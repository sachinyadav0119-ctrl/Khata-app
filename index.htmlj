async function saveHealthScoreHistory(){ try{ localStorage.setItem(bizKey('healthscorehistory'), JSON.stringify(state.healthScoreHistory)); }catch(e){} }
async function saveVoiceSettings(){ try{ localStorage.setItem(bizKey('voicesettings'), JSON.stringify(state.voiceSettings)); }catch(e){} }
async function saveVoiceLog(){ try{ localStorage.setItem(bizKey('voicelog'), JSON.stringify(state.voiceLog)); }catch(e){} }
async function saveAdvisor(){ try{ localStorage.setItem(bizKey('advisor'), JSON.stringify(state.advisor)); }catch(e){} }
// NOT scoped — deliberate (see Sprint 23 build-log entry): theme is a shared
// device preference, not per-profile business data.
async function saveTheme(){
  try{ localStorage.setItem('khaata:theme', state.theme); }catch(e){}
}
function flash(){
  const el = document.getElementById('saveFlash');
  el.classList.add('show');
  clearTimeout(flash._t);
  flash._t = setTimeout(()=>el.classList.remove('show'), 1200);
  driveMaybeAutoBackup();
}

/* ---------------------------------------------------------------
   HELPERS
--------------------------------------------------------------- */
function expenseCats(){ return [...DEFAULT_EXPENSE_CATS, ...state.customExpenseCats]; }
function incomeSources(){ return [...DEFAULT_INCOME_SOURCES, ...state.customIncomeSources]; }
function allTxns(){ return state.transactions; }
function incomeTxns(){ return state.transactions.filter(t=>t.type==='income'); }
function expenseTxns(){ return state.transactions.filter(t=>t.type==='expense'); }
function sum(arr){ return arr.reduce((s,t)=>s+Number(t.amount||0),0); }
function dateInRange(d, from, to){ return d>=from && d<=to; }
function monthKey(d){ return d.slice(0,7); }
function daysBetween(a,b){ return Math.max(1, Math.round((new Date(b)-new Date(a))/86400000)+1); }
function startOfWeek(){ const d=new Date(); const day=d.getDay(); const diff=(day===0?6:day-1); d.setDate(d.getDate()-diff); return d.toISOString().slice(0,10); }
function startOfMonth(offset=0){ const d=new Date(); d.setMonth(d.getMonth()+offset,1); return d.toISOString().slice(0,10); }
function endOfMonth(offset=0){ const d=new Date(); d.setMonth(d.getMonth()+offset+1,0); return d.toISOString().slice(0,10); }
function uniqueDays(txns){ return new Set(txns.map(t=>t.date)); }

/* ---------------------------------------------------------------
   ACCOUNTS / SUBCATS / TAGS HELPERS
--------------------------------------------------------------- */
function activeAccounts(){ return state.accounts.filter(a=>a.active!==false); }
function accountById(id){ return state.accounts.find(a=>a.id===id); }
function accountBalance(id){
  const acc = accountById(id);
  if(!acc) return 0;
  let bal = Number(acc.opening)||0;
  state.transactions.forEach(t=>{
    if(t.type==='income' && t.account===id) bal += Number(t.amount)||0;
    else if(t.type==='expense' && t.account===id) bal -= Number(t.amount)||0;
    else if(t.type==='transfer'){
      if(t.fromAccount===id) bal -= Number(t.amount)||0;
      if(t.toAccount===id) bal += Number(t.amount)||0;
    }
  });
  return bal;
}
function totalMoney(){ return activeAccounts().reduce((s,a)=>s+accountBalance(a.id),0); }
function subcatsFor(category){
  return [...(DEFAULT_SUBCATS[category]||[]), ...((state.customSubcats && state.customSubcats[category])||[])];
}
function allTags(){ return state.tags||[]; }
function parseTagsInput(str){
  return (str||'').split(',').map(s=>s.trim()).filter(Boolean).map(s=> s.startsWith('#')? s : '#'+s);
}
function registerTags(tags){
  tags.forEach(tg=>{ if(!state.tags.includes(tg)) state.tags.push(tg); });
}
/* real (non-transfer) income/expense only, used for all money math below */
function realExpenseTxns(){ return state.transactions.filter(t=>t.type==='expense'); }
function realIncomeTxns(){ return state.transactions.filter(t=>t.type==='income'); }
function transferTxns(){ return state.transactions.filter(t=>t.type==='transfer'); }

/* ---------------------------------------------------------------
   TABS
--------------------------------------------------------------- */
document.querySelectorAll('.tab').forEach(btn=>{
  btn.addEventListener('click', ()=> switchToView(btn.dataset.view));
});
document.querySelectorAll('#bottomNav button[data-view]').forEach(btn=>{
  btn.addEventListener('click', ()=> switchToView(btn.dataset.view));
});
/* Sprint 33 — body.kh-more-open drives the "+" (#fabBtn) visibility
   CSS above: it now only appears, top-right, while the More sheet is
   open. Every line below that closes #moreSheetOverlay also removes
   this class and collapses the plus-menu, so the "+" never lingers
   after the sheet is dismissed. */
document.getElementById('moreNavBtn').addEventListener('click', ()=>{
  document.getElementById('moreSheetOverlay').classList.remove('hidden');
  document.body.classList.add('kh-more-open');
});
document.getElementById('moreSheetClose').addEventListener('click', ()=>{
  document.getElementById('moreSheetOverlay').classList.add('hidden');
  document.body.classList.remove('kh-more-open');
  document.getElementById('khPlusMenu')?.classList.remove('kh-open');
  document.getElementById('fabBtn')?.classList.remove('kh-open');
});
document.querySelectorAll('.more-item').forEach(el=>{
  if(!el.dataset.view) return; // Sprint 24 — e.g. #moreAIAssistantItem, wired separately below
  el.addEventListener('click', ()=>{
    document.getElementById('moreSheetOverlay').classList.add('hidden');
    document.body.classList.remove('kh-more-open');
    switchToView(el.dataset.view);
  });
});
/* Sprint 24 — Menu ▸ AI Assistant: opens the existing, untouched
   App.Chat overlay (same engine the Voice Assistant already talks
   to) instead of switching to a view. */
document.getElementById('moreAIAssistantItem')?.addEventListener('click', ()=>{
  document.getElementById('moreSheetOverlay').classList.add('hidden');
  document.body.classList.remove('kh-more-open');
  if(window.App && App.Chat) App.Chat.open();
});

function renderView(name){
  if(name==='dashboard') renderDashboard();
  if(name==='transactions') renderTransactions();
  if(name==='budgets') renderBudgets();
  if(name==='food') renderFood();
  if(name==='insights') renderInsights();
  if(name==='advisor') App.Advisor.UI.render();
  if(name==='report') renderReport();
  if(name==='reports') renderReportsHub();
  if(name==='goals') renderGoals();
  if(name==='accounts') renderAccounts();
  if(name==='recurring') renderRecurring();
  if(name==='categories') renderCategoriesView();
  if(name==='debts') renderDebts();
  if(name==='creditcards') renderCreditCards();
  if(name==='investments') renderInvestments();
  if(name==='forecast') renderForecast();
  if(name==='affordability') renderAffordability();
  if(name==='search') { populateFilterCategories(); }
  if(name==='voice') renderVoiceView();
}

/* keep bottom nav + top tabs in sync when either is used to switch views */
function switchToView(name){
  document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('active', b.dataset.view===name));
  document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));
  const target = document.getElementById('view-'+name);
  if(target) target.classList.add('active');
  document.querySelectorAll('#bottomNav button[data-view]').forEach(b=>b.classList.toggle('active', b.dataset.view===name));
  renderView(name);
}

