}));
document.getElementById('qrSaveBtn').addEventListener('click', async ()=>{
  const title = document.getElementById('qr_title').value.trim();
  const dueDate = document.getElementById('qr_date').value;
  if(!title){ alert('Enter what to remind you about.'); return; }
  if(!dueDate){ alert('Pick a due date.'); return; }
  state.reminders.push({ id:uid(), title, dueDate, notes:'Added via Quick Entry', done:false, createdDate:todayStr() });
  await saveReminders();
  document.getElementById('quickAddOverlay').classList.add('hidden');
  document.getElementById('qr_title').value='';
  document.getElementById('qaReminderForm').classList.add('hidden');
  document.querySelectorAll('#qaMoreTypes button').forEach(x=>x.classList.remove('active'));
});

/* ---------------------------------------------------------------
   MONTHLY REPORT
--------------------------------------------------------------- */
function renderReport(){
  const monthsSel = document.getElementById('reportMonth');
  const months = monthsRange();
  if(!months.length){
    monthsSel.innerHTML='';
    document.getElementById('reportBody').innerHTML = '<div class="empty-note">Not enough data available yet. Add transactions to generate a monthly report.</div>';
    return;
  }
  const prevVal = monthsSel.value;
  monthsSel.innerHTML = months.slice().reverse().map(m=>`<option value="${m}">${m}</option>`).join('');
  if(prevVal && months.includes(prevVal)) monthsSel.value = prevVal;
  monthsSel.onchange = buildReportBody;
  buildReportBody();
}
function monthLabel(mKey){
  const [y,mo] = mKey.split('-').map(Number);
  if(!y||!mo) return mKey;
  return new Date(y, mo-1, 1).toLocaleString('en-IN', {month:'long', year:'numeric'});
}
function buildReportBody(){
  const m = document.getElementById('reportMonth').value;
  if(!m) return;
  const exp = expenseTxns().filter(t=>monthKey(t.date)===m);
  const inc = incomeTxns().filter(t=>monthKey(t.date)===m);
  const totalIncome = sum(inc), totalExpense = sum(exp);
  const net = totalIncome-totalExpense;
  const rate = totalIncome? (net/totalIncome*100):0;
  const byCat={}; exp.forEach(t=>byCat[t.category]=(byCat[t.category]||0)+Number(t.amount));
  const topCats = Object.entries(byCat).sort((a,b)=>b[1]-a[1]).slice(0,5);
  const food = sum(exp.filter(t=>FOOD_CATS.includes(t.category)));
  const byDay={}; exp.forEach(t=>byDay[t.date]=(byDay[t.date]||0)+Number(t.amount));
  const dayEntries = Object.entries(byDay).sort((a,b)=>b[1]-a[1]);
  const highDay = dayEntries[0], lowDay = dayEntries[dayEntries.length-1];

  // largest transaction & average daily spending for the selected month
  const largestTxn = exp.slice().sort((a,b)=>Number(b.amount)-Number(a.amount))[0];
  const today = todayStr();
  const isCurrentMonth = m===monthKey(today);
  const [ry, rmo] = m.split('-').map(Number);
  const daysInMonth = new Date(ry, rmo, 0).getDate();
  const daysElapsed = isCurrentMonth ? (new Date(today).getDate()) : daysInMonth;
  const avgDaily = daysElapsed>0 ? totalExpense/daysElapsed : 0;

  let budgetRows = Object.keys(state.budgets).map(c=>{
    const actual = sum(exp.filter(t=>t.category===c));
    const budget = Number(state.budgets[c]);
    return `<tr><td>${c}</td><td>${fmt(budget)}</td><td>${fmt(actual)}</td><td>${budget? (actual/budget*100).toFixed(0)+'%':'—'}</td><td>${actual>budget && budget>0?'⚠ Over':'On track'}</td></tr>`;
  }).join('');

  // Goal progress
  const goals = state.goals.filter(g=>!g.isEmergencyFund);
  const goalRows = goals.length ? goals.map(g=>{
    const saved = sum(g.contributions||[]);
    const pct = Number(g.cost)>0 ? Math.min(100, saved/Number(g.cost)*100) : 0;
    return `<tr><td>${g.name}</td><td>${fmt(saved)} / ${fmt(g.cost)}</td><td>${pct.toFixed(0)}%</td><td>${g.achieved?'Completed':g.paused?'Paused':'Active'}</td></tr>`;
  }).join('') : '';

  // Emergency fund
  const efGoal = getEmergencyFundGoal();
  let efHtml;
  if(efGoal && Number(efGoal.cost)>0){
    const saved = sum(efGoal.contributions||[]);
    const pct = Math.min(100, saved/Number(efGoal.cost)*100);
    efHtml = `<p style="font-size:13.5px;">${fmt(saved)} of ${fmt(efGoal.cost)} target — <b>${pct.toFixed(0)}% funded</b>.</p>`;
  } else {
    efHtml = '<div class="empty-note">No emergency fund target set up yet.</div>';
  }

  // Debt / EMI status
  const iOwe = (state.debts||[]).filter(d=>d.type==='i_owe'&&!d.settled).reduce((s,d)=>s+Number(d.amount),0);
  const owedToMe = (state.debts||[]).filter(d=>d.type==='owed_to_me'&&!d.settled).reduce((s,d)=>s+Number(d.amount),0);
  const debtHtml = (iOwe>0||owedToMe>0)
    ? `<p style="font-size:13.5px;">You owe: <b>${fmt(iOwe)}</b> &nbsp;·&nbsp; Owed to you: <b>${fmt(owedToMe)}</b></p>`
    : '<div class="empty-note">No outstanding debts recorded.</div>';

  // Credit card status
  const cards = state.creditCards||[];
  const cardHtml = cards.length ? `<p style="font-size:13.5px;">${cards.map(c=>`${c.name}: ${fmt(c.outstanding||0)} outstanding${Number(c.limit)>0? ` (${ccUtilization(c).toFixed(0)}% utilization)`:''}`).join('<br>')}</p>` : '<div class="empty-note">No credit cards recorded.</div>';

  // Net worth (current snapshot — the app tracks a running figure, not a per-past-month ledger)
  const nwAssets = netWorthAssets(), nwLiab = netWorthLiabilities();
  const netWorthNow = nwAssets - nwLiab;
  const nwHistEntry = (state.netWorthHistory||[]).find(h=>h.month===m);

  // Financial health score
  const healthDetail = computeHealthScoreDetail();

  // Month-over-month
  const lastMDate = new Date(ry, rmo-2, 1);
  const lastM = monthKey(lastMDate.toISOString().slice(0,10));
  const mom = computeMoMHtml(m, lastM, monthLabel(m), monthLabel(lastM));

  // Key insights (subset, scoped to this month)
  const keyInsights = [];
  if(topCats.length){
    keyInsights.push(`Highest spending category: <b>${topCats[0][0]}</b> at ${fmt(topCats[0][1])}${totalExpense?` (${(topCats[0][1]/totalExpense*100).toFixed(0)}% of expenses)`:''}.`);
  }
  if(largestTxn){
    keyInsights.push(`Largest transaction: <b>${fmt(largestTxn.amount)}</b> on ${largestTxn.date} (${largestTxn.category}${largestTxn.item?', '+largestTxn.item:''}).`);
  }
  if(totalIncome>0){
    keyInsights.push(`Saved ${fmt(net)} this month — a ${rate.toFixed(1)}% savings rate.`);
  } else if(totalExpense>0) {
    keyInsights.push(`No income logged for ${monthLabel(m)}, so savings rate can't be calculated.`);
  }
  Object.keys(state.budgets).forEach(c=>{
    const actual = sum(exp.filter(t=>t.category===c));
    const budget = Number(state.budgets[c]);
    if(budget>0 && actual>budget) keyInsights.push(`Over budget in <b>${c}</b> by ${fmt(actual-budget)}.`);
  });

  // Recommendations
  const recos = [];
  if(topCats.length && totalExpense>0 && topCats[0][1]/totalExpense>0.3){
    recos.push(`<b>${topCats[0][0]}</b> makes up over 30% of this month's expenses — trimming it could meaningfully boost savings.`);
  }
  Object.keys(state.budgets).forEach(c=>{
    const actual = sum(exp.filter(t=>t.category===c));
    const budget = Number(state.budgets[c]);
    if(budget>0 && actual>budget) recos.push(`Reduce <b>${c}</b> spending by ${fmt(actual-budget)} next month to get back within budget.`);
  });
  if(efGoal && Number(efGoal.cost)>0){
    const saved = sum(efGoal.contributions||[]);
    if(saved<Number(efGoal.cost)) recos.push(`Keep contributing to your Emergency Fund — ${fmt(Number(efGoal.cost)-saved)} still needed to reach the target.`);
  }
  if(!recos.length) recos.push('Not enough data available yet to generate personalized recommendations. Keep logging transactions daily.');

  document.getElementById('reportBody').innerHTML = `
    <div class="card-note" style="font-weight:700;font-size:15px;color:var(--ink);margin-bottom:10px;">${monthLabel(m)} Financial Snapshot</div>
    <div class="kpi-grid" style="margin-bottom:18px;">
      <div class="kpi income"><div class="kpi-label">Income</div><div class="kpi-value">${fmt(totalIncome)}</div></div>
      <div class="kpi expense"><div class="kpi-label">Spent</div><div class="kpi-value">${fmt(totalExpense)}</div></div>
      <div class="kpi savings"><div class="kpi-label">Saved</div><div class="kpi-value">${fmt(net)}</div><div class="kpi-sub">${rate.toFixed(1)}% savings rate</div></div>
      <div class="kpi"><div class="kpi-label">Financial Health</div><div class="kpi-value" style="color:${healthDetail.overall==null?'var(--ink-soft)':healthDetail.overall>=70?'var(--teal)':healthDetail.overall>=40?'var(--gold)':'var(--rust)'};">${healthDetail.overall==null?'—':healthDetail.overall+'/100'}</div></div>
    </div>
    <div class="kpi-grid" style="margin-bottom:18px;">
      <div class="kpi expense"><div class="kpi-label">Food Expenses</div><div class="kpi-value">${fmt(food)}</div><div class="kpi-sub">${totalExpense? (food/totalExpense*100).toFixed(0)+'% of expenses':''}</div></div>
      <div class="kpi expense"><div class="kpi-label">Largest Transaction</div><div class="kpi-value">${largestTxn?fmt(largestTxn.amount):'—'}</div><div class="kpi-sub">${largestTxn?largestTxn.category+' · '+largestTxn.date:''}</div></div>
      <div class="kpi expense"><div class="kpi-label">Avg Daily Spending</div><div class="kpi-value">${fmt(avgDaily)}</div><div class="kpi-sub">over ${daysElapsed} day(s)</div></div>
      <div class="kpi"><div class="kpi-label">Net Worth (current)</div><div class="kpi-value">${fmt(netWorthNow)}</div>${nwHistEntry?`<div class="kpi-sub">as recorded that month: ${fmt(nwHistEntry.netWorth)}</div>`:''}</div>
    </div>
    <div class="two-col">
      <div>
        <h4 style="font-family:var(--font-display);">Top Expense Categories</h4>
        ${topCats.length? '<table><thead><tr><th>Category</th><th>Amount</th></tr></thead><tbody>'+topCats.map(([c,a])=>`<tr><td>${c}</td><td>${fmt(a)}</td></tr>`).join('')+'</tbody></table>' : '<div class="empty-note">Not enough data available yet.</div>'}
        <h4 style="font-family:var(--font-display);margin-top:18px;">Spending Extremes</h4>
        <p style="font-size:13.5px;">Highest spending day: <b>${highDay? highDay[0]+' — '+fmt(highDay[1]) : '—'}</b><br>Lowest spending day: <b>${lowDay? lowDay[0]+' — '+fmt(lowDay[1]) : '—'}</b></p>
      </div>
      <div>
        <h4 style="font-family:var(--font-display);">Budget Performance</h4>
        ${budgetRows? '<table><thead><tr><th>Category</th><th>Budget</th><th>Actual</th><th>%</th><th>Status</th></tr></thead><tbody>'+budgetRows+'</tbody></table>' : '<div class="empty-note">No budgets set for this period.</div>'}
      </div>
    </div>
    <h4 style="font-family:var(--font-display);margin-top:18px;">Goal Progress</h4>
    ${goalRows? '<div class="table-wrap"><table><thead><tr><th>Goal</th><th>Saved / Target</th><th>Progress</th><th>Status</th></tr></thead><tbody>'+goalRows+'</tbody></table></div>' : '<div class="empty-note">No goals added yet.</div>'}
    <h4 style="font-family:var(--font-display);margin-top:18px;">Emergency Fund</h4>
    ${efHtml}
    <h4 style="font-family:var(--font-display);margin-top:18px;">Debt / EMI Status</h4>
    ${debtHtml}
    <h4 style="font-family:var(--font-display);margin-top:18px;">Credit Card Status</h4>
    ${cardHtml}
    <h4 style="font-family:var(--font-display);margin-top:18px;">Month-over-Month Comparison</h4>
    ${mom.hasData && mom.html ? mom.html : '<div class="empty-note">Not enough recorded data yet for a month-over-month comparison.</div>'}
    <h4 style="font-family:var(--font-display);margin-top:18px;">Key Insights</h4>
    ${keyInsights.length? keyInsights.map(t=>`<div class="insight"><span class="dot info"></span><p>${t}</p></div>`).join('') : '<div class="empty-note">Not enough data available yet.</div>'}
    <h4 style="font-family:var(--font-display);margin-top:18px;">Recommendations</h4>
    ${recos.map(r=>`<div class="insight"><span class="dot good"></span><p>${r}</p></div>`).join('')}
    <div class="card-note" style="margin-top:14px;">Khaata Financial Health Score and this report are based on your recorded data — not professional financial advice.</div>
  `;
}

/* ---------------------------------------------------------------
   DATA / EXPORT / IMPORT
--------------------------------------------------------------- */
function downloadFile(filename, content, type){
  const blob = new Blob([content], {type});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href=url; a.download=filename; a.click();
  URL.revokeObjectURL(url);
}
document.getElementById('exportCsvBtn').addEventListener('click', ()=>{
  const header = 'type,date,category,item,amount,mode,notes\n';
  const rows = state.transactions.map(t=> [t.type,t.date,t.category,(t.item||'').replace(/,/g,';'),t.amount,t.mode,(t.notes||'').replace(/,/g,';')].join(',')).join('\n');
  downloadFile('khaata-transactions.csv', header+rows, 'text/csv');
});
document.getElementById('backupBtn').addEventListener('click', ()=>{
  downloadFile('khaata-backup.json', JSON.stringify(state,null,2), 'application/json');
});
document.getElementById('restoreBtn').addEventListener('click', ()=>{
  const inp = document.getElementById('importFile');
  inp.accept='.json';
  inp.onchange = async e=>{
    const file = e.target.files[0]; if(!file) return;
    const text = await file.text();
    try{
      const data = JSON.parse(text);
      if(data.transactions){ state = {...state, ...data}; document.body.setAttribute('data-theme', state.theme||'dark');
        migrateToV2();
        await saveTransactions(); await saveBudgets(); await saveCustomCats();
        await saveAccounts(); await saveRecurring(); await saveDebts(); await saveSubcats(); await saveTags(); await saveGoals();
        await saveCreditCards(); await saveInvestments(); await saveNetWorthHistory();
        await saveInvestmentWatchlist(); await saveInvestmentHistory();
        await saveVoiceSettings(); await saveVoiceLog();
        alert('Backup restored.'); refreshAllCharts(); populateFilterCategories(); populateBudgetCategorySelect(); populateCategorySelect(); populateAccountSelects();
        syncVoiceSettingsUI();
      } else alert("This file doesn't look like a Khaata backup.");
    }catch(err){ alert('Could not read this file.'); }
  };
  inp.click();
});
document.getElementById('importCsvBtn').addEventListener('click', ()=>{
  const inp = document.getElementById('importFile');
  inp.accept='.csv';
  inp.onchange = async e=>{
    const file = e.target.files[0]; if(!file) return;
    const text = await file.text();
    const lines = text.trim().split('\n').slice(1);
    let added=0;
    lines.forEach(line=>{
      const [type,date,category,item,amount,mode,notes] = line.split(',');
      if(type && date && amount){
        state.transactions.push({id:uid(), type:type.trim(), date:date.trim(), category:(category||'Other').trim(), item:(item||'').trim(), amount:parseFloat(amount), mode:(mode||'Other').trim(), notes:(notes||'').trim()});
        added++;
      }
    });
    await saveTransactions();
    alert(added+' transaction(s) imported.');
    refreshAllCharts();
  };
  inp.click();
});
document.getElementById('clearAllBtn').addEventListener('click', async ()=>{
  if(confirm('This will permanently delete ALL data — transactions, budgets, accounts, recurring transactions, debts, goals, credit cards, investments, reminders and custom categories. This cannot be undone. Continue?')){
    state.transactions=[]; state.budgets={}; state.customExpenseCats=[]; state.customIncomeSources=[];
    state.accounts=[]; state.recurring=[]; state.debts=[]; state.customSubcats={}; state.tags=[]; state.goals=[];
    state.creditCards=[]; state.investments=[]; state.netWorthHistory=[]; state.voiceLog=[]; state.ccUtilHistory={}; state.reminders=[];
    state.investmentWatchlist=[]; state.investmentHistory=[];
    migrateToV2();
    await saveTransactions(); await saveBudgets(); await saveCustomCats();
    await saveAccounts(); await saveRecurring(); await saveDebts(); await saveSubcats(); await saveTags(); await saveGoals();
    await saveCreditCards(); await saveInvestments(); await saveNetWorthHistory(); await saveVoiceLog(); await saveCCUtilHistory(); await saveReminders();
    await saveInvestmentWatchlist(); await saveInvestmentHistory();
    refreshAllCharts(); populateFilterCategories(); populateBudgetCategorySelect(); populateCategorySelect(); populateAccountSelects();
    renderVoiceHistory();
  }
});

/* ===================================================================
   PART 2.3 — ADVANCED VOICE COMMAND SYSTEM
   Uses only the browser's built-in Web Speech API (SpeechRecognition +
   SpeechSynthesis). No external API calls, no data leaves the device.
   Reuses existing state, save*() functions and compute*() logic —
   never a parallel data path. Voice can log transactions/goal
   contributions/goal status changes (always via confirmation), answer
   questions from real computed data, and navigate — but can NEVER
   delete anything.
=================================================================== */
const voiceSupported = !!(window.SpeechRecognition || window.webkitSpeechRecognition);
let recognition = null;
let isListening = false;
let pendingAction = null;      // {type:'transaction'|'goalContribution'|'goalStatus', ..., raw}
let voiceSessionEntries = [];  // current-session on-screen transcript (resets each time panel opens)
let continuousRestartTO = null;
let continuousCountdownTimer = null;
let continuousSecondsLeft = 0;

// Best-effort English + Hinglish (Latin) + Hindi (Devanagari) number-word → digit map.
// "where feasible" per spec — common amounts resolve; unusual phrasing may still need the amount typed/repeated.
const NUM_WORDS = {
  'zero':0,'one':1,'two':2,'three':3,'four':4,'five':5,'six':6,'seven':7,'eight':8,'nine':9,'ten':10,
  'eleven':11,'twelve':12,'thirteen':13,'fourteen':14,'fifteen':15,'sixteen':16,'seventeen':17,'eighteen':18,'nineteen':19,
  'twenty':20,'thirty':30,'forty':40,'fifty':50,'sixty':60,'seventy':70,'eighty':80,'ninety':90,
  'hundred':100,'thousand':1000,'lakh':100000,'lac':100000,
  'ek':1,'do':2,'teen':3,'char':4,'chaar':4,'paanch':5,'panch':5,'chhe':6,'che':6,'saat':7,'aath':8,'nau':9,
  'das':10,'gyarah':11,'barah':12,'terah':13,'chaudah':14,'pandrah':15,'solah':16,'satrah':17,'atharah':18,'unnees':19,
  'bees':20,'tees':30,'chalis':40,'pachas':50,'saath':60,'sattar':70,'assi':80,'nabbe':90,
  'sau':100,'hazar':1000,'hazaar':1000,
  '\u090f\u0915':1,'\u0926\u094b':2,'\u0924\u0940\u0928':3,'\u091a\u093e\u0930':4,'\u092a\u093e\u0902\u091a':5,
  '\u091b\u0939':6,'\u0938\u093e\u0924':7,'\u0906\u0920':8,'\u0928\u094c':9,'\u0926\u0938':10,
  '\u092c\u0940\u0938':20,'\u0924\u0940\u0938':30,'\u0938\u094c':100,'\u0939\u091c\u093e\u0930':1000,
  '\u0939\u091c\u093c\u093e\u0930':1000,'\u0932\u093e\u0916':100000
};
// extra category hints for spoken Hindi/Hinglish, kept separate from CATEGORY_KEYWORDS so manual-entry
// auto-categorization (already tested in Part 2.2) is left untouched.
const VOICE_CATEGORY_KEYWORDS = [
  {cat:"Food", words:["khana","bhojan","khaana"]},
  {cat:"Bills", words:["bijli","kiraya","recharge"]},
  {cat:"Personal", words:["dawai","davai"]},
  {cat:"Shopping", words:["kapde","kapda"]},
  {cat:"Travel", words:["auto","petrol","diesel"]}
];
const WEEKDAY_MAP = {
  'sunday':0,'monday':1,'tuesday':2,'wednesday':3,'thursday':4,'friday':5,'saturday':6,
  'ravivar':0,'somvar':1,'somwar':1,'mangalvar':2,'budhvar':3,'buddhvar':3,'guruvar':4,'brihaspativar':4,'shukravar':5,'shanivar':6
};
const VIEW_ALIASES = {
  dashboard:['dashboard','home'], entry:['add entry','new entry'], transactions:['transactions','txns'],
  budgets:['budgets','budget'], goals:['goals','goal'], insights:['insights','insight'], accounts:['accounts','account'],
  recurring:['recurring'], categories:['categories','tags'], debts:['debts','loans'],
  creditcards:['credit cards','credit card'], investments:['investments','investment'],
  forecast:['cash flow forecast','cash-flow forecast','forecast'], affordability:['can i spend this','affordability'],
  food:['food analysis'], report:["this month's report","monthly report","report"], search:['search results','search'],
  data:['data and backup','data & backup','backup','data'], voice:['voice assistant','voice']
};

function escapeHtml(s){ return String(s==null?'':s).replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

/* ---------------- number / field extraction ---------------- */
function extractAmount(t){
  const digitMatch = t.match(/(\d+(?:[.,]\d+)?)/);
  if(digitMatch){
    const v = parseFloat(digitMatch[1].replace(/,/g,''));
    if(!isNaN(v) && v>0) return v;
  }
  const tokens = t.replace(/[^a-z\u0900-\u097F\s]/g,' ').split(/\s+/).filter(Boolean);
  let total=0, current=0, found=false;
  tokens.forEach(tok=>{
    if(NUM_WORDS[tok]===undefined) return;
    found=true;
    const val = NUM_WORDS[tok];
    if(val===100){ current = (current||1)*100; }
    else if(val===1000){ total += (current||1)*1000; current=0; }
    else if(val===100000){ total += (current||1)*100000; current=0; }
    else { current += val; }
  });
  const result = total+current;
  return (found && result>0) ? result : null;
}
function findCategoryInText(t, type){
  const list = (type==='income') ? incomeSources() : expenseCats();
  for(const c of list){ if(t.includes(c.toLowerCase())) return c; }
  if(type!=='income'){
    for(const k of CATEGORY_KEYWORDS.concat(VOICE_CATEGORY_KEYWORDS)){
      if(k.words.some(w=>t.includes(w))) return k.cat;
    }
  }
  return null;
}
function findGoalInText(t){
  const candidates = state.goals.slice().sort((a,b)=>b.name.length-a.name.length);
  for(const g of candidates){ if(g.name && t.includes(g.name.toLowerCase())) return g; }
  return null;
}
function detectType(t){
  const incomeWords = ['received','receive','income','salary aa','got paid','earned','mila','mile','aayi','aaya','kamaya','kamaye','salary'];
  const expenseWords = ['spent','spend','paid','pay ','kharch','kharcha','diya','diye','kiya kharch'];
  const hasIncome = incomeWords.some(w=>t.includes(w));
  const hasExpense = expenseWords.some(w=>t.includes(w));
  if(hasIncome && !hasExpense) return {type:'income', assumed:false};
  if(hasExpense && !hasIncome) return {type:'expense', assumed:false};
  return {type:'expense', assumed:true};
}
function detectCategory(t, type){
  const cat = findCategoryInText(t, type);
  if(cat){
    const subEntry = CATEGORY_KEYWORDS.find(k=>k.cat===cat && k.sub && k.words.some(w=>t.includes(w)));
    return { category:cat, subcategory: subEntry ? subEntry.sub : '' };
  }
  return { category:'Other', subcategory:'' };
}
function detectMode(t){
  if(/(upi|gpay|google pay|phonepe|paytm)/.test(t)) return 'UPI';
  if(/(credit card|debit card|\bcard\b)/.test(t)) return 'Card';
  if(/(net ?banking)/.test(t)) return 'Bank Transfer';
  if(/(cheque|check)\b/.test(t)) return 'Other';
  if(/(wallet)/.test(t)) return 'Other';
  if(/(cash|nagad)/.test(t)) return 'Cash';
  return 'Other';
}
function detectDate(t){
  if(/day before yesterday|parso/.test(t)){ const d=new Date(); d.setDate(d.getDate()-2); return d.toISOString().slice(0,10); }
  if(/yesterday|\bkal\b/.test(t)){ const d=new Date(); d.setDate(d.getDate()-1); return d.toISOString().slice(0,10); }
  if(/today|aaj/.test(t)) return todayStr();
  const specific = t.match(/\b(\d{1,2})\s+(january|february|march|april|may|june|july|august|september|october|november|december)\s+(\d{4})\b/);
  if(specific){ const d = parseDateWords(specific[0]); if(d) return d; }
  const wd = Object.keys(WEEKDAY_MAP).find(w=>t.includes(w));
  if(wd){
    const target = WEEKDAY_MAP[wd];
    const d = new Date();
    let diff = (d.getDay() - target + 7) % 7;
    if(diff===0) diff = 7;
    d.setDate(d.getDate()-diff);
    return d.toISOString().slice(0,10);
  }
  return todayStr();
}
function detectAccount(t){
  const accts = activeAccounts();
  for(const a of accts){ if(a.name && t.includes(a.name.toLowerCase())) return a.id; }
  return accts[0] ? accts[0].id : null;
}
function detectItem(rawText){
  let m = rawText.match(/\bfor\s+([a-z0-9 ]+?)(?:\s+(?:by|via|using|yesterday|today|kal|aaj)\b|[.?]|$)/i);
  if(m) return m[1].trim();
  m = rawText.match(/([a-z\u0900-\u097F]+)\s+(?:pe|par|mein|me)\b/i);
  if(m) return m[1].trim();
  return '';
}
function buildTransactionDraft(transcript){
  const t = transcript.toLowerCase();
  const amount = extractAmount(t);
  const {type, assumed} = detectType(t);
  const {category, subcategory} = detectCategory(t, type);
  const mode = detectMode(t);
  const date = detectDate(t);
  const account = detectAccount(t);
  const item = detectItem(transcript) || (category!=='Other'?category:'');
  return { amount, type, typeAssumed:assumed, category, subcategory, mode, date, account, item, raw:transcript };
}

/* ---------------- Ask Khaata: voice queries (real data only) ---------------- */
function pickSpeakText(en, hi){ return (state.voiceSettings.recognitionLang==='hi' && hi) ? hi : en; }
function matchQuery(raw){
  const t = raw.toLowerCase();

  if(/(yesterday|\bkal\b)/.test(t) && /(spend|spent|kharch)/.test(t)){
    const y = new Date(); y.setDate(y.getDate()-1); const ys = y.toISOString().slice(0,10);
    const amt = sum(expenseTxns().filter(x=>x.date===ys));
    const en = `You spent ${fmt(amt)} yesterday.`;
    return { speakEn:en, speakHi:`\u0915\u0932 \u0906\u092a\u0928\u0947 ${fmt(amt)} \u0916\u0930\u094d\u091a \u0915\u093f\u090f\u0964`, html:en, view:'transactions', viewLabel:'View Transactions', logText:en };
  }
  if(/(spend|spent|kharch)/.test(t) && /(month|mahine|mahina)/.test(t)){
    const cat = findCategoryInText(t, 'expense');
    if(cat){
      const amt = sum(expenseTxns().filter(x=>x.category===cat && dateInRange(x.date, startOfMonth(0), endOfMonth(0))));
      const en = `You've spent ${fmt(amt)} on ${cat} this month.`;
      return { speakEn:en, speakHi:`\u0907\u0938 \u092e\u0939\u0940\u0928\u0947 \u0906\u092a\u0928\u0947 ${cat} \u092a\u0930 ${fmt(amt)} \u0916\u0930\u094d\u091a \u0915\u093f\u090f\u0964`, html:en, view:'insights', viewLabel:'View Insights', logText:en };
    }
    const amt = sum(expenseTxns().filter(x=>dateInRange(x.date, startOfMonth(0), endOfMonth(0))));
    const en = `You've spent ${fmt(amt)} total this month.`;
    return { speakEn:en, html:en, view:'insights', viewLabel:'View Insights', logText:en };
  }
  if(/budget/.test(t) && /(left|remaining|bacha|bache)/.test(t)){
    const cat = findCategoryInText(t, 'expense');
    if(!cat){ const m="I couldn't find that — tell me which category's budget you mean."; return { speakEn:m, html:m, logText:m }; }
    const budget = Number(state.budgets[cat])||0;
    if(budget<=0){ const m=`I couldn't find that — you haven't set up a budget for ${cat} yet.`; return { speakEn:m, html:m, view:'budgets', viewLabel:'Set a Budget', logText:m }; }
    const spent = sum(expenseTxns().filter(x=>x.category===cat && dateInRange(x.date, startOfMonth(0), endOfMonth(0))));
    const left = Math.max(0, budget-spent);
    const en = `${fmt(left)} left in your ${cat} budget this month, out of ${fmt(budget)}.`;
    return { speakEn:en, html:en, view:'budgets', viewLabel:'View Budgets', logText:en };
  }
  if(/savings rate/.test(t)){
    const a = healthAreaSavings();
    if(a.score==null){ const m="I couldn't find that — add some income data first to calculate your savings rate."; return { speakEn:m, html:m, logText:m }; }
    const en = `Your savings rate is ${a.rate.toFixed(1)} percent.`;
    return { speakEn:en, speakHi:`\u0906\u092a\u0915\u0940 \u0938\u0947\u0935\u093f\u0902\u0917\u094d\u0938 \u0930\u0947\u091f ${a.rate.toFixed(1)} \u092a\u094d\u0930\u0924\u093f\u0936\u0924 \u0939\u0948\u0964`, html:en, view:'insights', viewLabel:'View Insights', logText:en };
  }
  if(/emergency fund/.test(t)){
    const efGoal = getEmergencyFundGoal();
    if(!efGoal){ const m="I couldn't find that — you haven't set up an emergency fund yet."; return { speakEn:m, html:m, view:'goals', viewLabel:'View Goals', logText:m }; }
    const target = Number(efGoal.cost)||0, saved = sum(efGoal.contributions);
    const pct = target>0 ? Math.min(100, saved/target*100) : 0;
    const en = pct>=100 ? `Yes, your emergency fund is fully funded at ${fmt(saved)}.` : `Your emergency fund is ${pct.toFixed(0)}% funded — ${fmt(saved)} of ${fmt(target)}.`;
    return { speakEn:en, html:en, view:'goals', viewLabel:'View Emergency Fund', logText:en };
  }
  if(/(health score|financial health)/.test(t)){
    const {overall} = computeHealthScoreDetail();
    if(overall==null){ const m="I couldn't find that — log more income, expenses, and goals to calculate your health score."; return { speakEn:m, html:m, view:'insights', viewLabel:'View Insights', logText:m }; }
    const en = `Your financial health score is ${overall} out of 100.`;
    return { speakEn:en, speakHi:`\u0906\u092a\u0915\u093e \u092b\u093e\u0907\u0928\u0947\u0902\u0936\u093f\u092f\u0932 \u0939\u0947\u0932\u094d\u0925 \u0938\u094d\u0915\u094b\u0930 100 \u092e\u0947\u0902 \u0938\u0947 ${overall} \u0939\u0948\u0964`, html:en, view:'insights', viewLabel:'View Health Score', logText:en };
  }
  if(/(upcoming bills|upcoming commitments|bills? (aane|coming))/.test(t)){
    const items = computeUpcomingCommitmentsItems(30).slice(0,5);
    if(!items.length){ const m="You don't have any upcoming bills or commitments recorded in the next 30 days."; return { speakEn:m, html:m, view:'recurring', viewLabel:'View Recurring', logText:m }; }
    const en = `You have ${items.length} upcoming item${items.length===1?'':'s'} in the next 30 days, starting with ${items[0].name} on ${items[0].date}.`;
    const html = items.map(it=>`${it.date} — ${it.name}: ${fmt(it.amount)}`).join('<br>');
    return { speakEn:en, html, view:'recurring', viewLabel:'View Upcoming', logText:en };
  }
  if(/(goal|lakshya)/.test(t) && /(going|progress|kaisa|kitna)/.test(t) && !/(add|contribut)/.test(t)){
    const g = findGoalInText(t);
    if(!g){ const m="I couldn't find that — you haven't set up a goal by that name yet."; return { speakEn:m, html:m, view:'goals', viewLabel:'View Goals', logText:m }; }
    const plan = computeGoalPlan();
    const r = plan.results[g.id];
    const status = computeGoalStatus(g, plan);
    const pct = r ? r.progressPct.toFixed(0) : '0';
    const en = `${g.name} is ${pct}% funded — ${fmt(r?r.contributed:0)} of ${fmt(g.cost)}. Status: ${status}.`;
    return { speakEn:en, html:en, view:'goals', viewLabel:'View Goals', logText:en };
  }
  if(/\bbalance\b/.test(t) && !/(budget|remaining|left)/.test(t)){
    const bal = totalMoney();
    const en = `Your balance is ${fmt(bal)}.`;
    return { speakEn:en, speakHi:`\u0906\u092a\u0915\u093e \u092c\u0948\u0932\u0947\u0902\u0938 ${fmt(bal)} \u0939\u0948\u0964`, html:en, view:'accounts', viewLabel:'View Accounts', logText:en };
  }
  return null;
}

/* ---------------- Voice navigation ---------------- */
function matchNavigation(raw){
  const t = raw.toLowerCase();
  if(!/\b(open|show|go to|switch to|khol)\b/.test(t)) return null;
  let best=null, bestLen=0;
  for(const [view, aliases] of Object.entries(VIEW_ALIASES)){
    for(const a of aliases){ if(t.includes(a) && a.length>bestLen){ best=view; bestLen=a.length; } }
  }
  if(!best) return null;
  const tabEl = document.querySelector(`.tab[data-view="${best}"]`);
  return { view:best, label: tabEl ? tabEl.textContent : best };
}
function matchForecastRun(raw){
  const t = raw.toLowerCase();
  if(!/forecast/.test(t)) return null;
  const m = t.match(/(\d+)\s*day/);
  return { days: m ? parseInt(m[1]) : 30 };
}
function matchAffordabilityCheck(raw){
  const t = raw.toLowerCase();
  if(!/(afford|can i spend|can i buy)/.test(t)) return null;
  const amount = extractAmount(t);
  if(!amount) return null;
  let item = 'this purchase';
  const forMatch = t.match(/for\s+([a-z0-9 ]+?)(?:[.?]|$)/);
  if(forMatch) item = forMatch[1].trim();
  const category = findCategoryInText(t, 'expense');
  return { amount, item, category };
}
function matchGoalStatusChange(raw){
  const t = raw.toLowerCase();
  const m = t.match(/mark\s+(?:the\s+)?([a-z0-9 ]+?)\s+(?:goal\s+)?as\s+(paused|resumed|completed|achieved|active)/);
  if(!m) return null;
  let newState = m[2];
  if(newState==='achieved') newState='completed';
  if(newState==='active') newState='resumed';
  return { goal: findGoalInText(t), goalNameRaw: m[1].trim(), newState };
}
function matchGoalContribution(raw){
  const t = raw.toLowerCase();
  if(!/goal/.test(t)) return null;
  if(!/(contribut|add|put|save)/.test(t)) return null;
  if(/mark|pause|resume|complete/.test(t)) return null;
  const amount = extractAmount(t);
  const toMatch = t.match(/to\s+([a-z0-9 ]+?)(?:[.?]|$)/) || t.match(/(?:mein|me)\s+([a-z0-9 ]+?)(?:[.?]|$)/);
  const goalNameRaw = toMatch ? toMatch[1].replace(/\bgoal\b/g,'').trim() : '';
  const goal = findGoalInText(t);
  if(!amount && !goal) return null;
  return { amount, goal, goalNameRaw: goalNameRaw || 'that goal' };
}

/* ---------------- speech synthesis ---------------- */
function speak(text, forcedLang){
  if(!('speechSynthesis' in window) || !text) return;
  try{
    window.speechSynthesis.cancel();
    const u = new SpeechSynthesisUtterance(text);
    u.lang = forcedLang || (state.voiceSettings.recognitionLang==='hi' ? 'hi-IN' : 'en-IN');
    window.speechSynthesis.speak(u);
  }catch(e){}
}

/* ---------------- UI plumbing ---------------- */
function showOutput(html){ document.getElementById('voiceOutputArea').innerHTML = html; }
function showAnswerCard(q){
  const text = pickSpeakText(q.speakEn, q.speakHi);
  showOutput(`<div class="voice-answer-card"><p style="margin:0;font-size:14px;">${q.html}</p>${q.view?`<button class="btn small secondary" style="margin-top:8px;" onclick="switchToView('${q.view}')">${q.viewLabel||'View Details'}</button>`:''}</div>`);
  return text;
}
function addSessionEntry(text){
  voiceSessionEntries.unshift({ ts:new Date().toLocaleTimeString(), text });
  if(voiceSessionEntries.length>30) voiceSessionEntries.length=30;
  renderSessionLog();
}
function renderSessionLog(){
  const el = document.getElementById('voiceSessionLog');
  if(!el) return;
  el.innerHTML = voiceSessionEntries.map(e=>`<div class="voice-session-item"><b>${e.ts}</b> — ${e.text}</div>`).join('');
}
async function logVoiceCommand(transcript, interpreted, status){
  state.voiceLog.unshift({ id:uid(), ts:new Date().toISOString(), transcript: transcript||'', interpreted: interpreted||'', status });
  if(state.voiceLog.length>300) state.voiceLog.length = 300;
  await saveVoiceLog();
  if(document.getElementById('view-voice')?.classList.contains('active')) renderVoiceHistory();
}
function renderVoiceHistory(){
  const el = document.getElementById('voiceHistList');
  if(!el) return;
  if(!state.voiceLog.length){ el.innerHTML = '<div class="empty-note">No voice commands yet — tap the mic and try "Add 200 for coffee".</div>'; return; }
  const colorVar = s => s==='Confirmed' ? 'var(--teal)' : s==='Cancelled' ? 'var(--gold)' : 'var(--rust)';
  el.innerHTML = state.voiceLog.map(v=>`
    <div class="voice-hist-row">
      <div class="voice-hist-top"><span>${new Date(v.ts).toLocaleString()}</span><span class="tag" style="background:transparent;border:1px solid ${colorVar(v.status)};color:${colorVar(v.status)};">${v.status}</span></div>
      <div class="voice-hist-transcript">"${escapeHtml(v.transcript)}"</div>
      <div class="voice-hist-outcome">${escapeHtml(v.interpreted)}</div>
    </div>`).join('');
}
function renderVoiceView(){ syncVoiceSettingsUI(); renderVoiceHistory(); }
function syncVoiceSettingsUI(){
  const en = document.getElementById('voiceEnabledToggle');
  const lang = document.getElementById('voiceLangSelect');
  const cont = document.getElementById('voiceContinuousToggle');
  if(en) en.checked = !!state.voiceSettings.enabled;
  if(lang) lang.value = state.voiceSettings.recognitionLang || 'auto';
  if(cont) cont.checked = !!state.voiceSettings.continuousMode;
  const note = document.getElementById('voiceSupportNote');
  if(note) note.textContent = voiceSupported ? '' : "Your browser doesn't support live speech recognition — use the text box in the Voice Assistant panel instead. Parsing, confirmation, and answers all work the same way.";
  applyVoiceEnabledUI();
}
function applyVoiceEnabledUI(){
  const fab = document.getElementById('micFabBtn');
  if(fab){
    fab.classList.toggle('hidden', !state.voiceSettings.enabled);
    fab.textContent = voiceSupported ? '🎙️' : '⌨️';
    fab.title = voiceSupported ? 'Voice Assistant' : 'Voice Assistant (text mode)';
  }
  if(!state.voiceSettings.enabled){ stopListening(); closeVoicePanel(); }
}

/* ---------------- confirmation cards ---------------- */
function showConfirmationCard_Transaction(draft, transcript){
  const accts = activeAccounts();
  const catList = draft.type==='income' ? incomeSources() : expenseCats();
  showOutput(`
    <div class="voice-confirm-card">
      <div class="vc-heard">I heard: "${escapeHtml(transcript)}"</div>
      ${draft.typeAssumed? `<div class="card-note" style="margin-bottom:8px;">I'm assuming this is an <b>expense</b> — change it below if not.</div>` : ''}
      <div class="form-grid">
        <div><label>Type</label><select id="vc_type"><option value="expense" ${draft.type==='expense'?'selected':''}>Expense</option><option value="income" ${draft.type==='income'?'selected':''}>Income</option></select></div>
        <div><label>Amount (₹)</label><input type="number" id="vc_amount" value="${draft.amount||''}" min="0" step="0.01"></div>
        <div><label>Category</label><select id="vc_category">${catList.map(c=>`<option ${c===draft.category?'selected':''}>${c}</option>`).join('')}</select></div>
        <div><label>Date</label><input type="date" id="vc_date" value="${draft.date}"></div>
        <div><label>Mode</label><select id="vc_mode">${PAYMENT_MODES.map(m=>`<option ${m===draft.mode?'selected':''}>${m}</option>`).join('')}</select></div>
        <div><label>Account</label><select id="vc_account">${accts.map(a=>`<option value="${a.id}" ${a.id===draft.account?'selected':''}>${a.icon||''} ${a.name}</option>`).join('')}</select></div>
        <div style="grid-column:1/-1;"><label>Description</label><input type="text" id="vc_item" value="${escapeHtml(draft.item||'')}"></div>
      </div>
      <div class="row-actions" style="margin-top:10px;">
        <button class="btn small teal" id="vcSaveBtn">✓ Save</button>
        <button class="btn small secondary" id="vcCancelBtn">✕ Cancel</button>
      </div>
    </div>`);
  document.getElementById('vcSaveBtn').addEventListener('click', confirmPendingAction);
  document.getElementById('vcCancelBtn').addEventListener('click', cancelPendingAction);
}
function showConfirmationCard_GoalContribution(p){
  showOutput(`
    <div class="voice-confirm-card">
      <div class="vc-heard">I heard: "${escapeHtml(p.raw)}"</div>
      <div class="form-grid">
        <div><label>Goal</label><input type="text" value="${escapeHtml(p.goal.name)}" disabled></div>
        <div><label>Amount (₹)</label><input type="number" id="vc_amount" value="${p.amount}" min="0" step="1"></div>
        <div><label>Date</label><input type="date" id="vc_date" value="${p.date}"></div>
      </div>
      <div class="row-actions" style="margin-top:10px;">
        <button class="btn small teal" id="vcSaveBtn">✓ Save</button>
        <button class="btn small secondary" id="vcCancelBtn">✕ Cancel</button>
      </div>
    </div>`);
  document.getElementById('vcSaveBtn').addEventListener('click', ()=>{
    pendingAction.amount = parseFloat(document.getElementById('vc_amount').value)||pendingAction.amount;
    pendingAction.date = document.getElementById('vc_date').value||pendingAction.date;
    confirmPendingAction();
  });
  document.getElementById('vcCancelBtn').addEventListener('click', cancelPendingAction);
}
function showConfirmationCard_GoalStatus(gs){
  showOutput(`
    <div class="voice-confirm-card">
      <div class="vc-heard">I heard: mark ${escapeHtml(gs.goal.name)} as ${gs.newState}</div>
      <div class="row-actions">
        <button class="btn small teal" id="vcSaveBtn">✓ Confirm</button>
        <button class="btn small secondary" id="vcCancelBtn">✕ Cancel</button>
      </div>
    </div>`);
  document.getElementById('vcSaveBtn').addEventListener('click', confirmPendingAction);
  document.getElementById('vcCancelBtn').addEventListener('click', cancelPendingAction);
}
async function confirmPendingAction(){
  if(!pendingAction) return;
  if(pendingAction.type==='transaction'){
    const el = id=>document.getElementById(id);
    const amountEl = el('vc_amount');
    const draft = pendingAction.draft;
    const finalDraft = amountEl ? {
      type: el('vc_type').value, amount: parseFloat(amountEl.value), category: el('vc_category').value,
      date: el('vc_date').value || todayStr(), mode: el('vc_mode').value, account: el('vc_account').value,
      item: el('vc_item').value.trim(), subcategory: draft.subcategory||''
    } : draft;
    if(!finalDraft.amount || finalDraft.amount<=0){ showOutput('<div class="empty-note">Enter a valid amount before saving.</div>'); return; }
    const txn = { id:uid(), type:finalDraft.type, date:finalDraft.date||todayStr(), time:'', category:finalDraft.category,
      subcategory:finalDraft.subcategory||'', item:finalDraft.item||'', amount:finalDraft.amount, account:finalDraft.account,
      mode:finalDraft.mode, notes:'Added via voice assistant', tags:[] };
    state.transactions.push(txn);
    await saveTransactions();
    const msg = `Saved ✓ — ${fmt(txn.amount)} ${txn.type} logged under ${txn.category}.`;
    showOutput(`<div class="voice-answer-card">${msg}</div>`); speak(msg);
    addSessionEntry(`✅ ${msg}`);
    logVoiceCommand(pendingAction.raw, `Logged ${fmt(txn.amount)} ${txn.type} — ${txn.category}`, 'Confirmed');
    try{
      refreshAllCharts();
      if(document.getElementById('view-transactions')?.classList.contains('active')) renderTransactions();
    }catch(e){ /* chart/render refresh is best-effort — the save itself already succeeded and was reported above */ }
  } else if(pendingAction.type==='goalContribution'){
    const g = pendingAction.goal;
    g.contributions.push({ id:uid(), date:pendingAction.date||todayStr(), amount:pendingAction.amount });
    await saveGoals();
    const msg = `Saved ✓ — added ${fmt(pendingAction.amount)} to ${g.name}.`;
    showOutput(`<div class="voice-answer-card">${msg}</div>`); speak(msg);
    addSessionEntry(`✅ ${msg}`);
    logVoiceCommand(pendingAction.raw, `Contribution ${fmt(pendingAction.amount)} \u2192 ${g.name}`, 'Confirmed');
    try{ if(document.getElementById('view-goals')?.classList.contains('active')) renderGoals(); }catch(e){ /* best-effort refresh */ }
  } else if(pendingAction.type==='goalStatus'){
    const g = pendingAction.goal;
    if(pendingAction.newState==='paused') g.paused = true;
    else if(pendingAction.newState==='resumed') g.paused = false;
    else if(pendingAction.newState==='completed'){ g.achieved = true; g.paused = false; }
    await saveGoals();
    const msg = `Saved ✓ — ${g.name} marked as ${pendingAction.newState}.`;
    showOutput(`<div class="voice-answer-card">${msg}</div>`); speak(msg);
    addSessionEntry(`✅ ${msg}`);
    logVoiceCommand(pendingAction.raw, `${g.name} \u2192 ${pendingAction.newState}`, 'Confirmed');
    try{ if(document.getElementById('view-goals')?.classList.contains('active')) renderGoals(); }catch(e){ /* best-effort refresh */ }
  }
  pendingAction = null;
  maybeRestartContinuous();
}
function cancelPendingAction(){
  if(!pendingAction) return;
  const msg = 'Cancelled — nothing was saved.';
  showOutput(`<div class="empty-note">${msg}</div>`); speak(msg);
  addSessionEntry(`🚫 ${msg}`);
  logVoiceCommand(pendingAction.raw, 'No action taken', 'Cancelled');
  pendingAction = null;
  maybeRestartContinuous();
}
function askClarification(transcript, question){
  showOutput(`<div class="voice-answer-card">${escapeHtml(question)}</div>`); speak(question);
  addSessionEntry(`❓ ${question}`);
  logVoiceCommand(transcript, question, 'Failed to understand');
  maybeRestartContinuous();
}
function askUnrecognized(transcript){
  const msg = "I didn't understand that command.";
  showOutput(`<div class="voice-answer-card"><b>${msg}</b><div class="voice-examples" style="margin-top:8px;">
    <div>Try: <code>Add 200 for coffee</code></div>
    <div><code>What's my balance?</code></div>
    <div><code>Open goals</code></div>
    <div><code>Check if I can afford 3000 for shoes</code></div>
  </div></div>`);
  speak(msg);
  addSessionEntry(`❓ ${msg} Heard: "${transcript}"`);
  logVoiceCommand(transcript, 'Not understood', 'Failed to understand');
  maybeRestartContinuous();
}

/* ---------------- main dispatcher ---------------- */
function processTranscript(transcript, confidence){
  if(!transcript || !transcript.trim()){
    logVoiceCommand('', 'Nothing heard', 'Failed to understand');
    return;
  }
  addSessionEntry(`🎤 Heard: "${transcript}"`);
  clearInterval(continuousCountdownTimer);
  document.getElementById('voiceConvBanner')?.classList.add('hidden');

  if(pendingAction){
    const t = transcript.toLowerCase();
    if(/\b(yes|haan|ha|save it|save this|confirm|ok|okay|theek hai)\b/.test(t)){ confirmPendingAction(); return; }
    if(/\b(no|nahi|cancel|discard)\b/.test(t)){ cancelPendingAction(); return; }
    logVoiceCommand(pendingAction.raw, 'Superseded by a new command', 'Cancelled');
    pendingAction = null;
  }

  if(typeof confidence==='number' && confidence>0 && confidence<0.4){
    const msg = `I'm not confident I heard that correctly: "${transcript}". Please confirm or try again.`;
    showOutput(`<div class="voice-answer-card">${escapeHtml(msg)}</div>`);
    speak("I'm not confident I heard that correctly. Please try again.");
    addSessionEntry(`⚠️ Low confidence: "${transcript}"`);
    logVoiceCommand(transcript, 'Low recognition confidence', 'Failed to understand');
    maybeRestartContinuous();
    return;
  }

  const t = transcript.toLowerCase();

  const q = matchQuery(transcript);
  if(q){
    const speakText = showAnswerCard(q);
    speak(speakText, state.voiceSettings.recognitionLang==='hi'?'hi-IN':'en-IN');
    addSessionEntry(`💬 ${speakText}`);
    logVoiceCommand(transcript, q.logText||speakText, 'Confirmed');
    maybeRestartContinuous();
    return;
  }

  const nav = matchNavigation(transcript);
  if(nav){
    const msg = `Opening ${nav.label}.`;
    try{ switchToView(nav.view); }catch(e){ /* view render best-effort; navigation + message still count as done */ }
    showOutput(`<div class="voice-answer-card"><b>${msg}</b></div>`); speak(msg);
    addSessionEntry(`🧭 ${msg}`);
    logVoiceCommand(transcript, `Opened ${nav.label}`, 'Confirmed');
    maybeRestartContinuous();
    return;
  }

  const fc = matchForecastRun(transcript);
  if(fc){
    forecastDays = fc.days;
    const msg = `Showing your ${fc.days}-day cash-flow forecast.`;
    try{
      switchToView('forecast');
      document.querySelectorAll('#forecastSeg button').forEach(b=>b.classList.toggle('active', parseInt(b.dataset.days)===fc.days));
      renderForecast();
    }catch(e){ /* chart render best-effort */ }
    showOutput(`<div class="voice-answer-card"><b>${msg}</b></div>`); speak(msg);
    addSessionEntry(`🔮 ${msg}`);
    logVoiceCommand(transcript, msg, 'Confirmed');
    maybeRestartContinuous();
    return;
  }

  const af = matchAffordabilityCheck(transcript);
  if(af){
    const r = computeAffordability(af.item, af.amount, af.category);
    showOutput(`<div class="voice-answer-card"><div class="verdict-title" style="font-size:16px;">${r.verdict}</div><p style="margin:6px 0 0;font-size:13.5px;">${r.reason}</p><button class="btn small secondary" style="margin-top:8px;" onclick="switchToView('affordability')">View Details</button></div>`);
    speak(`For ${fmt(af.amount)} on ${af.item}: ${r.reason}`);
    addSessionEntry(`🧮 Affordability check: ${r.verdict}`);
    logVoiceCommand(transcript, `Affordability check — ${r.verdict}`, 'Confirmed');
    maybeRestartContinuous();
    return;
  }

  const gs = matchGoalStatusChange(transcript);
  if(gs){
    if(!gs.goal){ askClarification(transcript, `I couldn't find a goal matching "${gs.goalNameRaw}". Which goal did you mean?`); return; }
    pendingAction = { type:'goalStatus', goal:gs.goal, newState:gs.newState, raw:transcript };
    showConfirmationCard_GoalStatus(gs);
    speak(`Mark ${gs.goal.name} as ${gs.newState}? Say yes to confirm.`);
    addSessionEntry(`⏳ Waiting for confirmation — mark ${gs.goal.name} as ${gs.newState}`);
    maybeRestartContinuous();
    return;
  }

  const gc = matchGoalContribution(transcript);
  if(gc){
    if(!gc.amount){ askClarification(transcript, 'How much would you like to contribute?'); return; }
    if(!gc.goal){ askClarification(transcript, `I couldn't find a goal matching "${gc.goalNameRaw}". Which goal did you mean?`); return; }
    pendingAction = { type:'goalContribution', goal:gc.goal, amount:gc.amount, date:todayStr(), raw:transcript };
    showConfirmationCard_GoalContribution(pendingAction);
    speak(`Add a contribution of ${fmt(gc.amount)} to ${gc.goal.name}? Say yes to confirm.`);
    addSessionEntry(`⏳ Waiting for confirmation — ${fmt(gc.amount)} to ${gc.goal.name}`);
    maybeRestartContinuous();
    return;
  }

  const draft = buildTransactionDraft(transcript);
  if(draft.amount){
    pendingAction = { type:'transaction', draft, raw:transcript };
    showConfirmationCard_Transaction(draft, transcript);
    speak(`I heard ${fmt(draft.amount)} ${draft.type} — ${draft.category} — ${draft.date===todayStr()?'today':draft.date} — ${draft.mode}. Save this?`);
    addSessionEntry(`⏳ Waiting for confirmation — ${fmt(draft.amount)} ${draft.type}, ${draft.category}`);
    maybeRestartContinuous();
    return;
  } else if(/(spend|spent|paid|pay|kharch|add|expense|income|received|salary)/.test(t)){
    askClarification(transcript, 'How much was it? Please say or type the amount.');
    return;
  }

  askUnrecognized(transcript);
}

/* ---------------- recognition engine ---------------- */
function updateMicButtons(listening){
  document.getElementById('voiceStartBtn')?.classList.toggle('hidden', listening);
  document.getElementById('voiceStopBtn')?.classList.toggle('hidden', !listening);
  document.getElementById('micFabBtn')?.classList.toggle('listening', listening);
  document.getElementById('voiceDot')?.classList.toggle('live', listening);
  document.getElementById('voiceWaveform')?.classList.toggle('hidden', !listening); // Sprint 24
}
function setVoiceStatus(kind, text){
  const el = document.getElementById('voiceStatusText');
  if(el) el.textContent = text || (kind==='listening' ? 'Listening…' : 'Tap the mic to start');
  updateMicButtons(kind==='listening');
}
function updateTranscriptBox(text, isFinal){
  const box = document.getElementById('voiceTranscriptBox');
  if(!box) return;
  box.innerHTML = isFinal ? `<span>${escapeHtml(text)}</span>` : `<span class="interim">${escapeHtml(text)}…</span>`;
}
function startListening(){
  if(!state.voiceSettings.enabled) return;
  if(!voiceSupported){ document.getElementById('voiceTextInput')?.focus(); return; }
  if(isListening) return;
  if(!localStorage.getItem('khaata:micExplained')){
    showOutput('<div class="voice-answer-card">🎙️ Khaata will now ask your browser for microphone access, used only to turn your speech into text on this device. No audio or financial data leaves your browser. Tap "Start Listening" again to continue.</div>');
    try{ localStorage.setItem('khaata:micExplained','1'); }catch(e){}
    return;
  }
  try{
    const langMap = { auto:'hi-IN', en:'en-IN', hi:'hi-IN' };
    recognition.lang = langMap[state.voiceSettings.recognitionLang] || 'hi-IN';
    recognition.start();
    isListening = true;
    setVoiceStatus('listening');
  }catch(e){
    setVoiceStatus('idle', 'Could not start the microphone — check browser permissions, or use the text box.');
  }
}
function stopListening(){
  if(recognition && isListening){ try{ recognition.stop(); }catch(e){} }
  isListening = false;
  updateMicButtons(false);
}
function handleRecognitionResult(event){
  let interim='', final='', confidence=null;
  for(let i=event.resultIndex; i<event.results.length; i++){
    const res = event.results[i];
    if(res.isFinal){ final += res[0].transcript; confidence = res[0].confidence; }
    else interim += res[0].transcript;
  }
  if(interim) updateTranscriptBox(interim, false);
  if(final){
    updateTranscriptBox(final, true);
    stopListening();
    processTranscript(final.trim(), confidence);
  }
}
function handleRecognitionError(e){
  isListening = false;
  updateMicButtons(false);
  if(e.error==='not-allowed' || e.error==='service-not-allowed'){
    setVoiceStatus('idle', "Microphone permission denied — you can use the text box instead, or allow mic access in your browser's site settings.");
  } else if(e.error==='no-speech'){
    setVoiceStatus('idle', "Didn't catch that — tap the mic and try again.");
  } else {
    setVoiceStatus('idle', 'Voice recognition had a problem — try again or use the text box.');
  }
}
function handleRecognitionEnd(){
  isListening = false;
  updateMicButtons(false);
  if(document.getElementById('voiceStatusText')?.textContent==='Listening…') setVoiceStatus('idle');
}
function initVoiceEngine(){
  if(voiceSupported){
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
    recognition = new SR();
    recognition.continuous = false;
    recognition.interimResults = true;
    recognition.maxAlternatives = 1;
    recognition.onresult = handleRecognitionResult;
    recognition.onerror = handleRecognitionError;
    recognition.onend = handleRecognitionEnd;
  } else {
    document.getElementById('voiceMicActions')?.classList.add('hidden');
  }
  syncVoiceSettingsUI();
}

/* ---------------- continuous conversation mode ---------------- */
function voicePanelOpen(){ return !document.getElementById('voiceOverlay').classList.contains('hidden'); }
function maybeRestartContinuous(){
  if(!state.voiceSettings.continuousMode || !voicePanelOpen()) return;
  showConvBanner();
  clearTimeout(continuousRestartTO);
  continuousRestartTO = setTimeout(()=>{ if(state.voiceSettings.continuousMode && voicePanelOpen()) startListening(); }, 900);
}
function showConvBanner(){
  document.getElementById('voiceConvBanner')?.classList.remove('hidden');
  clearInterval(continuousCountdownTimer);
  continuousSecondsLeft = 18;
  const timerEl = document.getElementById('voiceConvTimer');
  if(timerEl) timerEl.textContent = continuousSecondsLeft;
  continuousCountdownTimer = setInterval(()=>{
    continuousSecondsLeft--;
    const el = document.getElementById('voiceConvTimer');
    if(el) el.textContent = Math.max(0, continuousSecondsLeft);
    if(continuousSecondsLeft<=0) exitContinuousMode();
  }, 1000);
}
function exitContinuousMode(){
  clearInterval(continuousCountdownTimer);
  clearTimeout(continuousRestartTO);
  document.getElementById('voiceConvBanner')?.classList.add('hidden');
  stopListening();
  setVoiceStatus('idle', 'Continuous mode paused — tap the mic to continue.');
}

/* ---------------- panel open/close + bindings ---------------- */
function openVoicePanel(){
  document.getElementById('voiceOverlay').classList.remove('hidden');
  voiceSessionEntries = [];
  renderSessionLog();
  document.getElementById('voiceOutputArea').innerHTML='';
  document.getElementById('voiceTranscriptBox').innerHTML = '<span class="interim">Nothing heard yet — tap the mic and try "Add 200 for coffee".</span>';
  setVoiceStatus('idle', voiceSupported ? 'Tap the mic to start' : 'Voice input not supported on this browser — use the text box below.');
}
function closeVoicePanel(){
  document.getElementById('voiceOverlay').classList.add('hidden');
  stopListening();
  exitContinuousMode();
  pendingAction = null;
}
document.getElementById('micFabBtn').addEventListener('click', ()=>{
  // Sprint 41 — the Home-screen floating mic FAB now goes STRAIGHT into
  // a real, back-and-forth conversation via App.Voice.Bridge, instead
  // of opening the old single-shot #voiceOverlay sheet and waiting for
  // a second tap on "Start Listening". This calls the exact same
  // startConversation()/stopConversation() pair the "AI Voice Assistant
  // (Conversational)" card's mic (#veMicBtn, Sprint 19) and the chat
  // panel's mic (#chatMicBtn, Sprint 19) already call — one tap here
  // now behaves identically to a tap on either of those, including
  // opening the chat panel, pausing App.Voice.WakeWord (Sprint 40) for
  // the duration, and resuming it after. Toggle behavior matches the
  // other two mic buttons: a second tap while a conversation is active
  // stops it instead of starting a new one.
  // The OLD single-shot flow (openVoicePanel()/startListening(),
  // #voiceOverlay, #voiceStartBtn, #voiceTranscriptBox,
  // #voiceTextInput) is untouched below and still fully works — it's
  // just no longer reached from this button. It remains reachable from
  // the Voice Assistant tab/more-item via the new "Open Quick Voice
  // Commands" button on the "🎙️ Voice Assistant" card (see view-voice).
  // Guarded with a fallback: if App.Voice isn't ready for any reason
  // (e.g. a stale cached page), this button still does something useful
  // instead of silently failing.
  if (window.App && App.Voice && typeof App.Voice.startConversation === 'function') {
    if (App.Voice.isConversationActive()) App.Voice.stopConversation();
    else App.Voice.startConversation();
  } else {
    openVoicePanel();
    setTimeout(startListening, 200);
  }
});

