/* ---------------------------------------------------------------
   GOOGLE DRIVE SYNC
   Uses Google Identity Services (OAuth token client) + Drive REST API
   directly via fetch — no gapi client library needed for this scope.
   Scope used: drive.file (only touches files this app creates).
--------------------------------------------------------------- */
const DRIVE_CLIENT_ID = '661516565065-9bl0qs3jcgh35jding97qkk7eeddggk8.apps.googleusercontent.com';
const DRIVE_SCOPE = 'https://www.googleapis.com/auth/drive.file';
const DRIVE_BACKUP_FILENAME = 'khaata-backup.json';
Object.assign(App.Config, { DRIVE_CLIENT_ID, DRIVE_SCOPE, DRIVE_BACKUP_FILENAME });
let driveTokenClient = null;
let driveAccessToken = null;
let driveTokenExpiry = 0;
let driveFileId = localStorage.getItem('khaata:drivefileid') || null;
let driveAutoSyncTimer = null;

function driveSetStatus(text){
  const el = document.getElementById('driveStatusText');
  if(el) el.textContent = text;
}
function driveSetLastSync(text){
  const el = document.getElementById('driveLastSyncText');
  if(el) el.textContent = text;
}
function driveShowSignedIn(signedIn){
  document.getElementById('driveSignedOutRow')?.classList.toggle('hidden', signedIn);
  document.getElementById('driveSignedInRow')?.classList.toggle('hidden', !signedIn);
}
function driveInit(){
  if(!window.google || !google.accounts || !google.accounts.oauth2){
    driveSetStatus('Google sign-in could not load — check your internet connection and reload.');
    return;
  }
  driveTokenClient = google.accounts.oauth2.initTokenClient({
    client_id: DRIVE_CLIENT_ID,
    scope: DRIVE_SCOPE,
    callback: async (resp)=>{
      if(resp.error){ driveSetStatus('Sign-in failed — please try again.'); return; }
      driveAccessToken = resp.access_token;
      driveTokenExpiry = Date.now() + (resp.expires_in*1000 || 3300000);
      localStorage.setItem('khaata:drivesignedin','1');
      driveShowSignedIn(true);
      driveSetStatus('Signed in with Google Drive.');
      const autoOn = localStorage.getItem('khaata:driveautosync')==='1';
      const cb = document.getElementById('driveAutoSyncToggle');
      if(cb) cb.checked = autoOn;
      await driveFindExistingBackup();
    }
  });
  const wasSignedIn = localStorage.getItem('khaata:drivesignedin')==='1';
  if(wasSignedIn){
    driveShowSignedIn(true);
    driveSetStatus('Reconnecting to Google Drive…');
  }
}
function driveEnsureToken(){
  return new Promise((resolve, reject)=>{
    if(driveAccessToken && Date.now() < driveTokenExpiry - 30000){ resolve(driveAccessToken); return; }
    if(!driveTokenClient){ reject(new Error('Drive not initialised')); return; }
    driveTokenClient.callback = (resp)=>{
      if(resp.error){ reject(new Error(resp.error)); return; }
      driveAccessToken = resp.access_token;
      driveTokenExpiry = Date.now() + (resp.expires_in*1000 || 3300000);
      resolve(driveAccessToken);
    };
    driveTokenClient.requestAccessToken({prompt: driveAccessToken ? '' : 'consent'});
  });
}
async function driveFindExistingBackup(){
  try{
    const token = await driveEnsureToken();
    if(driveFileId){ driveSetLastSync('Ready — a backup file is linked in your Drive.'); return; }
    const q = encodeURIComponent(`name='${DRIVE_BACKUP_FILENAME}' and trashed=false`);
    const res = await fetch(`https://www.googleapis.com/drive/v3/files?q=${q}&spaces=drive&fields=files(id,name,modifiedTime)`, {
      headers: { Authorization: `Bearer ${token}` }
    });
    const data = await res.json();
    if(data.files && data.files.length){
      driveFileId = data.files[0].id;
      localStorage.setItem('khaata:drivefileid', driveFileId);
      driveSetLastSync('Found an existing backup in your Drive from '+new Date(data.files[0].modifiedTime).toLocaleString()+'.');
    } else {
      driveSetLastSync('No backup found yet in your Drive — tap "Backup to Drive now" to create one.');
    }
  }catch(e){ driveSetLastSync('Could not check Drive for an existing backup.'); }
}
async function driveBackupNow(silent){
  try{
    const token = await driveEnsureToken();
    const content = JSON.stringify(state, null, 2);
    const metadata = { name: DRIVE_BACKUP_FILENAME, mimeType: 'application/json' };
    let url, method;
    if(driveFileId){
      url = `https://www.googleapis.com/upload/drive/v3/files/${driveFileId}?uploadType=multipart`;
      method = 'PATCH';
    } else {
      url = `https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart`;
      method = 'POST';
    }
    const boundary = 'khaata-boundary-'+Date.now();
    const body =
      `--${boundary}\r\nContent-Type: application/json; charset=UTF-8\r\n\r\n${JSON.stringify(metadata)}\r\n`+
      `--${boundary}\r\nContent-Type: application/json\r\n\r\n${content}\r\n`+
      `--${boundary}--`;
    const res = await fetch(url, {
      method,
      headers: { Authorization: `Bearer ${token}`, 'Content-Type': `multipart/related; boundary=${boundary}` },
      body
    });
    const data = await res.json();
    if(data.id){
      driveFileId = data.id;
      localStorage.setItem('khaata:drivefileid', driveFileId);
      driveSetLastSync('Last backed up to Drive: '+new Date().toLocaleString());
      if(!silent) flash();
    } else if(!silent){ alert('Drive backup failed — please try again.'); }
  }catch(e){ if(!silent) alert('Drive backup failed — please sign in again.'); }
}
async function driveRestoreNow(){
  if(!driveFileId){ alert('No Drive backup found yet. Use "Backup to Drive now" first from another device, or check you are signed into the right Google account.'); return; }
  if(!confirm('This will replace your current data on this device with the backup from Google Drive. Continue?')) return;
  try{
    const token = await driveEnsureToken();
    const res = await fetch(`https://www.googleapis.com/drive/v3/files/${driveFileId}?alt=media`, {
      headers: { Authorization: `Bearer ${token}` }
    });
    const data = await res.json();
    if(data.transactions){
      state = {...state, ...data}; document.body.setAttribute('data-theme', state.theme||'dark');
      migrateToV2();
      await saveTransactions(); await saveBudgets(); await saveCustomCats();
      await saveAccounts(); await saveRecurring(); await saveDebts(); await saveSubcats(); await saveTags(); await saveGoals();
      await saveCreditCards(); await saveInvestments(); await saveNetWorthHistory();
      await saveInvestmentWatchlist(); await saveInvestmentHistory();
      await saveVoiceSettings(); await saveVoiceLog();
      refreshAllCharts(); populateFilterCategories(); populateBudgetCategorySelect(); populateCategorySelect(); populateAccountSelects();
      syncVoiceSettingsUI();
      alert('Restored from Google Drive.');
    } else { alert("The Drive file doesn't look like a Khaata backup."); }
  }catch(e){ alert('Could not restore from Drive — please try again.'); }
}
function driveSignOut(){
  if(driveAccessToken){ try{ google.accounts.oauth2.revoke(driveAccessToken, ()=>{}); }catch(e){} }
  driveAccessToken = null; driveTokenExpiry = 0;
  localStorage.removeItem('khaata:drivesignedin');
  driveShowSignedIn(false);
  driveSetStatus('Not signed in — your data stays only on this device unless you sign in.');
  driveSetLastSync('');
}
function driveMaybeAutoBackup(){
  if(localStorage.getItem('khaata:driveautosync')!=='1') return;
  if(localStorage.getItem('khaata:drivesignedin')!=='1') return;
  clearTimeout(driveAutoSyncTimer);
  driveAutoSyncTimer = setTimeout(()=>{ driveBackupNow(true); }, 4000);
}
document.getElementById('driveSignInBtn')?.addEventListener('click', ()=>{
  if(!driveTokenClient){ driveSetStatus('Still loading Google sign-in — please try again in a moment.'); return; }
  driveTokenClient.requestAccessToken({prompt:'consent'});
});
document.getElementById('driveSignOutBtn')?.addEventListener('click', driveSignOut);
document.getElementById('driveBackupNowBtn')?.addEventListener('click', ()=>driveBackupNow(false));
document.getElementById('driveRestoreBtn')?.addEventListener('click', driveRestoreNow);
document.getElementById('driveAutoSyncToggle')?.addEventListener('change', e=>{
  localStorage.setItem('khaata:driveautosync', e.target.checked ? '1' : '0');
});

/* ---------------------------------------------------------------
   APP MODULE WIRING
   Everything above this point still works exactly as it did before
   this sprint — no function was renamed, moved, or removed. This
   block exposes the existing functions through the App.* namespace
   declared at the top of the file, so there's one predictable place
   to look things up going forward.
--------------------------------------------------------------- */
App.Logger = {
  info: (...args)=>console.log('[Khaata]', ...args),
  warn: (...args)=>console.warn('[Khaata]', ...args),
  error: (...args)=>console.error('[Khaata]', ...args)
};

App.Events.on = (elOrId, evt, handler)=>{
  const el = typeof elOrId==='string' ? document.getElementById(elOrId) : elOrId;
  if(el) el.addEventListener(evt, handler);
  return el;
};
// NOTE: the addEventListener calls throughout this file (tabs, forms, row
// actions, Drive buttons, voice controls, etc.) are left exactly where they
// are. Many bind to elements generated dynamically at render time (e.g. a
// delete button created per table row), so moving them into a single
// upfront registration pass would change *when* they attach, not just
// *where the code lives* — that's a behavior change, which this sprint
// avoids. App.Events.on is available for new code going forward.

App.State.get = ()=>state;
App.State.charts = ()=>charts;

Object.assign(App.Storage, {
  load: loadState,
  saveTransactions, saveBudgets, saveCustomCats, saveAccounts, saveRecurring,
  saveDebts, saveSubcats, saveTags, saveGoals, saveCreditCards, saveCCUtilHistory,
  saveInvestments, saveNetWorthHistory, saveVoiceSettings, saveVoiceLog,
  saveTheme, saveSettings, saveAdvisor,
  saveInvestmentWatchlist, saveInvestmentHistory
});

/* debounce/throttle — general-purpose, added for the Smart Dashboard's
   auto-update engine but usable by any future module. Neither existed
   in the app before this sprint. */
function debounce(fn, wait){
  let t;
  function debounced(...args){ clearTimeout(t); t = setTimeout(()=>fn.apply(this,args), wait); }
  debounced.cancel = ()=>clearTimeout(t);
  return debounced;
}
function throttle(fn, wait){
  let last = 0, pending = null;
  return function throttled(...args){
    const now = Date.now();
    const remaining = wait - (now-last);
    if(remaining<=0){
      last = now; clearTimeout(pending);
      fn.apply(this,args);
    } else {
      clearTimeout(pending);
      pending = setTimeout(()=>{ last = Date.now(); fn.apply(this,args); }, remaining);
    }
  };
}

Object.assign(App.Utils, {
  fmt, todayStr, uid, sum, dateInRange, monthKey, daysBetween,
  escapeHtml, downloadFile, palette, debounce, throttle
});

Object.assign(App.Helpers, {
  expenseCats, incomeSources, allTxns, incomeTxns, expenseTxns,
  activeAccounts, accountById, accountBalance, totalMoney, subcatsFor,
  allTags, parseTagsInput, registerTags,
  debtPaid, debtRemaining, ccUtilization, essentialExpenseTxns
});

App.Notifications.flash = flash;

/* Safe global error handling — logs unexpected errors instead of letting
   them fail silently, without changing any user-facing behavior. */
window.addEventListener('error', e=>{ App.Logger.error('Uncaught error', e.error || e.message); });
window.addEventListener('unhandledrejection', e=>{ App.Logger.error('Unhandled promise rejection', e.reason); });

/* ================================================================
   VOICE ENGINE FOUNDATION  (App.Voice)
   ------------------------------------------------------------------
   Sprint scope: ARCHITECTURE ONLY.

   This block builds the modular skeleton that a future sprint will
   wire real speech recognition into. Nothing here:
     - touches the microphone
     - calls the Web Speech API
     - performs any finance action
     - talks to any network/AI/online service

   It exists purely so future work has typed, documented, testable
   seams to fill in, instead of new globals scattered through the
   file. Every method below is a placeholder: it validates input,
   updates App.Voice.State, logs through App.Voice.Logger, and
   returns a small structured result — but does no real work yet.

   IMPORTANT — this is intentionally separate from, and does not
   touch, the existing, already-functional "VOICE ASSISTANT" feature
   defined earlier in this file (the mic-fab button, voiceOverlay
   sheet, recognition/isListening variables, initVoiceEngine(),
   handleRecognitionResult, etc). That feature keeps working exactly
   as it did before this sprint. App.Voice is the foundation for
   *replacing/extending* it later — until a future sprint explicitly
   rewires things, the two simply coexist.

   Submodule map:
     App.Voice.Config       static configuration & tunable settings
     App.Voice.State        current runtime state of the voice engine
     App.Voice.Logger       scoped logging (delegates to App.Logger)
     App.Voice.Permission   microphone permission lifecycle (stubs)
     App.Voice.Language     language detection / supported locales
     App.Voice.Parser       speech text normalization & command parsing
     App.Voice.Commands     command registry (grammar definitions live
                             here in a future sprint; empty for now)
     App.Voice.Events       internal pub/sub bus, scoped to voice —
                             independent of the DOM-focused App.Events
     App.Voice.Manager      top-level orchestrator / public entry point
     App.Voice              convenience re-exports + App.Voice.initialize()
================================================================ */

/* ---- App.Voice.Config ------------------------------------------
   Static configuration and user-tunable settings for the future
   voice engine. Distinct from the *existing* state.voiceSettings
   object used by the current voice feature (that one is untouched).
   Nothing here is read by any active code path yet. */
App.Voice.Config = {
  // Supported languages. Real *detection* logic (auto-identifying which
  // language is being spoken) is still architecture-only this sprint —
  // see App.Voice.Language.detectLanguage() — but the recognizer and
  // synthesizer below DO really use these locale tags.
  SUPPORTED_LANGUAGES: Object.freeze({
    HINDI: 'hi-IN',
    ENGLISH: 'en-IN',
    HINGLISH: 'hi-en', // mixed Hindi+English, code-switched speech
    AUTO: 'auto'        // resolves to a best-effort locale at recognition time
  }),

  DEFAULT_LANGUAGE: 'auto',

  // Voice engine's finite state machine. This sprint's full state list —
  // every status App.Voice.State can hold, plus which transitions are
  // considered valid. Kept as data (not scattered if/else) so
  // App.Voice.State.set() can guard against nonsensical jumps (e.g.
  // "speaking" -> "listening" without passing through "idle").
  STATES: Object.freeze({
    UNINITIALIZED: 'uninitialized',
    IDLE: 'idle',
    LISTENING: 'listening',
    PROCESSING: 'processing',
    WAITING: 'waiting',   // engine asked something and is waiting on the user
    SPEAKING: 'speaking',  // speech synthesis is actively playing
    PAUSED: 'paused',
    STOPPED: 'stopped',    // explicitly stopped mid-session by caller/user
    ERROR: 'error'
  }),
  // From -> allowed-to list. '*' means "from any state". Used by
  // App.Voice.State.canTransition()/set() below — not enforced anywhere
  // that touches finance data, purely engine-lifecycle bookkeeping.
  STATE_TRANSITIONS: Object.freeze({
    uninitialized: ['idle', 'error'],
    idle: ['listening', 'waiting', 'speaking', 'stopped', 'error'],
    listening: ['processing', 'paused', 'idle', 'stopped', 'error'],
    processing: ['idle', 'waiting', 'speaking', 'error'],
    waiting: ['listening', 'idle', 'stopped', 'error'],
    speaking: ['idle', 'listening', 'error'],
    paused: ['listening', 'idle', 'stopped', 'error'],
    stopped: ['idle', 'listening', 'error'],
    error: ['idle', 'stopped']
  }),

  // Recognition mode placeholders. Online (browser Web Speech API) is
  // real this sprint; offline is still a future-sprint scaffold.
  RECOGNITION_MODE: Object.freeze({
    OFFLINE: 'offline', // on-device recognition (future)
    ONLINE: 'online'    // browser/cloud recognition — real this sprint
  }),
  defaultRecognitionMode: 'online',

  // User-tunable voice settings and their defaults. Persisted by
  // App.Voice.Settings under a key of its own, entirely separate from
  // the existing state.voiceSettings used by the legacy voice feature.
  SETTINGS_DEFAULTS: Object.freeze({
    speechRate: 1,            // 0.5 – 2, passed to SpeechSynthesisUtterance.rate
    speechPitch: 1,           // 0 – 2, passed to SpeechSynthesisUtterance.pitch
    speechVolume: 1,          // 0 – 1, passed to SpeechSynthesisUtterance.volume
    preferredLanguage: 'auto',// one of SUPPORTED_LANGUAGES values
    microphoneDeviceId: null, // null = browser default input device
    // ---- Sprint 19: now real, read by App.Voice.Bridge ----
    autoSpeakResponses: true, // read every App.Chat reply aloud via App.Voice.Synthesis
    continuousListening: false, // hands-free: mic re-opens after every reply, incl. during playback (barge-in). Was an inert future flag before Sprint 19; default stays false so existing users see no behavior change unless they opt in.
    confirmationMode: 'auto', // 'auto' = keep listening through Yes/No/Why prompts too; 'manual' = wait for a mic tap on confirmations
    // ---- Sprint 40: now real, read by App.Voice.WakeWord ----
    assistantName: 'Khaata', // custom name the user can give their assistant; also the wake-word phrase
    wakeWord: false,         // was an inert future flag before Sprint 40; default stays false so existing users see no behavior change unless they opt in
    // ---- still future-sprint flags (stored so UI has somewhere to
    // live, not read by any active recognition/synthesis code path yet) ----
    autoStart: false,
    offlineRecognition: false
  }),

  // Wake word support scaffold — sensitivity/phrase-object form is still
  // unused (App.Voice.WakeWord reads assistantName/wakeWord directly off
  // App.Voice.Settings instead, matching this file's existing pattern of
  // flat setting keys). Kept here only so nothing that referenced this
  // shape elsewhere breaks.
  wakeWord: {
    enabled: false,
    phrase: null,        // e.g. 'hey khaata' — reserved, not active
    sensitivity: 0.5      // 0..1, unused until implemented
  },

  // Continuous listening scaffold — disabled and unimplemented.
  continuousListening: {
    enabled: false,
    restartDelayMs: 1200,
    maxSessionMs: 30000
  },

  // Noise detection scaffold — no audio analysis is performed yet.
  noiseDetection: {
    enabled: false,
    thresholdDb: null
  },

  // Minimum confidence score (0..1) a real recognizer result needs
  // before App.Voice.Manager treats it as a usable final transcript
  // instead of flagging it as low-confidence. Not tied to finance
  // actions — this engine never executes those (see capabilities).
  minConfidence: 0.6,

  // Real, computed-once capability flags — actually probe the browser
  // instead of hardcoding. capabilities.voiceCommands/financeActions/
  // conversationAI/onlineApis stay false on purpose: this sprint is the
  // interface layer only, never command execution (that stays with the
  // existing, separate Part 2.3 voice-assistant feature).
  capabilities: Object.freeze({
    speechRecognition: !!(window.SpeechRecognition || window.webkitSpeechRecognition),
    speechSynthesis: ('speechSynthesis' in window),
    microphoneAccess: !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia),
    voiceCommands: false,
    financeActions: false,
    conversationAI: false,
    onlineApis: false
  })
};

/* ---- App.Voice.State --------------------------------------------
   Single source of truth for the voice engine's current runtime
   status. Plain object + accessor functions (matches the pattern
   App.State already uses elsewhere in this file) rather than a
   class, to keep this consistent with the rest of the codebase. */
App.Voice._state = {
  status: 'uninitialized', // one of App.Voice.Config.STATES
  language: App.Voice.Config.DEFAULT_LANGUAGE,
  recognitionMode: App.Voice.Config.defaultRecognitionMode,
  lastTranscript: '',
  lastInterimTranscript: '',
  lastConfidence: null,
  lastCommand: null,
  lastError: null,
  permission: 'unknown', // unknown | granted | denied | prompt | unsupported
  sessionStartedAt: null,
  sessionId: null
};

App.Voice.State = {
  get: () => ({ ...App.Voice._state }), // shallow copy — read-only outward

  /** Checks the STATE_TRANSITIONS map. A `status` outside the known
   *  transitions for the current status is rejected by set() below
   *  rather than silently accepted, so the 8-state machine (Idle,
   *  Listening, Processing, Waiting, Speaking, Paused, Stopped, Error)
   *  can't drift into an inconsistent UI. */
  canTransition(nextStatus) {
    const from = App.Voice._state.status;
    const allowed = App.Voice.Config.STATE_TRANSITIONS[from];
    return !allowed || allowed.includes(nextStatus); // unknown `from` = permissive
  },

  set: (patch) => {
    if (!patch || typeof patch !== 'object') {
      App.Voice.Logger.warn('State.set called with a non-object patch; ignored.', patch);
      return App.Voice.State.get();
    }
    if (patch.status && patch.status !== App.Voice._state.status && !App.Voice.State.canTransition(patch.status)) {
      App.Voice.Logger.warn(`State.set() blocked invalid transition ${App.Voice._state.status} -> ${patch.status}`);
      return App.Voice.State.get();
    }
    Object.assign(App.Voice._state, patch);
    App.Voice.Events.emit('state:change', App.Voice.State.get());
    return App.Voice.State.get();
  },
  reset: () => {
    App.Voice._state = {
      status: 'idle',
      language: App.Voice.Config.DEFAULT_LANGUAGE,
      recognitionMode: App.Voice.Config.defaultRecognitionMode,
      lastTranscript: '',
      lastInterimTranscript: '',
      lastConfidence: null,
      lastCommand: null,
      lastError: null,
      permission: App.Voice._state ? App.Voice._state.permission : 'unknown',
      sessionStartedAt: null,
      sessionId: null
    };
    App.Voice.Events.emit('state:reset', App.Voice.State.get());
    return App.Voice.State.get();
  }
};

/* ---- App.Voice.Logger --------------------------------------------
   Thin, scoped wrapper around App.Logger so every future voice-engine
   log line is easy to filter in devtools ("[Khaata:Voice]") without
   duplicating console plumbing. */
App.Voice.Logger = {
  info: (...args) => App.Logger.info('[Voice]', ...args),
  warn: (...args) => App.Logger.warn('[Voice]', ...args),
  error: (...args) => App.Logger.error('[Voice]', ...args)
};

/* ---- App.Voice.Events ---------------------------------------------
   Minimal internal pub/sub bus, scoped to the voice engine. Kept
   separate from App.Events (which wires DOM listeners) because voice
   lifecycle events (e.g. 'listening:start', 'command:parsed') aren't
   DOM events and future non-DOM consumers (tests, other modules)
   shouldn't need a DOM element to subscribe. */
App.Voice.Events = (() => {
  const listeners = {};
  return {
    on(eventName, handler) {
      if (typeof handler !== 'function') {
        App.Voice.Logger.warn('Events.on called without a function handler for', eventName);
        return () => {};
      }
      (listeners[eventName] = listeners[eventName] || []).push(handler);
      // returns an unsubscribe function for convenience
      return () => App.Voice.Events.off(eventName, handler);
    },
    off(eventName, handler) {
      if (!listeners[eventName]) return;
      listeners[eventName] = listeners[eventName].filter(h => h !== handler);
    },
    emit(eventName, payload) {
      (listeners[eventName] || []).forEach(handler => {
        try {
          handler(payload);
        } catch (err) {
          App.Voice.Logger.error(`Listener for "${eventName}" threw`, err);
        }
      });
    },
    clear(eventName) {
      if (eventName) delete listeners[eventName];
      else Object.keys(listeners).forEach(k => delete listeners[k]);
    }
  };
})();

/* ---- App.Voice.Settings ----------------------------------------------
   Persisted, user-tunable settings for the *new* voice engine: speech
   rate/pitch/volume, preferred language, microphone selection, plus the
   still-inert future flags (auto start, continuous listening, wake
   word, offline recognition). Stored under its own localStorage key —
   'khaata:voiceEngineSettings' — completely separate from the legacy
   state.voiceSettings object the Part 2.3 feature already owns, so
   neither feature can clobber the other's saved preferences. */
App.Voice.Settings = (() => {
  const STORAGE_KEY = 'khaata:voiceEngineSettings';
  let current = { ...App.Voice.Config.SETTINGS_DEFAULTS };
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) current = { ...current, ...JSON.parse(raw) };
  } catch (e) { App.Voice.Logger.warn('Settings — failed to load saved settings', e); }

  function persist() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(current)); }
    catch (e) { App.Voice.Logger.warn('Settings — failed to save settings', e); }
  }

  return {
    get: () => ({ ...current }),
    /** Merges a partial settings patch, clamping numeric ranges so a
     *  stray value (e.g. from a manually-edited localStorage blob)
     *  can never produce an invalid SpeechSynthesisUtterance. */
    set(patch) {
      if (!patch || typeof patch !== 'object') return App.Voice.Settings.get();
      const clamp = (v, lo, hi, fallback) => {
        const n = Number(v);
        return Number.isFinite(n) ? Math.min(hi, Math.max(lo, n)) : fallback;
      };
      const next = { ...current, ...patch };
      next.speechRate = clamp(next.speechRate, 0.5, 2, current.speechRate);
      next.speechPitch = clamp(next.speechPitch, 0, 2, current.speechPitch);
      next.speechVolume = clamp(next.speechVolume, 0, 1, current.speechVolume);
      current = next;
      persist();
      App.Voice.Events.emit('settings:change', App.Voice.Settings.get());
      return App.Voice.Settings.get();
    },
    reset() {
      current = { ...App.Voice.Config.SETTINGS_DEFAULTS };
      persist();
      App.Voice.Events.emit('settings:change', App.Voice.Settings.get());
      return App.Voice.Settings.get();
    }
  };
})();

/* ---- App.Voice.Permission ------------------------------------------
   Real microphone-permission lifecycle. Uses the Permissions API where
   available for a passive check() (no prompt), and getUserMedia() for
   an explicit request() the user has to approve/deny in their browser.
   Crucially, request() immediately stops any media stream tracks it
   opens — it only ever uses the mic to *ask permission*, never to
   record, analyze, or transmit audio. Falls back to 'unsupported' on
   browsers/contexts lacking either API (e.g. insecure http origins). */
App.Voice.Permission = {
  /** Passive check — never prompts the browser. Uses the Permissions
   *  API when present; otherwise falls back to whatever App.Voice
   *  already has recorded from a prior request() call. */
  async check() {
    if (!(navigator.permissions && navigator.permissions.query)) {
      App.Voice.Logger.info('Permission.check() — Permissions API unavailable; using last known status.');
      return App.Voice.State.get().permission || 'unknown';
    }
    try {
      const status = await navigator.permissions.query({ name: 'microphone' });
      App.Voice.State.set({ permission: status.state }); // 'granted' | 'denied' | 'prompt'
      // Keep App.Voice.State in sync if the user changes the OS/browser
      // permission later (e.g. via the site settings padlock), without
      // needing another explicit check() call.
      status.onchange = () => {
        App.Voice.State.set({ permission: status.state });
        App.Voice.Events.emit('permission:change', status.state);
      };
      return status.state;
    } catch (err) {
      App.Voice.Logger.warn('Permission.check() — query failed', err);
      return App.Voice.State.get().permission || 'unknown';
    }
  },
  /** Actively prompts the browser for microphone access. Resolves to
   *  'granted' or 'denied'; resolves (never rejects) to 'unsupported'
   *  if the browser has no getUserMedia at all. */
  async request() {
    if (!App.Voice.Config.capabilities.microphoneAccess) {
      App.Voice.Logger.info('Permission.request() — getUserMedia unsupported in this browser.');
      App.Voice.State.set({ permission: 'unsupported' });
      return 'unsupported';
    }
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      stream.getTracks().forEach(t => t.stop()); // never keep the mic open here
      App.Voice.State.set({ permission: 'granted' });
      App.Voice.Events.emit('permission:change', 'granted');
      return 'granted';
    } catch (err) {
      App.Voice.Logger.info('Permission.request() — denied or dismissed', err && err.name);
      App.Voice.State.set({ permission: 'denied' });
      App.Voice.Events.emit('permission:change', 'denied');
      return 'denied';
    }
  }
};

/* ---- App.Voice.Microphone --------------------------------------------
   Microphone *status* + device-selection manager. Separate from
   Permission (which only tracks yes/no access) so future UI can show
   "3 microphones found, using: Built-in Mic" without conflating the
   two concerns. Device *labels* are only populated by the browser once
   permission has been granted at least once — before that, devices
   still enumerate but with blank labels, which is standard browser
   privacy behavior and not a bug here. */
App.Voice.Microphone = {
  async listDevices() {
    if (!(navigator.mediaDevices && navigator.mediaDevices.enumerateDevices)) {
      App.Voice.Logger.info('Microphone.listDevices() — enumerateDevices unsupported.');
      return [];
    }
    try {
      const devices = await navigator.mediaDevices.enumerateDevices();
      return devices
        .filter(d => d.kind === 'audioinput')
        .map((d, i) => ({ deviceId: d.deviceId, label: d.label || `Microphone ${i + 1}` }));
    } catch (err) {
      App.Voice.Logger.warn('Microphone.listDevices() failed', err);
      return [];
    }
  },
  selectDevice(deviceId) {
    App.Voice.Settings.set({ microphoneDeviceId: deviceId || null });
    App.Voice.Events.emit('microphone:selected', deviceId || null);
    return App.Voice.Settings.get().microphoneDeviceId;
  },
  async getStatus() {
    const devices = await App.Voice.Microphone.listDevices();
    return {
      permission: App.Voice.State.get().permission,
      deviceCount: devices.length,
      selectedDeviceId: App.Voice.Settings.get().microphoneDeviceId,
      devices
    };
  }
};

/* ---- App.Voice.Language ---------------------------------------------
   Scaffold for Hindi / English / Hinglish / future-language support.
   No real detection logic yet — detectLanguage() returns the
   configured default so downstream code has something well-formed
   to consume once this is implemented for real. */
App.Voice.Language = {
  supported() {
    return { ...App.Voice.Config.SUPPORTED_LANGUAGES };
  },
  /** Real, but deliberately simple: maps a *chosen* SUPPORTED_LANGUAGES
   *  value to a concrete BCP-47 tag the SpeechRecognition/Synthesis
   *  APIs understand. This is NOT auto-detection — it's just settings
   *  resolution — so it stays legitimate to implement for real even
   *  while true "listen and guess the language" detection is
   *  architecture-only this sprint (see detectLanguage() below). */
  resolveLocale(preferred = App.Voice.Settings.get().preferredLanguage) {
    const L = App.Voice.Config.SUPPORTED_LANGUAGES;
    if (preferred === L.HINDI) return 'hi-IN';
    if (preferred === L.ENGLISH) return 'en-IN';
    if (preferred === L.HINGLISH) return 'en-IN'; // Web Speech has no native hi-en tag; English acoustic model reads code-switched speech best
    return 'en-IN'; // 'auto' fallback until real detection lands
  },
  /** Placeholder language detector. Real implementation (future
   *  sprint) will inspect transcript text/audio and return a best
   *  guess among SUPPORTED_LANGUAGES, with a confidence score. */
  detectLanguage(transcript = '') {
    App.Voice.Logger.info('Language.detectLanguage() — placeholder, returning default language.');
    return {
      language: App.Voice.Config.DEFAULT_LANGUAGE,
      confidence: 0,
      transcriptSample: typeof transcript === 'string' ? transcript.slice(0, 0) : '' // intentionally not inspected
    };
  }
};

/* ---- App.Voice.Parser -----------------------------------------------
   Scaffold for turning raw recognized speech into a normalized
   string and, eventually, a structured command. Both methods are
   pass-through placeholders this sprint. */
App.Voice.Parser = {
  /** Would lower-case, trim, strip filler words, expand Hinglish
   *  shorthand, etc. This sprint: trims whitespace only, so callers
   *  get a defined, testable contract without any real NLP. */
  normalizeSpeech(rawText = '') {
    if (typeof rawText !== 'string') {
      App.Voice.Logger.warn('Parser.normalizeSpeech() received a non-string; coercing.', rawText);
      rawText = String(rawText ?? '');
    }
    const normalized = rawText.trim();
    App.Voice.Logger.info('Parser.normalizeSpeech() — placeholder normalization applied.');
    return normalized;
  },
  /** Would match normalized text against App.Voice.Commands and
   *  return a structured { intent, entities, confidence } result.
   *  This sprint always returns an "unrecognized" result — no
   *  command grammar has been implemented yet. */
  parseCommand(normalizedText = '') {
    App.Voice.Logger.info('Parser.parseCommand() — placeholder, no command grammar implemented yet.');
    return {
      recognized: false,
      intent: null,
      entities: {},
      confidence: 0,
      rawText: normalizedText
    };
  }
};

/* ---- App.Voice.Commands ---------------------------------------------
   Registry for future voice-command definitions (grammar, intents,
   required entities, confirmation copy, etc). Empty this sprint —
   deliberately no finance-related commands are registered, per the
   "no voice commands / no finance actions" scope. Provides register/
   list/find so App.Voice.Parser has a real registry to query once
   commands are added, without changing this file's public shape
   later. */
App.Voice.Commands = (() => {
  const registry = new Map();
  return {
    /** Register a command definition for future use. Shape is
     *  intentionally loose this sprint: { id, patterns, handler }.
     *  No handler is ever invoked this sprint. */
    register(commandDef) {
      if (!commandDef || !commandDef.id) {
        App.Voice.Logger.warn('Commands.register() requires a commandDef with an id; ignored.', commandDef);
        return false;
      }
      if (registry.has(commandDef.id)) {
        App.Voice.Logger.warn(`Commands.register() — "${commandDef.id}" already registered; overwriting.`);
      }
      registry.set(commandDef.id, commandDef);
      App.Voice.Logger.info(`Commands.register() — registered placeholder command "${commandDef.id}".`);
      return true;
    },
    unregister(id) {
      return registry.delete(id);
    },
    list() {
      return Array.from(registry.values());
    },
    find(id) {
      return registry.get(id) || null;
    },
    clear() {
      registry.clear();
    }
  };
})();

/* ---- App.Voice.Recognition --------------------------------------------
   Real Web Speech API (SpeechRecognition) wrapper, with proper fallback
   when the browser doesn't support it. This is the "REAL voice
   interaction foundation" piece: it actually listens and emits
   transcripts — but it never interprets them into finance commands or
   executes anything. That stays out of scope this sprint (and remains
   the separate, existing Part 2.3 feature). One lazily-created
   recognizer instance is reused across start/stop/restart calls;
   naming everything with a `_` prefix / closure keeps it from
   colliding with the legacy feature's own top-level `recognition`
   variable defined earlier in this file. */
App.Voice.Recognition = (() => {
  const Ctor = window.SpeechRecognition || window.webkitSpeechRecognition;
  let instance = null;
  let manuallyStopped = false;

  function build() {
    const rec = new Ctor();
    rec.continuous = false;
    rec.interimResults = true;
    rec.maxAlternatives = 1;
    rec.lang = App.Voice.Language.resolveLocale();

    rec.onstart = () => {
      App.Voice.State.set({ status: App.Voice.Config.STATES.LISTENING, lastError: null });
      App.Voice.Events.emit('recognition:start', App.Voice.State.get());
    };
    rec.onresult = (evt) => {
      let interim = '', final = '', bestConfidence = 0;
      for (let i = evt.resultIndex; i < evt.results.length; i++) {
        const res = evt.results[i];
        if (res.isFinal) { final += res[0].transcript; bestConfidence = res[0].confidence || 0; }
        else interim += res[0].transcript;
      }
      if (interim) {
        App.Voice.State.set({ lastInterimTranscript: interim });
        App.Voice.Events.emit('recognition:interim', interim);
      }
      if (final) {
        App.Voice.Session.addTranscript({ text: final, confidence: bestConfidence, final: true });
        App.Voice.Events.emit('recognition:final', { transcript: final, confidence: bestConfidence });
        App.Voice.Manager.processSpeech(final, bestConfidence);
      }
    };
    rec.onerror = (evt) => {
      App.Voice.Logger.warn('Recognition error', evt.error);
      if (evt.error === 'not-allowed' || evt.error === 'permission-denied') {
        App.Voice.State.set({ permission: 'denied' });
      }
      // 'no-speech' / 'aborted' are routine (user paused, or we called
      // stop() ourselves) — don't escalate those to the ERROR state, but
      // DO tell any listener (Sprint 19: App.Voice.Bridge's hands-free
      // conversation loop) that nothing was heard, so it can decide
      // whether to quietly retry a couple of times.
      if (evt.error === 'no-speech' || evt.error === 'aborted') {
        if (evt.error === 'no-speech') App.Voice.Events.emit('recognition:nospeech', {});
        return;
      }
      App.Voice.State.set({ status: App.Voice.Config.STATES.ERROR, lastError: evt.error });
      App.Voice.Events.emit('recognition:error', evt.error);
    };
    rec.onend = () => {
      App.Voice.Events.emit('recognition:end', App.Voice.State.get());
      const { status } = App.Voice.State.get();
      // Only auto-settle to idle if we weren't deliberately moved
      // elsewhere (e.g. into 'processing'/'paused'/'error') while the
      // recognizer was shutting down.
      if (status === App.Voice.Config.STATES.LISTENING) {
        App.Voice.State.set({ status: manuallyStopped ? App.Voice.Config.STATES.STOPPED : App.Voice.Config.STATES.IDLE });
      }
      manuallyStopped = false;
    };
    return rec;
  }

  return {
    isSupported: () => !!Ctor,
    /** Starts (or restarts, if reused after settings changed) a
     *  listening session. Resolves the configured device via the
     *  `deviceId` constraint isn't directly supported by
     *  SpeechRecognition itself — device selection instead governs
     *  which input getUserMedia would use for permission purposes;
     *  the browser's own default recognition input is used for actual
     *  capture, which is a documented Web Speech API limitation. */
    start() {
      if (!Ctor) {
        App.Voice.Logger.info('Recognition.start() — SpeechRecognition unsupported; caller should fall back to text input.');
        return { ok: false, reason: 'unsupported' };
      }
      try {
        instance = instance || build();
        instance.lang = App.Voice.Language.resolveLocale();
        // Sprint 19 — reflect the real "Continuous listening" setting on
        // every start() call (not just at build() time) so toggling it
        // mid-session takes effect on the next listen without needing a
        // page reload.
        instance.continuous = !!App.Voice.Settings.get().continuousListening;
        manuallyStopped = false;
        instance.start();
        return { ok: true };
      } catch (err) {
        // Most commonly thrown when start() is called while already
        // running — treat as a soft no-op rather than an engine error.
        App.Voice.Logger.warn('Recognition.start() threw (likely already running)', err);
        return { ok: false, reason: String(err && err.message || err) };
      }
    },
    stop() {
      manuallyStopped = true;
      try { instance && instance.stop(); } catch (e) { /* no active session — fine */ }
      return { ok: true };
    },
    /** Hard-cancel — discards results-in-flight rather than finalizing
     *  them. Used by Manager.cancelAction()/resetSession(). */
    abort() {
      manuallyStopped = true;
      try { instance && instance.abort(); } catch (e) { /* nothing to abort */ }
      return { ok: true };
    }
  };
})();

/* ---- App.Voice.Synthesis ------------------------------------------------
   Real SpeechSynthesis wrapper honoring App.Voice.Settings (rate/pitch/
   volume/language). Kept entirely separate from the existing top-level
   speak() function the Part 2.3 feature already uses for command
   confirmations — that function is untouched and keeps working exactly
   as before. This is a parallel capability for the new engine, not a
   replacement, until a future sprint explicitly rewires things. */
App.Voice.Synthesis = {
  isSupported: () => ('speechSynthesis' in window),
  speak(text, opts = {}) {
    if (!App.Voice.Synthesis.isSupported() || !text) {
      return { ok: false, reason: 'unsupported-or-empty' };
    }
    try {
      window.speechSynthesis.cancel(); // never overlap utterances
      const settings = App.Voice.Settings.get();
      const utter = new SpeechSynthesisUtterance(text);
      utter.rate = opts.rate ?? settings.speechRate;
      utter.pitch = opts.pitch ?? settings.speechPitch;
      utter.volume = opts.volume ?? settings.speechVolume;
      utter.lang = opts.lang || App.Voice.Language.resolveLocale();
      utter.onstart = () => {
        App.Voice.State.set({ status: App.Voice.Config.STATES.SPEAKING });
        App.Voice.Events.emit('synthesis:start', text);
      };
      utter.onend = () => {
        App.Voice.State.set({ status: App.Voice.Config.STATES.IDLE });
        App.Voice.Events.emit('synthesis:end', text);
      };
      utter.onerror = (e) => {
        App.Voice.Logger.warn('Synthesis error', e.error);
        App.Voice.Events.emit('synthesis:error', e.error);
      };
      window.speechSynthesis.speak(utter);
      return { ok: true };
    } catch (err) {
      App.Voice.Logger.error('Synthesis.speak() failed', err);
      return { ok: false, error: String(err && err.message || err) };
    }
  },
  cancel() {
    try { window.speechSynthesis && window.speechSynthesis.cancel(); } catch (e) {}
    if (App.Voice.State.get().status === App.Voice.Config.STATES.SPEAKING) {
      App.Voice.State.set({ status: App.Voice.Config.STATES.IDLE });
    }
  }
};

/* ---- App.Voice.Session -------------------------------------------------
   Voice *session* manager — distinct from App.Voice.State (which is
   just "what's happening right now"). A session groups everything that
   happened between a startListening()/initialize() and a stopListening
   ()/resetSession(): its transcripts and a short state-transition
   trail, for a future UI transcript/history view. Persists a capped
   history list, mirroring the pattern state.voiceLog already uses for
   the legacy feature, but under its own storage key. */
App.Voice.Session = (() => {
  const STORAGE_KEY = 'khaata:voiceEngineSessions';
  let current = null;
  let history = [];
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (raw) history = JSON.parse(raw) || [];
  } catch (e) { App.Voice.Logger.warn('Session — failed to load history', e); }

  function persist() {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(history.slice(0, 50))); }
    catch (e) { App.Voice.Logger.warn('Session — failed to save history', e); }
  }

  return {
    start() {
      current = { id: 'vs_' + Date.now().toString(36) + Math.random().toString(36).slice(2, 7), startedAt: Date.now(), endedAt: null, transcripts: [] };
      App.Voice.State.set({ sessionId: current.id, sessionStartedAt: current.startedAt });
      App.Voice.Events.emit('session:start', { ...current });
      return { ...current };
    },
    addTranscript(entry) {
      if (!current) App.Voice.Session.start();
      current.transcripts.push({ ...entry, ts: Date.now() });
      App.Voice.Events.emit('session:transcript', { ...entry, ts: Date.now() });
      return current.transcripts.length;
    },
    end() {
      if (!current) return null;
      current.endedAt = Date.now();
      history.unshift({ ...current });
      persist();
      App.Voice.Events.emit('session:end', { ...current });
      const finished = { ...current };
      current = null;
      App.Voice.State.set({ sessionId: null, sessionStartedAt: null });
      return finished;
    },
    /** Safe "wipe the slate clean" method — discards the current
     *  session WITHOUT saving it to history (unlike end()), for the
     *  "Reset Session" control. */
    reset() {
      current = null;
      App.Voice.State.set({ sessionId: null, sessionStartedAt: null, lastTranscript: '', lastInterimTranscript: '', lastCommand: null, lastError: null });
      App.Voice.Events.emit('session:reset', {});
      return null;
    },
    getCurrent: () => (current ? { ...current } : null),
    getHistory: () => history.slice(0, 50)
  };
})();

/* ---- App.Voice.Manager -----------------------------------------------
   Top-level orchestrator. This is the surface a future UI (and,
   eventually, a rewritten voice-assistant sheet) would call into.
   Every method:
     - guards against being called in the wrong state
     - updates App.Voice.State
     - logs via App.Voice.Logger
     - emits an App.Voice.Events event
     - returns a small structured result object
   and does NOT touch the microphone, the network, or app data. */
App.Voice.Manager = {
  /** Sets up the voice engine: resets state/session, does a passive
   *  permission check (never prompts), and reports real capabilities.
   *  Safe to call multiple times — does not itself touch the mic. */
  async initialize() {
    try {
      App.Voice.State.reset();
      App.Voice.Session.reset();
      try { await App.Voice.Permission.check(); } catch (e) { /* non-fatal */ }
      App.Voice.State.set({ status: App.Voice.Config.STATES.IDLE });
      App.Voice.Logger.info('Manager.initialize() — voice engine ready.', App.Voice.Config.capabilities);
      App.Voice.Events.emit('lifecycle:initialized', App.Voice.State.get());
      return { ok: true, status: App.Voice.State.get().status, capabilities: App.Voice.Config.capabilities };
    } catch (err) {
      App.Voice.Logger.error('Manager.initialize() failed', err);
      App.Voice.State.set({ status: App.Voice.Config.STATES.ERROR, lastError: String(err && err.message || err) });
      return { ok: false, error: String(err && err.message || err) };
    }
  },

  /** Starts a real listening session (Web Speech API) when supported,
   *  with a documented, safe fallback when it isn't: the caller gets
   *  { ok:false, reason:'unsupported' } and should fall back to the
   *  text-input path, exactly like the existing Part 2.3 feature
   *  already does for unsupported browsers. Requests microphone
   *  permission first if it hasn't been resolved yet. */
  async startListening() {
    try {
      const { status, permission } = App.Voice.State.get();
      if (status === App.Voice.Config.STATES.LISTENING) {
        App.Voice.Logger.warn('Manager.startListening() called while already listening; ignored.');
        return { ok: false, reason: 'already-listening' };
      }
      if (!App.Voice.Recognition.isSupported()) {
        App.Voice.Logger.info('Manager.startListening() — SpeechRecognition unsupported; use text-input fallback.');
        App.Voice.State.set({ status: App.Voice.Config.STATES.STOPPED, lastError: 'unsupported' });
        return { ok: false, reason: 'unsupported' };
      }
      if (permission !== 'granted') {
        const result = await App.Voice.Permission.request();
        if (result !== 'granted') {
          App.Voice.State.set({ status: App.Voice.Config.STATES.ERROR, lastError: 'permission-' + result });
          return { ok: false, reason: 'permission-' + result };
        }
      }
      if (!App.Voice.Session.getCurrent()) App.Voice.Session.start();
      const res = App.Voice.Recognition.start();
      if (!res.ok) {
        App.Voice.State.set({ status: App.Voice.Config.STATES.ERROR, lastError: res.reason });
        return res;
      }
      App.Voice.Manager.showListeningIndicator();
      App.Voice.Events.emit('listening:start', App.Voice.State.get());
      return { ok: true, status: App.Voice.Config.STATES.LISTENING };
    } catch (err) {
      App.Voice.Logger.error('Manager.startListening() failed', err);
      App.Voice.State.set({ status: App.Voice.Config.STATES.ERROR, lastError: String(err && err.message || err) });
      return { ok: false, error: String(err && err.message || err) };
    }
  },

  /** Gracefully ends a listening session — recognition is allowed to
   *  finish delivering any final result already in flight. */
  stopListening() {
    try {
      App.Voice.Recognition.stop();
      App.Voice.Manager.hideListeningIndicator();
      App.Voice.Logger.info('Manager.stopListening() — recognition stop requested.');
      App.Voice.Events.emit('listening:stop', App.Voice.State.get());
      return { ok: true };
    } catch (err) {
      App.Voice.Logger.error('Manager.stopListening() failed', err);
      return { ok: false, error: String(err && err.message || err) };
    }
  },

  /** Pauses an in-progress session (e.g. user switches tabs). The Web
   *  Speech API has no native pause, so this stops active recognition
   *  while keeping the session (and its transcripts) alive — resume()
   *  starts a fresh recognizer pass without losing session context. */
  pauseListening() {
    const { status } = App.Voice.State.get();
    if (status !== App.Voice.Config.STATES.LISTENING) {
      App.Voice.Logger.warn('Manager.pauseListening() called while not listening; ignored.');
      return { ok: false, reason: 'not-listening' };
    }
    App.Voice.Recognition.stop();
    App.Voice.State.set({ status: App.Voice.Config.STATES.PAUSED });
    App.Voice.Logger.info('Manager.pauseListening() — recognition paused.');
    App.Voice.Events.emit('listening:pause', App.Voice.State.get());
    return { ok: true, status: 'paused' };
  },

  /** Resume counterpart to pauseListening(). */
  async resumeListening() {
    const { status } = App.Voice.State.get();
    if (status !== App.Voice.Config.STATES.PAUSED) {
      App.Voice.Logger.warn('Manager.resumeListening() called while not paused; ignored.');
      return { ok: false, reason: 'not-paused' };
    }
    const res = App.Voice.Recognition.start();
    if (!res.ok) return res;
    App.Voice.State.set({ status: App.Voice.Config.STATES.LISTENING });
    App.Voice.Logger.info('Manager.resumeListening() — recognition resumed.');
    App.Voice.Events.emit('listening:resume', App.Voice.State.get());
    return { ok: true, status: 'listening' };
  },

  /** Safe method: stop + start in one call, e.g. after the user
   *  changes the preferred-language or microphone setting mid-session. */
  async restart() {
    App.Voice.Logger.info('Manager.restart() — stopping then re-starting listening.');
    App.Voice.Manager.stopListening();
    await new Promise(r => setTimeout(r, 200)); // let the browser fully release the old session
    return App.Voice.Manager.startListening();
  },

  /** Safe method: hard-cancel whatever the engine is doing (listening,
   *  processing, or speaking) and drop any pending command, without
   *  wiping the session's transcript history (use resetSession() for
   *  that). Always safe to call from any state. */
  cancelAction() {
    App.Voice.Recognition.abort();
    App.Voice.Synthesis.cancel();
    App.Voice.State.set({ lastCommand: null });
    App.Voice.Logger.info('Manager.cancelAction() — cleared pending command and stopped any active recognition/speech.');
    App.Voice.Events.emit('command:cancelled', App.Voice.State.get());
    if (App.Voice.State.get().status !== App.Voice.Config.STATES.IDLE) {
      App.Voice.State.set({ status: App.Voice.Config.STATES.IDLE });
    }
    return { ok: true };
  },

  /** Safe method: fully clears the current session (transcripts,
   *  pending command, last error) and resets the state machine to
   *  idle — used by the "Reset Session" control. Does not touch
   *  finance data or the legacy voice feature's own history log. */
  resetSession() {
    App.Voice.Recognition.abort();
    App.Voice.Synthesis.cancel();
    App.Voice.Session.reset();
    App.Voice.State.set({ status: App.Voice.Config.STATES.IDLE });
    App.Voice.Logger.info('Manager.resetSession() — session and pending state cleared.');
    App.Voice.Events.emit('session:manager-reset', App.Voice.State.get());
    return { ok: true };
  },

  /** Moves the engine into the WAITING state — for a future
   *  conversational flow that has asked the user something and is
   *  waiting on a reply. No timeout/follow-up logic is implemented
   *  yet; this just gives that future flow a real state to sit in
   *  instead of overloading 'idle' or 'listening'. */
  waitForResponse(prompt = '') {
    App.Voice.State.set({ status: App.Voice.Config.STATES.WAITING });
    App.Voice.Logger.info('Manager.waitForResponse() — engine waiting on user reply.');
    App.Voice.Events.emit('lifecycle:waiting', { prompt });
    return { ok: true, status: 'waiting' };
  },

  /** Real speech-normalization pipeline (language detection stays a
   *  placeholder per this sprint's scope). Accepts a transcript —
   *  either from real Recognition final results, or from a caller
   *  testing the pipeline directly — and produces a normalized,
   *  loggable result. Deliberately never executes a finance action;
   *  parseCommand() always reports recognized:false this sprint. */
  processSpeech(transcript = '', confidence = null) {
    try {
      App.Voice.State.set({ status: App.Voice.Config.STATES.PROCESSING });
      const detected = App.Voice.Language.detectLanguage(transcript);
      const normalized = App.Voice.Parser.normalizeSpeech(transcript);
      const parsed = App.Voice.Parser.parseCommand(normalized);
      App.Voice.State.set({
        status: App.Voice.Config.STATES.IDLE,
        lastTranscript: normalized,
        lastConfidence: confidence ?? parsed.confidence,
        lastCommand: parsed.recognized ? parsed : null,
        language: detected.language
      });
      App.Voice.Logger.info('Manager.processSpeech() — pipeline complete (no command grammar yet; interface layer only).');
      App.Voice.Events.emit('speech:processed', { detected, normalized, parsed, confidence });
      // Sprint 19 — additive: hand the transcript to the real conversation
      // engine via App.Voice.Bridge. The placeholder parseCommand() above
      // is completely untouched and still always reports recognized:false;
      // Bridge is a separate, real consumer of the same transcript, not a
      // replacement for this pipeline.
      try{ if(window.App && App.Voice.Bridge) App.Voice.Bridge.handleFinalTranscript(normalized, confidence ?? parsed.confidence); }
      catch(e){ App.Voice.Logger.error('Bridge.handleFinalTranscript failed', e); }
      return { ok: true, detected, normalized, parsed };
    } catch (err) {
      App.Voice.Logger.error('Manager.processSpeech() failed', err);
      App.Voice.State.set({ status: App.Voice.Config.STATES.ERROR, lastError: String(err && err.message || err) });
      return { ok: false, error: String(err && err.message || err) };
    }
  },

  /** Placeholder for the "did I hear you right?" confirmation step.
   *  No finance action is ever taken here — this sprint's scope is
   *  explicitly interface-layer only; a future sprint hands the
   *  confirmed command to a real executor. */
  confirmAction(command = App.Voice.State.get().lastCommand) {
    if (!command) {
      App.Voice.Logger.warn('Manager.confirmAction() called with no pending command; ignored.');
      return { ok: false, reason: 'no-pending-command' };
    }
    App.Voice.Logger.info('Manager.confirmAction() — placeholder, finance actions not implemented this sprint.');
    App.Voice.Events.emit('command:confirm-requested', command);
    return { ok: true, pending: command };
  },

  /** UI-agnostic hook a listening indicator (mic pulse, banner, etc.)
   *  can subscribe to via App.Voice.Events instead of this method
   *  reaching into the DOM directly. Kept deliberately decoupled
   *  from the existing #voiceDot / #voiceStatusText elements used by
   *  the current, already-working voice feature — see App.Voice.UI
   *  below for how the *new* indicator elements are actually wired. */
  showListeningIndicator() {
    App.Voice.Events.emit('indicator:show', App.Voice.State.get());
  },
  hideListeningIndicator() {
    App.Voice.Events.emit('indicator:hide', App.Voice.State.get());
  }
};

/* ---- App.Voice top-level convenience surface -------------------------
   Lets future code call App.Voice.initialize() / App.Voice.startListening()
   etc. directly, without needing to know it's really App.Voice.Manager.*
   underneath. Deliberately NOT auto-invoked anywhere in this file — the
   existing, working voice feature keeps initializing itself exactly as
   before (see initVoiceEngine() and App.init() below); wiring App.Voice
   into that flow is future-sprint work. */
Object.assign(App.Voice, {
  initialize: (...a) => App.Voice.Manager.initialize(...a),
  startListening: (...a) => App.Voice.Manager.startListening(...a),
  stopListening: (...a) => App.Voice.Manager.stopListening(...a),
  pauseListening: (...a) => App.Voice.Manager.pauseListening(...a),
  resumeListening: (...a) => App.Voice.Manager.resumeListening(...a),
  restart: (...a) => App.Voice.Manager.restart(...a),
  resetSession: (...a) => App.Voice.Manager.resetSession(...a),
  waitForResponse: (...a) => App.Voice.Manager.waitForResponse(...a),
  processSpeech: (...a) => App.Voice.Manager.processSpeech(...a),
  confirmAction: (...a) => App.Voice.Manager.confirmAction(...a),
  cancelAction: (...a) => App.Voice.Manager.cancelAction(...a),
  showListeningIndicator: (...a) => App.Voice.Manager.showListeningIndicator(...a),
  hideListeningIndicator: (...a) => App.Voice.Manager.hideListeningIndicator(...a),
  detectLanguage: (...a) => App.Voice.Language.detectLanguage(...a),
  normalizeSpeech: (...a) => App.Voice.Parser.normalizeSpeech(...a),
  parseCommand: (...a) => App.Voice.Parser.parseCommand(...a),
  // ---- real, this-sprint conveniences (permission / mic / settings / speech) ----
  checkPermission: (...a) => App.Voice.Permission.check(...a),
  requestPermission: (...a) => App.Voice.Permission.request(...a),
  listMicrophones: (...a) => App.Voice.Microphone.listDevices(...a),
  selectMicrophone: (...a) => App.Voice.Microphone.selectDevice(...a),
  getSettings: (...a) => App.Voice.Settings.get(...a),
  updateSettings: (...a) => App.Voice.Settings.set(...a),
  speak: (...a) => App.Voice.Synthesis.speak(...a),
  cancelSpeak: (...a) => App.Voice.Synthesis.cancel(...a),
  getSessionHistory: (...a) => App.Voice.Session.getHistory(...a)
});

/* App.Voice.initialize() IS called from App.init() this sprint (see
   bottom of file) — it only resets state and does a passive permission
   check, it never starts listening on its own. Actually starting the
   microphone always requires an explicit user tap (App.Voice.UI below,
   or App.Voice.startListening() called directly), matching browser
   autoplay/permission-prompt norms and the "Auto Start" setting
   staying a future-sprint flag rather than something wired up today. */

/* ---- App.Voice.UI ------------------------------------------------------
   Binds the new "Voice Engine (Foundation)" card added to the existing
   Voice Assistant view to the modules above via App.Voice.Events —
   never by reaching into App.Voice internals directly, so this stays
   swappable if a future sprint redesigns the panel. Entirely additive:
   none of the element IDs here overlap the legacy #voiceDot / #micFabBtn
   / #voiceOverlay elements, so the existing feature is unaffected even
   if this binder fails to find its elements (e.g. on a stale cached
   page) — every lookup is null-guarded. */
App.Voice.UI = (() => {
  const $ = id => document.getElementById(id);
  let bound = false;

  function dotClassFor(kind, value) {
    if (kind === 'state') {
      if (value === 'error' || value === 'stopped') return 'bad';
      if (value === 'listening') return 'live';
      if (value === 'processing' || value === 'speaking' || value === 'waiting' || value === 'paused') return 'warn';
      return 'ok';
    }
    if (kind === 'permission') {
      if (value === 'granted') return 'ok';
      if (value === 'denied') return 'bad';
      return 'warn';
    }
    if (kind === 'recognition') return value ? 'ok' : 'bad';
    return '';
  }

  function renderState(state) {
    const dot = $('veStateDot'), text = $('veStateText');
    if (dot) dot.className = 've-dot ' + dotClassFor('state', state.status);
    if (text) text.textContent = state.status.charAt(0).toUpperCase() + state.status.slice(1);

    const micBtn = $('veMicBtn');
    if (micBtn) {
      micBtn.classList.toggle('listening', state.status === 'listening');
      micBtn.classList.toggle('processing', state.status === 'processing');
      micBtn.textContent = state.status === 'listening' ? '⏹' : '🎙️';
      micBtn.title = state.status === 'listening' ? 'Stop listening' : 'Start listening';
    }

    // Sprint 41 — the Home-screen mic FAB (#micFabBtn) now drives this
    // same real state machine directly (see its click handler), so give
    // it the live "listening" glow too, the same way veMicBtn above
    // already gets it. Its .mic-fab.listening CSS rule already existed
    // (Sprint 29/30) — this is the first time it's wired to the real
    // conversation state instead of only the old single-shot flow's own
    // updateMicButtons() (untouched, still used by #voiceOverlay).
    const fabBtn = $('micFabBtn');
    if (fabBtn) fabBtn.classList.toggle('listening', state.status === 'listening');

    const permDot = $('vePermDot'), permText = $('vePermText');
    if (permDot) permDot.className = 've-dot ' + dotClassFor('permission', state.permission);
    if (permText) permText.textContent = { granted: 'Granted', denied: 'Denied', prompt: 'Not yet asked', unsupported: 'Unsupported', unknown: 'Unknown' }[state.permission] || state.permission;

    const sessionText = $('veSessionText');
    if (sessionText) sessionText.textContent = state.sessionId ? `Active — ${Math.max(0, Math.round((Date.now() - state.sessionStartedAt) / 1000))}s` : 'No active session';

    const box = $('veTranscriptBox');
    if (box) {
      const shown = state.lastTranscript || state.lastInterimTranscript;
      box.innerHTML = shown
        ? (state.lastInterimTranscript && !state.lastTranscript
            ? `<span class="interim">${escapeHtml(shown)}</span>`
            : escapeHtml(shown))
        : '<span class="interim">Foundation layer — transcript preview only, no command is executed from here.</span>';
    }
  }

  function renderRecognitionSupport() {
    const dot = $('veRecogDot'), text = $('veRecogText');
    const supported = App.Voice.Recognition.isSupported();
    if (dot) dot.className = 've-dot ' + dotClassFor('recognition', supported);
    if (text) text.textContent = supported ? 'Supported' : 'Unsupported — use text input elsewhere';
  }

  async function renderMicList() {
    const sel = $('veMicSelect');
    if (!sel) return;
    const devices = await App.Voice.Microphone.listDevices();
    const current = App.Voice.Settings.get().microphoneDeviceId;
    sel.innerHTML = '<option value="">Default microphone</option>' +
      devices.map(d => `<option value="${escapeHtml(d.deviceId)}">${escapeHtml(d.label)}</option>`).join('');
    sel.value = current || '';
  }

  function renderSettings() {
    const s = App.Voice.Settings.get();
    const rate = $('veRateRange'), rateVal = $('veRateVal');
    const pitch = $('vePitchRange'), pitchVal = $('vePitchVal');
    const vol = $('veVolumeRange'), volVal = $('veVolumeVal');
    const lang = $('veLangSelect');
    if (rate) rate.value = s.speechRate;
    if (rateVal) rateVal.textContent = Number(s.speechRate).toFixed(1) + '×';
    if (pitch) pitch.value = s.speechPitch;
    if (pitchVal) pitchVal.textContent = Number(s.speechPitch).toFixed(1);
    if (vol) vol.value = s.speechVolume;
    if (volVal) volVal.textContent = Math.round(s.speechVolume * 100) + '%';
    if (lang) lang.value = s.preferredLanguage;
    // Sprint 19 — sync the three new real settings controls.
    const autoSpeak = $('veAutoSpeakToggle'); if (autoSpeak) autoSpeak.checked = s.autoSpeakResponses !== false;
    const cont = $('veContinuousToggle'); if (cont) cont.checked = !!s.continuousListening;
    const confirmMode = $('veConfirmModeSelect'); if (confirmMode) confirmMode.value = s.confirmationMode || 'auto';
    // Sprint 40 — assistant name + wake word. Skip overwriting the name
    // field mid-typing so a settings:change emitted by another control
    // never clobbers what the user is currently entering.
    const nameInput = $('veAssistantNameInput');
    if (nameInput && document.activeElement !== nameInput) nameInput.value = s.assistantName || 'Khaata';
    const wakeToggle = $('veWakeWordToggle'); if (wakeToggle) wakeToggle.checked = !!s.wakeWord;
  }

  /** Sprint 40 — reflects App.Voice.WakeWord's real support/permission/
   *  running status in the small note under the toggle, so the user
   *  always knows whether it's actually listening right now, waiting on
   *  permission, or unsupported in this browser (with the tap-to-talk
   *  mic offered as the always-working fallback in the latter case). */
  function renderWakeStatus() {
    const el = $('veWakeStatusText');
    if (!el || !window.App || !App.Voice.WakeWord) return;
    const s = App.Voice.Settings.get();
    const name = s.assistantName || 'Khaata';
    if (!App.Voice.WakeWord.isSupported()) {
      el.textContent = `Not supported in this browser — the mic button above still works normally.`;
      return;
    }
    if (!s.wakeWord) {
      el.textContent = 'Wake word listening is off.';
      return;
    }
    const perm = App.Voice.State.get().permission;
    if (perm === 'denied') {
      el.textContent = 'Microphone permission denied — enable it in your browser settings to use wake word.';
      return;
    }
    if (App.Voice.WakeWord.isRunning()) {
      el.textContent = `Listening for "${name}"…`;
    } else if (App.Voice.isConversationActive()) {
      el.textContent = `Paused while a conversation is active — resumes when it ends.`;
    } else {
      el.textContent = `Wake word is on — starting…`;
    }
  }

  function bindControls() {
    $('veMicBtn')?.addEventListener('click', () => {
      // Sprint 19 — this button now starts a real, chat-connected
      // conversation via App.Voice.Bridge (single push-to-talk turn by
      // default; hands-free if "Continuous listening" is on below),
      // instead of the previous Foundation-only preview that executed
      // nothing. See App.Voice.Bridge for what actually happens with
      // the transcript.
      if (App.Voice.isConversationActive()) App.Voice.stopConversation();
      else App.Voice.startConversation();
    });
    $('vePauseBtn')?.addEventListener('click', () => App.Voice.pauseListening());
    $('veResumeBtn')?.addEventListener('click', () => App.Voice.resumeListening());
    $('veRestartBtn')?.addEventListener('click', () => App.Voice.restart());
    $('veCancelBtn')?.addEventListener('click', () => App.Voice.cancelAction());
    $('veResetBtn')?.addEventListener('click', () => { App.Voice.resetSession(); renderState(App.Voice.State.get()); });

    $('veLangSelect')?.addEventListener('change', (e) => App.Voice.Settings.set({ preferredLanguage: e.target.value }));
    $('veMicSelect')?.addEventListener('change', (e) => App.Voice.selectMicrophone(e.target.value));

    $('veRateRange')?.addEventListener('input', (e) => App.Voice.Settings.set({ speechRate: e.target.value }));
    $('vePitchRange')?.addEventListener('input', (e) => App.Voice.Settings.set({ speechPitch: e.target.value }));
    $('veVolumeRange')?.addEventListener('input', (e) => App.Voice.Settings.set({ speechVolume: e.target.value }));

    // Sprint 19 — new real settings.
    $('veAutoSpeakToggle')?.addEventListener('change', (e) => App.Voice.Settings.set({ autoSpeakResponses: e.target.checked }));
    $('veContinuousToggle')?.addEventListener('change', (e) => App.Voice.Settings.set({ continuousListening: e.target.checked }));
    $('veConfirmModeSelect')?.addEventListener('change', (e) => App.Voice.Settings.set({ confirmationMode: e.target.value }));

    // Sprint 40 — assistant name + wake word.
    $('veAssistantNameInput')?.addEventListener('change', (e) => {
      let name = (e.target.value || '').trim().slice(0, 24);
      if (!name) name = 'Khaata';
      e.target.value = name;
      App.Voice.Settings.set({ assistantName: name });
      renderWakeStatus();
    });
    $('veWakeWordToggle')?.addEventListener('change', async (e) => {
      if (e.target.checked) {
        const res = await App.Voice.WakeWord.enable();
        if (!res.ok) e.target.checked = false; // enable() already reset the persisted setting on failure
      } else {
        App.Voice.WakeWord.disable();
      }
      renderWakeStatus();
    });
  }

  function bindEvents() {
    App.Voice.Events.on('state:change', renderState);
    App.Voice.Events.on('state:reset', renderState);
    App.Voice.Events.on('settings:change', renderSettings);
    App.Voice.Events.on('microphone:selected', renderMicList);
    // Live "Active — Ns" session counter without needing a real timer
    // subscription per second — piggybacks on interim-result frequency
    // plus a light interval only while actually listening.
    let tickTimer = null;
    App.Voice.Events.on('listening:start', () => {
      if (tickTimer) clearInterval(tickTimer);
      tickTimer = setInterval(() => renderState(App.Voice.State.get()), 1000);
    });
    App.Voice.Events.on('listening:stop', () => { if (tickTimer) { clearInterval(tickTimer); tickTimer = null; } });
    // Sprint 40 — keep the wake-word status note live.
    App.Voice.Events.on('wakeword:listening', renderWakeStatus);
    App.Voice.Events.on('wakeword:stopped', renderWakeStatus);
    App.Voice.Events.on('wakeword:detected', renderWakeStatus);
    App.Voice.Events.on('wakeword:error', renderWakeStatus);
    App.Voice.Events.on('wakeword:unsupported', renderWakeStatus);
    App.Voice.Events.on('permission:change', renderWakeStatus);
  }

  return {
    /** Wires the DOM once the Voice Assistant view's markup exists
     *  (it's static HTML present at load, so this can run immediately
     *  from App.init() — no need to wait for a view-switch event). */
    bind() {
      if (bound) return; // idempotent — safe if called more than once
      bound = true;
      renderState(App.Voice.State.get());
      renderRecognitionSupport();
      renderSettings();
      renderMicList();
      renderWakeStatus();
      bindControls();
      bindEvents();
      App.Voice.Logger.info('UI.bind() — Voice Engine foundation panel wired.');
    }
  };
})();

/* ---- App.Voice.Bridge ---------------------------------------------------
   Sprint 19 — Voice-First AI Finance Assistant.
   Connects the REAL voice engine above (Recognition/Synthesis/Manager) to
   the REAL conversation engine (App.Chat, defined later in this file)
   that already does Hindi/English/Hinglish slot-filling, confirmation,
   duplicate/unusual-amount warnings, undo, and learned suggestions
   (Sprints 15-18). This is the ONLY new module Sprint 19 adds, and it
   deliberately contains NO natural-language understanding, transaction
   building, or category/account matching of its own — every recognized
   sentence is handed, verbatim, to App.Chat.sendMessage(), the exact
   same function the typed 💬 chat box already calls. One single source
   of truth for "what did the user mean," whether typed or spoken.
   Bridge's only job is orchestration: when to listen, when to speak, how
   to keep a hands-free conversation flowing, and how to let the user
   interrupt naturally. References to App.Chat below are safe even though
   App.Chat is defined further down this file — every function here only
   *runs* later, once the whole script (and App.init()) has loaded. */
App.Voice.Bridge = (function(){
  let conversationActive = false;  // true while a Bridge-managed voice session is running
  let noSpeechStreak = 0;          // consecutive "didn't catch anything" retries this session
  let lastQuickReplies = null;     // quick-reply options from the most recent AI message (e.g. ['Yes','No','Why?'])
  let restartTimer = null;
  const MAX_NO_SPEECH_RETRIES = 2;

  function settings(){ return App.Voice.Settings.get(); }

  function isConfirmationPrompt(){
    return !!(lastQuickReplies && lastQuickReplies.some(q => /^yes/i.test(q)));
  }
  // Single gate every auto-restart/keep-listening decision below goes
  // through, so "Continuous listening" and "Voice confirmation mode"
  // only ever need to be reasoned about in one place.
  function shouldAutoListen(){
    if(!conversationActive) return false;
    if(!settings().continuousListening) return false;
    if(isConfirmationPrompt() && settings().confirmationMode === 'manual') return false;
    return true;
  }
  function scheduleRestart(delayMs){
    clearTimeout(restartTimer);
    restartTimer = setTimeout(()=>{
      if(!shouldAutoListen()) return;
      if(App.Voice.State.get().status === 'listening') return; // already listening — nothing to do
      App.Voice.Manager.startListening();
    }, delayMs || 700);
  }

  /** Routes a finished, real transcript into the existing chat engine.
   *  Opens the chat panel automatically the first time so a session
   *  started from the Voice Assistant tab still shows a visible
   *  transcript, not just audio. */
  function handleFinalTranscript(transcript, confidence){
    const text = (transcript || '').trim();
    if(!text) return;
    noSpeechStreak = 0;
    // Sprint 38 — if App.VoiceFollowUp is mid-conversation (it already
    // spoke a clarifying question and is waiting on the answer), this
    // transcript IS that answer, not a new command — hand it there
    // first so it never gets reclassified from scratch. No-op branch
    // (falls through to Sprint 37's behavior below unchanged) whenever
    // nothing is pending.
    if(window.App && App.VoiceFollowUp && App.VoiceFollowUp.isPending()){
      App.VoiceFollowUp.handleAnswer(text);
      return;
    }
    // Sprint 37 — transcripts now go through App.VoiceBrain first, which
    // decides "add transaction" / "navigate" / "question" / "unclear"
    // and either flips the tab (navigate) or hands off to App.Chat
    // exactly as this function always did (everything else). Falls back
    // to the pre-Sprint-37 direct-to-Chat behavior if VoiceBrain isn't
    // present for any reason, so nothing here is a hard dependency.
    if(window.App && App.VoiceBrain){
      const result = App.VoiceBrain.handle(text);
      // Sprint 38 — previously a needsFollowup:true result was only
      // logged by VoiceBrain.route() and otherwise silently dropped.
      // Now App.VoiceFollowUp speaks a clarifying question and takes
      // over listening for the answer. No-op (identical to Sprint 37)
      // if App.VoiceFollowUp isn't present for any reason.
      if(result && result.needsFollowup && window.App && App.VoiceFollowUp){
        App.VoiceFollowUp.begin(result);
      }
    } else if(window.App && App.Chat){
      if(!App.Chat.isOpen()) App.Chat.open();
      App.Chat.sendMessage(text, { viaVoice: true });
    }
  }

  /** Nothing was heard. Retries quietly a couple of times (typing
   *  pauses, background noise) before giving up and pausing — never an
   *  infinite listen loop. */
  function handleSilence(){
    if(!shouldAutoListen()) return;
    noSpeechStreak++;
    if(noSpeechStreak > MAX_NO_SPEECH_RETRIES){
      noSpeechStreak = 0;
      App.Voice.Bridge.stopConversation();
      App.Voice.Synthesis.speak("I'll pause listening for now — tap the mic whenever you're ready.");
      return;
    }
    scheduleRestart(600);
  }

  /** Real interruption handling: if the assistant is mid-sentence and
   *  the user starts talking (only possible while the mic is kept hot
   *  during playback — see onSynthesisStart below), stop talking
   *  immediately instead of speaking over them. */
  function handleInterim(interimText){
    if(!conversationActive) return;
    if(App.Voice.State.get().status === 'speaking' && interimText && interimText.trim().length > 1){
      App.Voice.Synthesis.cancel();
    }
  }

  function onRecognitionEnd(){
    const st = App.Voice.State.get().status;
    if(st === 'idle' || st === 'stopped') scheduleRestart(500);
  }

  /** Reads every AI reply aloud when "Auto-speak responses" is on.
   *  Registered once via App.Chat.onAIMessage() — the single place
   *  App.Chat already emits its replies from — so this never
   *  duplicates or re-derives what the assistant is saying. */
  function onAIMessage(text, quick){
    lastQuickReplies = quick || null;
    if(!settings().autoSpeakResponses) return;
    if(!App.Voice.Synthesis.isSupported() || !text) return;
    App.Voice.Synthesis.speak(text);
  }

  /** While speaking, keep the mic hot (only in continuous mode, and
   *  only when the current prompt is allowed to auto-listen) so the
   *  user can interrupt naturally instead of waiting the assistant out
   *  — real barge-in, not just a pause/resume toggle. */
  function onSynthesisStart(){
    if(shouldAutoListen() && App.Voice.State.get().status !== 'listening') App.Voice.Manager.startListening();
  }
  function onSynthesisEnd(){
    if(shouldAutoListen()) scheduleRestart(400);
  }

  function renderChatMicButton(){
    const btn = document.getElementById('chatMicBtn');
    if(!btn) return;
    const listening = App.Voice.State.get().status === 'listening';
    btn.textContent = conversationActive ? '⏹' : '🎙️';
    btn.title = conversationActive ? 'Stop voice conversation' : 'Talk to Khaata';
    btn.classList.toggle('rust', listening);
  }
  function bindChatMic(){
    const btn = document.getElementById('chatMicBtn');
    if(!btn) return;
    if(!App.Voice.Recognition.isSupported()){
      btn.disabled = true;
      btn.title = 'Voice input not supported on this browser — type instead';
      return;
    }
    btn.addEventListener('click', () => {
      if(conversationActive) App.Voice.Bridge.stopConversation();
      else App.Voice.Bridge.startConversation();
    });
  }

  return {
    /** Starts a Bridge-managed voice session: opens the chat panel and
     *  the mic. With "Continuous listening" off (the default), this is
     *  a single push-to-talk turn, same as the pre-Sprint-19 Foundation
     *  mic button. With it on, the mic keeps re-opening after every
     *  reply — including during playback, for real barge-in — until
     *  stopConversation() is called. */
    startConversation(){
      conversationActive = true;
      noSpeechStreak = 0;
      // Sprint 40 — whether this conversation started from a wake-word
      // hit or a manual mic tap, the passive wake-word listener must
      // yield the mic first. No-op/safe if App.Voice.WakeWord isn't
      // present or wasn't running.
      if(window.App && App.Voice.WakeWord) App.Voice.WakeWord.pauseForConversation();
      // Sprint 38 — never start a new voice session mid-way through a
      // stale App.VoiceFollowUp question from a previous session.
      if(window.App && App.VoiceFollowUp) App.VoiceFollowUp.reset();
      if(window.App && App.Chat && !App.Chat.isOpen()) App.Chat.open();
      renderChatMicButton();
      return App.Voice.Manager.startListening();
    },
    stopConversation(){
      conversationActive = false;
      clearTimeout(restartTimer);
      App.Voice.Manager.stopListening();
      App.Voice.Synthesis.cancel();
      // Sprint 38 — don't leave a pending clarifying question dangling
      // once the conversation is explicitly stopped.
      if(window.App && App.VoiceFollowUp) App.VoiceFollowUp.reset();
      renderChatMicButton();
      // Sprint 40 — hand the mic back to passive wake-word listening,
      // only if the user still has it turned on.
      if(window.App && App.Voice.WakeWord) App.Voice.WakeWord.resumeIfEnabled();
    },
    isActive(){ return conversationActive; },
    handleFinalTranscript,
    init(){
      App.Voice.Events.on('recognition:interim', handleInterim);
      App.Voice.Events.on('recognition:end', onRecognitionEnd);
      App.Voice.Events.on('recognition:nospeech', handleSilence);
      App.Voice.Events.on('synthesis:start', onSynthesisStart);
      App.Voice.Events.on('synthesis:end', onSynthesisEnd);
      App.Voice.Events.on('state:change', renderChatMicButton);
      if(window.App && App.Chat && typeof App.Chat.onAIMessage === 'function'){
        App.Chat.onAIMessage(onAIMessage);
      }
      bindChatMic();
      renderChatMicButton();
      App.Voice.Logger.info('Bridge.init() — voice engine connected to App.Chat; hands-free conversation ready.');
    }
  };
})();
Object.assign(App.Voice, {
  startConversation: (...a) => App.Voice.Bridge.startConversation(...a),
  stopConversation: (...a) => App.Voice.Bridge.stopConversation(...a),
  isConversationActive: (...a) => App.Voice.Bridge.isActive(...a)
});

/* ---- App.Voice.WakeWord ------------------------------------------------
   Sprint 40 — Voice Command Brain, Part 4 of 4. Passive, secondary
   listener: while enabled, it listens quietly for the user's chosen
   assistantName and, on hearing it, hands off to the REAL conversation
   via App.Voice.Bridge.startConversation() — the exact function the
   manual mic button already calls (see App.Voice.UI.bindControls()
   above). This module never interprets commands itself and never
   touches App.Voice.State's 8-state machine; it runs its own separate
   SpeechRecognition instance so a background restart/error here can
   never corrupt an active real conversation's state. */
App.Voice.WakeWord = (function(){
  const Ctor = window.SpeechRecognition || window.webkitSpeechRecognition;
  let instance = null;
  let active = false;   // user's persisted intent — wake word is turned ON
  let running = false;  // the passive recognizer is actually listening right now
  let restartTimer = null;
  let quickRestartCount = 0;
  let quickRestartWindowStart = 0;
  const MAX_QUICK_RESTARTS = 6;

  function normalize(s){
    return (s || '').toLowerCase().replace(/[^\p{L}\p{N}\s]/gu, ' ').replace(/\s+/g, ' ').trim();
  }
  function currentPhrase(){
    return normalize((App.Voice.Settings.get().assistantName || 'Khaata'));
  }
  function containsWakeWord(text){
    const phrase = currentPhrase();
    const norm = normalize(text);
    if(!phrase || !norm) return false;
    const escaped = phrase.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    return new RegExp('(^|\\s)' + escaped + '(\\s|$)').test(norm);
  }

  function build(){
    const rec = new Ctor();
    rec.continuous = true;
    rec.interimResults = true;
    rec.maxAlternatives = 1;
    rec.lang = App.Voice.Language.resolveLocale();
    rec.onstart = () => {
      running = true;
      App.Voice.Events.emit('wakeword:listening', {});
    };
    rec.onresult = (evt) => {
      let combined = '';
      for(let i = evt.resultIndex; i < evt.results.length; i++){
        combined += ' ' + evt.results[i][0].transcript;
      }
      if(containsWakeWord(combined)){
        App.Voice.Logger.info('WakeWord — phrase detected; starting real conversation.');
        App.Voice.Events.emit('wakeword:detected', { transcript: combined.trim() });
        App.Voice.WakeWord.pauseForConversation();
        App.Voice.Bridge.startConversation();
      }
    };
    rec.onerror = (evt) => {
      App.Voice.Logger.warn('WakeWord recognition error', evt.error);
      if(evt.error === 'not-allowed' || evt.error === 'permission-denied' || evt.error === 'service-not-allowed'){
        App.Voice.Events.emit('wakeword:error', evt.error);
        App.Voice.WakeWord.disable();
        return;
      }
      // 'no-speech' / 'aborted' / 'network' etc are routine for a
      // continuous background listener — onend() below decides whether
      // to quietly restart, same spirit as App.Voice.Recognition's own
      // no-speech handling.
      App.Voice.Events.emit('wakeword:error', evt.error);
    };
    rec.onend = () => {
      running = false;
      App.Voice.Events.emit('wakeword:stopped', {});
      if(!active) return; // user turned it off, or disable() ran (e.g. permission denied)
      if(App.Voice.Bridge.isActive()) return; // a real conversation now owns the mic — resumeIfEnabled() will restart this later
      // Several mobile browsers end a "continuous" recognizer every few
      // seconds by design, even with no user action and no error — a
      // real, documented platform limitation, not a bug here. Restart
      // quietly, but back off if it's happening too fast (mic held by
      // something else, or a browser that won't sustain this at all)
      // instead of hammering start() in a tight loop.
      const now = Date.now();
      if(now - quickRestartWindowStart > 10000){ quickRestartWindowStart = now; quickRestartCount = 0; }
      quickRestartCount++;
      const delay = quickRestartCount > MAX_QUICK_RESTARTS ? 8000 : 400;
      restartTimer = setTimeout(() => App.Voice.WakeWord._start(), delay);
    };
    return rec;
  }

  return {
    isSupported: () => !!Ctor,
    isActive: () => active,
    isRunning: () => running,

    /** Internal — actually calls the recognizer's start(). Not meant to
     *  be called directly by UI code; use enable()/pauseForConversation()
     *  /resumeIfEnabled() instead, which keep `active` in sync. */
    _start(){
      if(!Ctor || !active) return { ok: false };
      if(App.Voice.Bridge.isActive()) return { ok: false, reason: 'conversation-active' };
      try{
        instance = instance || build();
        instance.lang = App.Voice.Language.resolveLocale();
        instance.start();
        return { ok: true };
      } catch(err){
        // Most commonly thrown when start() is called while already
        // running — harmless, the same soft no-op App.Voice.Recognition
        // treats it as.
        App.Voice.Logger.warn('WakeWord._start() threw (likely already running)', err);
        return { ok: false, reason: String(err && err.message || err) };
      }
    },

    /** Turns wake-word listening ON: persists the setting, requests mic
     *  permission if it isn't already granted, then starts the passive
     *  listener (or leaves it queued if a real conversation currently
     *  owns the mic — resumeIfEnabled() will pick it up after). Resolves
     *  { ok:false, reason } when unsupported or permission is denied, so
     *  the UI can explain why and leave the toggle off. */
    async enable(){
      if(!Ctor){
        App.Voice.Logger.info('WakeWord.enable() — SpeechRecognition unsupported in this browser.');
        App.Voice.Events.emit('wakeword:unsupported', {});
        return { ok: false, reason: 'unsupported' };
      }
      let perm = App.Voice.State.get().permission;
      if(perm !== 'granted'){
        perm = await App.Voice.Permission.request();
        if(perm !== 'granted'){
          App.Voice.Settings.set({ wakeWord: false });
          App.Voice.Events.emit('wakeword:error', 'permission-' + perm);
          return { ok: false, reason: 'permission-' + perm };
        }
      }
      active = true;
      quickRestartCount = 0;
      App.Voice.Settings.set({ wakeWord: true });
      App.Voice.WakeWord._start();
      return { ok: true };
    },

    /** Turns wake-word listening OFF and persists it. Leaves the manual
     *  tap-to-talk mic button completely untouched. */
    disable(){
      active = false;
      clearTimeout(restartTimer);
      App.Voice.Settings.set({ wakeWord: false });
      try{ instance && instance.stop(); } catch(e){ /* nothing to stop */ }
      App.Voice.Events.emit('wakeword:stopped', {});
      return { ok: true };
    },

    /** Called by App.Voice.Bridge.startConversation() — whether that
     *  conversation started via a wake-word hit or a manual mic tap, the
     *  passive listener must yield the microphone so it never fights
     *  the real session for it. Does not change the user's `active`
     *  (on/off) intent, only the recognizer that's physically running. */
    pauseForConversation(){
      clearTimeout(restartTimer);
      try{ instance && instance.stop(); } catch(e){ /* nothing running — fine */ }
    },

    /** Called by App.Voice.Bridge.stopConversation() — resumes passive
     *  listening automatically once the real conversation ends, only if
     *  the user still has the toggle on. */
    resumeIfEnabled(){
      if(!active) return;
      clearTimeout(restartTimer);
      restartTimer = setTimeout(() => App.Voice.WakeWord._start(), 500);
    },

    /** Boots from persisted settings at app startup. Mirrors every other
     *  App.Voice sub-module's own-settings-on-load pattern. Deliberately
     *  never prompts for mic permission on page load — only resumes the
     *  passive listener if the user had it on AND permission is already
     *  granted from a previous session; otherwise it waits for the user
     *  to interact with the toggle once. */
    init(){
      if(!App.Voice.Settings.get().wakeWord) return;
      App.Voice.Permission.check().then((perm) => {
        if(perm === 'granted' && App.Voice.Settings.get().wakeWord){
          active = true;
          App.Voice.WakeWord._start();
        }
      }).catch((err) => App.Voice.Logger.warn('WakeWord.init() — permission check failed', err));
    }
  };
})();

/* ================================================================
   VOICE COMMAND BRAIN   (App.VoiceBrain)   —   v1.0.0   Sprint 37
   ------------------------------------------------------------------
   PART 1 of a 4-part voice-assistant build. This is the single new
   module this sprint adds. It sits between App.Voice.Bridge's real
   transcripts and the rest of the app, and answers one question:
   "given what the user just said, what already-existing part of
   Khaata should handle it?"

   What already existed before this sprint (checked first, not
   rebuilt):
     - App.Chat's private classifyKind()/matchKindWord() already do
       real income/expense/transfer/loan/investment/budget/goal/
       reminder detection, with slot-filling follow-up questions —
       but classifyKind isn't part of App.Chat's public API
       ({initialize, open, close, sendMessage, getRecentLog, isOpen,
       onAIMessage}), so it can't be called from outside App.Chat
       without duplicating its regex. Nothing here re-implements it —
       any message that isn't a clear navigation command is simply
       handed to the real App.Chat.sendMessage(), same call Sprint
       19's Bridge always made directly.
     - App.OnlineAI.DecisionEngine.isQuestion()/classify() already
       detect general questions and App.Chat already calls into
       App.OnlineAI for them when classifyKind() finds no transaction
       kind — also left untouched and reused via App.Chat, not called
       directly here.
     - App.Voice.Parser.parseCommand(), App.Conversation.Intent.
       detectIntent() and App.Intent.Detector.detectIntent() (Sprints
       15-19) were checked and are confirmed still-explicit no-op
       placeholders ("placeholder, no real classification this
       sprint" — see their own log lines). There was no real intent
       classifier anywhere in the app to reuse for the one thing that
       genuinely didn't exist yet: turning a spoken command into a
       screen change. Those three placeholders are untouched — this
       sprint doesn't rename, extend, or wire into any of them.
     - There was no route from voice transcript -> switchToView() at
       all. Saying "open goals" while talking to Khaata just got sent
       to App.Chat as a chat message and misunderstood. That's the
       actual gap this module fills.

   What App.VoiceBrain does:
     1. classify(text) — pure, no side effects. Normalizes the text
        and decides one of four intents:
          'navigate'        — matched a real screen name (built from
                               the same data-view values already on
                               .tab/.more-item elements in this file,
                               not a separate hardcoded list) together
                               with a navigation verb ("open", "go to",
                               "show me", "take me to", "switch to",
                               "pull up", jao/dikhao, ...).
          'add_transaction'  — everything else that isn't a question,
                               left for App.Chat's real classifyKind()
                               to actually sort out and slot-fill.
          'question'         — starts with a question word or ends in
                               "?"; still left for App.Chat, which
                               already falls through to App.OnlineAI
                               for exactly this case.
          'unclear'          — empty transcript, filler-only ("um",
                               "uh"...), or a bare screen name with no
                               verb ("goals" alone — could be
                               navigation, could be the start of "goal
                               ke liye 500 add karo"). Returns
                               needsFollowup:true and does NOT guess —
                               this is the hook Part 2 builds on.
     2. route(textOrResult) — takes either a raw string or a classify()
        result and actually dispatches it: switchToView() for
        'navigate', App.Chat.open()+sendMessage() for everything
        App.Chat already owns, and just returns the result untouched
        (no dispatch) when needsFollowup is true.
     3. handle(text) — classify() + route() in one call. This is the
        new single entry point.

   Integration (the only existing code touched this sprint):
     App.Voice.Bridge.handleFinalTranscript() — one additive branch,
     same pattern as Sprint 19's "one additive line" in
     App.Voice.Manager.processSpeech. It now calls
     App.VoiceBrain.handle(text) instead of going straight to
     App.Chat; if App.VoiceBrain is missing for any reason it falls
     back to the exact pre-Sprint-37 App.Chat.open()+sendMessage()
     call, unchanged. No IDs, classes, event listeners, or business
     logic were removed or renamed — App.Chat, App.OnlineAI,
     switchToView(), and every existing placeholder module are
     exactly as they were.

   For Part 2 (say this in the next prompt so the next session finds
   it): App.VoiceBrain.classify(text) and App.VoiceBrain.route(result)
   — Part 2 is expected to build the actual "ask the user to clarify"
   UI/voice-prompt around a needsFollowup:true result, without
   changing classify()/route() signatures.
================================================================ */
App.VoiceBrain = (function(){

  function log(...a){ if(window.App && App.Logger) App.Logger.info('[VoiceBrain]', ...a); }

  // Screen catalogue: every real data-view value already used by
  // .tab / .more-item elements in this file, mapped to the phrases a
  // person might actually say. Adding a screen here later is data,
  // not new routing logic — route()'s 'navigate' case just calls the
  // real switchToView(name) with whichever key matched.
  const VIEW_LABELS = {
    dashboard:     ['home', 'dashboard', 'main screen'],
    entry:         ['add entry', 'entry screen', 'new entry', 'add transaction screen'],
    transactions:  ['transactions', 'transaction history', 'txns', 'history'],
    budgets:       ['budgets', 'budget'],
    goals:         ['goals', 'goal'],
    insights:      ['insights', 'ai insights'],
    advisor:       ['ai advisor', 'financial advisor', 'advisor'],
    accounts:      ['accounts', 'account'],
    recurring:     ['recurring', 'subscriptions'],
    categories:    ['categories and tags', 'categories', 'tags'],
    debts:         ['debts and loans', 'debts & loans', 'debts', 'loans'],
    creditcards:   ['credit cards', 'credit card'],
    investments:   ['investments', 'investment', 'portfolio'],
    forecast:      ['cash flow forecast', 'forecast', 'cash flow'],
    affordability: ['can i spend this', 'can i afford this', 'affordability'],
    food:          ['food analysis', 'food'],
    report:        ['monthly report'],
    reports:       ['ai reports'],
    search:        ['search results', 'search'],
    data:          ['data and backup', 'data & backup', 'backup'],
    voice:         ['voice assistant']
  };

  const NAV_VERB = /\b(open|go to|goto|show me|show|take me to|navigate to|switch to|pull up|bring up|jao|jaake dikhao|dikhao)\b/i;
  const QUESTION_START = /^(what|how|when|why|who|which|kitna|kitne|kitni|kya|kab|kaun)\b/;

  function normalize(text){ return (text || '').toLowerCase().trim().replace(/\s+/g, ' '); }

  // Longest-synonym match wins, so "credit card" isn't shadowed by a
  // shorter, unrelated substring match.
  function matchView(tl){
    let best = null;
    Object.keys(VIEW_LABELS).forEach(view=>{
      VIEW_LABELS[view].forEach(syn=>{
        if(tl.includes(syn) && (!best || syn.length > best.syn.length)){
          best = { view, syn };
        }
      });
    });
    return best;
  }

  /** Pure classification — no side effects, nothing dispatched.
   *  Always returns { intent, confidence, target, text, needsFollowup,
   *  reason }. Safe to call as many times as Part 2 needs. */
  function classify(text){
    const raw = (text || '').trim();
    const tl = normalize(raw);

    if(!tl || tl.length < 2 || /^(um+|uh+|hm+|\.+)$/.test(tl)){
      return { intent:'unclear', confidence:0, target:null, text:raw, needsFollowup:true, reason:'empty_or_filler' };
    }

    const viewMatch = matchView(tl);
    if(viewMatch && NAV_VERB.test(tl)){
      return { intent:'navigate', confidence:'high', target:viewMatch.view, text:raw, needsFollowup:false, reason:null };
    }
    if(viewMatch && tl === viewMatch.syn){
      // Named a real screen with nothing else — plausibly navigation,
      // plausibly the start of a transaction/question mentioning the
      // same word (e.g. "goals"). Don't guess either way.
      return { intent:'navigate', confidence:'medium', target:viewMatch.view, text:raw, needsFollowup:true, reason:'bare_screen_name' };
    }

    // Not navigation. Whether this is a transaction or a question is
    // exactly what App.Chat's classifyKind()/App.OnlineAI already
    // determine for real — see build-log note above. VoiceBrain just
    // tags which existing path it expects to handle it, for logging/
    // Part 2's benefit; App.Chat does the actual work either way.
    const looksLikeQuestion = QUESTION_START.test(tl) || tl.endsWith('?');
    return {
      intent: looksLikeQuestion ? 'question' : 'add_transaction',
      confidence: 'delegated',
      target: null,
      text: raw,
      needsFollowup: false,
      reason: null
    };
  }

  /** Dispatches a classify() result (or classifies a raw string
   *  first) against the real app. Returns the result either way so
   *  callers can inspect what happened. Does nothing when
   *  needsFollowup is true — that's the hook, not a guess. */
  function route(input){
    const result = (typeof input === 'string') ? classify(input) : input;
    if(!result) return null;

    if(result.needsFollowup){
      log('needs_followup —', result.reason, '—', JSON.stringify(result.text));
      return result;
    }

    if(result.intent === 'navigate'){
      if(typeof window.switchToView === 'function' && result.target){
        window.switchToView(result.target);
        log('routed to view:', result.target);
      }
      return result;
    }

    // Sprint 39 — Part 3: a 'question' result gets one extra chance
    // before falling through to App.Chat — if it's a real financial
    // data question App.VoiceQA recognizes (spending totals, top
    // category, income vs expense, savings rate, month-over-month),
    // answer it directly from the same App.Reports data the Reports
    // tab already renders, speaking + showing it, and skip App.Chat/
    // App.OnlineAI entirely. Any 'question' App.VoiceQA doesn't
    // recognize (still genuinely open-ended) falls through below,
    // completely unchanged from Sprint 37.
    if(result.intent === 'question' && window.App && App.VoiceQA && App.VoiceQA.tryAnswer(result.text)){
      log('answered via App.VoiceQA —', JSON.stringify(result.text));
      return result;
    }

    // 'add_transaction' and 'question' both go to the same real
    // handler Sprint 19 already wired the mic to.
    if(window.App && App.Chat){
      if(!App.Chat.isOpen()) App.Chat.open();
      App.Chat.sendMessage(result.text, { viaVoice: true });
      log('routed to App.Chat.sendMessage() as', result.intent);
    }
    return result;
  }

  /** classify() + route() in one call — what App.Voice.Bridge calls
   *  for every finished transcript. */
  function handle(text){
    return route(classify(text));
  }

  return { classify, route, handle, VIEW_LABELS };
})();

/* Foundation is initialized from App.init() below (state reset + a
   passive permission check only) and its panel is bound so the status
   tiles/mic button/settings actually reflect real engine state — but
   nothing here ever starts listening without an explicit user tap.
   App.Voice.Bridge.init() (also called from App.init(), after both
   App.Voice and App.Chat are ready) is what makes tapping the mic
   actually talk to the real assistant — see the Sprint 19 build-log
   entry at the top of this file. */

/* ================================================================
   VOICE FOLLOW-UP / CROSS-QUESTIONING   (App.VoiceFollowUp)   —   v1.0.0
   Sprint 38 — Voice Command Brain, Part 2 of 4
   ------------------------------------------------------------------
   Full rationale lives in the Sprint 38 build-log entry at the top of
   this file. Short version: this module answers the one question
   Sprint 37 deliberately left unanswered — "App.VoiceBrain says it
   needs a follow-up; now what?" — by speaking one clarifying question
   (existing App.Voice.Synthesis TTS), listening for the next
   transcript as that question's *answer* (not a fresh command), and
   either resolving it (handing off to the exact same
   App.VoiceBrain.route() / App.Chat.sendMessage() dispatch every
   other voice command already uses) or, after up to two retries,
   falling back to the existing manual Entry form so the user is never
   left stuck talking to a mic that isn't responding.
   This module never calls a save/entry function itself and never
   re-implements App.Chat's real amount/category/account/date slot-
   filling — it only ever hands a resolved command onward to code that
   already existed before this sprint.
================================================================ */
App.VoiceFollowUp = (function(){

  const MAX_RETRIES = 2; // matches the Bridge's own MAX_NO_SPEECH_RETRIES convention

  let pending = null; // { reason, target, originalText, retries } | null, one question at a time

  function log(...a){ if(window.App && App.Logger) App.Logger.info('[VoiceFollowUp]', ...a); }

  // Best-effort turn logging into the existing Sprint 18 Conversation
  // Context stack — reused as-is (push/list/clear already exist),
  // never re-declared here. Purely additive/diagnostic: nothing below
  // depends on this succeeding.
  function noteContext(frame){
    try{
      if(window.App && App.Conversation && App.Conversation.Context && typeof App.Conversation.Context.push==='function'){
        App.Conversation.Context.push(Object.assign({ source:'VoiceFollowUp', at:new Date().toISOString() }, frame));
      }
    }catch(e){ /* diagnostic only — never blocks the real flow */ }
  }

  function speak(text){
    if(window.App && App.Voice && App.Voice.Synthesis && App.Voice.Synthesis.isSupported()){
      App.Voice.Synthesis.speak(text);
    }
    // Sprint 19's Bridge also opens the chat panel for every real
    // exchange so a voice-only session still has a visible transcript.
    // Mirrored here for the same reason (and so quick-reply-style
    // context isn't voice-only and invisible if TTS is unsupported).
    if(window.App && App.Chat){
      if(!App.Chat.isOpen()) App.Chat.open();
      // addMessage isn't part of App.Chat's public API, so the
      // question is only guaranteed to reach the user via speech;
      // this is a best-effort visual echo using the same log the mic
      // button already reads status from.
    }
  }

  // A small, local yes/no/cancel reader. App.Chat already has
  // isYes()/isNo()/isCancel() with the exact same job, but they're
  // private closure functions — not part of App.Chat's public
  // {initialize, open, close, sendMessage, getRecentLog, isOpen,
  // onAIMessage} surface — so they can't be called from here without
  // either exporting them (out of scope: "do not change any existing
  // save/entry functions" extends to not touching App.Chat's internals
  // this sprint) or re-declaring the same small regex locally. Kept
  // intentionally minimal, not a re-implementation of App.Chat's full
  // slot-filling.
  function answerIsAffirmative(t){ return /\b(yes|yeah|yep|ha+n|haan|ok|okay|theek hai|thik hai|sahi|kholo|open|show|dikhao)\b/i.test(t||''); }
  function answerIsNegative(t){ return /\b(no|nah|nahi|nahin|galat|mat|na)\b/i.test(t||''); }

  // Friendly label for a target view, for use inside a spoken question
  // — reuses App.VoiceBrain.VIEW_LABELS (Sprint 37) rather than a new
  // hardcoded name map.
  function friendlyLabel(target){
    const syns = (window.App && App.VoiceBrain && App.VoiceBrain.VIEW_LABELS && App.VoiceBrain.VIEW_LABELS[target]) || [];
    return syns[0] || target || 'that';
  }

  function questionFor(result){
    if(result.reason === 'bare_screen_name'){
      return `Kya aap ${friendlyLabel(result.target)} kholna chahte hain, ya iske baare mein kuch bolna chahte hain — jaise amount ya category? (Did you want to open ${friendlyLabel(result.target)}, or tell me something about it — like an amount or category?)`;
    }
    // 'empty_or_filler', or any future needsFollowup reason we don't
    // have specific phrasing for yet — a safe generic clarifier.
    return "Sorry, main sun nahi paya. Aap kya karna chahte hain — jaise entry add karna, ya report dekhna? (Sorry, I didn't catch that — what would you like to do, for example add an entry, or check your report?)";
  }

  function retryQuestionFor(result){
    if(result.reason === 'bare_screen_name'){
      return `Sorry, samajh nahi paya. Sirf 'yes' bolen ${friendlyLabel(result.target)} kholne ke liye, ya bata dein aap kya karna chahte hain. (Please just say 'yes' to open ${friendlyLabel(result.target)}, or tell me what you'd like to do.)`;
    }
    return "Ek baar phir se bata dein — entry add karni hai ya kuch aur? (Once more — do you want to add an entry, or something else?)";
  }

  /** Gracefully gives up after MAX_RETRIES: opens the real, existing
   *  manual Entry form so the user isn't left stuck. Never calls any
   *  save function itself — switchToView() only changes which screen
   *  is visible, same as any tab tap. */
  function fallbackToManualForm(){
    speak("No problem — I've opened the entry screen for you so you can fill it in manually.");
    try{
      if(typeof window.switchToView === 'function') window.switchToView('entry');
    }catch(e){ log('fallbackToManualForm — switchToView failed', e); }
    noteContext({ turn:'fallback', action:'opened-manual-entry-form' });
    pending = null;
  }

  /** Starts (or restarts) a follow-up question for a needsFollowup:true
   *  App.VoiceBrain result. Safe to call repeatedly — each call speaks
   *  exactly one question and waits for the next transcript. */
  function begin(result){
    if(!result || !result.needsFollowup) return null;
    pending = { reason: result.reason, target: result.target || null, originalText: result.text || '', retries: 0 };
    log('begin —', pending.reason, pending.target || '');
    noteContext({ turn:'ask', reason: pending.reason, target: pending.target, question: questionFor(result) });
    speak(questionFor(result));
    return pending;
  }

  /** The next transcript after begin() calls into here instead of
   *  App.VoiceBrain.handle() reclassifying it as a brand-new command —
   *  see the Bridge.handleFinalTranscript() hook below. */
  function handleAnswer(text){
    if(!pending) return { handled:false };
    const t = (text || '').trim();
    noteContext({ turn:'answer', reason: pending.reason, answer: t });

    if(pending.reason === 'bare_screen_name'){
      if(answerIsAffirmative(t) && !answerIsNegative(t)){
        if(typeof window.switchToView === 'function' && pending.target) window.switchToView(pending.target);
        log('resolved — navigated to', pending.target);
        pending = null;
        return { handled:true, resolution:'navigate' };
      }
      if(!answerIsNegative(t)){
        // Not a clear "no" either — see if the answer itself is now a
        // decisive command (e.g. they went straight to "500 rupaye
        // food ke liye"). Delegate to the exact same classify/route
        // Sprint 37 already uses for every other transcript.
        const reclassified = window.App && App.VoiceBrain ? App.VoiceBrain.classify(t) : null;
        if(reclassified && !reclassified.needsFollowup){
          App.VoiceBrain.route(reclassified);
          log('resolved — delegated to VoiceBrain.route()', reclassified.intent);
          pending = null;
          return { handled:true, resolution:'delegated' };
        }
      }
      // Either a clear "no" (wants to say something about the screen,
      // not open it) or still ambiguous but not affirmative — either
      // way, the combined text is meaningful conversation content, so
      // hand it to the real chat engine exactly like Sprint 37 already
      // does for 'add_transaction'/'question' results, unless it was
      // truly too thin to bother with (matches VoiceBrain's own
      // empty/filler bar).
      if(t.length >= 2 && window.App && App.Chat){
        if(!App.Chat.isOpen()) App.Chat.open();
        App.Chat.sendMessage((pending.originalText + ' ' + t).trim(), { viaVoice:true });
        log('resolved — handed combined text to App.Chat.sendMessage()');
        pending = null;
        return { handled:true, resolution:'chat' };
      }
    } else {
      // 'empty_or_filler' (or any other future reason): re-classify
      // the answer on its own merits.
      const reclassified = window.App && App.VoiceBrain ? App.VoiceBrain.classify(t) : null;
      if(reclassified && !reclassified.needsFollowup){
        App.VoiceBrain.route(reclassified);
        log('resolved — delegated to VoiceBrain.route()', reclassified.intent);
        pending = null;
        return { handled:true, resolution:'delegated' };
      }
    }

    // Still unresolved — retry up to MAX_RETRIES, then fall back.
    pending.retries += 1;
    if(pending.retries > MAX_RETRIES){
      log('giving up after', pending.retries, 'retries — falling back to manual form');
      fallbackToManualForm();
      return { handled:true, resolution:'fallback' };
    }
    log('retry', pending.retries, 'of', MAX_RETRIES);
    speak(retryQuestionFor({ reason: pending.reason, target: pending.target }));
    return { handled:true, resolution:'retry' };
  }

  return {
    begin,
    handleAnswer,
    isPending(){ return !!pending; },
    reset(){ pending = null; }
  };
})();

/* ================================================================
   VOICE FINANCIAL Q&A   (App.VoiceQA)   —   v1.0.0
   Sprint 39 — Voice Command Brain, Part 3 of 4
   ------------------------------------------------------------------
   Full rationale lives in the Sprint 39 build-log entry at the top of
   this file. Short version: App.VoiceBrain (Sprint 37) already tags a
   transcript as intent:'question' but leaves every question to
   App.Chat -> App.OnlineAI, which has no real access to the user's
   actual numbers. This module answers the subset of questions that
   ARE real, already-tracked financial data — by calling the exact
   same App.Reports.Filter/App.Reports.Builder functions the Reports
   tab itself uses — before that fallback ever runs. Nothing here
   recomputes a total, a category sum, or a savings rate; it only
   reads the same kpis/rows the Reports tab already renders and turns
   them into one spoken + written sentence.
================================================================ */
App.VoiceQA = (function(){

  function log(...a){ if(window.App && App.Logger) App.Logger.info('[VoiceQA]', ...a); }

  // Same filter shape App.Reports.Filter.readFromUI() builds from the
  // UI — App.Reports.Filter.apply()/App.Reports.Builder.build() both
  // expect every one of these keys. A voice question is unfiltered
  // except for the date range, so every non-date field is left wide
  // open ('all'/null), same as never touching a filter dropdown.
  function wideFilter(from, to){
    return {
      period:'monthly', from, to, focus:'overview',
      txnType:'all', category:'all', subcategory:'all', account:'all',
      mode:'all', merchant:'', tag:'all', min:null, max:null
    };
  }
  // Current calendar month — App.Reports.Filter.range('monthly') is
  // the exact function the Reports tab's own "This Month" period uses.
  function thisMonthFilter(){
    const r = App.Reports.Filter.range('monthly');
    return wideFilter(r.from, r.to);
  }
  // Previous calendar month — startOfMonth(-1)/endOfMonth(-1) are the
  // same existing global helpers App.Analytics.Insights/Trends already
  // use for month-over-month comparisons (see Sprint 14 build-log).
  function lastMonthFilter(){ return wideFilter(startOfMonth(-1), endOfMonth(-1)); }

  function kpi(kpis, label){
    const k = (kpis||[]).find(x=>x.label===label);
    return k ? k.value : null;
  }

  // ---- question detection ------------------------------------------
  // Order matters: more specific phrasing (comparison, income-vs-
  // expense, savings rate) is checked before the generic "how much did
  // I spend" pattern, so e.g. a comparison question naming both months
  // isn't mistaken for a plain monthly-total question.
  const QUESTION_TYPES = [
    { id:'compare_months',     re:/pichle\s*mahine|last\s*month|mukable|compar(e|ison|ing)?/i },
    { id:'income_vs_expense',  re:/income[^?]*expense|expense[^?]*income|income\s*aur\s*expense/i },
    { id:'savings_rate',       re:/savings?\s*rate|kitn[aei]\s*bach|bachat|save\s*kar/i },
    { id:'top_category',       re:/sabse\s*zyada|top\s*categ|which\s*categ|highest[^?]*categ|kis\s*categ/i },
    { id:'month_expense',      re:/kitn[aei]\s*kharch|how\s*much[^?]*spen|total\s*expense|spending\s*this\s*month/i }
  ];

  function detect(text){
    const tl = (text||'').toLowerCase();
    for(const q of QUESTION_TYPES){ if(q.re.test(tl)) return q.id; }
    return null;
  }

  // ---- answers — each one only reads App.Reports.Filter/Builder output ----
  function answerMonthExpense(){
    const f = thisMonthFilter();
    const txns = App.Reports.Filter.apply(state.transactions, f);
    const o = App.Reports.Builder.build('overview', txns, f);
    const expense = kpi(o.kpis, 'Total Expense');
    if(expense==null) return null;
    return {
      spoken: `Is mahine aapne ${expense} kharch kiye hain. (You've spent ${expense} this month.)`,
      display: `This month's total expense: ${expense}`
    };
  }

  function answerTopCategory(){
    const f = thisMonthFilter();
    const txns = App.Reports.Filter.apply(state.transactions, f);
    const c = App.Reports.Builder.build('category', txns, f);
    if(!c.rows || !c.rows.length){
      return {
        spoken: "Is mahine abhi tak koi expense category record nahi hui. (No expense category has been recorded yet this month.)",
        display: "No expense category recorded yet this month."
      };
    }
    const top = c.rows[0];
    return {
      spoken: `Sabse zyada paisa ${top.name} category mein gaya hai — ${top.val}. (You've spent the most on ${top.name} — ${top.val}.)`,
      display: `Top spending category this month: ${top.name} (${top.val})`
    };
  }

  function answerIncomeVsExpense(){
    const f = thisMonthFilter();
    const txns = App.Reports.Filter.apply(state.transactions, f);
    const o = App.Reports.Builder.build('overview', txns, f);
    const inc = kpi(o.kpis, 'Total Income'), exp = kpi(o.kpis, 'Total Expense'), net = kpi(o.kpis, 'Net (Savings)');
    if(inc==null || exp==null) return null;
    return {
      spoken: `Is mahine income ${inc} raha aur expense ${exp} — net ${net}. (This month's income was ${inc} and expense was ${exp} — net ${net}.)`,
      display: `Income: ${inc} · Expense: ${exp} · Net: ${net}`
    };
  }

  function answerSavingsRate(){
    const f = thisMonthFilter();
    const txns = App.Reports.Filter.apply(state.transactions, f);
    const o = App.Reports.Builder.build('overview', txns, f);
    const rate = kpi(o.kpis, 'Savings Rate'), net = kpi(o.kpis, 'Net (Savings)');
    if(rate==null) return null;
    return {
      spoken: `Aapki is mahine ki savings rate ${rate} hai — matlab ${net} bache hain. (Your savings rate this month is ${rate} — meaning ${net} saved.)`,
      display: `Savings rate this month: ${rate} (${net} saved)`
    };
  }

  function answerCompareMonths(){
    const fNow = thisMonthFilter(), fPrev = lastMonthFilter();
    const txnsNow = App.Reports.Filter.apply(state.transactions, fNow);
    const txnsPrev = App.Reports.Filter.apply(state.transactions, fPrev);
    const expNow = sum(txnsNow.filter(t=>t.type==='expense'));
    const expPrev = sum(txnsPrev.filter(t=>t.type==='expense'));
    const diff = expNow - expPrev;
    const pct = expPrev>0 ? Math.abs(diff/expPrev*100).toFixed(0) : null;
    let line;
    if(expPrev<=0){
      line = `is mahine ${fmt(expNow)} kharch hua hai — pichle mahine ka data nahi hai compare karne ke liye. (this month ${fmt(expNow)} was spent — there's no previous-month data to compare against.)`;
    } else if(diff>0){
      line = `is mahine ${pct}% zyada kharch hua hai — pichle mahine ${fmt(expPrev)} tha, is mahine ${fmt(expNow)} hai. (spending is up ${pct}% versus last month — ${fmt(expPrev)} last month, ${fmt(expNow)} this month.)`;
    } else if(diff<0){
      line = `is mahine ${pct}% kam kharch hua hai — pichle mahine ${fmt(expPrev)} tha, is mahine ${fmt(expNow)} hai. (spending is down ${pct}% versus last month — ${fmt(expPrev)} last month, ${fmt(expNow)} this month.)`;
    } else {
      line = `is mahine aur pichle mahine ka kharch barabar hai — ${fmt(expNow)}. (this month and last month's spending are the same — ${fmt(expNow)}.)`;
    }
    return {
      spoken: `Pichle mahine ke mukable, ${line}`,
      display: `This month: ${fmt(expNow)} · Last month: ${fmt(expPrev)}`
    };
  }

  const HANDLERS = {
    month_expense: answerMonthExpense,
    top_category: answerTopCategory,
    income_vs_expense: answerIncomeVsExpense,
    savings_rate: answerSavingsRate,
    compare_months: answerCompareMonths
  };

  /** Tries to answer a transcript as a financial data question.
   *  Returns true (and speaks + shows the answer) if it was one of the
   *  recognized types and the underlying report data was available;
   *  returns false with no side effects otherwise, so
   *  App.VoiceBrain.route() can fall back to its normal App.Chat
   *  dispatch exactly as it did before this sprint. */
  function tryAnswer(text){
    const type = detect(text);
    if(!type || !HANDLERS[type]) return false;
    if(!(window.App && App.Reports && App.Reports.Filter && App.Reports.Builder)) return false;

    let result;
    try{ result = HANDLERS[type](); }
    catch(err){ log('answer failed for', type, err); return false; }
    if(!result) return false;

    log('answered —', type);
    if(window.App && App.Chat){
      if(!App.Chat.isOpen()) App.Chat.open();
      if(typeof App.Chat.showAssistantMessage === 'function') App.Chat.showAssistantMessage(result.display);
    }
    if(window.App && App.Voice && App.Voice.Synthesis && App.Voice.Synthesis.isSupported()){
      App.Voice.Synthesis.speak(result.spoken);
    }
    return true;
  }

  return { detect, tryAnswer };
})();

/* ================================================================
   CONVERSATION ENGINE FOUNDATION  (App.Conversation)
   ------------------------------------------------------------------
   Sprint scope: ARCHITECTURE ONLY.

   Mission for this sprint: lay the groundwork so Khaata can *behave*
   like a human conversational assistant (ChatGPT-style back-and-forth,
   clarifying questions, natural confirmations) instead of a rigid
   command parser — without yet wiring in any real intelligence.

   Nothing in this block:
     - calls any LLM / AI API
     - calls any network endpoint
     - performs speech recognition
     - reads, writes, or mutates any finance data (transactions,
       accounts, budgets, loans, investments, reminders, etc.)
     - changes any existing database/state schema beyond the
       conversation engine's own, entirely separate, placeholder
       storage keys

   It exists purely so a future sprint has typed, documented,
   testable seams to fill in — a place for real intent-detection,
   slot-filling and natural language generation to live — instead of
   new globals scattered through the file. Every method below is a
   placeholder: it validates input, updates App.Conversation.State,
   logs through App.Conversation.Logger, emits an
   App.Conversation.Events event, and returns a small structured
   result — but does no real understanding or generation yet.

   IMPORTANT — this is entirely additive. It does not touch, replace,
   or depend on:
     - the existing, already-functional "VOICE ASSISTANT" feature
     - the App.Voice foundation built in an earlier sprint (though
       App.Conversation.Language deliberately mirrors the same
       language-tagging shape as App.Voice.Language, since both will
       likely feed the same future understanding layer)
     - any existing finance logic, forms, renderers, or storage

   Submodule map:
     App.Conversation.Config      static configuration & tunables
     App.Conversation.Logger      scoped logging (delegates to App.Logger)
     App.Conversation.Events      internal pub/sub bus, scoped to conversation
     App.Conversation.State       current turn-level status of the engine
     App.Conversation.Session     conversation session lifecycle (one
                                   "chat" from open to close)
     App.Conversation.Context     short-term context stack (what we're
                                   talking about right now, cross-question
                                   awareness within a session)
     App.Conversation.Memory      temporary session memory now; reserved
                                   seam for future long-term/cross-session
                                   memory (App.MemoryEngine territory)
     App.Conversation.Intent      intent-detection seam (placeholder only)
     App.Conversation.Flow        registry of example conversational
                                   flows (Income, Expense, Transfer, Loan,
                                   Investment, Budget, Reminder, Search,
                                   General) — shape only, no logic
     App.Conversation.Question    follow-up / clarifying question generation
     App.Conversation.Validator   placeholder answer validation
     App.Conversation.Response    natural-language response generation seam
     App.Conversation.Manager     top-level orchestrator / public entry point
     App.Conversation             convenience re-exports
================================================================ */

/* ---- App.Conversation.Config -------------------------------------
   Static configuration and tunables for the future conversation
   engine. Nothing here is read by any active code path yet — it
   documents intent so later sprints have a single source of truth. */
App.Conversation.Config = {
  // Conversational turn-taking is architected around these statuses.
  // A future State-machine implementation should only ever move
  // between these named states (see App.Conversation.State below).
  STATUS: Object.freeze({
    IDLE: 'idle',
    LISTENING: 'listening',          // waiting on the user's next message
    THINKING: 'thinking',            // reserved for future async AI calls
    ASKING: 'asking',                // engine has posed a follow-up question
    CONFIRMING: 'confirming',        // engine is awaiting a yes/no confirmation
    EXECUTING: 'executing',          // reserved — an action is being carried out
    ERROR: 'error',
    ENDED: 'ended'
  }),

  // Every future conversational flow is expected to declare its type
  // from this fixed set (see App.Conversation.Flow.TYPES). Kept as a
  // flat enum rather than free strings so typos fail loudly later.
  FLOW_TYPES: Object.freeze({
    INCOME: 'income_entry',
    EXPENSE: 'expense_entry',
    TRANSFER: 'transfer',
    LOAN: 'loan',
    INVESTMENT: 'investment',
    BUDGET: 'budget',
    REMINDER: 'reminder',
    SEARCH: 'search',
    GENERAL: 'general_question'
  }),

  // Mirrors App.Voice.Config.SUPPORTED_LANGUAGES so the conversation
  // engine can eventually share a single detected-language value with
  // the voice engine. Detection itself remains unimplemented.
  SUPPORTED_LANGUAGES: Object.freeze({
    HINDI: 'hi-IN',
    ENGLISH: 'en-IN',
    HINGLISH: 'hi-en',
    AUTO: 'auto'
  }),
  DEFAULT_LANGUAGE: 'auto',

  // How many prior turns App.Conversation.Context keeps in memory for
  // "cross-questioning" (the engine referring back to something the
  // user said a few turns ago). Purely a ceiling — nothing trims to
  // it yet since no real turns are produced this sprint.
  maxContextTurns: 20,

  // Reserved: once real AI wiring exists, this is where a future
  // sprint would flag whether follow-up questions, confirmations,
  // etc. are allowed to actually fire. Everything stays disabled here.
  capabilities: Object.freeze({
    intentDetection: false,
    followUpQuestions: false,
    naturalLanguageGeneration: false,
    longTermMemory: false,
    llmApi: false,
    financeActions: false,
    interruptionHandling: false
  })
};

/* ---- App.Conversation.Logger --------------------------------------
   Thin, scoped wrapper around App.Logger so every future
   conversation-engine log line is easy to filter in devtools
   ("[Khaata:Conversation]") without duplicating console plumbing. */
App.Conversation.Logger = {
  info: (...args) => App.Logger.info('[Conversation]', ...args),
  warn: (...args) => App.Logger.warn('[Conversation]', ...args),
  error: (...args) => App.Logger.error('[Conversation]', ...args)
};

/* ---- App.Conversation.Events ---------------------------------------
   Minimal internal pub/sub bus, scoped to the conversation engine.
   Kept separate from App.Events (DOM-focused) and App.Voice.Events
   (voice-scoped) so future non-DOM consumers — tests, a chat-style
   UI, or eventually the AI layer — can subscribe without needing a
   DOM element or the voice engine to exist. */
App.Conversation.Events = (() => {
  const listeners = {};
  return {
    on(eventName, handler) {
      if (typeof handler !== 'function') {
        App.Conversation.Logger.warn('Events.on() requires a function handler; ignored.', eventName);
        return () => {};
      }
      (listeners[eventName] = listeners[eventName] || []).push(handler);
      return () => App.Conversation.Events.off(eventName, handler);
    },
    off(eventName, handler) {
      if (!listeners[eventName]) return;
      listeners[eventName] = listeners[eventName].filter(h => h !== handler);
    },
    emit(eventName, payload) {
      (listeners[eventName] || []).forEach(h => {
        try { h(payload); }
        catch (err) { App.Conversation.Logger.error(`Events listener for "${eventName}" threw`, err); }
      });
    },
    clear(eventName) {
      if (eventName) delete listeners[eventName];
      else Object.keys(listeners).forEach(k => delete listeners[k]);
    }
  };
})();

/* ---- App.Conversation.State ----------------------------------------
   Single source of truth for the *current turn's* runtime status.
   Distinct from App.Conversation.Session (which tracks the whole
   conversation's lifecycle/history) — State is "what is happening
   right now", Session is "what has happened so far". Plain object +
   accessor functions, matching the pattern App.Voice.State already
   established, for consistency across the codebase. */
App.Conversation._state = {
  status: App.Conversation.Config
    ? App.Conversation.Config.STATUS.IDLE
    : 'idle',
  language: 'auto',
  activeFlowType: null,     // one of Config.FLOW_TYPES, or null
  pendingQuestion: null,    // last question object asked to the user
  pendingConfirmation: null,// action object awaiting yes/no
  lastIntent: null,
  lastUserMessage: null,
  lastEngineMessage: null,
  lastError: null,
  updatedAt: null
};
App.Conversation.State = {
  get: () => ({ ...App.Conversation._state }), // shallow copy — read-only outward
  set: (patch) => {
    if (!patch || typeof patch !== 'object') {
      App.Conversation.Logger.warn('State.set called with a non-object patch; ignored.', patch);
      return App.Conversation.State.get();
    }
    Object.assign(App.Conversation._state, patch, { updatedAt: new Date().toISOString() });
    App.Conversation.Events.emit('state:change', App.Conversation.State.get());
    return App.Conversation.State.get();
  },
  reset: () => {
    App.Conversation._state = {
      status: App.Conversation.Config.STATUS.IDLE,
      language: App.Conversation.Config.DEFAULT_LANGUAGE,
      activeFlowType: null,
      pendingQuestion: null,
      pendingConfirmation: null,
      lastIntent: null,
      lastUserMessage: null,
      lastEngineMessage: null,
      lastError: null,
      updatedAt: new Date().toISOString()
    };
    App.Conversation.Events.emit('state:reset', App.Conversation.State.get());
    return App.Conversation.State.get();
  }
};

/* ---- App.Conversation.Session ---------------------------------------
   Tracks one conversation "session" — from the moment the user opens
   a chat-style interaction to the moment it ends. A session holds an
   ordered turn history plus metadata. No persistence to
   localStorage/Drive happens yet — see saveConversation() /
   restoreConversation() on the Manager for the reserved seam that a
   future sprint would wire this into (App.Storage / App.MemoryEngine). */
App.Conversation.Session = (() => {
  let current = null;

  function makeSessionId() {
    return 'conv_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 8);
  }

  return {
    /** Starts a brand-new, empty session. Does not touch any previous
     *  session's data — callers that want to preserve history should
     *  call App.Conversation.Manager.saveConversation() first. */
    start(meta = {}) {
      current = {
        id: makeSessionId(),
        startedAt: new Date().toISOString(),
        endedAt: null,
        turns: [],       // { role: 'user'|'engine', text, meta, at }
        meta: { ...meta }
      };
      App.Conversation.Logger.info(`Session.start() — new session "${current.id}".`);
      App.Conversation.Events.emit('session:start', { ...current });
      return { ...current };
    },
    /** Appends a single turn (user or engine message) to the active
     *  session's history. No trimming/summarization yet — see
     *  App.Conversation.Config.maxContextTurns for the future ceiling. */
    addTurn(role, text, meta = {}) {
      if (!current) {
        App.Conversation.Logger.warn('Session.addTurn() called with no active session; auto-starting one.');
        this.start();
      }
      const turn = { role, text, meta: { ...meta }, at: new Date().toISOString() };
      current.turns.push(turn);
      App.Conversation.Events.emit('session:turn', { session: current.id, turn });
      return { ...turn };
    },
    /** Marks the session as ended but keeps it in memory until a new
     *  one is started (so saveConversation() can still read it). */
    end() {
      if (!current) {
        App.Conversation.Logger.warn('Session.end() called with no active session; ignored.');
        return null;
      }
      current.endedAt = new Date().toISOString();
      App.Conversation.Logger.info(`Session.end() — session "${current.id}" ended with ${current.turns.length} turn(s).`);
      App.Conversation.Events.emit('session:end', { ...current });
      return { ...current };
    },
    get() {
      return current ? { ...current, turns: [...current.turns] } : null;
    },
    isActive() {
      return !!(current && !current.endedAt);
    },
    /** Replaces the in-memory session wholesale — the seam
     *  restoreConversation() calls into once real persistence exists. */
    restore(sessionSnapshot) {
      if (!sessionSnapshot || typeof sessionSnapshot !== 'object') {
        App.Conversation.Logger.warn('Session.restore() requires a session object; ignored.');
        return null;
      }
      current = { ...sessionSnapshot, turns: [...(sessionSnapshot.turns || [])] };
      App.Conversation.Logger.info(`Session.restore() — restored session "${current.id}".`);
      App.Conversation.Events.emit('session:restore', { ...current });
      return { ...current };
    }
  };
})();

/* ---- App.Conversation.Context ----------------------------------------
   Short-term "what are we talking about right now" stack, distinct
   from Session's full turn-by-turn history. This is what a future
   intent/slot-filling layer would consult to support cross-questioning
   — e.g. remembering that "the loan" the user just mentioned is the
   one being clarified, without re-parsing the whole session. Purely
   an in-memory stack this sprint; no real frames are ever pushed by
   any active code path. */
App.Conversation.Context = (() => {
  let stack = [];
  return {
    /** Pushes a context frame, e.g. { flowType, field, value }.
     *  Shape is intentionally loose — a future sprint defines the
     *  real schema once Intent/Flow do real work. */
    push(frame) {
      if (!frame || typeof frame !== 'object') {
        App.Conversation.Logger.warn('Context.push() requires an object frame; ignored.', frame);
        return App.Conversation.Context.list();
      }
      stack.push({ ...frame, pushedAt: new Date().toISOString() });
      if (stack.length > App.Conversation.Config.maxContextTurns) stack.shift();
      App.Conversation.Events.emit('context:push', frame);
      return App.Conversation.Context.list();
    },
    pop() {
      const frame = stack.pop() || null;
      App.Conversation.Events.emit('context:pop', frame);
      return frame;
    },
    /** Returns the most recent frame without removing it — the
     *  "what are we currently clarifying" read a future Question
     *  generator would use. */
    top() {
      return stack.length ? { ...stack[stack.length - 1] } : null;
    },
    list() {
      return [...stack];
    },
    clear() {
      stack = [];
      App.Conversation.Events.emit('context:clear', null);
    }
  };
})();

/* ---- App.Conversation.Memory ------------------------------------------
   Temporary, in-memory, per-session recall (e.g. "the account the
   user picked earlier in this chat"). Deliberately separate from
   App.Conversation.Context (which is a short-term stack for the
   *current* clarification) and from the reserved App.MemoryEngine
   namespace (which is where real cross-session/long-term memory will
   eventually live). Nothing here survives a page reload this sprint. */
App.Conversation.Memory = (() => {
  let shortTerm = {};
  return {
    /** Stores a key/value fact for the lifetime of the current
     *  session only (e.g. rememberFact('lastAccountUsed', 'HDFC')). */
    remember(key, value) {
      if (!key) {
        App.Conversation.Logger.warn('Memory.remember() requires a key; ignored.');
        return;
      }
      shortTerm[key] = value;
      App.Conversation.Events.emit('memory:set', { key, value });
    },
    recall(key) {
      return Object.prototype.hasOwnProperty.call(shortTerm, key) ? shortTerm[key] : undefined;
    },
    forget(key) {
      delete shortTerm[key];
      App.Conversation.Events.emit('memory:forget', { key });
    },
    forgetAll() {
      shortTerm = {};
      App.Conversation.Events.emit('memory:clear', null);
    },
    dump() {
      return { ...shortTerm };
    },
    /** Reserved seam: a future sprint would back this with
     *  App.MemoryEngine / App.Storage instead of a plain object, so
     *  facts survive across sessions ("the user prefers Hinglish").
     *  Unimplemented and never called this sprint. */
    rememberLongTerm(_key, _value) {
      App.Conversation.Logger.info('Memory.rememberLongTerm() — placeholder, long-term memory not implemented this sprint.');
      return false;
    },
    recallLongTerm(_key) {
      App.Conversation.Logger.info('Memory.recallLongTerm() — placeholder, long-term memory not implemented this sprint.');
      return undefined;
    }
  };
})();

/* ---- App.Conversation.Language ---------------------------------------
   Mirrors the shape of App.Voice.Language so both engines can later
   share one detected-language value. No real detection is performed —
   this always reports the configured default. */
App.Conversation.Language = {
  detectLanguage(_text) {
    App.Conversation.Logger.info('Language.detectLanguage() — placeholder, always returns the default language this sprint.');
    return { language: App.Conversation.Config.DEFAULT_LANGUAGE, confidence: 0 };
  },
  isSupported(langCode) {
    return Object.values(App.Conversation.Config.SUPPORTED_LANGUAGES).includes(langCode);
  }
};

/* ---- App.Conversation.Intent -------------------------------------------
   Seam for future intent detection ("what is the user trying to do?").
   This sprint it never actually classifies anything — it always
   returns an "unknown" result so downstream code (Flow/Question) has
   a stable shape to branch on once real detection lands. */
App.Conversation.Intent = {
  /** Placeholder classifier. Real implementation (future sprint) would
   *  inspect `text` + current App.Conversation.Context and return one
   *  of App.Conversation.Config.FLOW_TYPES with a confidence score. */
  detectIntent(text) {
    App.Conversation.Logger.info('Intent.detectIntent() — placeholder, no real classification this sprint.');
    const result = {
      flowType: null,           // would be one of Config.FLOW_TYPES
      confidence: 0,
      raw: text != null ? String(text) : '',
      recognized: false
    };
    App.Conversation.Events.emit('intent:detected', result);
    return result;
  }
};

/* ---- App.Conversation.Flow ---------------------------------------------
   Registry of example conversational flows. This sprint only defines
   the *shape* of a flow (its declared required "slots"/fields) so a
   future sprint can implement real slot-filling logic against a
   known structure. No flow here ever runs, validates money, or
   touches the finance data model. */
App.Conversation.Flow = (() => {
  const T = App.Conversation.Config.FLOW_TYPES;

  // Architecture-only slot definitions. `required` just names the
  // pieces of information a real implementation would eventually
  // need to collect via collectMissingInformation(); there is no
  // validation or finance logic tied to any of it yet.
  const registry = {
    [T.INCOME]: { type: T.INCOME, label: 'Income Entry', required: ['amount', 'source', 'account', 'date'] },
    [T.EXPENSE]: { type: T.EXPENSE, label: 'Expense Entry', required: ['amount', 'category', 'account', 'date'] },
    [T.TRANSFER]: { type: T.TRANSFER, label: 'Transfer', required: ['amount', 'fromAccount', 'toAccount', 'date'] },
    [T.LOAN]: { type: T.LOAN, label: 'Loan', required: ['party', 'amount', 'direction', 'dueDate'] },
    [T.INVESTMENT]: { type: T.INVESTMENT, label: 'Investment', required: ['amount', 'instrument', 'account', 'date'] },
    [T.BUDGET]: { type: T.BUDGET, label: 'Budget', required: ['category', 'limit', 'period'] },
    [T.REMINDER]: { type: T.REMINDER, label: 'Reminder', required: ['title', 'dueDate'] },
    [T.SEARCH]: { type: T.SEARCH, label: 'Search', required: ['query'] },
    [T.GENERAL]: { type: T.GENERAL, label: 'General Question', required: [] }
  };

  return {
    TYPES: T,
    get(flowType) {
      return registry[flowType] ? { ...registry[flowType] } : null;
    },
    list() {
      return Object.values(registry).map(f => ({ ...f }));
    },
    /** Given a flow type and the facts collected so far (a plain
     *  object keyed by slot name), returns which required slots are
     *  still missing. Pure bookkeeping — no prompting/generation
     *  happens here (that's Question.generateFollowUpQuestion()). */
    getMissingSlots(flowType, collected = {}) {
      const def = registry[flowType];
      if (!def) return [];
      return def.required.filter(slot => collected[slot] === undefined || collected[slot] === null || collected[slot] === '');
    }
  };
})();

/* ---- App.Conversation.Question -----------------------------------------
   Seam for generating human-sounding follow-up / clarifying
   questions, and for the higher-level "what do I still need to ask"
   pass over a flow's missing slots. This sprint returns templated,
   generic placeholders rather than anything context-aware. */
App.Conversation.Question = {
  /** Placeholder that reports which slots of the active flow still
   *  need answers, without yet phrasing any question. Delegates the
   *  actual "what's missing" logic to App.Conversation.Flow so the
   *  two stay in sync. */
  collectMissingInformation(flowType, collected = {}) {
    const missing = App.Conversation.Flow.getMissingSlots(flowType, collected);
    App.Conversation.Logger.info(`Question.collectMissingInformation() — ${missing.length} slot(s) missing for "${flowType}" (placeholder).`);
    App.Conversation.Events.emit('question:missing-info', { flowType, missing });
    return missing;
  },
  /** Placeholder question generator. Real natural-language phrasing
   *  (future sprint) would consider App.Conversation.Context and
   *  App.Conversation.Language; this sprint returns a generic,
   *  clearly-labeled stand-in string so the UI/plumbing can be built
   *  and tested end-to-end before real language generation exists. */
  generateFollowUpQuestion(flowType, missingSlot) {
    const question = {
      flowType: flowType || null,
      slot: missingSlot || null,
      text: missingSlot
        ? `[placeholder] Could you tell me the ${missingSlot}?`
        : '[placeholder] Could you tell me more about that?',
      generatedAt: new Date().toISOString()
    };
    App.Conversation.Logger.info('Question.generateFollowUpQuestion() — placeholder question generated, no NLG yet.');
    App.Conversation.State.set({ pendingQuestion: question, status: App.Conversation.Config.STATUS.ASKING });
    App.Conversation.Events.emit('question:generated', question);
    return question;
  }
};

/* ---- App.Conversation.Validator ----------------------------------------
   Seam for validating a user's answer to a pending question. This
   sprint performs only the most basic non-empty check — no type
   coercion, no finance-specific validation (amount formats, date
   parsing, account existence, etc.) is implemented yet. */
App.Conversation.Validator = {
  validateAnswer(answer, _question = App.Conversation.State.get().pendingQuestion) {
    const isNonEmpty = answer !== undefined && answer !== null && String(answer).trim() !== '';
    const result = {
      valid: isNonEmpty,
      reason: isNonEmpty ? null : 'empty-answer',
      normalizedValue: isNonEmpty ? String(answer).trim() : null
    };
    App.Conversation.Logger.info(`Validator.validateAnswer() — placeholder check only, valid=${result.valid}.`);
    App.Conversation.Events.emit('answer:validated', result);
    return result;
  }
};

/* ---- App.Conversation.Response -----------------------------------------
   Seam for turning an internal result (confirmation, cancellation,
   answer to a general question, etc.) into a natural-sounding
   message. This sprint returns templated text only — no LLM call, no
   real personalization. Kept as its own module so a future sprint can
   swap the implementation for a real NLG/AI call without touching
   any of the orchestration in Manager. */
App.Conversation.Response = {
  generateNaturalResponse(kind, payload = {}) {
    const templates = {
      greeting: "[placeholder] Hi! What would you like to do today?",
      confirmation: `[placeholder] Got it — should I go ahead with that?`,
      cancelled: `[placeholder] Okay, I've cancelled that.`,
      error: `[placeholder] Something went wrong on my end — could you try again?`,
      unknown: `[placeholder] I'm still learning how to respond to that.`
    };
    const response = {
      kind,
      text: templates[kind] || templates.unknown,
      payload: { ...payload },
      generatedAt: new Date().toISOString()
    };
    App.Conversation.Logger.info(`Response.generateNaturalResponse() — placeholder template used for "${kind}".`);
    App.Conversation.State.set({ lastEngineMessage: response.text });
    App.Conversation.Events.emit('response:generated', response);
    return response;
  }
};

/* ---- App.Conversation.Manager -------------------------------------------
   Top-level orchestrator. This is the surface a future chat-style UI
   would call into. Every method:
     - guards against being called in the wrong state
     - updates App.Conversation.State
     - logs via App.Conversation.Logger
     - emits an App.Conversation.Events event
     - returns a small structured result object
   and does NOT call any AI/network service or touch finance data. */
App.Conversation.Manager = {
  /** Sets up the conversation engine scaffold: resets state, does not
   *  start a session automatically. Safe to call multiple times. */
  initialize() {
    try {
      App.Conversation.State.reset();
      App.Conversation.Context.clear();
      App.Conversation.Logger.info('Manager.initialize() — conversation engine scaffold ready (architecture-only).');
      App.Conversation.Events.emit('engine:initialized', App.Conversation.State.get());
      return { ok: true };
    } catch (err) {
      App.Conversation.Logger.error('Manager.initialize() failed', err);
      return { ok: false, error: String(err && err.message || err) };
    }
  },

  /** Starts a new conversation session. Optionally accepts an initial
   *  user message, which is recorded as the first turn but — this
   *  sprint — never actually classified or acted upon. */
  startConversation(initialMessage) {
    try {
      const session = App.Conversation.Session.start();
      App.Conversation.State.set({ status: App.Conversation.Config.STATUS.LISTENING, activeFlowType: null });
      if (initialMessage != null) {
        App.Conversation.Session.addTurn('user', String(initialMessage));
        App.Conversation.State.set({ lastUserMessage: String(initialMessage) });
      }
      App.Conversation.Logger.info('Manager.startConversation() — placeholder session started, no intent handling yet.');
      App.Conversation.Events.emit('conversation:start', { session, initialMessage });
      return { ok: true, session };
    } catch (err) {
      App.Conversation.Logger.error('Manager.startConversation() failed', err);
      App.Conversation.State.set({ status: App.Conversation.Config.STATUS.ERROR, lastError: String(err && err.message || err) });
      return { ok: false, error: String(err && err.message || err) };
    }
  },

  /** Accepts the next user message in an already-open session. This
   *  sprint just records the turn, runs the placeholder intent
   *  detector, and echoes a generic placeholder response — no real
   *  understanding, slot-filling, or finance action occurs. */
  continueConversation(message) {
    try {
      if (!App.Conversation.Session.isActive()) {
        App.Conversation.Logger.warn('Manager.continueConversation() called with no active session; starting one.');
        App.Conversation.Session.start();
      }
      App.Conversation.Session.addTurn('user', String(message));
      App.Conversation.State.set({ lastUserMessage: String(message), status: App.Conversation.Config.STATUS.THINKING });

      const intent = App.Conversation.Intent.detectIntent(message);
      App.Conversation.State.set({ lastIntent: intent });

      const response = App.Conversation.Response.generateNaturalResponse('unknown', { intent });
      App.Conversation.Session.addTurn('engine', response.text, { intent });
      App.Conversation.State.set({ status: App.Conversation.Config.STATUS.LISTENING });

      App.Conversation.Logger.info('Manager.continueConversation() — placeholder turn processed, no real AI logic yet.');
      App.Conversation.Events.emit('conversation:turn', { message, intent, response });
      return { ok: true, intent, response };
    } catch (err) {
      App.Conversation.Logger.error('Manager.continueConversation() failed', err);
      App.Conversation.State.set({ status: App.Conversation.Config.STATUS.ERROR, lastError: String(err && err.message || err) });
      return { ok: false, error: String(err && err.message || err) };
    }
  },

  /** Ends the current session. Does not clear Memory automatically —
   *  future sprints may want short-term facts to survive until a new
   *  session explicitly starts; that policy decision is deferred. */
  endConversation() {
    const session = App.Conversation.Session.end();
    App.Conversation.State.set({ status: App.Conversation.Config.STATUS.ENDED });
    App.Conversation.Logger.info('Manager.endConversation() — placeholder session ended.');
    App.Conversation.Events.emit('conversation:end', session);
    return { ok: !!session, session };
  },

  /** Placeholder for the "should I go ahead?" natural confirmation
   *  step. No finance action is ever taken here — this sprint's
   *  scope is explicitly architecture-only. */
  confirmAction(pending = App.Conversation.State.get().pendingConfirmation) {
    if (!pending) {
      App.Conversation.Logger.warn('Manager.confirmAction() called with no pending action; ignored.');
      return { ok: false, reason: 'no-pending-action' };
    }
    App.Conversation.State.set({ status: App.Conversation.Config.STATUS.CONFIRMING });
    const response = App.Conversation.Response.generateNaturalResponse('confirmation', { pending });
    App.Conversation.Logger.info('Manager.confirmAction() — placeholder, finance actions not implemented this sprint.');
    App.Conversation.Events.emit('action:confirm-requested', { pending, response });
    return { ok: true, pending, response };
  },

  /** Placeholder to discard a pending (never-executed) action, with a
   *  natural-sounding cancellation message. */
  cancelAction() {
    App.Conversation.State.set({ pendingConfirmation: null, pendingQuestion: null, status: App.Conversation.Config.STATUS.LISTENING });
    const response = App.Conversation.Response.generateNaturalResponse('cancelled');
    App.Conversation.Logger.info('Manager.cancelAction() — placeholder, cleared pending action.');
    App.Conversation.Events.emit('action:cancelled', response);
    return { ok: true, response };
  },

  /** Reserved seam for persisting the current session (conversation
   *  recovery / "continue where I left off"). This sprint keeps
   *  everything in memory only — no localStorage/Drive write occurs.
   *  A future sprint would likely route this through App.Storage. */
  saveConversation() {
    const session = App.Conversation.Session.get();
    if (!session) {
      App.Conversation.Logger.warn('Manager.saveConversation() — no active session to save.');
      return { ok: false, reason: 'no-active-session' };
    }
    App.Conversation.Logger.info('Manager.saveConversation() — placeholder, session held in memory only (no persistence yet).');
    App.Conversation.Events.emit('conversation:save', session);
    return { ok: true, session };
  },

  /** Reserved seam for restoring a previously-saved session — the
   *  counterpart to saveConversation(). This sprint just delegates to
   *  Session.restore() on whatever snapshot is handed in; nothing
   *  reads that snapshot from real storage yet. */
  restoreConversation(sessionSnapshot) {
    const restored = App.Conversation.Session.restore(sessionSnapshot);
    if (!restored) {
      App.Conversation.Logger.warn('Manager.restoreConversation() — nothing restored (invalid or missing snapshot).');
      return { ok: false, reason: 'invalid-snapshot' };
    }
    App.Conversation.Logger.info('Manager.restoreConversation() — placeholder session restored into memory.');
    App.Conversation.Events.emit('conversation:restore', restored);
    return { ok: true, session: restored };
  },

  /** Thin pass-through kept on Manager (in addition to living on
   *  App.Conversation.Response) so callers that only know about
   *  Manager don't need to reach into a submodule for the common
   *  case of "just give me something to show the user". */
  generateNaturalResponse(kind, payload) {
    return App.Conversation.Response.generateNaturalResponse(kind, payload);
  }
};

/* ---- App.Conversation top-level convenience surface -------------------
   Lets future code call App.Conversation.startConversation(...) etc.
   directly, without needing to know it's really
   App.Conversation.Manager.* underneath. Deliberately NOT
   auto-invoked anywhere in this file except App.Conversation.initialize()
   below — starting/continuing an actual conversation remains
   future-sprint work triggered by a real UI action. */
Object.assign(App.Conversation, {
  initialize: (...a) => App.Conversation.Manager.initialize(...a),
  startConversation: (...a) => App.Conversation.Manager.startConversation(...a),
  continueConversation: (...a) => App.Conversation.Manager.continueConversation(...a),
  endConversation: (...a) => App.Conversation.Manager.endConversation(...a),
  detectIntent: (...a) => App.Conversation.Intent.detectIntent(...a),
  collectMissingInformation: (...a) => App.Conversation.Question.collectMissingInformation(...a),
  generateFollowUpQuestion: (...a) => App.Conversation.Question.generateFollowUpQuestion(...a),
  validateAnswer: (...a) => App.Conversation.Validator.validateAnswer(...a),
  confirmAction: (...a) => App.Conversation.Manager.confirmAction(...a),
  cancelAction: (...a) => App.Conversation.Manager.cancelAction(...a),
  saveConversation: (...a) => App.Conversation.Manager.saveConversation(...a),
  restoreConversation: (...a) => App.Conversation.Manager.restoreConversation(...a),
  generateNaturalResponse: (...a) => App.Conversation.Manager.generateNaturalResponse(...a)
});

/* Foundation is built but deliberately NOT started automatically as
   part of page load — no call to App.Conversation.initialize() here.
   A future sprint decides when/whether the conversation engine spins
   up as part of App.init(), once there's an actual chat UI and real
   understanding/generation behind it. */

/* =================================================================
   SMART INTENT DETECTION ENGINE FOUNDATION  (App.Intent)
   ------------------------------------------------------------------
   Architecture-only scaffold, same spirit as the Voice Engine and
   Conversation Engine foundations above: every method here is a
   guarded, logged, event-emitting PLACEHOLDER. Nothing in this block:
     - calls any AI model or external service
     - makes a network/API request
     - reads/writes finance data (transactions, accounts, budgets…)
     - changes the UI
   The goal is only to give a future Voice AI / Chat AI a single,
   predictable "brain" to plug real NLU into later, without any
   rework of the surrounding app.

   Module map:
     App.Intent.Config      intent types, entity types, supported
                             languages, and prepared (unused) keyword
                             scaffolding for future matching
     App.Intent.State       current in-memory intent-engine state
     App.Intent.Logger      scoped logging (delegates to App.Logger)
     App.Intent.Events      internal pub/sub bus, scoped to Intent
     App.Intent.Context     short-term context (previous turns/intents/
                             partially-collected slots) — in memory only
     App.Intent.Detector    top-of-funnel "what is the user trying to
                             do" placeholder classifier
     App.Intent.Parser      entity-extraction placeholders (amount,
                             date, person, account, payment method…)
     App.Intent.Matcher     placeholder scaffolding for matching parsed
                             text/entities against known categories,
                             accounts, and intent types
     App.Intent.Validator   structural validation of an intent result +
                             "what's still missing" bookkeeping
     App.Intent.Manager     top-level orchestrator (the public entry
                             point a future Voice/Chat AI would call)
================================================================= */

/* ---- App.Intent.Config ---------------------------------------------
   Static configuration: the vocabulary of intent types and entity
   types this engine is being built to eventually recognize, plus
   *prepared* (not yet wired to any real matching logic) keyword
   scaffolding for Hindi / English / Hinglish. Preparing this data now
   means a future sprint can implement real matching without having
   to first agree on shapes/names. */
App.Intent.Config = {
  INTENT_TYPES: {
    INCOME: 'income',
    EXPENSE: 'expense',
    TRANSFER: 'transfer',
    LOAN: 'loan',
    INVESTMENT: 'investment',
    SAVINGS: 'savings',
    BUDGET: 'budget',
    REMINDER: 'reminder',
    SEARCH: 'search',
    SETTINGS: 'settings',
    HELP: 'help',
    GENERAL: 'general_conversation'
  },
  ENTITY_TYPES: {
    AMOUNT: 'amount',
    CURRENCY: 'currency',
    DATE: 'date',
    TIME: 'time',
    CATEGORY: 'category',
    SUBCATEGORY: 'subcategory',
    ACCOUNT: 'account',
    PERSON: 'person',
    LOCATION: 'location',
    NOTES: 'notes',
    ATTACHMENTS: 'attachments'
  },
  SUPPORTED_LANGUAGES: {
    HINDI: 'hi',
    ENGLISH: 'en',
    HINGLISH: 'hi-en',
    MIXED: 'mixed'
  },
  DEFAULT_LANGUAGE: 'en',
  DEFAULT_CURRENCY: 'INR',
  // Minimum confidence a future real classifier would require before
  // treating a match as "recognized" rather than "needs clarification".
  // Not enforced anywhere yet — Detector/Matcher always return 0 this
  // sprint — but the threshold is agreed now so behaviour doesn't
  // silently shift when real scoring lands.
  MIN_CONFIDENCE: 0.6,
  // Prepared (unused this sprint) bilingual/Hinglish keyword hints per
  // intent type. Deliberately small and illustrative, not exhaustive —
  // a real implementation would likely load/derive a much larger set.
  // Reuses the app's existing App.Config.CATEGORY_KEYWORDS separately
  // for category/subcategory hints instead of duplicating that list.
  INTENT_KEYWORD_HINTS: {
    income: ['income','salary','credited','mila','mila hai','aaya','aaya hai','paisa aaya','received','earn','kamaya'],
    expense: ['spent','kharcha','kharch','diya','de diya','paid','bill bhara','liya','khareeda','bought'],
    transfer: ['transfer','bhej','bheja','bhejo','sent to','move money','transfer kar','send kar'],
    loan: ['loan','udhaar','udhar','karza','borrow','lent','diya udhaar','liya udhaar','wapas','repay'],
    investment: ['invest','nivesh','sip','mutual fund','stock','shares','fd','fixed deposit'],
    savings: ['saving','bachat','jama','jama kiya','save kar','deposit'],
    budget: ['budget','limit','budget set','kharcha limit'],
    reminder: ['remind','yaad dila','reminder set','yaad rakhna','alert kar'],
    search: ['find','search','dikhao','dhundo','khoj','kahan hai','list kar'],
    settings: ['settings','setting','badlo','change kar','update kar profile'],
    help: ['help','madad','kaise','how to','sahayata'],
    general_conversation: ['hi','hello','namaste','kaise ho','thanks','shukriya']
  },
  // Prepared placeholder patterns a future Parser could use to spot
  // amounts / dates written in mixed Hindi-English shorthand (e.g.
  // "500 rupaye", "2 hazar", "kal", "parso"). Not applied anywhere
  // this sprint — identifyAmount()/identifyDate() below are stubs.
  AMOUNT_UNIT_HINTS: ['rs','rupaye','rupees','inr','₹','hazar','hazaar','lakh','crore','k'],
  RELATIVE_DATE_HINTS: {
    en: ['today','yesterday','tomorrow','last week','next week'],
    hi: ['aaj','kal','parso','pichle hafte','agle hafte']
  }
};

/* ---- App.Intent.State / App.Intent._state -----------------------------
   Runtime state for the intent engine, isolated from the app's
   finance `state` (App.State already covers that elsewhere). Kept
   in-memory only — nothing here is persisted to localStorage/Drive. */
App.Intent._state = {
  status: 'idle', // idle | detecting | parsing | validating | error
  lastRawInput: '',
  lastLanguage: App.Intent.Config.DEFAULT_LANGUAGE,
  lastIntent: null,
  lastEntities: null,
  lastValidation: null,
  lastError: null
};
App.Intent.State = {
  get: () => ({ ...App.Intent._state }), // shallow copy — read-only outward
  set(patch) {
    if (!patch || typeof patch !== 'object') {
      App.Intent.Logger.warn('State.set called with a non-object patch; ignored.', patch);
      return App.Intent.State.get();
    }
    Object.assign(App.Intent._state, patch);
    App.Intent.Events.emit('state:change', App.Intent.State.get());
    return App.Intent.State.get();
  },
  reset() {
    App.Intent._state = {
      status: 'idle',
      lastRawInput: '',
      lastLanguage: App.Intent.Config.DEFAULT_LANGUAGE,
      lastIntent: null,
      lastEntities: null,
      lastValidation: null,
      lastError: null
    };
    App.Intent.Events.emit('state:reset', App.Intent.State.get());
    return App.Intent.State.get();
  }
};

/* ---- App.Intent.Logger --------------------------------------------
   Thin, scoped wrapper around App.Logger so every future intent-engine
   log line is easy to filter/find in devtools. */
App.Intent.Logger = {
  info: (...args) => App.Logger.info('[Intent]', ...args),
  warn: (...args) => App.Logger.warn('[Intent]', ...args),
  error: (...args) => App.Logger.error('[Intent]', ...args)
};

/* ---- App.Intent.Events ---------------------------------------------
   Minimal internal pub/sub bus, scoped to the intent engine — kept
   separate from App.Events (DOM listeners) and App.Voice.Events /
   App.Conversation.Events so each engine's traffic stays easy to
   reason about independently, even once they're wired together. */
App.Intent.Events = (() => {
  const listeners = {};
  return {
    on(eventName, handler) {
      if (typeof handler !== 'function') {
        App.Intent.Logger.warn('Events.on called without a function handler for', eventName);
        return () => {};
      }
      (listeners[eventName] = listeners[eventName] || []).push(handler);
      return () => App.Intent.Events.off(eventName, handler);
    },
    off(eventName, handler) {
      if (!listeners[eventName]) return;
      listeners[eventName] = listeners[eventName].filter(h => h !== handler);
    },
    emit(eventName, payload) {
      (listeners[eventName] || []).forEach(handler => {
        try { handler(payload); }
        catch (err) { App.Intent.Logger.error(`Listener for "${eventName}" threw`, err); }
      });
    }
  };
})();

/* ---- App.Intent.Context ---------------------------------------------
   Short-term context for multi-turn understanding (e.g. "usko 500 aur
   bhej do" needs to know who "usko" was from the previous turn). Pure
   in-memory bookkeeping this sprint — no real coreference resolution,
   no persistence. Intended to be read by App.Conversation once wired
   together, without either module needing to know the other's
   internals. */
App.Intent.Context = (() => {
  let context = {
    recentIntents: [],   // most-recent-first, capped below
    recentEntities: [],  // most-recent-first, capped below
    pendingSlots: {},    // slot name -> value, for an in-progress intent
    updatedAt: null
  };
  const MAX_HISTORY = 10;

  return {
    get() {
      return {
        ...context,
        recentIntents: [...context.recentIntents],
        recentEntities: [...context.recentEntities],
        pendingSlots: { ...context.pendingSlots }
      };
    },
    /** Records a detected intent + its entities into short-term
     *  history. Does not itself decide relevance/decay — that's
     *  future-sprint work once real detection exists. */
    remember(intentResult, entities) {
      if (intentResult) {
        context.recentIntents = [intentResult, ...context.recentIntents].slice(0, MAX_HISTORY);
      }
      if (entities) {
        context.recentEntities = [entities, ...context.recentEntities].slice(0, MAX_HISTORY);
      }
      context.updatedAt = new Date().toISOString();
      App.Intent.Events.emit('context:updated', App.Intent.Context.get());
      return App.Intent.Context.get();
    },
    setPendingSlot(name, value) {
      if (!name) return App.Intent.Context.get();
      context.pendingSlots = { ...context.pendingSlots, [name]: value };
      context.updatedAt = new Date().toISOString();
      App.Intent.Events.emit('context:slot-set', { name, value });
      return App.Intent.Context.get();
    },
    clear() {
      context = { recentIntents: [], recentEntities: [], pendingSlots: {}, updatedAt: new Date().toISOString() };
      App.Intent.Events.emit('context:cleared', App.Intent.Context.get());
      return App.Intent.Context.get();
    }
  };
})();

/* ---- App.Intent.Parser -----------------------------------------------
   Entity-extraction placeholders. Every identify*() method has the
   real future signature and return shape, but performs no actual NLP
   this sprint — each simply reports "not yet detected" so downstream
   callers (Matcher/Validator/Manager) always see a stable structure. */
App.Intent.Parser = {
  identifyAmount(_text) {
    App.Intent.Logger.info('Parser.identifyAmount() — placeholder, no real extraction this sprint.');
    return { type: App.Intent.Config.ENTITY_TYPES.AMOUNT, value: null, currency: App.Intent.Config.DEFAULT_CURRENCY, confidence: 0, found: false };
  },
  identifyDate(_text) {
    App.Intent.Logger.info('Parser.identifyDate() — placeholder, no real extraction this sprint.');
    return { type: App.Intent.Config.ENTITY_TYPES.DATE, value: null, isRelative: false, confidence: 0, found: false };
  },
  identifyCategory(_text) {
    App.Intent.Logger.info('Parser.identifyCategory() — placeholder, no real extraction this sprint.');
    return { type: App.Intent.Config.ENTITY_TYPES.CATEGORY, value: null, subcategory: null, confidence: 0, found: false };
  },
  identifyPerson(_text) {
    App.Intent.Logger.info('Parser.identifyPerson() — placeholder, no real extraction this sprint.');
    return { type: App.Intent.Config.ENTITY_TYPES.PERSON, value: null, confidence: 0, found: false };
  },
  identifyAccount(_text) {
    App.Intent.Logger.info('Parser.identifyAccount() — placeholder, no real extraction this sprint.');
    return { type: App.Intent.Config.ENTITY_TYPES.ACCOUNT, value: null, confidence: 0, found: false };
  },
  identifyPaymentMethod(_text) {
    App.Intent.Logger.info('Parser.identifyPaymentMethod() — placeholder, no real extraction this sprint.');
    return { type: 'payment_method', value: null, confidence: 0, found: false };
  },
  identifyTransactionType(_text) {
    App.Intent.Logger.info('Parser.identifyTransactionType() — placeholder, no real extraction this sprint.');
    return { type: 'transaction_type', value: null, confidence: 0, found: false };
  },
  /** Runs every identify*() above and folds the results into one
   *  entities object, keyed by App.Intent.Config.ENTITY_TYPES. Also
   *  reserves (but never fills) slots for entity types that don't
   *  have a dedicated identify*() yet (currency/time/location/notes/
   *  attachments), so the shape is already future-proof. */
  extractEntities(text) {
    try {
      App.Intent.State.set({ status: 'parsing', lastRawInput: text != null ? String(text) : '' });
      const amount = App.Intent.Parser.identifyAmount(text);
      const date = App.Intent.Parser.identifyDate(text);
      const category = App.Intent.Parser.identifyCategory(text);
      const person = App.Intent.Parser.identifyPerson(text);
      const account = App.Intent.Parser.identifyAccount(text);
      const paymentMethod = App.Intent.Parser.identifyPaymentMethod(text);
      const transactionType = App.Intent.Parser.identifyTransactionType(text);

      const entities = {
        amount, date, category, person, account, paymentMethod, transactionType,
        currency: { type: App.Intent.Config.ENTITY_TYPES.CURRENCY, value: null, confidence: 0, found: false },
        time: { type: App.Intent.Config.ENTITY_TYPES.TIME, value: null, confidence: 0, found: false },
        location: { type: App.Intent.Config.ENTITY_TYPES.LOCATION, value: null, confidence: 0, found: false },
        notes: { type: App.Intent.Config.ENTITY_TYPES.NOTES, value: null, confidence: 0, found: false },
        attachments: { type: App.Intent.Config.ENTITY_TYPES.ATTACHMENTS, value: [], confidence: 0, found: false }
      };
      App.Intent.State.set({ lastEntities: entities });
      App.Intent.Logger.info('Parser.extractEntities() — placeholder entity bundle built, nothing actually parsed this sprint.');
      App.Intent.Events.emit('entities:extracted', entities);
      return entities;
    } catch (err) {
      App.Intent.Logger.error('Parser.extractEntities() failed', err);
      App.Intent.State.set({ status: 'error', lastError: String(err && err.message || err) });
      return null;
    }
  }
};

/* ---- App.Intent.Matcher -----------------------------------------------
   Seam for matching raw text / parsed entities against the prepared
   keyword scaffolding in App.Intent.Config and the app's existing
   category keyword lists. This sprint the matchers never actually
   score anything — they always report "no match" so real matching
   logic can land later without changing the calling shape. */
App.Intent.Matcher = {
  /** Would eventually score `text` against App.Intent.Config
   *  .INTENT_KEYWORD_HINTS for every intent type and return the best
   *  match. Always returns an unmatched result this sprint. */
  matchIntentType(_text) {
    App.Intent.Logger.info('Matcher.matchIntentType() — placeholder, no real keyword matching performed this sprint.');
    return { intentType: null, confidence: 0, candidates: [] };
  },
  /** Would eventually reuse App.Config.CATEGORY_KEYWORDS (the app's
   *  existing manual/voice category keyword lists) to suggest a
   *  category/subcategory for free text. Always returns unmatched. */
  matchCategory(_text) {
    App.Intent.Logger.info('Matcher.matchCategory() — placeholder, no real keyword matching performed this sprint.');
    return { category: null, subcategory: null, confidence: 0, candidates: [] };
  },
  /** Would eventually match a spoken/typed account name against the
   *  user's real accounts (App.Helpers / App.State). Always returns
   *  unmatched this sprint — no live account data is read. */
  matchAccount(_text) {
    App.Intent.Logger.info('Matcher.matchAccount() — placeholder, no real account matching performed this sprint.');
    return { account: null, confidence: 0, candidates: [] };
  },
  /** Convenience pass that would eventually run every matcher above
   *  against a parsed entities bundle and annotate it with match
   *  candidates. This sprint just echoes the entities back unchanged. */
  matchEntities(entities) {
    App.Intent.Logger.info('Matcher.matchEntities() — placeholder, entities returned unchanged this sprint.');
    return entities || null;
  }
};

/* ---- App.Intent.Detector -----------------------------------------------
   Top-of-funnel classifier: "what is the user trying to do?" Always
   returns an unrecognized result this sprint (mirrors the existing
   App.Conversation.Intent.detectIntent() placeholder), but with the
   fuller shape (language + candidate list) a real Voice/Chat AI would
   need. */
App.Intent.Detector = {
  initialize() {
    App.Intent.State.reset();
    App.Intent.Logger.info('Detector.initialize() — intent detector reset (architecture-only).');
    return App.Intent.State.get();
  },
  /** Placeholder language detector — always reports the configured
   *  default language, regardless of script/content. Kept separate
   *  from App.Voice.Language (speech-focused) since text typed into a
   *  future chat box won't go through the voice pipeline at all. */
  detectLanguage(_text) {
    App.Intent.Logger.info('Detector.detectLanguage() — placeholder, always returns the default language this sprint.');
    return { language: App.Intent.Config.DEFAULT_LANGUAGE, confidence: 0 };
  },
  detectIntent(text) {
    try {
      const raw = text != null ? String(text) : '';
      App.Intent.State.set({ status: 'detecting', lastRawInput: raw });
      const languageResult = App.Intent.Detector.detectLanguage(raw);
      const matched = App.Intent.Matcher.matchIntentType(raw);
      const result = {
        type: matched.intentType,          // would be one of Config.INTENT_TYPES
        confidence: matched.confidence,
        language: languageResult.language,
        raw,
        recognized: false,
        candidates: matched.candidates
      };
      App.Intent.State.set({ lastLanguage: result.language, lastIntent: result, status: 'idle' });
      App.Intent.Logger.info('Detector.detectIntent() — placeholder, no real classification this sprint.');
      App.Intent.Events.emit('intent:detected', result);
      return result;
    } catch (err) {
      App.Intent.Logger.error('Detector.detectIntent() failed', err);
      App.Intent.State.set({ status: 'error', lastError: String(err && err.message || err) });
      return { type: null, confidence: 0, language: App.Intent.Config.DEFAULT_LANGUAGE, raw: text != null ? String(text) : '', recognized: false, candidates: [] };
    }
  }
};

/* ---- App.Intent.Validator -----------------------------------------------
   Structural validation of an intent result, plus "what fields would
   still be needed" bookkeeping — the App.Intent counterpart to
   App.Conversation.Flow.getMissingSlots(), using the same registry
   idea. No semantic/business validation (e.g. "is this a valid
   account") happens here, only shape-level checks. */
App.Intent.Validator = (() => {
  const T = App.Intent.Config.INTENT_TYPES;
  // Prepared required-field registry per intent type. Mirrors
  // App.Conversation.Flow's `required` lists but expressed in terms of
  // App.Intent.Config.ENTITY_TYPES so Parser/Validator/Manager all
  // speak the same vocabulary.
  const REQUIRED_FIELDS = {
    [T.INCOME]: ['amount', 'account', 'date'],
    [T.EXPENSE]: ['amount', 'category', 'account', 'date'],
    [T.TRANSFER]: ['amount', 'account', 'date'],
    [T.LOAN]: ['person', 'amount', 'date'],
    [T.INVESTMENT]: ['amount', 'account', 'date'],
    [T.SAVINGS]: ['amount', 'account', 'date'],
    [T.BUDGET]: ['category', 'amount'],
    [T.REMINDER]: ['date'],
    [T.SEARCH]: [],
    [T.SETTINGS]: [],
    [T.HELP]: [],
    [T.GENERAL]: []
  };

  return {
    REQUIRED_FIELDS: { ...REQUIRED_FIELDS },
    /** Shape-only validation: confirms an intent result has the
     *  fields a downstream consumer would expect. Never judges
     *  whether values are *correct* — that needs real entity
     *  resolution against live finance data, which is out of scope
     *  this sprint. */
    validateIntent(intentResult) {
      try {
        App.Intent.State.set({ status: 'validating' });
        const errors = [];
        if (!intentResult || typeof intentResult !== 'object') {
          errors.push('Intent result is missing or not an object.');
        } else {
          if (!('type' in intentResult)) errors.push('Intent result is missing "type".');
          if (!('confidence' in intentResult)) errors.push('Intent result is missing "confidence".');
        }
        const validation = { valid: errors.length === 0, errors, checkedAt: new Date().toISOString() };
        App.Intent.State.set({ lastValidation: validation, status: 'idle' });
        App.Intent.Logger.info('Validator.validateIntent() — placeholder structural check only, no semantic validation this sprint.');
        App.Intent.Events.emit('intent:validated', validation);
        return validation;
      } catch (err) {
        App.Intent.Logger.error('Validator.validateIntent() failed', err);
        App.Intent.State.set({ status: 'error', lastError: String(err && err.message || err) });
        return { valid: false, errors: [String(err && err.message || err)], checkedAt: new Date().toISOString() };
      }
    },
    /** Given an intent type and whatever entities/fields have been
     *  collected so far (plain object keyed by entity name), reports
     *  which required fields are still missing — pure bookkeeping,
     *  same shape as App.Conversation.Flow.getMissingSlots(). Does
     *  not itself prompt the user or fill anything in. */
    generateMissingFields(intentType, collected = {}) {
      const required = REQUIRED_FIELDS[intentType] || [];
      const missing = required.filter(field => {
        const val = collected ? collected[field] : undefined;
        if (val && typeof val === 'object' && 'found' in val) return !val.found;
        return val === undefined || val === null || val === '';
      });
      App.Intent.Logger.info('Validator.generateMissingFields() — placeholder bookkeeping, no prompting performed.');
      App.Intent.Events.emit('fields:missing', { intentType, missing });
      return missing;
    }
  };
})();

/* ---- App.Intent.Manager -------------------------------------------------
   Top-level orchestrator — the single entry point a future Voice AI
   or Chat AI would call. Every method:
     - guards against being called in the wrong state
     - updates App.Intent.State
     - logs via App.Intent.Logger
     - emits an App.Intent.Events event
     - returns a small structured result object
   and does NOT call any AI/network service, perform any finance
   action, or touch the UI. */
App.Intent.Manager = {
  /** Sets up the intent engine scaffold: resets state + context. Safe
   *  to call multiple times. Does not hook into any UI element. */
  initialize() {
    try {
      App.Intent.State.reset();
      App.Intent.Context.clear();
      App.Intent.Logger.info('Manager.initialize() — intent engine scaffold ready (architecture-only).');
      App.Intent.Events.emit('engine:initialized', App.Intent.State.get());
      return { ok: true };
    } catch (err) {
      App.Intent.Logger.error('Manager.initialize() failed', err);
      return { ok: false, error: String(err && err.message || err) };
    }
  },
  /** Full placeholder pipeline: detect intent -> extract entities ->
   *  match entities -> validate -> report missing fields -> remember
   *  in context. This sprint every stage is a stub, but the pipeline
   *  shape is the one a real implementation would keep. Never
   *  performs a finance action, regardless of what `text` says. */
  processInput(text) {
    try {
      const intent = App.Intent.Detector.detectIntent(text);
      const entities = App.Intent.Parser.extractEntities(text);
      const matchedEntities = App.Intent.Matcher.matchEntities(entities);
      const validation = App.Intent.Validator.validateIntent(intent);
      const missingFields = App.Intent.Validator.generateMissingFields(intent.type, matchedEntities || {});
      App.Intent.Context.remember(intent, matchedEntities);
      const result = { ok: true, intent, entities: matchedEntities, validation, missingFields };
      App.Intent.Logger.info('Manager.processInput() — placeholder pipeline run, no real understanding or finance action this sprint.');
      App.Intent.Events.emit('input:processed', result);
      return result;
    } catch (err) {
      App.Intent.Logger.error('Manager.processInput() failed', err);
      App.Intent.State.set({ status: 'error', lastError: String(err && err.message || err) });
      return { ok: false, error: String(err && err.message || err) };
    }
  },
  reset() {
    App.Intent.State.reset();
    App.Intent.Context.clear();
    App.Intent.Logger.info('Manager.reset() — intent engine state + context cleared.');
    App.Intent.Events.emit('engine:reset', App.Intent.State.get());
    return { ok: true };
  }
};

/* ---- App.Intent top-level convenience surface --------------------------
   Lets future code call App.Intent.detectIntent(...) /
   App.Intent.extractEntities(...) etc directly, without needing to
   know which submodule actually owns the method underneath.
   Deliberately NOT auto-invoked anywhere in this file except
   App.Intent.initialize() below — no automatic classification of any
   real user input happens as part of page load. */
Object.assign(App.Intent, {
  initialize: (...a) => App.Intent.Manager.initialize(...a),
  processInput: (...a) => App.Intent.Manager.processInput(...a),
  reset: (...a) => App.Intent.Manager.reset(...a),
  detectIntent: (...a) => App.Intent.Detector.detectIntent(...a),
  extractEntities: (...a) => App.Intent.Parser.extractEntities(...a),
  identifyCategory: (...a) => App.Intent.Parser.identifyCategory(...a),
  identifyAmount: (...a) => App.Intent.Parser.identifyAmount(...a),
  identifyDate: (...a) => App.Intent.Parser.identifyDate(...a),
  identifyPerson: (...a) => App.Intent.Parser.identifyPerson(...a),
  identifyAccount: (...a) => App.Intent.Parser.identifyAccount(...a),
  identifyPaymentMethod: (...a) => App.Intent.Parser.identifyPaymentMethod(...a),
  identifyTransactionType: (...a) => App.Intent.Parser.identifyTransactionType(...a),
  validateIntent: (...a) => App.Intent.Validator.validateIntent(...a),
  generateMissingFields: (...a) => App.Intent.Validator.generateMissingFields(...a)
});

/* Foundation is built but deliberately NOT started automatically as
   part of page load — no call to App.Intent.initialize() here. A
   future sprint decides when/whether this engine spins up as part of
   App.init(), once there's a real Voice AI / Chat AI surface and real
   understanding behind it. Intended to plug into both App.Voice
   (speech already normalized to text) and App.Conversation
   (multi-turn session/flow handling) without requiring rework of
   either. */


/* ================================================================
   SMART TRANSACTION ENGINE FOUNDATION  (App.Transaction)
   ------------------------------------------------------------------
   Sprint scope: natural-language transaction UNDERSTANDING + DRAFT
   PREPARATION only. Same architectural spirit as the Voice/
   Conversation/Intent foundations above.

   What this block does NOT do:
     - no voice/speech recognition (reads plain strings only)
     - no network/Internet calls
     - no LLM/AI API calls — every detect*() method below is plain
       regex/keyword matching, most of it reusing the app's existing,
       already-working extractAmount()/detectType()/detectCategory()/
       detectMode()/detectDate()/detectAccount()/detectItem() helpers
       (the same functions the working voice feature already calls)
       instead of duplicating that logic
     - no UI redesign — nothing here renders or touches the DOM
     - it NEVER writes to the real `state.transactions` array. It only
       builds/updates/deletes DRAFT records in its own, separate,
       localStorage-backed store. Turning a confirmed draft into a
       real transaction still goes through the app's existing,
       unchanged add-transaction flow — that wiring is future-sprint
       work, same as Voice/Conversation/Intent being "built but not
       started" today.

   Module map:
     App.Transaction.Config      transaction types, payment methods,
                                  required-field registry, storage key
     App.Transaction.State       current in-memory engine state
     App.Transaction.Logger      scoped logging (delegates to App.Logger)
     App.Transaction.Events      internal pub/sub bus, scoped to Transaction
     App.Transaction.Context     short-term "what's been collected so
                                  far for the in-progress draft" bookkeeping
     App.Transaction.Category    category detection (wraps detectCategory())
     App.Transaction.SubCategory subcategory detection (wraps the same
                                  CATEGORY_KEYWORDS sub-matching + subcatsFor())
     App.Transaction.Account     account detection (wraps detectAccount())
     App.Transaction.Parser      full field-level extraction — amount,
                                  date, notes, transaction type — wired to
                                  the app's existing helpers
     App.Transaction.Validator   missing-field / structural validation
     App.Transaction.Builder     assembles a structured Draft transaction
                                  from raw text and prepares it for
                                  user confirmation
     App.Transaction.History     append-only in-memory log of draft
                                  create/update/delete/confirm actions
     App.Transaction.Manager     top-level orchestrator + Draft CRUD +
                                  save/restore (public entry point)
     App.Transaction.Plugins     tiny registry so future modules (e.g.
                                  a real AI layer, OCR, voice) can hook
                                  extra detectors in without editing
                                  this file's core logic
================================================================= */

/* ---- App.Transaction.Config -----------------------------------------
   Static configuration: supported transaction types, payment/account
   method labels, and the required-field registry Validator uses to
   decide what's still missing. Reuses the app's existing
   App.Config.PAYMENT_MODES / ACCOUNT_TYPES / CATEGORY_KEYWORDS /
   DEFAULT_SUBCATS instead of redefining them. */
App.Transaction.Config = {
  TRANSACTION_TYPES: {
    INCOME: 'income',
    EXPENSE: 'expense',
    TRANSFER: 'transfer',
    INVESTMENT: 'investment',
    LOAN_GIVEN: 'loan_given',
    LOAN_TAKEN: 'loan_taken',
    SAVINGS: 'savings'
  },
  // Payment-method / account-flavour vocabulary the mission asked for
  // (Cash, Bank, UPI, Card, Wallet). Deliberately kept distinct from
  // App.Config.PAYMENT_MODES (used by the existing manual add-transaction
  // form) — that list stays untouched; this is the Transaction engine's
  // own normalized vocabulary for matching detected free text against.
  PAYMENT_METHODS: {
    CASH: 'Cash',
    BANK: 'Bank',
    UPI: 'UPI',
    CARD: 'Card',
    WALLET: 'Wallet'
  },
  DEFAULT_CURRENCY: 'INR',
  DRAFT_STATUS: {
    DRAFT: 'draft',           // still missing required fields
    READY: 'ready',           // all required fields present, awaiting confirmation
    CONFIRMED: 'confirmed',   // user confirmed (still not written to state.transactions here)
    DISCARDED: 'discarded'
  },
  // Required fields per transaction type — Validator's source of truth.
  // Mirrors the shape App.Intent.Validator.REQUIRED_FIELDS uses, kept as
  // a separate registry since transaction-level requirements are more
  // specific (e.g. a Loan needs a person, a Transfer needs two accounts).
  REQUIRED_FIELDS: {
    income: ['amount', 'category', 'account', 'date'],
    expense: ['amount', 'category', 'account', 'date'],
    transfer: ['amount', 'fromAccount', 'toAccount', 'date'],
    investment: ['amount', 'account', 'date'],
    loan_given: ['amount', 'person', 'date'],
    loan_taken: ['amount', 'person', 'date'],
    savings: ['amount', 'account', 'date']
  },
  // localStorage key for the Draft store. Deliberately its own new key
  // (not one of the existing save*() keys) so this sprint is purely
  // additive and never touches the app's real saved data.
  DRAFT_STORAGE_KEY: 'khaata_txn_drafts_v1',
  // Prepared (small) performance knob for future callers that parse on
  // every keystroke — not applied anywhere automatically this sprint.
  PARSE_DEBOUNCE_MS: 250,
  MAX_HISTORY: 50
};

/* ---- App.Transaction.State -------------------------------------------
   Runtime state for the engine, isolated from the app's finance
   `state` (App.State already covers that). In-memory only. */
App.Transaction._state = {
  status: 'idle', // idle | parsing | validating | error
  lastRawInput: '',
  lastDraftId: null,
  lastValidation: null,
  lastError: null
};
App.Transaction.State = {
  get: () => ({ ...App.Transaction._state }),
  set(patch) {
    if (!patch || typeof patch !== 'object') {
      App.Transaction.Logger.warn('State.set called with a non-object patch; ignored.', patch);
      return App.Transaction.State.get();
    }
    Object.assign(App.Transaction._state, patch);
    App.Transaction.Events.emit('state:change', App.Transaction.State.get());
    return App.Transaction.State.get();
  },
  reset() {
    App.Transaction._state = { status: 'idle', lastRawInput: '', lastDraftId: null, lastValidation: null, lastError: null };
    App.Transaction.Events.emit('state:reset', App.Transaction.State.get());
    return App.Transaction.State.get();
  }
};

/* ---- App.Transaction.Logger ------------------------------------------ */
App.Transaction.Logger = {
  info: (...args) => App.Logger.info('[Transaction]', ...args),
  warn: (...args) => App.Logger.warn('[Transaction]', ...args),
  error: (...args) => App.Logger.error('[Transaction]', ...args)
};

/* ---- App.Transaction.Events -------------------------------------------
   Minimal internal pub/sub bus, scoped to this engine — kept separate
   from App.Events/App.Voice.Events/App.Intent.Events so traffic from
   each engine stays easy to reason about independently. */
App.Transaction.Events = (() => {
  const listeners = {};
  return {
    on(eventName, handler) {
      if (typeof handler !== 'function') {
        App.Transaction.Logger.warn('Events.on called without a function handler for', eventName);
        return () => {};
      }
      (listeners[eventName] = listeners[eventName] || []).push(handler);
      return () => App.Transaction.Events.off(eventName, handler);
    },
    off(eventName, handler) {
      if (!listeners[eventName]) return;
      listeners[eventName] = listeners[eventName].filter(h => h !== handler);
    },
    emit(eventName, payload) {
      (listeners[eventName] || []).forEach(handler => {
        try { handler(payload); }
        catch (err) { App.Transaction.Logger.error(`Listener for "${eventName}" threw`, err); }
      });
    }
  };
})();

/* ---- App.Transaction.Context ------------------------------------------
   Short-term bookkeeping for the draft currently being assembled —
   e.g. across several follow-up answers ("500" -> "food" -> "cash").
   Pure in-memory state, separate from the persisted Draft store in
   Manager/History. */
App.Transaction.Context = (() => {
  let ctx = { pendingFields: {}, lastDraftId: null, updatedAt: null };
  return {
    get() { return { ...ctx, pendingFields: { ...ctx.pendingFields } }; },
    setField(name, value) {
      if (!name) return App.Transaction.Context.get();
      ctx.pendingFields = { ...ctx.pendingFields, [name]: value };
      ctx.updatedAt = new Date().toISOString();
      App.Transaction.Events.emit('context:field-set', { name, value });
      return App.Transaction.Context.get();
    },
    setDraftId(id) { ctx.lastDraftId = id; return App.Transaction.Context.get(); },
    clear() {
      ctx = { pendingFields: {}, lastDraftId: null, updatedAt: new Date().toISOString() };
      App.Transaction.Events.emit('context:cleared', App.Transaction.Context.get());
      return App.Transaction.Context.get();
    }
  };
})();

/* ---- App.Transaction.Category / SubCategory / Account ------------------
   Thin, documented wrappers around the app's existing detection
   helpers (findCategoryInText/detectCategory/subcatsFor/detectAccount),
   so this engine has a stable App.Transaction.* surface without
   duplicating any matching logic. Read-only — never mutate app state. */
App.Transaction.Category = {
  /** Detects category from lowercase-normalized text for a given
   *  transaction type ('income'|'expense'). Reuses the existing,
   *  already-working detectCategory(t, type) helper. */
  detect(text, type) {
    try {
      const t = String(text || '').toLowerCase();
      const kind = (type === App.Transaction.Config.TRANSACTION_TYPES.INCOME) ? 'income' : 'expense';
      const result = detectCategory(t, kind); // existing global helper, untouched
      const found = !!(result && result.category && result.category !== 'Other');
      return { value: result ? result.category : null, subcategory: result ? result.subcategory : '', confidence: found ? 0.7 : 0, found };
    } catch (err) {
      App.Transaction.Logger.error('Category.detect() failed', err);
      return { value: null, subcategory: '', confidence: 0, found: false };
    }
  },
  list(type) {
    return (type === App.Transaction.Config.TRANSACTION_TYPES.INCOME) ? incomeSources() : expenseCats();
  }
};

App.Transaction.SubCategory = {
  /** Detects a subcategory for an already-known category, reusing the
   *  app's live subcategory list (subcatsFor) plus the same
   *  CATEGORY_KEYWORDS sub-matching detectCategory() uses internally. */
  detect(text, category) {
    try {
      const t = String(text || '').toLowerCase();
      if (!category) return { value: null, confidence: 0, found: false };
      const entry = App.Config.CATEGORY_KEYWORDS.find(k => k.cat === category && k.sub && k.words.some(w => t.includes(w)));
      return entry ? { value: entry.sub, confidence: 0.7, found: true } : { value: null, confidence: 0, found: false };
    } catch (err) {
      App.Transaction.Logger.error('SubCategory.detect() failed', err);
      return { value: null, confidence: 0, found: false };
    }
  },
  list(category) {
    try { return subcatsFor(category) || []; }
    catch (err) { App.Transaction.Logger.error('SubCategory.list() failed', err); return []; }
  }
};

App.Transaction.Account = {
  /** Detects an account id from free text, reusing the existing
   *  detectAccount(t) helper (matches against the user's real,
   *  currently-active accounts — read-only, no state changes). */
  detect(text) {
    try {
      const t = String(text || '').toLowerCase();
      const accountId = detectAccount(t); // existing global helper, untouched
      return { value: accountId, confidence: accountId ? 0.6 : 0, found: !!accountId };
    } catch (err) {
      App.Transaction.Logger.error('Account.detect() failed', err);
      return { value: null, confidence: 0, found: false };
    }
  },
  /** Normalizes free text against the mission's Cash/Bank/UPI/Card/
   *  Wallet vocabulary, reusing the existing detectMode() helper and
   *  mapping its ('Cash'|'UPI'|'Card'|'Bank Transfer'|'Other') result
   *  onto App.Transaction.Config.PAYMENT_METHODS. */
  detectPaymentMethod(text) {
    try {
      const t = String(text || '').toLowerCase();
      const mode = detectMode(t); // existing global helper, untouched
      const map = { 'Cash': 'CASH', 'UPI': 'UPI', 'Card': 'CARD', 'Bank Transfer': 'BANK' };
      const key = map[mode];
      if (/wallet|paytm wallet|amazon pay/.test(t) && !key) {
        return { value: App.Transaction.Config.PAYMENT_METHODS.WALLET, confidence: 0.5, found: true };
      }
      return key
        ? { value: App.Transaction.Config.PAYMENT_METHODS[key], confidence: 0.6, found: true }
        : { value: null, confidence: 0, found: false };
    } catch (err) {
      App.Transaction.Logger.error('Account.detectPaymentMethod() failed', err);
      return { value: null, confidence: 0, found: false };
    }
  },
  list() {
    try { return activeAccounts(); }
    catch (err) { App.Transaction.Logger.error('Account.list() failed', err); return []; }
  }
};

/* ---- App.Transaction.Parser --------------------------------------------
   Field-level extraction, one method per field the mission asked for.
   Every method reuses an existing, already-working global helper where
   one exists, rather than re-implementing regex matching that's
   already in the file. Each returns the same small {value, confidence,
   found} shape so Builder/Validator can treat every field uniformly. */
App.Transaction.Parser = {
  detectAmount(text) {
    try {
      const t = String(text || '').toLowerCase();
      const value = extractAmount(t); // existing global helper, untouched
      return { value, currency: App.Transaction.Config.DEFAULT_CURRENCY, confidence: value ? 0.8 : 0, found: value != null };
    } catch (err) {
      App.Transaction.Logger.error('Parser.detectAmount() failed', err);
      return { value: null, currency: App.Transaction.Config.DEFAULT_CURRENCY, confidence: 0, found: false };
    }
  },
  detectDate(text) {
    try {
      const t = String(text || '').toLowerCase();
      const value = detectDate(t); // existing global helper, untouched — defaults to today
      return { value, confidence: 0.5, found: !!value };
    } catch (err) {
      App.Transaction.Logger.error('Parser.detectDate() failed', err);
      return { value: todayStr(), confidence: 0, found: false };
    }
  },
  detectTransactionType(text) {
    try {
      const t = String(text || '').toLowerCase();
      const T = App.Transaction.Config.TRANSACTION_TYPES;
      if (/\btransfer\b|\bbhej\b|\bbheja\b|\bmove money\b/.test(t)) return { value: T.TRANSFER, confidence: 0.6, found: true };
      if (/\bloan.*(gave|given|lent)\b|\budhaar diya\b|\bdiya udhaar\b/.test(t)) return { value: T.LOAN_GIVEN, confidence: 0.6, found: true };
      if (/\bloan.*(took|taken|borrow)\b|\budhaar liya\b|\bliya udhaar\b/.test(t)) return { value: T.LOAN_TAKEN, confidence: 0.6, found: true };
      if (/\binvest\b|\bnivesh\b|\bsip\b|\bmutual fund\b|\bstocks?\b|\bshares?\b/.test(t)) return { value: T.INVESTMENT, confidence: 0.6, found: true };
      if (/\bsav(e|ing|ings)\b|\bbachat\b|\bjama\b/.test(t)) return { value: T.SAVINGS, confidence: 0.5, found: true };
      const detected = detectType(t); // existing global helper, untouched (income/expense)
      return { value: detected.type === 'income' ? T.INCOME : T.EXPENSE, confidence: detected.assumed ? 0.3 : 0.7, found: !detected.assumed };
    } catch (err) {
      App.Transaction.Logger.error('Parser.detectTransactionType() failed', err);
      return { value: App.Transaction.Config.TRANSACTION_TYPES.EXPENSE, confidence: 0, found: false };
    }
  },
  detectCategory(text, type) { return App.Transaction.Category.detect(text, type); },
  detectSubCategory(text, category) { return App.Transaction.SubCategory.detect(text, category); },
  detectAccount(text) { return App.Transaction.Account.detect(text); },
  detectNotes(text) {
    try {
      const value = detectItem(String(text || '')); // existing global helper, untouched
      return { value: value || null, confidence: value ? 0.5 : 0, found: !!value };
    } catch (err) {
      App.Transaction.Logger.error('Parser.detectNotes() failed', err);
      return { value: null, confidence: 0, found: false };
    }
  },
  // Reserved for future sprints — no OCR/attachment capture happens here.
  detectAttachmentId(_text) {
    return { value: null, confidence: 0, found: false };
  },
  // Reserved for future sprints — no location capture happens here.
  detectLocation(_text) {
    return { value: null, confidence: 0, found: false };
  },
  /** Runs every detect*() above once and folds the results into a
   *  single fields object, keyed by field name. */
  extractFields(text) {
    try {
      App.Transaction.State.set({ status: 'parsing', lastRawInput: text != null ? String(text) : '' });
      const type = App.Transaction.Parser.detectTransactionType(text);
      const category = App.Transaction.Parser.detectCategory(text, type.value);
      const fields = {
        type,
        amount: App.Transaction.Parser.detectAmount(text),
        category,
        subcategory: App.Transaction.Parser.detectSubCategory(text, category.value),
        account: App.Transaction.Parser.detectAccount(text),
        paymentMethod: App.Transaction.Account.detectPaymentMethod(text),
        date: App.Transaction.Parser.detectDate(text),
        notes: App.Transaction.Parser.detectNotes(text),
        location: App.Transaction.Parser.detectLocation(text),
        attachmentId: App.Transaction.Parser.detectAttachmentId(text)
      };
      App.Transaction.State.set({ status: 'idle' });
      App.Transaction.Events.emit('fields:extracted', fields);
      return fields;
    } catch (err) {
      App.Transaction.Logger.error('Parser.extractFields() failed', err);
      App.Transaction.State.set({ status: 'error', lastError: String(err && err.message || err) });
      return null;
    }
  }
};

/* ---- App.Transaction.Validator -----------------------------------------
   Structural / missing-field validation only — never judges whether a
   value is *correct*, just whether the required fields for this
   transaction type are present. Prepares (but doesn't yet act on) the
   architecture for a future sprint to turn "missing" into an actual
   follow-up question via App.Conversation. */
App.Transaction.Validator = {
  /** Given a fields object (as returned by Parser.extractFields) and a
   *  transaction type, reports which required fields are still missing. */
  getMissingFields(type, fields = {}) {
    const required = App.Transaction.Config.REQUIRED_FIELDS[type] || [];
    return required.filter(name => {
      const f = fields ? fields[name] : undefined;
      if (f && typeof f === 'object' && 'found' in f) return !f.found;
      return f === undefined || f === null || f === '';
    });
  },
  /** Full validation of a Draft transaction object (see Builder). Checks
   *  the five things the mission calls out explicitly: missing amount,
   *  missing category, missing account, missing date, and missing
   *  confirmation — plus any other required field for the type. */
  validateTransaction(draft) {
    try {
      App.Transaction.State.set({ status: 'validating' });
      const errors = [];
      if (!draft || typeof draft !== 'object') {
        errors.push('Draft transaction is missing or not an object.');
        const validation = { valid: false, errors, missingFields: [], checkedAt: new Date().toISOString() };
        App.Transaction.State.set({ lastValidation: validation, status: 'idle' });
        return validation;
      }
      const missingFields = App.Transaction.Validator.getMissingFields(draft.type, draft.fields || {});
      if (missingFields.includes('amount')) errors.push('Missing amount.');
      if (missingFields.includes('category')) errors.push('Missing category.');
      if (missingFields.includes('account') || missingFields.includes('fromAccount') || missingFields.includes('toAccount')) errors.push('Missing account.');
      if (missingFields.includes('date')) errors.push('Missing date.');
      if (missingFields.includes('person')) errors.push('Missing person (required for loans).');
      if (draft.status !== App.Transaction.Config.DRAFT_STATUS.CONFIRMED && missingFields.length === 0) {
        // All required fields present but the user hasn't confirmed yet —
        // reported as a distinct, non-blocking note rather than an error,
        // since "ready but unconfirmed" is a valid, expected draft state.
      }
      const needsConfirmation = missingFields.length === 0 && draft.status !== App.Transaction.Config.DRAFT_STATUS.CONFIRMED;
      const validation = {
        valid: errors.length === 0,
        errors,
        missingFields,
        needsConfirmation,
        checkedAt: new Date().toISOString()
      };
      App.Transaction.State.set({ lastValidation: validation, status: 'idle' });
      App.Transaction.Events.emit('transaction:validated', validation);
      return validation;
    } catch (err) {
      App.Transaction.Logger.error('Validator.validateTransaction() failed', err);
      App.Transaction.State.set({ status: 'error', lastError: String(err && err.message || err) });
      return { valid: false, errors: [String(err && err.message || err)], missingFields: [], checkedAt: new Date().toISOString() };
    }
  }
};

/* ---- App.Transaction.Builder --------------------------------------------
   Assembles a structured Draft transaction from raw text (via Parser)
   and prepares a plain-language confirmation summary. Building a
   draft NEVER writes to state.transactions — see Manager for the
   Draft-store CRUD that owns persistence of drafts themselves. */
App.Transaction.Builder = {
  /** Parses `text` and returns a new, unsaved Draft transaction object.
   *  Call App.Transaction.Manager.createTransaction(text) to also
   *  persist it to the Draft store. */
  buildTransaction(text) {
    try {
      const fields = App.Transaction.Parser.extractFields(text);
      const validation = fields ? App.Transaction.Validator.getMissingFields(fields.type.value, fields) : [];
      const draft = {
        id: uid(),
        raw: text != null ? String(text) : '',
        type: fields ? fields.type.value : App.Transaction.Config.TRANSACTION_TYPES.EXPENSE,
        fields: fields || {},
        status: (fields && validation.length === 0)
          ? App.Transaction.Config.DRAFT_STATUS.READY
          : App.Transaction.Config.DRAFT_STATUS.DRAFT,
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString()
      };
      App.Transaction.Logger.info('Builder.buildTransaction() — draft assembled from real (non-AI) field detection.');
      App.Transaction.Events.emit('draft:built', draft);
      return draft;
    } catch (err) {
      App.Transaction.Logger.error('Builder.buildTransaction() failed', err);
      return null;
    }
  },
  /** Produces a short, human-readable confirmation summary for a
   *  Draft, plus its validation result — the shape a future
   *  confirmation UI (or App.Conversation follow-up question) would
   *  read from. Marks the draft READY if nothing required is missing. */
  prepareConfirmation(draft) {
    try {
      if (!draft) return { ok: false, error: 'No draft provided.' };
      const validation = App.Transaction.Validator.validateTransaction(draft);
      if (validation.missingFields.length === 0 && draft.status !== App.Transaction.Config.DRAFT_STATUS.CONFIRMED) {
        draft.status = App.Transaction.Config.DRAFT_STATUS.READY;
        draft.updatedAt = new Date().toISOString();
      }
      const f = draft.fields || {};
      const parts = [];
      if (f.amount && f.amount.found) parts.push(fmt(f.amount.value));
      if (f.category && f.category.found) parts.push(f.category.value + (f.subcategory && f.subcategory.found ? ' / ' + f.subcategory.value : ''));
      if (f.account && f.account.found) { const a = accountById(f.account.value); if (a) parts.push('via ' + a.name); }
      if (f.date && f.date.found) parts.push('on ' + f.date.value);
      const summary = parts.length ? parts.join(' — ') : 'Not enough information detected yet.';
      const result = { ok: true, draftId: draft.id, summary, validation };
      App.Transaction.Events.emit('confirmation:prepared', result);
      return result;
    } catch (err) {
      App.Transaction.Logger.error('Builder.prepareConfirmation() failed', err);
      return { ok: false, error: String(err && err.message || err) };
    }
  }
};

/* ---- App.Transaction.History --------------------------------------------
   Append-only in-memory log of what the engine did to drafts this
   session (created/updated/deleted/confirmed) — separate from
   App.Transaction.Manager's persisted Draft store, and separate from
   the app's real transaction history. Capped so it can't grow
   unbounded in a long session. */
App.Transaction.History = (() => {
  let entries = [];
  return {
    log(action, payload) {
      const entry = { action, payload, at: new Date().toISOString() };
      entries = [entry, ...entries].slice(0, App.Transaction.Config.MAX_HISTORY);
      App.Transaction.Events.emit('history:appended', entry);
      return entry;
    },
    getAll() { return [...entries]; },
    clear() { entries = []; App.Transaction.Events.emit('history:cleared', null); }
  };
})();

/* ---- App.Transaction.Plugins ---------------------------------------------
   Minimal registry so a future sprint (real AI parsing, OCR, a
   dedicated voice grammar, etc.) can register an additional detector
   or post-processor without editing this file's core logic. Empty by
   default — nothing is registered or invoked automatically. */
App.Transaction.Plugins = (() => {
  const registry = {};
  return {
    register(name, fn) {
      if (!name || typeof fn !== 'function') {
        App.Transaction.Logger.warn('Plugins.register() requires a name and a function.', name);
        return false;
      }
      registry[name] = fn;
      App.Transaction.Logger.info('Plugins.register() —', name, 'registered.');
      return true;
    },
    unregister(name) { delete registry[name]; },
    has(name) { return typeof registry[name] === 'function'; },
    list() { return Object.keys(registry); },
    /** Runs a registered plugin by name, if present. Never throws —
     *  a missing/broken plugin degrades to a no-op result. */
    run(name, ...args) {
      if (typeof registry[name] !== 'function') return { ok: false, error: `Plugin "${name}" is not registered.` };
      try { return { ok: true, result: registry[name](...args) }; }
      catch (err) { App.Transaction.Logger.error(`Plugin "${name}" threw`, err); return { ok: false, error: String(err && err.message || err) }; }
    }
  };
})();

/* ---- App.Transaction.Manager ---------------------------------------------
   Top-level orchestrator and the Draft store's CRUD surface — the
   single entry point a future confirmation UI, App.Conversation, or
   App.Voice would call. Draft persistence uses its own dedicated
   localStorage key (App.Transaction.Config.DRAFT_STORAGE_KEY) and
   never touches saveTransactions()/state.transactions. */
App.Transaction.Manager = (() => {
  function loadDrafts() {
    try {
      const raw = localStorage.getItem(App.Transaction.Config.DRAFT_STORAGE_KEY);
      const parsed = raw ? JSON.parse(raw) : [];
      return Array.isArray(parsed) ? parsed : [];
    } catch (err) {
      App.Transaction.Logger.error('Manager: failed to read draft store, starting empty.', err);
      return [];
    }
  }
  function persistDrafts(drafts) {
    try {
      localStorage.setItem(App.Transaction.Config.DRAFT_STORAGE_KEY, JSON.stringify(drafts));
      return true;
    } catch (err) {
      App.Transaction.Logger.error('Manager: failed to persist draft store.', err);
      return false;
    }
  }

  return {
    initialize() {
      try {
        App.Transaction.State.reset();
        App.Transaction.Context.clear();
        App.Transaction.Logger.info('Manager.initialize() — Smart Transaction Engine ready (drafts only, no live-data writes).');
        App.Transaction.Events.emit('engine:initialized', App.Transaction.State.get());
        return { ok: true, draftCount: loadDrafts().length };
      } catch (err) {
        App.Transaction.Logger.error('Manager.initialize() failed', err);
        return { ok: false, error: String(err && err.message || err) };
      }
    },

    /** Parses `text`, builds a Draft, persists it to the Draft store,
     *  and returns it with a ready-made confirmation summary. This is
     *  the "prepare a transaction from natural input" entry point —
     *  it does not touch state.transactions. */
    createTransaction(text) {
      try {
        const draft = App.Transaction.Builder.buildTransaction(text);
        if (!draft) return { ok: false, error: 'Could not build a draft from the given input.' };
        const drafts = loadDrafts();
        drafts.unshift(draft);
        persistDrafts(drafts);
        App.Transaction.Context.setDraftId(draft.id);
        App.Transaction.State.set({ lastDraftId: draft.id });
        const confirmation = App.Transaction.Builder.prepareConfirmation(draft);
        App.Transaction.History.log('created', { id: draft.id, status: draft.status });
        App.Transaction.Logger.info('Manager.createTransaction() — draft', draft.id, 'saved (status:', draft.status + ').');
        App.Transaction.Events.emit('draft:created', draft);
        return { ok: true, draft, confirmation };
      } catch (err) {
        App.Transaction.Logger.error('Manager.createTransaction() failed', err);
        return { ok: false, error: String(err && err.message || err) };
      }
    },

    /** Merges `patch` into an existing draft's fields/status and
     *  re-validates it. Used e.g. once a follow-up question fills in
     *  a previously-missing field. */
    updateTransaction(id, patch) {
      try {
        if (!id) return { ok: false, error: 'updateTransaction() requires a draft id.' };
        const drafts = loadDrafts();
        const idx = drafts.findIndex(d => d.id === id);
        if (idx === -1) return { ok: false, error: `No draft found with id "${id}".` };
        const merged = {
          ...drafts[idx],
          ...(patch && patch.type ? { type: patch.type } : {}),
          fields: { ...drafts[idx].fields, ...(patch && patch.fields ? patch.fields : {}) },
          updatedAt: new Date().toISOString()
        };
        const validation = App.Transaction.Validator.validateTransaction(merged);
        if (validation.missingFields.length === 0 && merged.status !== App.Transaction.Config.DRAFT_STATUS.CONFIRMED) {
          merged.status = App.Transaction.Config.DRAFT_STATUS.READY;
        }
        drafts[idx] = merged;
        persistDrafts(drafts);
        App.Transaction.History.log('updated', { id, status: merged.status });
        App.Transaction.Logger.info('Manager.updateTransaction() — draft', id, 'updated.');
        App.Transaction.Events.emit('draft:updated', merged);
        return { ok: true, draft: merged, validation };
      } catch (err) {
        App.Transaction.Logger.error('Manager.updateTransaction() failed', err);
        return { ok: false, error: String(err && err.message || err) };
      }
    },

    /** Marks a ready draft as CONFIRMED. Still does not write to
     *  state.transactions — wiring a confirmed draft into the app's
     *  real add-transaction flow is explicitly future-sprint work. */
    confirmTransaction(id) {
      try {
        const drafts = loadDrafts();
        const idx = drafts.findIndex(d => d.id === id);
        if (idx === -1) return { ok: false, error: `No draft found with id "${id}".` };
        const validation = App.Transaction.Validator.validateTransaction(drafts[idx]);
        if (validation.missingFields.length > 0) {
          return { ok: false, error: 'Cannot confirm — required fields still missing.', missingFields: validation.missingFields };
        }
        drafts[idx].status = App.Transaction.Config.DRAFT_STATUS.CONFIRMED;
        drafts[idx].updatedAt = new Date().toISOString();
        persistDrafts(drafts);
        App.Transaction.History.log('confirmed', { id });
        App.Transaction.Logger.info('Manager.confirmTransaction() — draft', id, 'marked confirmed (not yet written to live transactions).');
        App.Transaction.Events.emit('draft:confirmed', drafts[idx]);
        return { ok: true, draft: drafts[idx] };
      } catch (err) {
        App.Transaction.Logger.error('Manager.confirmTransaction() failed', err);
        return { ok: false, error: String(err && err.message || err) };
      }
    },

    deleteTransaction(id) {
      try {
        if (!id) return { ok: false, error: 'deleteTransaction() requires a draft id.' };
        const drafts = loadDrafts();
        const next = drafts.filter(d => d.id !== id);
        if (next.length === drafts.length) return { ok: false, error: `No draft found with id "${id}".` };
        persistDrafts(next);
        App.Transaction.History.log('deleted', { id });
        App.Transaction.Logger.info('Manager.deleteTransaction() — draft', id, 'removed from the Draft store.');
        App.Transaction.Events.emit('draft:deleted', { id });
        return { ok: true };
      } catch (err) {
        App.Transaction.Logger.error('Manager.deleteTransaction() failed', err);
        return { ok: false, error: String(err && err.message || err) };
      }
    },

    getTransaction(id) { return loadDrafts().find(d => d.id === id) || null; },
    listDrafts() { return loadDrafts(); },

    /** Explicit save — mostly here for API completeness/consistency
     *  with the mission's requested method names; createTransaction()/
     *  updateTransaction() already persist automatically. */
    saveDraft(draft) {
      try {
        if (!draft || !draft.id) return { ok: false, error: 'saveDraft() requires a draft with an id.' };
        const drafts = loadDrafts();
        const idx = drafts.findIndex(d => d.id === draft.id);
        if (idx === -1) drafts.unshift(draft); else drafts[idx] = draft;
        persistDrafts(drafts);
        App.Transaction.History.log('saved', { id: draft.id });
        return { ok: true };
      } catch (err) {
        App.Transaction.Logger.error('Manager.saveDraft() failed', err);
        return { ok: false, error: String(err && err.message || err) };
      }
    },
    /** Restores a specific draft by id, or the most recently updated
     *  one if no id is given (e.g. resuming after a page reload). */
    restoreDraft(id) {
      try {
        const drafts = loadDrafts();
        if (!drafts.length) return { ok: false, error: 'No saved drafts to restore.' };
        const draft = id ? drafts.find(d => d.id === id) : drafts.slice().sort((a, b) => (b.updatedAt || '').localeCompare(a.updatedAt || ''))[0];
        if (!draft) return { ok: false, error: `No draft found with id "${id}".` };
        App.Transaction.Context.setDraftId(draft.id);
        App.Transaction.State.set({ lastDraftId: draft.id });
        App.Transaction.Events.emit('draft:restored', draft);
        return { ok: true, draft };
      } catch (err) {
        App.Transaction.Logger.error('Manager.restoreDraft() failed', err);
        return { ok: false, error: String(err && err.message || err) };
      }
    },

    reset() {
      App.Transaction.State.reset();
      App.Transaction.Context.clear();
      App.Transaction.Logger.info('Manager.reset() — Transaction engine state + context cleared (Draft store on disk left untouched).');
      App.Transaction.Events.emit('engine:reset', App.Transaction.State.get());
      return { ok: true };
    }
  };
})();

/* ---- App.Transaction top-level convenience surface ----------------------
   Lets future code call App.Transaction.createTransaction(...) etc.
   directly, without needing to know which submodule owns the method.
   Deliberately NOT auto-invoked anywhere in this file except
   App.Transaction.initialize() below — nothing here runs automatically
   as part of page load, and nothing here ever mutates
   state.transactions. */
Object.assign(App.Transaction, {
  initialize: (...a) => App.Transaction.Manager.initialize(...a),
  createTransaction: (...a) => App.Transaction.Manager.createTransaction(...a),
  updateTransaction: (...a) => App.Transaction.Manager.updateTransaction(...a),
  deleteTransaction: (...a) => App.Transaction.Manager.deleteTransaction(...a),
  confirmTransaction: (...a) => App.Transaction.Manager.confirmTransaction(...a),
  getTransaction: (...a) => App.Transaction.Manager.getTransaction(...a),
  listDrafts: (...a) => App.Transaction.Manager.listDrafts(...a),
  saveDraft: (...a) => App.Transaction.Manager.saveDraft(...a),
  restoreDraft: (...a) => App.Transaction.Manager.restoreDraft(...a),
  reset: (...a) => App.Transaction.Manager.reset(...a),
  buildTransaction: (...a) => App.Transaction.Builder.buildTransaction(...a),
  prepareConfirmation: (...a) => App.Transaction.Builder.prepareConfirmation(...a),
  validateTransaction: (...a) => App.Transaction.Validator.validateTransaction(...a),
  detectTransactionType: (...a) => App.Transaction.Parser.detectTransactionType(...a),
  detectCategory: (...a) => App.Transaction.Parser.detectCategory(...a),
  detectSubCategory: (...a) => App.Transaction.Parser.detectSubCategory(...a),
  detectAmount: (...a) => App.Transaction.Parser.detectAmount(...a),
  detectDate: (...a) => App.Transaction.Parser.detectDate(...a),
  detectAccount: (...a) => App.Transaction.Parser.detectAccount(...a),
  detectNotes: (...a) => App.Transaction.Parser.detectNotes(...a)
});

/* Foundation is built but deliberately NOT started automatically as
   part of page load — no call to App.Transaction.initialize() here.
   A future sprint decides when/whether a real confirmation UI (or
   App.Conversation/App.Voice) drives this engine, and when/whether a
   CONFIRMED draft gets turned into a real entry in state.transactions
   via the app's existing, unchanged add-transaction flow. */

/* ---------------------------------------------------------------
   TODO MODULE PLACEHOLDERS
   Empty on purpose this sprint — reserved so future work has an
   agreed home instead of new globals scattered through the file.
--------------------------------------------------------------- */
// TODO(AI Engine): natural-language finance assistant / smart suggestions.
// TODO(Voice Engine): App.Voice foundation built this sprint (see "VOICE
//   ENGINE FOUNDATION" above) — real recognition, command grammar, and
//   wiring the existing voice-assistant UI to it are future-sprint work.
//   App.VoiceEngine remains reserved/empty for now.
// TODO(Conversation Engine): App.Conversation foundation built this
//   sprint (see "CONVERSATION ENGINE FOUNDATION" above) — real intent
//   detection, slot-filling, and natural language generation, plus
//   wiring in an actual chat UI, are future-sprint work. This is
//   deliberately architected to plug into App.Voice and a future
//   App.AIEngine without requiring rework. App.ConversationEngine
//   remains reserved/empty for now.
// TODO(Offline Engine): offline action queueing & conflict resolution.
// TODO(Online Engine): cloud sync beyond the current Google Drive backup.
// TODO(Attachment Engine): receipts / attachment capture & storage.
// TODO(Search Engine): migrate the existing universal search (see the
//   UNIVERSAL FINANCE SEARCH section above) into App.SearchEngine.
// TODO(Memory Engine): long-term user memory & personalization.
// TODO(Analytics Engine): deeper analytics beyond current charts/insights.
// TODO(Intent Engine): App.Intent foundation built this sprint (see
//   "SMART INTENT DETECTION ENGINE FOUNDATION" above) — real intent
//   classification, entity extraction, and Hindi/English/Hinglish
//   language handling are future-sprint work. Designed to plug into
//   App.Voice and App.Conversation as the shared "brain" once real
//   NLU logic lands, without requiring rework of either.
// TODO(Transaction Engine): App.Transaction foundation built this sprint
//   (see "SMART TRANSACTION ENGINE FOUNDATION" above) — real field
//   detection is wired up (reusing the existing extractAmount()/
//   detectType()/detectCategory()/detectMode()/detectDate()/
//   detectAccount()/detectItem() helpers), plus a Draft store, missing-
//   field validation, history logging and a plugin registry. Turning a
//   CONFIRMED draft into a real state.transactions entry through the
//   app's existing add-transaction flow, and wiring a confirmation UI /
//   follow-up questions via App.Conversation, are future-sprint work.

/* ================================================================
   REAL CONVERSATION ENGINE  (App.Chat)
   ------------------------------------------------------------------
   This is the actual, working implementation of human-like,
   ChatGPT-style back-and-forth for logging transactions — the real
   counterpart to the architecture-only foundations built earlier
   (App.Conversation / App.Intent / App.Transaction) and to the
   already-working Part 2.3 voice assistant. It is entirely additive:
   it does not touch, rename, or remove anything above, and it does
   not use any network call, LLM API, or online service — all
   understanding is done locally with keyword/pattern matching,
   reusing the same extractAmount()/detectType()/detectCategory()/
   detectMode()/detectDate()/findGoalInText() helpers the voice
   assistant already relies on, so behavior stays consistent across
   both surfaces.

   Flow: classify what the user means (income / expense / transfer /
   savings / loan / investment) → pull whatever fields are already in
   their message → ask, one question at a time, for whatever is still
   missing → summarize → confirm → save through the app's existing,
   unchanged save*()/state.* functions → refresh the existing views.

   Supports Hindi, English, Hinglish and mixed-language replies via
   bilingual keyword lists (this is pattern matching on common
   words/spellings, not real language detection).
================================================================ */

/* ================================================================
   MULTI-ITEM TRANSACTION HELPERS   (App.Transaction.MultiItem)
   Sprint 25 — additive. The single shared place that knows how to
   turn a list of child line items into a valid parent transaction.
   Reused by:
     - the New Transaction form's item repeater (manual entry)
     - App.Transaction.ItemsEditor (editing an existing transaction's
       items from the Transactions list)
     - App.Chat's grouped-expense voice/chat flow (saveDraft())
   so the amount/summary math is written and tested in exactly one
   place instead of three. Does not read or write state.transactions
   itself — callers still go through the existing saveTransactions().
================================================================ */
App.Transaction.MultiItem = (function(){
  function cleanItem(raw){
    raw = raw || {};
    const qtyNum = (raw.qty !== null && raw.qty !== undefined && raw.qty !== '') ? Number(raw.qty) : null;
    return {
      id: raw.id || uid(),
      name: (raw.name || '').toString().trim(),
      amount: Number(raw.amount) || 0,
      qty: (qtyNum !== null && !isNaN(qtyNum)) ? qtyNum : null,
      unit: (raw.unit || '').toString().trim() || null,
      notes: (raw.notes || '').toString().trim(),
      tags: Array.isArray(raw.tags) ? raw.tags.slice() : []
    };
  }
  function sum(items){
    return (items || []).reduce((total, it) => total + (Number(it.amount) || 0), 0);
  }
  // A short human-readable label for the parent's existing `item` field,
  // so every pre-existing reader of t.item (search, CSV export, list
  // view fallback text) keeps showing something sensible.
  function summaryLabel(items){
    return (items || []).map(it => it.name).filter(Boolean).join(', ');
  }
  // base: the shared parent-level fields (id/type/date/time/category/
  // subcategory/account/mode/notes/tags/item). rawItems: unclean item
  // rows straight from a form or voice session. Returns a full,
  // ready-to-push transaction object — amount and item are always
  // (re)computed from valid items, never trusted from `base`.
  function buildParentTxn(base, rawItems){
    const items = (rawItems || []).map(cleanItem).filter(it => it.name && it.amount > 0);
    const amount = sum(items);
    return Object.assign({}, base, {
      amount,
      item: (base && base.item && base.item.trim()) ? base.item.trim() : summaryLabel(items),
      items,
      isMultiItem: items.length > 0
    });
  }
  function addItem(list, raw){ list.push(cleanItem(raw || { name:'', amount:'' })); return list; }
  function removeItem(list, id){ const i = list.findIndex(x=>x.id===id); if(i>-1) list.splice(i,1); return list; }
  function duplicateItem(list, id){
    const i = list.findIndex(x=>x.id===id);
    if(i>-1){ const copy = Object.assign({}, list[i], { id: uid() }); list.splice(i+1, 0, copy); }
    return list;
  }
  function moveItem(list, id, direction){
    const i = list.findIndex(x=>x.id===id);
    if(i===-1) return list;
    const j = i + direction;
    if(j<0 || j>=list.length) return list;
    const tmp = list[i]; list[i] = list[j]; list[j] = tmp;
    return list;
  }
  return { cleanItem, sum, summaryLabel, buildParentTxn, addItem, removeItem, duplicateItem, moveItem };
})();

/* ---- Items Editor sheet (App.Transaction.ItemsEditor) --------------
   Lets the user Add/Delete/Edit/Reorder/Duplicate the child items of
   an EXISTING transaction that already has an items[] array. Opened
   from a new "🧾 N" badge in the Transactions list (see renderTransactions
   below) — the existing pencil-icon single-amount edit is untouched and
   still works exactly as before for every transaction. */
App.Transaction.ItemsEditor = (function(){
  let workingId = null;
  let workingItems = [];
  function el(id){ return document.getElementById(id); }

  function render(){
    const wrap = el('itemsEditorList');
    if(!wrap) return;
    wrap.innerHTML = workingItems.length ? workingItems.map(it => `
      <div class="mi-item-row" data-id="${it.id}">
        <div class="mi-item-main">
          <input type="text" class="mi-name" placeholder="Item name" value="${escapeHtml(it.name)}">
          <input type="number" class="mi-amount" placeholder="0.00" min="0" step="0.01" value="${it.amount || ''}">
        </div>
        <div class="mi-item-actions">
          <button type="button" class="mi-up" title="Move up">↑</button>
          <button type="button" class="mi-down" title="Move down">↓</button>
          <button type="button" class="mi-dup" title="Duplicate">⧉</button>
          <button type="button" class="mi-del" title="Delete">✕</button>
        </div>
      </div>`).join('') : '<div class="empty-note">No items — add one below.</div>';
    el('itemsEditorTotal').textContent = fmt(App.Transaction.MultiItem.sum(workingItems));
    wrap.querySelectorAll('.mi-item-row').forEach(row=>{
      const id = row.dataset.id;
      const it = workingItems.find(x=>x.id===id);
      if(!it) return;
      row.querySelector('.mi-name').addEventListener('input', e=>{ it.name = e.target.value; });
      row.querySelector('.mi-amount').addEventListener('input', e=>{
        it.amount = parseFloat(e.target.value) || 0;
        el('itemsEditorTotal').textContent = fmt(App.Transaction.MultiItem.sum(workingItems));
      });
      row.querySelector('.mi-up').addEventListener('click', ()=>{ App.Transaction.MultiItem.moveItem(workingItems, id, -1); render(); });
      row.querySelector('.mi-down').addEventListener('click', ()=>{ App.Transaction.MultiItem.moveItem(workingItems, id, 1); render(); });
      row.querySelector('.mi-dup').addEventListener('click', ()=>{ App.Transaction.MultiItem.duplicateItem(workingItems, id); render(); });
      row.querySelector('.mi-del').addEventListener('click', ()=>{ App.Transaction.MultiItem.removeItem(workingItems, id); render(); });
    });
  }

  function open(txnId){
    const t = state.transactions.find(x=>x.id===txnId);
    if(!t || !Array.isArray(t.items)) return;
    workingId = txnId;
    workingItems = t.items.map(it=>Object.assign({}, it));
    el('itemsEditorTxnInfo').textContent = `${t.category || t.type} · ${t.date}`;
    render();
    el('itemsEditorOverlay').classList.remove('hidden');
  }
  function close(){
    el('itemsEditorOverlay').classList.add('hidden');
    workingId = null; workingItems = [];
  }
  async function save(){
    const t = state.transactions.find(x=>x.id===workingId);
    if(!t){ close(); return; }
    if(!workingItems.some(it=>it.name.trim() && Number(it.amount)>0)){
      alert('Keep at least one item with a name and amount.');
      return;
    }
    const rebuilt = App.Transaction.MultiItem.buildParentTxn({
      id: t.id, type: t.type, date: t.date, time: t.time, category: t.category,
      subcategory: t.subcategory, account: t.account, mode: t.mode, notes: t.notes,
      tags: t.tags, item: ''
    }, workingItems);
    Object.assign(t, rebuilt);
    await saveTransactions();
    renderTransactions();
    refreshAllCharts();
    close();
  }
  function bind(){
    el('itemsEditorClose').addEventListener('click', close);
    el('itemsEditorOverlay').addEventListener('click', e=>{ if(e.target.id==='itemsEditorOverlay') close(); });
    el('itemsEditorAddBtn').addEventListener('click', ()=>{ App.Transaction.MultiItem.addItem(workingItems, {name:'', amount:''}); render(); });
    el('itemsEditorSaveBtn').addEventListener('click', save);
  }
  return { open, close, bind };
})();

App.Chat = (function(){
  const LOG_KEY = 'khaata:chatlog';
  const SESSION_KEY = 'khaata:chatsession';
  const MAX_LOG = 200;
  const SESSION_TIMEOUT_MS = 15*60*1000; // idle-session timeout

  let log = [];          // {role:'user'|'ai', text, quick?:string[], ts}
  let session = null;    // active slot-filling session, or null between transactions
  let typingVisible = false;
  let typingTimer = null;
  // ---- Sprint 19: voice bridge hooks (App.Chat still knows nothing about
  // voice itself — these are generic seams App.Voice.Bridge attaches to) ----
  let aiMessageListeners = []; // notified with (text, quick) whenever an AI message is added
  let lastInputViaVoice = false; // set just before handleUserMessage() runs when the message came in via sendMessage(text,{viaVoice:true})
  let pendingAttachPrompt = false; // set after a voice-originated income/expense save; the next message answers "attach a receipt photo?" instead of starting a new command

  /* ---------------- Sprint 43: proactive post-save insight (Part 2 of 3) ----------------
     See the Sprint 43 build-log block at the top of this file for the
     full rationale. In short: proactiveExpenseInsight()/proactiveGoalInsight()
     below are thin readers over the EXISTING App.Advisor engines
     (App.Advisor.Notifications.computeAlerts, App.Advisor.Analysis.patterns,
     computeGoalPlan/computeGoalStatus) — no financial math lives here.
     insightLog is only a small "don't repeat the same thing too soon" gate
     so saveDraft() doesn't append an insight sentence on every single save. */
  const INSIGHT_LOG_KEY = 'khaata:chatinsightlog';
  const INSIGHT_COOLDOWN_MS = 12*60*60*1000; // same insight id won't repeat sooner than this
  let insightLog = {}; // {insightId: ISO timestamp last spoken in chat}

  function insightOnCooldown(id){
    const ts = insightLog[id];
    return !!ts && (Date.now() - new Date(ts).getTime()) < INSIGHT_COOLDOWN_MS;
  }
  function markInsightSpoken(id){ insightLog[id] = new Date().toISOString(); persist(); }

  // Reuses App.Advisor.Notifications.computeAlerts(txn) — the exact same
  // duplicate/unusually-large/over-budget/low-balance checks the manual
  // entry form's real-time toast already runs — then, only if none of
  // those fired, reads App.Advisor.Analysis.patterns().budgetUsage (same
  // figures the Advisor tab's budget suggestions already use) against the
  // existing BUDGET_NEAR_LIMIT_PCT threshold to catch "close to budget but
  // not over yet". Returns null whenever there's nothing real to say.
  function proactiveExpenseInsight(txn){
    if(!window.App || !App.Advisor || !txn) return null;
    try{
      const alerts = App.Advisor.Notifications.computeAlerts(txn);
      const top = alerts.find(a=>a.level==='bad') || alerts.find(a=>a.level==='warn');
      if(top && !insightOnCooldown(top.id)){
        markInsightSpoken(top.id);
        return top.text;
      }
      const patterns = App.Advisor.Analysis.patterns();
      const b = (patterns.budgetUsage||[]).find(x=>x.category===txn.category);
      if(b && b.budget>0 && b.pct!=null && b.pct<100 && b.pct>=App.Advisor.Config.BUDGET_NEAR_LIMIT_PCT){
        const id = 'near-budget-'+txn.category+'-'+monthKey(todayStr());
        if(!insightOnCooldown(id)){
          markInsightSpoken(id);
          return `Heads up — this puts your ${txn.category} spend at ${b.pct.toFixed(0)}% of its ${fmt(b.budget)} budget for the month.`;
        }
      }
    }catch(err){ App.Logger.error('[Chat] proactiveExpenseInsight failed', err); }
    return null;
  }

  // Reuses the existing computeGoalPlan()/computeGoalStatus() (same
  // functions the Goals tab already calls) to see whether a chat-logged
  // contribution landed on a goal that's genuinely 'On Track' or 'Behind'.
  // Any other status (Completed/Paused/Not Started/In Progress with no
  // target date) has nothing worth proactively mentioning, so returns null.
  function proactiveGoalInsight(goalId){
    if(!goalId) return null;
    try{
      const g = (state.goals||[]).find(x=>x.id===goalId);
      if(!g || g.isEmergencyFund || g.achieved) return null;
      const plan = computeGoalPlan();
      const status = computeGoalStatus(g, plan);
      if(status!=='On Track' && status!=='Behind') return null;
      const id = 'goal-status-'+g.id+'-'+status;
      if(insightOnCooldown(id)) return null;
      markInsightSpoken(id);
      return status==='On Track'
        ? `You're on track with your "${g.name}" goal — nice pace.`
        : `Small note — "${g.name}" is currently behind its target pace.`;
    }catch(err){ App.Logger.error('[Chat] proactiveGoalInsight failed', err); return null; }
  }

  /* ---------------- Sprint 18: reasoning layer ----------------
     memoryCache holds the last snapshot from App.Memory.Manager.suggest()
     (learned frequency data — top categories/accounts/modes, last-used
     values). It is refreshed opportunistically (chat open, after a
     save) rather than awaited inline, so the existing synchronous
     slot-filling flow below is untouched — this only adds *optional*
     extra signal on top of it, never blocks or replaces it. If
     App.Memory isn't available for any reason, every function below
     degrades to its current (pre-Sprint-18) behavior automatically. */
  let memoryCache = null;
  function refreshMemoryCache(){
    try{
      if(window.App && App.Memory && App.Memory.Manager && typeof App.Memory.Manager.suggest==='function'){
        App.Memory.Manager.suggest().then(s=>{ memoryCache = s; }).catch(()=>{});
      }
    }catch(e){ /* best-effort — chat works fine without this */ }
  }
  // note(): appends a short, human-readable reason to the current
  // session's reasoning trace, so "Why?" during confirmation can
  // explain — in plain language — what was auto-filled and why,
  // instead of the user having to trust a black box.
  function note(text){
    if(!session) return;
    session.fields.__reasoning = session.fields.__reasoning || [];
    session.fields.__reasoning.push(text);
  }
  // Learned-preference lookups — read-only glances at the memory
  // snapshot above. Both return null (never throw, never guess wildly)
  // whenever memory hasn't loaded yet or has nothing relevant, so every
  // call site already has a safe existing fallback to drop back to.
  function memoryPreferredCategory(kind){
    if(!memoryCache) return null;
    const cat = kind==='income'
      ? (memoryCache.lastIncomeSource || (memoryCache.topIncomeSources && memoryCache.topIncomeSources[0]))
      : (memoryCache.lastExpenseCategory || (memoryCache.topExpenseCategories && memoryCache.topExpenseCategories[0]));
    if(!cat) return null;
    const list = kind==='income' ? incomeSources() : expenseCats();
    return list.includes(cat) ? cat : null; // never suggest a category that no longer exists
  }
  function memoryPreferredAccountId(){
    if(!memoryCache || !memoryCache.lastAccount) return null;
    const accts = activeAccounts();
    const match = accts.find(a=>a.name===memoryCache.lastAccount) ||
                  accts.find(a=>memoryCache.topAccounts && memoryCache.topAccounts.includes(a.name));
    return match ? match.id : null;
  }

  /* ---------------- temporary memory / session recovery ---------------- */
  function persist(){
    try{ localStorage.setItem(LOG_KEY, JSON.stringify(log.slice(-MAX_LOG))); }catch(e){ /* best-effort */ }
    try{ localStorage.setItem(SESSION_KEY, JSON.stringify(session)); }catch(e){ /* best-effort */ }
    // Sprint 43 — persists the proactive-insight cooldown (see above) so a
    // page reload doesn't forget an insight was just spoken and repeat it.
    try{ localStorage.setItem(INSIGHT_LOG_KEY, JSON.stringify(insightLog)); }catch(e){ /* best-effort */ }
  }
  function restore(){
    try{ const l = JSON.parse(localStorage.getItem(LOG_KEY)||'[]'); log = Array.isArray(l) ? l : []; }catch(e){ log = []; }
    try{ session = JSON.parse(localStorage.getItem(SESSION_KEY)||'null'); }catch(e){ session = null; }
    try{ const il = JSON.parse(localStorage.getItem(INSIGHT_LOG_KEY)||'{}'); insightLog = (il && typeof il==='object') ? il : {}; }catch(e){ insightLog = {}; }
  }

  /* ---------------- small text helpers (Hindi/English/Hinglish) ---------------- */
  function cap(s){ return s ? s.charAt(0).toUpperCase()+s.slice(1).toLowerCase() : s; }
  function isYes(t){ return /\b(yes|yeah|yep|yup|haan|ha|han|ok|okay|okey|theek hai|thik hai|sahi hai|sahi|confirm|save it|save this|kar do|karo|bilkul|right)\b/i.test(t); }
  function isNo(t){ return /\b(no|nah|nope|nahi|nahin|galat|wrong|mat karo|rehne do)\b/i.test(t); }
  function isCancel(t){ return /\b(cancel|band karo|chodo|chhodo|forget it|nevermind|never mind)\b/i.test(t); }
  function isRestart(t){ return /\b(restart|reset|shuru se|dobara|start over|naya|phir se)\b/i.test(t); }

  function extractPerson(origText){
    const t = origText.toLowerCase();
    const relationMap = {
      papa:'Father', pita:'Father', father:'Father', dad:'Father', daddy:'Father',
      mummy:'Mother', mother:'Mother', maa:'Mother', mom:'Mother',
      dost:'Friend', friend:'Friend', boss:'Boss', client:'Client',
      company:'Company', office:'Company', bhai:'Brother', brother:'Brother',
      behen:'Sister', sister:'Sister', uncle:'Uncle', aunty:'Aunty', chacha:'Uncle', mausi:'Aunty'
    };
    for(const k in relationMap){ if(new RegExp('\\b'+k+'\\b').test(t)) return relationMap[k]; }
    let m = origText.match(/\bfrom\s+(?:my\s+|mera\s+|meri\s+|mere\s+)?([A-Za-z\u0900-\u097F]+)/i);
    if(m) return cap(m[1]);
    m = origText.match(/\b([A-Za-z\u0900-\u097F]+)\s+ne\b/i);
    if(m && !['maine','usne','unhone','humne'].includes(m[1].toLowerCase())) return cap(m[1]);
    return null;
  }
  function categoryFromPerson(person){
    const map = { Father:'Gift', Mother:'Gift', Friend:'Gift', Brother:'Gift', Sister:'Gift', Uncle:'Gift', Aunty:'Gift',
      Boss:'Salary', Company:'Salary', Client:'Freelance' };
    return map[person] || null;
  }
  function matchInList(text, list){
    const t = text.toLowerCase();
    return list.find(c=>t.includes(c.toLowerCase())) || null;
  }
  function matchAccount(text){
    const accts = activeAccounts();
    if(!accts.length) return null;
    const t = text.toLowerCase();
    let found = accts.find(a=>a.name && t.includes(a.name.toLowerCase()));
    if(found) return found;
    if(/\bcash\b|\bnagad\b/.test(t)) found = accts.find(a=>/cash/i.test(a.type||''));
    if(!found && /\bupi\b|\bgpay\b|\bphonepe\b|\bpaytm\b/.test(t)) found = accts.find(a=>/upi/i.test(a.type||''));
    if(!found && /\bcard\b|\bcredit\b/.test(t)) found = accts.find(a=>/credit/i.test(a.type||''));
    if(!found && /\bsaving/.test(t)) found = accts.find(a=>/saving/i.test(a.type||''));
    if(!found && /\bbank\b|\bonline\b|\bnet banking\b|\btransfer\b/.test(t)) found = accts.find(a=>/bank/i.test(a.type||'')&&!/credit/i.test(a.type||''));
    return found || null;
  }
  // ---- Sprint 25: grouped multi-item expense parsing ----------------
  // Recognizes "<item> <amount>" phrases such as "Milk 60", "₹120 for
  // Peanut", "Bread 40 rs" so a single expense session can collect
  // several line items before saving. Deliberately requires at least
  // one letter in the item-name portion — a bare number like "150"
  // (the normal single-amount answer) never matches this, so every
  // existing non-item expense/income/transfer/etc. flow is unaffected.
  function parseItemAmountSegment(seg){
    seg = (seg||'').trim();
    if(!seg) return null;
    let m = seg.match(/^([a-zA-Z\u0900-\u097F][a-zA-Z\u0900-\u097F\s]*?)\s*(?:for|ka|ki|ke|[-:])?\s*₹?\s*(\d+(?:\.\d+)?)\s*(?:rs\.?|rupees?|rupaye)?$/i);
    if(m && m[1] && m[1].trim()) return { name: cap(m[1].trim()), amount: parseFloat(m[2]) };
    m = seg.match(/^₹?\s*(\d+(?:\.\d+)?)\s*(?:rs\.?|rupees?)?\s+(?:for|ka|ki|ke)\s+([a-zA-Z\u0900-\u097F].*)$/i);
    if(m && m[2] && m[2].trim()) return { name: cap(m[2].trim()), amount: parseFloat(m[1]) };
    return null;
  }
  function extractItemAmountPairs(text){
    const segs = (text||'').split(/,|\band\b|\baur\b|\bevam\b|\n/i);
    const out = [];
    segs.forEach(seg=>{
      const r = parseItemAmountSegment(seg);
      if(r && r.amount>0) out.push(r);
    });
    return out;
  }
  function itemsTotal(items){
    return (window.App && App.Transaction && App.Transaction.MultiItem)
      ? App.Transaction.MultiItem.sum(items)
      : (items||[]).reduce((a,b)=>a+(Number(b.amount)||0),0);
  }
  // Budget / Goal / Reminder detection is checked before transfer/loan/etc.
  // because phrases like "set a budget" or "remind me" would otherwise be
  // ambiguous with nothing above (they don't overlap with the existing
  // income/expense/transfer/savings/loan/investment keyword sets), so this
  // is purely additive and never changes how a message already classified
  // as one of the six original kinds is handled.
  function classifyKind(tl){
    if(/\bbudget\b|\bbajat\b/.test(tl)) return 'budget';

    if(/\bremind(er)?\b|\byaad dila\b|\byaad rakh\b|\balert\b/.test(tl)) return 'reminder';
    if(/\b(add|create|set|naya|nayi)\b.*\bgoal\b|\bgoal\b.*\b(add|create|set|banao|banana)\b|\bsave (up )?for\b|\bnaya goal\b/.test(tl)) return 'goal';
    if(/\btransfer\b|\bbhej(a|o|na|un|kar|kiya)?\b|\bmove money\b|\bswitch (kar|karo)\b/.test(tl)) return 'transfer';
    if(/\bloan\b|\budhaar\b|\budhar\b|\bkarz\b|\bkarza\b|\bborrow(ed)?\b|\blent\b/.test(tl)) return 'loan';
    if(/\binvest(ed|ment)?\b|\bnivesh\b|\bmutual fund\b|\bstocks?\b|\bshares?\b|\bfixed deposit\b|\bfd\b|\bsip\b/.test(tl)) return 'investment';
    if(/\bsaving(s)?\b|\bbachat\b|\bjama kar(o)?\b|\bdeposit kar(o)?\b/.test(tl)) return 'savings';
    const strongIncome = /\breceived\b|\breceive\b|\bincome\b|\bsalary\b|\bgot paid\b|\bearned\b|\bmila\b|\bmile\b|\baayi\b|\baaya\b|\bkamaya\b|\bkamaye\b|\bgot money\b|\bpaisa mila\b|\bpaise mile\b|\bmujhe mile\b|\bmujhe mila\b/.test(tl);
    const strongExpense = /\bspent\b|\bspend\b|\bexpense\b|\bpaid\b|\bkharch\b|\bkharcha\b|\bdiya\b|\bdiye\b/.test(tl);
    if(strongIncome && !strongExpense) return 'income';
    if(strongExpense && !strongIncome) return 'expense';
    if(/\bmoney\b|\bpaisa\b|\bpaise\b|\brupees?\b|₹/.test(tl)) return 'unclear-money';
    return null;
  }
  function matchKindWord(t){
    const tl = t.toLowerCase();
    if(/\bincome\b/.test(tl)) return 'income';
    if(/\bexpense\b/.test(tl)) return 'expense';
    if(/\btransfer\b/.test(tl)) return 'transfer';
    if(/\bsaving/.test(tl)) return 'savings';
    if(/\bloan\b/.test(tl)) return 'loan';
    if(/\binvest/.test(tl)) return 'investment';
    if(/\bbudget\b/.test(tl)) return 'budget';
    if(/\bgoal\b/.test(tl)) return 'goal';
    if(/\bremind(er)?\b/.test(tl)) return 'reminder';
    return classifyKind(tl);
  }

  // ---- Sprint 42: situation-aware pre-check (Part 1 of 3) -----------
  // Runs BEFORE classifyKind() in startFlowFromMessage(). It recognizes
  // a handful of specific, everyday money situations by phrasing —
  // bonus, salary hike, a received gift, a refund, lending/borrowing
  // money, and paying someone back — that classifyKind() either can't
  // see at all (no matching keyword) or reads WRONG (see the repayment
  // case below). Anything not matched here returns null and the caller
  // falls straight through to classifyKind()/matchKindWord(), so every
  // message this function doesn't specifically recognize behaves
  // exactly as it did before Sprint 42.
  function detectSituation(t){
    const tl = t.toLowerCase();

    // 1) Loan repayment / settling up. Checked FIRST and deliberately
    //    ahead of everything else: "paid Ramesh back" or "repaid the
    //    loan" contains the word "paid", which classifyKind()'s
    //    strongExpense pattern alone would otherwise read as a plain
    //    expense — a real misclassification this fixes. This is about
    //    settling an EXISTING loan, so it's tagged separately from a
    //    brand-new 'lent'/'borrowed' loan below.
    const repayRe = /\b(paid|pay|gave|de di[ya]?)\b[^.]{0,25}\bback\b|\brepaid\b|\brepay(ing)?\b|\bchuka(ya|diya|di)?\b|\blauta(ya|diya|di)?\b|\bwapas\s*(kar|kiya|karo|kar\s*diya|kardiya|di[ye]?)\b/;
    if(repayRe.test(tl)){
      const toMe = /\b(paid me back|paid us back|mujhe wapas|repaid me|gave me back|humein wapas|hume wapas)\b/.test(tl);
      return { kind:'loan', situation:'repayment', settleDirection: toMe ? 'owed_to_me' : 'i_owe' };
    }

    // 2) Bonus
    if(/\bbonus\b/.test(tl)) return { kind:'income', situation:'bonus', category:'Bonus' };

    // 3) Salary hike / raise / increment
    if(/\b(hike|raise|increment)\b/.test(tl) || /\bsalary\b[^.]{0,15}\b(badh|badhi|increase[d]?)\b/.test(tl))
      return { kind:'income', situation:'salary_hike', category:'Salary' };

    // 4) Refund / cashback
    if(/\brefund(ed)?\b|\bcash\s*back\b|\bpaisa\s+wapas\s+(aaya|mila)\b|\bpaise\s+wapas\s+(aaye|mile)\b|\bwapas\s+mila\b|\bwapas\s+aaya\b/.test(tl))
      return { kind:'income', situation:'refund', category:'Refund' };

    // 5) Gift RECEIVED — only when phrased as receiving, so "bought a
    //    gift for my mom" (a real expense) is never swept into income.
    if(/\bgift\b/.test(tl) &&
       !/\b(bought|buy|kharida|kharidi|purchase[d]?)\b/.test(tl) &&
       /\b(got|received|mila|mile|gifted)\b/.test(tl))
      return { kind:'income', situation:'gift' };

    // 6) Lent money to someone — classifyKind() already routes this to
    //    'loan' and extractInitialFields() already infers the correct
    //    direction; tagged here only so the confirmation can speak
    //    naturally instead of generically.
    if(/\b(lent|lending)\b/.test(tl) && !/\b(took|borrowed|liya)\b/.test(tl))
      return { kind:'loan', situation:'lent', direction:'owed_to_me' };

    // 7) Borrowed money — same idea, opposite direction.
    if(/\bborrow(ed|ing)?\b/.test(tl) && !/\b(lent|gave)\b/.test(tl))
      return { kind:'loan', situation:'borrowed', direction:'i_owe' };

    return null;
  }

  /* ---------------- field extraction from a free-form message ---------------- */
  function extractInitialFields(t, kind){
    const tl = t.toLowerCase();
    const amount = extractAmount(tl);
    if(amount){ session.fields.amount = amount; note(`Read the amount ₹${fmt(amount)} directly from your message.`); }
    session.fields.date = detectDate(tl);
    const mode = detectMode(tl);
    if(mode && mode!=='Other'){ session.fields.mode = mode; note(`Detected "${mode}" as the payment mode from your message.`); }

    if(kind==='income'){
      const person = extractPerson(t);
      if(person){ session.fields.person = person; note(`Detected "${person}" as the sender from your message.`); }
      const cat = findCategoryInText(tl,'income') || (person ? categoryFromPerson(person) : null);
      if(cat){ session.fields.category = cat; note(person && !findCategoryInText(tl,'income') ? `Guessed "${cat}" as the category because money from ${person} is usually ${cat}.` : `Matched "${cat}" as the category from your message.`); }
      else{
        const guess = memoryPreferredCategory('income');
        if(guess){ session.fields.category = guess; session.fields.categoryFromMemory = true; note(`Defaulted to "${guess}" — it's the income category you use most often. Say a different one to change it.`); }
      }
      const acct = matchAccount(t);
      if(acct){ session.fields.accountId = acct.id; note(`Matched "${acct.name}" as the account from your message.`); }
      else{
        const acctId = memoryPreferredAccountId();
        if(acctId){ session.fields.accountId = acctId; session.fields.accountFromMemory = true; note(`Defaulted to "${accountName(acctId)}" — the account you use most often. Say a different one to change it.`); }
      }
      const item = detectItem(t); if(item) session.fields.item = item;
    } else if(kind==='expense'){
      const cat = findCategoryInText(tl,'expense');
      if(cat){ session.fields.category = cat; note(`Matched "${cat}" as the category from your message.`); }
      else{
        const guess = memoryPreferredCategory('expense');
        if(guess){ session.fields.category = guess; session.fields.categoryFromMemory = true; note(`Defaulted to "${guess}" — it's the expense category you use most often. Say a different one to change it.`); }
      }
      const acct = matchAccount(t);
      if(acct){ session.fields.accountId = acct.id; note(`Matched "${acct.name}" as the account from your message.`); }
      else{
        const acctId = memoryPreferredAccountId();
        if(acctId){ session.fields.accountId = acctId; session.fields.accountFromMemory = true; note(`Defaulted to "${accountName(acctId)}" — the account you use most often. Say a different one to change it.`); }
      }
      const item = detectItem(t); if(item) session.fields.item = item;
      // Sprint 25 — grouped multi-item expense. If the very first message
      // already contains one or more "<item> <amount>" phrases (e.g.
      // "Food expense, milk 60, peanut 120"), start collecting them as
      // items right away instead of treating it as a single amount.
      const openingPairs = extractItemAmountPairs(t);
      if(openingPairs.length){
        session.fields.items = openingPairs.map(p=>({ id:uid(), name:p.name, amount:p.amount, notes:'', qty:null, unit:null, tags:[] }));
        session.fields.amount = itemsTotal(session.fields.items);
        delete session.fields.item;
        note(`Added item${openingPairs.length>1?'s':''} from your message: ${openingPairs.map(p=>`${p.name} ₹${fmt(p.amount)}`).join(', ')}.`);
      }
    } else if(kind==='transfer'){
      const mFrom = t.match(/\bfrom\s+([a-z0-9 ]+?)(?:\s+to\b|[.?]|$)/i);
      const mTo = t.match(/\bto\s+([a-z0-9 ]+?)(?:[.?]|$)/i);
      if(mFrom){ const a = matchAccount(mFrom[1]); if(a) session.fields.fromAccountId = a.id; }
      if(mTo){ const a = matchAccount(mTo[1]); if(a) session.fields.toAccountId = a.id; }
    } else if(kind==='savings'){
      const goal = findGoalInText(tl);
      if(goal) session.fields.goalId = goal.id;
      const acct = matchAccount(t); if(acct) session.fields.toAccountId = acct.id;
    } else if(kind==='loan'){
      if(/\b(gave|lent|diya|udhaar diya|maine diya)\b/.test(tl) && !/\b(took|borrowed|liya|mujhe diya)\b/.test(tl)) session.fields.direction = 'owed_to_me';
      else if(/\b(took|borrowed|liya|mujhe diya)\b/.test(tl) && !/\b(gave|lent|diya|maine diya)\b/.test(tl)) session.fields.direction = 'i_owe';
      const person = extractPerson(t);
      if(person) session.fields.person = person;
    } else if(kind==='investment'){
      if(/mutual fund/.test(tl)) session.fields.invType = 'Mutual Funds';
      else if(/\bstocks?\b|\bshares?\b/.test(tl)) session.fields.invType = 'Stocks';
      else if(/\bfd\b|fixed deposit/.test(tl)) session.fields.invType = 'Fixed Deposit (FD)';
      else if(/gold/.test(tl)) session.fields.invType = 'Gold';
      else if(/real estate|property/.test(tl)) session.fields.invType = 'Real Estate';
    } else if(kind==='budget'){
      const cat = matchInList(t, expenseCats());
      if(cat) session.fields.category = cat;
    } else if(kind==='goal'){
      const m = t.match(/\bfor\s+(?:a |an |my )?([a-z0-9 ]+?)(?:\s+(?:of|worth|costing)\b|[.?]|$)/i);
      if(m && m[1].trim() && !/^\d+$/.test(m[1].trim())) session.fields.name = cap(m[1].trim());
    } else if(kind==='reminder'){
      const m = t.match(/\b(?:to|for|about)\s+(.+?)(?:\s+on\b|\s+by\b|[.?]|$)/i);
      if(m && m[1].trim()) session.fields.title = cap(m[1].trim());
      session.fields.dueDate = detectDate(tl);
    }
  }

  function applyFreeformEdit(t){
    const tl = t.toLowerCase();
    const amt = extractAmount(tl); if(amt) session.fields.amount = amt;
    const acct = matchAccount(t);
    if(acct){ if(session.kind==='transfer') session.fields.fromAccountId = acct.id; else if(session.kind!=='savings') session.fields.accountId = acct.id; else session.fields.toAccountId = acct.id; }
    if(session.kind==='income' || session.kind==='expense' || session.kind==='budget'){
      const cat = matchInList(t, session.kind==='income' ? incomeSources() : expenseCats());
      if(cat) session.fields.category = cat;
    }
    if(session.kind==='goal' && t.trim() && !/^\d+$/.test(t.trim())) session.fields.name = cap(t.trim());
    if(session.kind==='reminder' && t.trim()) session.fields.title = cap(t.trim());
    if(/yesterday|\bkal\b|today|\baaj\b|parso|\d{4}-\d{2}-\d{2}/.test(tl)) session.fields.date = detectDate(tl);
    if(session.kind==='reminder' && /yesterday|\bkal\b|today|\baaj\b|parso|\d{4}-\d{2}-\d{2}|tomorrow|kal(?!\s*maine)/.test(tl)) session.fields.dueDate = detectDate(tl);
  }

  /* ---------------- what's still missing, per transaction kind ---------------- */
  function nextMissingStep(s){
    const f = s.fields;
    switch(s.kind){
      case 'income':
        if(!f.person && !f.category) return 'person';
        if(!f.amount) return 'amount';
        if(!f.category) return 'category';
        if(!f.accountId) return 'account';
        return null;
      case 'expense':
        if(!f.amount) return 'amount';
        if(!f.category) return 'category';
        // Sprint 25 — give the user a chance to add more items before
        // moving on to account/confirmation, but only once they've
        // actually started a grouped-item expense (f.items non-empty).
        // Sessions with a plain single amount (no items) are completely
        // unaffected and skip straight to 'account' as before.
        if(f.items && f.items.length && !f.itemsFinalized) return 'moreItems';
        if(!f.accountId) return 'account';
        return null;
      case 'transfer':
        if(!f.amount) return 'amount';
        if(!f.fromAccountId) return 'fromAccount';
        if(!f.toAccountId) return 'toAccount';
        return null;
      case 'savings':
        if(!f.amount) return 'amount';
        if(!f.goalId && !f.toAccountId) return 'target';
        return null;
      case 'loan':
        // Sprint 42 — settling an existing loan (f.isRepayment) needs
        // only who + how much; "did you give or take this?" is moot for
        // a repayment, so it's skipped entirely. Brand-new loans (the
        // vast majority of cases, and every pre-Sprint-42 session) fall
        // through to the original three-step check below, untouched.
        if(f.isRepayment){
          if(!f.person) return 'person';
          if(!f.amount) return 'amount';
          return null;
        }
        if(!f.direction) return 'direction';
        if(!f.person) return 'person';
        if(!f.amount) return 'amount';
        return null;
      case 'investment':
        if(!f.invType && !f.invName) return 'invType';
        if(!f.amount) return 'amount';
        return null;
      case 'budget':
        if(!f.category) return 'budgetCategory';
        if(!f.amount) return 'amount';
        return null;
      case 'goal':
        if(!f.name) return 'goalName';
        if(!f.amount) return 'amount';
        return null;
      case 'reminder':
        if(!f.title) return 'reminderTitle';
        if(!f.dueDate) return 'reminderDate';
        return null;
    }
    return null;
  }

  function questionFor(s, step){
    switch(step){
      case 'person':
        // Sprint 42 — a loan repayment asks "who was this with", not
        // "who gave you the money" (which only makes sense for income).
        // Every non-repayment session (income included) is unaffected.
        if(s.kind==='loan' && s.fields.isRepayment){
          return { text: s.fields.settleDirection==='owed_to_me' ? "Nice! Who paid you back?" : "Got it — who did you pay back?" };
        }
        return { text:"Nice! Who gave you the money?" };
      case 'amount':
        if(s.kind==='transfer') return { text:"How much would you like to transfer?" };
        if(s.kind==='budget') return { text:`What monthly limit should I set for ${s.fields.category}?` };
        if(s.kind==='goal') return { text:`How much does "${s.fields.name}" cost, in total?` };
        return { text:"How much was it?" };
      case 'budgetCategory': return { text:"Which category is this budget for?", quick: expenseCats() };
      case 'goalName': return { text:"What are you saving up for?" };
      case 'reminderTitle': return { text:"What should I remind you about?" };
      case 'reminderDate': return { text:"When should I remind you? (e.g. tomorrow, 15 Sept, or a date)" };
      case 'category':
        if(s.kind==='income'){
          const guess = s.fields.person && !s.fields.categoryGuessRejected ? categoryFromPerson(s.fields.person) : null;
          if(guess){ s.fields.categoryGuess = guess; return { text:`Should I save this as ${guess} Income?`, quick:['Yes','No'] }; }
          return { text:"What kind of income is this? (e.g. Salary, Freelance, Business, Gift, Interest)", quick: incomeSources() };
        }
        return { text:"What was this expense for? (e.g. Food, Travel, Shopping, Bills, Entertainment, Personal)", quick: expenseCats() };
      case 'account': return { text:"Cash or Bank? Which account should I use?", quick: activeAccounts().map(a=>a.name) };
      case 'fromAccount': return { text:"Which account is this coming from?", quick: activeAccounts().map(a=>a.name) };
      case 'toAccount': return { text:"Which account is it going to?", quick: activeAccounts().map(a=>a.name) };
      case 'target': {
        const goals = (state.goals||[]).filter(g=>!g.achieved);
        if(goals.length) return { text:"Which goal is this for? (or say 'savings account')", quick: goals.map(g=>g.name).concat(['Savings account']) };
        return { text:"Which account should I move this into?", quick: activeAccounts().map(a=>a.name) };
      }
      case 'direction': return { text:"Did you give this loan, or did you take it?", quick:['I gave it','I took it'] };
      case 'invType': return { text:"What did you invest in? (e.g. Mutual Funds, Stocks, FD, Gold, Real Estate)", quick:['Mutual Funds','Stocks','Fixed Deposit (FD)','Gold','Real Estate'] };
    }
    return { text:"Could you tell me a bit more?" };
  }

  function askNextQuestion(){
    const step = nextMissingStep(session);
    if(!step){ askConfirmation(); return; }
    // Sprint 25 — 'moreItems' is a special step: it doesn't ask a normal
    // slot-filling question, it reports the running total and waits for
    // either another "<item> <amount>" or a "save"/"done" to move on.
    if(step==='moreItems'){
      session.step = step;
      const items = session.fields.items;
      const list = items.map(it=>`${it.name} ₹${fmt(it.amount)}`).join(', ');
      aiSayTyping(`Got it — ${list}. Running total ₹${fmt(session.fields.amount)}. Say another item, or say "save" to finish.`, ['Save','Cancel']);
      return;
    }
    session.step = step;
    const q = questionFor(session, step);
    aiSayTyping(q.text, q.quick);
  }

  // Sprint 25 — handles a reply while session.step==='moreItems'. Either
  // another item+amount is added to the running list, or a save/done
  // word finalizes items and lets the existing flow continue on to
  // account/confirmation exactly as a single-amount expense already does.
  function handleMoreItemsAnswer(t){
    const tl = t.toLowerCase();
    if(/\b(save|done|bas|khatam|finish|that'?s all|thats all)\b/i.test(tl) || isYes(t)){
      session.fields.itemsFinalized = true;
      askNextQuestion();
      return;
    }
    const pairs = extractItemAmountPairs(t);
    if(pairs.length){
      session.fields.items = session.fields.items || [];
      pairs.forEach(p=> session.fields.items.push({ id:uid(), name:p.name, amount:p.amount, notes:'', qty:null, unit:null, tags:[] }));
      session.fields.amount = itemsTotal(session.fields.items);
      note(`Added item${pairs.length>1?'s':''}: ${pairs.map(p=>`${p.name} ₹${fmt(p.amount)}`).join(', ')}.`);
      askNextQuestion();
      return;
    }
    aiSayTyping('Say the next item and amount (e.g. "Bread 40"), or say "save" to finish.', ['Save','Cancel']);
  }

  function accountName(id){ const a = accountById(id); return a ? a.name : '—'; }

  // Sprint 42 — natural-language confirmation for a recognized
  // situation (f.__situation), instead of the generic phrasing below.
  // Returns null for any session that wasn't tagged with a situation,
  // in which case buildSummaryText() falls through to its original
  // switch/case exactly as before.
  function situationSummaryText(s, dateStr){
    const f = s.fields;
    const acctPart = f.accountId ? ` (${accountName(f.accountId)})` : '';
    switch(f.__situation){
      case 'bonus':
        return `Samajh gaya — ₹${fmt(f.amount)} ka bonus, income mein add kar doon${acctPart}, dated ${dateStr}?`;
      case 'gift':
        return `Samajh gaya — ₹${fmt(f.amount)} ka gift${f.person?` ${f.person} se`:''}, income mein add kar doon${acctPart}, dated ${dateStr}?`;
      case 'salary_hike':
        return `Samajh gaya — ₹${fmt(f.amount)} ki salary hike, income mein add kar doon${acctPart}, dated ${dateStr}?`;
      case 'refund':
        return `Samajh gaya — ₹${fmt(f.amount)} ka refund${f.person?` ${f.person} se`:''}, income mein add kar doon${acctPart}, dated ${dateStr}?`;
      case 'lent':
        return `Samajh gaya — aapne ${f.person||'unhe'} ko ₹${fmt(f.amount)} udhaar diya, loan mein log kar doon?`;
      case 'borrowed':
        return `Samajh gaya — aapne ${f.person||'unse'} se ₹${fmt(f.amount)} udhaar liya, loan mein log kar doon?`;
      case 'repayment':
        return f.settleDirection==='owed_to_me'
          ? `Samajh gaya — ${f.person||'unhone'} ne aapko ₹${fmt(f.amount)} wapas kiya, loan settle kar doon?`
          : `Samajh gaya — aapne ${f.person||'unhe'} ko ₹${fmt(f.amount)} wapas kiya, loan settle kar doon?`;
    }
    return null;
  }

  function buildSummaryText(s){
    const f = s.fields;
    const dateStr = f.date || todayStr();
    if(f.__situation){
      const situ = situationSummaryText(s, dateStr);
      if(situ) return situ;
    }
    switch(s.kind){
      case 'income':
        return `Should I save this as ₹${fmt(f.amount)} ${f.category||'Other'} Income${f.person?` from ${f.person}`:''} into ${accountName(f.accountId)}, dated ${dateStr}?`;
      case 'expense':
        if(f.items && f.items.length){
          const list = f.items.map(it=>`${it.name} ₹${fmt(it.amount)}`).join(', ');
          return `Should I save ₹${fmt(f.amount)} as ${f.category||'Other'} expense from ${accountName(f.accountId)} with ${f.items.length} items (${list}), dated ${dateStr}?`;
        }
        return `Should I save ₹${fmt(f.amount)} as ${f.category||'Other'} expense from ${accountName(f.accountId)}${f.item?` (${f.item})`:''}, dated ${dateStr}?`;
      case 'transfer':
        return `Should I transfer ₹${fmt(f.amount)} from ${accountName(f.fromAccountId)} to ${accountName(f.toAccountId)}, dated ${dateStr}?`;
      case 'savings': {
        if(f.goalId){ const g=(state.goals||[]).find(x=>x.id===f.goalId); return `Should I add ₹${fmt(f.amount)} to your "${g?g.name:'goal'}" goal, dated ${dateStr}?`; }
        return `Should I move ₹${fmt(f.amount)} into ${accountName(f.toAccountId)}, dated ${dateStr}?`;
      }
      case 'loan':
        return f.direction==='owed_to_me'
          ? `Should I log that ${f.person} owes you ₹${fmt(f.amount)}, dated ${dateStr}?`
          : `Should I log that you owe ${f.person} ₹${fmt(f.amount)}, dated ${dateStr}?`;
      case 'investment':
        return `Should I log ₹${fmt(f.amount)} invested in ${f.invType||f.invName}, dated ${dateStr}?`;
      case 'budget':
        return `Should I set your ${f.category} budget to ₹${fmt(f.amount)} per month?`;
      case 'goal':
        return `Should I add a new goal "${f.name}" with a target of ₹${fmt(f.amount)}?`;
      case 'reminder':
        return `Should I remind you about "${f.title}" on ${f.dueDate}?`;
    }
    return "Should I save this?";
  }

  // Looks for an existing transaction that already matches this draft
  // almost exactly (same type, date, amount, category, account) — the
  // classic "did I already log this?" slip from double-tapping send or
  // re-describing something already saved earlier in the day.
  function findDuplicateWarning(s){
    const f = s.fields;
    if(s.kind!=='income' && s.kind!=='expense') return null;
    if(!f.amount) return null;
    const dateStr = f.date || todayStr();
    const dup = (state.transactions||[]).find(t=>
      t.type===s.kind && t.date===dateStr && Number(t.amount)===Number(f.amount) &&
      (t.category||'Other')===(f.category||'Other') &&
      (!f.accountId || t.account===f.accountId)
    );
    if(!dup) return null;
    return `I already have a ₹${fmt(f.amount)} ${f.category||'Other'} ${s.kind} logged on ${dateStr} — this looks like it might be a duplicate.`;
  }
  // Compares this draft's amount to your own recent history for the
  // same category, so an unusually large (or oddly small) entry gets a
  // gentle nudge instead of being silently accepted — useful when a
  // typo turns 150 into 1500.
  function findUnusualAmountWarning(s){
    const f = s.fields;
    if((s.kind!=='income' && s.kind!=='expense') || !f.amount) return null;
    const relevant = (state.transactions||[]).filter(t=>t.type===s.kind && (t.category||'Other')===(f.category||'Other') && Number(t.amount)>0).slice(-30);
    if(relevant.length<3) return null; // not enough history to call anything "unusual" yet
    const amounts = relevant.map(t=>Number(t.amount));
    const avg = amounts.reduce((a,b)=>a+b,0)/amounts.length;
    if(avg>0 && f.amount > avg*3){
      return `that's a fair bit more than your usual ~₹${fmt(Math.round(avg))} for ${f.category||'this'} — just checking the amount is right.`;
    }
    return null;
  }
  function isWhy(t){ return /\b(why|kyu|kyun|explain|reason|kaise)\b/i.test(t); }
  // Turns the reasoning trace built up during extraction (see note())
  // into a short, readable explanation — what was read straight from
  // the message vs. defaulted from learned habits vs. guessed — plus
  // any active warnings, so "Why?" always answers with specifics
  // instead of a generic "because I said so".
  function explainSession(s){
    const reasons = (s.fields.__reasoning||[]).filter(Boolean);
    let out = reasons.length ? reasons.map(r=>'• '+r).join('\n') : "I used exactly what you told me — nothing here was guessed.";
    if(s.warnings && s.warnings.length) out += '\n\n' + s.warnings.map(w=>'⚠️ '+w).join('\n');
    return out;
  }

  function askConfirmation(){
    session.awaitingConfirm = true;
    const warnings = [];
    const dupW = findDuplicateWarning(session); if(dupW) warnings.push(dupW);
    const unusualW = findUnusualAmountWarning(session); if(unusualW) warnings.push(unusualW);
    session.warnings = warnings;
    const prefix = warnings.length ? warnings.map(w=>'⚠️ '+w).join('\n') + '\n\n' : '';
    aiSayTyping(prefix + buildSummaryText(session), ['Yes','No','Why?']);
  }

  /* ---------------- saving a completed draft into real app data ---------------- */
  function refreshChartsAndViews(){
    try{ refreshAllCharts(); }catch(e){ /* best-effort */ }
    try{ if(document.getElementById('view-transactions')?.classList.contains('active')) renderTransactions(); }catch(e){}
    try{ if(document.getElementById('view-dashboard')?.classList.contains('active')) renderDashboard(); }catch(e){}
    try{ flash(); }catch(e){}
  }
  async function saveDraft(s){
    try{
      const f = s.fields;
      if(s.kind==='income' || s.kind==='expense'){
        const acct = accountById(f.accountId);
        const baseTxn = { id:uid(), type:s.kind, date:f.date||todayStr(), time:'', category:f.category||'Other', subcategory:'',
          account:f.accountId, mode: f.mode || (acct && /cash/i.test(acct.type||'') ? 'Cash' : 'Bank Transfer'),
          notes: (f.person?`From ${f.person} — `:'')+'Added via chat assistant', tags:[] };
        // Sprint 25 — grouped multi-item expense: build the parent
        // transaction through the same shared helper the manual entry
        // form and Items Editor use, so amount/item summary stay
        // consistent everywhere. Sessions without f.items (every
        // pre-Sprint-25 flow, and every income save) are unaffected.
        const txn = (f.items && f.items.length && window.App && App.Transaction && App.Transaction.MultiItem)
          ? App.Transaction.MultiItem.buildParentTxn(Object.assign({ item:'' }, baseTxn), f.items)
          : Object.assign({}, baseTxn, { item: f.item || (f.person?`From ${f.person}`:'') || '', amount: f.amount });
        state.transactions.push(txn);
        await saveTransactions();
        refreshChartsAndViews();
        // Sprint 43 — same Advisor refresh the manual entry form already
        // triggers after every save, so the Advisor tab stays in sync with
        // chat-added transactions too. Then, for expenses only, append at
        // most one proactive insight sentence (see proactiveExpenseInsight
        // above) — never invented, only present when there's something
        // real to say, and gated so it doesn't repeat every message.
        let insightText = null;
        try{
          if(window.App && App.Advisor){
            App.Advisor.Manager.run();
            if(s.kind==='expense') insightText = proactiveExpenseInsight(txn);
          }
        }catch(err){ App.Logger.error('[Chat] Sprint 43 post-save insight failed', err); }
        return `Done ✅ — saved ₹${fmt(txn.amount)} ${s.kind} under ${txn.category}${acct?` (${acct.name})`:''}${txn.items&&txn.items.length?` across ${txn.items.length} items`:''}.`
          + (insightText ? `\n\n${insightText}` : '');
      }
      if(s.kind==='transfer'){
        state.transactions.push({ id:uid(), type:'transfer', date:f.date||todayStr(), fromAccount:f.fromAccountId, toAccount:f.toAccountId, amount:f.amount, notes:'Added via chat assistant' });
        await saveTransactions();
        refreshChartsAndViews();
        return `Done ✅ — transferred ₹${fmt(f.amount)} from ${accountName(f.fromAccountId)} to ${accountName(f.toAccountId)}.`;
      }
      if(s.kind==='savings'){
        if(f.goalId){
          const g = (state.goals||[]).find(x=>x.id===f.goalId);
          if(g){
            g.contributions = g.contributions||[];
            g.contributions.push({ id:uid(), date:f.date||todayStr(), amount:f.amount });
            await saveGoals();
            try{ if(document.getElementById('view-goals')?.classList.contains('active')) renderGoals(); }catch(e){}
            // Sprint 43 — proactive goal-pace insight (see proactiveGoalInsight
            // above); reuses the same computeGoalPlan()/computeGoalStatus()
            // the Goals tab already calls, appended only when there's a real
            // 'On Track'/'Behind' status worth mentioning.
            let insightText = null;
            try{ insightText = proactiveGoalInsight(f.goalId); }catch(err){ App.Logger.error('[Chat] Sprint 43 post-save insight failed', err); }
            return `Done ✅ — added ₹${fmt(f.amount)} to "${g.name}".` + (insightText ? `\n\n${insightText}` : '');
          }
        }
        state.transactions.push({ id:uid(), type:'transfer', date:f.date||todayStr(), fromAccount:f.fromAccountId||null, toAccount:f.toAccountId||null, amount:f.amount, notes:'Savings — added via chat assistant' });
        await saveTransactions();
        refreshChartsAndViews();
        return `Done ✅ — moved ₹${fmt(f.amount)} into ${accountName(f.toAccountId)}.`;
      }
      if(s.kind==='loan'){
        // Sprint 42 — settling an EXISTING loan (f.isRepayment), not
        // creating a new one. Reuses the exact same payment-record
        // shape the manual "Log Payment" form (dpayBtn) already writes,
        // so Debts-screen totals/history stay consistent no matter
        // which path added the payment. Brand-new loans (no repayment
        // phrasing detected — every pre-Sprint-42 session) fall through
        // to the original push below, completely untouched.
        if(f.isRepayment){
          const wantType = f.settleDirection; // 'i_owe' or 'owed_to_me'
          const match = (state.debts||[]).find(d=>
            d.type===wantType && !d.settled && d.person && f.person &&
            d.person.toLowerCase()===f.person.toLowerCase());
          const verbPhrase = wantType==='owed_to_me' ? `that ${f.person} paid you back` : `paid back to ${f.person}`;
          if(match){
            match.payments = match.payments||[];
            match.payments.push({ date:f.date||todayStr(), amount:f.amount, account:f.accountId||null });
            if(debtRemaining(match)<=0) match.settled = true;
            await saveDebts();
            try{ if(document.getElementById('view-debts')?.classList.contains('active')) renderDebts(); }catch(e){}
            return `Done ✅ — logged ₹${fmt(f.amount)} ${verbPhrase}.${match.settled?' That loan is now fully settled 🎉':''}`;
          }
          // No matching open debt found — save it as a standalone
          // settled entry so it's still visible on the Debts screen,
          // rather than dropping it or forcing it into Income/Expense.
          state.debts.push({ id:uid(), type:wantType, person:f.person, amount:f.amount, interest:0, date:f.date||todayStr(), due:null, settled:true, payments:[{ date:f.date||todayStr(), amount:f.amount, account:f.accountId||null }] });
          await saveDebts();
          try{ if(document.getElementById('view-debts')?.classList.contains('active')) renderDebts(); }catch(e){}
          return `Done ✅ — logged ₹${fmt(f.amount)} ${verbPhrase} (no earlier open loan record was found, so I've saved it as a settled entry).`;
        }
        state.debts.push({ id:uid(), type:f.direction, person:f.person, amount:f.amount, interest:0, date:f.date||todayStr(), due:null, settled:false, payments:[] });
        await saveDebts();
        try{ if(document.getElementById('view-debts')?.classList.contains('active')) renderDebts(); }catch(e){}
        return `Done ✅ — logged ₹${fmt(f.amount)} that ${f.direction==='owed_to_me'?`${f.person} owes you`:`you owe ${f.person}`}.`;
      }
      if(s.kind==='investment'){
        state.investments.push({ id:uid(), name:f.invName||f.invType, type:f.invType||'Other', invested:f.amount, currentValue:f.amount, purchaseDate:f.date||todayStr(), notes:'Added via chat assistant' });
        await saveInvestments();
        try{ recordNetWorthSnapshot(); if(document.getElementById('view-investments')?.classList.contains('active')) renderInvestments(); }catch(e){}
        return `Done ✅ — logged ₹${fmt(f.amount)} invested in ${f.invType||f.invName}.`;
      }
      if(s.kind==='budget'){
        state.budgets[f.category] = f.amount;
        await saveBudgets();
        try{ populateBudgetCategorySelect(); if(document.getElementById('view-budgets')?.classList.contains('active')) renderBudgets(); }catch(e){}
        return `Done ✅ — set your ${f.category} budget to ₹${fmt(f.amount)}/month.`;
      }
      if(s.kind==='goal'){
        state.goals.push({
          id:uid(), name:f.name, cost:f.amount, category:'Big Purchase', priority:(Math.max(0,...state.goals.map(g=>g.priority||0))+1),
          targetDate:null, monthlyOverride:null, weeklyOverride:null, dailyOverride:null, notes:'Added via chat assistant',
          paused:false, contributions:[], achieved:false, isEmergencyFund:false, createdDate: f.date||todayStr()
        });
        await saveGoals();
        try{ if(document.getElementById('view-goals')?.classList.contains('active')) renderGoals(); }catch(e){}
        return `Done ✅ — added a new goal "${f.name}" (target ₹${fmt(f.amount)}).`;
      }
      if(s.kind==='reminder'){
        state.reminders.push({ id:uid(), title:f.title, dueDate:f.dueDate, notes:'Added via chat assistant', done:false, createdDate: todayStr() });
        await saveReminders();
        return `Done ✅ — I'll remind you about "${f.title}" on ${f.dueDate}.`;
      }
    }catch(err){
      App.Logger.error('[Chat] saveDraft failed', err);
      return "Hmm, something went wrong while saving. Please try again, or add it manually from the relevant tab.";
    }
    return "Saved.";
  }

  /* ---------------- answering the current question ---------------- */
  function applyAnswerToStep(step, t){
    const tl = t.toLowerCase();
    switch(step){
      case 'editAny':
        applyFreeformEdit(t);
        askNextQuestion();
        return;
      case 'person':
        session.fields.person = extractPerson(t) || cap(t.replace(/^(my|mera|meri|mere)\s+/i,'').trim());
        break;
      case 'amount': {
        // Sprint 25 — an expense answer like "Milk 60" starts a grouped
        // multi-item list instead of being treated as a bare amount. A
        // plain number ("150") never matches the item regex, so a normal
        // single-amount answer falls straight through to the unchanged
        // extractAmount() path below exactly as before.
        if(session.kind==='expense'){
          const pairs = extractItemAmountPairs(t);
          if(pairs.length){
            session.fields.items = session.fields.items || [];
            pairs.forEach(p=> session.fields.items.push({ id:uid(), name:p.name, amount:p.amount, notes:'', qty:null, unit:null, tags:[] }));
            session.fields.amount = itemsTotal(session.fields.items);
            note(`Added item${pairs.length>1?'s':''}: ${pairs.map(p=>`${p.name} ₹${fmt(p.amount)}`).join(', ')}.`);
            break;
          }
        }
        const amt = extractAmount(tl);
        if(!amt || amt<=0){ aiSayTyping("That doesn't look like a valid amount — please tell me a number, e.g. 150."); return; }
        session.fields.amount = amt;
        break;
      }
      case 'category': {
        if(session.fields.categoryGuess){
          if(isYes(t)){ session.fields.category = session.fields.categoryGuess; delete session.fields.categoryGuess; }
          else if(isNo(t)){ session.fields.categoryGuessRejected = true; delete session.fields.categoryGuess; askNextQuestion(); return; }
          else { session.fields.categoryGuessRejected = true; delete session.fields.categoryGuess; session.fields.category = matchInList(t, incomeSources()) || cap(t.trim()); }
        } else {
          const list = session.kind==='income' ? incomeSources() : expenseCats();
          session.fields.category = matchInList(t, list) || cap(t.trim());
        }
        break;
      }
      case 'account': {
        const a = matchAccount(t);
        if(a){ session.fields.accountId = a.id; }
        else if(activeAccounts().length===1){ session.fields.accountId = activeAccounts()[0].id; }
        else { aiSayTyping(`I didn't catch which account — options: ${activeAccounts().map(x=>x.name).join(', ')}.`); return; }
        break;
      }
      case 'fromAccount': {
        const a = matchAccount(t);
        if(!a){ aiSayTyping(`Which account is this from? Options: ${activeAccounts().map(x=>x.name).join(', ')}.`); return; }
        session.fields.fromAccountId = a.id;
        break;
      }
      case 'toAccount': {
        const a = matchAccount(t);
        if(!a){ aiSayTyping(`Which account is this going to? Options: ${activeAccounts().map(x=>x.name).join(', ')}.`); return; }
        session.fields.toAccountId = a.id;
        break;
      }
      case 'target': {
        const goal = findGoalInText(tl) || (state.goals||[]).find(g=>g.name && tl.includes(g.name.toLowerCase()));
        if(goal){ session.fields.goalId = goal.id; break; }
        const a = matchAccount(t) || activeAccounts().find(x=>/saving/i.test(x.type||''));
        if(a){ session.fields.toAccountId = a.id; break; }
        aiSayTyping("Sorry, I couldn't find that goal or account — could you name it again, or say 'savings account'?");
        return;
      }
      case 'direction': {
        if(/\b(gave|lent|diya|udhaar diya|maine diya|i gave)\b/i.test(t)) session.fields.direction = 'owed_to_me';
        else if(/\b(took|borrowed|liya|udhaar liya|mujhe diya|i took)\b/i.test(t)) session.fields.direction = 'i_owe';
        else { aiSayTyping("Just to confirm — did you give the loan, or take it?"); return; }
        break;
      }
      case 'invType': {
        if(/mutual fund/i.test(t)) session.fields.invType='Mutual Funds';
        else if(/stock|share/i.test(t)) session.fields.invType='Stocks';
        else if(/\bfd\b|fixed deposit/i.test(t)) session.fields.invType='Fixed Deposit (FD)';
        else if(/gold/i.test(t)) session.fields.invType='Gold';
        else if(/real estate|property/i.test(t)) session.fields.invType='Real Estate';
        else { session.fields.invName = cap(t.trim()); session.fields.invType='Other'; }
        break;
      }
      case 'budgetCategory': {
        const cat = matchInList(t, expenseCats());
        if(!cat){ aiSayTyping(`I didn't catch that category — options: ${expenseCats().join(', ')}.`, expenseCats()); return; }
        session.fields.category = cat;
        break;
      }
      case 'goalName': {
        const name = t.trim();
        if(!name){ aiSayTyping("What should I call this goal?"); return; }
        session.fields.name = cap(name.replace(/^(a|an|for)\s+/i,'').trim());
        break;
      }
      case 'reminderTitle': {
        const title = t.trim();
        if(!title){ aiSayTyping("What should I remind you about?"); return; }
        session.fields.title = cap(title);
        break;
      }
      case 'reminderDate': {
        // detectDate() (existing helper, shared with every other date field
        // in the app) always resolves to a concrete date, defaulting to
        // today when it can't recognize a specific one — same convention
        // used for income/expense/transfer dates elsewhere in this file.
        session.fields.dueDate = detectDate(tl);
        break;
      }
    }
    askNextQuestion();
  }

  function handleConfirmAnswer(t){
    if(isWhy(t)){
      // Re-explains without touching awaitingConfirm — the user is still
      // sitting at the same confirmation afterward, same Yes/No/Why options.
      aiSayTyping(explainSession(session), ['Yes','No','Why?']);
      return;
    }
    if(isYes(t)){
      const s = session;
      aiSayTyping('Saving…');
      saveDraft(s).then(msg=>{
        addMessage('ai', msg);
        persist(); renderMessages();
        refreshMemoryCache(); // this save just changed your habits/frequencies — pick that up for the next suggestion
        // Sprint 19 — mirrors the mission's "would you like to attach a
        // photo of the receipt?" voice flow. Only offered after a
        // voice-originated income/expense save, so typed-chat behavior
        // (and every other transaction kind) is completely unchanged.
        if((s.kind==='income'||s.kind==='expense') && s.viaVoice){
          pendingAttachPrompt = true;
          aiSayTyping('Would you like to attach a photo of the receipt?', ['Yes, attach photo',"No, that's all"]);
        }
      });
      session = null;
      return;
    }
    if(isNo(t)){
      session.awaitingConfirm = false;
      session.step = 'editAny';
      aiSayTyping("No problem — what should I change? Tell me the correct amount, category, account, etc., or say 'cancel' to discard.");
      return;
    }
    aiSayTyping("Please reply 'yes' to save, 'no' to make a change, or 'why' to see my reasoning.", ['Yes','No','Why?']);
  }

  /* ---------------- top-level message handling / orchestration ---------------- */
  // Async helper for App.OnlineAI answers — mirrors aiSayTyping()'s
  // typing-indicator behaviour but waits on a Promise instead of a
  // fixed timeout, since an online lookup's duration isn't known in
  // advance. Additive only — aiSayTyping() itself is untouched.
  function aiRespondAsync(promise){
    typingVisible = true; renderMessages();
    promise.then(text=>{
      typingVisible = false;
      addMessage('ai', text);
      persist(); renderMessages();
    }).catch(err=>{
      typingVisible = false;
      App.Logger.error('[Chat] OnlineAI.ask failed', err);
      addMessage('ai', "Sorry, something went wrong while checking that. Please try again.");
      persist(); renderMessages();
    });
  }

  function startFlowFromMessage(t){
    const tl = t.toLowerCase();
    // Sprint 42 — situation-aware pre-check runs first (see
    // detectSituation() above). It only fires for a handful of specific
    // phrasings; every other message gets `situation === null` and
    // `kind` falls straight through to the original classifyKind()
    // call, completely unchanged from pre-Sprint-42 behavior.
    const situation = detectSituation(t);
    let kind = situation ? situation.kind : classifyKind(tl);
    if(kind==='unclear-money') kind = 'income'; // e.g. "Today I got money" leans income
    // Online AI Knowledge Engine hook (App.OnlineAI) — additive only.
    // Only takes over when this message does NOT look like a transaction
    // to log AND DOES look like a knowledge question (finance, tax,
    // stock, mutual fund, gold/silver, crypto, government scheme, or
    // general knowledge). Never touches the income/expense/transfer/
    // savings/loan/investment slot-filling flow below in any way.
    if(!kind && window.App && App.OnlineAI && App.OnlineAI.DecisionEngine.classify(t)){
      session = null;
      aiRespondAsync(App.OnlineAI.Manager.ask(t).then(res=>
        (res && res.handled) ? res.reply : "Sure! Is this an income, expense, transfer, savings, loan, investment, budget, goal, or reminder?"
      ));
      return;
    }
    session = { kind: kind||null, fields:{}, step: kind?null:'awaitKind', awaitingConfirm:false, createdAt:Date.now(), lastActivityAt:Date.now(), rawInitial:t, viaVoice: lastInputViaVoice };
    if(!kind){
      aiSayTyping("Sure! Is this an income, expense, transfer, savings, loan, investment, budget, goal, or reminder?");
      return;
    }
    extractInitialFields(t, kind);
    // Sprint 42 — apply the recognized situation AFTER the normal
    // extraction above, so it can safely override a generic
    // memory-guessed category (e.g. force "Bonus" instead of whatever
    // category the user last used) without extractInitialFields()
    // itself needing any changes. A person mentioned in the message is
    // still picked up by extractInitialFields()/extractPerson() as
    // usual for every situation, loan included.
    if(situation){
      session.fields.__situation = situation.situation;
      if(situation.category) session.fields.category = situation.category;
      if(situation.direction && !session.fields.direction) session.fields.direction = situation.direction;
      if(situation.settleDirection){
        session.fields.isRepayment = true;
        session.fields.settleDirection = situation.settleDirection;
        delete session.fields.direction; // irrelevant for a repayment — settleDirection drives it instead
      }
      note(`Recognized this as a "${situation.situation.replace('_',' ')}" from your message.`);
    }
    askNextQuestion();
  }

  function continueFlow(t){
    session.lastActivityAt = Date.now();
    if(session.step==='awaitKind'){
      const kind = matchKindWord(t);
      if(!kind || kind==='unclear-money'){ aiSayTyping("Sorry, I didn't catch that — please say income, expense, transfer, savings, loan, investment, budget, goal, or reminder."); return; }
      session.kind = kind; session.step = null;
      extractInitialFields(session.rawInitial+' '+t, kind);
      askNextQuestion();
      return;
    }
    if(session.awaitingConfirm){ handleConfirmAnswer(t); return; }
    if(session.step==='moreItems'){ handleMoreItemsAnswer(t); return; }
    applyAnswerToStep(session.step, t);
  }

  /* ---------------- Sprint 18: chat-based undo, with an explicit warning ----------------
     Kept fully separate from the slot-filling `session` state machine above
     (its own pendingUndo variable, checked first) so it can never collide
     with or change the behavior of an in-progress income/expense/etc. flow. */
  let pendingUndo = null; // id of the transaction awaiting a delete confirmation, or null
  function isUndoLastRequest(tl){
    return /\b(undo|delete|remove|hata do|hatao|mita do|mitao)\b/.test(tl) && /\b(last|previous|pichla|pichli|abhi|recent)\b/.test(tl);
  }
  function describeTxnForUndo(tx){
    if(tx.type==='transfer') return `₹${fmt(tx.amount)} transfer (${accountName(tx.fromAccount)} → ${accountName(tx.toAccount)}) on ${tx.date}`;
    return `₹${fmt(tx.amount)} ${tx.category||'Other'} ${tx.type} on ${tx.date}${tx.item?` (${tx.item})`:''}`;
  }
  function requestUndoLast(){
    const txns = state.transactions||[];
    if(!txns.length){ aiSayTyping("There's nothing to undo — no transactions logged yet."); return; }
    const last = txns[txns.length-1];
    pendingUndo = last.id;
    aiSayTyping(`⚠️ This will permanently delete: ${describeTxnForUndo(last)}. This can't be undone from here — are you sure?`, ['Yes, delete it','No, keep it']);
  }
  async function confirmUndoLast(t){
    if(isNo(t) || /\bkeep\b/i.test(t)){ pendingUndo = null; aiSayTyping("Okay — I've left it as is."); return; }
    if(isYes(t) || /\bdelete\b/i.test(t)){
      const id = pendingUndo; pendingUndo = null;
      const idx = (state.transactions||[]).findIndex(x=>x.id===id);
      if(idx===-1){ aiSayTyping("Hmm, I couldn't find that entry anymore — it may already have been removed."); return; }
      const [removed] = state.transactions.splice(idx,1);
      await saveTransactions();
      refreshChartsAndViews();
      aiSayTyping(`Done ✅ — deleted ${describeTxnForUndo(removed)}.`);
      return;
    }
    aiSayTyping("Please reply 'yes' to delete it, or 'no' to keep it.", ['Yes, delete it','No, keep it']);
  }

  /* ---------------- Sprint 19: voice "attach a receipt photo?" follow-up ----------------
     Fully separate from `session` and `pendingUndo`, same pattern as the
     Sprint 18 undo flow above — a small, independent pending-flag so it
     can never collide with or change the behavior of an in-progress
     slot-filling conversation. */
  function handleAttachPromptAnswer(t){
    pendingAttachPrompt = false;
    if(isYes(t) || /attach|photo|receipt|scan/i.test(t)){
      aiSayTyping('Sure — opening the receipt scanner for you.');
      try{
        switchToView('entry');
        setTimeout(()=>{ document.getElementById('ocrScanZone')?.scrollIntoView({behavior:'smooth', block:'center'}); }, 350);
      }catch(e){ /* best-effort — the message above still stands even if the view switch fails */ }
      return;
    }
    aiSayTyping("No problem — all done. What else can I help with?");
  }

  function processMessage(t){
    const tl = t.toLowerCase();
    if(pendingUndo){ confirmUndoLast(t); return; }
    if(pendingAttachPrompt){ handleAttachPromptAnswer(t); return; }
    if(!session && isUndoLastRequest(tl)){ requestUndoLast(); return; }
    if(session && (Date.now() - (session.lastActivityAt||0) > SESSION_TIMEOUT_MS)){
      session = null;
      aiSayTyping("That took a while, so I've restarted our conversation. Go ahead — what would you like to log?");
      return;
    }
    if(session && isCancel(tl)){
      session = null;
      aiSayTyping("No problem — cancelled. Nothing was saved. What else can I help with?");
      return;
    }
    if(session && isRestart(tl)){
      const kind = session.kind;
      session = null;
      aiSayTyping("Sure, let's start over. Go ahead and tell me again.");
      if(kind){ /* leave it to the user's next message so we don't guess */ }
      return;
    }
    if(!session){ startFlowFromMessage(t); return; }
    continueFlow(t);
  }

  function handleUserMessage(text){
    const t = (text||'').trim();
    if(!t) return;
    addMessage('user', t);
    persist(); renderMessages();
    try{ processMessage(t); }
    catch(err){
      App.Logger.error('[Chat] processMessage failed', err);
      session = null;
      aiSayTyping("Sorry, something went wrong on my end 🙏 — let's start fresh. What would you like to log?");
    }
  }

  /* ---------------- rendering ---------------- */
  function addMessage(role, text, quick){
    log.push({ role, text, quick: quick||null, ts:new Date().toISOString() });
    if(log.length>MAX_LOG) log = log.slice(-MAX_LOG);
    // Sprint 19 — notify voice bridge (or any future listener) of every
    // AI reply, in exactly the words the user sees in the chat panel.
    if(role==='ai' && aiMessageListeners.length){
      aiMessageListeners.forEach(fn=>{ try{ fn(text, quick||null); }catch(e){ App.Logger.error('[Chat] onAIMessage listener failed', e); } });
    }
  }

  function aiSayTyping(text, quick){
    typingVisible = true; renderMessages();
    clearTimeout(typingTimer);
    const delay = 450 + Math.min(700, text.length*6);
    typingTimer = setTimeout(()=>{
      typingVisible = false;
      addMessage('ai', text, quick);
      persist(); renderMessages();
    }, delay);
  }

  function renderMessages(){
    const el = document.getElementById('chatMessages');
    if(!el) return;
    el.innerHTML = log.map(m=>`<div class="chat-msg ${m.role==='user'?'user':'ai'}">${escapeHtml(m.text)}</div>`).join('')
      + (typingVisible ? '<div class="chat-typing"><span></span><span></span><span></span></div>' : '');
    el.scrollTop = el.scrollHeight;
    renderQuickReplies();
  }
  function renderQuickReplies(){
    const wrap = document.getElementById('chatQuickReplies');
    if(!wrap) return;
    const last = log[log.length-1];
    if(!typingVisible && last && last.role==='ai' && last.quick && last.quick.length){
      wrap.innerHTML = last.quick.slice(0,6).map(q=>`<button class="chat-quick-chip" data-qr="${escapeHtml(q)}">${escapeHtml(q)}</button>`).join('');
      wrap.querySelectorAll('[data-qr]').forEach(b=>b.addEventListener('click', ()=>sendChatMessage(b.dataset.qr)));
    } else {
      wrap.innerHTML = '';
    }
  }

  function sendChatMessage(text, opts){
    const input = document.getElementById('chatInput');
    const val = (text!==undefined ? text : (input?input.value:'')).trim();
    if(!val) return;
    if(input) input.value = '';
    lastInputViaVoice = !!(opts && opts.viaVoice); // Sprint 19 — read by startFlowFromMessage() below
    handleUserMessage(val);
  }

  function openChatPanel(){
    document.getElementById('chatOverlay').classList.remove('hidden');
    refreshMemoryCache();
    if(!log.length){
      addMessage('ai', "Hi! I'm your Khaata assistant 👋 Tell me what happened — e.g. \"I spent 200 on food\", \"Aaj maine 500 kamaye\", \"set a budget for food\", \"add a goal for a new phone\", or \"remind me to pay rent\" — and I'll help you log it. You can reply in Hindi, English, or a mix of both, anytime. I'll also learn your usual categories and accounts over time — ask \"why?\" before confirming anything to see my reasoning, or say \"undo last transaction\" if something needs to be removed.");
      persist();
    } else if(session && !session.resumeAnnounced && (Date.now() - (session.lastActivityAt||0) <= SESSION_TIMEOUT_MS)){
      // Resuming an interrupted conversation (panel was closed or the page
      // was reloaded mid-flow): remind the user where things were left off
      // instead of silently sitting on a half-filled draft.
      session.resumeAnnounced = true;
      addMessage('ai', "Welcome back — we were still in the middle of something. Picking up where we left off:");
      persist();
      if(session.awaitingConfirm){ askConfirmation(); }
      else if(session.step==='awaitKind'){ aiSayTyping("Sure! Is this an income, expense, transfer, savings, loan, investment, budget, goal, or reminder?"); }
      else if(session.step){ askNextQuestion(); }
    }
    renderMessages();
    setTimeout(()=>document.getElementById('chatInput')?.focus(), 200);
  }
  function closeChatPanel(){ document.getElementById('chatOverlay').classList.add('hidden'); }

  function bindUI(){
    document.getElementById('chatFabBtn')?.addEventListener('click', openChatPanel);
    document.getElementById('chatClose')?.addEventListener('click', closeChatPanel);
    document.getElementById('chatOverlay')?.addEventListener('click', e=>{ if(e.target.id==='chatOverlay') closeChatPanel(); });
    document.getElementById('chatSendBtn')?.addEventListener('click', ()=>sendChatMessage());
    document.getElementById('chatInput')?.addEventListener('keydown', e=>{ if(e.key==='Enter'){ e.preventDefault(); sendChatMessage(); } });
    document.getElementById('chatRestartBtn')?.addEventListener('click', ()=>sendChatMessage('restart'));
    document.getElementById('chatCancelBtn')?.addEventListener('click', ()=>sendChatMessage('cancel'));
  }

  function initialize(){ restore(); bindUI(); refreshMemoryCache(); }

  // Read-only accessor for the Smart Dashboard's Recent Activity widget —
  // additive only, does not change how `log` is built or persisted above.
  function getRecentLog(n){ return log.slice(-(n||5)); }

  // ---- Sprint 19: generic seams for App.Voice.Bridge (or any future
  // listener) — App.Chat itself still has zero knowledge of voice. ----
  function isOpen(){ return !document.getElementById('chatOverlay')?.classList.contains('hidden'); }
  function onAIMessage(fn){ if(typeof fn==='function') aiMessageListeners.push(fn); }

  // ---- Sprint 39 (App.VoiceQA, Part 3 of 4): additive export only ----
  // Shows a message using the identical log-push/trim/persist/render
  // steps the private addMessage('ai', text) above already uses, but
  // deliberately does NOT notify aiMessageListeners. App.VoiceQA (and
  // any future caller that already has its own real answer to speak)
  // calls App.Voice.Synthesis.speak() itself, the same way
  // App.VoiceFollowUp's own speak() helper does — routing the same
  // text through the general auto-speak-every-AI-reply listener here
  // too would speak it twice. No existing function, ID, or behavior
  // above is changed by this addition.
  function showAssistantMessage(text){
    log.push({ role:'ai', text, quick:null, ts:new Date().toISOString() });
    if(log.length>MAX_LOG) log = log.slice(-MAX_LOG);
    persist(); renderMessages();
  }

  return { initialize, open: openChatPanel, close: closeChatPanel, sendMessage: sendChatMessage, getRecentLog, isOpen, onAIMessage, showAssistantMessage };
})();

/* ================================================================
   OFFLINE AI MEMORY ENGINE   (App.Memory)   —   v1.0.0
   ------------------------------------------------------------------
   100% offline. No network calls, no cloud sync, no external AI.
   Everything below is additive: it reuses the existing `state`,
   `saveTransactions()`, `uid()`, `todayStr()`, `App.Logger` etc.
   exactly as they already work, and wires itself in through a small
   number of *extra* event listeners and one backward-compatible
   wrapper around saveTransactions(). Nothing already on the page is
   removed, renamed, or redesigned.

   Storage backend : IndexedDB ("khaataMemory" DB) when available,
                      with an automatic localStorage fallback
                      (prefix "khaata:mem:") for browsers/contexts
                      where IndexedDB is blocked (private tabs,
                      some webviews, etc.) — the rest of the engine
                      does not care which backend is actually in use.
   Encryption       : AES-GCM 256 via the browser's built-in Web
                       Crypto API, using a key generated once on
                       this device and kept in localStorage. This
                       protects memory contents against casual
                       inspection of the raw storage (e.g. someone
                       browsing IndexedDB/localStorage in devtools on
                       a shared machine) — it is NOT a substitute for
                       device-level security, since the key lives on
                       the same device as the data. If Web Crypto is
                       unavailable, the engine falls back to storing
                       plain JSON and logs a one-time warning.

   Module map (all namespaced under App.Memory):
     App.Memory.Storage    low-level encrypted key/value persistence
                            (IndexedDB, falls back to localStorage)
     App.Memory.Cache      in-memory LRU cache in front of Storage
     App.Memory.Index      lightweight inverted-word-index for search
     App.Memory.Search     ranked search across everything remembered
     App.Memory.ShortTerm  TTL'd memory — unfinished transactions,
                            unfinished/resumable state, recent
                            searches — auto-expires on its own
     App.Memory.LongTerm   durable memory — preferences, frequency
                            counters for categories / accounts /
                            payment modes / income sources, recent
                            merchants, contacts, notes, tags
     App.Memory.Context    turns LongTerm + ShortTerm into ready-to-
                            use "smart suggestion" values
     App.Memory.Session    lightweight session bookkeeping + restore
     App.Memory.Logger     scoped logging (delegates to App.Logger)
     App.Memory.Manager    the façade other code should call:
                            init(), restore(), recordTransaction(),
                            suggest(), search(), deleteMemory(),
                            history(), expireNow(), cleanup(),
                            backupPrepare()
================================================================ */
App.Memory = (function(){

  /* ---------------------------------------------------------------
     0. SHARED CONSTANTS
  --------------------------------------------------------------- */
  const DB_NAME    = 'khaataMemory';
  const DB_VERSION = 1;
  const STORE      = 'kv';
  const LS_PREFIX  = 'khaata:mem:';
  const KEY_LS_KEY = 'khaata:mem:cryptokey';
  const MAX_CACHE_ENTRIES   = 300;
  const MAX_RECENT_LIST     = 25;
  const MAX_HISTORY_ENTRIES = 200;
  const DRAFT_TTL_MS        = 3 * 24 * 60 * 60 * 1000;   // unfinished transaction draft: 3 days
  const SHORT_TERM_DEFAULT_TTL_MS = 24 * 60 * 60 * 1000; // generic short-term default: 1 day
  const CLEANUP_INTERVAL_MS = 5 * 60 * 1000;             // periodic expiry sweep: 5 minutes

  /* ---------------------------------------------------------------
     1. LOGGER — thin wrapper so every line this engine logs is
        clearly tagged, while still going through the app's existing
        console logger (and therefore the existing global error
        listeners) instead of a separate parallel system.
  --------------------------------------------------------------- */
  const Logger = {
    info:  (...a)=>{ try{ App.Logger.info('[Memory]', ...a); }catch(e){} },
    warn:  (...a)=>{ try{ App.Logger.warn('[Memory]', ...a); }catch(e){} },
    error: (...a)=>{ try{ App.Logger.error('[Memory]', ...a); }catch(e){} }
  };

  /* ---------------------------------------------------------------
     2. ENCRYPTION — best-effort AES-GCM using a per-device key.
        Every function here is safe to call even if Web Crypto is
        missing; encrypt()/decrypt() just become pass-throughs and a
        single warning is logged the first time that happens.
  --------------------------------------------------------------- */
  const Crypto = (function(){
    let keyPromise = null;
    let warned = false;
    const subtle = (window.crypto && window.crypto.subtle) ? window.crypto.subtle : null;

    function bufToB64(buf){
      const bytes = new Uint8Array(buf);
      let bin = '';
      for(let i=0;i<bytes.length;i++) bin += String.fromCharCode(bytes[i]);
      return btoa(bin);
    }
    function b64ToBuf(b64){
      const bin = atob(b64);
      const bytes = new Uint8Array(bin.length);
      for(let i=0;i<bin.length;i++) bytes[i] = bin.charCodeAt(i);
      return bytes.buffer;
    }

    async function getKey(){
      if(!subtle) return null;
      if(keyPromise) return keyPromise;
      keyPromise = (async ()=>{
        let raw = null;
        try{ raw = localStorage.getItem(KEY_LS_KEY); }catch(e){}
        if(raw){
          try{
            return await subtle.importKey('raw', b64ToBuf(raw), {name:'AES-GCM'}, true, ['encrypt','decrypt']);
          }catch(e){ Logger.warn('Stored memory key unreadable, generating a new one', e); }
        }
        const key = await subtle.generateKey({name:'AES-GCM', length:256}, true, ['encrypt','decrypt']);
        try{
          const exported = await subtle.exportKey('raw', key);
          localStorage.setItem(KEY_LS_KEY, bufToB64(exported));
        }catch(e){ Logger.warn('Could not persist memory encryption key', e); }
        return key;
      })();
      return keyPromise;
    }

    async function encrypt(obj){
      const json = JSON.stringify(obj);
      const key = await getKey();
      if(!key){
        if(!warned){ Logger.warn('Web Crypto unavailable — memory will be stored unencrypted on this device.'); warned = true; }
        return { plain: json };
      }
      const iv = window.crypto.getRandomValues(new Uint8Array(12));
      const data = new TextEncoder().encode(json);
      const cipher = await subtle.encrypt({name:'AES-GCM', iv}, key, data);
      return { iv: bufToB64(iv), data: bufToB64(cipher) };
    }

    async function decrypt(record){
      if(!record) return null;
      if(record.plain !== undefined){
        try{ return JSON.parse(record.plain); }catch(e){ return null; }
      }
      const key = await getKey();
      if(!key) return null;
      try{
        const plainBuf = await subtle.decrypt({name:'AES-GCM', iv:new Uint8Array(b64ToBuf(record.iv))}, key, b64ToBuf(record.data));
        return JSON.parse(new TextDecoder().decode(plainBuf));
      }catch(e){ Logger.error('Failed to decrypt a memory record', e); return null; }
    }

    return { encrypt, decrypt };
  })();

  /* ---------------------------------------------------------------
     3. STORAGE — IndexedDB primary, localStorage fallback. Every
        value is passed through Crypto.encrypt()/decrypt() so the
        two backends behave identically from the caller's point of
        view: get(id) -> plain JS value (or null), set(id, value).
  --------------------------------------------------------------- */
  const Storage = (function(){
    let dbPromise = null;
    let useIDB = (typeof window.indexedDB !== 'undefined') && window.indexedDB !== null;

    function openDB(){
      if(!useIDB) return Promise.resolve(null);
      if(dbPromise) return dbPromise;
      dbPromise = new Promise((resolve)=>{
        try{
          const req = indexedDB.open(DB_NAME, DB_VERSION);
          req.onupgradeneeded = ()=>{
            const db = req.result;
            if(!db.objectStoreNames.contains(STORE)) db.createObjectStore(STORE, {keyPath:'id'});
          };
          req.onsuccess = ()=> resolve(req.result);
          req.onerror = ()=>{ Logger.warn('IndexedDB unavailable, falling back to localStorage', req.error); useIDB = false; resolve(null); };
          req.onblocked = ()=>{ Logger.warn('IndexedDB open blocked, falling back to localStorage'); useIDB = false; resolve(null); };
        }catch(e){ Logger.warn('IndexedDB threw on open, falling back to localStorage', e); useIDB = false; resolve(null); }
      });
      return dbPromise;
    }

    async function idbGet(id){
      const db = await openDB();
      if(!db) return undefined;
      return new Promise((resolve)=>{
        try{
          const tx = db.transaction(STORE, 'readonly');
          const req = tx.objectStore(STORE).get(id);
          req.onsuccess = ()=> resolve(req.result ? req.result.value : undefined);
          req.onerror = ()=> resolve(undefined);
        }catch(e){ resolve(undefined); }
      });
    }
    async function idbSet(id, value){
      const db = await openDB();
      if(!db) return false;
      return new Promise((resolve)=>{
        try{
          const tx = db.transaction(STORE, 'readwrite');
          tx.objectStore(STORE).put({id, value});
          tx.oncomplete = ()=> resolve(true);
          tx.onerror = ()=> resolve(false);
        }catch(e){ resolve(false); }
      });
    }
    async function idbDelete(id){
      const db = await openDB();
      if(!db) return false;
      return new Promise((resolve)=>{
        try{
          const tx = db.transaction(STORE, 'readwrite');
          tx.objectStore(STORE).delete(id);
          tx.oncomplete = ()=> resolve(true);
          tx.onerror = ()=> resolve(false);
        }catch(e){ resolve(false); }
      });
    }
    async function idbKeys(prefix){
      const db = await openDB();
      if(!db) return null;
      return new Promise((resolve)=>{
        try{
          const tx = db.transaction(STORE, 'readonly');
          const req = tx.objectStore(STORE).getAllKeys();
          req.onsuccess = ()=> resolve((req.result||[]).filter(k=> !prefix || String(k).startsWith(prefix)));
          req.onerror = ()=> resolve([]);
        }catch(e){ resolve([]); }
      });
    }

    function lsGet(id){
      try{
        const raw = localStorage.getItem(LS_PREFIX + id);
        return raw ? JSON.parse(raw) : undefined;
      }catch(e){ return undefined; }
    }
    function lsSet(id, value){
      try{ localStorage.setItem(LS_PREFIX + id, JSON.stringify(value)); return true; }
      catch(e){ Logger.error('localStorage memory write failed (storage full?)', e); return false; }
    }
    function lsDelete(id){
      try{ localStorage.removeItem(LS_PREFIX + id); return true; }catch(e){ return false; }
    }
    function lsKeys(prefix){
      const out = [];
      try{
        for(let i=0;i<localStorage.length;i++){
          const k = localStorage.key(i);
          if(k && k.startsWith(LS_PREFIX)){
            const id = k.slice(LS_PREFIX.length);
            if(!prefix || id.startsWith(prefix)) out.push(id);
          }
        }
      }catch(e){}
      return out;
    }

    async function get(id){
      let record = useIDB ? await idbGet(id) : undefined;
      if(record === undefined) record = lsGet(id);
      if(record === undefined) return null;
      return Crypto.decrypt(record);
    }
    async function set(id, value){
      const record = await Crypto.encrypt(value);
      let ok = false;
      if(useIDB) ok = await idbSet(id, record);
      if(!ok) ok = lsSet(id, record);
      return ok;
    }
    async function del(id){
      if(useIDB) await idbDelete(id);
      lsDelete(id);
      return true;
    }
    async function keys(prefix){
      let list = useIDB ? await idbKeys(prefix) : null;
      if(!list) list = lsKeys(prefix);
      return list;
    }

    return { get, set, delete: del, keys, backend: ()=> useIDB ? 'indexeddb' : 'localstorage' };
  })();

  /* ---------------------------------------------------------------
     4. CACHE — simple in-memory LRU sitting in front of Storage, so
        repeated reads within a session (e.g. Context.buildSuggestions
        being called on every keystroke) don't keep hitting IndexedDB.
  --------------------------------------------------------------- */
  const Cache = (function(){
    const map = new Map(); // insertion order == recency for a Map

    function get(id){
      if(!map.has(id)) return undefined;
      const val = map.get(id);
      map.delete(id); map.set(id, val); // bump to most-recently-used
      return val;
    }
    function set(id, val){
      if(map.has(id)) map.delete(id);
      map.set(id, val);
      while(map.size > MAX_CACHE_ENTRIES){
        const oldestKey = map.keys().next().value;
        map.delete(oldestKey);
      }
    }
    function del(id){ map.delete(id); }
    function clear(){ map.clear(); }

    return { get, set, delete: del, clear, size: ()=>map.size };
  })();

  /* Cache-aware read/write helpers used by every higher module below,
     so "Storage" itself never needs to be touched directly again. */
  async function readRecord(id){
    const cached = Cache.get(id);
    if(cached !== undefined) return cached;
    const val = await Storage.get(id);
    Cache.set(id, val);
    return val;
  }
  async function writeRecord(id, val){
    Cache.set(id, val);
    return Storage.set(id, val);
  }

  /* ---------------------------------------------------------------
     5. INDEX — a small inverted word index so App.Memory.Search can
        rank results instead of just filtering. Persisted as its own
        record ('__index__') and rebuilt lazily; kept entirely in
        memory during a session and flushed on write.
  --------------------------------------------------------------- */
  const Index = (function(){
    let table = {};      // word -> { id: occurrences }
    let loaded = false;
    let dirty = false;

    function tokenize(text){
      return String(text||'')
        .toLowerCase()
        .split(/[^a-z0-9\u0900-\u097F]+/i) // also keep Devanagari runs intact for Hindi notes
        .filter(w=> w && w.length>1);
    }

    async function load(){
      if(loaded) return;
      const saved = await readRecord('__index__');
      table = saved && typeof saved==='object' ? saved : {};
      loaded = true;
    }
    async function flush(){
      if(!dirty) return;
      await writeRecord('__index__', table);
      dirty = false;
    }

    async function addDoc(id, text){
      await load();
      const words = new Set(tokenize(text));
      words.forEach(w=>{
        if(!table[w]) table[w] = {};
        table[w][id] = (table[w][id]||0) + 1;
      });
      dirty = true;
    }
    async function removeDoc(id){
      await load();
      Object.keys(table).forEach(w=>{
        if(table[w] && table[w][id] !== undefined){
          delete table[w][id];
          if(Object.keys(table[w]).length===0) delete table[w];
        }
      });
      dirty = true;
    }
    async function query(text){
      await load();
      const words = tokenize(text);
      if(!words.length) return [];
      const scores = {};
      words.forEach(w=>{
        Object.keys(table).forEach(indexed=>{
          if(indexed.includes(w)){
            const postings = table[indexed];
            Object.keys(postings).forEach(id=>{
              scores[id] = (scores[id]||0) + postings[id];
            });
          }
        });
      });
      return Object.keys(scores)
        .map(id=>({id, score:scores[id]}))
        .sort((a,b)=> b.score - a.score);
    }

    return { addDoc, removeDoc, query, flush };
  })();

  /* ---------------------------------------------------------------
     6. SEARCH — ranked search across everything the engine has
        indexed (currently: transaction summaries; open to future
        record types via the same addDoc/removeDoc calls).
  --------------------------------------------------------------- */
  const Search = {
    async search(queryText, opts){
      opts = opts||{};
      const limit = opts.limit || 20;
      const hits = await Index.query(queryText);
      const results = [];
      for(const hit of hits.slice(0, limit*2)){
        const rec = await readRecord(hit.id);
        if(!rec) continue;
        if(opts.type && rec.type !== opts.type) continue;
        results.push(Object.assign({}, rec, {_score: hit.score}));
        if(results.length >= limit) break;
      }
      return results;
    }
  };

  /* ---------------------------------------------------------------
     7. SHORT-TERM MEMORY — TTL'd key/value memory. Used for the
        in-progress transaction draft, generic resumable UI state,
        and the recent-searches list. Expired entries are dropped
        the moment they're read, plus swept periodically by Manager.
  --------------------------------------------------------------- */
  const ShortTerm = (function(){
    const RECORD_PREFIX = 'short:';

    async function set(key, value, ttlMs){
      const rec = { value, expiresAt: Date.now() + (ttlMs || SHORT_TERM_DEFAULT_TTL_MS) };
      await writeRecord(RECORD_PREFIX + key, rec);
    }
    async function get(key){
      const rec = await readRecord(RECORD_PREFIX + key);
      if(!rec) return null;
      if(rec.expiresAt && rec.expiresAt < Date.now()){
        await remove(key);
        return null;
      }
      return rec.value;
    }
    async function remove(key){
      Cache.delete(RECORD_PREFIX + key);
      await Storage.delete(RECORD_PREFIX + key);
    }
    async function cleanupExpired(){
      const ids = await Storage.keys(RECORD_PREFIX);
      let removed = 0;
      for(const id of ids){
        const rec = await readRecord(id);
        if(rec && rec.expiresAt && rec.expiresAt < Date.now()){
          Cache.delete(id);
          await Storage.delete(id);
          removed++;
        }
      }
      return removed;
    }

    return { set, get, remove, cleanupExpired };
  })();

  /* ---------------------------------------------------------------
     8. LONG-TERM MEMORY — durable preferences + frequency counters.
        Stored as one compact record so a read only ever costs one
        lookup; Manager saves it (debounced) whenever it changes.
  --------------------------------------------------------------- */
  const LongTerm = (function(){
    const RECORD_ID = 'longterm';
    let data = null;
    let saveTimer = null;

    function blank(){
      return {
        preferredLanguage: null,
        categoryFrequency: {},      // any category, expense or income
        expenseCategoryFrequency: {},
        incomeSourceFrequency: {},
        accountFrequency: {},
        paymentModeFrequency: {},
        paymentModeByCategory: {},  // { category: { mode: count } }
        recentMerchants: [],        // [{name, ts}]
        recentContacts: [],         // [{name, ts}]
        recentNotes: [],            // [{text, ts}]
        recentTags: [],             // [{tag, ts}]
        recentSearches: [],         // [{term, ts}]
        lastUsed: {                 // last value used for each field, for "smart" prefill
          category: null, subcategory: null, account: null, mode: null,
          incomeSource: null, expenseCategory: null
        },
        updatedAt: null
      };
    }

    async function load(){
      if(data) return data;
      const saved = await readRecord(RECORD_ID);
      data = saved && typeof saved==='object' ? Object.assign(blank(), saved) : blank();
      return data;
    }

    function scheduleSave(){
      clearTimeout(saveTimer);
      saveTimer = setTimeout(async ()=>{
        data.updatedAt = new Date().toISOString();
        await writeRecord(RECORD_ID, data);
      }, 300);
    }

    function bump(map, key, cap){
      if(!key) return;
      map[key] = (map[key]||0) + 1;
      const keys = Object.keys(map);
      if(cap && keys.length > cap){
        // drop the least-used entry once the counter map grows too large
        let minKey = keys[0];
        keys.forEach(k=>{ if(map[k] < map[minKey]) minKey = k; });
        delete map[minKey];
      }
    }
    function pushRecent(list, entry, keyField){
      const filtered = list.filter(e=> e[keyField] !== entry[keyField]);
      filtered.unshift(entry);
      return filtered.slice(0, MAX_RECENT_LIST);
    }

    return {
      async get(){ return load(); },

      async setPreferredLanguage(lang){
        const d = await load();
        d.preferredLanguage = lang;
        scheduleSave();
      },
      async getPreferredLanguage(){
        const d = await load();
        return d.preferredLanguage;
      },

      async recordCategoryUse(category, isIncome){
        if(!category) return;
        const d = await load();
        bump(d.categoryFrequency, category, 60);
        bump(isIncome ? d.incomeSourceFrequency : d.expenseCategoryFrequency, category, 60);
        d.lastUsed.category = category;
        if(isIncome) d.lastUsed.incomeSource = category; else d.lastUsed.expenseCategory = category;
        scheduleSave();
      },
      async recordAccountUse(account){
        if(!account) return;
        const d = await load();
        bump(d.accountFrequency, account, 40);
        d.lastUsed.account = account;
        scheduleSave();
      },
      async recordPaymentMode(mode, category){
        if(!mode) return;
        const d = await load();
        bump(d.paymentModeFrequency, mode, 20);
        if(category){
          if(!d.paymentModeByCategory[category]) d.paymentModeByCategory[category] = {};
          bump(d.paymentModeByCategory[category], mode, 10);
        }
        d.lastUsed.mode = mode;
        scheduleSave();
      },
      async recordMerchant(name){
        if(!name) return;
        const d = await load();
        d.recentMerchants = pushRecent(d.recentMerchants, {name, ts:Date.now()}, 'name');
        scheduleSave();
      },
      async recordContact(name){
        if(!name) return;
        const d = await load();
        d.recentContacts = pushRecent(d.recentContacts, {name, ts:Date.now()}, 'name');
        scheduleSave();
      },
      async recordNote(text){
        if(!text) return;
        const d = await load();
        d.recentNotes = pushRecent(d.recentNotes, {text, ts:Date.now()}, 'text');
        scheduleSave();
      },
      async recordTag(tag){
        if(!tag) return;
        const d = await load();
        d.recentTags = pushRecent(d.recentTags, {tag, ts:Date.now()}, 'tag');
        scheduleSave();
      },
      async recordSearch(term){
        if(!term || term.trim().length<2) return;
        const d = await load();
        d.recentSearches = pushRecent(d.recentSearches, {term:term.trim(), ts:Date.now()}, 'term');
        scheduleSave();
      },

      async topN(field, n){
        const d = await load();
        const map = d[field] || {};
        return Object.keys(map)
          .map(k=>({key:k, count:map[k]}))
          .sort((a,b)=> b.count - a.count)
          .slice(0, n||5);
      },
      async lastUsed(){
        const d = await load();
        return d.lastUsed;
      }
    };
  })();

  /* ---------------------------------------------------------------
     9. CONTEXT — turns LongTerm + ShortTerm into ready "suggestion"
        values other UI code (or a future sprint) can read directly.
  --------------------------------------------------------------- */
  const Context = {
    async buildSuggestions(){
      const [lastUsed, topExpense, topIncome, topAccount, topMode] = await Promise.all([
        LongTerm.lastUsed(),
        LongTerm.topN('expenseCategoryFrequency', 5),
        LongTerm.topN('incomeSourceFrequency', 5),
        LongTerm.topN('accountFrequency', 5),
        LongTerm.topN('paymentModeFrequency', 5)
      ]);
      const d = await LongTerm.get();
      return {
        lastCategory: lastUsed.category,
        lastAccount: lastUsed.account,
        lastPaymentMode: lastUsed.mode,
        lastIncomeSource: lastUsed.incomeSource,
        lastExpenseCategory: lastUsed.expenseCategory,
        topExpenseCategories: topExpense.map(x=>x.key),
        topIncomeSources: topIncome.map(x=>x.key),
        topAccounts: topAccount.map(x=>x.key),
        topPaymentModes: topMode.map(x=>x.key),
        recentTags: d.recentTags.slice(0,10).map(x=>x.tag),
        recentMerchants: d.recentMerchants.slice(0,10).map(x=>x.name),
        recentSearches: d.recentSearches.slice(0,10).map(x=>x.term),
        preferredLanguage: d.preferredLanguage
      };
    },
    async suggestedPaymentModeFor(category){
      const d = await LongTerm.get();
      const byCat = category && d.paymentModeByCategory[category];
      if(byCat){
        const best = Object.keys(byCat).sort((a,b)=> byCat[b]-byCat[a])[0];
        if(best) return best;
      }
      return d.lastUsed.mode;
    }
  };

  /* ---------------------------------------------------------------
     10. SESSION — lightweight bookkeeping around app open/close, plus
         read-only awareness of the existing chat engine's own
         persisted state (App.Chat already restores conversations
         itself; this just reports whether one is in progress so the
         rest of the memory engine, or a future sprint, can react).
  --------------------------------------------------------------- */
  const Session = (function(){
    const RECORD_ID = 'session-log';
    let current = null;

    async function start(){
      const d = (await readRecord(RECORD_ID)) || { count:0, history:[] };
      current = { id: uid(), startedAt: Date.now() };
      d.count = (d.count||0) + 1;
      d.lastStartedAt = current.startedAt;
      d.history = [{id:current.id, startedAt:current.startedAt}].concat(d.history||[]).slice(0, MAX_HISTORY_ENTRIES);
      await writeRecord(RECORD_ID, d);
      return current;
    }
    function hasUnfinishedChat(){
      try{
        const raw = localStorage.getItem('khaata:chatsession');
        if(!raw) return false;
        const sess = JSON.parse(raw);
        return !!(sess && sess.step !== undefined);
      }catch(e){ return false; }
    }
    async function stats(){
      const d = (await readRecord(RECORD_ID)) || { count:0, history:[] };
      return { totalSessions: d.count||0, lastStartedAt: d.lastStartedAt||null, current };
    }

    return { start, hasUnfinishedChat, stats };
  })();

  /* ---------------------------------------------------------------
     11. MANAGER — the façade the rest of the app (and App.init)
         actually talks to.
  --------------------------------------------------------------- */
  const Manager = (function(){
    const DRAFT_KEY = 'txn-draft';
    let historyLog = [];
    let cleanupTimer = null;
    let initialized = false;

    async function logHistory(action, detail){
      historyLog.unshift({ action, detail, ts: Date.now() });
      if(historyLog.length > MAX_HISTORY_ENTRIES) historyLog.length = MAX_HISTORY_ENTRIES;
      // persisted lazily, not on every single entry, to stay cheap
      writeRecord('history-log', historyLog).catch(()=>{});
    }

    async function init(){
      if(initialized) return;
      initialized = true;
      try{
        await LongTerm.get();       // warm the cache
        await Index.load ? null : null; // Index loads lazily on first use
        const savedHistory = await readRecord('history-log');
        if(Array.isArray(savedHistory)) historyLog = savedHistory;
        await Session.start();
        clearInterval(cleanupTimer);
        cleanupTimer = setInterval(()=>{ ShortTerm.cleanupExpired().catch(()=>{}); }, CLEANUP_INTERVAL_MS);
        Logger.info('initialized (backend:', Storage.backend()+')');
      }catch(err){
        Logger.error('init failed', err);
      }
    }

    /* ---- unfinished transaction (draft) ---- */
    async function saveDraftTransaction(draft){
      try{ await ShortTerm.set(DRAFT_KEY, draft, DRAFT_TTL_MS); }
      catch(err){ Logger.error('saveDraftTransaction failed', err); }
    }
    async function getDraftTransaction(){
      try{ return await ShortTerm.get(DRAFT_KEY); }
      catch(err){ Logger.error('getDraftTransaction failed', err); return null; }
    }
    async function clearDraftTransaction(){
      try{ await ShortTerm.remove(DRAFT_KEY); }catch(err){}
    }

    /* ---- learn from a transaction that was actually saved ---- */
    async function recordTransaction(tx){
      if(!tx || typeof tx !== 'object') return;
      try{
        const isIncome = tx.type === 'income';
        if(tx.category) await LongTerm.recordCategoryUse(tx.category, isIncome);
        const account = tx.account || tx.fromAccount;
        if(account) await LongTerm.recordAccountUse(account);
        if(tx.mode) await LongTerm.recordPaymentMode(tx.mode, tx.category);
        if(tx.item) await LongTerm.recordMerchant(tx.item);
        if(tx.notes) await LongTerm.recordNote(tx.notes);
        (tx.tags||[]).forEach(t=> LongTerm.recordTag(t));

        // index a compact summary so App.Memory.Search can find it later
        const summary = {
          type: 'transaction', refId: tx.id,
          text: [tx.item, tx.notes, tx.category, tx.subcategory, (tx.tags||[]).join(' ')].filter(Boolean).join(' '),
          amount: tx.amount, category: tx.category, date: tx.date, ts: Date.now()
        };
        await writeRecord('txn:'+tx.id, summary);
        await Index.addDoc('txn:'+tx.id, summary.text);
        await Index.flush();

        await clearDraftTransaction();
        logHistory('recordTransaction', {id: tx.id, category: tx.category});
      }catch(err){
        Logger.error('recordTransaction failed', err);
      }
    }

    async function deleteMemory(id){
      try{
        await Storage.delete(id);
        Cache.delete(id);
        await Index.removeDoc(id);
        await Index.flush();
        logHistory('deleteMemory', {id});
        return true;
      }catch(err){ Logger.error('deleteMemory failed', err); return false; }
    }

    async function search(queryText, opts){
      try{ return await Search.search(queryText, opts); }
      catch(err){ Logger.error('search failed', err); return []; }
    }
    async function recordSearchTerm(term){
      try{ await LongTerm.recordSearch(term); }catch(err){}
    }

    async function suggest(){
      try{ return await Context.buildSuggestions(); }
      catch(err){ Logger.error('suggest failed', err); return {}; }
    }

    function history(){ return historyLog.slice(); }

    async function expireNow(){
      try{ return await ShortTerm.cleanupExpired(); }
      catch(err){ Logger.error('expireNow failed', err); return 0; }
    }

    async function cleanup(){
      const removed = await expireNow();
      Logger.info('cleanup removed', removed, 'expired short-term record(s)');
      return removed;
    }

    /* Assembles an exportable snapshot of what memory currently
       knows — NOT wired to Google Drive or any network call; a
       future sprint can decide where this goes. Deliberately excludes
       raw encryption key material. */
    async function backupPrepare(){
      const longTerm = await LongTerm.get();
      return {
        version: '1.0.0',
        exportedAt: new Date().toISOString(),
        backend: Storage.backend(),
        longTerm,
        historyCount: historyLog.length
      };
    }

    /* ---- restore whatever is restorable after an app relaunch ---- */
    async function restore(){
      try{
        const draft = await getDraftTransaction();
        if(draft && typeof draft === 'object'){
          restoreDraftIntoForm(draft);
        }
        return { draftRestored: !!draft, unfinishedChat: Session.hasUnfinishedChat() };
      }catch(err){
        Logger.error('restore failed', err);
        return { draftRestored:false, unfinishedChat:false };
      }
    }

    function restoreDraftIntoForm(draft){
      // Only prefill if the user hasn't already started typing something
      // new in this load — never silently overwrite active input.
      const amountEl = document.getElementById('f_amount');
      if(!amountEl || amountEl.value) return;
      try{
        if(draft.entryType){
          const btn = document.querySelector('#typeSeg button[data-type="'+draft.entryType+'"]');
          if(btn) btn.click();
        }
        const setVal = (id, val)=>{ const el = document.getElementById(id); if(el && val!==undefined && val!==null) el.value = val; };
        setVal('f_amount', draft.amount);
        setVal('f_item', draft.item);
        setVal('f_notes', draft.notes);
        setVal('f_tags', draft.tags);
        if(draft.category){
          setVal('f_category', draft.category);
          if(typeof populateSubcatSelect === 'function') populateSubcatSelect();
        }
        setVal('f_subcategory', draft.subcategory);
        setVal('f_account', draft.account);
        setVal('f_mode', draft.mode);
        const hint = document.getElementById('entryHint');
        if(hint) hint.textContent = 'Restored your unfinished entry from last time — review and save, or just keep typing.';
        Logger.info('restored an unfinished transaction draft');
      }catch(err){ Logger.error('restoreDraftIntoForm failed', err); }
    }

    return {
      init, restore,
      saveDraftTransaction, getDraftTransaction, clearDraftTransaction,
      recordTransaction, recordSearchTerm,
      deleteMemory, search, suggest, history, expireNow, cleanup, backupPrepare
    };
  })();

  return {
    Storage, Cache, Index, Search, ShortTerm, LongTerm, Context, Session,
    Logger, Manager
  };
})();

/* ---------------------------------------------------------------
   WIRING — additive only. Nothing below removes, replaces, or
   changes the behavior of any existing function or listener; it
   only observes the same events / wraps the same save function with
   a thin pass-through that also feeds the memory engine.
--------------------------------------------------------------- */

/* 1) Learn from every transaction that actually gets saved, no matter
      which part of the app created it (manual form, chat assistant,
      voice assistant, duplicate/edit flows, recurring auto-posting…).
      saveTransactions() is already the single choke point all of
      those go through, so wrapping it once here gives full coverage
      without touching any of those call sites individually. Edits
      and deletes (transactions.length not increasing) are left
      alone — only newly-appended transactions are learned from. */
(function(){
  const originalSaveTransactions = saveTransactions;
  let lastKnownCount = Array.isArray(state.transactions) ? state.transactions.length : 0;
  saveTransactions = async function(){
    const result = await originalSaveTransactions.apply(this, arguments);
    try{
      const txns = state.transactions || [];
      if(txns.length > lastKnownCount){
        // awaited (not fire-and-forget) so anything that reads memory
        // right after saveTransactions() resolves — e.g. a suggestion
        // or search call — always sees the just-saved transaction.
        for(let i=lastKnownCount; i<txns.length; i++){
          await App.Memory.Manager.recordTransaction(txns[i]);
        }
      }
      lastKnownCount = txns.length;
    }catch(err){ App.Memory.Logger.error('post-save hook failed', err); }
    return result;
  };
})();

/* 2) Remember an in-progress (unsaved) manual entry, so it survives an
      accidental tab close / refresh. Purely additive listeners on top
      of the existing ones already bound to these fields — debounced
      so typing doesn't hammer storage. */
(function(){
  let debounceTimer = null;
  function captureDraft(){
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(()=>{
      try{
        if(typeof currentEntryType === 'undefined' || currentEntryType==='transfer') return;
        const val = id => { const el = document.getElementById(id); return el ? el.value : ''; };
        const amount = val('f_amount'), item = val('f_item'), notes = val('f_notes');
        if(!amount && !item && !notes) return; // nothing worth remembering yet
        App.Memory.Manager.saveDraftTransaction({
          entryType: currentEntryType,
          amount, item, notes,
          category: val('f_category'), subcategory: val('f_subcategory'),
          account: val('f_account'), mode: val('f_mode'), tags: val('f_tags')
        });
      }catch(err){ App.Memory.Logger.error('draft capture failed', err); }
    }, 500);
  }
  ['f_amount','f_item','f_notes','f_tags','f_category','f_subcategory','f_account','f_mode'].forEach(id=>{
    const el = document.getElementById(id);
    if(el){ el.addEventListener('input', captureDraft); el.addEventListener('change', captureDraft); }
  });
})();

/* 3) Remember recent searches from the existing transaction search box,
      without changing what that box already does. */
(function(){
  let debounceTimer = null;
  const el = document.getElementById('searchViewInput');
  if(el){
    el.addEventListener('input', e=>{
      clearTimeout(debounceTimer);
      const term = e.target.value;
      debounceTimer = setTimeout(()=>{ App.Memory.Manager.recordSearchTerm(term); }, 600);
    });
  }
})();

/* 4) Remember the user's language choice if/when the app exposes one
      via state.settings.language (read-only observation — does not
      create a new setting or UI control). */
(function(){
  try{
    if(state && state.settings && state.settings.language){
      App.Memory.LongTerm.setPreferredLanguage(state.settings.language);
    }
  }catch(err){}
})();


/* ================================================================
   SMART ATTACHMENT ENGINE   (App.Attachments)   —   v1.0.0   (Sprint 11)
   ------------------------------------------------------------------
   Real, working implementation (not a placeholder) letting any
   transaction carry multiple attachments — receipts, bills, invoices,
   PDFs, photos, voice notes, video clips, text files and documents.

   Everything below is additive and self-contained:
     • no existing function, element id, or transaction field is
       changed in a breaking way
     • the only touch points in the rest of the file are: the new
       "Attachments" section in the New Transaction form, a 📎 badge
       per transaction row/card, and three small hooks (save, duplicate,
       delete) documented at their call sites above
     • storage is 100% local — IndexedDB primary, localStorage fallback
       (mirrors the pattern already used by App.Memory). No network
       calls, no cloud upload, no OCR, no external APIs.

   Submodules:
     App.Attachments.Config        constants — allowed types, size
                                    limits, categories
     App.Attachments.Logger        scoped logging + small in-memory
                                    event log, separate from App.Logger
     App.Attachments.Security      filename sanitizing, MIME/extension
                                    whitelisting, file-signature sniffing
     App.Attachments.Validator     ties Security together into one
                                    validateFile() call: size, type,
                                    corruption, duplicate-by-hash
     App.Attachments.Compression   canvas-based image resize/recompress
                                    + thumbnail generation (images and
                                    video frames)
     App.Attachments.Storage       IndexedDB CRUD (localStorage
                                    fallback) for attachment records
     App.Attachments.Cache         object-URL + thumbnail cache so the
                                    same blob isn't re-decoded/re-drawn
                                    on every render
     App.Attachments.Manager       the public high-level API other code
                                    calls: addFiles / list / rename /
                                    replace / delete / duplicate / counts
     App.Attachments.Viewer        renders the full-preview stage for a
                                    single attachment (image zoom/rotate/
                                    fullscreen, PDF, audio, video)
     App.Attachments.UI            DOM wiring: the entry-form drop zone,
                                    the Attachments manager sheet, and
                                    the viewer sheet
================================================================ */
App.Attachments.Config = {
  DB_NAME: 'khaata_attachments_db',
  DB_VERSION: 1,
  STORE: 'attachments',
  LS_PREFIX: 'khaata:attach:',
  LS_INDEX_KEY: 'khaata:attach:_index',
  MAX_FILE_SIZE: 15 * 1024 * 1024,      // 15 MB per file
  MAX_IMAGE_DIM: 1600,                  // longest edge after compression
  THUMB_DIM: 160,                       // thumbnail longest edge
  IMAGE_QUALITY: 0.82,
  CATEGORIES: ['Receipt','Bill','Invoice','Photo','Voice Note','Video','Document','Other'],
  ALLOWED_MIME: {
    image: ['image/jpeg','image/jpg','image/png','image/webp','image/gif'],
    pdf: ['application/pdf'],
    audio: ['audio/mpeg','audio/mp3','audio/wav','audio/x-wav','audio/webm','audio/ogg','audio/mp4','audio/m4a','audio/x-m4a','audio/aac'],
    video: ['video/mp4','video/webm','video/quicktime','video/ogg'],
    text: ['text/plain'],
    document: ['application/msword','application/vnd.openxmlformats-officedocument.wordprocessingml.document']
  },
  ALLOWED_EXT: {
    image: ['.jpg','.jpeg','.png','.webp','.gif'],
    pdf: ['.pdf'],
    audio: ['.mp3','.wav','.m4a','.aac','.ogg','.webm'],
    video: ['.mp4','.webm','.mov','.ogv'],
    text: ['.txt'],
    document: ['.doc','.docx']
  },
  // magic-byte signatures used for corrupted/mislabeled-file detection.
  // Each entry is [offset, byteArray]; a file only fails the sniff check
  // when we DO have a signature for its detected kind and none match.
  SIGNATURES: {
    image: [
      [0, [0xFF,0xD8,0xFF]],                                   // JPEG
      [0, [0x89,0x50,0x4E,0x47,0x0D,0x0A,0x1A,0x0A]],           // PNG
      [0, [0x47,0x49,0x46,0x38]],                               // GIF
      [8, [0x57,0x45,0x42,0x50]]                                // WEBP ("WEBP" at offset 8)
    ],
    pdf: [[0, [0x25,0x50,0x44,0x46]]],                          // %PDF
    audio: [
      [0, [0x49,0x44,0x33]],                                    // ID3 (mp3)
      [0, [0xFF,0xFB]], [0,[0xFF,0xF3]], [0,[0xFF,0xF2]],       // raw mp3 frame sync
      [0, [0x52,0x49,0x46,0x46]],                                // RIFF (wav)
      [4, [0x66,0x74,0x79,0x70]],                                // ftyp (m4a)
      [0, [0x4F,0x67,0x67,0x53]]                                 // OggS
    ],
    video: [
      [4, [0x66,0x74,0x79,0x70]],                                // ftyp (mp4/mov)
      [0, [0x1A,0x45,0xDF,0xA3]],                                // webm/mkv EBML
      [0, [0x4F,0x67,0x67,0x53]]                                 // OggS (ogv)
    ]
    // text/document have no reliable universal signature — validated by
    // extension/MIME + readability only, not sniffed.
  }
};

/* ---------------------------------------------------------------
   LOGGER — scoped separately from App.Logger so attachment activity
   (adds, deletes, validation failures) can be inspected on its own.
--------------------------------------------------------------- */
App.Attachments.Logger = (function(){
  const MAX_LOG = 150;
  const log = [];
  function push(level, args){
    log.push({ level, at: new Date().toISOString(), msg: args.map(a=> a instanceof Error ? a.message : (typeof a==='object'? JSON.stringify(a): String(a))).join(' ') });
    if(log.length > MAX_LOG) log.shift();
  }
  return {
    info:(...a)=>{ push('info',a); console.log('[Attachments]', ...a); },
    warn:(...a)=>{ push('warn',a); console.warn('[Attachments]', ...a); },
    error:(...a)=>{ push('error',a); console.error('[Attachments]', ...a); },
    getLog:()=> log.slice()
  };
})();

/* ---------------------------------------------------------------
   SECURITY — filename sanitizing, type whitelisting, signature sniff
--------------------------------------------------------------- */
App.Attachments.Security = (function(){
  const Cfg = App.Attachments.Config;

  function extOf(name){
    const m = /\.[a-z0-9]+$/i.exec(name||'');
    return m ? m[0].toLowerCase() : '';
  }

  // Strips path separators, control characters and anything that isn't a
  // safe filename character; caps length; guarantees a non-empty result.
  function sanitizeFileName(name){
    let n = String(name||'attachment').split(/[\\/]/).pop();
    n = n.replace(/[\x00-\x1F\x7F]/g,'');
    n = n.replace(/[^a-zA-Z0-9 ._\-()]/g,'_');
    n = n.trim().replace(/^\.+/, '');
    if(!n) n = 'attachment';
    if(n.length > 120){
      const ext = extOf(n);
      n = n.slice(0, 120-ext.length) + ext;
    }
    return n;
  }

  function detectKind(mimeType, fileName){
    const mime = (mimeType||'').toLowerCase();
    const ext = extOf(fileName);
    for(const kind of Object.keys(Cfg.ALLOWED_MIME)){
      if(Cfg.ALLOWED_MIME[kind].includes(mime)) return kind;
    }
    for(const kind of Object.keys(Cfg.ALLOWED_EXT)){
      if(Cfg.ALLOWED_EXT[kind].includes(ext)) return kind;
    }
    return 'other';
  }

  function isAllowedType(mimeType, fileName){
    return detectKind(mimeType, fileName) !== 'other';
  }

  // Reads only the first 16 bytes (cheap) and checks them against known
  // magic-byte signatures for the file's detected kind. Used to catch a
  // renamed/corrupted file (e.g. a .jpg that isn't really a JPEG).
  async function sniffSignature(file, kind){
    const sigs = Cfg.SIGNATURES[kind];
    if(!sigs) return { checked:false, ok:true }; // no signature table for this kind (text/document) — skip
    try{
      const head = new Uint8Array(await file.slice(0, 16).arrayBuffer());
      const matched = sigs.some(([offset, bytes])=>{
        if(head.length < offset + bytes.length) return false;
        for(let i=0;i<bytes.length;i++){ if(head[offset+i] !== bytes[i]) return false; }
        return true;
      });
      return { checked:true, ok: matched };
    }catch(err){
      App.Attachments.Logger.warn('signature sniff failed', err);
      return { checked:false, ok:true }; // fail open — never block on a read error alone
    }
  }

  return { sanitizeFileName, detectKind, isAllowedType, sniffSignature, extOf };
})();

/* ---------------------------------------------------------------
   VALIDATOR — one entry point that combines Security's checks with
   size limits, a readability check and SHA-256 hashing for dedup.
--------------------------------------------------------------- */
App.Attachments.Validator = (function(){
  const Cfg = App.Attachments.Config;
  const Security = App.Attachments.Security;

  async function hashFile(file){
    if(!(window.crypto && window.crypto.subtle)) return null; // very old browser — dedup just won't be available
    try{
      const buf = await file.arrayBuffer();
      const digest = await crypto.subtle.digest('SHA-256', buf);
      return Array.from(new Uint8Array(digest)).map(b=>b.toString(16).padStart(2,'0')).join('');
    }catch(err){
      App.Attachments.Logger.warn('hashing failed', err);
      return null;
    }
  }

  // existingHashes: Set of hashes already attached to this transaction
  async function validateFile(file, existingHashes){
    const errors = [];
    const warnings = [];
    const safeName = Security.sanitizeFileName(file.name);
    const kind = Security.detectKind(file.type, file.name);

    if(kind === 'other'){
      errors.push(`"${file.name}" isn't a supported file type.`);
      return { valid:false, errors, warnings, kind, safeName, hash:null };
    }
    if(file.size <= 0){
      errors.push(`"${safeName}" is empty.`);
      return { valid:false, errors, warnings, kind, safeName, hash:null };
    }
    if(file.size > Cfg.MAX_FILE_SIZE){
      errors.push(`"${safeName}" is ${(file.size/1024/1024).toFixed(1)} MB — the limit is ${(Cfg.MAX_FILE_SIZE/1024/1024)|0} MB.`);
      return { valid:false, errors, warnings, kind, safeName, hash:null };
    }

    const sig = await Security.sniffSignature(file, kind);
    if(sig.checked && !sig.ok){
      errors.push(`"${safeName}" looks corrupted or doesn't actually match its file type.`);
      return { valid:false, errors, warnings, kind, safeName, hash:null };
    }

    const hash = await hashFile(file);
    let duplicate = false;
    if(hash && existingHashes && existingHashes.has(hash)){
      duplicate = true;
      warnings.push(`"${safeName}" looks identical to a file already attached — adding it anyway as a separate copy.`);
    }

    return { valid:true, errors, warnings, kind, safeName, hash, duplicate };
  }

  return { validateFile, hashFile };
})();

/* ---------------------------------------------------------------
   COMPRESSION — canvas-based image resize/recompress + thumbnails.
   Video gets a captured-frame thumbnail. Everything else has no
   thumbnail (the UI falls back to a type icon).
--------------------------------------------------------------- */
App.Attachments.Compression = (function(){
  const Cfg = App.Attachments.Config;

  function loadImage(file){
    return new Promise((resolve, reject)=>{
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = ()=>{ URL.revokeObjectURL(url); resolve(img); };
      img.onerror = (e)=>{ URL.revokeObjectURL(url); reject(e); };
      img.src = url;
    });
  }

  function drawScaled(img, maxDim){
    let { width, height } = img;
    if(width > maxDim || height > maxDim){
      if(width >= height){ height = Math.round(height * (maxDim/width)); width = maxDim; }
      else { width = Math.round(width * (maxDim/height)); height = maxDim; }
    }
    const canvas = document.createElement('canvas');
    canvas.width = width; canvas.height = height;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(img, 0, 0, width, height);
    return canvas;
  }

  function canvasToBlob(canvas, type, quality){
    return new Promise(resolve=> canvas.toBlob(b=> resolve(b), type, quality));
  }

  // Returns { blob, width, height } — the possibly-recompressed image,
  // never larger than the original (falls back to the original file if
  // canvas decoding isn't available, e.g. an unsupported image variant).
  async function compressImage(file){
    try{
      const img = await loadImage(file);
      const canvas = drawScaled(img, Cfg.MAX_IMAGE_DIM);
      const blob = await canvasToBlob(canvas, 'image/jpeg', Cfg.IMAGE_QUALITY);
      if(blob && blob.size < file.size){
        return { blob, width: canvas.width, height: canvas.height };
      }
      return { blob: file, width: img.naturalWidth, height: img.naturalHeight };
    }catch(err){
      App.Attachments.Logger.warn('image compression skipped, storing original', err);
      return { blob: file, width: null, height: null };
    }
  }

  async function imageThumbnail(file){
    try{
      const img = await loadImage(file);
      const canvas = drawScaled(img, Cfg.THUMB_DIM);
      return await canvasToBlob(canvas, 'image/jpeg', 0.75);
    }catch(err){ return null; }
  }

  // Captures a frame ~10% into the clip as the thumbnail.
  function videoThumbnail(file){
    return new Promise((resolve)=>{
      try{
        const url = URL.createObjectURL(file);
        const video = document.createElement('video');
        video.muted = true; video.playsInline = true; video.src = url;
        const cleanup = ()=>{ URL.revokeObjectURL(url); };
        video.addEventListener('loadedmetadata', ()=>{
          video.currentTime = Math.min(1, (video.duration||1) * 0.1);
        });
        video.addEventListener('seeked', async ()=>{
          try{
            const canvas = drawScaled({naturalWidth:video.videoWidth, naturalHeight:video.videoHeight, __v:video}, Cfg.THUMB_DIM);
            // drawScaled expects an <img>-like element passed to drawImage; video
            // works fine with ctx.drawImage too, so re-draw directly here:
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0,0,canvas.width,canvas.height);
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
            const blob = await canvasToBlob(canvas, 'image/jpeg', 0.75);
            cleanup();
            resolve(blob);
          }catch(err){ cleanup(); resolve(null); }
        });
        video.addEventListener('error', ()=>{ cleanup(); resolve(null); });
      }catch(err){ resolve(null); }
    });
  }

  async function makeThumbnail(file, kind){
    if(kind === 'image') return imageThumbnail(file);
    if(kind === 'video') return videoThumbnail(file);
    return null;
  }

  return { compressImage, makeThumbnail };
})();

/* ---------------------------------------------------------------
   STORAGE — IndexedDB primary (blobs stored natively), localStorage
   fallback (blobs stored as base64 data URLs — best-effort, since
   localStorage has a much smaller quota than IndexedDB).
--------------------------------------------------------------- */
App.Attachments.Storage = (function(){
  const Cfg = App.Attachments.Config;
  let dbPromise = null;
  let useIDB = (typeof window.indexedDB !== 'undefined') && window.indexedDB !== null;

  function openDB(){
    if(!useIDB) return Promise.resolve(null);
    if(dbPromise) return dbPromise;
    dbPromise = new Promise(resolve=>{
      try{
        const req = indexedDB.open(Cfg.DB_NAME, Cfg.DB_VERSION);
        req.onupgradeneeded = ()=>{
          const db = req.result;
          if(!db.objectStoreNames.contains(Cfg.STORE)){
            const store = db.createObjectStore(Cfg.STORE, { keyPath:'id' });
            store.createIndex('byTransaction', 'transactionId', { unique:false });
          }
        };
        req.onsuccess = ()=> resolve(req.result);
        req.onerror = ()=>{ App.Attachments.Logger.warn('IndexedDB unavailable, falling back to localStorage', req.error); useIDB=false; resolve(null); };
        req.onblocked = ()=>{ App.Attachments.Logger.warn('IndexedDB open blocked, falling back to localStorage'); useIDB=false; resolve(null); };
      }catch(err){ App.Attachments.Logger.warn('IndexedDB threw on open, falling back to localStorage', err); useIDB=false; resolve(null); }
    });
    return dbPromise;
  }

  function idbPut(record){
    return openDB().then(db=>{
      if(!db) return false;
      return new Promise(resolve=>{
        try{
          const tx = db.transaction(Cfg.STORE,'readwrite');
          tx.objectStore(Cfg.STORE).put(record);
          tx.oncomplete = ()=> resolve(true);
          tx.onerror = ()=> resolve(false);
        }catch(err){ resolve(false); }
      });
    });
  }
  function idbGet(id){
    return openDB().then(db=>{
      if(!db) return undefined;
      return new Promise(resolve=>{
        try{
          const tx = db.transaction(Cfg.STORE,'readonly');
          const req = tx.objectStore(Cfg.STORE).get(id);
          req.onsuccess = ()=> resolve(req.result);
          req.onerror = ()=> resolve(undefined);
        }catch(err){ resolve(undefined); }
      });
    });
  }
  function idbGetAllForTxn(transactionId){
    return openDB().then(db=>{
      if(!db) return null;
      return new Promise(resolve=>{
        try{
          const tx = db.transaction(Cfg.STORE,'readonly');
          const idx = tx.objectStore(Cfg.STORE).index('byTransaction');
          const req = idx.getAll(IDBKeyRange.only(transactionId));
          req.onsuccess = ()=> resolve(req.result||[]);
          req.onerror = ()=> resolve([]);
        }catch(err){ resolve([]); }
      });
    });
  }
  function idbDelete(id){
    return openDB().then(db=>{
      if(!db) return false;
      return new Promise(resolve=>{
        try{
          const tx = db.transaction(Cfg.STORE,'readwrite');
          tx.objectStore(Cfg.STORE).delete(id);
          tx.oncomplete = ()=> resolve(true);
          tx.onerror = ()=> resolve(false);
        }catch(err){ resolve(false); }
      });
    });
  }

  // ---- localStorage fallback: keeps a small JSON index of ids per
  // transaction, and one entry per attachment with blobs as data URLs ----
  function lsIndex(){
    try{ return JSON.parse(localStorage.getItem(Cfg.LS_INDEX_KEY)||'{}'); }catch(e){ return {}; }
  }
  function lsSaveIndex(idx){
    try{ localStorage.setItem(Cfg.LS_INDEX_KEY, JSON.stringify(idx)); return true; }catch(e){ return false; }
  }
  function blobToDataUrl(blob){
    return new Promise((resolve, reject)=>{
      const r = new FileReader();
      r.onload = ()=> resolve(r.result);
      r.onerror = reject;
      r.readAsDataURL(blob);
    });
  }
  function dataUrlToBlob(dataUrl){
    if(!dataUrl) return null;
    const [meta, b64] = dataUrl.split(',');
    const mime = /data:(.*?);base64/.exec(meta)?.[1] || 'application/octet-stream';
    const bin = atob(b64);
    const arr = new Uint8Array(bin.length);
    for(let i=0;i<bin.length;i++) arr[i] = bin.charCodeAt(i);
    return new Blob([arr], { type: mime });
  }
  async function lsPut(record){
    try{
      const plain = Object.assign({}, record);
      plain.blob = record.blob ? await blobToDataUrl(record.blob) : null;
      plain.thumbBlob = record.thumbBlob ? await blobToDataUrl(record.thumbBlob) : null;
      localStorage.setItem(Cfg.LS_PREFIX + record.id, JSON.stringify(plain));
      const idx = lsIndex();
      idx[record.transactionId] = idx[record.transactionId] || [];
      if(!idx[record.transactionId].includes(record.id)) idx[record.transactionId].push(record.id);
      lsSaveIndex(idx);
      return true;
    }catch(err){
      App.Attachments.Logger.error('localStorage attachment write failed (storage likely full)', err);
      return false;
    }
  }
  function lsGetRaw(id){
    try{ const raw = localStorage.getItem(Cfg.LS_PREFIX + id); return raw ? JSON.parse(raw) : undefined; }catch(e){ return undefined; }
  }
  function lsRecordFromRaw(raw){
    if(!raw) return undefined;
    return Object.assign({}, raw, {
      blob: raw.blob ? dataUrlToBlob(raw.blob) : null,
      thumbBlob: raw.thumbBlob ? dataUrlToBlob(raw.thumbBlob) : null
    });
  }
  function lsGetAllForTxn(transactionId){
    const idx = lsIndex();
    return (idx[transactionId]||[]).map(lsGetRaw).filter(Boolean).map(lsRecordFromRaw);
  }
  function lsDelete(id, transactionId){
    try{ localStorage.removeItem(Cfg.LS_PREFIX + id); }catch(e){}
    const idx = lsIndex();
    if(idx[transactionId]) idx[transactionId] = idx[transactionId].filter(x=>x!==id);
    lsSaveIndex(idx);
  }

  async function put(record){
    const ok = await idbPut(record);
    if(ok) return true;
    return lsPut(record);
  }
  async function get(id){
    const rec = await idbGet(id);
    if(rec) return rec;
    if(useIDB) return undefined; // real IDB says "not found" — trust it
    return lsRecordFromRaw(lsGetRaw(id));
  }
  async function getAllForTransaction(transactionId){
    const rec = await idbGetAllForTxn(transactionId);
    if(rec !== null) return rec;
    return lsGetAllForTxn(transactionId);
  }
  async function remove(id, transactionId){
    const ok = await idbDelete(id);
    if(!ok || !useIDB) lsDelete(id, transactionId);
    return true;
  }
  function backend(){ return useIDB ? 'indexeddb' : 'localstorage'; }

  return { put, get, getAllForTransaction, remove, backend };
})();

/* ---------------------------------------------------------------
   CACHE — object-URL cache so the same blob isn't turned into a new
   blob: URL on every re-render (which would leak memory over a long
   session if never revoked).
--------------------------------------------------------------- */
App.Attachments.Cache = (function(){
  const urls = new Map();   // attachmentId -> { main, thumb }
  const metaCache = new Map(); // transactionId -> { at, records }
  const META_TTL_MS = 4000;

  function urlFor(attachmentId, blob, which){
    if(!blob) return null;
    const entry = urls.get(attachmentId) || {};
    if(entry[which]) return entry[which];
    const url = URL.createObjectURL(blob);
    entry[which] = url;
    urls.set(attachmentId, entry);
    return url;
  }
  function revoke(attachmentId){
    const entry = urls.get(attachmentId);
    if(!entry) return;
    Object.values(entry).forEach(u=>{ try{ URL.revokeObjectURL(u); }catch(e){} });
    urls.delete(attachmentId);
  }
  function revokeAll(){ for(const id of Array.from(urls.keys())) revoke(id); }

  function getMeta(transactionId){
    const hit = metaCache.get(transactionId);
    if(hit && (Date.now()-hit.at) < META_TTL_MS) return hit.records;
    return null;
  }
  function setMeta(transactionId, records){ metaCache.set(transactionId, { at: Date.now(), records }); }
  function invalidate(transactionId){ metaCache.delete(transactionId); }

  return { urlFor, revoke, revokeAll, getMeta, setMeta, invalidate };
})();

/* ---------------------------------------------------------------
   MANAGER — the public high-level API. Everything else in the app
   (and the UI submodule below) should go through this, not Storage
   directly, so validation/compression/logging always run.
--------------------------------------------------------------- */
App.Attachments.Manager = (function(){
  const Storage = App.Attachments.Storage;
  const Validator = App.Attachments.Validator;
  const Compression = App.Attachments.Compression;
  const Security = App.Attachments.Security;
  const Cache = App.Attachments.Cache;
  const Logger = App.Attachments.Logger;

  async function list(transactionId){
    const cached = Cache.getMeta(transactionId);
    if(cached) return cached;
    const records = await Storage.getAllForTransaction(transactionId);
    records.sort((a,b)=> (b.createdDate||'').localeCompare(a.createdDate||''));
    Cache.setMeta(transactionId, records);
    return records;
  }

  async function countForTransaction(transactionId){
    return (await list(transactionId)).length;
  }
  async function countsForTransactions(ids){
    const out = {};
    await Promise.all(ids.map(async id=>{ out[id] = await countForTransaction(id); }));
    return out;
  }

  // Adds one or more files (a FileList or array of File) to a transaction.
  // Returns { added:[record,...], errors:[string,...], warnings:[string,...] }
  async function addFiles(transactionId, files, category){
    const errors = [], warnings = [], added = [];
    const existing = await list(transactionId);
    const existingHashes = new Set(existing.map(r=>r.hash).filter(Boolean));
    const now = new Date().toISOString();

    for(const file of Array.from(files||[])){
      try{
        const v = await Validator.validateFile(file, existingHashes);
        if(!v.valid){ errors.push(...v.errors); continue; }
        if(v.warnings.length) warnings.push(...v.warnings);
        if(v.hash) existingHashes.add(v.hash); // so two dupes in the same batch both get flagged, not silently merged

        let blob = file, width=null, height=null;
        if(v.kind === 'image'){
          const c = await Compression.compressImage(file);
          blob = c.blob; width = c.width; height = c.height;
        }
        const thumbBlob = await Compression.makeThumbnail(file, v.kind);

        let pageCount = null;
        if(v.kind === 'pdf'){
          pageCount = await estimatePdfPageCount(file).catch(()=>null);
        }

        const record = {
          id: uid(),
          transactionId,
          fileName: v.safeName,
          category: category || (v.kind==='image' ? 'Receipt' : v.kind==='pdf' ? 'Bill' : v.kind==='audio' ? 'Voice Note' : v.kind==='video' ? 'Video' : 'Document'),
          kind: v.kind,
          mimeType: file.type || '',
          fileSize: blob.size,
          createdDate: now,
          modifiedDate: now,
          hash: v.hash,
          description: '',
          tags: [],
          width, height, pageCount,
          blob,
          thumbBlob
        };
        const ok = await Storage.put(record);
        if(!ok){ errors.push(`Couldn't save "${v.safeName}" — storage may be full.`); continue; }
        added.push(record);
        Logger.info('added attachment', record.fileName, 'to txn', transactionId);
      }catch(err){
        Logger.error('addFiles failed for a file', err);
        errors.push(`Something went wrong adding "${file.name}".`);
      }
    }
    if(added.length) Cache.invalidate(transactionId);
    return { added, errors, warnings };
  }

  async function rename(attachmentId, newName){
    const rec = await Storage.get(attachmentId);
    if(!rec) return false;
    rec.fileName = Security.sanitizeFileName(newName);
    rec.modifiedDate = new Date().toISOString();
    const ok = await Storage.put(rec);
    if(ok) Cache.invalidate(rec.transactionId);
    return ok;
  }

  async function updateMeta(attachmentId, { description, tags, category } = {}){
    const rec = await Storage.get(attachmentId);
    if(!rec) return false;
    if(description !== undefined) rec.description = String(description).slice(0, 500);
    if(tags !== undefined) rec.tags = Array.isArray(tags) ? tags : String(tags).split(',').map(s=>s.trim()).filter(Boolean);
    if(category !== undefined) rec.category = category;
    rec.modifiedDate = new Date().toISOString();
    const ok = await Storage.put(rec);
    if(ok) Cache.invalidate(rec.transactionId);
    return ok;
  }

  async function replace(attachmentId, newFile){
    const rec = await Storage.get(attachmentId);
    if(!rec) return { ok:false, errors:['Original attachment not found.'] };
    const existing = (await list(rec.transactionId)).filter(r=>r.id!==attachmentId);
    const existingHashes = new Set(existing.map(r=>r.hash).filter(Boolean));
    const v = await Validator.validateFile(newFile, existingHashes);
    if(!v.valid) return { ok:false, errors:v.errors };

    let blob = newFile, width=null, height=null;
    if(v.kind === 'image'){
      const c = await Compression.compressImage(newFile);
      blob = c.blob; width=c.width; height=c.height;
    }
    const thumbBlob = await Compression.makeThumbnail(newFile, v.kind);
    let pageCount = rec.pageCount;
    if(v.kind === 'pdf') pageCount = await estimatePdfPageCount(newFile).catch(()=>null);

    Object.assign(rec, {
      fileName: v.safeName, kind: v.kind, mimeType: newFile.type||'', fileSize: blob.size,
      modifiedDate: new Date().toISOString(), hash: v.hash, width, height, pageCount, blob, thumbBlob
    });
    const ok = await Storage.put(rec);
    if(ok){ Cache.revoke(attachmentId); Cache.invalidate(rec.transactionId); }
    return { ok, errors: ok? [] : ['Storage write failed.'], warnings: v.warnings };
  }

  async function remove(attachmentId){
    const rec = await Storage.get(attachmentId);
    if(!rec) return false;
    const ok = await Storage.remove(attachmentId, rec.transactionId);
    Cache.revoke(attachmentId);
    Cache.invalidate(rec.transactionId);
    return ok;
  }

  async function deleteAllForTransaction(transactionId){
    const recs = await list(transactionId);
    for(const r of recs) await remove(r.id);
    Cache.invalidate(transactionId);
  }

  async function duplicateForTransaction(oldTransactionId, newTransactionId){
    const recs = await Storage.getAllForTransaction(oldTransactionId);
    const now = new Date().toISOString();
    for(const r of recs){
      const copy = Object.assign({}, r, { id: uid(), transactionId: newTransactionId, createdDate: now, modifiedDate: now });
      await Storage.put(copy);
    }
    if(recs.length) Cache.invalidate(newTransactionId);
    return recs.length;
  }

  function get(attachmentId){ return Storage.get(attachmentId); }

  function openFile(attachmentId){
    return Storage.get(attachmentId).then(rec=>{
      if(!rec || !rec.blob) return;
      const url = App.Attachments.Cache.urlFor(attachmentId, rec.blob, 'main');
      window.open(url, '_blank');
    });
  }
  function downloadFileAttachment(attachmentId){
    return Storage.get(attachmentId).then(rec=>{
      if(!rec || !rec.blob) return;
      downloadFile(rec.fileName, rec.blob, rec.mimeType || 'application/octet-stream');
    });
  }

  // Best-effort PDF page count: scans the raw bytes for "/Type /Page"
  // object markers. Works for the large majority of non-encrypted PDFs
  // without needing a PDF-parsing library (kept intentionally simple —
  // this is a page-count estimate, not a PDF parser).
  async function estimatePdfPageCount(file){
    try{
      const text = await file.slice(0, Math.min(file.size, 4*1024*1024)).text();
      const matches = text.match(/\/Type\s*\/Page[^s]/g);
      return matches ? matches.length : null;
    }catch(err){ return null; }
  }

  return {
    list, countForTransaction, countsForTransactions, addFiles, rename, updateMeta,
    replace, remove, deleteAllForTransaction, duplicateForTransaction, get,
    openFile, downloadFile: downloadFileAttachment, estimatePdfPageCount
  };
})();
/* ---------------------------------------------------------------
   VIEWER — renders the full-preview stage for one attachment inside
   #attachViewerOverlay: image (zoom/rotate/fullscreen), PDF (page
   count + open/download), audio (play/pause/seek + waveform
   placeholder), video (play/pause/fullscreen), and a generic
   icon+download fallback for text/document files.
--------------------------------------------------------------- */
App.Attachments.Viewer = (function(){
  const Cache = App.Attachments.Cache;
  const Manager = () => App.Attachments.Manager; // lazy — Manager is defined above, but keep this indirection tidy
  let imgState = { scale:1, rotation:0 };

  function el(id){ return document.getElementById(id); }

  function iconFor(kind){
    return { image:'🖼️', pdf:'📄', audio:'🎙️', video:'🎬', text:'📝', document:'📃' }[kind] || '📎';
  }

  async function open(attachmentId){
    const rec = await App.Attachments.Manager.get(attachmentId);
    if(!rec){ App.Attachments.Logger.warn('viewer: attachment not found', attachmentId); return; }
    el('attachViewerTitle').textContent = rec.fileName;
    const stage = el('attachViewerStage');
    const controls = el('attachViewerControls');
    stage.innerHTML = ''; controls.innerHTML = '';
    imgState = { scale:1, rotation:0 };

    const url = rec.blob ? Cache.urlFor(rec.id, rec.blob, 'main') : null;

    if(rec.kind === 'image' && url){
      const img = document.createElement('img');
      img.src = url; img.id = 'attachViewerImg';
      stage.appendChild(img);
      controls.innerHTML = `
        <button id="avZoomOut">➖ Zoom</button>
        <button id="avZoomIn">➕ Zoom</button>
        <button id="avRotate">↻ Rotate</button>
        <button id="avFullscreen">⛶ Fullscreen</button>
        <button id="avDownload">⬇ Download</button>`;
      applyImgTransform();
      el('avZoomOut').onclick = ()=>{ imgState.scale = Math.max(0.25, imgState.scale-0.25); applyImgTransform(); };
      el('avZoomIn').onclick = ()=>{ imgState.scale = Math.min(4, imgState.scale+0.25); applyImgTransform(); };
      el('avRotate').onclick = ()=>{ imgState.rotation = (imgState.rotation+90)%360; applyImgTransform(); };
      el('avFullscreen').onclick = ()=> toggleFullscreen(stage);
      el('avDownload').onclick = ()=> App.Attachments.Manager.downloadFile(rec.id);
    } else if(rec.kind === 'pdf' && url){
      const frame = document.createElement('iframe');
      frame.src = url;
      stage.appendChild(frame);
      controls.innerHTML = `
        <button id="avOpen">↗ Open</button>
        <button id="avDownload">⬇ Download</button>`;
      el('avOpen').onclick = ()=> App.Attachments.Manager.openFile(rec.id);
      el('avDownload').onclick = ()=> App.Attachments.Manager.downloadFile(rec.id);
    } else if(rec.kind === 'audio' && url){
      const wrap = document.createElement('div');
      wrap.style.width = '100%';
      const waveform = document.createElement('div');
      waveform.className = 'attach-waveform';
      // Waveform placeholder: deterministic pseudo-random bar heights from
      // the file's hash, not a real audio analysis (kept intentionally
      // lightweight — no audio-decoding library involved).
      const bars = 40;
      const seedSrc = (rec.hash||rec.id);
      for(let i=0;i<bars;i++){
        const h = 20 + (parseInt(seedSrc.substr((i*2)%seedSrc.length,2),16)||10) % 70;
        const bar = document.createElement('span');
        bar.style.height = h+'%';
        waveform.appendChild(bar);
      }
      const audio = document.createElement('audio');
      audio.controls = true; audio.src = url; audio.style.width='100%'; audio.style.marginTop='8px';
      wrap.appendChild(waveform); wrap.appendChild(audio);
      stage.appendChild(wrap);
      controls.innerHTML = `<button id="avDownload">⬇ Download</button>`;
      el('avDownload').onclick = ()=> App.Attachments.Manager.downloadFile(rec.id);
    } else if(rec.kind === 'video' && url){
      const video = document.createElement('video');
      video.controls = true; video.src = url;
      stage.appendChild(video);
      controls.innerHTML = `
        <button id="avFullscreen">⛶ Fullscreen</button>
        <button id="avDownload">⬇ Download</button>`;
      el('avFullscreen').onclick = ()=>{ if(video.requestFullscreen) video.requestFullscreen(); };
      el('avDownload').onclick = ()=> App.Attachments.Manager.downloadFile(rec.id);
    } else {
      const box = document.createElement('div');
      box.style.cssText = 'display:flex;flex-direction:column;align-items:center;gap:8px;padding:30px;';
      box.innerHTML = `<div style="font-size:40px;">${iconFor(rec.kind)}</div><div class="card-note">Preview isn't available for this file type — open or download it instead.</div>`;
      stage.appendChild(box);
      controls.innerHTML = `<button id="avOpen">↗ Open</button><button id="avDownload">⬇ Download</button>`;
      el('avOpen').onclick = ()=> App.Attachments.Manager.openFile(rec.id);
      el('avDownload').onclick = ()=> App.Attachments.Manager.downloadFile(rec.id);
    }

    const metaBits = [rec.category, rec.kind.toUpperCase(), fmtBytes(rec.fileSize)];
    if(rec.pageCount) metaBits.push(rec.pageCount + ' page(s)');
    if(rec.width && rec.height) metaBits.push(rec.width+'×'+rec.height);
    el('attachViewerMeta').textContent = metaBits.filter(Boolean).join(' · ');

    el('attachViewerOverlay').classList.remove('hidden');
  }

  function applyImgTransform(){
    const img = el('attachViewerImg');
    if(img) img.style.transform = `scale(${imgState.scale}) rotate(${imgState.rotation}deg)`;
  }
  function toggleFullscreen(stageEl){
    if(!document.fullscreenElement){ stageEl.requestFullscreen && stageEl.requestFullscreen(); }
    else { document.exitFullscreen && document.exitFullscreen(); }
  }
  function fmtBytes(n){
    if(!n && n!==0) return '';
    if(n < 1024) return n+' B';
    if(n < 1024*1024) return (n/1024).toFixed(1)+' KB';
    return (n/1024/1024).toFixed(1)+' MB';
  }
  function close(){ el('attachViewerOverlay').classList.add('hidden'); }

  return { open, close, iconFor, fmtBytes };
})();

/* ---------------------------------------------------------------
   UI — DOM wiring: the New-Transaction drop zone, the per-transaction
   Attachments manager sheet, and binding the Viewer's close button.
   Nothing in here talks to state.transactions directly — it only
   calls into App.Attachments.Manager.
--------------------------------------------------------------- */
App.Attachments.UI = (function(){
  const Manager = App.Attachments.Manager;
  const Viewer = App.Attachments.Viewer;
  const Cache = App.Attachments.Cache;

  let entryAttachId = uid(); // pending id for the New Transaction form; becomes the real txn.id on save
  let managerTxnId = null;

  function el(id){ return document.getElementById(id); }
  function currentEntryAttachId(){ return entryAttachId; }
  function resetEntryZone(){
    entryAttachId = uid();
    el('entryAttachList').innerHTML = '';
    el('entryAttachInput').value = '';
  }

  function renderProgress(barId, wrapId, pct){
    const wrap = el(wrapId), bar = el(barId);
    if(pct === null){ wrap.classList.add('hidden'); return; }
    wrap.classList.remove('hidden');
    bar.style.width = pct + '%';
    if(pct >= 100) setTimeout(()=> wrap.classList.add('hidden'), 400);
  }

  async function renderList(containerId, transactionId, opts){
    const container = el(containerId);
    const recs = await Manager.list(transactionId);
    if(!recs.length){
      container.innerHTML = `<div class="attach-empty-note">No attachments yet.</div>`;
      return;
    }
    container.innerHTML = recs.map(r=>{
      const thumbUrl = r.thumbBlob ? Cache.urlFor(r.id, r.thumbBlob, 'thumb') : null;
      const thumbHtml = thumbUrl ? `<img src="${thumbUrl}" alt="">` : Viewer.iconFor(r.kind);
      return `<div class="attach-item" data-aid="${r.id}">
        <div class="attach-thumb attach-open-viewer" title="Preview">${thumbHtml}</div>
        <div class="attach-meta attach-open-viewer">
          <div class="attach-name">${escapeHtml(r.fileName)}</div>
          <div class="attach-sub">${escapeHtml(r.category)} · ${Viewer.fmtBytes(r.fileSize)}${r.pageCount?' · '+r.pageCount+'p':''}</div>
        </div>
        <div class="attach-actions">
          <button class="a-open" title="Open">↗</button>
          <button class="a-download" title="Download">⬇</button>
          ${opts&&opts.compact? '' : '<button class="a-rename" title="Rename">✎</button><button class="a-replace" title="Replace">🔁</button>'}
          <button class="a-delete" title="Delete">🗑</button>
        </div>
      </div>`;
    }).join('');

    container.querySelectorAll('.attach-item').forEach(item=>{
      const id = item.dataset.aid;
      item.querySelectorAll('.attach-open-viewer').forEach(node=> node.addEventListener('click', ()=> Viewer.open(id)));
      const openBtn = item.querySelector('.a-open'); if(openBtn) openBtn.addEventListener('click', ()=> Manager.openFile(id));
      const dlBtn = item.querySelector('.a-download'); if(dlBtn) dlBtn.addEventListener('click', ()=> Manager.downloadFile(id));
      const delBtn = item.querySelector('.a-delete');
      if(delBtn) delBtn.addEventListener('click', async ()=>{
        if(!confirm('Delete this attachment?')) return;
        await Manager.remove(id);
        await renderList(containerId, transactionId, opts);
        if(managerTxnId) renderTransactions();
      });
      const renameBtn = item.querySelector('.a-rename');
      if(renameBtn) renameBtn.addEventListener('click', async ()=>{
        const rec = await Manager.get(id);
        const nn = prompt('Rename attachment:', rec ? rec.fileName : '');
        if(nn===null || !nn.trim()) return;
        await Manager.rename(id, nn.trim());
        await renderList(containerId, transactionId, opts);
      });
      const replaceBtn = item.querySelector('.a-replace');
      if(replaceBtn) replaceBtn.addEventListener('click', ()=>{
        const input = el('mgrAttachReplaceInput');
        input.onchange = async ()=>{
          if(!input.files || !input.files[0]) return;
          const res = await Manager.replace(id, input.files[0]);
          if(!res.ok) alert(res.errors.join('\n'));
          input.value = '';
          await renderList(containerId, transactionId, opts);
        };
        input.click();
      });
    });
  }

  async function handleFiles(transactionId, files, { containerId, progressBarId, progressWrapId, compact }){
    if(!files || !files.length) return;
    renderProgress(progressBarId, progressWrapId, 10);
    const res = await Manager.addFiles(transactionId, files);
    renderProgress(progressBarId, progressWrapId, 100);
    await renderList(containerId, transactionId, { compact });
    if(managerTxnId === transactionId || containerId === 'entryAttachList') renderTransactions();
    if(res.errors.length) alert(res.errors.join('\n'));
    else if(res.warnings.length) {
      const note = document.createElement('div');
      note.className = 'attach-dup-warn';
      note.textContent = res.warnings.join(' ');
      el(containerId).prepend(note);
    }
  }

  function wireZone(zoneId, inputId, transactionIdGetter, listOpts){
    const zone = el(zoneId), input = el(inputId);
    if(!zone || !input) return;
    zone.addEventListener('click', ()=> input.click());
    zone.addEventListener('keydown', e=>{ if(e.key==='Enter' || e.key===' '){ e.preventDefault(); input.click(); } });
    input.addEventListener('change', async ()=>{
      await handleFiles(transactionIdGetter(), input.files, listOpts);
      input.value = '';
    });
    ['dragenter','dragover'].forEach(evt=> zone.addEventListener(evt, e=>{ e.preventDefault(); zone.classList.add('dragover'); }));
    ['dragleave','drop'].forEach(evt=> zone.addEventListener(evt, e=>{ e.preventDefault(); zone.classList.remove('dragover'); }));
    zone.addEventListener('drop', async e=>{
      const files = e.dataTransfer && e.dataTransfer.files;
      if(files && files.length) await handleFiles(transactionIdGetter(), files, listOpts);
    });
  }

  async function openManager(transactionId){
    managerTxnId = transactionId;
    const t = state.transactions.find(x=>x.id===transactionId);
    el('attachManagerTxnInfo').textContent = t
      ? `${t.type==='transfer'?'Transfer':(t.category||t.type)} · ${fmt(t.amount)} · ${t.date}`
      : 'Transaction';
    await renderList('mgrAttachList', transactionId, { compact:false });
    el('attachManagerOverlay').classList.remove('hidden');
  }
  function closeManager(){ el('attachManagerOverlay').classList.add('hidden'); managerTxnId = null; }

  function bind(){
    wireZone('entryAttachZone', 'entryAttachInput', ()=>entryAttachId, {
      containerId:'entryAttachList', progressBarId:'entryAttachProgressBar', progressWrapId:'entryAttachProgress', compact:true
    });
    wireZone('mgrAttachZone', 'mgrAttachInput', ()=>managerTxnId, {
      containerId:'mgrAttachList', progressBarId:'mgrAttachProgressBar', progressWrapId:'mgrAttachProgress', compact:false
    });
    el('attachManagerClose').addEventListener('click', closeManager);
    el('attachManagerOverlay').addEventListener('click', e=>{ if(e.target.id==='attachManagerOverlay') closeManager(); });
    el('attachViewerClose').addEventListener('click', Viewer.close);
    el('attachViewerOverlay').addEventListener('click', e=>{ if(e.target.id==='attachViewerOverlay') Viewer.close(); });
  }

  return { bind, openManager, closeManager, currentEntryAttachId, resetEntryZone, renderList };
})();

/* ==================================================================
   PRODUCTION OCR ENGINE   (App.OCR)   —   v1.0.0   (Sprint 12)
   ==================================================================
   Real OCR, not a placeholder: text recognition runs via Tesseract.js
   (an actual OCR engine), loaded lazily from a CDN the first time the
   user taps "Scan Receipt / Bill" so it never slows down normal app
   startup. Everything after raw text recognition (field extraction,
   validation, transaction drafting) runs locally in this file with no
   network calls and no external service.

   Submodules:
     App.OCR.Scanner    lazy-loads Tesseract.js, preprocesses the image
                        on a <canvas> (grayscale + contrast stretch +
                        upscaling for small images), runs recognition,
                        reuses a single worker across scans for speed.
     App.OCR.Parser     turns raw OCR text into structured fields
                        (merchant, amount, GST/tax, discount, date,
                        time, invoice #, payment method, phone,
                        address, items, total, currency). Reuses the
                        app's existing detectCategory()/detectMode()/
                        detectAccount() helpers (the same ones the
                        voice assistant already uses) instead of
                        duplicating that logic, and exposes a small
                        plugin registry (registerFieldExtractor) so
                        new field types can be added without editing
                        this file's core loop.
     App.OCR.Validator  sanity-checks parsed fields (amount > 0, GSTIN
                        checksum shape, plausible date range, etc.),
                        assigns a confidence level per field, and
                        produces a list of warnings shown to the user
                        before they confirm the draft.
     App.OCR.Logger     '[OCR]' — prefixed logging on top of App.Logger,
                        plus an in-memory ring buffer (last 25 events)
                        inspectable via App.OCR.Logger.history() for
                        debugging failed scans.
     App.OCR.UI         wires the "Scan Receipt / Bill" zone + file
                        input, runs the pipeline, shows the review
                        sheet with editable fields, and — only on
                        explicit user confirmation — creates the real
                        transaction the exact same way the manual
                        entry form does (state.transactions.push(...) +
                        saveTransactions()). It never writes transaction
                        data on its own.

   Supported source types: printed receipts, retail/restaurant bills,
   invoices, GST bills, bank slips, and payment/UPI screenshots — all
   of these are machine-printed text, which is what Tesseract is
   actually good at. Handwritten notes use the exact same pipeline
   (flagged "experimental" in the UI) but real handwriting recognition
   accuracy with a client-side, no-training model is genuinely poor —
   this is disclosed rather than oversold.
================================================================== */
App.OCR = (function(){
  const TESSERACT_CDN = 'https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js';
  const RING_SIZE = 25;

  /* ---------------- Logger ---------------- */
  const ringBuffer = [];
  const Logger = {
    info(...args){ ringBuffer.push({level:'info', at:Date.now(), msg:args.map(String).join(' ')}); if(ringBuffer.length>RING_SIZE) ringBuffer.shift(); App.Logger.info('[OCR]', ...args); },
    warn(...args){ ringBuffer.push({level:'warn', at:Date.now(), msg:args.map(String).join(' ')}); if(ringBuffer.length>RING_SIZE) ringBuffer.shift(); App.Logger.warn('[OCR]', ...args); },
    error(...args){ ringBuffer.push({level:'error', at:Date.now(), msg:args.map(String).join(' ')}); if(ringBuffer.length>RING_SIZE) ringBuffer.shift(); App.Logger.error('[OCR]', ...args); },
    history(){ return ringBuffer.slice(); }
  };

  /* ---------------- Scanner ---------------- */
  let scriptLoadPromise = null;
  let worker = null;
  function loadTesseractScript(){
    if(window.Tesseract) return Promise.resolve();
    if(scriptLoadPromise) return scriptLoadPromise;
    scriptLoadPromise = new Promise((resolve, reject)=>{
      const s = document.createElement('script');
      s.src = TESSERACT_CDN;
      s.async = true;
      s.onload = ()=>resolve();
      s.onerror = ()=>reject(new Error('Could not load the OCR engine — check your internet connection and try again.'));
      document.head.appendChild(s);
    });
    return scriptLoadPromise;
  }
  async function getWorker(onProgress){
    await loadTesseractScript();
    if(!worker){
      Logger.info('initializing Tesseract worker (eng)');
      worker = await Tesseract.createWorker('eng', 1, {
        logger: m=>{ if(onProgress && m && typeof m.progress==='number') onProgress(m); }
      });
    }
    return worker;
  }
  /* Preprocess on a canvas: grayscale + simple contrast stretch, and
     upscale small images — measurably improves OCR accuracy on phone
     photos of receipts vs. feeding the raw photo straight in. */
  function preprocessImage(file){
    return new Promise((resolve, reject)=>{
      const img = new Image();
      const url = URL.createObjectURL(file);
      img.onload = ()=>{
        try{
          const scale = img.width < 900 ? Math.min(2, 900/img.width) : 1;
          const w = Math.round(img.width*scale), h = Math.round(img.height*scale);
          const canvas = document.createElement('canvas');
          canvas.width = w; canvas.height = h;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, w, h);
          const imgData = ctx.getImageData(0,0,w,h);
          const d = imgData.data;
          let min=255, max=0;
          for(let i=0;i<d.length;i+=4){
            const g = 0.299*d[i]+0.587*d[i+1]+0.114*d[i+2];
            d[i]=d[i+1]=d[i+2]=g;
            if(g<min) min=g; if(g>max) max=g;
          }
          const range = Math.max(1, max-min);
          for(let i=0;i<d.length;i+=4){
            const v = ((d[i]-min)/range)*255;
            d[i]=d[i+1]=d[i+2]=v;
          }
          ctx.putImageData(imgData,0,0);
          URL.revokeObjectURL(url);
          resolve(canvas.toDataURL('image/png'));
        }catch(err){ URL.revokeObjectURL(url); reject(err); }
      };
      img.onerror = ()=>{ URL.revokeObjectURL(url); reject(new Error('Could not read that image file.')); };
      img.src = url;
    });
  }
  async function recognize(file, onProgress){
    Logger.info('scan started', file.name, file.size+'b');
    const dataUrl = await preprocessImage(file);
    const w = await getWorker(onProgress);
    const { data } = await w.recognize(dataUrl);
    Logger.info('scan complete, confidence', data.confidence);
    return { text: data.text || '', confidence: data.confidence || 0 };
  }
  async function terminate(){
    if(worker){ try{ await worker.terminate(); }catch(e){} worker = null; }
  }

  /* ---------------- Parser ---------------- */
  const fieldExtractors = {}; // plugin registry — App.OCR.Parser.registerFieldExtractor(name, fn)
  function registerFieldExtractor(name, fn){ fieldExtractors[name] = fn; }

  const CURRENCY_RE = /(₹|Rs\.?|INR|\$)/i;
  const GSTIN_RE = /\b\d{2}[A-Z]{5}\d{4}[A-Z]\d[A-Z\d]Z[A-Z\d]\b/;
  const PHONE_RE = /(?:\+?91[-\s]?)?\b[6-9]\d{9}\b/;
  const DATE_RES = [
    /\b(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{2,4})\b/,                              // 12/03/2026, 12-03-26
    /\b(\d{4})-(\d{1,2})-(\d{1,2})\b/,                                            // 2026-03-12
    /\b(\d{1,2})\s+(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\s+(\d{2,4})\b/i // 12 Mar 2026
  ];
  const TIME_RE = /\b(\d{1,2}):(\d{2})(?::\d{2})?\s*(am|pm|AM|PM)?\b/;
  const MONTHS = {jan:0,feb:1,mar:2,apr:3,may:4,jun:5,jul:6,aug:7,sep:8,oct:9,nov:10,dec:11};

  function moneyNear(lines, keywordsRe){
    for(const line of lines){
      if(keywordsRe.test(line)){
        const m = line.match(/([\d,]+\.\d{1,2}|[\d,]{2,})/);
        if(m){ const v = parseFloat(m[1].replace(/,/g,'')); if(!isNaN(v)) return v; }
      }
    }
    return null;
  }
  function parseDateToken(text){
    for(const re of DATE_RES){
      const m = text.match(re);
      if(!m) continue;
      let y,mo,d;
      if(re===DATE_RES[0]){ d=+m[1]; mo=+m[2]-1; y=+m[3]; if(y<100) y+=2000; }
      else if(re===DATE_RES[1]){ y=+m[1]; mo=+m[2]-1; d=+m[3]; }
      else { d=+m[1]; mo=MONTHS[m[2].slice(0,3).toLowerCase()]; y=+m[3]; if(y<100) y+=2000; }
      if(mo<0||mo>11||d<1||d>31) continue;
      const dt = new Date(Date.UTC(y,mo,d));
      if(isNaN(dt.getTime())) continue;
      return dt.toISOString().slice(0,10);
    }
    return null;
  }
  function guessMerchant(lines){
    for(const line of lines.slice(0,6)){
      const clean = line.trim();
      if(clean.length<3) continue;
      if(/^\d+$/.test(clean)) continue;
      if(GSTIN_RE.test(clean)) continue;
      if(/^(invoice|receipt|bill|tax invoice|gst invoice|date|time|order)/i.test(clean)) continue;
      return clean.replace(/[^\w\s&.,'-]/g,'').trim().slice(0,60);
    }
    return '';
  }
  function guessItems(lines){
    const items = [];
    const itemRe = /^(.{2,40}?)\s+(?:x\s*\d+\s+)?[₹Rs.]*\s*([\d,]+\.\d{2}|[\d,]{2,})\s*$/i;
    for(const line of lines){
      const m = line.match(itemRe);
      if(m && !/total|subtotal|gst|tax|discount|change|balance|cash|card|upi/i.test(m[1])){
        items.push(m[1].trim()+' — '+m[2]);
      }
      if(items.length>=12) break;
    }
    return items;
  }
  function parseReceiptText(rawText){
    const lines = rawText.split(/\r?\n/).map(l=>l.trim()).filter(Boolean);
    const lower = rawText.toLowerCase();

    const merchant = guessMerchant(lines);
    const currencyMatch = rawText.match(CURRENCY_RE);
    const currency = currencyMatch ? (currencyMatch[1].toUpperCase().startsWith('R') ? '₹' : currencyMatch[1]) : '₹';

    const total = moneyNear(lines, /\b(grand\s*total|total\s*amount|net\s*amount|amount\s*payable|total)\b/i)
                  ?? moneyNear(lines, /₹|rs\.?\s*\d/i);
    const tax = moneyNear(lines, /\b(cgst|sgst|igst|gst|vat|tax)\b/i);
    const discount = moneyNear(lines, /\bdiscount\b/i);
    const gstin = (rawText.match(GSTIN_RE)||[])[0] || '';
    const phone = (rawText.match(PHONE_RE)||[])[0] || '';
    const date = parseDateToken(rawText);
    const timeMatch = rawText.match(TIME_RE);
    const time = timeMatch ? `${timeMatch[1].padStart(2,'0')}:${timeMatch[2]}` : '';
    const invoiceMatch = rawText.match(/\b(?:invoice|bill|receipt|order)\s*(?:no\.?|#|number|id)?\s*[:\-]?\s*([A-Za-z0-9\-\/]{3,20})/i);
    const invoiceNo = invoiceMatch ? invoiceMatch[1] : '';
    const addressLine = lines.find(l=>/\b(road|street|st\.|nagar|marg|lane|floor|near|opp\.?|pin\s?code|\b\d{6}\b)\b/i.test(l)) || '';
    const items = guessItems(lines);

    // Reuse the app's existing category/mode/account detection helpers so
    // OCR-derived transactions land in the same categories the voice
    // assistant would pick, instead of a second, divergent classifier.
    const { category, subcategory } = (typeof detectCategory==='function') ? detectCategory(lower,'expense') : {category:'Other',subcategory:''};
    const mode = (typeof detectMode==='function') ? detectMode(lower) : 'Other';
    const accountId = (typeof detectAccount==='function') ? detectAccount(lower) : null;

    const fields = {
      merchant, amount: total, currency, gstin, tax, discount, date, time,
      invoiceNo, phone, address: addressLine, items, category, subcategory, mode, accountId
    };
    for(const name in fieldExtractors){
      try{ const extra = fieldExtractors[name](rawText, lines, fields); if(extra) Object.assign(fields, extra); }
      catch(err){ Logger.warn('field extractor', name, 'failed', err && err.message); }
    }
    return fields;
  }

  /* ---------------- Validator ---------------- */
  function confidenceOf(fields, key){
    switch(key){
      case 'amount': return fields.amount!=null ? (fields.amount>0?'high':'low') : 'low';
      case 'date': return fields.date ? 'high' : 'low';
      case 'merchant': return fields.merchant ? (fields.merchant.length>=3?'med':'low') : 'low';
      case 'mode': return fields.mode && fields.mode!=='Other' ? 'high' : 'med';
      case 'gstin': return fields.gstin ? (GSTIN_RE.test(fields.gstin)?'high':'low') : 'low';
      case 'invoiceNo': return fields.invoiceNo ? 'med' : 'low';
      default: return 'med';
    }
  }
  function validate(fields){
    const warnings = [];
    if(fields.amount==null || fields.amount<=0) warnings.push("Couldn't confidently detect an amount — please enter it manually.");
    if(!fields.date) warnings.push("Couldn't detect a date — defaulted to today.");
    if(!fields.merchant) warnings.push("Couldn't confidently detect a merchant/payee name.");
    if(fields.gstin && !GSTIN_RE.test(fields.gstin)) warnings.push('The detected GSTIN doesn\'t match the standard 15-character format — please double-check it.');
    return { warnings, ok: fields.amount!=null && fields.amount>0 };
  }

  return {
    Scanner: { recognize, terminate, preprocessImage },
    Parser: { parseReceiptText, registerFieldExtractor },
    Validator: { validate, confidenceOf },
    Logger,
    // UI is assembled further down (after it, since it needs DOM elements
    // and app helpers like uid()/saveTransactions() already defined above
    // in this file) and merged into this same App.OCR object there.
  };
})();

App.OCR.UI = (function(){
  const el = id=>document.getElementById(id);
  let currentFields = null;
  let currentRawText = '';
  let draftAutosaveTimer = null;

  function badgeFor(level){
    if(level==='high') return '<span class="ocr-conf-badge ocr-conf-high">High</span>';
    if(level==='med') return '<span class="ocr-conf-badge ocr-conf-med">Med</span>';
    return '<span class="ocr-conf-badge ocr-conf-low-badge">Low</span>';
  }
  function setBadge(id, level){ const n = el(id); if(n) n.innerHTML = badgeFor(level); }

  function populateSelects(){
    const catSel = el('ocr_f_category');
    if(catSel && !catSel.options.length){
      expenseCats().forEach(c=>{ const o=document.createElement('option'); o.value=c; o.textContent=c; catSel.appendChild(o); });
    }
    const acctSel = el('ocr_f_account');
    if(acctSel){
      acctSel.innerHTML = '';
      activeAccounts().forEach(a=>{ const o=document.createElement('option'); o.value=a.id; o.textContent=a.name; acctSel.appendChild(o); });
    }
  }

  function fillModal(fields, rawText){
    populateSelects();
    el('ocr_f_type').value = 'expense';
    el('ocr_f_merchant').value = fields.merchant || '';
    el('ocr_f_amount').value = fields.amount!=null ? fields.amount : '';
    el('ocr_f_currency').value = fields.currency || '₹';
    el('ocr_f_date').value = fields.date || todayStr();
    el('ocr_f_time').value = fields.time || '';
    if(fields.category) el('ocr_f_category').value = fields.category;
    el('ocr_f_mode').value = fields.mode || 'Other';
    if(fields.accountId) el('ocr_f_account').value = fields.accountId;
    el('ocr_f_invoice').value = fields.invoiceNo || '';
    el('ocr_f_gstin').value = fields.gstin || '';
    el('ocr_f_tax').value = fields.tax!=null ? fields.tax : '';
    el('ocr_f_discount').value = fields.discount!=null ? fields.discount : '';
    el('ocr_f_phone').value = fields.phone || '';
    el('ocr_f_address').value = fields.address || '';
    el('ocr_f_items').value = (fields.items||[]).join('\n');
    el('ocr_f_notes').value = '';

    setBadge('ocr_c_merchant', App.OCR.Validator.confidenceOf(fields,'merchant'));
    setBadge('ocr_c_amount', App.OCR.Validator.confidenceOf(fields,'amount'));
    setBadge('ocr_c_date', App.OCR.Validator.confidenceOf(fields,'date'));
    setBadge('ocr_c_mode', App.OCR.Validator.confidenceOf(fields,'mode'));
    setBadge('ocr_c_invoice', App.OCR.Validator.confidenceOf(fields,'invoiceNo'));
    setBadge('ocr_c_gstin', App.OCR.Validator.confidenceOf(fields,'gstin'));

    const { warnings } = App.OCR.Validator.validate(fields);
    const warnBox = el('ocrReviewWarnBox');
    if(warnings.length){ warnBox.innerHTML = warnings.map(w=>'• '+w).join('<br>'); warnBox.classList.remove('hidden'); }
    else warnBox.classList.add('hidden');

    el('ocrRawText').textContent = rawText;
  }

  function readFieldsFromModal(){
    return {
      type: el('ocr_f_type').value,
      merchant: el('ocr_f_merchant').value.trim(),
      amount: parseFloat(el('ocr_f_amount').value)||0,
      currency: el('ocr_f_currency').value.trim()||'₹',
      date: el('ocr_f_date').value || todayStr(),
      time: el('ocr_f_time').value || '',
      category: el('ocr_f_category').value,
      mode: el('ocr_f_mode').value,
      accountId: el('ocr_f_account').value,
      invoiceNo: el('ocr_f_invoice').value.trim(),
      gstin: el('ocr_f_gstin').value.trim(),
      tax: el('ocr_f_tax').value ? parseFloat(el('ocr_f_tax').value) : null,
      discount: el('ocr_f_discount').value ? parseFloat(el('ocr_f_discount').value) : null,
      phone: el('ocr_f_phone').value.trim(),
      address: el('ocr_f_address').value.trim(),
      items: el('ocr_f_items').value.split('\n').map(s=>s.trim()).filter(Boolean),
      notes: el('ocr_f_notes').value.trim()
    };
  }

  function buildNotes(f){
    const parts = [];
    if(f.invoiceNo) parts.push('Invoice #'+f.invoiceNo);
    if(f.gstin) parts.push('GSTIN '+f.gstin);
    if(f.tax) parts.push('Tax '+fmt(f.tax));
    if(f.discount) parts.push('Discount '+fmt(f.discount));
    if(f.phone) parts.push('Ph '+f.phone);
    if(f.address) parts.push(f.address);
    if(f.items && f.items.length) parts.push('Items: '+f.items.join('; '));
    if(f.notes) parts.push(f.notes);
    parts.push('Added via OCR scan');
    return parts.join(' — ');
  }

  function openReview(fields, rawText){
    currentFields = fields;
    currentRawText = rawText;
    fillModal(fields, rawText);
    el('ocrReviewOverlay').classList.remove('hidden');
    scheduleDraftAutosave();
  }
  function closeReview(){
    el('ocrReviewOverlay').classList.add('hidden');
    currentFields = null; currentRawText = '';
    clearTimeout(draftAutosaveTimer);
    try{ App.AutoSave.Recovery.clearOCRDraft(); }catch(e){}
  }

  function scheduleDraftAutosave(){
    clearTimeout(draftAutosaveTimer);
    draftAutosaveTimer = setTimeout(()=>{
      if(el('ocrReviewOverlay').classList.contains('hidden')) return;
      try{ App.AutoSave.Recovery.saveOCRDraft(readFieldsFromModal(), currentRawText); }catch(e){}
    }, 900);
  }

  async function confirmSave(){
    const f = readFieldsFromModal();
    if(!f.amount || f.amount<=0){ alert('Enter a valid amount before saving.'); return; }
    const txn = {
      id: uid(),
      type: f.type,
      date: f.date,
      time: f.time,
      category: f.category || 'Other',
      subcategory: '',
      item: f.merchant || 'Scanned receipt',
      amount: f.amount,
      account: f.accountId || (activeAccounts()[0] && activeAccounts()[0].id) || null,
      mode: f.mode,
      notes: buildNotes(f),
      tags: []
    };
    state.transactions.push(txn);
    await saveTransactions();
    App.OCR.Logger.info('transaction saved from OCR draft', txn.id);
    refreshAllCharts();
    try{ if(document.getElementById('view-transactions')?.classList.contains('active')) renderTransactions(); }catch(e){}
    flash();
    closeReview();
    alert('Saved ✅ — transaction added from scanned receipt.');
  }

  function sendToForm(){
    const f = readFieldsFromModal();
    document.querySelector(`#typeSeg button[data-type="${f.type}"]`)?.click();
    el('f_date').value = f.date;
    el('f_time').value = f.time;
    if(f.category) el('f_category').value = f.category;
    el('f_amount').value = f.amount || '';
    if(f.accountId) el('f_account').value = f.accountId;
    el('f_mode').value = f.mode;
    el('f_item').value = f.merchant || '';
    el('f_notes').value = buildNotes(f);
    document.querySelector('.tab[data-view="entry"]')?.click();
    closeReview();
  }

  async function runScan(file){
    el('ocrProgressWrap').classList.remove('hidden');
    el('ocrProgressLabel').classList.remove('hidden');
    el('ocrProgressBar').style.width = '2%';
    el('ocrProgressLabel').textContent = 'Loading OCR engine…';
    try{
      const { text, confidence } = await App.OCR.Scanner.recognize(file, m=>{
        if(m.status==='recognizing text'){
          const pct = Math.round((m.progress||0)*100);
          el('ocrProgressBar').style.width = pct+'%';
          el('ocrProgressLabel').textContent = 'Reading text… '+pct+'%';
        } else if(m.status){
          el('ocrProgressLabel').textContent = m.status;
        }
      });
      el('ocrProgressBar').style.width = '100%';
      if(!text || !text.trim()){
        alert("Couldn't read any text from that image — try a clearer, well-lit photo.");
        return;
      }
      const fields = App.OCR.Parser.parseReceiptText(text);
      openReview(fields, text);
    }catch(err){
      App.OCR.Logger.error('scan failed', err && err.message);
      alert(err && err.message ? err.message : 'OCR scan failed — please try again.');
    }finally{
      setTimeout(()=>{ el('ocrProgressWrap').classList.add('hidden'); el('ocrProgressLabel').classList.add('hidden'); el('ocrProgressBar').style.width='0%'; }, 600);
    }
  }

  function restoreDraft(draft){
    openReview(draft.fields, draft.rawText||'');
  }

  function bind(){
    el('ocrScanZone').addEventListener('click', ()=>el('ocrScanInput').click());
    el('ocrScanZone').addEventListener('keydown', e=>{ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); el('ocrScanInput').click(); } });
    el('ocrScanInput').addEventListener('change', e=>{
      const file = e.target.files && e.target.files[0];
      e.target.value = '';
      if(file) runScan(file);
    });
    el('ocrReviewClose').addEventListener('click', closeReview);
    el('ocrReviewDiscardBtn').addEventListener('click', closeReview);
    el('ocrReviewOverlay').addEventListener('click', e=>{ if(e.target.id==='ocrReviewOverlay') closeReview(); });
    el('ocrReviewConfirmBtn').addEventListener('click', confirmSave);
    el('ocrReviewEditFormBtn').addEventListener('click', sendToForm);
    el('ocrRawToggle').addEventListener('click', ()=>el('ocrRawText').classList.toggle('hidden'));
    document.querySelectorAll('.ocr-field-grid input, .ocr-field-grid select, .ocr-field-grid textarea').forEach(n=>{
      n.addEventListener('input', scheduleDraftAutosave);
    });
  }

  return { bind, openReview, closeReview, restoreDraft };
})();

/* ==================================================================
   INTELLIGENT AUTO-SAVE ENGINE   (App.AutoSave)   —   v1.0.0 (Sprint 12)
   ==================================================================
   Important context: committed app data (transactions, budgets,
   accounts, goals, debts, tags, etc.) already saves to localStorage
   the instant it changes — every save*() function in this file (see
   "HELPERS" section near the top) has always run with no Save button
   and no debounce. That behavior is unchanged; this engine does not
   re-implement it. What was genuinely missing, and what this engine
   adds, is persistence + recovery for *uncommitted, in-progress* work:
   text the user has typed into the New Transaction form but not yet
   submitted, and an OCR review draft that's still open. Before this
   sprint, closing the tab or refreshing mid-edit silently lost that.

   Submodules:
     App.AutoSave.Queue     a tiny generic debounce/dedupe queue —
                            enqueue(key, fn) coalesces rapid repeated
                            calls for the same key into one write,
                            same idea as the browser "debounce"
                            pattern, so fast typing doesn't hammer
                            localStorage on every keystroke.
     App.AutoSave.Manager   owns the debounce interval, wires the New
                            Transaction form's inputs, and flushes any
                            pending queue entries on 'beforeunload' so
                            nothing in flight is lost.
     App.AutoSave.Sync      after a queue flush, if Drive auto-backup
                            is turned on, asks the existing (already
                            debounced, already-authorized) Drive sync
                            to run — via the same driveMaybeAutoBackup()
                            used everywhere else in the app. This module
                            does not touch Google auth at all; it was
                            already correct (one consent prompt, silent
                            token reuse — see driveEnsureToken()).
     App.AutoSave.Recovery  reads/writes the two draft keys in
                            localStorage (form + OCR draft), and drives
                            the recovery banner shown at the top of the
                            app on load when a draft is found.
================================================================== */
App.AutoSave = (function(){
  const FORM_DRAFT_KEY = 'khaata:autosave:txnform';
  const OCR_DRAFT_KEY = 'khaata:autosave:ocrdraft';
  const DEBOUNCE_MS = 700;

  /* ---------------- Queue ---------------- */
  const timers = {};
  const Queue = {
    enqueue(key, fn, delay){
      clearTimeout(timers[key]);
      timers[key] = setTimeout(()=>{ delete timers[key]; try{ fn(); }catch(e){ App.Logger.error('[AutoSave] queue task failed for', key, e); } }, delay!=null?delay:DEBOUNCE_MS);
    },
    flushAll(){
      Object.keys(timers).forEach(key=>{ clearTimeout(timers[key]); });
      // 'beforeunload' can't reliably wait on async work, so flush is
      // best-effort synchronous localStorage writes only — which is all
      // the draft-saving functions below actually do.
    },
    pendingCount(){ return Object.keys(timers).length; }
  };

  /* ---------------- Sync (bridges to existing Drive backup) --------- */
  const Sync = {
    requestCloudSync(){
      if(typeof driveMaybeAutoBackup==='function'){ try{ driveMaybeAutoBackup(); }catch(e){} }
    }
  };

  /* ---------------- Recovery ---------------- */
  const Recovery = {
    saveFormDraft(values){
      try{ localStorage.setItem(FORM_DRAFT_KEY, JSON.stringify({ values, at: Date.now() })); }catch(e){}
    },
    getFormDraft(){
      try{ const raw = localStorage.getItem(FORM_DRAFT_KEY); return raw ? JSON.parse(raw) : null; }catch(e){ return null; }
    },
    clearFormDraft(){ try{ localStorage.removeItem(FORM_DRAFT_KEY); }catch(e){} },

    saveOCRDraft(fields, rawText){
      try{ localStorage.setItem(OCR_DRAFT_KEY, JSON.stringify({ fields, rawText, at: Date.now() })); }catch(e){}
    },
    getOCRDraft(){
      try{ const raw = localStorage.getItem(OCR_DRAFT_KEY); return raw ? JSON.parse(raw) : null; }catch(e){ return null; }
    },
    clearOCRDraft(){ try{ localStorage.removeItem(OCR_DRAFT_KEY); }catch(e){} },

    hasAnyDraft(){ return !!(this.getFormDraft() || this.getOCRDraft()); },

    showBannerIfNeeded(){
      const formDraft = this.getFormDraft();
      const ocrDraft = this.getOCRDraft();
      if(!formDraft && !ocrDraft) return;
      const banner = document.getElementById('autosaveRecoveryBanner');
      const text = document.getElementById('autosaveRecoveryText');
      if(!banner) return;
      const which = ocrDraft ? 'a scanned receipt review' : 'your New Transaction form';
      const at = new Date((ocrDraft||formDraft).at);
      text.textContent = `You have unsaved work in ${which} from ${at.toLocaleString()}.`;
      banner.classList.remove('hidden');
      const restoreBtn = document.getElementById('autosaveRecoveryRestoreBtn');
      const discardBtn = document.getElementById('autosaveRecoveryDiscardBtn');
      const onRestore = ()=>{
        if(ocrDraft){
          document.querySelector('.tab[data-view="entry"]')?.click();
          App.OCR.UI.restoreDraft(ocrDraft);
        } else if(formDraft){
          document.querySelector('.tab[data-view="entry"]')?.click();
          Object.entries(formDraft.values||{}).forEach(([id,val])=>{ const n=document.getElementById(id); if(n) n.value = val; });
        }
        banner.classList.add('hidden');
        restoreBtn.removeEventListener('click', onRestore);
        discardBtn.removeEventListener('click', onDiscard);
      };
      const onDiscard = ()=>{
        Recovery.clearFormDraft(); Recovery.clearOCRDraft();
        banner.classList.add('hidden');
        restoreBtn.removeEventListener('click', onRestore);
        discardBtn.removeEventListener('click', onDiscard);
      };
      restoreBtn.addEventListener('click', onRestore);
      discardBtn.addEventListener('click', onDiscard);
    }
  };

  /* ---------------- Manager ---------------- */
  const FORM_FIELD_IDS = ['f_date','f_time','f_category','f_subcategory','f_amount','f_account','f_mode','f_tags','f_item','f_notes'];
  const Manager = {
    init(){
      // Wire New Transaction form draft autosave.
      FORM_FIELD_IDS.forEach(id=>{
        const n = document.getElementById(id);
        if(!n) return;
        n.addEventListener('input', ()=>{
          Queue.enqueue('formDraft', ()=>{
            const values = {};
            let hasContent = false;
            FORM_FIELD_IDS.forEach(fid=>{ const fn=document.getElementById(fid); if(fn){ values[fid]=fn.value; if(fn.value) hasContent=true; } });
            if(hasContent) Recovery.saveFormDraft(values);
            else Recovery.clearFormDraft();
          });
        });
      });
      // Clear the form draft the moment a real transaction is saved —
      // the submit handler already exists and is untouched; we just also
      // listen for the same submit event here rather than editing it.
      document.getElementById('txnForm')?.addEventListener('submit', ()=>{
        Recovery.clearFormDraft();
      });
      // Flush any pending debounced draft write before the tab closes.
      window.addEventListener('beforeunload', ()=>{ Queue.flushAll(); });
      // Show recovery banner for anything left over from last session.
      Recovery.showBannerIfNeeded();
    }
  };

  return { Queue, Sync, Recovery, Manager };
})();

/* ===================================================================
   SMART DASHBOARD   (App.Dashboard)   —   v1.0.0   (Sprint 13)
   -------------------------------------------------------------------
   Turns the existing Home tab into a live-updating dashboard. Every
   sub-module below is real, working code — nothing here is a stub.

   App.Dashboard.Config     — thresholds/limits used by the modules below.
   App.Dashboard.Logger     — same thin console-logger pattern as
                               App.Attachments.Logger / App.OCR.Logger.
   App.Dashboard.Cards      — computes the numeric "cards" (today &
                               month income/expense/savings, Cash/Bank/
                               Wallet balances) once per refresh.
   App.Dashboard.Analytics  — offline, rule-based insights generated
                               from the same numbers Cards computed —
                               never re-scans state on its own.
   App.Dashboard.Widgets    — Recent Transactions, Upcoming Bills,
                               Budget Status, Loan Summary, Investment
                               Summary, Goal Progress.
   App.Dashboard.QuickActions — renders quick-add buttons that open the
                               app's existing FAB quick-add sheet
                               (#quickAddOverlay) — this does NOT
                               introduce a second way to add a
                               transaction, it's a shortcut into the
                               one that already exists.
   App.Dashboard.RecentActivity — last AI chat exchange (App.Chat),
                               last OCR scan (App.OCR.Logger.history()),
                               most recently attached file
                               (App.Attachments.Manager), rendered after
                               the synchronous part of the dashboard so
                               a slow IndexedDB read never blocks it.
   App.Dashboard.Charts     — intentionally thin: delegates to the
                               dashboard's existing Chart.js code
                               (refreshAllCharts / renderDashboardDetails)
                               rather than building a second charting
                               path, so there's exactly one place that
                               owns Chart.js instances for this tab.
   App.Dashboard.Manager    — orchestrates the above + the auto-update
                               engine (below).

   AUTO-UPDATE ENGINE
   -------------------------------------------------------------------
   Wraps the app's existing save*() functions (saveTransactions,
   saveAccounts, saveBudgets, saveGoals, saveDebts, saveCreditCards,
   saveInvestments, saveRecurring, saveSubcats, saveCustomCats,
   saveNetWorthHistory) exactly once, here, instead of editing each of
   their ~40 call sites across the file. Every wrapped function still
   does precisely what it did before and returns the same thing — this
   only adds a call to App.Dashboard.Manager.scheduleRefresh() after it
   resolves. That means: add / edit / delete / duplicate / undo a
   transaction, import a CSV, restore a JSON backup, or "Clear All"
   data — the dashboard picks it up automatically, no refresh needed.

   PERFORMANCE NOTES (scoped honestly — see the Sprint 13 build-log
   entry at the top of this file for what was and wasn't touched):
   - scheduleRefresh() is debounced and batched on requestAnimationFrame,
     so a burst of saves (e.g. importing 200 CSV rows) triggers one
     dashboard render, not 200.
   - The render is skipped entirely unless the Home tab is the one
     currently visible (checked via #view-dashboard.classList — the
     same check switchToView() already uses). Editing a budget while
     sitting on the Budgets tab does not pay any dashboard-render cost.
   - Cards.compute() is called once per refresh and its result is
     handed to Widgets/Analytics, instead of each of them re-deriving
     today's/this month's totals from state.transactions independently.
=================================================================== */
App.Dashboard.Config = {
  RECENT_TXN_COUNT: 5,
  UPCOMING_BILLS_DAYS: 14,
  BUDGET_WARN_PCT: 80,
  LOW_CASH_THRESHOLD: 500,      // below this, the "cash balance is low" insight fires
  GOAL_PROGRESS_COUNT: 3,
  REFRESH_DEBOUNCE_MS: 250
};

App.Dashboard.Logger = {
  info: (...a)=>App.Logger.info('[Dashboard]', ...a),
  warn: (...a)=>App.Logger.warn('[Dashboard]', ...a),
  error: (...a)=>App.Logger.error('[Dashboard]', ...a)
};

/* ---------------- Cards ---------------- */
App.Dashboard.Cards = (function(){
  function compute(){
    const Cfg = App.Dashboard.Config;
    const inc = incomeTxns(), exp = expenseTxns();
    const today = todayStr();
    const from = startOfMonth(0), to = endOfMonth(0);
    const lastFrom = startOfMonth(-1), lastTo = endOfMonth(-1);

    const todayIncome = sum(inc.filter(t=>t.date===today));
    const todayExpense = sum(exp.filter(t=>t.date===today));
    const monthIncome = sum(inc.filter(t=>dateInRange(t.date,from,to)));
    const monthExpense = sum(exp.filter(t=>dateInRange(t.date,from,to)));
    const lastMonthIncome = sum(inc.filter(t=>dateInRange(t.date,lastFrom,lastTo)));
    const lastMonthExpense = sum(exp.filter(t=>dateInRange(t.date,lastFrom,lastTo)));

    let cashBalance=0, bankBalance=0, walletBalance=0, otherBalance=0;
    activeAccounts().forEach(a=>{
      const bal = accountBalance(a.id);
      if(a.type==='Cash') cashBalance += bal;
      else if(a.type==='Bank Account' || a.type==='Savings Account') bankBalance += bal;
      else if(a.type==='UPI') walletBalance += bal;
      else otherBalance += bal;
    });

    // category totals this week / last week (for the food-spend insight)
    const weekFrom = (()=>{ const d=new Date(); d.setDate(d.getDate()-6); return d.toISOString().slice(0,10); })();
    const prevWeekFrom = (()=>{ const d=new Date(); d.setDate(d.getDate()-13); return d.toISOString().slice(0,10); })();
    const prevWeekTo = (()=>{ const d=new Date(); d.setDate(d.getDate()-7); return d.toISOString().slice(0,10); })();
    const byCatThisMonth = {};
    exp.filter(t=>dateInRange(t.date,from,to)).forEach(t=>{ byCatThisMonth[t.category]=(byCatThisMonth[t.category]||0)+Number(t.amount||0); });
    let topCat=null, topCatAmt=0;
    Object.entries(byCatThisMonth).forEach(([c,a])=>{ if(a>topCatAmt){ topCat=c; topCatAmt=a; } });

    return {
      today, from, to, lastFrom, lastTo, weekFrom, prevWeekFrom, prevWeekTo,
      todayIncome, todayExpense, todayBalance: todayIncome-todayExpense,
      monthIncome, monthExpense, monthSavings: monthIncome-monthExpense,
      lastMonthIncome, lastMonthExpense, lastMonthSavings: lastMonthIncome-lastMonthExpense,
      cashBalance, bankBalance, walletBalance, otherBalance,
      totalBalance: totalMoney(),
      topCat, topCatAmt,
      foodThisWeek: sum(exp.filter(t=>t.category==='Food' && dateInRange(t.date,weekFrom,today))),
      foodPrevWeek: sum(exp.filter(t=>t.category==='Food' && dateInRange(t.date,prevWeekFrom,prevWeekTo)))
    };
  }
  return { compute };
})();

/* ---------------- Analytics (offline AI insights) ---------------- */
App.Dashboard.Analytics = (function(){
  function generate(cards){
    const Cfg = App.Dashboard.Config;
    const out = [];

    if(cards.foodPrevWeek>0){
      const diffPct = ((cards.foodThisWeek-cards.foodPrevWeek)/cards.foodPrevWeek)*100;
      if(Math.abs(diffPct)>=10){
        out.push({ dot: diffPct>0?'warn':'good', text: `Your food expenses ${diffPct>0?'increased':'decreased'} by ${Math.abs(diffPct).toFixed(0)}% this week compared to last week.` });
      }
    } else if(cards.foodThisWeek>0){
      out.push({ dot:'info', text:`You've spent ${fmt(cards.foodThisWeek)} on Food this week.` });
    }

    if(cards.lastMonthIncome>0 || cards.lastMonthExpense>0){
      if(cards.monthSavings>cards.lastMonthSavings){
        out.push({ dot:'good', text:`You've saved more than last month so far — ${fmt(cards.monthSavings)} vs ${fmt(cards.lastMonthSavings)}.` });
      } else if(cards.monthSavings<cards.lastMonthSavings){
        out.push({ dot:'warn', text:`You've saved less than last month so far — ${fmt(cards.monthSavings)} vs ${fmt(cards.lastMonthSavings)}.` });
      }
    }

    if(cards.topCat){
      out.push({ dot:'info', text:`You've spent the most on ${cards.topCat} this month (${fmt(cards.topCatAmt)}).` });
    }

    if(cards.cashBalance < Cfg.LOW_CASH_THRESHOLD){
      out.push({ dot:'bad', text:`Your cash balance is low (${fmt(cards.cashBalance)}).` });
    }

    // budgets close to / over their limit this month
    const from = cards.from, to = cards.to;
    Object.keys(state.budgets||{}).forEach(cat=>{
      const budget = Number(state.budgets[cat])||0;
      if(budget<=0) return;
      const actual = sum(expenseTxns().filter(t=>t.category===cat && dateInRange(t.date,from,to)));
      const pct = actual/budget*100;
      if(pct>=100){ out.push({ dot:'bad', text:`Your ${cat} budget is exhausted — ${fmt(actual)} spent of ${fmt(budget)}.` }); }
      else if(pct>=Cfg.BUDGET_WARN_PCT){ out.push({ dot:'warn', text:`Your ${cat} budget is almost exhausted — ${pct.toFixed(0)}% used.` }); }
    });

    if(!out.length){ out.push({ dot:'info', text:'Nothing unusual to flag yet — keep logging transactions for sharper insights.' }); }
    return out.slice(0,6);
  }
  return { generate };
})();

/* ---------------- Widgets ---------------- */
App.Dashboard.Widgets = (function(){
  function recentTransactionsHtml(){
    const Cfg = App.Dashboard.Config;
    const list = [...state.transactions].sort((a,b)=> (b.date+((b.time)||'')).localeCompare(a.date+((a.time)||''))).slice(0,Cfg.RECENT_TXN_COUNT);
    if(!list.length) return '<div class="empty-note">No transactions yet.</div>';
    return '<div class="widget-list">'+list.map(t=>{
      if(t.type==='transfer'){
        const info = txnDisplayLine(t);
        return `<div class="widget-row"><span class="wr-label">${escapeHtml(info.label)} · ${t.date}</span><span class="wr-val">${fmt(t.amount)}</span></div>`;
      }
      const info = txnDisplayLine(t);
      return `<div class="widget-row"><span class="wr-label">${escapeHtml(t.item||t.category)} · ${t.date}</span><span class="wr-val ${info.amtClass}">${info.prefix}${fmt(t.amount)}</span></div>`;
    }).join('')+'</div>';
  }

  function upcomingBillsHtml(){
    const Cfg = App.Dashboard.Config;
    const to = (()=>{ const d=new Date(); d.setDate(d.getDate()+Cfg.UPCOMING_BILLS_DAYS); return d.toISOString().slice(0,10); })();
    const due = dueRecurringInRange(todayStr(), to).sort((a,b)=>a.nextDate.localeCompare(b.nextDate));
    if(!due.length) return `<div class="empty-note">Nothing due in the next ${Cfg.UPCOMING_BILLS_DAYS} days.</div>`;
    return '<div class="widget-list">'+due.map(r=>`<div class="widget-row"><span class="wr-label">${escapeHtml(r.name)} · ${r.nextDate}</span><span class="wr-val">${fmt(r.amount)}</span></div>`).join('')+'</div>';
  }

  function budgetStatusHtml(cards){
    const cats = Object.keys(state.budgets||{});
    if(!cats.length) return '<div class="empty-note">No budgets set yet.</div>';
    const rows = cats.map(c=>{
      const budget = Number(state.budgets[c])||0;
      const actual = sum(expenseTxns().filter(t=>t.category===c && dateInRange(t.date,cards.from,cards.to)));
      const pct = budget>0 ? Math.min(100, actual/budget*100) : 0;
      return { c, budget, actual, pct, over: actual>budget };
    }).sort((a,b)=>b.pct-a.pct).slice(0,4);
    return rows.map(r=>`<div class="budget-row">
      <div class="budget-top"><span class="budget-cat">${escapeHtml(r.c)}</span><span class="budget-figs">${fmt(r.actual)} / ${fmt(r.budget)}</span></div>
      <div class="bar-track"><div class="bar-fill ${r.over?'over':r.pct>=App.Dashboard.Config.BUDGET_WARN_PCT?'warn':''}" style="width:${r.pct}%;"></div></div>
    </div>`).join('');
  }

  function loanSummaryHtml(){
    const debts = state.debts||[];
    if(!debts.length) return '<div class="empty-note">No debts or loans recorded.</div>';
    const owedToMe = debts.filter(d=>d.type==='owed_to_me' && !d.settled);
    const iOwe = debts.filter(d=>d.type==='i_owe' && !d.settled);
    const owedToMeTotal = owedToMe.reduce((s,d)=>s+debtRemaining(d),0);
    const iOweTotal = iOwe.reduce((s,d)=>s+debtRemaining(d),0);
    return `<div class="widget-list">
      <div class="widget-row"><span class="wr-label">Owed to me</span><span class="wr-val amt-in">${fmt(owedToMeTotal)}</span></div>
      <div class="widget-row"><span class="wr-label">I owe</span><span class="wr-val amt-ex">${fmt(iOweTotal)}</span></div>
      <div class="widget-row"><span class="wr-label">Net position</span><span class="wr-val">${fmt(owedToMeTotal-iOweTotal)}</span></div>
    </div>`;
  }

  function investmentSummaryHtml(){
    const inv = state.investments||[];
    if(!inv.length) return '<div class="empty-note">No investments recorded.</div>';
    const invested = inv.reduce((s,i)=>s+(Number(i.invested)||0),0);
    const current = inv.reduce((s,i)=>s+(Number(i.currentValue)||0),0);
    const pl = current-invested;
    const plPct = invested? (pl/invested*100) : 0;
    return `<div class="widget-list">
      <div class="widget-row"><span class="wr-label">Invested</span><span class="wr-val">${fmt(invested)}</span></div>
      <div class="widget-row"><span class="wr-label">Current Value</span><span class="wr-val">${fmt(current)}</span></div>
      <div class="widget-row"><span class="wr-label">P/L</span><span class="wr-val ${pl>=0?'amt-in':'amt-ex'}">${pl>=0?'+':''}${fmt(pl)} (${plPct.toFixed(1)}%)</span></div>
    </div>`;
  }

  function goalProgressHtml(){
    const Cfg = App.Dashboard.Config;
    const active = (state.goals||[]).filter(g=>!g.achieved).sort((a,b)=>(a.priority||0)-(b.priority||0)).slice(0,Cfg.GOAL_PROGRESS_COUNT);
    if(!active.length) return '<div class="empty-note">No active goals.</div>';
    return '<div class="widget-list">'+active.map(g=>{
      const saved = sum(g.contributions||[]);
      const pct = g.cost? Math.min(100, saved/g.cost*100) : 0;
      return `<div class="budget-row">
        <div class="budget-top"><span class="budget-cat">${escapeHtml(g.name)}</span><span class="budget-figs">${fmt(saved)} / ${fmt(g.cost)}</span></div>
        <div class="bar-track"><div class="bar-fill" style="width:${pct}%;"></div></div>
      </div>`;
    }).join('')+'</div>';
  }

  function renderAll(cards){
    const grid = document.getElementById('dashWidgetGrid');
    if(!grid) return;
    grid.innerHTML = `
      <div class="widget-box"><h4>Recent Transactions</h4>${recentTransactionsHtml()}</div>
      <div class="widget-box"><h4>Upcoming Bills</h4>${upcomingBillsHtml()}</div>
      <div class="widget-box"><h4>Budget Status</h4>${budgetStatusHtml(cards)}</div>
      <div class="widget-box"><h4>Loan Summary</h4>${loanSummaryHtml()}</div>
      <div class="widget-box"><h4>Investment Summary</h4>${investmentSummaryHtml()}</div>
      <div class="widget-box"><h4>Goal Progress</h4>${goalProgressHtml()}</div>
    `;
  }
  return { renderAll, recentTransactionsHtml, upcomingBillsHtml, budgetStatusHtml, loanSummaryHtml, investmentSummaryHtml, goalProgressHtml };
})();

/* ---------------- Quick Actions ---------------- */
App.Dashboard.QuickActions = (function(){
  function openQuickAdd(type){
    const seg = document.querySelector(`#qaTypeSeg button[data-type="${type}"]`);
    if(seg) seg.click();
    openQuickAddOverlay();
  }
  function render(){
    const el = document.getElementById('dashQuickActions');
    if(!el) return;
    el.innerHTML = `
      <button type="button" data-act="expense"><span class="qi-ic">➖</span>Add Expense</button>
      <button type="button" data-act="income"><span class="qi-ic">➕</span>Add Income</button>
      <button type="button" data-act="transfer"><span class="qi-ic">🔁</span>Transfer</button>
      <button type="button" data-act="scan"><span class="qi-ic">📷</span>Scan Receipt</button>
      <button type="button" data-act="chat"><span class="qi-ic">💬</span>Ask AI</button>
    `;
    el.querySelectorAll('button[data-act]').forEach(b=>b.addEventListener('click', ()=>{
      const act = b.dataset.act;
      if(act==='expense'||act==='income'||act==='transfer') openQuickAdd(act);
      else if(act==='scan'){ switchToView('entry'); setTimeout(()=>document.getElementById('ocrScanZone')?.focus(),150); }
      else if(act==='chat'){ if(window.App && App.Chat) App.Chat.open(); }
    }));
  }
  return { render, openQuickAdd };
})();

/* ---------------- Recent Activity ---------------- */
App.Dashboard.RecentActivity = (function(){
  async function render(){
    const el = document.getElementById('dashActivityList');
    if(!el) return;
    const items = [];

    // Last AI conversation exchange (App.Chat)
    try{
      if(window.App && App.Chat && typeof App.Chat.getRecentLog==='function'){
        const msgs = App.Chat.getRecentLog(1);
        if(msgs.length){
          const m = msgs[msgs.length-1];
          items.push({ ic:'💬', text: `${m.role==='ai'?'Khaata AI':'You'}: ${escapeHtml((m.text||'').slice(0,90))}`, at: m.ts });
        }
      }
    }catch(e){ App.Dashboard.Logger.warn('chat activity read failed', e); }

    // Last OCR scan (App.OCR.Logger ring buffer)
    try{
      if(window.App && App.OCR && App.OCR.Logger && typeof App.OCR.Logger.history==='function'){
        const hist = App.OCR.Logger.history().filter(h=>h.level==='info').slice(-1);
        if(hist.length) items.push({ ic:'🧾', text: escapeHtml(hist[0].msg), at: hist[0].at });
      }
    }catch(e){ App.Dashboard.Logger.warn('OCR activity read failed', e); }

    // Most recent attachment on the most recent transactions (best-effort,
    // async — never blocks the synchronous dashboard render above it)
    try{
      if(window.App && App.Attachments){
        const recentIds = [...state.transactions].sort((a,b)=>(b.date||'').localeCompare(a.date||'')).slice(0,5).map(t=>t.id);
        for(const id of recentIds){
          const recs = await App.Attachments.Manager.list(id);
          if(recs && recs.length){
            items.push({ ic:'📎', text: `${escapeHtml(recs[0].fileName)} attached`, at: recs[0].createdDate });
            break;
          }
        }
      }
    }catch(e){ App.Dashboard.Logger.warn('attachment activity read failed', e); }

    if(!items.length){ el.innerHTML = '<div class="empty-note">No recent AI, OCR or attachment activity yet.</div>'; return; }
    el.innerHTML = items.map(it=>`<div class="activity-item"><span class="activity-ic">${it.ic}</span><div class="activity-body"><p>${it.text}</p>${it.at?`<div class="activity-meta">${new Date(it.at).toLocaleString()}</div>`:''}</div></div>`).join('');
  }
  return { render };
})();

/* ---------------- Charts (thin delegate — see module doc above) ------- */
App.Dashboard.Charts = {
  refresh(){ if(!document.getElementById('dashDetailsPanel').classList.contains('hidden')) renderDashboardDetails(); }
};

/* ---------------- Manager (orchestration + auto-update engine) -------- */
App.Dashboard.Manager = (function(){
  let rafScheduled = false;
  let dirty = true; // renders once on first activation even with no prior save

  function isDashboardActive(){
    const v = document.getElementById('view-dashboard');
    return !!(v && v.classList.contains('active'));
  }

  function renderNow(){
    const root = document.getElementById('smartDashboardRoot');
    if(!root) return;
    if(!root.dataset.built){
      root.innerHTML = `
        <div class="dash-section">
          <div class="dash-quickgrid" id="dashQuickActions"></div>
        </div>
        <div class="dash-section card">
          <div class="card-head"><div class="card-title">AI Insights</div><span class="card-note">Offline · from your own data</span></div>
          <div id="dashInsightsList"></div>
        </div>
        <div class="dash-section widget-grid" id="dashWidgetGrid"></div>
        <div class="dash-section card">
          <div class="card-head"><div class="card-title">Recent Activity</div><span class="card-note">AI chat · OCR scans · attachments</span></div>
          <div id="dashActivityList"></div>
        </div>
      `;
      root.dataset.built = '1';
      App.Dashboard.QuickActions.render();
    }

    const cards = App.Dashboard.Cards.compute();
    const insights = App.Dashboard.Analytics.generate(cards);
    const insightsEl = document.getElementById('dashInsightsList');
    if(insightsEl){
      insightsEl.innerHTML = insights.map(i=>`<div class="insight"><span class="dot ${i.dot}"></span><p>${i.text}</p></div>`).join('');
    }
    App.Dashboard.Widgets.renderAll(cards);
    // best-effort async — never awaited here, never blocks the render above
    App.Dashboard.RecentActivity.render().catch(err=>App.Dashboard.Logger.error('RecentActivity render failed', err));
    dirty = false;
  }

  /* Debounced + rAF-batched: several saves in the same tick collapse into
     one render, and nothing happens at all unless the Home tab is visible. */
  const debouncedTrigger = debounce(()=>{
    dirty = true;
    if(!isDashboardActive()) return; // stay dirty; renders on next tab activation
    if(rafScheduled) return;
    rafScheduled = true;
    requestAnimationFrame(()=>{ rafScheduled=false; renderNow(); });
  }, App.Dashboard.Config.REFRESH_DEBOUNCE_MS);

  function scheduleRefresh(){ debouncedTrigger(); }

  /* Called by switchToView('dashboard') via the renderDashboard() wrap
     below — guarantees a fresh render the moment the user looks at the
     Home tab, even if scheduleRefresh() skipped rendering while they
     were elsewhere. */
  function renderIfNeeded(){
    if(dirty) renderNow();
  }

  function init(){
    // Wrap the app's existing save*() functions exactly once. Each
    // wrapped function still runs the original body and returns the
    // original result — this only adds the auto-update hook after it.
    const SAVE_FNS = [
      'saveTransactions','saveAccounts','saveBudgets','saveGoals','saveDebts',
      'saveCreditCards','saveInvestments','saveRecurring','saveSubcats',
      'saveCustomCats','saveNetWorthHistory','saveCCUtilHistory'
    ];
    SAVE_FNS.forEach(name=>{
      const orig = window[name];
      if(typeof orig !== 'function') return;
      const wrapped = async function(...args){
        const result = await orig.apply(this, args);
        scheduleRefresh();
        return result;
      };
      window[name] = wrapped;
      if(App.Storage[name]) App.Storage[name] = wrapped;
    });
    App.Dashboard.Logger.info('auto-update engine wired to', SAVE_FNS.length, 'save functions');
  }

  return { init, scheduleRefresh, renderNow, renderIfNeeded, isDashboardActive };
})();

/* Wrap the existing renderDashboard() so the Home tab (whether entered
   via the top tabs or bottom nav — both funnel through switchToView() →
   renderView() → renderDashboard()) always shows a fresh Smart Dashboard,
   without editing switchToView()/renderView() themselves. renderDashboard
   itself still does exactly what it did before (hero + optional details
   panel) — this only adds one call after it. */
(function(){
  const origRenderDashboard = renderDashboard;
  renderDashboard = function(){
    origRenderDashboard();
    App.Dashboard.Manager.renderIfNeeded();
  };
})();

/* ===================================================================
   HOME SCREEN VISUAL REDESIGN   (Sprint 26)
   -------------------------------------------------------------------
   Purely additive, Home-tab-scoped. Renders a new #khHome subtree that
   matches the reference "Khaata AI" look (dark bg, purple/cyan accent,
   gradient hero card + sparkline, quick actions, recent transactions,
   circular budget ring, top goal, and an AI-insight banner). Every
   figure below is computed live from state/helpers the rest of the
   app already relies on — incomeTxns/expenseTxns/sum/fmt/txnIcon/
   txnGroupLabel/txnDisplayLine/App.Dashboard.Cards/App.Dashboard.
   Analytics/state.budgets/state.goals — nothing here is sample data.

   Refresh strategy: hooks onto App.Dashboard.Widgets.renderAll (the
   function App.Dashboard.Manager.renderNow() already calls on every
   dashboard build — first paint, tab switch, and every save while the
   Home tab is visible), so #khHome always updates on the exact same
   schedule as the rest of the Smart Dashboard, with zero changes to
   Manager/Widgets/Cards/Analytics themselves.
=================================================================== */
let khBalanceHidden = false;

function khGreetingText(){
  const h = new Date().getHours();
  if(h<5) return 'Good night';
  if(h<12) return 'Good morning';
  if(h<17) return 'Good afternoon';
  return 'Good evening';
}

/* Real, derived daily balance trail: walks backward from today's actual
   totalMoney() by each day's real income-expense net, so the sparkline
   reflects this account's real recent history — no synthetic data. */
function khBalanceSparklinePoints(days){
  days = days || 14;
  const dailyNet = {};
  (state.transactions||[]).forEach(t=>{
    if(t.type==='income') dailyNet[t.date]=(dailyNet[t.date]||0)+Number(t.amount||0);
    else if(t.type==='expense') dailyNet[t.date]=(dailyNet[t.date]||0)-Number(t.amount||0);
  });
  const out = [];
  let bal = totalMoney();
  const d = new Date();
  for(let i=0;i<days;i++){
    const ds = d.toISOString().slice(0,10);
    out.unshift(bal);
    bal -= (dailyNet[ds]||0);
    d.setDate(d.getDate()-1);
  }
  return out;
}
function khSparklineSvg(points){
  if(!points || points.length<2) return '';
  const w=112,h=46;
  const min=Math.min(...points), max=Math.max(...points);
  const range=(max-min)||1;
  const stepX=w/(points.length-1);
  const coords = points.map((p,i)=>[i*stepX, h-((p-min)/range)*h]);
  const path = coords.map((c,i)=>(i===0?'M':'L')+c[0].toFixed(1)+','+c[1].toFixed(1)).join(' ');
  const area = path+` L${w},${h} L0,${h} Z`;
  const last = coords[coords.length-1];
  return `<svg viewBox="0 0 ${w} ${h}" class="kh-spark" preserveAspectRatio="none">
    <defs><linearGradient id="khSparkGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#fff" stop-opacity="0.45"/><stop offset="100%" stop-color="#fff" stop-opacity="0"/>
    </linearGradient></defs>
    <line x1="0" y1="${h-1}" x2="${w}" y2="${h-1}" stroke="rgba(255,255,255,.25)" stroke-width="1" stroke-dasharray="2 3"/>
    <path d="${area}" fill="url(#khSparkGrad)" stroke="none"/>
    <path d="${path}" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="filter:drop-shadow(0 0 4px rgba(255,255,255,.65));"/>
    <circle cx="${last[0].toFixed(1)}" cy="${last[1].toFixed(1)}" r="3.2" fill="#fff" style="filter:drop-shadow(0 0 5px rgba(255,255,255,.9));"/>
  </svg>`;
}
function khRingSvg(pct){
  const p = Math.max(0, Math.min(100, pct));
  const r = 30, c = 2*Math.PI*r;
  const dash = (p/100)*c;
  return `<svg width="78" height="78" viewBox="0 0 76 76">
    <defs><linearGradient id="khRingGrad" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="var(--kh-purple)"/><stop offset="100%" stop-color="var(--kh-cyan)"/></linearGradient></defs>
    <circle cx="38" cy="38" r="${r}" fill="none" stroke="var(--kh-card-line)" stroke-width="7"/>
    <circle cx="38" cy="38" r="${r}" fill="none" stroke="${pct>=100?'var(--kh-red)':'url(#khRingGrad)'}" stroke-width="7" stroke-linecap="round" stroke-dasharray="${dash.toFixed(1)} ${c.toFixed(1)}" transform="rotate(-90 38 38)" style="filter:drop-shadow(0 0 6px rgba(124,58,237,.6));"/>
    <text x="38" y="43" text-anchor="middle" font-size="15" font-weight="700" fill="var(--kh-text)" font-family="var(--font-mono)">${Math.round(pct)}%</text>
  </svg>`;
}
function khPctDelta(cur, prev){
  if(!prev) return null;
  return ((cur-prev)/Math.abs(prev))*100;
}
/* Sprint 27 — visual-only helpers: split a real fmt() amount into a
   whole part + small decimal part for the hero balance display, and
   turn a real insight's existing dot classification (good/warn/bad/
   info) into a short headline. Neither invents any figure — both are
   pure presentation derived from data the app already computed. */
function khFmtSplit(n){
  const v = Number(n)||0;
  const neg = v<0;
  const abs = Math.abs(v);
  const whole = Math.trunc(abs);
  const dec = Math.round((abs-whole)*100).toString().padStart(2,'0');
  return { sign: neg?'-':'', whole:'₹'+whole.toLocaleString('en-IN'), dec };
}
function khInsightHeadline(dot){
  if(dot==='good') return 'Great job! 🎉';
  if(dot==='bad') return 'Heads up ⚠️';
  if(dot==='warn') return 'Worth a look 👀';
  return "Here's a tip 💡";
}

function renderKhaataHomeV2(cards){
  const root = document.getElementById('khHome');
  if(!root) return;
  try{
    const total = cards.totalBalance;
    const startOfMonthTotal = total - cards.monthSavings;
    const balPct = startOfMonthTotal!==0 ? (cards.monthSavings/Math.abs(startOfMonthTotal))*100 : (cards.monthSavings>0?100:0);
    const incPct = khPctDelta(cards.monthIncome, cards.lastMonthIncome);
    const expPct = khPctDelta(cards.monthExpense, cards.lastMonthExpense);
    const savPct = khPctDelta(cards.monthSavings, cards.lastMonthSavings);
    /* Sprint 28 — hero pill prefers a real month-over-month comparison
       (same savPct already used in the stats row) so the "vs last
       month" caption is literally true; if there's no prior-month data
       yet it falls back to the existing start-of-month figure with an
       accurate caption instead of mislabeling it. */
    const heroPct = savPct!=null ? savPct : balPct;
    const heroCaption = savPct!=null ? 'vs last month' : 'vs start of month';
    const balSplit = khFmtSplit(total);
    const balanceDisplay = khBalanceHidden ? '••••••' : `${balSplit.sign}${balSplit.whole}<span class="kh-decimal">.${balSplit.dec}</span>`;

    const recent = [...state.transactions].sort((a,b)=>(b.date+(b.time||'')).localeCompare(a.date+(a.time||''))).slice(0,4);
    const txnHtml = recent.length ? recent.map(t=>{
      const iconInfo = txnIcon(t);
      const info = txnDisplayLine(t);
      const name = t.type==='transfer' ? info.label : (t.item||t.category);
      const subCat = t.type==='transfer' ? 'Transfer' : (t.category||(t.type==='income'?'Income':'Other'));
      const dateLabel = txnGroupLabel(t.date);
      const amtClass = t.type==='income' ? 'in' : (t.type==='expense' ? 'ex' : '');
      const prefix = t.type==='income' ? '+' : (t.type==='expense' ? '-' : '');
      return `<div class="kh2-txn-row">
        <div class="kh2-txn-ic" style="background:${iconInfo.bg};color:${iconInfo.col};">${iconInfo.ic}</div>
        <div class="kh2-txn-body"><div class="kh2-txn-name">${escapeHtml(name)}</div><div class="kh2-txn-sub">${escapeHtml(subCat)}</div></div>
        <div class="kh2-txn-right"><span class="kh2-txn-amt ${amtClass}">${prefix}${fmt(t.amount)}</span><span class="kh2-txn-date">${escapeHtml(dateLabel)}</span></div>
      </div>`;
    }).join('') : '<div class="kh2-empty">No transactions yet — add your first one above.</div>';

    const budgetCats = Object.keys(state.budgets||{}).filter(c=>Number(state.budgets[c])>0);
    let budgetHtml;
    if(budgetCats.length){
      const totalBudget = budgetCats.reduce((s,c)=>s+Number(state.budgets[c]),0);
      const totalSpent = sum(expenseTxns().filter(t=>budgetCats.includes(t.category) && dateInRange(t.date,cards.from,cards.to)));
      const pct = totalBudget>0 ? (totalSpent/totalBudget*100) : 0;
      const left = totalBudget-totalSpent;
      budgetHtml = `<div class="kh2-budget-row">
          <div class="kh2-ring">${khRingSvg(pct)}<div class="kh2-ring-sub">of ${fmt(totalBudget)}<br>spent</div></div>
          <div class="kh2-budget-info">
            <div class="kh2-budget-figs-row"><span class="kh2-budget-name">Monthly Budget</span><span class="kh2-budget-figs">${fmt(totalSpent)} / ${fmt(totalBudget)}</span></div>
            <div class="kh2-bar-track"><div class="kh2-bar-fill ${pct>=100?'over':''}" style="width:${Math.min(100,pct)}%;"></div></div>
          </div>
        </div>
        <div class="kh2-budget-left">${left>=0? fmt(left)+' left' : fmt(Math.abs(left))+' over budget'}</div>`;
    } else {
      budgetHtml = '<div class="kh2-empty">No budgets set yet — set one up in the Budgets tab.</div>';
    }

    const activeGoals = (state.goals||[]).filter(g=>!g.achieved).sort((a,b)=>(a.priority||0)-(b.priority||0));
    let goalsHtml;
    if(activeGoals.length){
      const g = activeGoals[0];
      const saved = sum(g.contributions||[]);
      const pct = g.cost? Math.min(100, saved/g.cost*100) : 0;
      const icon = (window.App && App.Goals && App.Goals.Config && App.Goals.Config.TYPE_ICONS && App.Goals.Config.TYPE_ICONS[g.category]) || '🎯';
      goalsHtml = `<div class="kh2-goal-row">
        <div class="kh2-goal-ic">${icon}</div>
        <div class="kh2-goal-body">
          <div class="kh2-goal-name">${escapeHtml(g.name)}</div>
          <div class="kh2-goal-figs">${fmt(saved)} / ${fmt(g.cost)}</div>
          <div class="kh2-bar-track"><div class="kh2-bar-fill" style="width:${pct}%;"></div></div>
          ${g.targetDate ? `<div class="kh2-goal-target">Target: ${escapeHtml(g.targetDate)}</div>` : ''}
        </div>
        <div class="kh2-goal-pct">${Math.round(pct)}%</div>
      </div>`;
    } else {
      goalsHtml = '<div class="kh2-empty">No active goals yet — create one in the Goals tab.</div>';
    }

    let insightText = 'Nothing unusual to flag yet — keep logging transactions for sharper insights.', insightDot = 'info';
    try{
      const insights = App.Dashboard.Analytics.generate(cards);
      if(insights && insights.length){ insightText = insights[0].text; insightDot = insights[0].dot; }
    }catch(e){ App.Dashboard.Logger.warn('khHome insight read failed', e); }
    const notifDot = document.getElementById('khNotifDot');
    if(notifDot) notifDot.classList.toggle('show', insightDot==='warn' || insightDot==='bad');
    const insightHeadline = khInsightHeadline(insightDot);

    root.innerHTML = `
      <div class="kh2-home">
        <div class="kh2-topline">
          <div>
            <div class="kh2-greet-name">${khGreetingText()} 👋</div>
            <div class="kh2-greet-sub">Here's your financial overview</div>
          </div>
        </div>

        <div class="kh2-hero">
          <div class="kh2-hero-main">
            <div class="kh2-particles"><span></span><span></span><span></span><span></span><span></span></div>
            <div class="kh2-hero-top">
              <div class="kh2-hero-label"><span class="kh2-hero-ic">💼</span> Total Balance</div>
              <button type="button" class="kh2-eye" data-kh-action="toggle-balance" title="Show/hide balance">${khBalanceHidden?'🙈':'👁️'}</button>
            </div>
            <div class="kh2-hero-amt">${balanceDisplay}</div>
            <div class="kh2-hero-row">
              <div class="kh2-hero-pillwrap">
                <span class="kh2-hero-pill ${heroPct<0?'down':''}">${heroPct>=0?'↑':'↓'} ${Math.abs(heroPct).toFixed(1)}%</span>
                <span class="kh2-hero-sub">${heroCaption}</span>
              </div>
              ${khSparklineSvg(khBalanceSparklinePoints(14)).replace('class="kh-spark"','class="kh-spark kh2-hero-spark"')}
            </div>
          </div>
          <div class="kh2-hero-strip">
            <div class="kh2-hero-cell"><div class="kh2-hero-cell-top"><span class="kh2-hero-cell-dot in"></span>Income</div><div class="kh2-hero-cell-val">${fmt(cards.monthIncome)}</div>${incPct!=null?`<div class="kh2-hero-cell-delta ${incPct>=0?'up':'down'}">${incPct>=0?'↑':'↓'} ${Math.abs(incPct).toFixed(0)}%</div>`:''}</div>
            <div class="kh2-hero-cell"><div class="kh2-hero-cell-top"><span class="kh2-hero-cell-dot ex"></span>Expenses</div><div class="kh2-hero-cell-val">${fmt(cards.monthExpense)}</div>${expPct!=null?`<div class="kh2-hero-cell-delta ${expPct<=0?'up':'down'}">${expPct>=0?'↑':'↓'} ${Math.abs(expPct).toFixed(0)}%</div>`:''}</div>
            <div class="kh2-hero-cell"><div class="kh2-hero-cell-top"><span class="kh2-hero-cell-dot sv"></span>Savings</div><div class="kh2-hero-cell-val">${fmt(cards.monthSavings)}</div>${savPct!=null?`<div class="kh2-hero-cell-delta ${savPct>=0?'up':'down'}">${savPct>=0?'↑':'↓'} ${Math.abs(savPct).toFixed(0)}%</div>`:''}</div>
          </div>
        </div>

        <div class="kh2-qa-scroll">
          <button type="button" class="kh2-qa-btn" data-kh-action="qa-income"><span class="kh2-qa-ic income"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg></span>Add Money</button>
          <button type="button" class="kh2-qa-btn" data-kh-action="qa-expense"><span class="kh2-qa-ic expense"><svg viewBox="0 0 24 24"><path d="M5 12h14"/></svg></span>Add Expense</button>
          <button type="button" class="kh2-qa-btn" data-kh-action="qa-transfer"><span class="kh2-qa-ic transfer"><svg viewBox="0 0 24 24"><path d="M4 7h13M17 7l-3.5-3.5M17 7l-3.5 3.5"/><path d="M20 17H7M7 17l3.5-3.5M7 17l3.5 3.5"/></svg></span>Transfer</button>
          <button type="button" class="kh2-qa-btn" data-kh-action="qa-ai"><span class="kh2-qa-ic ai"><svg viewBox="0 0 24 24" fill="#fff" stroke="none"><path d="M12 2.5l1.9 5.6 5.6 1.9-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.9L12 2.5Z"/></svg></span>Ask Khaata AI</button>
        </div>

        <div class="kh2-grid2">
          <div class="kh2-card">
            <div class="kh2-card-head"><div class="kh2-card-title">Recent Transactions</div><button type="button" class="kh2-viewall" data-kh-action="viewall-transactions">View All ›</button></div>
            ${txnHtml}
          </div>

          <div class="kh2-card">
            <div class="kh2-card-head"><div class="kh2-card-title">Budget Progress</div><div class="kh2-headright"><button type="button" class="kh2-viewall" data-kh-action="viewall-budgets">View All ›</button><span class="kh2-dots">⋯</span></div></div>
            ${budgetHtml}
          </div>
        </div>

        <div class="kh2-grid2">
          <div class="kh2-card">
            <div class="kh2-card-head"><div class="kh2-card-title">Your Goals</div><div class="kh2-headright"><button type="button" class="kh2-viewall" data-kh-action="viewall-goals">View All ›</button><span class="kh2-dots">⋯</span></div></div>
            ${goalsHtml}
          </div>

          <div class="kh2-insight" id="khInsightBanner">
            <div class="kh2-insight-ic">💡</div>
            <div><div class="kh2-insight-title">AI Insight</div><div class="kh2-insight-headline">${escapeHtml(insightHeadline)}</div><div class="kh2-insight-text">${escapeHtml(insightText)}</div></div>
          </div>
        </div>
      </div>
    `;
  }catch(err){
    App.Logger.error('renderKhaataHomeV2 failed', err);
  }
}

/* Event delegation on the stable #khHome container — survives every
   innerHTML rebuild above, so it's wired exactly once. */
(function(){
  const root = document.getElementById('khHome');
  if(!root) return;
  root.addEventListener('click', (e)=>{
    const btn = e.target.closest('[data-kh-action]');
    if(!btn) return;
    const act = btn.dataset.khAction;
    if(act==='toggle-balance'){
      khBalanceHidden = !khBalanceHidden;
      try{ renderKhaataHomeV2(App.Dashboard.Cards.compute()); }catch(err){ App.Logger.error('khHome balance toggle failed', err); }
    } else if(act==='qa-expense'){ App.Dashboard.QuickActions.openQuickAdd('expense'); }
    else if(act==='qa-income'){ App.Dashboard.QuickActions.openQuickAdd('income'); }
    else if(act==='qa-transfer'){ App.Dashboard.QuickActions.openQuickAdd('transfer'); }
    else if(act==='qa-ai'){ if(window.App && App.Chat) App.Chat.open(); }
    else if(act==='viewall-transactions'){ switchToView('transactions'); }
    else if(act==='viewall-budgets'){ switchToView('budgets'); }
    else if(act==='viewall-goals'){ switchToView('goals'); }
  });
})();

/* New topbar icon buttons (Sprint 26) — bell reuses the existing AI
   Insight data (just scrolls to + flashes the banner above); avatar
   reuses the existing "More" sheet instead of introducing a new menu. */
document.getElementById('khNotifBtn')?.addEventListener('click', ()=>{
  switchToView('dashboard');
  const banner = document.getElementById('khInsightBanner');
  if(banner){
    banner.scrollIntoView({behavior:'smooth', block:'center'});
    banner.classList.add('kh-flash');
    setTimeout(()=>banner.classList.remove('kh-flash'), 1900);
  }
});
document.getElementById('khAvatarBtn')?.addEventListener('click', ()=>{
  document.getElementById('moreNavBtn')?.click();
});

/* Wire #khHome into the same auto-update engine App.Dashboard.Manager
   already drives: App.Dashboard.Widgets.renderAll(cards) is called by
   Manager.renderNow() on first paint, every tab switch back to Home,
   and every save while Home is visible — wrapping it here means khHome
   refreshes on that exact same schedule with no change to Manager/
   Widgets internals. */
(function(){
  const origWidgetsRenderAll = App.Dashboard.Widgets.renderAll;
  App.Dashboard.Widgets.renderAll = function(cards){
    origWidgetsRenderAll(cards);
    renderKhaataHomeV2(cards);
  };
})();

/* ===================================================================
   AI REPORTS & SMART ANALYTICS ENGINE   (App.Reports / App.Analytics)   —   v1.0.0   (Sprint 14)
   -------------------------------------------------------------------
   New tab ("AI Reports", id="view-reports"), new namespaces. Every
   sub-module below is real, working code — nothing here is a stub.
   Nothing in Sprint 1-13 (including the existing "Monthly Report" and
   "Insights" tabs) is modified — this reads the same `state` those do,
   through the same helper functions already defined above
   (incomeTxns/expenseTxns, sum, dateInRange, activeAccounts,
   accountBalance, subcatsFor, expenseCats/incomeSources, debtRemaining,
   fmt, escapeHtml, downloadFile, debounce, palette).
=================================================================== */

/* ---------------- App.Reports.Config ---------------- */
App.Reports.Config = {
  REFRESH_DEBOUNCE_MS: 250,
  FOOD_LOOKBACK_MONTHS: 3,     // "higher than usual" baseline
  TREND_MONTHS: 3,              // months of history used for trend direction
  BUDGET_WARN_PCT: 80,
  LOW_CASH_THRESHOLD: 500,
  SMALL_FREQ_THRESHOLD: 100,
  FOCI: ['overview','category','subcategory','income','expense','cashflow','savings','loan','investment','budget','account','paymentmethod','merchant'],
  FOCUS_LABELS: {
    overview:'Overview', category:'Category Report', subcategory:'Subcategory Report',
    income:'Income Report', expense:'Expense Report', cashflow:'Cash Flow Report',
    savings:'Savings Report', loan:'Loan Report', investment:'Investment Report',
    budget:'Budget Report', account:'Account Report', paymentmethod:'Payment Method Report',
    merchant:'Merchant Report'
  }
};

/* ---------------- App.Reports.Logger ---------------- */
App.Reports.Logger = {
  info: (...a)=>App.Logger.info('[Reports]', ...a),
  warn: (...a)=>App.Logger.warn('[Reports]', ...a),
  error: (...a)=>App.Logger.error('[Reports]', ...a)
};

/* ---------------- App.Reports.Filter ----------------
   One filter model shared by every report focus. readFromUI() reads
   the filter bar's current values; range() turns the chosen period
   (daily/weekly/monthly/yearly/custom) into a concrete [from,to] date
   pair; apply() runs the full filter (date range + every dropdown/
   input on the bar) over any transaction array. */
App.Reports.Filter = (function(){
  function range(period, customFrom, customTo){
    const today = todayStr();
    if(period==='daily') return { from: today, to: today };
    if(period==='weekly'){
      const d = new Date(); d.setDate(d.getDate()-6);
      return { from: d.toISOString().slice(0,10), to: today };
    }
    if(period==='yearly'){
      const y = new Date().getFullYear();
      return { from: `${y}-01-01`, to: `${y}-12-31` };
    }
    if(period==='custom'){
      return { from: customFrom||startOfMonth(0), to: customTo||today };
    }
    // monthly (default)
    return { from: startOfMonth(0), to: endOfMonth(0) };
  }

  function readFromUI(){
    const period = document.getElementById('rep_period')?.value || 'monthly';
    const customFrom = document.getElementById('rep_from')?.value || '';
    const customTo = document.getElementById('rep_to')?.value || '';
    const { from, to } = range(period, customFrom, customTo);
    return {
      period, from, to,
      focus: document.getElementById('rep_focus')?.value || 'overview',
      txnType: document.getElementById('rep_txnType')?.value || 'all',
      category: document.getElementById('rep_category')?.value || 'all',
      subcategory: document.getElementById('rep_subcategory')?.value || 'all',
      account: document.getElementById('rep_account')?.value || 'all',
      mode: document.getElementById('rep_mode')?.value || 'all',
      merchant: (document.getElementById('rep_merchant')?.value || '').trim().toLowerCase(),
      tag: document.getElementById('rep_tag')?.value || 'all',
      min: parseFloat(document.getElementById('rep_min')?.value) || null,
      max: parseFloat(document.getElementById('rep_max')?.value) || null
    };
  }

  function apply(txns, f){
    return txns.filter(t=>{
      if(!dateInRange(t.date, f.from, f.to)) return false;
      if(f.txnType!=='all' && t.type!==f.txnType) return false;
      if(f.category!=='all' && t.category!==f.category) return false;
      if(f.subcategory!=='all' && t.subcategory!==f.subcategory) return false;
      if(f.account!=='all' && t.account!==f.account && t.fromAccount!==f.account && t.toAccount!==f.account) return false;
      if(f.mode!=='all' && t.mode!==f.mode) return false;
      if(f.merchant && !String(t.item||'').toLowerCase().includes(f.merchant)) return false;
      if(f.tag!=='all' && !(t.tags||[]).includes(f.tag)) return false;
      const amt = Number(t.amount||0);
      if(f.min!=null && amt<f.min) return false;
      if(f.max!=null && amt>f.max) return false;
      return true;
    });
  }

  /* previous period of equal length immediately before f.from..f.to —
     used by Analytics/Trends for "vs previous period" comparisons. */
  function previousRange(f){
    const fromD = new Date(f.from), toD = new Date(f.to);
    const spanMs = Math.max(0, toD - fromD);
    const prevTo = new Date(fromD.getTime() - 86400000);
    const prevFrom = new Date(prevTo.getTime() - spanMs);
    return { from: prevFrom.toISOString().slice(0,10), to: prevTo.toISOString().slice(0,10) };
  }

  return { range, readFromUI, apply, previousRange };
})();

/* ---------------- App.Reports.Builder ----------------
   Builds the data for whichever of the 13 focuses is selected, over
   whatever transactions Filter.apply() already narrowed down to. Each
   builder returns { kpis:[{label,value}], rows:[...], chart:{...}|null,
   note }. Nothing here writes to `state` — read-only, like every other
   report tab in the app. */
App.Reports.Builder = (function(){
  function groupSum(txns, keyFn){
    const map = {};
    txns.forEach(t=>{
      const k = keyFn(t) || '(none)';
      if(!map[k]) map[k] = { total:0, count:0 };
      map[k].total += Number(t.amount||0);
      map[k].count += 1;
    });
    return map;
  }
  function sortedEntries(map){
    return Object.entries(map).sort((a,b)=>b[1].total-a[1].total);
  }

  function overview(txns, f){
    const inc = txns.filter(t=>t.type==='income');
    const exp = txns.filter(t=>t.type==='expense');
    const totalIncome = sum(inc), totalExpense = sum(exp);
    const net = totalIncome - totalExpense;
    const savingsRate = totalIncome>0 ? (net/totalIncome*100) : 0;
    const byCat = groupSum(exp, t=>t.category);
    const byInc = groupSum(inc, t=>t.category);
    const topCatEntry = sortedEntries(byCat)[0];
    const topIncEntry = sortedEntries(byInc)[0];
    return {
      kpis: [
        { label:'Total Income', value: fmt(totalIncome) },
        { label:'Total Expense', value: fmt(totalExpense) },
        { label:'Net (Savings)', value: (net>=0?'+':'')+fmt(net) },
        { label:'Savings Rate', value: savingsRate.toFixed(1)+'%' },
        { label:'Transactions', value: String(txns.length) },
        { label:'Avg Transaction', value: fmt(txns.length? sum(txns)/txns.length : 0) }
      ],
      rows: [
        topCatEntry ? { name:`Highest expense: ${topCatEntry[0]}`, val: fmt(topCatEntry[1].total) } : null,
        topIncEntry ? { name:`Highest income source: ${topIncEntry[0]}`, val: fmt(topIncEntry[1].total) } : null
      ].filter(Boolean),
      chart: { type:'doughnut', labels: sortedEntries(byCat).map(e=>e[0]).slice(0,8), data: sortedEntries(byCat).map(e=>e[1].total).slice(0,8), title:'Expense by Category' },
      note: 'Overview covers every transaction (income, expense, transfer) that matches your filters for this period.'
    };
  }

  function categoryReport(txns, f, useSub){
    const exp = txns.filter(t=>t.type==='expense');
    const map = groupSum(exp, t=> useSub ? `${t.category} › ${t.subcategory||'—'}` : t.category);
    const entries = sortedEntries(map);
    const total = sum(exp);
    const rows = entries.map(([name,v])=>({
      name, val: fmt(v.total),
      sub: `${v.count} txn${v.count===1?'':'s'} · ${total? (v.total/total*100).toFixed(1):'0'}% of expenses`
    }));
    return {
      kpis: [
        { label:'Total Expense', value: fmt(total) },
        { label:(useSub?'Subcategories':'Categories'), value: String(entries.length) },
        { label:'Top', value: entries[0]? entries[0][0] : '—' }
      ],
      rows,
      chart: { type:'bar', labels: entries.map(e=>e[0]).slice(0,10), data: entries.map(e=>e[1].total).slice(0,10), title: useSub?'Spend by Subcategory':'Spend by Category' },
      note: useSub ? 'Only expense transactions with a subcategory are broken out below; ones without a subcategory show as "—".' : 'All expense categories in this period, highest spend first.'
    };
  }

  function incomeReport(txns){
    const inc = txns.filter(t=>t.type==='income');
    const map = groupSum(inc, t=>t.category);
    const entries = sortedEntries(map);
    const total = sum(inc);
    return {
      kpis: [ { label:'Total Income', value: fmt(total) }, { label:'Sources', value:String(entries.length) }, { label:'Top Source', value: entries[0]?entries[0][0]:'—' } ],
      rows: entries.map(([name,v])=>({ name, val: fmt(v.total), sub:`${v.count} txn${v.count===1?'':'s'}` })),
      chart: { type:'bar', labels: entries.map(e=>e[0]), data: entries.map(e=>e[1].total), title:'Income by Source' },
      note: 'All income transactions matching your filters, grouped by source.'
    };
  }

  function expenseReport(txns){ return categoryReport(txns, null, false); }

  function cashflowReport(txns, f){
    // bucket by day across the range for a simple, honest cash-flow line
    const days = [];
    let d = new Date(f.from);
    const end = new Date(f.to);
    while(d<=end && days.length<370){ days.push(d.toISOString().slice(0,10)); d.setDate(d.getDate()+1); }
    const incByDay = {}, expByDay = {};
    txns.forEach(t=>{
      if(t.type==='income') incByDay[t.date]=(incByDay[t.date]||0)+Number(t.amount||0);
      if(t.type==='expense') expByDay[t.date]=(expByDay[t.date]||0)+Number(t.amount||0);
    });
    let cum = 0;
    const cumSeries = days.map(dt=>{ cum += (incByDay[dt]||0)-(expByDay[dt]||0); return cum; });
    const totalIn = sum(txns.filter(t=>t.type==='income'));
    const totalOut = sum(txns.filter(t=>t.type==='expense'));
    return {
      kpis: [ { label:'Cash In', value: fmt(totalIn) }, { label:'Cash Out', value: fmt(totalOut) }, { label:'Net Cash Flow', value: (totalIn-totalOut>=0?'+':'')+fmt(totalIn-totalOut) } ],
      rows: [],
      chart: { type:'line', labels: days, data: cumSeries, data2: days.map(dt=>(incByDay[dt]||0)-(expByDay[dt]||0)), title:'Cumulative Net Cash Flow' },
      note: 'Running (cumulative) balance of money in minus money out, day by day, across the selected period.'
    };
  }

  function savingsReport(txns, f){
    const inc = sum(txns.filter(t=>t.type==='income'));
    const exp = sum(txns.filter(t=>t.type==='expense'));
    const net = inc-exp;
    const rate = inc>0 ? net/inc*100 : 0;
    return {
      kpis: [ { label:'Income', value: fmt(inc) }, { label:'Expense', value: fmt(exp) }, { label:'Savings', value: (net>=0?'+':'')+fmt(net) }, { label:'Savings Rate', value: rate.toFixed(1)+'%' } ],
      rows: [],
      chart: { type:'doughnut', labels:['Saved','Spent'], data:[Math.max(0,net), exp], title:'Savings vs Spend' },
      note: 'Savings = income minus expense for this period. A healthy target most planners suggest is 20% or more.'
    };
  }

  function loanReport(){
    const debts = state.debts||[];
    const owedToMe = debts.filter(d=>d.type==='owed_to_me');
    const iOwe = debts.filter(d=>d.type==='i_owe');
    const owedToMeTotal = owedToMe.reduce((s,d)=>s+debtRemaining(d),0);
    const iOweTotal = iOwe.reduce((s,d)=>s+debtRemaining(d),0);
    const rows = debts.map(d=>({
      name: `${d.person||'(unnamed)'} — ${d.type==='owed_to_me'?'owes you':'you owe'}`,
      val: fmt(debtRemaining(d)),
      sub: d.settled? 'Settled' : (d.due? `Due ${d.due}` : 'No due date set')
    }));
    return {
      kpis: [ { label:'Owed to me', value: fmt(owedToMeTotal) }, { label:'I owe', value: fmt(iOweTotal) }, { label:'Net Position', value: (owedToMeTotal-iOweTotal>=0?'+':'')+fmt(owedToMeTotal-iOweTotal) }, { label:'Open loans', value: String(debts.filter(d=>!d.settled).length) } ],
      rows,
      chart: { type:'bar', labels:['Owed to me','I owe'], data:[owedToMeTotal, iOweTotal], title:'Loan Position' },
      note: 'Debts & Loans are not date-filtered — this shows your full current loan book.'
    };
  }

  function investmentReport(){
    const inv = state.investments||[];
    const invested = inv.reduce((s,i)=>s+(Number(i.invested)||0),0);
    const current = inv.reduce((s,i)=>s+(Number(i.currentValue)||0),0);
    const pl = current-invested;
    const rows = inv.map(i=>{
      const iPl = (Number(i.currentValue)||0)-(Number(i.invested)||0);
      const iPct = i.invested? (iPl/i.invested*100):0;
      return { name:i.name, val: fmt(i.currentValue), sub:`Invested ${fmt(i.invested)} · ${iPl>=0?'+':''}${iPct.toFixed(1)}%` };
    });
    return {
      kpis: [ { label:'Invested', value: fmt(invested) }, { label:'Current Value', value: fmt(current) }, { label:'P/L', value:(pl>=0?'+':'')+fmt(pl) }, { label:'Return %', value: (invested? (pl/invested*100).toFixed(1):'0')+'%' } ],
      rows,
      chart: { type:'bar', labels: inv.map(i=>i.name), data: inv.map(i=>Number(i.currentValue)||0), title:'Current Value by Investment' },
      note: 'Investments are not date-filtered — this shows your full current portfolio, same figures as the Investments tab.'
    };
  }

  function budgetReport(txns, f){
    const cats = Object.keys(state.budgets||{});
    const rows = cats.map(c=>{
      const budget = Number(state.budgets[c])||0;
      const actual = sum(txns.filter(t=>t.type==='expense' && t.category===c));
      const pct = budget>0? actual/budget*100 : 0;
      return { name:c, val: `${fmt(actual)} / ${fmt(budget)}`, sub: pct.toFixed(0)+'% used'+(actual>budget?' — OVER BUDGET':''), over: actual>budget };
    }).sort((a,b)=>b.over-a.over);
    return {
      kpis: [ { label:'Budgets set', value:String(cats.length) }, { label:'Over budget', value:String(rows.filter(r=>r.over).length) } ],
      rows,
      chart: { type:'bar', labels: cats, data: cats.map(c=> Number(state.budgets[c])||0), data2: cats.map(c=> sum(txns.filter(t=>t.type==='expense'&&t.category===c))), title:'Budget vs Actual' },
      note: 'Budgets are compared against expense transactions that match your filters for this period.'
    };
  }

  function accountReport(txns){
    const accs = activeAccounts();
    const rows = accs.map(a=>{
      const acctTxns = txns.filter(t=>t.account===a.id || t.fromAccount===a.id || t.toAccount===a.id);
      const inAmt = sum(acctTxns.filter(t=>t.type==='income' || t.toAccount===a.id));
      const outAmt = sum(acctTxns.filter(t=>t.type==='expense' || t.fromAccount===a.id));
      return { name:`${a.icon||''} ${a.name}`, val: fmt(accountBalance(a.id)), sub:`${acctTxns.length} txn${acctTxns.length===1?'':'s'} this period · in ${fmt(inAmt)} / out ${fmt(outAmt)}` };
    }).sort((a,b)=>b.val.localeCompare(a.val));
    const mostActive = [...accs].map(a=>({a, n: txns.filter(t=>t.account===a.id||t.fromAccount===a.id||t.toAccount===a.id).length})).sort((x,y)=>y.n-x.n)[0];
    return {
      kpis: [ { label:'Accounts', value:String(accs.length) }, { label:'Total Balance', value: fmt(totalMoney()) }, { label:'Most Active', value: mostActive&&mostActive.n>0? mostActive.a.name : '—' } ],
      rows,
      chart: { type:'doughnut', labels: accs.map(a=>a.name), data: accs.map(a=>Math.max(0,accountBalance(a.id))), title:'Balance by Account' },
      note: 'Balances shown are current (all-time) account balances; transaction counts are for the selected period.'
    };
  }

  function paymentMethodReport(txns){
    const exp = txns.filter(t=>t.type==='expense'||t.type==='income');
    const map = groupSum(exp, t=>t.mode);
    const entries = sortedEntries(map);
    const total = sum(exp);
    return {
      kpis: [ { label:'Modes used', value:String(entries.length) }, { label:'Most used (amount)', value: entries[0]?entries[0][0]:'—' } ],
      rows: entries.map(([name,v])=>({ name, val: fmt(v.total), sub:`${v.count} txn${v.count===1?'':'s'} · ${total?(v.total/total*100).toFixed(1):'0'}%` })),
      chart: { type:'doughnut', labels: entries.map(e=>e[0]), data: entries.map(e=>e[1].total), title:'Spend by Payment Method' },
      note: 'Covers income and expense transactions (transfers excluded — they move money between your own accounts).'
    };
  }

  function merchantReport(txns){
    const exp = txns.filter(t=>t.type==='expense' && t.item);
    const map = groupSum(exp, t=>t.item);
    const entries = sortedEntries(map).slice(0,25);
    return {
      kpis: [ { label:'Merchants / Items', value:String(entries.length) }, { label:'Top', value: entries[0]?entries[0][0]:'—' } ],
      rows: entries.map(([name,v])=>({ name, val: fmt(v.total), sub:`${v.count} purchase${v.count===1?'':'s'}` })),
      chart: { type:'bar', labels: entries.map(e=>e[0]).slice(0,10), data: entries.map(e=>e[1].total).slice(0,10), title:'Top Merchants / Items by Spend' },
      note: 'Grouped by the Item/Description text you entered, top 25 by total spend.'
    };
  }

  function build(focus, txns, f){
    switch(focus){
      case 'overview': return overview(txns, f);
      case 'category': return categoryReport(txns, f, false);
      case 'subcategory': return categoryReport(txns, f, true);
      case 'income': return incomeReport(txns);
      case 'expense': return expenseReport(txns);
      case 'cashflow': return cashflowReport(txns, f);
      case 'savings': return savingsReport(txns, f);
      case 'loan': return loanReport();
      case 'investment': return investmentReport();
      case 'budget': return budgetReport(txns, f);
      case 'account': return accountReport(txns);
      case 'paymentmethod': return paymentMethodReport(txns);
      case 'merchant': return merchantReport(txns);
      default: return overview(txns, f);
    }
  }

  return { build, groupSum, sortedEntries };
})();

/* ---------------- App.Analytics.Trends ----------------
   Month-over-month direction helper. monthlyCategoryTotals() walks
   back N months and sums expenses for one category per month;
   direction() turns that series into 'up'/'down'/'flat' so Insights
   can say things like "Travel expenses are increasing" only when
   there's an actual multi-month trend, not just one noisy month. */
App.Analytics.Trends = (function(){
  function monthlySeries(category, months){
    const out = [];
    for(let i=months-1;i>=0;i--){
      const from = startOfMonth(-i), to = endOfMonth(-i);
      const total = sum(state.transactions.filter(t=>t.type==='expense' && (!category||t.category===category) && dateInRange(t.date,from,to)));
      out.push(total);
    }
    return out;
  }
  function direction(series){
    if(series.length<2) return 'flat';
    let ups=0, downs=0;
    for(let i=1;i<series.length;i++){
      if(series[i] > series[i-1]*1.05) ups++;
      else if(series[i] < series[i-1]*0.95) downs++;
    }
    if(ups>downs && series[series.length-1]>series[0]) return 'up';
    if(downs>ups && series[series.length-1]<series[0]) return 'down';
    return 'flat';
  }
  return { monthlySeries, direction };
})();

/* ---------------- App.Analytics.Forecast ----------------
   Simple, clearly-labeled ESTIMATE: trailing-average projection for
   next month's income/expense/top category. No AI model, no network
   call — pure arithmetic over the last N months already in state. */
App.Analytics.Forecast = (function(){
  function nextMonth(monthsBack){
    monthsBack = monthsBack || 3;
    let incTotal=0, expTotal=0, n=0;
    for(let i=1;i<=monthsBack;i++){
      const from = startOfMonth(-i), to = endOfMonth(-i);
      const mi = sum(state.transactions.filter(t=>t.type==='income' && dateInRange(t.date,from,to)));
      const me = sum(state.transactions.filter(t=>t.type==='expense' && dateInRange(t.date,from,to)));
      if(mi>0 || me>0){ incTotal+=mi; expTotal+=me; n++; }
    }
    if(n===0) return null;
    return { projectedIncome: incTotal/n, projectedExpense: expTotal/n, projectedSavings: (incTotal-expTotal)/n, monthsUsed: n };
  }
  return { nextMonth };
})();

/* ---------------- App.Analytics.Insights ----------------
   Generates the specific plain-language insights requested. Every
   sentence here is written so a beginner, a business owner and a
   professional accountant can each read the same line and understand
   it — no jargon. Nothing is invented: every insight is either a
   direct number from `state.transactions`/state.budgets/etc., or a
   clearly-labeled ESTIMATE from App.Analytics.Forecast. */
App.Analytics.Insights = (function(){
  function generate(f){
    const Cfg = App.Reports.Config;
    const out = [];
    const from = f.from, to = f.to;
    const prev = App.Reports.Filter.previousRange(f);

    const incNow = sum(incomeTxns().filter(t=>dateInRange(t.date,from,to)));
    const incPrev = sum(incomeTxns().filter(t=>dateInRange(t.date,prev.from,prev.to)));
    const expNow = sum(expenseTxns().filter(t=>dateInRange(t.date,from,to)));
    const expPrev = sum(expenseTxns().filter(t=>dateInRange(t.date,prev.from,prev.to)));

    // 1. Income increased/decreased
    if(incPrev>0){
      const pct = (incNow-incPrev)/incPrev*100;
      if(Math.abs(pct)>=5){
        out.push({ dot: pct>0?'good':'warn', text:`Your income ${pct>0?'increased':'decreased'} by ${Math.abs(pct).toFixed(0)}% compared to the previous period (${fmt(incPrev)} → ${fmt(incNow)}).` });
      }
    } else if(incNow>0){
      out.push({ dot:'good', text:`You recorded ${fmt(incNow)} of income this period.` });
    }

    // 2. Food expenses higher than usual (vs trailing average)
    const foodSeries = App.Analytics.Trends.monthlySeries('Food', Cfg.FOOD_LOOKBACK_MONTHS);
    const foodAvg = foodSeries.length? foodSeries.reduce((a,b)=>a+b,0)/foodSeries.length : 0;
    const foodNow = sum(expenseTxns().filter(t=>t.category==='Food' && dateInRange(t.date,from,to)));
    if(foodAvg>0 && foodNow > foodAvg*1.15){
      out.push({ dot:'warn', text:`Food expenses are higher than usual — ${fmt(foodNow)} this period vs your ${fmt(foodAvg)} average.` });
    } else if(foodAvg>0 && foodNow < foodAvg*0.85 && foodNow>0){
      out.push({ dot:'good', text:`Food expenses are lower than usual — ${fmt(foodNow)} this period vs your ${fmt(foodAvg)} average.` });
    }

    // 3. Travel expenses trend
    const travelSeries = App.Analytics.Trends.monthlySeries('Travel', Cfg.TREND_MONTHS);
    const travelDir = App.Analytics.Trends.direction(travelSeries);
    if(travelDir==='up') out.push({ dot:'warn', text:`Travel expenses are increasing over the last ${Cfg.TREND_MONTHS} months.` });
    else if(travelDir==='down') out.push({ dot:'good', text:`Travel expenses are decreasing over the last ${Cfg.TREND_MONTHS} months.` });

    // 4 & 11. Most spending by amount / most frequent by count, by payment mode
    const modeMap = App.Reports.Builder.groupSum(state.transactions.filter(t=>(t.type==='expense') && dateInRange(t.date,from,to)), t=>t.mode);
    const byAmount = App.Reports.Builder.sortedEntries(modeMap)[0];
    const byCount = Object.entries(modeMap).sort((a,b)=>b[1].count-a[1].count)[0];
    if(byAmount) out.push({ dot:'info', text:`Most of your spending is done through ${byAmount[0]} (${fmt(byAmount[1].total)}).` });
    if(byCount && (!byAmount || byCount[0]!==byAmount[0])) out.push({ dot:'info', text:`${byCount[0]} is your most frequently used payment method (${byCount[1].count} transactions).` });

    // 5. Savings trend improving
    const savingsSeries = [];
    for(let i=Cfg.TREND_MONTHS-1;i>=0;i--){
      const mf=startOfMonth(-i), mt=endOfMonth(-i);
      savingsSeries.push(sum(state.transactions.filter(t=>t.type==='income'&&dateInRange(t.date,mf,mt))) - sum(state.transactions.filter(t=>t.type==='expense'&&dateInRange(t.date,mf,mt))));
    }
    const savDir = App.Analytics.Trends.direction(savingsSeries.map(v=>Math.max(0,v)+1)); // shift to avoid zero-division noise
    if(savDir==='up') out.push({ dot:'good', text:`Your savings trend is improving over the last ${Cfg.TREND_MONTHS} months.` });
    else if(savDir==='down') out.push({ dot:'warn', text:`Your savings trend is declining over the last ${Cfg.TREND_MONTHS} months.` });

    // 6. Cash balance reducing
    let cashBalance = 0;
    activeAccounts().forEach(a=>{ if(a.type==='Cash') cashBalance += accountBalance(a.id); });
    if(cashBalance < Cfg.LOW_CASH_THRESHOLD) out.push({ dot:'bad', text:`Your cash balance is low (${fmt(cashBalance)}).` });

    // 7. Budget exceeded
    Object.keys(state.budgets||{}).forEach(cat=>{
      const budget = Number(state.budgets[cat])||0;
      if(budget<=0) return;
      const actual = sum(expenseTxns().filter(t=>t.category===cat && dateInRange(t.date,from,to)));
      if(actual>budget) out.push({ dot:'bad', text:`Budget exceeded for ${cat} — ${fmt(actual)} spent of ${fmt(budget)}.` });
      else if(actual/budget*100>=Cfg.BUDGET_WARN_PCT) out.push({ dot:'warn', text:`Your ${cat} budget is almost used up — ${(actual/budget*100).toFixed(0)}%.` });
    });

    // 8. Highest expense category
    const catMap = App.Reports.Builder.groupSum(expenseTxns().filter(t=>dateInRange(t.date,from,to)), t=>t.category);
    const topCat = App.Reports.Builder.sortedEntries(catMap)[0];
    if(topCat) out.push({ dot:'info', text:`Your highest expense category this period is ${topCat[0]} (${fmt(topCat[1].total)}).` });

    // 9. Highest income source
    const incMap = App.Reports.Builder.groupSum(incomeTxns().filter(t=>dateInRange(t.date,from,to)), t=>t.category);
    const topInc = App.Reports.Builder.sortedEntries(incMap)[0];
    if(topInc) out.push({ dot:'info', text:`Your highest income source this period is ${topInc[0]} (${fmt(topInc[1].total)}).` });

    // 10. Most active account
    const accCounts = activeAccounts().map(a=>({a, n: state.transactions.filter(t=>dateInRange(t.date,from,to)&&(t.account===a.id||t.fromAccount===a.id||t.toAccount===a.id)).length})).sort((x,y)=>y.n-x.n)[0];
    if(accCounts && accCounts.n>0) out.push({ dot:'info', text:`Your most active account this period is ${accCounts.a.name} (${accCounts.n} transactions).` });

    // 12. Forecast headline
    const fc = App.Analytics.Forecast.nextMonth(3);
    if(fc){
      out.push({ dot: fc.projectedSavings>=0?'good':'warn', text:`Based on your last ${fc.monthsUsed} month(s), next month's expenses are estimated around ${fmt(fc.projectedExpense)} and income around ${fmt(fc.projectedIncome)} (ESTIMATE, not a guarantee).` });
    }

    if(!out.length) out.push({ dot:'info', text:'Not enough data yet for this period — add a few more transactions for sharper insights.' });
    return out;
  }
  return { generate };
})();

App.Analytics.Manager = { generate: (f)=>App.Analytics.Insights.generate(f) };

/* delegate — App.Reports.Analytics simply calls App.Analytics.Manager,
   named separately so the Reports tab's own module list matches the
   mission's requested App.Reports.Analytics surface. */
App.Reports.Analytics = { generate: (f)=>App.Analytics.Manager.generate(f) };

/* ---------------- App.Reports.Export ----------------
   Real, working exports of whatever report is currently on screen —
   CSV, JSON, Excel (.xls — an HTML table Excel opens natively, the
   standard dependency-free way to produce an Excel-openable file from
   the browser alone), and Print/Save-as-PDF (uses the browser's own
   print dialog on a clean printable view — the standard dependency-
   free way to produce a PDF from the browser alone, since pulling in
   a PDF-generation library was out of scope for this sprint). */
App.Reports.Export = (function(){
  function currentPayload(){
    const f = App.Reports.Filter.readFromUI();
    const txns = App.Reports.Filter.apply(state.transactions, f);
    const built = App.Reports.Builder.build(f.focus, txns, f);
    return { f, txns, built };
  }

  function toCSV(){
    const { f, built } = currentPayload();
    let out = `Khaata AI Report,${App.Reports.Config.FOCUS_LABELS[f.focus]}\nPeriod,${f.from} to ${f.to}\n\n`;
    out += 'Metric,Value\n' + built.kpis.map(k=>`"${k.label}","${k.value}"`).join('\n') + '\n\n';
    if(built.rows.length){
      out += 'Item,Value,Detail\n' + built.rows.map(r=>`"${(r.name||'').replace(/"/g,'""')}","${(r.val||'').replace(/"/g,'""')}","${(r.sub||'').replace(/"/g,'""')}"`).join('\n');
    }
    downloadFile(`khaata-report-${f.focus}-${f.from}_to_${f.to}.csv`, out, 'text/csv');
  }

  function toJSON(){
    const { f, built } = currentPayload();
    downloadFile(`khaata-report-${f.focus}-${f.from}_to_${f.to}.json`, JSON.stringify({ filters:f, report:built, generatedAt:new Date().toISOString() }, null, 2), 'application/json');
  }

  function toExcel(){
    const { f, built } = currentPayload();
    let rows = `<tr><th>Metric</th><th>Value</th></tr>` + built.kpis.map(k=>`<tr><td>${escapeHtml(k.label)}</td><td>${escapeHtml(k.value)}</td></tr>`).join('');
    if(built.rows.length){
      rows += `<tr><td colspan="2"></td></tr><tr><th>Item</th><th>Value</th></tr>` + built.rows.map(r=>`<tr><td>${escapeHtml(r.name||'')} ${r.sub?('('+escapeHtml(r.sub)+')'):''}</td><td>${escapeHtml(r.val||'')}</td></tr>`).join('');
    }
    const html = `<html><head><meta charset="UTF-8"></head><body><h3>Khaata — ${escapeHtml(App.Reports.Config.FOCUS_LABELS[f.focus])} (${f.from} to ${f.to})</h3><table border="1">${rows}</table></body></html>`;
    downloadFile(`khaata-report-${f.focus}-${f.from}_to_${f.to}.xls`, html, 'application/vnd.ms-excel');
  }

  function buildPrintableHtml(){
    const { f, built } = currentPayload();
    const insights = App.Reports.Analytics.generate(f);
    return `
      <h2 style="margin:0 0 4px;">Khaata — ${escapeHtml(App.Reports.Config.FOCUS_LABELS[f.focus])}</h2>
      <p style="margin:0 0 16px;color:#666;">Period: ${f.from} to ${f.to} · Generated ${new Date().toLocaleString()}</p>
      <h3>Summary</h3>
      <table border="1" cellpadding="6" style="border-collapse:collapse;width:100%;margin-bottom:16px;">
        ${built.kpis.map(k=>`<tr><td><b>${escapeHtml(k.label)}</b></td><td>${escapeHtml(k.value)}</td></tr>`).join('')}
      </table>
      ${built.rows.length ? `<h3>Details</h3><table border="1" cellpadding="6" style="border-collapse:collapse;width:100%;margin-bottom:16px;">
        <tr><th>Item</th><th>Value</th><th>Detail</th></tr>
        ${built.rows.map(r=>`<tr><td>${escapeHtml(r.name||'')}</td><td>${escapeHtml(r.val||'')}</td><td>${escapeHtml(r.sub||'')}</td></tr>`).join('')}
      </table>` : ''}
      <h3>Smart AI Insights</h3>
      <ul>${insights.map(i=>`<li>${escapeHtml(i.text)}</li>`).join('')}</ul>
      <p style="color:#999;font-size:11px;margin-top:20px;">Generated entirely offline by Khaata from data you entered on this device. Not professional financial or tax advice.</p>
    `;
  }

  function print(){
    const html = buildPrintableHtml();
    const w = window.open('', '_blank');
    if(!w){
      // popup blocked — fall back to an in-page printable panel
      const panel = document.getElementById('repPrintable');
      panel.innerHTML = html;
      panel.style.display = 'block';
      window.print();
      panel.style.display = 'none';
      return;
    }
    w.document.write(`<!DOCTYPE html><html><head><title>Khaata Report</title><meta charset="UTF-8"></head><body style="font-family:sans-serif;color:#222;">${html}</body></html>`);
    w.document.close();
    w.focus();
    setTimeout(()=>{ try{ w.print(); }catch(e){} }, 300);
  }

  return { toCSV, toJSON, toExcel, print, currentPayload, buildPrintableHtml };
})();

/* ---------------- App.Reports.Share ----------------
   Web Share API when available (mobile-friendly), clipboard-copy
   fallback otherwise. Shares a plain-text summary, never a file the
   receiving app can't open. */
App.Reports.Share = (function(){
  async function share(){
    const { f, built } = App.Reports.Export.currentPayload();
    const lines = [`Khaata — ${App.Reports.Config.FOCUS_LABELS[f.focus]} (${f.from} to ${f.to})`, ''];
    built.kpis.forEach(k=> lines.push(`${k.label}: ${k.value}`));
    const text = lines.join('\n');
    try{
      if(navigator.share){
        await navigator.share({ title:'Khaata Report', text });
        return;
      }
    }catch(e){ App.Reports.Logger.warn('navigator.share failed, falling back to clipboard', e); }
    try{
      await navigator.clipboard.writeText(text);
      App.Notifications && App.Notifications.flash ? App.Notifications.flash('Report summary copied to clipboard') : alert('Report summary copied to clipboard.');
    }catch(e){
      App.Reports.Logger.error('clipboard share failed', e);
      alert('Could not share or copy automatically. Please select and copy the report manually.');
    }
  }
  return { share };
})();

/* ---------------- App.Reports.Manager ----------------
   Orchestrates the whole tab + reuses the Sprint-13 auto-update
   pattern: wraps the same save*() functions again (composing with
   App.Dashboard's existing wrap, not replacing it) so this tab also
   refreshes itself automatically — but only renders while the Reports
   tab is the one currently on screen, debounced + rAF-batched exactly
   like App.Dashboard.Manager. */
App.Reports.Manager = (function(){
  let rafScheduled = false;
  let dirty = true;
  let optionsBuilt = false;

  function isActive(){
    const v = document.getElementById('view-reports');
    return !!(v && v.classList.contains('active'));
  }

  function buildOptionsOnce(){
    if(optionsBuilt) return;
    const catSel = document.getElementById('rep_category');
    const subSel = document.getElementById('rep_subcategory');
    const accSel = document.getElementById('rep_account');
    const tagSel = document.getElementById('rep_tag');
    if(catSel){
      const cats = [...new Set([...expenseCats(), ...incomeSources()])];
      catSel.innerHTML = '<option value="all">All categories</option>' + cats.map(c=>`<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`).join('');
    }
    if(accSel){
      accSel.innerHTML = '<option value="all">All accounts</option>' + activeAccounts().map(a=>`<option value="${a.id}">${escapeHtml(a.name)}</option>`).join('');
    }
    if(tagSel){
      tagSel.innerHTML = '<option value="all">All tags</option>' + (state.tags||[]).map(t=>`<option value="${escapeHtml(t)}">${escapeHtml(t)}</option>`).join('');
    }
    if(catSel) catSel.addEventListener('change', ()=>{
      if(subSel){
        const subs = subcatsFor(catSel.value==='all' ? '' : catSel.value);
        subSel.innerHTML = '<option value="all">All subcategories</option>' + subs.map(s=>`<option value="${escapeHtml(s)}">${escapeHtml(s)}</option>`).join('');
      }
      scheduleRefresh(true);
    });
    optionsBuilt = true;
  }

  function bindFilterBar(){
    if(document.getElementById('repFilterBar').dataset.bound) return;
    document.getElementById('repFilterBar').dataset.bound = '1';
    document.getElementById('rep_period').addEventListener('change', e=>{
      document.getElementById('repCustomWrap').classList.toggle('hidden', e.target.value!=='custom');
      scheduleRefresh(true);
    });
    ['rep_from','rep_to','rep_focus','rep_txnType','rep_subcategory','rep_account','rep_mode','rep_tag'].forEach(id=>{
      const el = document.getElementById(id);
      if(el) el.addEventListener('change', ()=>scheduleRefresh(true));
    });
    ['rep_merchant','rep_min','rep_max'].forEach(id=>{
      const el = document.getElementById(id);
      if(el) el.addEventListener('input', debounce(()=>scheduleRefresh(true), 300));
    });
    document.getElementById('repClearBtn').addEventListener('click', ()=>{
      ['rep_from','rep_to','rep_merchant','rep_min','rep_max'].forEach(id=>{ const el=document.getElementById(id); if(el) el.value=''; });
      ['rep_txnType','rep_category','rep_subcategory','rep_account','rep_mode','rep_tag'].forEach(id=>{ const el=document.getElementById(id); if(el) el.value='all'; });
      document.getElementById('rep_period').value = 'monthly';
      document.getElementById('repCustomWrap').classList.add('hidden');
      scheduleRefresh(true);
    });
    document.getElementById('repExportCsvBtn').addEventListener('click', ()=>App.Reports.Export.toCSV());
    document.getElementById('repExportJsonBtn').addEventListener('click', ()=>App.Reports.Export.toJSON());
    document.getElementById('repExportExcelBtn').addEventListener('click', ()=>App.Reports.Export.toExcel());
    document.getElementById('repPrintBtn').addEventListener('click', ()=>App.Reports.Export.print());
    document.getElementById('repShareBtn').addEventListener('click', ()=>App.Reports.Share.share());
  }

  function chartTypeFor(type){ return type==='doughnut' ? 'doughnut' : type; }

  function renderChart(built){
    const wrap = document.getElementById('repCharts');
    if(!wrap) return;
    if(!built.chart || !built.chart.labels || !built.chart.labels.length){
      wrap.innerHTML = '';
      return;
    }
    wrap.innerHTML = `<div class="chart-box"><h4>${escapeHtml(built.chart.title||'')}</h4><canvas id="repChartCanvas"></canvas></div>`;
    destroyChart('reports');
    const c = built.chart;
    const cfg = c.type==='line'
      ? { type:'line', data:{ labels:c.labels, datasets:[{ label:'Cumulative', data:c.data, borderColor: palette(1)[0], backgroundColor:'transparent', tension:.25 }] }, options:{ responsive:true, plugins:{legend:{display:false}} } }
      : c.type==='doughnut'
      ? { type:'doughnut', data:{ labels:c.labels, datasets:[{ data:c.data, backgroundColor: palette(c.labels.length) }] }, options:{ responsive:true } }
      : { type:'bar', data:{ labels:c.labels, datasets: c.data2 ? [
            { label:'Budget', data:c.data, backgroundColor: palette(2)[0] },
            { label:'Actual', data:c.data2, backgroundColor: palette(2)[1] }
          ] : [{ label:c.title||'Amount', data:c.data, backgroundColor: palette(c.labels.length) }] }, options:{ responsive:true, plugins:{legend:{display: !!c.data2}} } };
    try{ charts.reports = new Chart(document.getElementById('repChartCanvas'), cfg); }
    catch(e){ App.Reports.Logger.error('chart render failed', e); }
  }

  function renderNow(){
    if(!isActive()) return;
    buildOptionsOnce();
    bindFilterBar();
    const f = App.Reports.Filter.readFromUI();
    const txns = App.Reports.Filter.apply(state.transactions, f);
    const built = App.Reports.Builder.build(f.focus, txns, f);
    const insights = App.Reports.Analytics.generate(f);

    document.getElementById('repMeta').textContent = `${txns.length} transaction${txns.length===1?'':'s'} matched · ${f.from} to ${f.to}`;

    const kpiGrid = document.getElementById('repSummaryGrid');
    kpiGrid.innerHTML = built.kpis.map(k=>`<div class="kpi"><div class="card-note">${escapeHtml(k.label)}</div><div style="font-size:20px;font-weight:800;margin-top:4px;">${escapeHtml(k.value)}</div></div>`).join('');

    const body = document.getElementById('repBody');
    if(!built.rows.length){
      body.innerHTML = `<div class="empty-note">${escapeHtml(built.note||'No matching data for this period yet.')}</div>`;
    } else {
      body.innerHTML = (built.note?`<div class="rep-focus-note">${escapeHtml(built.note)}</div>`:'') +
        built.rows.map(r=>`<div class="rep-row"><span class="rr-label"><span class="rr-name">${escapeHtml(r.name||'')}</span>${r.sub?`<span class="rr-sub">${escapeHtml(r.sub)}</span>`:''}</span><span class="rr-val ${r.over?'amt-ex':''}">${escapeHtml(r.val||'')}</span></div>`).join('');
    }

    const insEl = document.getElementById('repInsightsList');
    insEl.innerHTML = insights.map(i=>`<div class="insight"><span class="dot ${i.dot}"></span><p>${escapeHtml(i.text)}</p></div>`).join('');

    renderChart(built);
    dirty = false;
  }

  const debouncedTrigger = debounce(()=>{
    dirty = true;
    if(!isActive()) return;
    if(rafScheduled) return;
    rafScheduled = true;
    requestAnimationFrame(()=>{ rafScheduled=false; renderNow(); });
  }, App.Reports.Config.REFRESH_DEBOUNCE_MS);

  function scheduleRefresh(immediate){
    if(immediate && isActive()){ dirty = true; renderNow(); return; }
    debouncedTrigger();
  }

  function renderIfNeeded(){ if(dirty) renderNow(); else if(isActive()) renderNow(); }

  function init(){
    // Compose with the existing save*() wraps (App.Dashboard.Manager.init()
    // already wrapped these once) — wrapping again here just chains a
    // second, independent callback after the same original function.
    const SAVE_FNS = [
      'saveTransactions','saveAccounts','saveBudgets','saveGoals','saveDebts',
      'saveCreditCards','saveInvestments','saveRecurring','saveSubcats',
      'saveCustomCats','saveNetWorthHistory','saveCCUtilHistory'
    ];
    SAVE_FNS.forEach(name=>{
      const orig = window[name];
      if(typeof orig !== 'function') return;
      const wrapped = async function(...args){
        const result = await orig.apply(this, args);
        scheduleRefresh(false);
        return result;
      };
      window[name] = wrapped;
      if(App.Storage[name]) App.Storage[name] = wrapped;
    });
    App.Reports.Logger.info('auto-update engine wired to', SAVE_FNS.length, 'save functions');
  }

  return { init, scheduleRefresh, renderNow, renderIfNeeded, isActive };
})();

/* Entry point called from renderView('reports') — mirrors how every
   other tab (renderBudgets, renderReport, renderInsights, ...) has its
   own render*() function wired in renderView() above. */
function renderReportsHub(){
  App.Reports.Manager.renderNow();
}

/* ================================================================
   ONLINE AI KNOWLEDGE ENGINE   (App.OnlineAI)   —   v1.0.0
   ------------------------------------------------------------------
   Offline-first. Decides per question whether Khaata's own built-in
   knowledge is enough, or whether it needs to go online — and only
   goes online when it actually needs to. Everything below is
   additive: it does not touch App.Chat's transaction slot-filling
   flow, any save*() function, or any existing UI. It plugs into
   App.Chat as one new early branch (see the small, clearly-marked
   edit inside App.Chat.startFlowFromMessage below) so a message
   that isn't a transaction — a genuine question — gets answered
   instead of triggering "Is this an income or expense?".

   No API keys. No paid services. No cloud account dependency.
   Every network call below hits a free, key-less, CORS-enabled
   public endpoint (Wikipedia's REST API, CoinGecko's public price
   API). Where no reliable key-less live-data endpoint exists for a
   category (stock prices, mutual fund NAVs, gold/silver rates, tax
   slabs, government schemes) the engine does NOT invent a number —
   it says so plainly and points to the trusted official source to
   check, with full attribution. Honest "I don't know, here's where
   to look" beats a confident, possibly-stale, fabricated figure.

   Module map (all namespaced under App.OnlineAI):
     App.OnlineAI.Config          trusted-source list, cache TTLs
     App.OnlineAI.Logger          scoped logging (delegates to App.Logger)
     App.OnlineAI.DecisionEngine  classifies a question: finance / investment
                                   / tax / stock / government-scheme /
                                   mutual-fund / gold-silver / crypto /
                                   general-knowledge / not-a-question
     App.OnlineAI.Knowledge       offline FAQ answers for common finance
                                   terms — answered instantly, no network
     App.OnlineAI.SourceManager   builds/formats the source-name + website
                                   + published/last-updated + confidence
                                   block attached to every online answer
     App.OnlineAI.Cache           localStorage cache of recent online
                                   answers, TTL per category, so the same
                                   question twice doesn't re-search
     App.OnlineAI.Search          the actual key-less online lookups
                                   (Wikipedia, CoinGecko) + the honest
                                   "trusted sources, no live fetch"
                                   fallback for categories with no
                                   key-less live-data API
     App.OnlineAI.Sync            architecture-ready hook for folding the
                                   cache into a future Drive backup, and a
                                   provider registry so more online
                                   sources can be added later without
                                   touching Manager/Search again
     App.OnlineAI.Manager         the façade other code calls: ask(text)
================================================================ */
App.OnlineAI = {};

App.OnlineAI.Config = {
  VERSION: '1.0.0',
  CACHE_PREFIX: 'khaata:onlineai:cache:',
  CACHE_TTL_MS: {
    generalKnowledge: 7*24*60*60*1000,   // slow-changing — a week is fine
    crypto:           5*60*1000,          // fast-changing — 5 minutes
    default:          24*60*60*1000
  },
  MAX_CACHE_ENTRIES: 100,
  SEARCH_TIMEOUT_MS: 8000,
  // Trusted official/well-known sources for the categories where Khaata
  // will NOT fetch or guess a live figure (see Search.referenceOnly below).
  TRUSTED_SOURCES: {
    stock:        [{name:'NSE India', url:'https://www.nseindia.com'}, {name:'BSE India', url:'https://www.bseindia.com'}],
    mutualFund:   [{name:'AMFI India', url:'https://www.amfiindia.com'}, {name:'Value Research', url:'https://www.valueresearchonline.com'}],
    tax:          [{name:'Income Tax Department, Govt. of India', url:'https://www.incometax.gov.in'}],
    goldSilver:   [{name:'India Bullion and Jewellers Association (IBJA)', url:'https://www.ibja.co'}, {name:'Good Returns Gold Rates', url:'https://www.goodreturns.in/gold-rates/'}],
    govtScheme:   [{name:'MyScheme, Govt. of India', url:'https://www.myscheme.gov.in'}, {name:'India.gov.in National Portal', url:'https://www.india.gov.in'}],
    investment:   [{name:'RBI', url:'https://www.rbi.org.in'}, {name:'SEBI Investor Website', url:'https://investor.sebi.gov.in'}],
    finance:      [{name:'RBI', url:'https://www.rbi.org.in'}],
    crypto:       [{name:'CoinGecko', url:'https://www.coingecko.com'}],
    generalKnowledge: [{name:'Wikipedia', url:'https://www.wikipedia.org'}]
  }
};

/* ---------------------------------------------------------------
   LOGGER — same shape as App.Attachments.Logger / App.Reports.Logger
--------------------------------------------------------------- */
App.OnlineAI.Logger = (function(){
  const MAX_LOG = 150;
  const log = [];
  function push(level, args){
    log.push({ level, at: new Date().toISOString(), msg: args.map(a=> a instanceof Error ? a.message : (typeof a==='object'? JSON.stringify(a): String(a))).join(' ') });
    if(log.length > MAX_LOG) log.shift();
  }
  return {
    info:(...a)=>{ push('info',a); console.log('[OnlineAI]', ...a); },
    warn:(...a)=>{ push('warn',a); console.warn('[OnlineAI]', ...a); },
    error:(...a)=>{ push('error',a); console.error('[OnlineAI]', ...a); },
    getLog:()=> log.slice()
  };
})();

/* ---------------------------------------------------------------
   DECISION ENGINE — is this even a question? which category?
   does it need to go online, or can offline knowledge answer it?
--------------------------------------------------------------- */
App.OnlineAI.DecisionEngine = (function(){
  // Order matters — more specific finance categories are checked before
  // the generic 'finance'/'investment' catch-alls.
  const PATTERNS = [
    ['tax',            /\b(income tax|itr|tds|tax slab|tax deduction|80c|80d|gst|capital gains tax)\b/i],
    ['stock',          /\b(share price|stock price|nifty|sensex|nse|bse|stock market|equity market)\b/i],
    ['mutualFund',     /\b(mutual fund|nav\b|elss|amfi|sip return|expense ratio)\b/i],
    ['goldSilver',     /\b(gold price|gold rate|silver price|silver rate|sona (ka|ki)? bhaav|chandi (ka|ki)? bhaav|22k|24k gold)\b/i],
    ['crypto',         /\b(bitcoin|btc|ethereum|\beth\b|crypto|cryptocurrency|dogecoin|solana|litecoin|cardano|\bxrp\b|binance coin|bnb\b)\b/i],
    ['govtScheme',     /\b(yojana|govt(\.|ernment)? scheme|sarkari scheme|pradhan mantri|pm kisan|pm awas|subsidy scheme)\b/i],
    ['investment',     /\b(ppf|nps\b|fixed deposit rate|fd interest rate|invest(ing|ment)? advice|nivesh kaise)\b/i],
    ['finance',        /\b(repo rate|inflation rate|rbi policy|loan interest rate|home loan rate)\b/i]
  ];
  const QUESTION_START = /^(what|who|when|where|why|how|which|is|are|does|do|can|could|will|should|kya|kaun|kab|kahan|kyun|kaise|kitna|kitni)\b/i;

  function isQuestion(text){
    const t = (text||'').trim();
    if(!t) return false;
    return QUESTION_START.test(t) || /\?\s*$/.test(t);
  }

  // Returns a category string, or null if this doesn't look like a
  // knowledge question at all (i.e. App.Chat should treat it as a
  // possible transaction, exactly as it always has).
  function classify(text){
    const t = (text||'').toLowerCase();
    if(!t.trim()) return null;
    for(const [cat, re] of PATTERNS){ if(re.test(t)) return cat; }
    if(isQuestion(t)) return 'generalKnowledge';
    return null;
  }

  function needsOnline(category){
    // Offline knowledge is only ever attempted for the finance-flavoured
    // categories (Manager checks App.OnlineAI.Knowledge first regardless);
    // this flag just documents that every recognised category *can*
    // fall through to an online lookup if offline knowledge misses.
    return !!category;
  }

  return { classify, isQuestion, needsOnline, PATTERNS };
})();

/* ---------------------------------------------------------------
   OFFLINE KNOWLEDGE — instant answers for common finance terms,
   no network involved at all. Checked before anything online.
--------------------------------------------------------------- */
App.OnlineAI.Knowledge = (function(){
  const FAQ = [
    { match:/\bsip\b/i, topic:'SIP (Systematic Investment Plan)',
      answer:'An SIP lets you invest a fixed amount into a mutual fund at regular intervals (usually monthly) instead of investing a lump sum. It builds discipline and averages your purchase cost over time (rupee-cost averaging).' },
    { match:/\bppf\b/i, topic:'PPF (Public Provident Fund)',
      answer:'PPF is a long-term (15-year) government-backed savings scheme in India. Interest earned is tax-free and contributions qualify for deduction under Section 80C, but there is an annual contribution limit and a lock-in period — check the current limit online since it can change.' },
    { match:/\belss\b/i, topic:'ELSS (Equity Linked Savings Scheme)',
      answer:'ELSS is a mutual fund category that invests mainly in equities and qualifies for tax deduction under Section 80C. It has a mandatory 3-year lock-in — the shortest among the common 80C options.' },
    { match:/\bnps\b/i, topic:'NPS (National Pension System)',
      answer:'NPS is a government-regulated retirement savings scheme in India. Contributions get market-linked returns and additional tax benefits under Section 80CCD(1B), with restrictions on withdrawal before retirement.' },
    { match:/\bemi\b/i, topic:'EMI (Equated Monthly Instalment)',
      answer:'An EMI is the fixed monthly payment you make to repay a loan, made up of a principal portion and an interest portion. Early in the loan more of each EMI goes toward interest; later, more goes toward principal.' },
    { match:/\bcompound interest\b|\bchakravriddhi\b/i, topic:'Compound Interest',
      answer:'Compound interest is interest calculated on both the original amount and the interest already earned, so money grows faster the longer it stays invested — this is why starting early usually matters more than the amount you start with.' },
    { match:/\bcredit score\b|\bcibil\b/i, topic:'Credit Score / CIBIL Score',
      answer:'A credit score (like a CIBIL score in India, roughly in the 300-900 range) reflects how reliably you repay debt. Paying bills and EMIs on time, keeping credit card usage low, and not applying for too much new credit at once all help keep it high.' },
    { match:/\bemergency fund\b/i, topic:'Emergency Fund',
      answer:'An emergency fund is money set aside — usually 3 to 6 months of expenses — kept somewhere easily accessible, for unexpected situations like a job loss or medical emergency, so you don\u2019t have to take a loan or break long-term investments.' },
    { match:/\b80c\b/i, topic:'Section 80C',
      answer:'Section 80C of India\u2019s Income Tax Act lets you reduce taxable income by investing in specific options — PPF, ELSS, life insurance premiums, EPF, tax-saving fixed deposits and more — up to a combined limit. The exact limit changes with the budget, so check the Income Tax Department site for the current figure.' },
    { match:/\bfixed deposit\b|\bwhat is (an? )?fd\b/i, topic:'Fixed Deposit (FD)',
      answer:'A Fixed Deposit is a lump sum you deposit with a bank for a fixed period at a fixed interest rate, generally higher than a regular savings account. Withdrawing it early usually costs a penalty on the interest earned.' },
    { match:/\bwhat is khaata\b|\babout khaata\b/i, topic:'Khaata',
      answer:'Khaata is your personal finance manager — it tracks income, expenses, budgets, recurring items, debts, goals, credit cards, investments and net worth, all in one place, with optional Google Drive backup.' }
  ];
  function lookup(text){
    const entry = FAQ.find(f=> f.match.test(text||''));
    if(!entry) return null;
    return {
      topic: entry.topic,
      answer: entry.answer,
      source: App.OnlineAI.SourceManager.build({ name:'Khaata built-in knowledge base', url:null, confidence:'high' })
    };
  }
  return { lookup, FAQ };
})();

/* ---------------------------------------------------------------
   SOURCE MANAGER — every online answer carries source name, website,
   published date (if known), last-updated timestamp, confidence.
--------------------------------------------------------------- */
App.OnlineAI.SourceManager = (function(){
  function build({name, url, publishedDate, lastUpdated, confidence}){
    let website = null;
    if(url){ try{ website = new URL(url).hostname.replace(/^www\./,''); }catch(e){ website = url; } }
    return {
      sourceName: name || 'Unknown source',
      website,
      url: url || null,
      publishedDate: publishedDate || null,
      lastUpdated: lastUpdated || new Date().toISOString(),
      confidence: confidence || 'medium'
    };
  }
  function format(sources){
    if(!sources || !sources.length) return '';
    return sources.map(s=>{
      const bits = [s.sourceName];
      if(s.website) bits.push(`(${s.website})`);
      if(s.publishedDate) bits.push(`— published ${s.publishedDate}`);
      bits.push(`[${s.confidence} confidence]`);
      return '• ' + bits.join(' ');
    }).join('\n');
  }
  return { build, format };
})();

/* ---------------------------------------------------------------
   CACHE — localStorage, per-category TTL, LRU-ish trim. Avoids
   repeated online searches for the same question.
--------------------------------------------------------------- */
App.OnlineAI.Cache = (function(){
  function keyFor(category, text){
    return App.OnlineAI.Config.CACHE_PREFIX + category + ':' +
      (text||'').trim().toLowerCase().replace(/\s+/g,'_').slice(0,80);
  }
  function get(category, text){
    try{
      const raw = localStorage.getItem(keyFor(category, text));
      if(!raw) return null;
      const rec = JSON.parse(raw);
      const ttl = App.OnlineAI.Config.CACHE_TTL_MS[category] || App.OnlineAI.Config.CACHE_TTL_MS.default;
      if(Date.now() - rec.cachedAt > ttl){ localStorage.removeItem(keyFor(category, text)); return null; }
      return rec.data;
    }catch(e){ return null; }
  }
  function set(category, text, data){
    try{
      localStorage.setItem(keyFor(category, text), JSON.stringify({ cachedAt: Date.now(), data }));
      trim();
    }catch(e){ App.OnlineAI.Logger.warn('Cache.set failed', e); }
  }
  function trim(){
    try{
      const keys = Object.keys(localStorage).filter(k=> k.startsWith(App.OnlineAI.Config.CACHE_PREFIX));
      if(keys.length <= App.OnlineAI.Config.MAX_CACHE_ENTRIES) return;
      const entries = keys.map(k=>{
        try{ return { k, t: JSON.parse(localStorage.getItem(k)).cachedAt||0 }; }
        catch(e){ return { k, t:0 }; }
      }).sort((a,b)=> a.t-b.t);
      const excess = entries.length - App.OnlineAI.Config.MAX_CACHE_ENTRIES;
      for(let i=0;i<excess;i++) localStorage.removeItem(entries[i].k);
    }catch(e){ /* best-effort */ }
  }
  function clear(){
    try{ Object.keys(localStorage).filter(k=> k.startsWith(App.OnlineAI.Config.CACHE_PREFIX)).forEach(k=> localStorage.removeItem(k)); }
    catch(e){ /* best-effort */ }
  }
  return { get, set, clear, keyFor };
})();

/* ---------------------------------------------------------------
   SYNC — architecture-ready hook, not wired into anything yet.
   Mirrors App.Memory.Manager.backupPrepare()'s pattern so a future
   sprint can fold OnlineAI's cache into the same Drive backup blob
   without redesigning anything here. Also doubles as a light
   "search provider registry" so future multi-provider search can
   register a new source without Manager/Search changing shape.
--------------------------------------------------------------- */
App.OnlineAI.Sync = (function(){
  function backupPrepare(){
    try{
      const keys = Object.keys(localStorage).filter(k=> k.startsWith(App.OnlineAI.Config.CACHE_PREFIX));
      const payload = {};
      keys.forEach(k=>{ try{ payload[k] = JSON.parse(localStorage.getItem(k)); }catch(e){ /* skip bad entry */ } });
      return { version: App.OnlineAI.Config.VERSION, cache: payload };
    }catch(e){ App.OnlineAI.Logger.warn('Sync.backupPrepare failed', e); return null; }
  }
  function restoreFromBackup(payload){
    if(!payload || !payload.cache) return;
    try{ Object.keys(payload.cache).forEach(k=> localStorage.setItem(k, JSON.stringify(payload.cache[k]))); }
    catch(e){ App.OnlineAI.Logger.warn('Sync.restoreFromBackup failed', e); }
  }
  const providers = []; // future: {id, category, run(text)} entries
  function registerProvider(p){ providers.push(p); App.OnlineAI.Logger.info('provider registered', p && p.id); }
  function listProviders(){ return providers.slice(); }
  return { backupPrepare, restoreFromBackup, registerProvider, listProviders };
})();

/* ---------------------------------------------------------------
   SEARCH — the actual key-less online lookups. Wikipedia for
   general knowledge, CoinGecko for crypto prices — both free,
   key-less, CORS-enabled public APIs. Every other recognised
   category gets an honest "here's where to check" reference
   answer instead of a fabricated live number.
--------------------------------------------------------------- */
App.OnlineAI.Search = (function(){
  const CFG = App.OnlineAI.Config;

  function fetchWithTimeout(url, opts){
    const ctrl = new AbortController();
    const timer = setTimeout(()=> ctrl.abort(), CFG.SEARCH_TIMEOUT_MS);
    return fetch(url, Object.assign({ signal: ctrl.signal }, opts||{})).finally(()=> clearTimeout(timer));
  }

  function extractTopic(text){
    let s = (text||'').trim().replace(/\?+$/,'');
    s = s.replace(/^(what is|what are|what was|who is|who was|who are|explain|define|tell me about|meaning of|kya hai|kya hota hai|kaun hai)\s+/i,'');
    return s.trim() || text;
  }

  async function generalKnowledge(text){
    const topic = extractTopic(text);
    try{
      let title = topic;
      // Resolve the best-matching Wikipedia title first (opensearch,
      // origin=* makes it CORS-friendly without any key).
      const osRes = await fetchWithTimeout(`https://en.wikipedia.org/w/api.php?action=opensearch&limit=1&namespace=0&format=json&origin=*&search=${encodeURIComponent(topic)}`);
      if(osRes.ok){
        const osData = await osRes.json();
        if(osData && osData[1] && osData[1][0]) title = osData[1][0];
      }
      const res = await fetchWithTimeout(`https://en.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(title)}`);
      if(!res.ok) throw new Error('Wikipedia summary returned ' + res.status);
      const data = await res.json();
      if(!data.extract) throw new Error('No summary text in response');
      return {
        ok: true,
        answer: data.extract,
        sources: [ App.OnlineAI.SourceManager.build({
          name: 'Wikipedia',
          url: (data.content_urls && data.content_urls.desktop && data.content_urls.desktop.page) || ('https://en.wikipedia.org/wiki/' + encodeURIComponent(title)),
          lastUpdated: new Date().toISOString(),
          confidence: 'medium'
        }) ]
      };
    }catch(err){
      App.OnlineAI.Logger.warn('generalKnowledge search failed:', err);
      return { ok:false, error: err.message };
    }
  }

  const COIN_IDS = {
    bitcoin:'bitcoin', btc:'bitcoin', ethereum:'ethereum', eth:'ethereum',
    dogecoin:'dogecoin', solana:'solana', litecoin:'litecoin', cardano:'cardano',
    ripple:'ripple', xrp:'ripple', tether:'tether', bnb:'binancecoin', binance:'binancecoin'
  };
  async function crypto(text){
    const tl = (text||'').toLowerCase();
    let coinId = 'bitcoin';
    for(const k in COIN_IDS){ if(tl.includes(k)){ coinId = COIN_IDS[k]; break; } }
    try{
      const res = await fetchWithTimeout(`https://api.coingecko.com/api/v3/simple/price?ids=${coinId}&vs_currencies=inr,usd&include_last_updated_at=true`);
      if(!res.ok) throw new Error('CoinGecko returned ' + res.status);
      const data = await res.json();
      const d = data[coinId];
      if(!d) throw new Error('No price data for ' + coinId);
      const label = coinId.charAt(0).toUpperCase() + coinId.slice(1);
      const updated = d.last_updated_at ? new Date(d.last_updated_at*1000).toISOString() : new Date().toISOString();
      return {
        ok: true,
        answer: `${label}: ₹${Number(d.inr).toLocaleString('en-IN')} (~$${d.usd})`,
        sources: [ App.OnlineAI.SourceManager.build({
          name: 'CoinGecko', url: `https://www.coingecko.com/en/coins/${coinId}`,
          lastUpdated: updated, confidence: 'high'
        }) ]
      };
    }catch(err){
      App.OnlineAI.Logger.warn('crypto search failed:', err);
      return { ok:false, error: err.message };
    }
  }

  // Honest fallback for categories with no reliable key-less live-data
  // API (stock prices, mutual fund NAVs, gold/silver rates, tax slabs,
  // government schemes, general investment/finance advice). Never
  // fabricates a number — points to official trusted sources instead.
  function referenceOnly(category){
    const list = CFG.TRUSTED_SOURCES[category] || [];
    const sources = list.map(s=> App.OnlineAI.SourceManager.build({ name:s.name, url:s.url, confidence:'informational' }));
    const label = {
      tax:'tax', stock:'stock market', mutualFund:'mutual fund', goldSilver:'gold/silver price',
      govtScheme:'government scheme', investment:'investment', finance:'finance'
    }[category] || category;
    return {
      ok: true,
      requiresManualCheck: true,
      answer: `I can't pull a live ${label} figure without an API key or a paid data feed, and I'd rather not guess a number that changes daily. Here are trusted sources to check the current ${label} info yourself:`,
      sources
    };
  }

  async function run(category, text){
    // Any provider registered via App.OnlineAI.Sync.registerProvider()
    // for this category gets first refusal — keeps this function stable
    // as more providers are added in future sprints.
    const provider = App.OnlineAI.Sync.listProviders().find(p=> p.category===category);
    if(provider){
      try{ const r = await provider.run(text); if(r && r.ok) return r; }
      catch(e){ App.OnlineAI.Logger.warn('registered provider failed', e); }
    }
    switch(category){
      case 'generalKnowledge': { const r = await generalKnowledge(text); return r.ok ? r : referenceOnly('generalKnowledge'); }
      case 'crypto':           { const r = await crypto(text);           return r.ok ? r : referenceOnly('crypto'); }
      case 'tax': case 'stock': case 'mutualFund': case 'goldSilver':
      case 'govtScheme': case 'investment': case 'finance':
        return referenceOnly(category);
      default:
        return referenceOnly(category);
    }
  }

  return { run, extractTopic, generalKnowledge, crypto, referenceOnly };
})();

/* ---------------------------------------------------------------
   MANAGER — the façade. Offline-first: tries Knowledge, then Cache,
   then a live Search, in that order, and only ever goes online when
   offline knowledge genuinely doesn't have the answer.
--------------------------------------------------------------- */
App.OnlineAI.Manager = (function(){
  function formatReply(answer, sources, opts){
    opts = opts || {};
    let out = answer;
    if(sources && sources.length){
      out += '\n\n' + (opts.manualCheck ? 'Trusted sources to check:' : 'Source:') + '\n' + App.OnlineAI.SourceManager.format(sources);
    }
    if(opts.wasOnline && !opts.manualCheck){
      out += opts.fromCache ? '\n(from a recent cached search)' : '\n(fetched online just now)';
    }
    return out;
  }

  async function ask(text){
    const category = App.OnlineAI.DecisionEngine.classify(text);
    if(!category) return { handled:false };
    App.OnlineAI.Logger.info('classified "'+text+'" as', category);

    // 1) Offline knowledge — instant, no network, always tried first.
    const offline = App.OnlineAI.Knowledge.lookup(text);
    if(offline){
      return { handled:true, category, reply: formatReply(offline.answer, [offline.source], {}) };
    }

    // 2) Cache — same question asked recently.
    const cached = App.OnlineAI.Cache.get(category, text);
    if(cached){
      return { handled:true, category, fromCache:true,
        reply: formatReply(cached.answer, cached.sources, { wasOnline:true, fromCache:true }) };
    }

    // 3) Live search — only reached when offline knowledge and cache
    // both miss, and only if we can plausibly be online.
    if(typeof navigator!=='undefined' && navigator.onLine===false){
      return { handled:true, category,
        reply: "I'd need internet access to look that up, and it looks like you're offline right now. I'll check as soon as you're back online." };
    }
    try{
      const result = await App.OnlineAI.Search.run(category, text);
      if(result && result.ok){
        if(!result.requiresManualCheck) App.OnlineAI.Cache.set(category, text, { answer: result.answer, sources: result.sources });
        return { handled:true, category,
          reply: formatReply(result.answer, result.sources, { wasOnline:true, manualCheck: !!result.requiresManualCheck }) };
      }
      return { handled:true, category, reply: "I looked online but couldn't get a reliable answer to that just now. You could try rephrasing, or check again in a bit." };
    }catch(err){
      App.OnlineAI.Logger.error('Manager.ask failed', err);
      return { handled:true, category, reply: "Something went wrong while I was checking that online. Please try again." };
    }
  }

  function init(){
    App.OnlineAI.Logger.info('Online AI Knowledge Engine ready — v' + App.OnlineAI.Config.VERSION);
  }

  return { init, ask };
})();

/* Entry point App.Chat calls for any message that isn't recognised as a
   transaction to log — see the small additive branch inside
   App.Chat.startFlowFromMessage. Kept as a thin top-level alias so other
   future callers (Voice, Reports "ask a question" box, etc.) don't need
   to know the module's internal structure. */
function askOnlineAI(text){ return App.OnlineAI.Manager.ask(text); }



/* ================================================================
   PERSONAL AI FINANCIAL ADVISOR   (App.Advisor)   —   v1.0.0   Sprint 20
   ------------------------------------------------------------------
   Proactive layer on top of the app. It does NOT recompute the Health
   Score, spending intelligence, anomaly detection, or emergency-fund
   target math the app already has — App.Advisor.Manager calls straight
   into computeHealthScoreDetail(), getEmergencyFundGoal(),
   computeGoalPlan(), essentialExpenseTxns(), ccUtilization(),
   debtRemaining(), etc. (all defined earlier in this file, powering the
   existing "Insights" and "AI Reports" tabs) rather than duplicating
   that logic. What this module adds that didn't exist before:

     App.Advisor.Config           thresholds (all offline, no tuning UI)
     App.Advisor.Logger           scoped logging + personalization memory
                                   (which recommendations were shown /
                                   dismissed, so repeats are spaced out —
                                   backed by state.advisor, new this sprint)
     App.Advisor.Analysis         daily/monthly/yearly income, expense,
                                   savings, cash-flow, investment and loan
                                   pattern rollups (new aggregation; reuses
                                   expenseTxns/incomeTxns/sum/monthsRange
                                   etc., does not re-derive the Health
                                   Score itself)
     App.Advisor.Budget           budget-usage suggestions: over/near
                                   limit, un-budgeted big categories,
                                   consistently oversized budgets
     App.Advisor.Savings          subscription detection (declared in
                                   Recurring + untracked repeat charges),
                                   emergency-fund target/gap
     App.Advisor.Goals            goal-pace nudges (wraps
                                   computeGoalPlan/computeGoalStatus)
     App.Advisor.Risk             loan repayment priority (avalanche
                                   order) + a conservative, rule-based
                                   investment-readiness score — new
     App.Advisor.Notifications    real-time save-time checks (duplicate
                                   entry, abnormal amount, budget
                                   overspend, low account balance) +
                                   the toast that shows them — new
     App.Advisor.Recommendations  aggregates Budget/Savings/Goals/Risk
                                   output, applies the dismissed-cooldown
                                   filter, sorts by priority — new
     App.Advisor.Manager          run()/getSnapshot()/init() — the
                                   façade everything else calls; caches
                                   the last run in state.advisor.snapshot
     App.Advisor.UI                render() for the new "AI Advisor" tab
                                   (id="view-advisor")

   No paid APIs, no network calls — everything below reads only from
   `state` (already in memory) and localStorage, same as every other
   module in this file. Nothing here alters state.transactions,
   state.budgets, state.goals, state.debts, etc. — it only reads them
   and writes to its own state.advisor key.
================================================================ */

App.Advisor.Config = {
  VERSION: '1.0.0',
  DISMISS_COOLDOWN_DAYS: 14,     // a dismissed recommendation stays hidden this long
  LARGE_EXPENSE_MULTIPLIER: 3,   // vs. the category's own recent average
  DUPLICATE_WINDOW_DAYS: 1,      // same amount+category within this many days = possible duplicate
  SUBSCRIPTION_MIN_MONTHS: 2,    // same item/category/~amount repeating this many consecutive recent months
  LOW_BALANCE_BUFFER_DAYS: 3,    // account balance under (avg daily spend * this) triggers a warning
  BUDGET_NEAR_LIMIT_PCT: 90,     // warn before hitting 100%
  MAX_SHOWN_LOG: 200
};

App.Advisor.Logger = {
  info: (...a)=>App.Logger.info('[Advisor]', ...a),
  warn: (...a)=>App.Logger.warn('[Advisor]', ...a),
  error: (...a)=>App.Logger.error('[Advisor]', ...a),
  // Personalization: remembers a recommendation was shown, and lets the
  // rest of the module check whether the user dismissed it recently so
  // the same suggestion doesn't get repeated every single run.
  record(id){
    const log = state.advisor.shownLog;
    log.push({id, ts: new Date().toISOString()});
    if(log.length > App.Advisor.Config.MAX_SHOWN_LOG) log.splice(0, log.length - App.Advisor.Config.MAX_SHOWN_LOG);
  },
  dismiss(id){
    state.advisor.dismissed[id] = new Date().toISOString();
    saveAdvisor();
  },
  isDismissed(id){
    const ts = state.advisor.dismissed[id];
    if(!ts) return false;
    const days = (Date.now() - new Date(ts).getTime()) / 86400000;
    return days < App.Advisor.Config.DISMISS_COOLDOWN_DAYS;
  }
};

App.Advisor.Analysis = {
  /* Daily/monthly/yearly income, expense, savings, cash-flow, investment
     and loan pattern rollup. Built from the same primitives every other
     tab already uses (expenseTxns/incomeTxns/sum/monthsRange/etc.) —
     this just aggregates them into one snapshot for the Advisor to
     reason over, it doesn't re-derive anything those functions already
     compute for the Health Score or Insights tab. */
  patterns(){
    const exp = expenseTxns(), inc = incomeTxns();
    const months = monthsRange();
    const monthlyExpense = months.map(m=>({m, total: sum(exp.filter(t=>monthKey(t.date)===m))}));
    const monthlyIncome = months.map(m=>({m, total: sum(inc.filter(t=>monthKey(t.date)===m))}));

    const trendOf = (arr)=>{
      if(arr.length<2) return 'insufficient-data';
      const half = Math.floor(arr.length/2);
      const firstAvg = arr.slice(0,half).reduce((s,x)=>s+x.total,0) / Math.max(1,half);
      const secondAvg = arr.slice(half).reduce((s,x)=>s+x.total,0) / Math.max(1, arr.length-half);
      if(firstAvg<=0 && secondAvg<=0) return 'flat';
      const pct = firstAvg>0 ? ((secondAvg-firstAvg)/firstAvg*100) : (secondAvg>0 ? 100 : 0);
      if(pct>10) return 'rising';
      if(pct<-10) return 'falling';
      return 'stable';
    };

    const totalIncome = sum(inc), totalExpense = sum(exp);
    const savingsRate = totalIncome>0 ? (totalIncome-totalExpense)/totalIncome*100 : null;

    const from = startOfMonth(0), to = endOfMonth(0), today = todayStr();
    const monthExpSoFar = sum(exp.filter(t=>dateInRange(t.date, from, today)));
    const monthIncSoFar = sum(inc.filter(t=>dateInRange(t.date, from, today)));
    const dayOfMonth = new Date().getDate();
    const daysInMonth = new Date(new Date().getFullYear(), new Date().getMonth()+1, 0).getDate();
    const projectedExpense = dayOfMonth>0 ? (monthExpSoFar/dayOfMonth)*daysInMonth : monthExpSoFar;

    const totalInvested = (state.investments||[]).reduce((s,i)=>s+(Number(i.invested)||0),0);
    const totalCurrentValue = (state.investments||[]).reduce((s,i)=>s+(Number(i.currentValue)||0),0);

    const iOwe = (state.debts||[]).filter(d=>d.type==='i_owe' && !d.settled).reduce((s,d)=>s+debtRemaining(d),0);
    const owedToMe = (state.debts||[]).filter(d=>d.type==='owed_to_me' && !d.settled).reduce((s,d)=>s+debtRemaining(d),0);

    const budgetUsage = Object.keys(state.budgets||{}).map(c=>{
      const budget = Number(state.budgets[c])||0;
      const actual = sum(exp.filter(t=>t.category===c && dateInRange(t.date, from, to)));
      return {category:c, budget, actual, pct: budget>0 ? (actual/budget*100) : null};
    });

    const byDay = {}; exp.forEach(t=>byDay[t.date]=(byDay[t.date]||0)+Number(t.amount));
    const dayVals = Object.values(byDay);
    const avgDailySpend = dayVals.length ? dayVals.reduce((a,b)=>a+b,0)/dayVals.length : 0;

    const byWeekday = [0,0,0,0,0,0,0], byWeekdayCount = [0,0,0,0,0,0,0];
    exp.forEach(t=>{ const wd = new Date(t.date).getDay(); byWeekday[wd]+=Number(t.amount); byWeekdayCount[wd]++; });
    const weekdayNames = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
    let topWeekdayIdx = -1, topWeekdayAvg = 0;
    byWeekday.forEach((total,i)=>{ const avg = byWeekdayCount[i] ? total/byWeekdayCount[i] : 0; if(avg>topWeekdayAvg){ topWeekdayAvg=avg; topWeekdayIdx=i; } });

    const byYear = {}; exp.forEach(t=>{ const y=t.date.slice(0,4); byYear[y]=(byYear[y]||0)+Number(t.amount); });
    const years = Object.keys(byYear).sort();
    const thisYear = String(new Date().getFullYear());
    const lastYear = String(new Date().getFullYear()-1);

    return {
      income: {total: totalIncome, monthly: monthlyIncome, trend: trendOf(monthlyIncome)},
      expense: {total: totalExpense, monthly: monthlyExpense, trend: trendOf(monthlyExpense)},
      savings: {rate: savingsRate},
      cashFlow: {monthExpSoFar, monthIncSoFar, projectedExpense, dayOfMonth, daysInMonth},
      investment: {totalInvested, totalCurrentValue, unrealizedPL: totalCurrentValue-totalInvested},
      loan: {iOwe, owedToMe},
      budgetUsage,
      daily: {avgDailySpend, topWeekday: topWeekdayIdx>=0 ? weekdayNames[topWeekdayIdx] : null, topWeekdayAvg},
      monthly: {avg: monthlyExpense.length ? monthlyExpense.reduce((s,x)=>s+x.total,0)/monthlyExpense.length : 0},
      yearly: {byYear, thisYear: byYear[thisYear]||0, lastYear: byYear[lastYear]||0, hasMultiYear: years.length>=2}
    };
  }
};

App.Advisor.Budget = {
  suggestions(patterns){
    const out = [];
    const exp = expenseTxns();
    const from = startOfMonth(0), to = endOfMonth(0);
    const daysLeft = Math.max(0, new Date(to).getDate() - new Date().getDate());

    (patterns.budgetUsage||[]).forEach(b=>{
      if(b.pct==null) return;
      if(b.pct>=100){
        out.push({id:'budget-over-'+b.category+'-'+monthKey(todayStr()), type:'budget', dot:'bad', priority:9,
          text:`You've gone <b>${(b.pct-100).toFixed(0)}%</b> over your <b>${b.category}</b> budget this month (${fmt(b.actual)} of ${fmt(b.budget)}). Trim spending here for the rest of the month, or raise the budget if this is the new normal.`});
      } else if(b.pct>=App.Advisor.Config.BUDGET_NEAR_LIMIT_PCT){
        out.push({id:'budget-near-'+b.category+'-'+monthKey(todayStr()), type:'budget', dot:'warn', priority:6,
          text:`<b>${b.category}</b> budget is ${b.pct.toFixed(0)}% used with ${daysLeft} day(s) left this month.`});
      }
    });

    const byCat = {}; exp.filter(t=>dateInRange(t.date,from,to)).forEach(t=>byCat[t.category]=(byCat[t.category]||0)+Number(t.amount));
    const totalExp = Object.values(byCat).reduce((a,b)=>a+b,0);
    Object.entries(byCat).forEach(([c,amt])=>{
      if(!(c in (state.budgets||{})) && totalExp>0 && amt/totalExp>0.12 && amt>500){
        out.push({id:'budget-missing-'+c, type:'budget', dot:'info', priority:4,
          text:`<b>${c}</b> is a significant expense this month (${fmt(amt)}, ${(amt/totalExp*100).toFixed(0)}% of total) but has no budget set. A budget here can help catch overspending early.`});
      }
    });

    const last3 = monthsRange().slice(-3);
    Object.keys(state.budgets||{}).forEach(c=>{
      const budget = Number(state.budgets[c])||0;
      if(budget<=0 || last3.length<3) return;
      const underAll = last3.every(m=> sum(exp.filter(t=>t.category===c && monthKey(t.date)===m)) < budget*0.5);
      if(underAll){
        out.push({id:'budget-oversized-'+c, type:'budget', dot:'info', priority:3,
          text:`Your <b>${c}</b> budget of ${fmt(budget)} has gone under 50% used for 3 straight months. Consider reallocating some of it toward savings or a goal.`});
      }
    });

    return out;
  }
};

App.Advisor.Savings = {
  subscriptions(){
    const tracked = (state.recurring||[]).filter(r=>r.active && r.type==='expense');
    const exp = expenseTxns();
    const months = monthsRange().slice(-4);
    const groups = {};
    exp.forEach(t=>{
      if(!months.includes(monthKey(t.date))) return;
      const key = (t.item||t.category).toLowerCase()+'|'+t.category+'|'+Math.round(Number(t.amount)/10)*10;
      (groups[key] = groups[key]||[]).push(t);
    });
    const detected = [];
    Object.values(groups).forEach(txns=>{
      const monthsHit = new Set(txns.map(t=>monthKey(t.date)));
      if(monthsHit.size >= App.Advisor.Config.SUBSCRIPTION_MIN_MONTHS){
        const name = txns[0].item || txns[0].category;
        const already = tracked.some(r=>(r.name||'').toLowerCase()===name.toLowerCase());
        if(!already){
          detected.push({name, category: txns[0].category, amount: Number(txns[txns.length-1].amount), monthsHit: monthsHit.size});
        }
      }
    });
    return {tracked, detected};
  },
  emergencyFund(){
    const efGoal = getEmergencyFundGoal();
    const essential = essentialExpenseTxns();
    const months = monthsRange().slice(-3);
    const avgEssentialMonthly = months.length
      ? months.reduce((s,m)=> s + sum(essential.filter(t=>monthKey(t.date)===m)), 0) / months.length
      : 0;
    const bufferMonths = (state.settings && state.settings.bufferMonths) || 3;
    const target = avgEssentialMonthly * bufferMonths;
    if(!efGoal) return {hasGoal:false, target, avgEssentialMonthly, bufferMonths};
    const saved = sum(efGoal.contributions||[]);
    const goalTarget = Number(efGoal.cost)||target;
    return {hasGoal:true, target: goalTarget, saved, pct: goalTarget>0 ? Math.min(100, saved/goalTarget*100) : null, avgEssentialMonthly, bufferMonths};
  },
  suggestions(patterns){
    const out = [];
    const {detected} = App.Advisor.Savings.subscriptions();
    detected.forEach(d=>{
      out.push({id:'sub-'+d.name.toLowerCase().replace(/\s+/g,'-'), type:'savings', dot:'info', priority:5,
        text:`<b>${d.name}</b> (${d.category}) has charged around ${fmt(d.amount)} for ${d.monthsHit} months running — looks like a recurring subscription that isn't in your Recurring list yet. Worth confirming it's still needed.`});
    });
    const ef = App.Advisor.Savings.emergencyFund();
    if(!ef.hasGoal && ef.target>0){
      out.push({id:'ef-missing', type:'savings', dot:'warn', priority:7,
        text:`No Emergency Fund goal set yet. Based on your average essential spend, a ${ef.bufferMonths}-month cushion would be about <b>${fmt(ef.target)}</b>. Add an Emergency Fund goal on the Goals tab to start tracking it.`});
    } else if(ef.hasGoal && ef.pct!=null && ef.pct<50){
      out.push({id:'ef-behind-'+monthKey(todayStr()), type:'savings', dot:'warn', priority:6,
        text:`Emergency Fund is only ${ef.pct.toFixed(0)}% funded (${fmt(ef.saved)} of ${fmt(ef.target)}). It's prioritized first in your goal funding for a reason — a top-up when you can would help.`});
    }
    if(patterns.savings.rate!=null && patterns.savings.rate<10 && patterns.income.total>0){
      out.push({id:'savings-low-rate-'+monthKey(todayStr()), type:'savings', dot:'bad', priority:8,
        text:`Your overall savings rate is ${patterns.savings.rate.toFixed(1)}% of income — under 10% leaves little room for goals or emergencies. Your highest spending category is usually the best place to start trimming.`});
    }
    return out;
  }
};

App.Advisor.Goals = {
  suggestions(patterns){
    const out = [];
    const goals = (state.goals||[]).filter(g=>!g.achieved && !g.isEmergencyFund);
    if(!goals.length) return out;
    const plan = computeGoalPlan();
    goals.forEach(g=>{
      const status = computeGoalStatus(g, plan);
      if(status==='Behind'){
        out.push({id:'goal-behind-'+g.id, type:'goals', dot:'warn', priority:5,
          text:`Goal <b>${g.name}</b> is behind pace. Try the What-If Simulator on the Insights tab to see what a small extra monthly contribution would do.`});
      } else if(status==='Not Started'){
        out.push({id:'goal-notstarted-'+g.id, type:'goals', dot:'info', priority:3,
          text:`Goal <b>${g.name}</b> hasn't had a contribution logged yet.`});
      }
    });
    if(patterns.savings.rate!=null && patterns.savings.rate>25){
      const top = goals.slice().sort((a,b)=>a.priority-b.priority)[0];
      if(top) out.push({id:'goal-surplus-'+top.id+'-'+monthKey(todayStr()), type:'goals', dot:'good', priority:2,
        text:`You're saving a healthy share of income right now — consider directing some of it toward <b>${top.name}</b>, your top-priority goal.`});
    }
    return out;
  }
};

App.Advisor.Risk = {
  /* Avalanche order: highest interest rate first, so interest cost is
     minimized. Ties broken by larger remaining balance first. */
  loanPriority(){
    return (state.debts||[])
      .filter(d=>d.type==='i_owe' && !d.settled && debtRemaining(d)>0)
      .slice()
      .sort((a,b)=> (Number(b.interest)||0)-(Number(a.interest)||0) || debtRemaining(b)-debtRemaining(a));
  },
  /* Conservative, rule-based readiness signal — not investment advice,
     just a "is now a reasonable time to prioritize investing more"
     nudge, in line with the app's existing no-guaranteed-returns stance. */
  investmentReadiness(patterns, ef){
    let score = 0; const reasons = [];
    if(ef.hasGoal && ef.pct!=null && ef.pct>=100){ score+=40; reasons.push('Emergency fund is fully funded.'); }
    else if(ef.hasGoal && ef.pct!=null && ef.pct>=50){ score+=20; reasons.push('Emergency fund is partly funded.'); }
    else reasons.push('Emergency fund is not yet adequately funded — usually the first priority before investing more.');

    if(patterns.loan.iOwe<=0){ score+=25; reasons.push('No outstanding personal debt recorded.'); }
    else if(patterns.income.total>0 && patterns.loan.iOwe/patterns.income.total < 0.2){ score+=12; reasons.push('Debt load is relatively low versus recorded income.'); }
    else reasons.push('Outstanding debt is significant relative to income — usually worth prioritizing over new investing.');

    if(patterns.savings.rate!=null && patterns.savings.rate>=20){ score+=25; reasons.push('Savings rate is healthy (20%+).'); }
    else if(patterns.savings.rate!=null && patterns.savings.rate>=10){ score+=12; reasons.push('Savings rate is moderate.'); }
    else reasons.push('Savings rate is on the low side — building this up first usually pays off before investing more.');

    if(patterns.cashFlow.monthIncSoFar >= patterns.cashFlow.monthExpSoFar && patterns.cashFlow.monthIncSoFar>0){ score+=10; reasons.push('Cash flow this month is positive so far.'); }

    score = Math.max(0, Math.min(100, score));
    const level = score>=70 ? 'Ready' : score>=40 ? 'Getting there' : 'Not yet';
    return {score, level, reasons};
  }
};

App.Advisor.Notifications = {
  toast(text, level){
    const el = document.getElementById('advisorToast');
    if(!el) return;
    el.textContent = text;
    el.classList.remove('bad');
    if(level==='bad') el.classList.add('bad');
    el.classList.add('show');
    clearTimeout(App.Advisor.Notifications.toast._t);
    App.Advisor.Notifications.toast._t = setTimeout(()=>el.classList.remove('show'), 4500);
  },
  /* Sprint 43 — pure computation extracted out of onTransactionSaved()
     below, unchanged in behavior, so it can be reused elsewhere (App.Chat's
     proactiveExpenseInsight() — see the Sprint 43 build-log block) without
     duplicating this math or triggering a toast. Each alert also gained a
     stable `id`, used only by App.Chat's own cooldown; the manual entry
     form's toast still only reads `.text`/`.level`, so its behavior is
     byte-for-byte identical to before this refactor. */
  computeAlerts(txn){
    if(!txn || txn.type!=='expense') return [];
    const alerts = [];

    const winMs = App.Advisor.Config.DUPLICATE_WINDOW_DAYS * 86400000;
    const near = state.transactions.filter(t=> t.id!==txn.id && t.type==='expense' && t.category===txn.category
      && Number(t.amount)===Number(txn.amount) && Math.abs(new Date(t.date)-new Date(txn.date)) <= winMs);
    if(near.length){
      alerts.push({id:'dup-'+txn.category+'-'+txn.amount, level:'warn', text:`Possible duplicate: another ${fmt(txn.amount)} ${txn.category} entry was logged within a day of this one.`});
    }

    const priorSame = state.transactions.filter(t=> t.id!==txn.id && t.type==='expense' && t.category===txn.category);
    if(priorSame.length>=3){
      const avg = sum(priorSame)/priorSame.length;
      if(avg>0 && Number(txn.amount) > avg*App.Advisor.Config.LARGE_EXPENSE_MULTIPLIER){
        alerts.push({id:'large-'+txn.category, level:'bad', text:`${fmt(txn.amount)} on ${txn.category} is unusually high — about ${(Number(txn.amount)/avg).toFixed(1)}x your usual for this category (avg ${fmt(avg)}).`});
      }
    }

    const budget = Number((state.budgets||{})[txn.category]);
    if(budget>0){
      const from = startOfMonth(0), to = endOfMonth(0);
      const actual = sum(expenseTxns().filter(t=>t.category===txn.category && dateInRange(t.date,from,to)));
      if(actual>budget) alerts.push({id:'over-budget-'+txn.category, level:'bad', text:`This puts ${txn.category} ${fmt(actual-budget)} over its ${fmt(budget)} budget for the month.`});
    }

    if(txn.account){
      const bal = accountBalance(txn.account);
      const snap = App.Advisor.Manager.getSnapshot();
      const dailySpend = snap ? snap.patterns.daily.avgDailySpend : 0;
      const buffer = dailySpend * App.Advisor.Config.LOW_BALANCE_BUFFER_DAYS;
      if(bal < buffer && bal < 1000){
        alerts.push({id:'low-balance-'+txn.account, level:'bad', text:`Balance in this account is running low (${fmt(bal)}).`});
      }
    }

    return alerts;
  },
  /* Real-time save-time check — called right after a new expense is
     saved (see the small additive hook inside the #txnForm submit
     handler). Never blocks or delays the save itself; only surfaces a
     toast afterward. Income/transfer saves just trigger a fresh
     Advisor run so cached figures stay current. */
  onTransactionSaved(txn){
    if(!txn || txn.type!=='expense'){ App.Advisor.Manager.run(); return; }
    const alerts = App.Advisor.Notifications.computeAlerts(txn);
    alerts.forEach(a=> App.Advisor.Notifications.toast(a.text, a.level));
    App.Advisor.Manager.run();
  }
};

App.Advisor.Recommendations = {
  build(patterns){
    let list = [
      ...App.Advisor.Budget.suggestions(patterns),
      ...App.Advisor.Savings.suggestions(patterns),
      ...App.Advisor.Goals.suggestions(patterns)
    ];
    const loans = App.Advisor.Risk.loanPriority();
    if(loans.length){
      const top = loans[0];
      list.push({id:'loan-priority-'+top.id, type:'risk', dot:'warn', priority:7,
        text:`Among your outstanding debts, <b>${top.person}</b>'s ${fmt(debtRemaining(top))}${top.interest?` at ${top.interest}% interest`:''} is the highest priority to pay down first (highest-interest-first).`});
    }
    list = list.filter(r=>!App.Advisor.Logger.isDismissed(r.id));
    const seen = new Set();
    list = list.filter(r=> seen.has(r.id) ? false : (seen.add(r.id), true));
    list.sort((a,b)=> b.priority-a.priority);
    list.forEach(r=> App.Advisor.Logger.record(r.id));
    return list;
  }
};

App.Advisor.Manager = {
  run(){
    try{
      const patterns = App.Advisor.Analysis.patterns();
      const ef = App.Advisor.Savings.emergencyFund();
      const subs = App.Advisor.Savings.subscriptions();
      const loanPriority = App.Advisor.Risk.loanPriority();
      const investReadiness = App.Advisor.Risk.investmentReadiness(patterns, ef);
      const health = computeHealthScoreDetail();
      const recommendations = App.Advisor.Recommendations.build(patterns);
      const snapshot = {patterns, ef, subs, loanPriority, investReadiness, health, recommendations, generatedAt: new Date().toISOString()};
      state.advisor.snapshot = snapshot;
      state.advisor.lastRunAt = snapshot.generatedAt;
      saveAdvisor();
      const activeView = document.querySelector('.view.active');
      if(activeView && activeView.id==='view-advisor') App.Advisor.UI.render();
      return snapshot;
    }catch(err){ App.Advisor.Logger.error('run failed', err); return null; }
  },
  getSnapshot(){ return state.advisor.snapshot; },
  init(){
    App.Advisor.Manager.run();
    App.Advisor.Logger.info('ready — v'+App.Advisor.Config.VERSION);
  }
};

App.Advisor.UI = {
  render(){
    let snap = App.Advisor.Manager.getSnapshot();
    if(!snap) snap = App.Advisor.Manager.run();
    if(!snap) return;
    const {patterns, ef, subs, loanPriority, investReadiness, health, recommendations} = snap;

    const riskEl = document.getElementById('advisorRiskSummary');
    riskEl.innerHTML = health.overall==null
      ? '<div class="empty-note">Not enough data yet. Log income, expenses, budgets, and goals to unlock the Advisor.</div>'
      : `<div class="insight"><span class="dot ${health.overall>=70?'good':health.overall>=40?'warn':'bad'}"></span><p>Financial Health Score: <b>${health.overall}/100</b> — full breakdown on the Insights tab. Investment readiness: <b>${investReadiness.level}</b> (${investReadiness.score}/100).</p></div>`;

    const alertsEl = document.getElementById('advisorAlerts');
    const liveAlerts = [];
    (patterns.budgetUsage||[]).forEach(b=>{
      if(b.pct!=null && b.pct>=100) liveAlerts.push({dot:'bad', text:`Over budget on <b>${b.category}</b> this month (${fmt(b.actual)} of ${fmt(b.budget)}).`});
    });
    if(patterns.income.total>0 && patterns.cashFlow.monthIncSoFar>0 && patterns.cashFlow.projectedExpense > patterns.cashFlow.monthIncSoFar){
      liveAlerts.push({dot:'warn', text:`At this pace, this month's expenses (~${fmt(patterns.cashFlow.projectedExpense)} projected) may exceed income logged so far (${fmt(patterns.cashFlow.monthIncSoFar)}).`});
    }
    alertsEl.innerHTML = liveAlerts.length
      ? liveAlerts.map(a=>`<div class="insight"><span class="dot ${a.dot}"></span><p>${a.text}</p></div>`).join('')
      : '<div class="empty-note">No active alerts right now.</div>';

    const recoEl = document.getElementById('advisorRecommendations');
    recoEl.innerHTML = recommendations.length
      ? recommendations.map(r=>`<div class="advisor-reco"><span class="dot ${r.dot}" style="margin-top:8px;"></span><p>${r.text}</p><button type="button" class="link-btn" data-dismiss-id="${r.id}">Dismiss</button></div>`).join('')
      : '<div class="empty-note">Nothing to flag right now — you\'re on track.</div>';
    recoEl.querySelectorAll('[data-dismiss-id]').forEach(btn=>{
      btn.onclick = ()=>{ App.Advisor.Logger.dismiss(btn.dataset.dismissId); App.Advisor.Manager.run(); };
    });

    const subEl = document.getElementById('advisorSubscriptions');
    let subHtml = '';
    if(subs.tracked.length){
      subHtml += subs.tracked.map(r=>`<div class="insight"><span class="dot info"></span><p><b>${r.name}</b> — ${fmt(r.amount)} / ${r.frequency}</p></div>`).join('');
    }
    if(subs.detected.length){
      subHtml += subs.detected.map(d=>`<div class="insight"><span class="dot warn"></span><p>Possible untracked subscription: <b>${d.name}</b> (~${fmt(d.amount)}, seen ${d.monthsHit} months running).</p></div>`).join('');
    }
    subEl.innerHTML = subHtml || '<div class="empty-note">No recurring commitments tracked or detected yet.</div>';

    const savEl = document.getElementById('advisorSavings');
    savEl.innerHTML = ef.hasGoal
      ? `<div class="insight"><span class="dot ${ef.pct>=100?'good':ef.pct>=50?'warn':'bad'}"></span><p>${(ef.pct||0).toFixed(0)}% funded — ${fmt(ef.saved)} of ${fmt(ef.target)} target (${ef.bufferMonths} months of essential spend).</p></div>`
      : `<div class="insight"><span class="dot warn"></span><p>No Emergency Fund goal yet. Suggested target based on your average essential spend: <b>${fmt(ef.target)}</b> (${ef.bufferMonths} months).</p></div>`;

    const loanEl = document.getElementById('advisorLoanPriority');
    loanEl.innerHTML = loanPriority.length
      ? `<div class="table-wrap"><table><thead><tr><th>Person</th><th>Remaining</th><th>Interest</th><th>Due</th></tr></thead><tbody>${
          loanPriority.map(d=>`<tr><td>${d.person}</td><td>${fmt(debtRemaining(d))}</td><td>${d.interest?d.interest+'%':'—'}</td><td>${d.due||'—'}</td></tr>`).join('')
        }</tbody></table></div>`
      : '<div class="empty-note">No outstanding debts recorded.</div>';

    const invEl = document.getElementById('advisorInvestReadiness');
    invEl.innerHTML = `<div class="insight"><span class="dot ${investReadiness.score>=70?'good':investReadiness.score>=40?'warn':'bad'}"></span><p><b>${investReadiness.level}</b> (${investReadiness.score}/100)</p></div>`
      + investReadiness.reasons.map(r=>`<div class="insight" style="padding:4px 0;"><span class="dot info"></span><p>${r}</p></div>`).join('');

    const patEl = document.getElementById('advisorPatterns');
    const rows = [];
    rows.push(`Income trend: <b>${patterns.income.trend}</b>. Expense trend: <b>${patterns.expense.trend}</b>.`);
    rows.push(`Average daily spend: <b>${fmt(patterns.daily.avgDailySpend)}</b>${patterns.daily.topWeekday?`, highest on <b>${patterns.daily.topWeekday}</b>s on average.`:'.'}`);
    rows.push(`Average monthly expense: <b>${fmt(patterns.monthly.avg)}</b>.`);
    if(patterns.yearly.hasMultiYear){
      const diff = patterns.yearly.thisYear - patterns.yearly.lastYear;
      rows.push(`This year's spend so far (${fmt(patterns.yearly.thisYear)}) is ${diff>=0?'higher':'lower'} than last year's same-period total (${fmt(patterns.yearly.lastYear)}).`);
    }
    if(patterns.investment.totalInvested>0){
      rows.push(`Investments: ${fmt(patterns.investment.totalInvested)} invested, currently worth ${fmt(patterns.investment.totalCurrentValue)} (${patterns.investment.unrealizedPL>=0?'+':''}${fmt(patterns.investment.unrealizedPL)}).`);
    }
    if(patterns.loan.iOwe>0) rows.push(`Outstanding debt: <b>${fmt(patterns.loan.iOwe)}</b>.`);
    patEl.innerHTML = rows.map(t=>`<div class="insight"><span class="dot info"></span><p>${t}</p></div>`).join('');
  }
};


/* ================================================================
   SPRINT 21 — Smart Budget AI & Goal Planner
   (App.Budget — new, App.Goals — new)

   IMPORTANT — reuse, not duplication: budgets and goals already have a
   full working engine in this file (state.budgets, saveBudgets(),
   renderBudgets(); state.goals, saveGoals(), renderGoals(),
   computeSavingsProfile(), computeGoalPlan(), computeGoalStatus(),
   getEmergencyFundGoal(), fixedMonthlyEquivalent()). Nothing below
   recomputes any of that. App.Budget and App.Goals call those exact
   functions/data directly and only add what didn't exist before:

     App.Budget.Config     periods/scopes enum, thresholds (offline)
     App.Budget.Manager    CRUD + usage engine for a new, purely
                            additive "advanced budget" type (state.
                            budgetTypes, new storage key
                            "khaata:budgettypes") that layers Daily /
                            Weekly / Yearly / Custom periods and
                            Subcategory / Account / Project scopes on
                            top of the existing category-monthly
                            budgets{} — which remains untouched and is
                            still the simple default path. "Project"
                            scope reuses the app's existing tag system
                            (t.tags) instead of inventing a new one.
     App.Budget.AI          recommends a budget for any un-budgeted
                            category (3-month average of that
                            category's own actual spend + 10% buffer,
                            reusing expenseTxns()/monthsRange()) and a
                            per-category month-end forecast (same
                            run-rate technique spendingPrediction()
                            already uses elsewhere, applied per
                            category instead of app-wide)
     App.Budget.Alerts      budget-almost-exhausted / exceeded, for
                            both the existing budgets{} and the new
                            advanced budgets — pure read, computed live
     App.Budget.Analysis    small aggregate rollup (counts/totals)
                            over App.Budget.Alerts + App.Budget.AI
                            output, for the summary line in the panel
     App.Budget.Forecast    thin alias kept for naming symmetry with
                            the requested module list — delegates to
                            App.Budget.AI.forecastMonthEnd(), no
                            separate logic
     App.Budget.UI          render() for the new "Smart Budget AI"
                            card + the new Advanced Budgets card, both
                            added to the existing Budgets tab; wires
                            the new form's Add/scope-toggle handlers

     App.Goals.Config       goal-type icon map — now the single source
                            of truth renderGoals() also reads from
                            (extends the 4 original entries, removes
                            none), plus 5 new goal-type <option>s added
                            to the existing #g_category select in the
                            HTML (old options — Big Purchase,
                            Investment, Other — all still there and
                            unchanged, so every existing goal still
                            resolves)
     App.Goals.Progress     one-line wrapper around
                            computeGoalPlan()/computeGoalStatus() so
                            the modules below share one call
     App.Goals.Analytics    per-goal-type totals (target/saved/count)
                            and a contribution-pace trend (rising/
                            falling), built from state.goals +
                            monthsRange()/monthKey(), same technique
                            App.Advisor.Analysis already uses for
                            income/expense trend
     App.Goals.Recommendations  suggests a first goal + monthly
                            contribution when the user has spare
                            capacity and no active goals, and a
                            realistic monthly-contribution figure for
                            each underfunded goal — reusing
                            computeSavingsProfile()/computeGoalPlan(),
                            never re-deriving the underlying numbers
     App.Goals.Notifications   goal completed / behind pace / savings
                            improving-or-decreasing / upcoming target
                            date — computed live each render, no new
                            persistence, reuses computeGoalStatus()
     App.Goals.UI            render() for the new "Goal AI" card added
                            to the existing Goals tab

   New storage key: "khaata:budgettypes" (advanced budgets — added to
   loadState()/migrateToV2() the same way every other save*() key
   already is). No existing storage key, schema, save*() function, or
   UI element was changed, renamed or removed. No paid APIs, no
   network calls — offline-first, same as every other module here.
================================================================ */

App.Budget.Config = {
  VERSION: '1.0.0',
  PERIODS: ['daily','weekly','monthly','yearly','custom'],
  SCOPES: ['category','subcategory','account','project'],
  NEAR_LIMIT_PCT: 85,     // warn before hitting 100% (advanced budgets)
  RECOMMEND_MONTHS: 3,    // look back this many months when recommending a budget
  RECOMMEND_BUFFER: 1.10  // recommend 10% above the recent average
};

App.Budget.Manager = {
  list(){ return state.budgetTypes || []; },
  label(entry){
    if(entry.scope==='category') return `${entry.category} (${entry.period})`;
    if(entry.scope==='subcategory') return `${entry.category} → ${entry.subcategory} (${entry.period})`;
    if(entry.scope==='account'){ const a=(state.accounts||[]).find(x=>x.id===entry.account); return `${a?a.name:'Account'} (${entry.period})`; }
    if(entry.scope==='project') return `Project "${entry.tag}" (${entry.period})`;
    return `Budget (${entry.period})`;
  },
  async add(entry){
    entry.id = uid();
    entry.createdDate = todayStr();
    state.budgetTypes.push(entry);
    await saveBudgetTypes();
  },
  async remove(id){
    state.budgetTypes = state.budgetTypes.filter(b=>b.id!==id);
    await saveBudgetTypes();
  },
  matches(entry, t){
    if(entry.scope==='category') return t.category===entry.category;
    if(entry.scope==='subcategory') return t.category===entry.category && (t.subcategory||'')===(entry.subcategory||'');
    if(entry.scope==='account') return t.account===entry.account;
    if(entry.scope==='project') return Array.isArray(t.tags) && t.tags.includes(entry.tag);
    return false;
  },
  // Current window for a given period, reusing the same date primitives
  // (startOfMonth/endOfMonth/todayStr/daysBetween) every other tab uses.
  periodWindow(period, customDays){
    const today = todayStr();
    if(period==='daily') return {from: today, to: today};
    if(period==='weekly'){
      const d = new Date();
      const dow = d.getDay(); // 0=Sun
      const mondayOffset = (dow===0) ? -6 : 1-dow;
      const start = new Date(d); start.setDate(d.getDate()+mondayOffset);
      const end = new Date(start); end.setDate(start.getDate()+6);
      return {from: start.toISOString().slice(0,10), to: end.toISOString().slice(0,10)};
    }
    if(period==='monthly') return {from: startOfMonth(0), to: endOfMonth(0)};
    if(period==='yearly'){ const y=new Date().getFullYear(); return {from:`${y}-01-01`, to:`${y}-12-31`}; }
    if(period==='custom'){
      const days = Math.max(1, Number(customDays)||30);
      const start = new Date(); start.setDate(start.getDate()-(days-1));
      return {from: start.toISOString().slice(0,10), to: today};
    }
    return {from: startOfMonth(0), to: endOfMonth(0)};
  },
  getUsage(entry){
    const win = this.periodWindow(entry.period, entry.customDays);
    const actual = sum(expenseTxns().filter(t=> dateInRange(t.date, win.from, win.to) && this.matches(entry, t)));
    const amount = Number(entry.amount)||0;
    const pct = amount>0 ? (actual/amount*100) : 0;
    return {actual, amount, pct, window: win, over: amount>0 && actual>amount, near: amount>0 && pct>=App.Budget.Config.NEAR_LIMIT_PCT && actual<=amount};
  },
  // Normalizes any period's amount to a monthly-equivalent figure, so
  // different-period budgets can be compared/summed on one basis.
  monthlyEquivalent(entry){
    const daysByPeriod = {daily:1, weekly:7, monthly:30.44, yearly:365};
    const days = entry.period==='custom' ? Math.max(1, Number(entry.customDays)||30) : (daysByPeriod[entry.period]||30.44);
    return (Number(entry.amount)||0) * (30.44/days);
  },
  init(){ App.Logger.info('[Budget] Manager ready — advanced budgets:', (state.budgetTypes||[]).length); }
};

App.Budget.AI = {
  // 3-month average actual spend for a category, +10% buffer, rounded
  // to the nearest 50 — same expenseTxns()/monthsRange()/monthKey()
  // primitives every other tab already uses.
  recommend(category){
    const exp = expenseTxns().filter(t=>t.category===category);
    const months = monthsRange().slice(-App.Budget.Config.RECOMMEND_MONTHS);
    if(!months.length) return 0;
    const totals = months.map(m=> sum(exp.filter(t=>monthKey(t.date)===m)) );
    const avg = totals.reduce((a,b)=>a+b,0)/totals.length;
    if(avg<=0) return 0;
    return Math.ceil((avg*App.Budget.Config.RECOMMEND_BUFFER)/50)*50;
  },
  recommendUnbudgeted(){
    const budgeted = Object.keys(state.budgets||{});
    return expenseCats()
      .filter(c=>!budgeted.includes(c))
      .map(c=>({category:c, recommended: this.recommend(c)}))
      .filter(r=>r.recommended>0)
      .sort((a,b)=>b.recommended-a.recommended);
  },
  // Same run-rate technique as the existing app-wide spendingPrediction(),
  // applied per category instead of app-wide.
  forecastMonthEnd(category){
    const from = startOfMonth(0), to = endOfMonth(0), today = todayStr();
    const spent = sum(expenseTxns().filter(t=>t.category===category && dateInRange(t.date, from, today)));
    const dayOfMonth = new Date().getDate();
    const daysInMonth = new Date(new Date().getFullYear(), new Date().getMonth()+1, 0).getDate();
    const projected = dayOfMonth>0 ? (spent/dayOfMonth)*daysInMonth : spent;
    const budget = Number((state.budgets||{})[category])||0;
    return {category, spent, projected, budget, willExceed: budget>0 && projected>budget};
  },
  monthEndForecasts(){
    return Object.keys(state.budgets||{}).map(c=>this.forecastMonthEnd(c));
  }
};

// Named for symmetry with the requested module list — delegates to
// App.Budget.AI, no separate forecasting logic of its own (single
// source of truth).
App.Budget.Forecast = {
  forCategory(category){ return App.Budget.AI.forecastMonthEnd(category); },
  all(){ return App.Budget.AI.monthEndForecasts(); }
};

App.Budget.Alerts = {
  generate(){
    const alerts = [];
    const from = startOfMonth(0), to = endOfMonth(0);
    Object.keys(state.budgets||{}).forEach(c=>{
      const budget = Number(state.budgets[c])||0;
      if(budget<=0) return;
      const actual = sum(expenseTxns().filter(t=>t.category===c && dateInRange(t.date, from, to)));
      const pct = actual/budget*100;
      if(actual>budget) alerts.push({severity:'bad', text:`⚠ ${c} budget exceeded — ${fmt(actual)} of ${fmt(budget)}.`});
      else if(pct>=App.Budget.Config.NEAR_LIMIT_PCT) alerts.push({severity:'warn', text:`${c} budget almost used up — ${pct.toFixed(0)}%.`});
    });
    (state.budgetTypes||[]).forEach(entry=>{
      const u = App.Budget.Manager.getUsage(entry);
      const label = App.Budget.Manager.label(entry);
      if(u.over) alerts.push({severity:'bad', text:`⚠ ${label} exceeded — ${fmt(u.actual)} of ${fmt(entry.amount)}.`});
      else if(u.near) alerts.push({severity:'warn', text:`${label} nearing its limit — ${u.pct.toFixed(0)}%.`});
    });
    App.Budget.AI.monthEndForecasts().filter(f=>f.willExceed).forEach(f=>{
      alerts.push({severity:'warn', text:`📈 ${f.category} is on pace for ${fmt(f.projected)} by month end (budget ${fmt(f.budget)}).`});
    });
    return alerts;
  }
};

App.Budget.Analysis = {
  summary(){
    const alerts = App.Budget.Alerts.generate();
    return {
      exceeded: alerts.filter(a=>a.severity==='bad').length,
      nearLimit: alerts.filter(a=>a.severity==='warn').length,
      advancedBudgetCount: (state.budgetTypes||[]).length,
      recommendedCount: App.Budget.AI.recommendUnbudgeted().length
    };
  }
};

App.Budget.UI = {
  _bound: false,
  toggleAdvFormFields(){
    const scope = document.getElementById('ab_scope').value;
    document.getElementById('ab_subcat_wrap').style.display = scope==='subcategory' ? '' : 'none';
    const period = document.getElementById('ab_period').value;
    document.getElementById('ab_customdays_wrap').style.display = period==='custom' ? '' : 'none';
    const label = document.getElementById('ab_target_label');
    const targetSel = document.getElementById('ab_target');
    if(scope==='category' || scope==='subcategory'){
      label.textContent = 'Category';
      targetSel.innerHTML = expenseCats().map(c=>`<option>${c}</option>`).join('');
      document.getElementById('ab_target_wrap').style.display = '';
    } else if(scope==='account'){
      label.textContent = 'Account';
      targetSel.innerHTML = (state.accounts||[]).map(a=>`<option value="${a.id}">${a.name}</option>`).join('') || '<option value="">No accounts yet</option>';
      document.getElementById('ab_target_wrap').style.display = '';
    } else if(scope==='project'){
      label.textContent = 'Tag';
      targetSel.innerHTML = (state.tags||[]).map(t=>`<option>${t}</option>`).join('') || '<option value="">No tags used yet</option>';
      document.getElementById('ab_target_wrap').style.display = '';
    }
  },
  bind(){
    if(this._bound) return; // App.init() may re-render Budgets tab many times; only bind form listeners once
    this._bound = true;
    document.getElementById('ab_scope').addEventListener('change', ()=>this.toggleAdvFormFields());
    document.getElementById('ab_period').addEventListener('change', ()=>this.toggleAdvFormFields());
    document.getElementById('addAdvBudgetBtn').addEventListener('click', async ()=>{
      const scope = document.getElementById('ab_scope').value;
      const period = document.getElementById('ab_period').value;
      const customDays = parseInt(document.getElementById('ab_customdays').value,10) || null;
      const amount = parseFloat(document.getElementById('ab_amount').value);
      if(!amount || amount<0){ alert('Enter a valid budget amount.'); return; }
      const entry = {scope, period, customDays, amount};
      if(scope==='category'){ entry.category = document.getElementById('ab_target').value; }
      else if(scope==='subcategory'){
        entry.category = document.getElementById('ab_target').value;
        entry.subcategory = document.getElementById('ab_subcat').value.trim();
        if(!entry.subcategory){ alert('Enter a subcategory.'); return; }
      } else if(scope==='account'){
        entry.account = document.getElementById('ab_target').value;
        if(!entry.account){ alert('Add an account first (Accounts tab).'); return; }
      } else if(scope==='project'){
        entry.tag = document.getElementById('ab_target').value;
        if(!entry.tag){ alert('Add a tag to a transaction first, then budget that project here.'); return; }
      }
      await App.Budget.Manager.add(entry);
      document.getElementById('ab_amount').value='';
      renderBudgets();
    });
    // Budget Planner redesign — feature-card shortcuts. Purely additive:
    // just prefill the existing ab_scope/ab_period/ab_target selects and
    // focus the amount field; the actual save path above is untouched.
    document.querySelectorAll('#kbudFeatureGrid .kbud-feature').forEach(card=>{
      card.addEventListener('click', ()=>{
        const scope = card.getAttribute('data-scope');
        const period = card.getAttribute('data-period');
        const target = card.getAttribute('data-target');
        document.getElementById('ab_scope').value = scope;
        document.getElementById('ab_period').value = period;
        this.toggleAdvFormFields();
        if(target){
          const sel = document.getElementById('ab_target');
          const opt = [...sel.options].find(o=>o.value===target || o.textContent===target);
          if(opt) sel.value = opt.value;
        }
        const formCard = document.getElementById('kbudAdvForm');
        if(formCard) formCard.scrollIntoView({behavior:'smooth', block:'center'});
        const amtField = document.getElementById('ab_amount');
        if(amtField) amtField.focus();
      });
    });
    this.toggleAdvFormFields();
  },
  render(){
    this.bind();
    const alerts = App.Budget.Alerts.generate();
    const alertsEl = document.getElementById('budgetAIAlerts');
    alertsEl.innerHTML = alerts.length
      ? alerts.map(a=>`<div class="insight"><span class="dot ${a.severity==='bad'?'bad':'warn'}"></span><p>${a.text}</p></div>`).join('')
      : '<div class="insight"><span class="dot good"></span><p>No budget alerts right now — everything tracked is within limits.</p></div>';

    const recs = App.Budget.AI.recommendUnbudgeted();
    document.getElementById('budgetAIRecs').innerHTML = recs.length
      ? recs.map(r=>`<div class="insight"><span class="dot info"></span><p><b>${r.category}</b> — suggested monthly budget <b>${fmt(r.recommended)}</b> (based on your last ${App.Budget.Config.RECOMMEND_MONTHS} months).</p></div>`).join('')
      : '<div class="empty-note">Every category with recent spending already has a budget, or there isn\'t enough history yet.</div>';

    const forecasts = App.Budget.AI.monthEndForecasts();
    document.getElementById('budgetAIForecast').innerHTML = forecasts.length
      ? forecasts.map(f=>`<div class="insight"><span class="dot ${f.willExceed?'bad':'good'}"></span><p><b>${f.category}</b>: ${fmt(f.spent)} spent so far, on pace for <b>${fmt(f.projected)}</b> by month end (budget ${fmt(f.budget)})${f.willExceed?' — likely to exceed.':'.'}</p></div>`).join('')
      : '<div class="empty-note">Set a budget above to see a month-end forecast.</div>';

    const listEl = document.getElementById('advBudgetList');
    const entries = App.Budget.Manager.list();
    const scopeIcon = {category:'🏷️',subcategory:'🏷️',account:'🏦',project:'📌'};
    listEl.innerHTML = entries.length ? entries.map(entry=>{
      const u = App.Budget.Manager.getUsage(entry);
      const pct = Math.min(100, u.pct);
      return `<div class="budget-row" data-id="${entry.id}">
        <div class="budget-top"><span class="budget-cat"><span class="budget-cat-icon">${scopeIcon[entry.scope]||'💳'}</span>${App.Budget.Manager.label(entry)}</span><span class="budget-figs">${fmt(u.actual)} / ${fmt(entry.amount)}${u.over?' ⚠ over':''}</span></div>
        <div class="bar-track"><div class="bar-fill ${u.over?'over':u.near?'warn':''}" style="width:${pct}%;"></div></div>
        <div class="card-note" style="margin-top:3px;display:flex;justify-content:space-between;"><span>${u.window.from} → ${u.window.to}</span><a href="#" data-del-adv="${entry.id}">Delete</a></div>
      </div>`;
    }).join('') : '<div class="empty-note">No advanced budgets yet — add one below (e.g. a weekly Food budget, or a budget for one account or tagged project).</div>';
    listEl.querySelectorAll('[data-del-adv]').forEach(a=>{
      a.addEventListener('click', async (e)=>{
        e.preventDefault();
        await App.Budget.Manager.remove(a.getAttribute('data-del-adv'));
        renderBudgets();
      });
    });
  }
};

/* ---------------------------------------------------------------- */

App.Goals.Config = {
  VERSION: '1.0.0',
  // Single source of truth for goal-type icons — renderGoals() (the
  // original Goals-tab list, unchanged otherwise) now reads this same
  // map instead of its own inline copy. All 4 original entries are
  // still here unchanged; only new goal-type entries were added.
  TYPE_ICONS: {
    'Emergency Fund':'🛟', 'Big Purchase':'🛍️', 'Investment':'📈', 'Other':'🎯',
    'Savings Goal':'💰', 'Vacation Goal':'✈️', 'Education Goal':'🎓',
    'Vehicle Goal':'🚗', 'Home Goal':'🏠', 'Investment Goal':'📈',
    'Business Goal':'💼', 'Custom Goal':'🎯'
  },
  BEHIND_NOTICE_MIN_DAYS: 1 // a goal with a target date already in the past and unfinished always notifies, regardless of pace
};

// One-line wrapper so App.Goals.* modules share a single call to the
// existing engine instead of each calling computeGoalPlan() themselves.
App.Goals.Progress = {
  snapshot(){
    const plan = computeGoalPlan();
    const list = state.goals.map(g=>({goal:g, status: computeGoalStatus(g, plan), result: plan.results[g.id]}));
    return {plan, list};
  }
};

App.Goals.Analytics = {
  byType(){
    const {list} = App.Goals.Progress.snapshot();
    const map = {};
    list.forEach(({goal, result})=>{
      const t = goal.category || 'Other';
      if(!map[t]) map[t] = {count:0, target:0, saved:0};
      map[t].count++;
      map[t].target += Number(goal.cost)||0;
      map[t].saved += result ? result.contributed : sum(goal.contributions);
    });
    return map;
  },
  // Rising/falling goal-contribution pace, same half-vs-half technique
  // App.Advisor.Analysis.patterns() already uses for income/expense trend.
  contributionTrend(){
    const allContribs = [];
    state.goals.forEach(g=>(g.contributions||[]).forEach(c=>allContribs.push(c)));
    const months = monthsRange();
    if(months.length<2 || allContribs.length<2) return 'insufficient-data';
    const byMonth = months.map(m=> sum(allContribs.filter(c=>monthKey(c.date)===m)) );
    const half = Math.floor(byMonth.length/2);
    const firstAvg = byMonth.slice(0,half).reduce((a,b)=>a+b,0)/Math.max(1,half);
    const secondAvg = byMonth.slice(half).reduce((a,b)=>a+b,0)/Math.max(1, byMonth.length-half);
    if(firstAvg<=0 && secondAvg<=0) return 'flat';
    const pct = firstAvg>0 ? ((secondAvg-firstAvg)/firstAvg*100) : (secondAvg>0 ? 100 : 0);
    if(pct>10) return 'improving';
    if(pct<-10) return 'decreasing';
    return 'stable';
  }
};

App.Goals.Recommendations = {
  suggestions(){
    const out = [];
    const {plan, list} = App.Goals.Progress.snapshot();
    const active = list.filter(x=>!x.goal.achieved && !x.goal.paused && !x.goal.isEmergencyFund);
    // No goals yet, but there's spare monthly capacity — suggest starting one.
    if(!active.length && plan.profile.avgMonthlySavings>0){
      out.push(`You have roughly ${fmt(plan.profile.avgMonthlySavings)}/month of savings capacity and no active goals yet — consider starting a Savings Goal or a goal for something specific you're planning for.`);
    }
    // Underfunded goals with a target date: suggest the required monthly contribution.
    active.forEach(({goal, result})=>{
      if(!result || !goal.targetDate || !result.paceStatus) return;
      if(!result.paceStatus.onTrack && result.remainingCost>0){
        out.push(`For "${goal.name}", contributing ~${fmt(result.paceStatus.requiredMonthly)}/month would keep it on track for ${goal.targetDate}.`);
      }
    });
    // Goals with no pace info at all (no fixed amount, no shared capacity) — suggest a contribution.
    active.forEach(({goal, result})=>{
      if(result && result.monthlyRate<=0 && result.remainingCost>0 && !goal.targetDate){
        const suggestion = Math.max(500, Math.round(result.remainingCost/12/50)*50);
        out.push(`"${goal.name}" has no funding pace right now — a fixed monthly amount (try ~${fmt(suggestion)}, roughly a 12-month pace) would get it moving.`);
      }
    });
    return out;
  }
};

App.Goals.Notifications = {
  generate(){
    const alerts = [];
    const {plan, list} = App.Goals.Progress.snapshot();
    list.forEach(({goal, status, result})=>{
      if(goal.achieved) return; // already celebrated when it was marked achieved; don't repeat every render
      if(status==='Completed') alerts.push({severity:'good', text:`🎉 "${goal.name}" is fully funded!`});
      else if(status==='Behind') alerts.push({severity:'warn', text:`⏰ "${goal.name}" is behind pace for its target date of ${goal.targetDate}.`});
      else if(goal.targetDate && daysBetween(todayStr(), goal.targetDate) <= 30 && daysBetween(todayStr(), goal.targetDate) >= 0 && status!=='Completed'){
        alerts.push({severity:'info', text:`📅 "${goal.name}" target date (${goal.targetDate}) is within 30 days.`});
      }
    });
    const trend = App.Goals.Analytics.contributionTrend();
    if(trend==='improving') alerts.push({severity:'good', text:'💪 Your goal contributions have been trending up recently.'});
    else if(trend==='decreasing') alerts.push({severity:'warn', text:'📉 Your goal contributions have slowed down recently.'});
    return alerts;
  }
};

App.Goals.UI = {
  render(planFromCaller){
    const alerts = App.Goals.Notifications.generate();
    document.getElementById('goalAINotifications').innerHTML = alerts.length
      ? alerts.map(a=>`<div class="insight"><span class="dot ${a.severity==='bad'?'bad':a.severity==='warn'?'warn':a.severity==='good'?'good':'info'}"></span><p>${a.text}</p></div>`).join('')
      : '<div class="insight"><span class="dot good"></span><p>No notifications right now.</p></div>';

    const recs = App.Goals.Recommendations.suggestions();
    document.getElementById('goalAIRecs').innerHTML = recs.length
      ? recs.map(r=>`<div class="insight"><span class="dot info"></span><p>${r}</p></div>`).join('')
      : '<div class="empty-note">No new recommendations right now.</div>';

    const byType = App.Goals.Analytics.byType();
    const types = Object.keys(byType);
    document.getElementById('goalAIAnalytics').innerHTML = types.length ? types.map(t=>{
      const d = byType[t];
      const pct = d.target>0 ? Math.min(100, d.saved/d.target*100) : 0;
      return `<div class="kpi savings"><div class="kpi-label">${App.Goals.Config.TYPE_ICONS[t]||'🎯'} ${t}</div><div class="kpi-value">${pct.toFixed(0)}%</div><div class="kpi-sub">${d.count} goal(s) · ${fmt(d.saved)} / ${fmt(d.target)}</div></div>`;
    }).join('') : '<div class="empty-note">Add a goal to see analytics by type.</div>';
  }
};

/* ---------------------------------------------------------------- */

/* ===================================================================
   SPRINT 22 — App.Investment: Investment Intelligence System
   ===================================================================
   Extends the existing Investments tab (state.investments,
   saveInvestments(), totalInvestedAmount(), totalInvestmentValue(),
   renderInvestments()) — none of that is recomputed or duplicated here.
   Ten sub-modules, all reading/writing the same single source of truth
   (state.investments + two new, purely additive arrays:
   state.investmentWatchlist and state.investmentHistory):

     App.Investment.Config          — types, risk map, benchmarks, glossary, FAQ
     App.Investment.Manager         — CRUD wrapper over state.investments/save*(), snapshots, dividends
     App.Investment.Portfolio       — totals, allocation by type/asset-class
     App.Investment.Analytics       — per-investment P&L, best/worst, dividends, annualized return
     App.Investment.Performance     — vs. FD/inflation benchmark comparison, growth trend
     App.Investment.Risk            — risk meter score, concentration detection
     App.Investment.Goals           — links investments to existing state.goals (App.Goals engine, reused)
     App.Investment.Recommendations — rule-based tips (diversification, SIP, underperformers, goal funding)
     App.Investment.Watchlist       — CRUD over state.investmentWatchlist
     App.Investment.Logger          — same info/error console pattern as every other App.*.Logger
     App.Investment.UI              — renders all of the above into the new cards on the Investments tab

   Everything here is rule-based, computed only from the user's own
   recorded numbers. No broker/market-data APIs, no paid APIs, no
   buy/sell orders — none of that is implemented, by design. Benchmark
   figures (FD/inflation) are editable illustrative assumptions, not
   live data, and are labeled as such in the UI. Nothing here is
   professional financial advice.
   =================================================================== */

App.Investment.Config = {
  VERSION: '1.0.0',
  // Full supported-type list. The original 6 (Mutual Funds, Stocks, Fixed
  // Deposit (FD), Gold, Real Estate, Other) are unchanged and still first —
  // everything after them is new.
  TYPES: [
    'Mutual Funds','Stocks','Fixed Deposit (FD)','Gold','Real Estate','Other',
    'SIP','ETF','Silver','Recurring Deposit (RD)','PPF','EPF','NPS','Bonds','Crypto','Custom Asset'
  ],
  // Broad asset-class grouping, used only for diversification/risk views.
  ASSET_CLASS: {
    'Stocks':'Equity','Mutual Funds':'Equity','SIP':'Equity','ETF':'Equity',
    'Crypto':'Alternative','Gold':'Commodity','Silver':'Commodity',
    'Fixed Deposit (FD)':'Debt','Recurring Deposit (RD)':'Debt','PPF':'Debt','EPF':'Debt','Bonds':'Debt',
    'NPS':'Hybrid','Real Estate':'Real Estate','Custom Asset':'Other','Other':'Other'
  },
  // Illustrative risk levels (1 = very low, 5 = very high) for education —
  // a user can always override a single investment's risk in Advanced details.
  RISK_LEVEL: {
    'Fixed Deposit (FD)':1,'Recurring Deposit (RD)':1,'PPF':1,'EPF':1,
    'Bonds':2,'NPS':2,'Gold':2,
    'Silver':3,'Mutual Funds':3,'SIP':3,'ETF':3,'Real Estate':3,'Custom Asset':3,'Other':3,
    'Stocks':4,
    'Crypto':5
  },
  RISK_LABELS: {1:'Very Low',2:'Low',3:'Medium',4:'High',5:'Very High'},
  CONCENTRATION_ASSET_PCT: 35, // flag when one investment is >35% of the portfolio
  CONCENTRATION_TYPE_PCT: 55,  // flag when one asset class is >55% of the portfolio
  // Long-run illustrative assumptions ONLY — not live rates, not a
  // guarantee, not investment advice. Shown to the user with that label.
  BENCHMARKS: { fdAnnual: 6.5, inflationAnnual: 6.0 },
  UNDERPERFORM_GAP_PCT: 8, // an investment trailing the FD benchmark by more than this, after 1+ year held, is flagged
  GLOSSARY: [
    {term:'SIP (Systematic Investment Plan)', def:'Investing a fixed amount regularly (usually monthly) into a mutual fund, instead of one lump sum.'},
    {term:'ETF (Exchange Traded Fund)', def:'A basket of stocks or bonds that trades on a stock exchange like a single share.'},
    {term:'Diversification', def:'Spreading money across different types of assets so one bad investment doesn\u2019t sink your whole portfolio.'},
    {term:'Concentration Risk', def:'Having too much of your money in one asset or one asset class, which makes your portfolio more fragile.'},
    {term:'Asset Allocation', def:'How your money is split across categories like Equity, Debt, Gold and Real Estate.'},
    {term:'Average Buy Price', def:'The average price you paid per unit/share, across all your purchases of that investment.'},
    {term:'P&L (Profit & Loss)', def:'Current Value minus Invested Amount — how much you\u2019ve gained or lost so far.'},
    {term:'Annualized Return', def:'Your return expressed as a yearly rate, so investments held for different lengths of time can be compared fairly.'},
    {term:'PPF (Public Provident Fund)', def:'A long-term, government-backed savings scheme with tax benefits and a 15-year lock-in.'},
    {term:'NPS (National Pension System)', def:'A government-regulated retirement savings scheme that invests in a mix of equity and debt.'},
    {term:'Bonds', def:'A loan you give to a company or government that pays you back with interest over time.'},
    {term:'Fixed Deposit (FD)', def:'A lump sum locked with a bank for a fixed period at a fixed interest rate.'},
    {term:'Goal-Based Investing', def:'Choosing and tracking investments based on a specific target (e.g. a house down payment) rather than investing in general.'}
  ],
  FAQ: [
    {q:'Do I need to know the exact current market price?', a:'No — just enter your best estimate of Current Value. You can update it any time; nothing here fetches live prices.'},
    {q:'What does the Risk Meter actually measure?', a:'A simple weighted average of illustrative risk levels per asset type, based on how much of your portfolio is in each. It\u2019s a rule of thumb, not a real risk model.'},
    {q:'Are the FD/inflation numbers live rates?', a:'No — they\u2019re editable, illustrative long-run assumptions used only to give you a rough comparison. Check current rates yourself before deciding anything.'},
    {q:'Can this app place trades or connect to my broker?', a:'No — this is a tracking and learning tool only. It never places buy/sell orders and never connects to any broker or market-data API.'},
    {q:'Is any of this financial advice?', a:'No. Everything here is a rule-based observation about the numbers you entered — always useful to double check with a qualified financial advisor before acting.'}
  ]
};

App.Investment.Logger = {
  info(...args){ try{ console.log('[App.Investment]', ...args); }catch(e){} },
  error(...args){ try{ console.error('[App.Investment]', ...args); }catch(e){} }
};

App.Investment.Manager = {
  init(){ App.Investment.Logger.info('ready —', (state.investments||[]).length, 'holdings,', (state.investmentWatchlist||[]).length, 'watchlist item(s)'); },
  list(){ return state.investments||[]; },
  get(id){ return (state.investments||[]).find(i=>i.id===id); },
  riskOf(inv){ return inv.riskOverride || App.Investment.Config.RISK_LEVEL[inv.type] || 3; },
  assetClassOf(inv){ return App.Investment.Config.ASSET_CLASS[inv.type] || 'Other'; },
  // Adds a dividend/interest record to an existing investment. Purely
  // additive field (dividends[]) — investments without it are treated as [].
  addDividend(id, amount, date){
    const inv = this.get(id);
    if(!inv) return;
    if(!Array.isArray(inv.dividends)) inv.dividends = [];
    inv.dividends.push({amount:Number(amount)||0, date: date||todayStr()});
  },
  // One snapshot per calendar day (overwrites same-day snapshot instead of
  // piling up duplicates if the user saves multiple times today), capped
  // to the most recent 365 so the array can't grow unbounded.
  recordSnapshot(){
    const today = todayStr();
    const totalInvested = totalInvestedAmount(), totalCurrent = totalInvestmentValue();
    const idx = state.investmentHistory.findIndex(h=>h.date===today);
    const snap = {date:today, totalInvested, totalCurrent};
    if(idx>=0) state.investmentHistory[idx] = snap; else state.investmentHistory.push(snap);
    state.investmentHistory.sort((a,b)=>a.date.localeCompare(b.date));
    if(state.investmentHistory.length>365) state.investmentHistory = state.investmentHistory.slice(-365);
    saveInvestmentHistory();
  }
};

App.Investment.Portfolio = {
  totals(){
    const invested = totalInvestedAmount(), current = totalInvestmentValue();
    const pl = current-invested;
    return {invested, current, pl, retPct: invested? (pl/invested*100) : 0, count:(state.investments||[]).length};
  },
  byType(){
    const map = {};
    (state.investments||[]).forEach(i=>{
      map[i.type] = (map[i.type]||0) + (Number(i.currentValue)||0);
    });
    return map;
  },
  byAssetClass(){
    const map = {};
    (state.investments||[]).forEach(i=>{
      const cls = App.Investment.Manager.assetClassOf(i);
      map[cls] = (map[cls]||0) + (Number(i.currentValue)||0);
    });
    return map;
  },
  // 0-100: rewards more distinct asset classes and penalizes any single
  // class dominating the portfolio. A simple, transparent heuristic.
  diversificationScore(){
    const byClass = this.byAssetClass();
    const classes = Object.keys(byClass);
    const total = Object.values(byClass).reduce((a,b)=>a+b,0);
    if(!total || !classes.length) return 0;
    const maxShare = Math.max(...Object.values(byClass))/total;
    const breadthScore = Math.min(100, classes.length*20); // 5+ classes = full breadth credit
    const concentrationPenalty = Math.max(0, (maxShare-0.25)*100); // penalize beyond a 25% single-class share
    return Math.max(0, Math.round(breadthScore - concentrationPenalty));
  }
};

App.Investment.Analytics = {
  perInvestmentReturns(){
    return (state.investments||[]).map(i=>{
      const invested = Number(i.invested)||0, current = Number(i.currentValue)||0;
      const pl = current-invested;
      const retPct = invested? (pl/invested*100) : 0;
      const days = i.purchaseDate ? daysBetween(i.purchaseDate, todayStr()) : null;
      const years = days ? days/365 : null;
      const annualized = (years && years>0.08 && invested>0) ? (Math.pow(current/invested, 1/years)-1)*100 : null;
      return {inv:i, invested, current, pl, retPct, annualized};
    });
  },
  bestWorst(){
    const rows = this.perInvestmentReturns().filter(r=>r.invested>0);
    if(!rows.length) return {best:null, worst:null};
    const sorted = [...rows].sort((a,b)=>b.retPct-a.retPct);
    return {best: sorted[0], worst: sorted[sorted.length-1]};
  },
  totalDividends(){
    return (state.investments||[]).reduce((s,i)=> s + (Array.isArray(i.dividends)? i.dividends.reduce((a,d)=>a+(Number(d.amount)||0),0) : 0), 0);
  },
  // Simple weighted-average annualized return across holdings that have
  // enough history to compute one (see perInvestmentReturns). Not a true
  // XIRR (which needs full cash-flow timing) — a transparent approximation.
  annualizedReturnEstimate(){
    const rows = this.perInvestmentReturns().filter(r=>r.annualized!==null && r.invested>0);
    if(!rows.length) return null;
    const totalInvested = rows.reduce((s,r)=>s+r.invested,0);
    if(!totalInvested) return null;
    return rows.reduce((s,r)=> s + r.annualized*(r.invested/totalInvested), 0);
  }
};

App.Investment.Performance = {
  vsBenchmarks(){
    const est = App.Investment.Analytics.annualizedReturnEstimate();
    const {fdAnnual, inflationAnnual} = App.Investment.Config.BENCHMARKS;
    return {portfolioAnnualized: est, fdAnnual, inflationAnnual};
  },
  trend(){ return state.investmentHistory||[]; }
};

App.Investment.Risk = {
  // Weighted average risk level (1-5) across current holdings, by current value.
  meterScore(){
    const invs = state.investments||[];
    const totalCurrent = invs.reduce((s,i)=>s+(Number(i.currentValue)||0),0);
    if(!totalCurrent) return {score:0, level:'—'};
    const weighted = invs.reduce((s,i)=> s + App.Investment.Manager.riskOf(i)*(Number(i.currentValue)||0), 0) / totalCurrent;
    const level = App.Investment.Config.RISK_LABELS[Math.round(weighted)] || 'Medium';
    return {score: weighted, pct: Math.round((weighted/5)*100), level};
  },
  concentration(){
    const warnings = [];
    const invs = state.investments||[];
    const totalCurrent = invs.reduce((s,i)=>s+(Number(i.currentValue)||0),0);
    if(!totalCurrent) return warnings;
    invs.forEach(i=>{
      const share = (Number(i.currentValue)||0)/totalCurrent*100;
      if(share >= App.Investment.Config.CONCENTRATION_ASSET_PCT){
        warnings.push({severity:'warn', text:`"${i.name}" alone makes up ${share.toFixed(0)}% of your portfolio — consider whether that concentration is intentional.`});
      }
    });
    const byClass = App.Investment.Portfolio.byAssetClass();
    Object.entries(byClass).forEach(([cls, val])=>{
      const share = val/totalCurrent*100;
      if(share >= App.Investment.Config.CONCENTRATION_TYPE_PCT){
        warnings.push({severity:'warn', text:`${cls} makes up ${share.toFixed(0)}% of your portfolio — a large share is in one asset class.`});
      }
    });
    const score = App.Investment.Portfolio.diversificationScore();
    if(invs.length && score>=70) warnings.unshift({severity:'good', text:`Diversification score: ${score}/100 — reasonably well spread across asset classes.`});
    else if(invs.length) warnings.unshift({severity:'info', text:`Diversification score: ${score}/100.`});
    return warnings;
  }
};

// Reuses state.goals (the same array App.Goals reads/writes) — never
// duplicates or recomputes goal data, only links an investment's goalId
// to an existing goal.
App.Investment.Goals = {
  linked(){
    const invs = (state.investments||[]).filter(i=>i.goalId);
    const map = {};
    invs.forEach(i=>{
      if(!map[i.goalId]) map[i.goalId] = [];
      map[i.goalId].push(i);
    });
    return Object.entries(map).map(([goalId, items])=>{
      const goal = (state.goals||[]).find(g=>g.id===goalId);
      const coveredValue = items.reduce((s,i)=>s+(Number(i.currentValue)||0),0);
      const pct = goal && goal.cost ? Math.min(100, coveredValue/goal.cost*100) : null;
      return {goal, items, coveredValue, pct};
    }).filter(x=>x.goal); // drop links to a goal that was since deleted
  }
};

App.Investment.Recommendations = {
  suggestions(){
    const out = [];
    const invs = state.investments||[];
    if(!invs.length) return out;

    // Concentration / diversification (reuses App.Investment.Risk, doesn't recompute it)
    App.Investment.Risk.concentration().forEach(w=>{ if(w.severity==='warn') out.push(w.text); });

    // SIP opportunity: user has equity-type lump investments but no SIP yet,
    // and has some monthly savings capacity (reuses the existing goal-planning
    // savings profile computeSavingsProfile(), never recomputed here).
    const hasSIP = invs.some(i=>i.type==='SIP');
    const hasEquity = invs.some(i=>App.Investment.Manager.assetClassOf(i)==='Equity');
    try{
      const profile = computeSavingsProfile();
      if(!hasSIP && profile && profile.avgMonthlySavings>500){
        out.push(hasEquity
          ? `You're already invested in equity but have no SIP — a monthly SIP can help average out purchase price over time instead of investing in lump sums.`
          : `You have roughly ${fmt(profile.avgMonthlySavings)}/month of savings capacity and no equity exposure yet — a small SIP could be a low-effort way to start.`);
      }
    }catch(e){ /* computeSavingsProfile depends on goal-planning data; skip quietly if unavailable */ }

    // Underperforming assets vs. the FD benchmark, only for holdings held 1+ year.
    App.Investment.Analytics.perInvestmentReturns().forEach(r=>{
      if(r.annualized!==null && r.annualized < (App.Investment.Config.BENCHMARKS.fdAnnual - App.Investment.Config.UNDERPERFORM_GAP_PCT)){
        out.push(`"${r.inv.name}" is annualizing around ${r.annualized.toFixed(1)}%, well below the FD benchmark (${App.Investment.Config.BENCHMARKS.fdAnnual}%) — worth reviewing whether it still fits your plan.`);
      }
    });

    // Goal-based suggestion: active goals with no linked investment at all.
    const linkedGoalIds = new Set(invs.filter(i=>i.goalId).map(i=>i.goalId));
    (state.goals||[]).filter(g=>!g.achieved && !g.isEmergencyFund && !linkedGoalIds.has(g.id)).slice(0,2).forEach(g=>{
      out.push(`Consider linking an investment to your goal "${g.name}" (use "Link to Goal" in Advanced details) so its progress shows up here.`);
    });

    return out;
  }
};

App.Investment.Watchlist = {
  init(){}, // data already loaded by loadState(); nothing else to warm up
  list(){ return state.investmentWatchlist||[]; },
  add(item){
    const rec = {id:uid(), name:item.name, type:item.type||'Other', notes:item.notes||'', createdDate: todayStr()};
    state.investmentWatchlist.push(rec);
    saveInvestmentWatchlist();
    return rec;
  },
  remove(id){
    state.investmentWatchlist = state.investmentWatchlist.filter(w=>w.id!==id);
    saveInvestmentWatchlist();
  }
};

App.Investment.UI = {
  bound: false,
  bind(){
    if(this.bound) return; // wire the static controls (watchlist form, type dropdown) once
    this.bound = true;
    const wType = document.getElementById('w_type');
    if(wType) wType.innerHTML = App.Investment.Config.TYPES.map(t=>`<option>${t}</option>`).join('');
    const addWatchBtn = document.getElementById('addWatchBtn');
    if(addWatchBtn){
      addWatchBtn.addEventListener('click', ()=>{
        const name = document.getElementById('w_name').value.trim();
        if(!name){ alert('Enter a name for the watchlist item.'); return; }
        App.Investment.Watchlist.add({
          name, type: document.getElementById('w_type').value,
          notes: document.getElementById('w_notes').value.trim()
        });
        ['w_name','w_notes'].forEach(id=>document.getElementById(id).value='');
        App.Investment.UI.renderWatchlist();
      });
    }
  },
  renderGoalSelect(){
    const sel = document.getElementById('i_goal');
    if(!sel) return;
    const current = sel.value;
    const active = (state.goals||[]).filter(g=>!g.achieved);
    sel.innerHTML = '<option value="">— None —</option>' + active.map(g=>`<option value="${g.id}">${g.name}</option>`).join('');
    if(active.some(g=>g.id===current)) sel.value = current;
  },
  renderAnalytics(){
    const t = App.Investment.Portfolio.totals();
    const div = App.Investment.Analytics.totalDividends();
    const {best, worst} = App.Investment.Analytics.bestWorst();
    const el = document.getElementById('invAIAnalytics');
    if(!el) return;
    if(!t.count){ el.innerHTML = '<div class="empty-note">Add an investment above to see intelligence and insights here.</div>'; return; }
    el.innerHTML = `
      <div class="kpi savings"><div class="kpi-label">Total Dividends / Interest Logged</div><div class="kpi-value">${fmt(div)}</div></div>
      ${best ? `<div class="kpi income"><div class="kpi-label">Best Performer</div><div class="kpi-value">${best.inv.name}</div><div class="kpi-sub">${best.retPct.toFixed(1)}%</div></div>` : ''}
      ${worst ? `<div class="kpi ${worst.retPct>=0?'savings':'expense'}"><div class="kpi-label">Needs a Look</div><div class="kpi-value">${worst.inv.name}</div><div class="kpi-sub">${worst.retPct.toFixed(1)}%</div></div>` : ''}
    `;
  },
  renderRiskMeter(){
    const el = document.getElementById('invRiskMeter');
    if(!el) return;
    const {score, pct, level} = App.Investment.Risk.meterScore();
    if(!state.investments.length){ el.innerHTML = '<div class="empty-note">No holdings yet.</div>'; return; }
    el.innerHTML = `
      <div class="bar-track"><div class="bar-fill" style="width:${pct}%;"></div></div>
      <div class="card-note" style="margin-top:4px;">Portfolio risk level: <b>${level}</b> (${score.toFixed(1)} / 5, illustrative rule-of-thumb — see Learn: Investment Basics below).</div>
    `;
  },
  renderConcentration(){
    const el = document.getElementById('invConcentration');
    if(!el) return;
    const warnings = App.Investment.Risk.concentration();
    el.innerHTML = warnings.length
      ? warnings.map(w=>`<div class="insight"><span class="dot ${w.severity==='warn'?'warn':w.severity==='good'?'good':'info'}"></span><p>${w.text}</p></div>`).join('')
      : '<div class="empty-note">Add an investment to see diversification insights.</div>';
  },
  renderRecommendations(){
    const el = document.getElementById('invRecs');
    if(!el) return;
    const recs = App.Investment.Recommendations.suggestions();
    el.innerHTML = recs.length
      ? recs.map(r=>`<div class="insight"><span class="dot info"></span><p>${r}</p></div>`).join('')
      : '<div class="empty-note">No new recommendations right now.</div>';
  },
  renderPerformance(){
    const el = document.getElementById('invPerf');
    if(!el) return;
    const {portfolioAnnualized, fdAnnual, inflationAnnual} = App.Investment.Performance.vsBenchmarks();
    if(portfolioAnnualized===null){
      el.innerHTML = '<div class="empty-note">Hold an investment for a while (with a purchase date) to see an annualized-return comparison.</div>';
      return;
    }
    el.innerHTML = `
      <div class="kpi-grid">
        <div class="kpi ${portfolioAnnualized>=0?'savings':'expense'}"><div class="kpi-label">Your Portfolio (est. annualized)</div><div class="kpi-value">${portfolioAnnualized.toFixed(1)}%</div></div>
        <div class="kpi"><div class="kpi-label">FD Benchmark (illustrative)</div><div class="kpi-value">${fdAnnual.toFixed(1)}%</div></div>
        <div class="kpi"><div class="kpi-label">Inflation (illustrative)</div><div class="kpi-value">${inflationAnnual.toFixed(1)}%</div></div>
      </div>
      <div class="card-note" style="margin-top:6px;">Benchmarks are editable illustrative assumptions (App.Investment.Config.BENCHMARKS), not live rates.</div>
    `;
  },
  renderGoalLinked(){
    const el = document.getElementById('invGoalLinked');
    if(!el) return;
    const linked = App.Investment.Goals.linked();
    el.innerHTML = linked.length ? linked.map(({goal, items, coveredValue, pct})=>`
      <div class="budget-row">
        <div class="budget-top"><span class="budget-cat">🎯 ${goal.name}</span><span class="budget-figs">${fmt(coveredValue)} / ${fmt(goal.cost)}</span></div>
        <div class="bar-track"><div class="bar-fill" style="width:${pct||0}%;"></div></div>
        <div class="card-note" style="margin-top:3px;">${items.map(i=>i.name).join(', ')}</div>
      </div>
    `).join('') : '<div class="empty-note">No investments linked to a goal yet — use "Link to Goal" in Advanced details when adding an investment.</div>';
  },
  renderWatchlist(){
    const el = document.getElementById('invWatchlist');
    if(!el) return;
    const items = App.Investment.Watchlist.list();
    el.innerHTML = items.length ? `<div class="table-wrap"><table><thead><tr><th>Name</th><th>Type</th><th>Notes</th><th></th></tr></thead><tbody>${
      items.map(w=>`<tr data-id="${w.id}"><td>${w.name}</td><td>${w.type}</td><td>${w.notes||'—'}</td><td><button class="btn small rust del-watch">✕</button></td></tr>`).join('')
    }</tbody></table></div>` : '<div class="empty-note">Nothing on your watchlist yet.</div>';
    el.querySelectorAll('.del-watch').forEach(b=>b.addEventListener('click', e=>{
      const id = e.target.closest('tr').dataset.id;
      App.Investment.Watchlist.remove(id);
      App.Investment.UI.renderWatchlist();
    }));
  },
  renderTrendChart(){
    destroyChart('invtrend');
    const hist = App.Investment.Performance.trend();
    if(hist.length<2){ noData('c_invtrend'); return; }
    const {text} = chartTheme();
    charts.invtrend = new Chart(document.getElementById('c_invtrend'), {
      type:'line',
      data:{
        labels: hist.map(h=>h.date),
        datasets:[
          {label:'Invested', data: hist.map(h=>h.totalInvested), borderColor: palette(2)[0], backgroundColor:'transparent', tension:0.25},
          {label:'Current Value', data: hist.map(h=>h.totalCurrent), borderColor: palette(2)[1], backgroundColor:'transparent', tension:0.25}
        ]
      },
      options:{responsive:true, maintainAspectRatio:false, plugins:{legend:{position:'bottom', labels:{color:text, boxWidth:10, font:{size:10}}}}, scales:{x:{ticks:{color:text}}, y:{ticks:{color:text}}}}
    });
  },
  renderGlossaryFAQ(){
    const gEl = document.getElementById('invGlossary');
    if(gEl && !gEl.dataset.rendered){
      gEl.dataset.rendered = '1'; // static content — render once, no need to rebuild every save
      gEl.innerHTML = App.Investment.Config.GLOSSARY.map(g=>`<div class="card-note" style="margin-bottom:6px;"><b>${g.term}</b> — ${g.def}</div>`).join('');
    }
    const fEl = document.getElementById('invFAQ');
    if(fEl && !fEl.dataset.rendered){
      fEl.dataset.rendered = '1';
      fEl.innerHTML = App.Investment.Config.FAQ.map(f=>`<div class="insight"><span class="dot info"></span><p><b>${f.q}</b><br>${f.a}</p></div>`).join('');
    }
  },
  render(){
    this.bind();
    this.renderGoalSelect();
    this.renderAnalytics();
    this.renderRiskMeter();
    this.renderConcentration();
    this.renderRecommendations();
    this.renderPerformance();
    this.renderGoalLinked();
    this.renderWatchlist();
    this.renderTrendChart();
    this.renderGlossaryFAQ();
  }
};

/* ---------------------------------------------------------------- */

/* ================================================================
   SPRINT 23 — BUSINESS FOUNDATION  (App.Business)
   ------------------------------------------------------------------
   Foundation only — see the Sprint 23 build-log entry at the top of
   this file for the full mission/scope/regression writeup. Nothing
   below implements Customers, Vendors, Products, Inventory, Invoices,
   Payments, GST/Tax or Cloud Sync — those are explicitly deferred.

   What this actually is: a Personal <-> Business profile switcher.
   "Personal" is the app exactly as it always was — same localStorage
   keys, same functions. A "Business" profile is a second (or third,
   or Nth — this is future-ready for multiple businesses) independent
   copy of the same 21 state fields, stored under its own namespaced
   keys, that the user can switch to instantly, with no page reload.

   The actual isolation mechanism lives OUTSIDE this block, in
   bizKey() (declared near uid()/todayStr() at the top of this file)
   and the ~20 save*() functions + loadState() that already call it —
   this block is what decides *which* profile bizKey() should resolve
   to, and provides the small UI to switch between them.

   Submodule map:
     App.Business.Config     constants — storage-key prefixes, the
                              fixed Personal profile record, the list
                              of 21 state fields that get isolated
     App.Business.Logger     scoped logging, delegates to App.Logger
     App.Business.Storage    resolveKey() / resetScopedState() — the
                              actual isolation primitives
     App.Business.Profile    CRUD for Business profiles (Personal is
                              fixed and isn't part of this list)
     App.Business.Session    tracks + persists the active profile id
     App.Business.Workspace  read-only facade for future modules
     App.Business.Security   name validation + guard rails
     App.Business.Manager    switchProfile() + the switcher UI
================================================================ */

/* ---- App.Business.Config --------------------------------------- */
App.Business.Config = {
  VERSION: '1.0.0',
  // Personal's keys are the app's original, untouched 'khaata:base' keys.
  STORAGE_PREFIX: 'khaata:',
  // A Business profile's keys live at 'khaata:biz:<profileId>:base'.
  BUSINESS_PREFIX: 'khaata:biz:',
  PROFILES_KEY: 'khaata:business:profiles',
  ACTIVE_KEY: 'khaata:business:active',
  // Personal is fixed: always exists, never stored in the profile
  // list, never removable/renamable. One single source of truth for
  // what "Personal" means, reused everywhere in this block.
  PERSONAL_PROFILE: Object.freeze({ id:'personal', type:'personal', name:'Personal', icon:'👤' }),
  MAX_NAME_LEN: 60,
  // The 21 state fields bizKey()-routed save*()/loadState() calls
  // already isolate — documentation/reference list, not itself read
  // by any code path (resetScopedState() below spells each one out
  // explicitly so its defaults exactly match state's own defaults).
  SCOPED_STATE_FIELDS: [
    'transactions','budgets','budgetTypes','customExpenseCats','customIncomeSources',
    'customSubcats','goals','settings','accounts','recurring','debts','tags',
    'creditCards','ccUtilHistory','investments','investmentWatchlist','investmentHistory',
    'netWorthHistory','voiceSettings','voiceLog','reminders','advisor'
  ],
  // Deliberately NOT isolated — see Sprint 23 build-log entry: theme is a
  // shared device preference, not per-profile business data.
  UNSCOPED_STATE_FIELDS: ['theme']
};

/* ---- App.Business.Logger ----------------------------------------
   Same thin-wrapper pattern App.Voice.Logger / App.Advisor.Logger
   already use — everything still funnels through App.Logger, so the
   existing console + global error listeners stay the one place logs
   go, nothing parallel or new. */
App.Business.Logger = {
  info:  (...a)=>{ try{ App.Logger.info('[Business]', ...a); }catch(e){} },
  warn:  (...a)=>{ try{ App.Logger.warn('[Business]', ...a); }catch(e){} },
  error: (...a)=>{ try{ App.Logger.error('[Business]', ...a); }catch(e){} }
};

/* ---- App.Business.Session ----------------------------------------
   Tracks which profile is active, in-memory + persisted. Restored
   synchronously the moment this object literal is evaluated — i.e.
   while this file is still parsing, well before App.init()/loadState()
   run at the very bottom of the script — so loadState()'s bizKey()
   calls resolve to the right profile from the very first load, with
   no separate "load Personal then swap" step ever needed. */
App.Business.Session = (function(){
  const Cfg = App.Business.Config;
  let activeId = 'personal';
  try{ activeId = localStorage.getItem(Cfg.ACTIVE_KEY) || 'personal'; }catch(e){}
  function getActiveId(){ return activeId; }
  function setActiveId(id){
    activeId = id || 'personal';
    try{ localStorage.setItem(Cfg.ACTIVE_KEY, activeId); }catch(e){}
  }
  return { getActiveId, setActiveId };
})();

/* ---- App.Business.Security ----------------------------------------
   Small, real validation helpers — not a stub. Guards the two things
   that actually matter this sprint: profile names can't be empty/
   absurdly long, and Personal can never be renamed or removed. */
App.Business.Security = {
  sanitizeName(name){
    return (name==null ? '' : String(name)).trim().replace(/\s+/g,' ').slice(0, App.Business.Config.MAX_NAME_LEN);
  },
  canRename(id){ return id !== 'personal'; },
  canRemove(id){ return id !== 'personal'; }
};

/* ---- App.Business.Storage ----------------------------------------
   resolveKey() is what bizKey() (top of file) actually calls.
   resetScopedState() blanks the 21 isolated fields back to their
   defaults — used right before a profile switch loads a different
   profile's data over the current one, so nothing from the outgoing
   profile can leak into the incoming one for a field that profile
   has never saved yet (a brand-new Business profile, for example). */
App.Business.Storage = {
  resolveKey(base){
    const Cfg = App.Business.Config;
    const id = App.Business.Session.getActiveId();
    if(!id || id === 'personal') return Cfg.STORAGE_PREFIX + base;
    return Cfg.BUSINESS_PREFIX + id + ':' + base;
  },
  resetScopedState(){
    state.transactions = [];
    state.budgets = {};
    state.budgetTypes = [];
    state.customExpenseCats = [];
    state.customIncomeSources = [];
    state.customSubcats = {};
    state.goals = [];
    state.settings = { bufferMonths: 3 };
    state.accounts = [];
    state.recurring = [];
    state.debts = [];
    state.tags = [];
    state.creditCards = [];
    state.ccUtilHistory = {};
    state.investments = [];
    state.investmentWatchlist = [];
    state.investmentHistory = [];
    state.netWorthHistory = [];
    state.voiceSettings = { enabled:true, recognitionLang:'auto', continuousMode:false };
    state.voiceLog = [];
    state.reminders = [];
    state.advisor = { dismissed:{}, shownLog:[], lastRunAt:null, snapshot:null };
    // in-memory-only, never persisted — but an undo/draft from one
    // profile must never bleed into another
    state.deletedLog = [];
    lastDeleted = null;
    quickAddAmount = null;
    // state.theme is intentionally left untouched — shared across profiles.
  }
};

/* ---- App.Business.Profile ----------------------------------------
   CRUD for Business profiles. Personal is never stored here — it's
   the fixed Config.PERSONAL_PROFILE record, always prepended to
   list(). Future-ready for any number of Business profiles. */
App.Business.Profile = (function(){
  const Cfg = App.Business.Config;
  function loadList(){
    try{ const raw = localStorage.getItem(Cfg.PROFILES_KEY); const arr = raw ? JSON.parse(raw) : []; return Array.isArray(arr) ? arr : []; }
    catch(e){ return []; }
  }
  function saveList(list){
    try{ localStorage.setItem(Cfg.PROFILES_KEY, JSON.stringify(list)); }catch(e){ App.Business.Logger.error('Profile.saveList failed', e); }
  }
  function list(){ return [Cfg.PERSONAL_PROFILE, ...loadList()]; }
  function get(id){ return list().find(p=>p.id===id) || null; }
  function exists(id){ return !!get(id); }
  function create(name){
    const clean = App.Business.Security.sanitizeName(name);
    if(!clean) return null;
    const profiles = loadList();
    const p = { id: 'biz_'+uid(), type:'business', name: clean, icon:'🏢', createdDate: todayStr() };
    profiles.push(p);
    saveList(profiles);
    App.Business.Logger.info('business profile created', p.id, clean);
    return p;
  }
  function rename(id, newName){
    if(!App.Business.Security.canRename(id)) return false;
    const clean = App.Business.Security.sanitizeName(newName);
    if(!clean) return false;
    const profiles = loadList();
    const p = profiles.find(x=>x.id===id);
    if(!p) return false;
    p.name = clean;
    saveList(profiles);
    App.Business.Logger.info('business profile renamed', id, clean);
    return true;
  }
  function remove(id){
    if(!App.Business.Security.canRemove(id)) return false;
    saveList(loadList().filter(x=>x.id!==id));
    // Deliberately does NOT delete the profile's stored data
    // (khaata:biz:<id>:*) — only removes it from the switcher list, so
    // a mis-click can never silently wipe a business's books. Real
    // deletion (with confirmation) is left for a future sprint.
    App.Business.Logger.info('business profile removed from list (data retained)', id);
    return true;
  }
  return { list, get, exists, create, rename, remove };
})();

/* ---- App.Business.Workspace ----------------------------------------
   Read-only facade future Business modules (Customers, Vendors,
   Invoices, Inventory, ... — none of which exist yet) will read
   instead of re-deriving profile context themselves. */
App.Business.Workspace = {
  activeProfileId(){ return App.Business.Session.getActiveId(); },
  activeProfile(){ return App.Business.Profile.get(this.activeProfileId()) || App.Business.Config.PERSONAL_PROFILE; },
  isBusinessProfile(){ return this.activeProfileId() !== 'personal'; },
  // Same resolver bizKey() uses — future business-only modules (a
  // Customers list, say) key off this so they inherit isolation for
  // free instead of reinventing it.
  scopedKey(base){ return App.Business.Storage.resolveKey(base); }
};

/* ---- App.Business.Manager ----------------------------------------
   Orchestrator: renders/binds the profile switcher, and performs the
   actual instant switch. switchProfile() deliberately reuses
   loadState() itself rather than re-implementing hydration — see the
   Sprint 23 build-log entry for why that's safe and non-duplicative. */
App.Business.Manager = {
  init(){
    this.renderSwitcherUI();
    this.bindUI();
    App.Business.Logger.info('Business Foundation ready — active profile:', App.Business.Session.getActiveId());
  },
  renderSwitcherUI(){
    const sel = document.getElementById('businessProfileSwitcher');
    if(!sel) return;
    const activeId = App.Business.Session.getActiveId();
    const esc = (App.Utils && App.Utils.escapeHtml) ? App.Utils.escapeHtml : (s=>s);
    const profiles = App.Business.Profile.list();
    sel.innerHTML = profiles.map(p=>
      `<option value="${esc(p.id)}"${p.id===activeId?' selected':''}>${p.icon} ${esc(p.name)}</option>`
    ).join('') + `<option value="__new_business__">＋ New Business…</option>`;
  },
  bindUI(){
    const sel = document.getElementById('businessProfileSwitcher');
    if(!sel || sel.dataset.bizBound) return;
    sel.dataset.bizBound = '1';
    sel.addEventListener('change', async (e)=>{
      const val = e.target.value;
      if(val === '__new_business__'){
        const name = prompt('New business name:');
        if(name && name.trim()){
          const p = App.Business.Profile.create(name);
          if(p) await this.switchProfile(p.id);
          else this.renderSwitcherUI();
        } else {
          this.renderSwitcherUI(); // cancelled — revert the select back to the active profile
        }
        return;
      }
      await this.switchProfile(val);
    });
  },
  async switchProfile(targetId){
    const Session = App.Business.Session, Profile = App.Business.Profile, Logger = App.Business.Logger;
    if(!Profile.exists(targetId)){ Logger.warn('switchProfile: unknown profile', targetId); return false; }
    if(targetId === Session.getActiveId()) return true; // already active — no-op
    try{
      App.Business.Storage.resetScopedState();
      Session.setActiveId(targetId);
      await loadState(); // fully reused, unmodified — now profile-aware via bizKey()
      this.refreshUI();
      Logger.info('switched to profile', targetId);
      return true;
    }catch(err){
      Logger.error('switchProfile failed', err);
      return false;
    }
  },
  refreshUI(){
    // Same populate*() calls App.init() already runs at startup — safe
    // to re-run, they just rebuild <select> option lists from state.
    try{ populateCategorySelect(); }catch(e){}
    try{ populateAccountSelects(); }catch(e){}
    try{ populateFilterCategories(); }catch(e){}
    try{ populateBudgetCategorySelect(); }catch(e){}
    try{ populateSubcatParentSelect(); }catch(e){}
    try{ populateCCSelects(); }catch(e){}
    try{ processDueRecurring(); }catch(e){}     // already dedupes by recurringId+date — safe to re-run
    try{ recordNetWorthSnapshot(); }catch(e){}
    const activeTabBtn = document.querySelector('.tab.active');
    const activeView = activeTabBtn ? activeTabBtn.dataset.view : 'dashboard';
    try{ renderView(activeView); }catch(e){}
    try{ renderDashboard(); }catch(e){}
    this.renderSwitcherUI();
    flash();
  }
};

/* ---------------------------------------------------------------- */

/* ---------------------------------------------------------------
   INIT
--------------------------------------------------------------- */
/* App.init — centralized startup sequence. Same steps that used to run
   inside an anonymous IIFE, now named and wrapped in error handling so a
   single failed step is logged instead of silently breaking the rest of
   startup. */
App.init = async function init(){
  try{
    await loadState();
    populateCategorySelect();
    populateAccountSelects();
    populateFilterCategories();
    populateBudgetCategorySelect();
    populateSubcatParentSelect();
    processDueRecurring();
    populateCCSelects();
    recordNetWorthSnapshot();
    if(window.innerWidth<=768) document.getElementById('mobileSearchBtn').style.display='flex';
    initVoiceEngine();
    applyVoiceEnabledUI();
    // New Voice Interface Layer (App.Voice) — resets its state machine and
    // does a passive mic-permission check only; never starts listening on
    // its own. Kept in its own try/catch so a failure here can never break
    // the rest of app startup (mirrors how initVoiceEngine() above behaves).
    try{ await App.Voice.initialize(); App.Voice.UI.bind(); }catch(err){ App.Logger.error('App.Voice.initialize failed', err); }
    // Real Conversation Engine (App.Chat) — the working chat UI. Restores any
    // in-progress chat session/log from localStorage and wires the FAB + panel.
    try{ App.Chat.initialize(); }catch(err){ App.Logger.error('App.Chat.initialize failed', err); }
    // Voice ⇄ Chat Bridge (App.Voice.Bridge) — Sprint 19. Connects the real
    // voice engine above to the real conversation engine (App.Chat), so
    // voice becomes a first-class way to do everything chat already does.
    // Must run after both App.Voice.initialize() and App.Chat.initialize()
    // above. Kept in its own try/catch, same as every module here, so a
    // failure can never break the rest of app startup — voice and chat
    // keep working independently even if the bridge itself fails to wire.
    try{ App.Voice.Bridge.init(); }catch(err){ App.Logger.error('App.Voice.Bridge.init failed', err); }
    // Wake-Word Listening (App.Voice.WakeWord) — Sprint 40. Resumes passive
    // "Hey <name>" listening from a previous session, but only if the user
    // had it turned on AND mic permission is already granted — never
    // prompts on page load. Kept in its own try/catch, same as every
    // module here, so a failure can never break the rest of app startup;
    // the manual mic button is completely unaffected either way.
    try{ App.Voice.WakeWord.init(); }catch(err){ App.Logger.error('App.Voice.WakeWord.init failed', err); }
    // Offline AI Memory Engine (App.Memory) — opens local storage, warms its
    // caches, then restores whatever is restorable (an unfinished
    // transaction draft, session bookkeeping). Kept in its own try/catch,
    // same as Voice/Chat above, so a failure here can never break the rest
    // of app startup.
    try{ await App.Memory.Manager.init(); await App.Memory.Manager.restore(); }
    catch(err){ App.Logger.error('App.Memory.Manager.init/restore failed', err); }
    // Smart Attachment Engine (App.Attachments) — wires the New Transaction
    // drop zone and the Attachments manager/viewer sheets. Kept in its own
    // try/catch, same as Voice/Chat/Memory above, so a failure here can
    // never break the rest of app startup.
    try{ App.Attachments.UI.bind(); }catch(err){ App.Logger.error('App.Attachments.UI.bind failed', err); }
    // Multi-Item Transaction Entry (App.Transaction.ItemsEditor) — Sprint 25.
    // Wires the Items Editor sheet used to Add/Delete/Edit/Reorder/Duplicate
    // items on an existing multi-item transaction. Kept in its own
    // try/catch, same as every module above, so a failure here can never
    // break the rest of app startup.
    try{ App.Transaction.ItemsEditor.bind(); }catch(err){ App.Logger.error('App.Transaction.ItemsEditor.bind failed', err); }
    // Production OCR Engine (App.OCR) — wires the "Scan Receipt / Bill"
    // zone and review sheet. Kept in its own try/catch, same as the
    // modules above, so a failure here can never break the rest of
    // app startup.
    try{ App.OCR.UI.bind(); }catch(err){ App.Logger.error('App.OCR.UI.bind failed', err); }
    // Intelligent Auto-Save Engine (App.AutoSave) — wires in-progress
    // draft autosave for the New Transaction form and shows the
    // recovery banner if a draft (form or OCR) was left over from a
    // previous session. Kept in its own try/catch, same as the modules
    // above, so a failure here can never break the rest of app startup.
    try{ App.AutoSave.Manager.init(); }catch(err){ App.Logger.error('App.AutoSave.Manager.init failed', err); }
    // Smart Dashboard (App.Dashboard) — wires the auto-update engine to
    // the existing save*() functions. Kept in its own try/catch, same as
    // the modules above, so a failure here can never break the rest of
    // app startup (and renderDashboard() below still runs the original,
    // pre-Sprint-13 dashboard even if this one line failed).
    try{ App.Dashboard.Manager.init(); }catch(err){ App.Logger.error('App.Dashboard.Manager.init failed', err); }
    // AI Reports & Smart Analytics Engine (App.Reports / App.Analytics) —
    // wires its own auto-update hook (composes with App.Dashboard's,
    // does not replace it). Kept in its own try/catch, same as every
    // module above, so a failure here can never break the rest of app
    // startup or any tab before this one.
    try{ App.Reports.Manager.init(); }catch(err){ App.Logger.error('App.Reports.Manager.init failed', err); }
    // Online AI Knowledge Engine (App.OnlineAI) — offline-first Q&A layer.
    // init() only logs readiness; it makes no network calls on its own
    // and never runs unless/until a real question comes through
    // App.Chat. Kept in its own try/catch, same as every module above,
    // so a failure here can never break the rest of app startup.
    try{ App.OnlineAI.Manager.init(); }catch(err){ App.Logger.error('App.OnlineAI.Manager.init failed', err); }
    // Personal AI Financial Advisor (App.Advisor) — Sprint 20. Runs one
    // full analysis pass so alerts/recommendations are ready the moment
    // the "AI Advisor" tab is opened, and wires itself to the same
    // save*() functions App.Dashboard already hooked (composes with it,
    // does not replace it). Kept in its own try/catch, same as every
    // module above, so a failure here can never break the rest of app
    // startup or any tab before this one.
    try{ App.Advisor.Manager.init(); }catch(err){ App.Logger.error('App.Advisor.Manager.init failed', err); }
    // Smart Budget AI & Goal Planner (App.Budget / App.Goals) — Sprint 21.
    // App.Budget.Manager.init() just logs readiness (its data — advanced
    // budgets — was already loaded by loadState() above); both modules'
    // UI.render() calls are wired into the existing renderBudgets()/
    // renderGoals() instead, so they refresh automatically whenever those
    // already do. Kept in its own try/catch, same as every module above,
    // so a failure here can never break the rest of app startup.
    try{ App.Budget.Manager.init(); }catch(err){ App.Logger.error('App.Budget.Manager.init failed', err); }
    // Investment Intelligence System (App.Investment) — Sprint 22. Manager.init()
    // just logs readiness (data was already loaded by loadState() above); its
    // UI.render() is wired into the existing renderInvestments() instead, so it
    // refreshes automatically whenever that already does (same pattern as
    // App.Budget/App.Goals directly above). Kept in its own try/catch, same as
    // every module above, so a failure here can never break the rest of app startup.
    try{ App.Investment.Manager.init(); App.Investment.Watchlist.init(); }catch(err){ App.Logger.error('App.Investment.Manager.init failed', err); }
    // Business Foundation (App.Business) — Sprint 23. loadState() above has
    // already hydrated whichever profile App.Business.Session restored at
    // parse time, so this just renders/binds the profile switcher UI —
    // it does not reload or move any data. Kept in its own try/catch, same
    // as every module above, so a failure here can never break app startup.
    try{ App.Business.Manager.init(); }catch(err){ App.Logger.error('App.Business.Manager.init failed', err); }
    renderDashboard();
    setTimeout(driveInit, 300);
  }catch(err){
    App.Logger.error('App.init failed', err);
  }
};
App.init();
</script>
</body>
</html>
