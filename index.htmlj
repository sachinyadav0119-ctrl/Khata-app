document.querySelectorAll('.scan-option[data-scan]').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.getElementById('scanSheetOverlay').classList.add('hidden');
    switchToView('entry');
    const mode = btn.dataset.scan;
    setTimeout(()=>{
      if(mode==='camera'){
        document.getElementById('ocrScanInput')?.click();
      } else {
        // Gallery / PDF / Document / Image / Audio / Video / Browse Files
        // all route through the same existing multi-type attach input.
        document.getElementById('entryAttachInput')?.click();
      }
    }, 150);
  });
});

/* ---------------------------------------------------------------
   QUICK ADD (FAB)
   Sprint 29 — extracted from the old #fabBtn click handler into a
   named function so it keeps working from every existing caller
   (App.Dashboard.QuickActions.openQuickAdd, #txnMobiAddBtn) even
   though #fabBtn itself now opens the Voice menu instead (see the
   Premium FAB Consolidation block below). No save/validation logic
   changed — this is the exact same body that used to live inline
   on #fabBtn's listener.
--------------------------------------------------------------- */
function openQuickAddOverlay(){
  populateAccountSelects();
