const DEFAULT_EXPENSE_CATS = ["Food","Travel","Shopping","Bills","Entertainment","Personal","Other"];
const DEFAULT_INCOME_SOURCES = ["Salary","Freelance","Business","Gift","Interest","Bonus","Refund","Other"];
const FOOD_CATS = ["Food","Milk","Curd/Dahi","Paneer","Soybean","Roasted Chana","Peanut","Coffee","Water"];
