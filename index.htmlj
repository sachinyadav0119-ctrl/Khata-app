   ENTRY FORM
--------------------------------------------------------------- */
const typeSegBtns = document.querySelectorAll('#typeSeg button');
typeSegBtns.forEach(b=>b.addEventListener('click', ()=>{
  typeSegBtns.forEach(x=>x.classList.remove('active'));
  b.classList.add('active');
  currentEntryType = b.dataset.type;
  const isTransfer = currentEntryType==='transfer';
  document.getElementById('transferFields').style.display = isTransfer? 'grid':'none';
  document.getElementById('normalFields').style.display = isTransfer? 'none':'block';
  if(!isTransfer){
    populateCategorySelect();
    document.getElementById('f_itemLabel').textContent = currentEntryType==='income' ? 'Notes / Description' : 'Item / Description';
  } else {
    populateAccountSelects();
    document.getElementById('f_transferDate').value = todayStr();
  }
}));

function populateCategorySelect(){
  const sel = document.getElementById('f_category');
  const list = currentEntryType==='income' ? incomeSources() : expenseCats();
  sel.innerHTML = list.map(c=>`<option value="${c}">${c}</option>`).join('');
  populateSubcatSelect();
  populateAccountSelects();
}
function populateSubcatSelect(){
  const cat = document.getElementById('f_category').value;
  const subs = subcatsFor(cat);
  document.getElementById('f_subcategory').innerHTML = '<option value="">— none —</option>' + subs.map(s=>`<option>${s}</option>`).join('');
}
document.getElementById('f_category').addEventListener('change', populateSubcatSelect);
function populateAccountSelects(){
  const opts = activeAccounts().map(a=>`<option value="${a.id}">${a.icon||''} ${a.name}</option>`).join('');
  ['f_account','f_fromAccount','f_toAccount','qa_account','qa_from','qa_to','tr_from','tr_to','r_account'].forEach(id=>{
    const el = document.getElementById(id);
    if(el) el.innerHTML = opts;
  });
}
document.getElementById('f_date').value = todayStr();
populateCategorySelect();

// Smart categorization: as the user types a description, suggest a category by keyword match
document.getElementById('f_item').addEventListener('input', e=>{
  const val = e.target.value.toLowerCase();
  const hint = document.getElementById('autoCatHint');
  if(!val){ hint.textContent=''; return; }
  for(const entry of CATEGORY_KEYWORDS){
    if(entry.words.some(w=>val.includes(w))){
      const cat = entry.cat, sub = entry.sub||'';
      if(expenseCats().includes(cat) && (document.getElementById('f_category').value!==cat || (sub && document.getElementById('f_subcategory').value!==sub))){
        const label = sub? `${cat} → ${sub}` : cat;
        hint.innerHTML = `Looks like <b>${label}</b> — <button type="button" class="link-btn" id="applyAutoCat">use this category</button>`;
        document.getElementById('applyAutoCat').onclick = ()=>{
          document.getElementById('f_category').value=cat; populateSubcatSelect();
          if(sub) document.getElementById('f_subcategory').value=sub;
          hint.textContent='Category applied ✓';
        };
      } else hint.textContent='';
      return;
    }
  }
  hint.textContent='';
});

/* ---------------------------------------------------------------
   MULTI-ITEM TRANSACTION ENTRY (Sprint 25, additive)
   In-memory item list for the New Transaction form only — cleared on
   every save/mode switch. Uses App.Transaction.MultiItem for all the
   actual add/remove/reorder/duplicate/sum logic so the New Transaction
   form, the Items Editor sheet, and the chat/voice flow all share one
   implementation. The single-item Amount + Item/Description fields
   and the entire Income/Transfer flow are completely untouched — this
   is strictly an opt-in addition, off by default.
--------------------------------------------------------------- */
let miItems = [];
let miModeActive = false;

function miRenderItems(){
  const wrap = document.getElementById('miList');
  if(!wrap) return;
  wrap.innerHTML = miItems.length ? miItems.map(it=>`
    <div class="mi-item-row" data-id="${it.id}">
      <div class="mi-item-main">
        <input type="text" class="mi-name" placeholder="Item name (e.g. Milk)" value="${escapeHtml(it.name)}">
        <input type="number" class="mi-amount" placeholder="0.00" min="0" step="0.01" value="${it.amount || ''}">
      </div>
      <div class="mi-item-actions">
        <button type="button" class="mi-more" title="Qty / unit / notes">⋯</button>
        <button type="button" class="mi-up" title="Move up">↑</button>
        <button type="button" class="mi-down" title="Move down">↓</button>
        <button type="button" class="mi-dup" title="Duplicate">⧉</button>
        <button type="button" class="mi-del" title="Delete">✕</button>
      </div>
      <div class="mi-item-more hidden">
        <input type="text" class="mi-qty" placeholder="Qty (optional)" value="${it.qty ?? ''}">
        <input type="text" class="mi-unit" placeholder="Unit (optional, e.g. kg)" value="${escapeHtml(it.unit || '')}">
        <input type="text" class="mi-notes" placeholder="Notes (optional)" value="${escapeHtml(it.notes || '')}">
      </div>
    </div>`).join('') : '<div class="empty-note">No items yet — tap "+ Add Item" to start.</div>';
  document.getElementById('miTotalDisplay').textContent = fmt(App.Transaction.MultiItem.sum(miItems));
  wrap.querySelectorAll('.mi-item-row').forEach(row=>{
    const id = row.dataset.id;
    const it = miItems.find(x=>x.id===id);
    if(!it) return;
    row.querySelector('.mi-name').addEventListener('input', e=>{ it.name = e.target.value; });
    row.querySelector('.mi-amount').addEventListener('input', e=>{
      it.amount = parseFloat(e.target.value) || 0;
      document.getElementById('miTotalDisplay').textContent = fmt(App.Transaction.MultiItem.sum(miItems));
    });
    row.querySelector('.mi-qty').addEventListener('input', e=>{ it.qty = e.target.value; });
    row.querySelector('.mi-unit').addEventListener('input', e=>{ it.unit = e.target.value; });
    row.querySelector('.mi-notes').addEventListener('input', e=>{ it.notes = e.target.value; });
    row.querySelector('.mi-more').addEventListener('click', ()=> row.querySelector('.mi-item-more').classList.toggle('hidden'));
    row.querySelector('.mi-up').addEventListener('click', ()=>{ App.Transaction.MultiItem.moveItem(miItems, id, -1); miRenderItems(); });
    row.querySelector('.mi-down').addEventListener('click', ()=>{ App.Transaction.MultiItem.moveItem(miItems, id, 1); miRenderItems(); });
    row.querySelector('.mi-dup').addEventListener('click', ()=>{ App.Transaction.MultiItem.duplicateItem(miItems, id); miRenderItems(); });
    row.querySelector('.mi-del').addEventListener('click', ()=>{ App.Transaction.MultiItem.removeItem(miItems, id); miRenderItems(); });
  });
}
function miAddItem(prefill){
  App.Transaction.MultiItem.addItem(miItems, prefill || {name:'', amount:''});
  miRenderItems();
  const rows = document.querySelectorAll('#miList .mi-item-row');
  const last = rows[rows.length-1];
  if(last) last.querySelector('.mi-name').focus();
}
function miSetMode(active){
  miModeActive = active;
  document.getElementById('multiItemWrap').classList.toggle('hidden', !active);
  document.getElementById('multiItemToggleBtn').textContent = active ? '← Back to single item entry' : '🧾 Add multiple items in this transaction';
  const amountField = document.getElementById('f_amount');
  const amountWrap = amountField.parentElement;
  const itemWrap = document.getElementById('f_item').parentElement;
  if(amountWrap) amountWrap.classList.toggle('hidden', active);
  if(itemWrap) itemWrap.classList.toggle('hidden', active);
  amountField.required = !active;
  if(active && !miItems.length) miAddItem();
}
document.getElementById('multiItemToggleBtn').addEventListener('click', ()=> miSetMode(!miModeActive));
document.getElementById('miAddItemBtn').addEventListener('click', ()=> miAddItem());

document.getElementById('txnForm').addEventListener('submit', async e=>{
  e.preventDefault();
  if(currentEntryType==='transfer'){
    const amount = parseFloat(document.getElementById('f_transferAmount').value);
    const from = document.getElementById('f_fromAccount').value, to = document.getElementById('f_toAccount').value;
    if(!amount || amount<=0){ alert('Enter a valid transfer amount.'); return; }
    if(from===to){ alert('Choose two different accounts.'); return; }
    state.transactions.push({ id:uid(), type:'transfer', date: document.getElementById('f_transferDate').value||todayStr(), fromAccount:from, toAccount:to, amount, notes: document.getElementById('f_transferNotes').value.trim() });
    await saveTransactions();
    document.getElementById('f_transferAmount').value=''; document.getElementById('f_transferNotes').value='';
    document.getElementById('entryHint').textContent='Transfer saved ✓ — account balances updated.';
    refreshAllCharts();
    return;
  }
  const tags = parseTagsInput(document.getElementById('f_tags').value);
  registerTags(tags);
  // Reuse the pending-attachment id (see App.Attachments UI wiring near the
  // end of this file) as the real transaction id, if the user already
  // staged any attachments on this form before saving — that way the files
  // they already added don't need to be re-linked after the fact. Falls
  // back to a fresh id when Attachments isn't loaded or nothing was staged.
  const txnId = (window.App && App.Attachments && App.Attachments.UI.currentEntryAttachId()) || uid();
  const baseFields = {
    id: txnId,
    type: currentEntryType,
    date: document.getElementById('f_date').value || todayStr(),
    time: document.getElementById('f_time').value || '',
    category: document.getElementById('f_category').value,
    subcategory: document.getElementById('f_subcategory').value || '',
    account: document.getElementById('f_account').value,
    mode: document.getElementById('f_mode').value,
    notes: document.getElementById('f_notes').value.trim(),
    tags
  };
  let txn;
  // Sprint 25 — Multi-Item Transaction Entry. Only taken when the user has
  // explicitly opted into "🧾 Add multiple items"; every other save keeps
  // running through the exact single-item path that existed before.
  if(miModeActive){
    if(!miItems.some(it=>it.name.trim() && Number(it.amount)>0)){ alert('Add at least one item with a name and amount.'); return; }
    txn = App.Transaction.MultiItem.buildParentTxn(Object.assign({ item: document.getElementById('f_item').value.trim() }, baseFields), miItems);
    if(!txn.amount || txn.amount<=0){ alert('Enter a valid amount for at least one item.'); return; }
  } else {
    const amount = parseFloat(document.getElementById('f_amount').value);
    if(!amount || amount<=0){ alert('Enter a valid amount.'); return; }
    txn = Object.assign({}, baseFields, { item: document.getElementById('f_item').value.trim(), amount });
  }
  state.transactions.push(txn);
  await saveTransactions();
  await saveTags();
  document.getElementById('f_amount').value='';
  document.getElementById('f_item').value='';
  document.getElementById('f_notes').value='';
  document.getElementById('f_tags').value='';
  document.getElementById('autoCatHint').textContent='';
  if(miModeActive){ miItems = []; miSetMode(false); }
  document.getElementById('entryHint').textContent = 'Saved ✓ — add another, or switch tabs to see it reflected everywhere.';
  refreshAllCharts();
  if(window.App && App.Attachments) App.Attachments.UI.resetEntryZone();
  // Personal AI Financial Advisor (App.Advisor) — real-time save-time check.
  // Runs after the transaction is already saved (never blocks or delays the
  // save itself); surfaces anything worth flagging as a small toast. Kept
  // in its own try/catch, same convention as every other module hooked
  // into App.init, so a failure here can never break entry saving.
  try{ if(window.App && App.Advisor) App.Advisor.Notifications.onTransactionSaved(txn); }
  catch(err){ App.Logger.error('App.Advisor.Notifications.onTransactionSaved failed', err); }
});

document.getElementById('addCustomCatBtn').addEventListener('click', async ()=>{
  const type = document.getElementById('cc_type').value;
  const name = document.getElementById('cc_name').value.trim();
  if(!name) return;
  if(type==='expense'){ if(!expenseCats().includes(name)) state.customExpenseCats.push(name); }
  else { if(!incomeSources().includes(name)) state.customIncomeSources.push(name); }
  await saveCustomCats();
  document.getElementById('cc_name').value='';
  populateCategorySelect();
  populateFilterCategories();
  populateBudgetCategorySelect();
  populateSubcatParentSelect();
});

function populateSubcatParentSelect(){
  const sel = document.getElementById('sc_parent');
  if(sel) sel.innerHTML = expenseCats().map(c=>`<option>${c}</option>`).join('');
}
populateSubcatParentSelect();
document.getElementById('addSubcatBtn').addEventListener('click', async ()=>{
  const parent = document.getElementById('sc_parent').value;
  const name = document.getElementById('sc_name').value.trim();
  if(!name) return;
  if(!state.customSubcats[parent]) state.customSubcats[parent]=[];
  if(!subcatsFor(parent).includes(name)) state.customSubcats[parent].push(name);
  await saveSubcats();
  document.getElementById('sc_name').value='';
  populateSubcatSelect();
});

/* ---------------------------------------------------------------
   DASHBOARD
--------------------------------------------------------------- */
function destroyChart(key){ if(charts[key]){ charts[key].destroy(); delete charts[key]; } }

function chartTheme(){
  const dark = state.theme==='dark';
  return { grid: dark? 'rgba(255,255,255,.06)':'rgba(18,32,58,.08)', text: dark? '#B8B0A0':'#3A4A68' };
}

/* ---------------------------------------------------------------
   SAFE TO SPEND TODAY
--------------------------------------------------------------- */
function computeSafeToSpend(){
  const inc = incomeTxns(), exp = expenseTxns();
  const from = startOfMonth(0), to = endOfMonth(0);
  const monthIncome = sum(inc.filter(t=>dateInRange(t.date,from,to)));
  const monthExpenseSoFar = sum(exp.filter(t=>dateInRange(t.date,from,to)));
  const today = new Date();
  const daysInMonth = new Date(today.getFullYear(), today.getMonth()+1, 0).getDate();
  const daysElapsed = today.getDate();
  const daysRemaining = Math.max(1, daysInMonth - daysElapsed + 1);

  const available = totalMoney();
  // upcoming committed expenses in the rest of this month: recurring due + budget remainder
  const upcomingRecurring = sum(dueRecurringInRange(todayStr(), endOfMonth(0)).map(r=>({amount:r.amount})));
  const totalBudgeted = Object.values(state.budgets).reduce((a,b)=>a+Number(b||0),0);
  const goalMonthly = state.goals.filter(g=>!g.achieved).reduce((s,g)=>s+(Number(g.monthlyOverride)||0),0);
  const emergencyBuffer = 0; // buffer already reflected via goal planner's own buffer logic

  const committedRemaining = Math.max(0, upcomingRecurring) + goalMonthly*0.0; // recurring already time-bound; goals handled via planner, kept light here
  const budgetRemainder = Math.max(0, totalBudgeted - monthExpenseSoFar);
  const incomeBasis = monthIncome>0 ? monthIncome : available;

  // Distribute what's safely spendable across the days left in the month
  const spendableMonthPool = Math.max(0, Math.min(available, incomeBasis) - monthExpenseSoFar - upcomingRecurring - emergencyBuffer);
  const dailyAllowance = spendableMonthPool>0 ? spendableMonthPool/daysRemaining : 0;

  const spentToday = sum(exp.filter(t=>t.date===todayStr()));
  const remaining = dailyAllowance - spentToday;
  return { dailyAllowance, spentToday, remaining, exceeded: remaining<0, over: Math.abs(Math.min(0,remaining)) };
}
function dueRecurringInRange(from,to){
  return (state.recurring||[]).filter(r=>r.active!==false && r.nextDate && r.nextDate>=from && r.nextDate<=to);
}

function renderDashboardHero(){
  const inc = incomeTxns(), exp = expenseTxns();
  const from = startOfMonth(0), to = endOfMonth(0);
  const monthIncome = sum(inc.filter(t=>dateInRange(t.date,from,to)));
  const monthExpense = sum(exp.filter(t=>dateInRange(t.date,from,to)));
  const monthSavings = monthIncome - monthExpense;
  const savingsRate = monthIncome? (monthSavings/monthIncome*100) : 0;
  const spentToday = sum(exp.filter(t=>t.date===todayStr()));
  const total = totalMoney();
  const sts = computeSafeToSpend();

  document.getElementById('heroGrid').innerHTML = `
    <div class="hero-card big" style="--accent:var(--gold);"><div class="hl">Total Money</div><div class="hv">${fmt(total)}</div><div class="hs">across ${activeAccounts().length} active account(s)</div></div>
    <div class="hero-card" style="--accent:var(--teal);"><div class="hl">This Month Income</div><div class="hv">${fmt(monthIncome)}</div></div>
    <div class="hero-card" style="--accent:var(--rust);"><div class="hl">This Month Spending</div><div class="hv">${fmt(monthExpense)}</div></div>
    <div class="hero-card" style="--accent:${monthSavings>=0?'var(--teal)':'var(--rust)'};"><div class="hl">This Month Savings</div><div class="hv">${fmt(monthSavings)}</div></div>
    <div class="hero-card" style="--accent:var(--gold);"><div class="hl">Savings Rate</div><div class="hv">${monthIncome?savingsRate.toFixed(1)+'%':'—'}</div></div>
    <div class="hero-card" style="--accent:var(--rust);"><div class="hl">Today's Spending</div><div class="hv">${fmt(spentToday)}</div></div>
  `;

  const pct = sts.dailyAllowance>0 ? Math.min(100, sts.spentToday/sts.dailyAllowance*100) : (sts.spentToday>0?100:0);
  document.getElementById('stsCard').innerHTML = `
    <div class="sts-top">
      <div><div class="sts-label">Safe to Spend Today</div><div class="sts-amt ${sts.exceeded?'over':''}">${fmt(sts.dailyAllowance)}</div></div>
      <div style="text-align:right;"><div class="sts-label">Spent Today</div><div style="font-family:var(--font-mono);font-weight:700;font-size:18px;">${fmt(sts.spentToday)}</div></div>
    </div>
    <div class="sts-bar"><div class="sts-bar-fill ${sts.exceeded?'over':''}" style="width:${pct}%;"></div></div>
    <div class="sts-sub">Remaining today: <b>${fmt(sts.remaining)}</b></div>
    ${sts.exceeded? `<div class="sts-warn">⚠️ You have exceeded today's recommended spending by ${fmt(sts.over)}.</div>` : ''}
    <div class="sts-disclaimer">This is an estimate based on your recorded income, spending, budgets and recurring commitments — not guaranteed financial advice.</div>
  `;
}
document.getElementById('dashDetailsToggle').addEventListener('click', ()=>{
  const panel = document.getElementById('dashDetailsPanel');
  panel.classList.toggle('hidden');
  document.getElementById('dashDetailsToggle').textContent = panel.classList.contains('hidden') ? 'Show ▾' : 'Hide ▲';
  if(!panel.classList.contains('hidden')) renderDashboardDetails();
});

function renderDashboard(){
  renderDashboardHero();
  if(!document.getElementById('dashDetailsPanel').classList.contains('hidden')) renderDashboardDetails();
}

function renderDashboardDetails(){
  const inc = incomeTxns(), exp = expenseTxns();
  const totalIncome = sum(inc), totalExpense = sum(exp);
  const net = totalIncome-totalExpense;
  const savingsRate = totalIncome>0 ? (net/totalIncome*100) : 0;
  const incDays = uniqueDays(inc), expDays = uniqueDays(exp);
  const avgDailyExp = expDays.size ? totalExpense/expDays.size : 0;
  const avgDailyInc = incDays.size ? totalIncome/incDays.size : 0;

  // highest expense category
  const byCat = {};
  exp.forEach(t=>{ byCat[t.category]=(byCat[t.category]||0)+Number(t.amount); });
  let topCat = null, topCatAmt=0;
  Object.entries(byCat).forEach(([c,a])=>{ if(a>topCatAmt){topCat=c; topCatAmt=a;} });

  // highest spending day
  const byDay = {};
  exp.forEach(t=>{ byDay[t.date]=(byDay[t.date]||0)+Number(t.amount); });
  let topDay=null, topDayAmt=0;
  Object.entries(byDay).forEach(([d,a])=>{ if(a>topDayAmt){topDay=d; topDayAmt=a;} });

  /* Sprint 33 — six additional metrics for the redesigned Full
     Breakdown grid. Every figure below is derived from the exact
     same transaction/helper data the ten metrics above already use
     (startOfMonth/endOfMonth/dateInRange/computeHealthScoreDetail) —
     nothing invented, nothing duplicated. */
  const thisFrom = startOfMonth(0), thisTo = endOfMonth(0);
  const lastFrom = startOfMonth(-1), lastTo = endOfMonth(-1);
  const thisMonthInc = sum(inc.filter(t=>dateInRange(t.date,thisFrom,thisTo)));
  const thisMonthExp = sum(exp.filter(t=>dateInRange(t.date,thisFrom,thisTo)));
  const lastMonthInc = sum(inc.filter(t=>dateInRange(t.date,lastFrom,lastTo)));
  const lastMonthExp = sum(exp.filter(t=>dateInRange(t.date,lastFrom,lastTo)));
  const thisMonthNet = thisMonthInc - thisMonthExp;
  const lastMonthNet = lastMonthInc - lastMonthExp;
  const monthlyGrowth = lastMonthNet!==0 ? ((thisMonthNet-lastMonthNet)/Math.abs(lastMonthNet)*100) : null;
  const weeklyAvgExpense = expDays.size ? avgDailyExp*7 : 0;
  const expTrendPct = lastMonthExp>0 ? ((thisMonthExp-lastMonthExp)/lastMonthExp*100) : null;
  const incTrendPct = lastMonthInc>0 ? ((thisMonthInc-lastMonthInc)/lastMonthInc*100) : null;
  let healthScore = null;
  try{ healthScore = computeHealthScoreDetail().overall; }catch(e){}

  const kpis = [
    {label:'Total Income', value:fmt(totalIncome), cls:'income', ic:'💰', sub:`${inc.length} entries`},
    {label:'Total Expenses', value:fmt(totalExpense), cls:'expense', ic:'💳', sub:`${exp.length} entries`},
    {label:'Current Balance', value:fmt(net), cls: net>=0?'savings':'expense', ic:'🏦', sub: net>=0?'Positive':'Negative'},
    {label:'Net Savings', value:fmt(net), cls: net>=0?'savings':'expense', ic:'🐷', sub:`${savingsRate.toFixed(1)}% of income`},
    {label:'Savings Rate', value: totalIncome? savingsRate.toFixed(1)+'%':'—', cls:'savings', ic:'📈', sub: totalIncome? 'Of total income' : 'No income logged yet'},
    {label:'Avg Daily Income', value: incDays.size? fmt(avgDailyInc):'—', cls:'income', ic:'☀️', sub: incDays.size? `over ${incDays.size} day(s)`:'Not enough data yet'},
    {label:'Avg Daily Expense', value: expDays.size? fmt(avgDailyExp):'—', cls:'expense', ic:'🌙', sub: expDays.size? `over ${expDays.size} day(s)`:'Not enough data yet'},
    {label:'Top Expense Category', value: topCat||'—', cls:'expense', ic:'🏷️', sub: topCat? fmt(topCatAmt):'Not enough data yet'},
    {label:'Highest Spending Day', value: topDay||'—', cls:'expense', ic:'📅', sub: topDay? fmt(topDayAmt):'Not enough data yet'},
    {label:'Total Transactions', value: state.transactions.length, cls:'savings', ic:'🧾', sub:'income + expense'},
    {label:'Monthly Growth', value: monthlyGrowth!=null? `${monthlyGrowth>=0?'+':''}${monthlyGrowth.toFixed(1)}%`:'—', cls: monthlyGrowth>=0?'savings':'expense', ic:'🚀', sub:'Net vs last month'},
    {label:'Weekly Average', value: expDays.size? fmt(weeklyAvgExpense):'—', cls:'expense', ic:'🗓️', sub:'Estimated spend / week'},
    {label:'Expense Trend', value: expTrendPct!=null? `${expTrendPct>=0?'↑':'↓'} ${Math.abs(expTrendPct).toFixed(1)}%`:'—', cls: expTrendPct>0?'expense':'savings', ic:'📉', sub:'vs last month'},
    {label:'Income Trend', value: incTrendPct!=null? `${incTrendPct>=0?'↑':'↓'} ${Math.abs(incTrendPct).toFixed(1)}%`:'—', cls: incTrendPct>=0?'savings':'expense', ic:'📊', sub:'vs last month'},
    {label:'Cash Flow', value: fmt(thisMonthNet), cls: thisMonthNet>=0?'savings':'expense', ic:'🔄', sub: thisMonthNet>=0?'Positive this month':'Negative this month'},
    {label:'Financial Health Score', value: healthScore!=null? `${healthScore}/100` : '—', cls: healthScore>=70?'savings':(healthScore!=null&&healthScore<40?'expense':'income'), ic:'🩺', sub: healthScore!=null? 'See AI Advisor for detail':'Not enough data yet'}
  ];
  document.getElementById('kpiGrid').innerHTML = kpis.map(k=>`
    <div class="kpi kh-bd-card ${k.cls}"><div class="kh-bd-ic">${k.ic}</div><div class="kpi-label">${k.label}</div><div class="kpi-value">${k.value}</div><div class="kpi-sub">${k.sub}</div></div>
  `).join('');

  const grid = document.getElementById('dashCharts');
  grid.innerHTML = `
    <div class="chart-box"><h4>Daily Income vs Expense (last 30 days)</h4><canvas id="c_daily"></canvas></div>
    <div class="chart-box"><h4>Monthly Income vs Expense Trend</h4><canvas id="c_monthly"></canvas></div>
    <div class="chart-box"><h4>Daily Savings Trend</h4><canvas id="c_dailysavings"></canvas></div>
    <div class="chart-box"><h4>Cumulative Savings</h4><canvas id="c_cumulative"></canvas></div>
    <div class="chart-box"><h4>Expense Category Breakdown</h4><canvas id="c_catbreak"></canvas></div>
    <div class="chart-box"><h4>Income Source Breakdown</h4><canvas id="c_incbreak"></canvas></div>
    <div class="chart-box"><h4>Top 5 Expense Categories</h4><canvas id="c_top5"></canvas></div>
    <div class="chart-box"><h4>Budget vs Actual (this month)</h4><canvas id="c_budget"></canvas></div>
  `;
  buildDailyChart(); buildMonthlyChart(); buildDailySavingsChart(); buildCumulativeChart();
  buildCatBreakdown(); buildIncomeBreakdown(); buildTop5Chart(); buildBudgetChart();
}

function last30Dates(){
  const arr=[]; const d=new Date();
  for(let i=29;i>=0;i--){ const x=new Date(d); x.setDate(d.getDate()-i); arr.push(x.toISOString().slice(0,10)); }
  return arr;
}

function buildDailyChart(){
  destroyChart('daily');
  const days = last30Dates();
  const inc = days.map(d=> sum(incomeTxns().filter(t=>t.date===d)) );
  const exp = days.map(d=> sum(expenseTxns().filter(t=>t.date===d)) );
  if(!state.transactions.length){ noData('c_daily'); return; }
  const {grid,text} = chartTheme();
  charts.daily = new Chart(document.getElementById('c_daily'), {
    type:'bar',
    data:{ labels: days.map(d=>d.slice(5)), datasets:[
      {label:'Income', data:inc, backgroundColor:'#0E7C6B'},
      {label:'Expense', data:exp, backgroundColor:'#B54834'}
    ]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:text}}},scales:{x:{ticks:{color:text,maxRotation:0,autoSkip:true},grid:{color:grid}},y:{ticks:{color:text},grid:{color:grid}}}}
  });
}
function monthsRange(){
  const set = new Set(state.transactions.map(t=>monthKey(t.date)));
  return [...set].sort();
}
function buildMonthlyChart(){
  destroyChart('monthly');
  const months = monthsRange();
  if(!months.length){ noData('c_monthly'); return; }
  const inc = months.map(m=> sum(incomeTxns().filter(t=>monthKey(t.date)===m)) );
  const exp = months.map(m=> sum(expenseTxns().filter(t=>monthKey(t.date)===m)) );
  const {grid,text} = chartTheme();
  charts.monthly = new Chart(document.getElementById('c_monthly'), {
    type:'line',
    data:{ labels:months, datasets:[
      {label:'Income', data:inc, borderColor:'#0E7C6B', backgroundColor:'#0E7C6B', tension:.3},
      {label:'Expense', data:exp, borderColor:'#B54834', backgroundColor:'#B54834', tension:.3}
    ]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:text}}},scales:{x:{ticks:{color:text},grid:{color:grid}},y:{ticks:{color:text},grid:{color:grid}}}}
  });
}
function buildDailySavingsChart(){
  destroyChart('dailysavings');
  const days = last30Dates();
  if(!state.transactions.length){ noData('c_dailysavings'); return; }
  const data = days.map(d=> sum(incomeTxns().filter(t=>t.date===d)) - sum(expenseTxns().filter(t=>t.date===d)) );
  const {grid,text} = chartTheme();
  charts.dailysavings = new Chart(document.getElementById('c_dailysavings'), {
    type:'line',
    data:{ labels:days.map(d=>d.slice(5)), datasets:[{label:'Net Savings', data, borderColor:'#B98A1E', backgroundColor:'#B98A1E22', fill:true, tension:.3}] },
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{color:text,autoSkip:true},grid:{color:grid}},y:{ticks:{color:text},grid:{color:grid}}}}
  });
}
function buildCumulativeChart(){
  destroyChart('cumulative');
  const allDates = [...new Set(state.transactions.map(t=>t.date))].sort();
  if(!allDates.length){ noData('c_cumulative'); return; }
  let run=0;
  const data = allDates.map(d=>{
    run += sum(incomeTxns().filter(t=>t.date===d)) - sum(expenseTxns().filter(t=>t.date===d));
    return run;
  });
  const {grid,text} = chartTheme();
  charts.cumulative = new Chart(document.getElementById('c_cumulative'), {
    type:'line',
    data:{ labels:allDates.map(d=>d.slice(5)), datasets:[{label:'Cumulative Savings', data, borderColor:'#0E7C6B', backgroundColor:'#0E7C6B22', fill:true, tension:.25}] },
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{color:text,autoSkip:true},grid:{color:grid}},y:{ticks:{color:text},grid:{color:grid}}}}
  });
}
function buildCatBreakdown(){
  destroyChart('catbreak');
  const byCat={}; expenseTxns().forEach(t=>byCat[t.category]=(byCat[t.category]||0)+Number(t.amount));
  const labels = Object.keys(byCat);
  if(!labels.length){ noData('c_catbreak'); return; }
  const {text} = chartTheme();
  charts.catbreak = new Chart(document.getElementById('c_catbreak'), {
    type:'doughnut',
    data:{ labels, datasets:[{data:Object.values(byCat), backgroundColor: palette(labels.length)}] },
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:text,boxWidth:10,font:{size:10}}}}}
  });
}
function buildIncomeBreakdown(){
  destroyChart('incbreak');
  const byCat={}; incomeTxns().forEach(t=>byCat[t.category]=(byCat[t.category]||0)+Number(t.amount));
  const labels = Object.keys(byCat);
  if(!labels.length){ noData('c_incbreak'); return; }
  const {text} = chartTheme();
  charts.incbreak = new Chart(document.getElementById('c_incbreak'), {
    type:'doughnut',
    data:{ labels, datasets:[{data:Object.values(byCat), backgroundColor: palette(labels.length, true)}] },
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:text,boxWidth:10,font:{size:10}}}}}
  });
}
function buildTop5Chart(){
  destroyChart('top5');
  const byCat={}; expenseTxns().forEach(t=>byCat[t.category]=(byCat[t.category]||0)+Number(t.amount));
  const sorted = Object.entries(byCat).sort((a,b)=>b[1]-a[1]).slice(0,5);
  if(!sorted.length){ noData('c_top5'); return; }
  const {grid,text} = chartTheme();
  charts.top5 = new Chart(document.getElementById('c_top5'), {
    type:'bar',
    data:{ labels: sorted.map(s=>s[0]), datasets:[{label:'Spent', data: sorted.map(s=>s[1]), backgroundColor:'#B54834'}] },
    options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{color:text},grid:{color:grid}},y:{ticks:{color:text},grid:{color:grid}}}}
  });
}
function buildBudgetChart(){
  destroyChart('budget');
  const cats = Object.keys(state.budgets);
  if(!cats.length){ noData('c_budget'); return; }
  const from = startOfMonth(0), to = endOfMonth(0);
  const actual = cats.map(c=> sum(expenseTxns().filter(t=>t.category===c && dateInRange(t.date,from,to))) );
  const budget = cats.map(c=> Number(state.budgets[c])||0 );
  const {grid,text} = chartTheme();
  charts.budget = new Chart(document.getElementById('c_budget'), {
    type:'bar',
    data:{ labels:cats, datasets:[
      {label:'Budget', data:budget, backgroundColor:'#B98A1E66'},
      {label:'Actual', data:actual, backgroundColor:'#B54834'}
    ]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{labels:{color:text}}},scales:{x:{ticks:{color:text},grid:{color:grid}},y:{ticks:{color:text},grid:{color:grid}}}}
  });
}
function noData(canvasId){
  const c = document.getElementById(canvasId);
  if(c) c.parentElement.innerHTML += '<div class="empty-note">Not enough data available yet. Add a few transactions to see this chart.</div>';
}
function palette(n, alt){
  const base = alt
    ? ['#0E7C6B','#B98A1E','#3A4A68','#B54834','#7C9C8C','#D4AF67','#5C7080','#8F5A45','#4A8B7C','#C79A3D']
    : ['#B54834','#B98A1E','#0E7C6B','#3A4A68','#D98B6C','#E0C368','#5C9C8C','#7A6A8C','#C97A5A','#4A6E63'];
  const out=[]; for(let i=0;i<n;i++) out.push(base[i%base.length]); return out;
}
function refreshAllCharts(){
  const activeView = document.querySelector('.tab.active').dataset.view;
  renderView(activeView);
}

/* ---------------------------------------------------------------
   TRANSACTIONS TABLE
--------------------------------------------------------------- */
function populateFilterCategories(){
  const sel = document.getElementById('tCategory');
  const cats = [...new Set([...expenseCats(), ...incomeSources()])];
  sel.innerHTML = '<option value="all">All categories</option>' + cats.map(c=>`<option>${c}</option>`).join('');
  const subSel = document.getElementById('tSubcategory');
  if(subSel){
    const allSubs = [...new Set(Object.keys(DEFAULT_SUBCATS).concat(Object.keys(state.customSubcats||{})).flatMap(c=>subcatsFor(c)))];
    subSel.innerHTML = '<option value="all">All subcategories</option>' + allSubs.map(s=>`<option>${s}</option>`).join('');
  }
  const acctSel = document.getElementById('tAccount');
  if(acctSel) acctSel.innerHTML = '<option value="all">All accounts</option>' + state.accounts.map(a=>`<option value="${a.id}">${a.name}</option>`).join('');
  const tagSel = document.getElementById('tTag');
  if(tagSel) tagSel.innerHTML = '<option value="all">All tags</option>' + allTags().map(t=>`<option>${t}</option>`).join('');
}
populateFilterCategories();

['tSearch','tRange','tType','tCategory','tSubcategory','tAccount','tMode','tTag','tMin','tMax','tSort','tFrom','tTo'].forEach(id=>{
  const el = document.getElementById(id);
  if(!el) return;
  el.addEventListener('input', renderTransactions);
  el.addEventListener('change', renderTransactions);
});
document.getElementById('tRange').addEventListener('change', e=>{
  document.getElementById('customRangeWrap').classList.toggle('hidden', e.target.value!=='custom');
});
document.getElementById('clearFiltersBtn').addEventListener('click', ()=>{
  ['tSearch','tMin','tMax','tFrom','tTo'].forEach(id=>document.getElementById(id).value='');
  ['tRange','tType','tCategory','tSubcategory','tAccount','tMode','tTag'].forEach(id=>document.getElementById(id).value= (id==='tRange'?'all':'all'));
  document.getElementById('tSort').value='newest';
  document.getElementById('customRangeWrap').classList.add('hidden');
  renderTransactions();
});

/* Mobile Transactions header — All/Income/Expense/Transfer pills just
   drive the existing #tType select (same filteredTransactions() path
   as desktop), so no new filtering logic is introduced. */
document.querySelectorAll('#txnMobiPills .txn-pill').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    document.getElementById('tType').value = btn.dataset.ttype;
    renderTransactions();
  });
});
document.getElementById('txnMobiFilterBtn')?.addEventListener('click', ()=>{
  document.getElementById('txnFiltersCard')?.classList.toggle('open');
});
document.getElementById('txnMobiSearchBtn')?.addEventListener('click', ()=>{
  document.getElementById('txnFiltersCard')?.classList.add('open');
  document.getElementById('tSearch')?.focus();
});
document.getElementById('txnMobiAddBtn')?.addEventListener('click', ()=>{
  openQuickAddOverlay();
});

function filteredTransactions(){
  let list = [...state.transactions];
  const range = document.getElementById('tRange').value;
  const now = todayStr();
  if(range==='today') list = list.filter(t=>t.date===now);
  else if(range==='yesterday'){ const y=new Date(); y.setDate(y.getDate()-1); const ys=y.toISOString().slice(0,10); list=list.filter(t=>t.date===ys); }
  else if(range==='week') list = list.filter(t=>t.date>=startOfWeek());
  else if(range==='lastweek'){ const s=new Date(); const day=s.getDay(); const diff=(day===0?6:day-1); s.setDate(s.getDate()-diff-7); const from=s.toISOString().slice(0,10); const e=new Date(s); e.setDate(e.getDate()+6); const to=e.toISOString().slice(0,10); list=list.filter(t=>dateInRange(t.date,from,to)); }
  else if(range==='month') list = list.filter(t=>dateInRange(t.date, startOfMonth(0), endOfMonth(0)));
  else if(range==='prevmonth') list = list.filter(t=>dateInRange(t.date, startOfMonth(-1), endOfMonth(-1)));
  else if(range==='last7'){ const d=new Date(); d.setDate(d.getDate()-6); const from=d.toISOString().slice(0,10); list=list.filter(t=>t.date>=from); }
  else if(range==='last30'){ const d=new Date(); d.setDate(d.getDate()-29); const from=d.toISOString().slice(0,10); list=list.filter(t=>t.date>=from); }
  else if(range==='custom'){
    const f = document.getElementById('tFrom').value, to = document.getElementById('tTo').value;
    if(f) list = list.filter(t=>t.date>=f);
    if(to) list = list.filter(t=>t.date<=to);
  }
  const type = document.getElementById('tType').value;
  if(type!=='all') list = list.filter(t=>t.type===type);
  const cat = document.getElementById('tCategory').value;
  if(cat!=='all') list = list.filter(t=>t.category===cat);
  const subcat = document.getElementById('tSubcategory')?.value;
  if(subcat && subcat!=='all') list = list.filter(t=>t.subcategory===subcat);
  const acct = document.getElementById('tAccount')?.value;
  if(acct && acct!=='all') list = list.filter(t=>t.account===acct || t.fromAccount===acct || t.toAccount===acct);
  const mode = document.getElementById('tMode').value;
  if(mode!=='all') list = list.filter(t=>t.mode===mode);
  const tag = document.getElementById('tTag')?.value;
  if(tag && tag!=='all') list = list.filter(t=>(t.tags||[]).includes(tag));
  const min = parseFloat(document.getElementById('tMin')?.value);
  if(!isNaN(min)) list = list.filter(t=>Number(t.amount)>=min);
  const max = parseFloat(document.getElementById('tMax')?.value);
  if(!isNaN(max)) list = list.filter(t=>Number(t.amount)<=max);
  const q = document.getElementById('tSearch').value.trim().toLowerCase();
  if(q) list = list.filter(t => (t.item||'').toLowerCase().includes(q) || (t.notes||'').toLowerCase().includes(q) || (t.category||'').toLowerCase().includes(q) || (t.subcategory||'').toLowerCase().includes(q) || (t.tags||[]).join(' ').toLowerCase().includes(q));

  const sortMode = document.getElementById('tSort')?.value || 'newest';
  if(sortMode==='newest') list.sort((a,b)=> b.date.localeCompare(a.date) || (b.time||'').localeCompare(a.time||''));
  else if(sortMode==='oldest') list.sort((a,b)=> a.date.localeCompare(b.date) || (a.time||'').localeCompare(b.time||''));
  else if(sortMode==='highest') list.sort((a,b)=> Number(b.amount)-Number(a.amount));
  else if(sortMode==='lowest') list.sort((a,b)=> Number(a.amount)-Number(b.amount));
  return list;
}
function txnDisplayLine(t){
  if(t.type==='transfer'){
    const fa = accountById(t.fromAccount), ta = accountById(t.toAccount);
    return { label: `${fa?fa.name:'—'} → ${ta?ta.name:'—'}`, sub: 'Transfer', amtClass:'', prefix:'' };
  }
  const acc = accountById(t.account);
  return { label: t.category + (t.subcategory? ' / '+t.subcategory : ''), sub: acc?acc.name:'', amtClass: t.type==='income'?'amt-in':'amt-ex', prefix: t.type==='income'?'+':'-' };
}
/* ---------------------------------------------------------------
   TRANSACTIONS — MOBILE APP LOOK (helpers)
   Pure presentation helpers for the new mobile card list. They only
   read from the same `list` renderTransactions() already computed
   via filteredTransactions() — no new data/filtering logic.
--------------------------------------------------------------- */
function txnGroupLabel(dateStr){
  const today = todayStr();
  const y = new Date(); y.setDate(y.getDate()-1);
  const yStr = y.toISOString().slice(0,10);
  if(dateStr===today) return 'Today';
  if(dateStr===yStr) return 'Yesterday';
  const d = new Date(dateStr+'T00:00:00');
  const opts = d.getFullYear()!==new Date().getFullYear()
    ? {day:'numeric',month:'short',year:'numeric'}
    : {day:'numeric',month:'short'};
  return isNaN(d.getTime()) ? dateStr : d.toLocaleDateString('en-IN', opts);
}
function txnIcon(t){
  if(t.type==='transfer') return {ic:'🔁', bg:'var(--tm-purple-soft)', col:'var(--tm-purple)'};
  if(t.type==='income') return {ic:'🏦', bg:'var(--tm-teal-soft)', col:'var(--tm-teal)'};
  const cat = ((t.category||'')+' '+(t.subcategory||'')).toLowerCase();
  const map = [
    [/grocer|super ?market/, '🛒'], [/food|restaurant|dining|drink|coffee|cafe/, '☕'],
    [/fuel|petrol|transport|cab|taxi|uber|ola|auto/, '🚗'], [/rent|house|home/, '🏠'],
    [/medic|health|pharma|doctor|hospital/, '💊'], [/shop|cloth|fashion/, '🛍️'],
    [/entertain|movie|game|subscription|ott/, '🎬'], [/bill|electric|utility|recharge|mobile|internet/, '💡'],
    [/travel|flight|hotel|trip/, '✈️'], [/educat|school|course|fee|tuition/, '🎓'],
    [/invest|mutual|stock|sip/, '📈'], [/loan|emi|debt|credit card/, '💳'], [/gift|donat/, '🎁'],
  ];
  for(const [re, ic] of map) if(re.test(cat)) return {ic, bg:'var(--tm-coral-soft)', col:'var(--tm-coral)'};
  return {ic:'💸', bg:'var(--tm-coral-soft)', col:'var(--tm-coral)'};
}
function renderTxnMobileSummary(list){
  const el = document.getElementById('txnMobiSummary');
  if(!el) return;
  const inc = list.filter(t=>t.type==='income').reduce((s,t)=>s+Number(t.amount||0),0);
  const exp = list.filter(t=>t.type==='expense').reduce((s,t)=>s+Number(t.amount||0),0);
  el.innerHTML = `
    <div class="txn-mobi-sumcard in"><div class="tms-lbl">↓ Total Income</div><div class="tms-val">+${fmt(inc)}</div></div>
    <div class="txn-mobi-sumcard ex"><div class="tms-lbl">↑ Total Expense</div><div class="tms-val">-${fmt(exp)}</div></div>
  `;
}
function renderTxnMobileList(list){
  const wrap = document.getElementById('txnMobiList');
  if(!wrap) return;
  if(!list.length){
    wrap.innerHTML = `<div class="txn-mobi-empty">No transactions match these filters yet.</div>`;
    return;
  }
  const order = [], byLabel = new Map();
  list.forEach(t=>{
    const lbl = txnGroupLabel(t.date);
    if(!byLabel.has(lbl)){ byLabel.set(lbl, []); order.push(lbl); }
    byLabel.get(lbl).push(t);
  });
  wrap.innerHTML = order.map(lbl=>{
    const items = byLabel.get(lbl);
    return `<div class="txn-mobi-group">
      <div class="txn-mobi-gtitle">${escapeHtml(lbl)}</div>
      <div class="txn-mobi-gcard">
        ${items.map(t=>{
          const info = txnDisplayLine(t);
          const icon = txnIcon(t);
          const nameLine = t.type==='transfer' ? info.label : (t.item || t.notes || t.category || '—');
          const subLine = t.type==='transfer' ? 'Transfer' : `${t.category||''}${t.subcategory?' / '+t.subcategory:''}${t.time?' • '+t.time:''}`;
          const amtCls = t.type==='income'?'in':(t.type==='transfer'?'tr':'ex');
          const sign = t.type==='income'?'+':(t.type==='transfer'?'':'-');
          const hasItems = Array.isArray(t.items) && t.items.length>0;
          const itemsPanel = hasItems ? `<div class="txn-items-panel txn-items-row hidden" data-parent="${t.id}">
            ${t.items.map(it=>`<div class="ti-row"><span>${escapeHtml(it.name)}${it.qty?` × ${escapeHtml(String(it.qty))}${it.unit?' '+escapeHtml(it.unit):''}`:''}</span><span>${fmt(it.amount)}</span></div>`).join('')}
            <div class="row-actions" style="margin-top:8px;"><button type="button" class="link-btn items-edit" data-id="${t.id}">Edit items</button></div>
          </div>` : '';
          return `<div class="txn-mobi-item" data-id="${t.id}">
            <div class="txn-mobi-row" data-toggle="${t.id}">
              <div class="txn-mobi-ic" style="background:${icon.bg};color:${icon.col};">${icon.ic}</div>
              <div class="txn-mobi-main">
                <div class="txn-mobi-name">${escapeHtml(nameLine)}</div>
                <div class="txn-mobi-sub">${escapeHtml(subLine)}</div>
              </div>
              <div class="txn-mobi-amt ${amtCls}">${sign}${fmt(t.amount)}</div>
            </div>
            <div class="txn-mobi-detail hidden" id="txnMobiDetail-${t.id}">
              <button type="button" class="tmd-btn attach-open" title="Attachments" data-id="${t.id}">📎 <span class="attach-count-num">0</span></button>
              ${hasItems?`<button type="button" class="tmd-btn items-toggle" title="View items" data-id="${t.id}">🧾 ${t.items.length}</button>`:''}
              ${t.type!=='transfer'?`<button type="button" class="tmd-btn dup" data-id="${t.id}">⧉ Duplicate</button><button type="button" class="tmd-btn edit" data-id="${t.id}">✎ Edit</button>`:''}
              <button type="button" class="tmd-btn del" data-id="${t.id}">✕ Delete</button>
              ${itemsPanel}
            </div>
          </div>`;
        }).join('')}
      </div>
    </div>`;
  }).join('');
  wrap.querySelectorAll('[data-toggle]').forEach(row=>{
    row.addEventListener('click', ()=>{
      document.getElementById('txnMobiDetail-'+row.dataset.toggle)?.classList.toggle('hidden');
    });
  });
}
function renderTransactions(){
  const list = filteredTransactions();
  const body = document.getElementById('txnTableBody');
  const cardsWrap = document.getElementById('txnCards');
  const mobiWrap = document.getElementById('txnMobiList');
  renderTxnMobileSummary(list);
  renderTxnMobileList(list);
  document.querySelectorAll('#txnMobiPills .txn-pill').forEach(b=>{
    b.classList.toggle('active', b.dataset.ttype === document.getElementById('tType').value);
  });
  if(!list.length){
    body.innerHTML = `<tr><td colspan="8" class="empty-note">No transactions match these filters yet.</td></tr>`;
    if(cardsWrap) cardsWrap.innerHTML = `<div class="empty-note">No transactions match these filters yet.</div>`;
  } else {
    body.innerHTML = list.map(t=>{
      const info = txnDisplayLine(t);
      const hasItems = Array.isArray(t.items) && t.items.length>0;
      const itemsRow = hasItems ? `<tr class="txn-items-row hidden" data-parent="${t.id}"><td colspan="8">
        <div class="txn-items-panel">
          ${t.items.map(it=>`<div class="ti-row"><span>${escapeHtml(it.name)}${it.qty?` × ${escapeHtml(String(it.qty))}${it.unit?' '+escapeHtml(it.unit):''}`:''}</span><span>${fmt(it.amount)}</span></div>`).join('')}
          <div class="row-actions" style="margin-top:8px;"><button type="button" class="link-btn items-edit" data-id="${t.id}">Edit items</button></div>
        </div>
      </td></tr>` : '';
      return `<tr data-id="${t.id}">
        <td>${t.date}${t.time?' '+t.time:''}</td>
        <td><span class="tag" style="background:${t.type==='income'?'var(--teal-soft)':t.type==='transfer'?'var(--gold-soft)':'var(--rust-soft)'};color:${t.type==='income'?'var(--teal)':t.type==='transfer'?'var(--gold)':'var(--rust)'};">${t.type}</span></td>
        <td>${t.type==='transfer'? info.label : (t.category+(t.subcategory?' / '+t.subcategory:''))}</td>
        <td>${t.item||t.notes||'—'}</td>
        <td>${info.sub||'—'}</td>
        <td>${t.mode||'—'}</td>
        <td style="text-align:right;" class="${info.amtClass}">${t.type==='transfer'?'':info.prefix}${fmt(t.amount)}</td>
        <td><div class="tbl-actions">
          <button class="attach-badge attach-open" title="Attachments" data-attach-count="0">📎 <span class="attach-count-num">0</span></button>
          ${hasItems?`<button class="items-badge items-toggle" title="View items" data-id="${t.id}">🧾 ${t.items.length}</button>`:''}
          ${t.type!=='transfer'?'<button class="dup" title="Duplicate">⧉</button><button class="edit" title="Edit">✎</button>':''}
          <button class="del" title="Delete">✕</button>
        </div></td>
      </tr>${itemsRow}`;
    }).join('');
    if(cardsWrap){
      cardsWrap.innerHTML = list.map(t=>{
        const info = txnDisplayLine(t);
        const tagsHtml = (t.tags||[]).map(tg=>`<span class="chip tag">${tg}</span>`).join(' ');
        const hasItems = Array.isArray(t.items) && t.items.length>0;
        const itemsPanel = hasItems ? `<div class="txn-items-panel txn-items-row hidden" data-parent="${t.id}">
          ${t.items.map(it=>`<div class="ti-row"><span>${escapeHtml(it.name)}${it.qty?` × ${escapeHtml(String(it.qty))}${it.unit?' '+escapeHtml(it.unit):''}`:''}</span><span>${fmt(it.amount)}</span></div>`).join('')}
          <div class="row-actions" style="margin-top:8px;"><button type="button" class="link-btn items-edit" data-id="${t.id}">Edit items</button></div>
        </div>` : '';
        return `<div class="txn-card" data-id="${t.id}">
          <div class="txn-card-top">
            <div><div class="txn-card-cat">${t.type==='transfer'?info.label:(t.category+(t.subcategory?' / '+t.subcategory:''))}</div><div class="txn-card-sub">${t.item||t.notes||''}</div></div>
            <div class="txn-card-amt ${info.amtClass}">${t.type==='transfer'?'':info.prefix}${fmt(t.amount)}</div>
          </div>
          <div class="txn-card-meta">
            <span>${t.date}${t.time?' '+t.time:''}</span>
            ${t.type!=='transfer'?`<span class="chip acct">${info.sub||'—'}</span>`:''}
            ${t.mode?`<span>${t.mode}</span>`:''}
            ${tagsHtml}
          </div>
          <div class="txn-card-actions">
            <button class="attach-badge attach-open" title="Attachments" data-attach-count="0">📎 <span class="attach-count-num">0</span></button>
            ${hasItems?`<button class="items-badge items-toggle" title="View items" data-id="${t.id}">🧾 ${t.items.length}</button>`:''}
            ${t.type!=='transfer'?'<button class="dup">Duplicate</button><button class="edit">Edit</button>':''}
            <button class="del">Delete</button>
          </div>
          ${itemsPanel}
        </div>`;
      }).join('');
    }
  }
  document.getElementById('txnCount').textContent = `${list.length} transaction(s) shown of ${state.transactions.length} total.`;
  [body, cardsWrap, mobiWrap].forEach(container=>{
    if(!container) return;
    container.querySelectorAll('.items-toggle').forEach(b=>b.addEventListener('click', e=>{
      const id = e.currentTarget.dataset.id;
      const panel = container.querySelector(`.txn-items-row[data-parent="${id}"]`);
      if(panel) panel.classList.toggle('hidden');
    }));
    container.querySelectorAll('.items-edit').forEach(b=>b.addEventListener('click', e=>{
      const id = e.currentTarget.dataset.id;
      if(window.App && App.Transaction && App.Transaction.ItemsEditor) App.Transaction.ItemsEditor.open(id);
    }));
    container.querySelectorAll('.del').forEach(b=>b.addEventListener('click', async e=>{
      const id = e.target.closest('[data-id]').dataset.id;
      const idx = state.transactions.findIndex(t=>t.id===id);
      if(idx===-1) return;
      lastDeleted = { txn: state.transactions[idx], index: idx };
      state.transactions.splice(idx,1);
      await saveTransactions(); renderTransactions(); refreshAllCharts();
      const note = document.getElementById('undoDeleteNote');
      note.innerHTML = 'Transaction deleted. <button class="link-btn" id="undoBtn">Undo</button>';
      document.getElementById('undoBtn').onclick = async ()=>{
        if(lastDeleted){ state.transactions.splice(lastDeleted.index,0,lastDeleted.txn); lastDeleted=null; await saveTransactions(); renderTransactions(); refreshAllCharts(); note.textContent=''; }
      };
      clearTimeout(renderTransactions._undoT);
      renderTransactions._undoT = setTimeout(()=>{
        note.textContent='';
        // Deletion is now final (the 8s undo window passed) — clean up any
        // attachments that belonged only to this transaction so storage
        // doesn't quietly fill up with orphaned files. Never runs if the
        // user hit Undo, since lastDeleted is cleared there first.
        if(lastDeleted && window.App && App.Attachments){
          App.Attachments.Manager.deleteAllForTransaction(lastDeleted.txn.id).catch(err=>{ App.Logger && App.Logger.error('attachment cleanup failed', err); });
        }
        lastDeleted=null;
      }, 8000);
    }));
    container.querySelectorAll('.dup').forEach(b=>b.addEventListener('click', async e=>{
      const id = e.target.closest('[data-id]').dataset.id;
      const orig = state.transactions.find(t=>t.id===id);
      if(orig){
        const newId = uid();
        state.transactions.push({...orig, id:newId, date: todayStr()});
        await saveTransactions(); renderTransactions(); refreshAllCharts();
        // Attachments belong to the transaction they document — carry them
        // over to the duplicate too, so a duplicated bill still has its
        // receipt attached. Best-effort: never blocks the duplicate itself.
        try{ if(window.App && App.Attachments) await App.Attachments.Manager.duplicateForTransaction(id, newId); }catch(err){ App.Logger && App.Logger.error('attachment duplicate failed', err); }
        renderTransactions();
      }
    }));
    container.querySelectorAll('.attach-open').forEach(b=>b.addEventListener('click', e=>{
      const id = e.target.closest('[data-id]').dataset.id;
      if(window.App && App.Attachments) App.Attachments.UI.openManager(id);
    }));
    container.querySelectorAll('.edit').forEach(b=>b.addEventListener('click', async e=>{
      const id = e.target.closest('[data-id]').dataset.id;
      const t = state.transactions.find(x=>x.id===id);
      if(!t) return;
      const newAmt = prompt('Edit amount (₹):', t.amount);
      if(newAmt===null) return;
      const val = parseFloat(newAmt);
      if(val>0){ t.amount = val; await saveTransactions(); renderTransactions(); refreshAllCharts(); }
    }));
  });
  // Fill in real attachment counts for the rows just rendered. Done as a
  // best-effort async pass after the synchronous render above so a slow
  // or unavailable IndexedDB never blocks the transaction list itself.
  if(window.App && App.Attachments){
    App.Attachments.Manager.countsForTransactions(list.map(t=>t.id)).then(counts=>{
      [body, cardsWrap, mobiWrap].forEach(container=>{
        if(!container) return;
        container.querySelectorAll('[data-id]').forEach(row=>{
          const id = row.dataset.id;
          const n = counts[id]||0;
          const badge = row.querySelector('.attach-open');
          if(!badge) return;
          badge.querySelector('.attach-count-num').textContent = n;
          badge.dataset.attachCount = n;
          badge.style.opacity = n>0 ? '1' : '.6';
        });
      });
    }).catch(err=>{ App.Logger && App.Logger.error('attachment count refresh failed', err); });
  }
}

/* ---------------------------------------------------------------
   BUDGETS
--------------------------------------------------------------- */
function populateBudgetCategorySelect(){
  document.getElementById('b_category').innerHTML = expenseCats().map(c=>`<option>${c}</option>`).join('');
}
populateBudgetCategorySelect();

document.getElementById('saveBudgetBtn').addEventListener('click', async ()=>{
  const cat = document.getElementById('b_category').value;
  const amt = parseFloat(document.getElementById('b_amount').value);
  if(!amt || amt<0){ alert('Enter a valid budget amount.'); return; }
  state.budgets[cat] = amt;
  await saveBudgets();
  document.getElementById('b_amount').value='';
  renderBudgets();
});

// Budget Planner redesign — small category → emoji map, purely cosmetic
// (rendered inside the existing .budget-cat span, computations untouched).
const KBUD_CAT_ICONS = {Food:'🍔',Travel:'✈️',Shopping:'🛍️',Bills:'🧾',Entertainment:'🎬',Personal:'🧴',Other:'🔘',Milk:'🥛','Curd/Dahi':'🍶',Paneer:'🧀',Soybean:'🌱','Roasted Chana':'🥜',Peanut:'🥜',Coffee:'☕',Water:'💧'};
function kbudCatIcon(c){ return KBUD_CAT_ICONS[c] || '💳'; }

function renderBudgets(){
  const from = startOfMonth(0), to = endOfMonth(0);
  const cats = Object.keys(state.budgets);
  const list = document.getElementById('budgetList');
  if(!cats.length){
    list.innerHTML = '<div class="empty-note">No budgets set yet. Add one below.</div>';
  } else {
    list.innerHTML = cats.map(c=>{
      const actual = sum(expenseTxns().filter(t=>t.category===c && dateInRange(t.date,from,to)));
      const budget = Number(state.budgets[c]);
      const pct = budget>0 ? Math.min(100, actual/budget*100) : 0;
      const over = actual>budget;
      const warn = !over && pct>=80;
      return `<div class="budget-row">
        <div class="budget-top"><span class="budget-cat"><span class="budget-cat-icon">${kbudCatIcon(c)}</span>${c}</span><span class="budget-figs">${fmt(actual)} / ${fmt(budget)}${over?' ⚠ over':''}</span></div>
        <div class="bar-track"><div class="bar-fill ${over?'over':warn?'warn':''}" style="width:${pct}%;"></div></div>
        <div class="card-note" style="margin-top:3px;">${budget>0 ? (budget-actual>=0? fmt(budget-actual)+' remaining' : fmt(actual-budget)+' over') : ''} · ${budget>0? (actual/budget*100).toFixed(0):0}% utilized</div>
      </div>`;
    }).join('');
  }
  // Sprint 21 — additive AI/forecast/alerts/advanced-budget panel; never
  // touches budgetList above. Own try/catch so a failure here can never
  // break the original monthly-category budget view. Redesign fix: this
  // used to be skipped entirely whenever no simple category budgets were
  // set yet (early `return` above) — moved so the AI panel, advanced-
  // budget list and analytics still render for a first-time user with
  // zero budgets, since that's exactly when the recommendations are
  // most useful. No computed figures changed, only when these run.
  try{ App.Budget.UI.render(); }catch(err){ App.Logger.error('App.Budget.UI.render failed', err); }
  // Budget Planner redesign — overview ring/stats/health + AI score card.
  // Purely additive: reads the same state.budgets/expenseTxns()/
  // App.Budget.Analysis/App.Budget.AI already used above, writes only to
  // the new kbud* elements, and never touches budgetList/advBudgetList.
  try{ renderBudgetOverview(); }catch(err){ App.Logger.error('renderBudgetOverview failed', err); }
}

// Budget Planner redesign — lightweight count-up for the hero/AI numbers.
// Purely cosmetic: always lands on exactly the same final text the plain
// `textContent = ...` assignment used to produce, just eased over ~700ms
// instead of snapping instantly.
function kbudAnimateNum(el, endValue, formatter){
  if(!el) return;
  try{
    const startValue = Number(el.dataset.kbudRaw)||0;
    const duration = 700;
    const t0 = performance.now();
    function tick(now){
      const p = Math.min(1, (now-t0)/duration);
      const eased = 1-Math.pow(1-p,3);
      el.textContent = formatter(startValue + (endValue-startValue)*eased);
      if(p<1){ requestAnimationFrame(tick); }
      else { el.textContent = formatter(endValue); el.dataset.kbudRaw = endValue; }
    }
    requestAnimationFrame(tick);
  }catch(e){ el.textContent = formatter(endValue); el.dataset.kbudRaw = endValue; }
}

function renderBudgetOverview(){
  const from = startOfMonth(0), to = endOfMonth(0);
  const cats = Object.keys(state.budgets||{});
  const exp = expenseTxns();
  const totalBudget = cats.reduce((a,c)=>a+(Number(state.budgets[c])||0),0);
  const totalSpent = cats.reduce((a,c)=>a+sum(exp.filter(t=>t.category===c && dateInRange(t.date,from,to))),0);
  const remaining = totalBudget - totalSpent;
  const usedPct = totalBudget>0 ? Math.min(100,(totalSpent/totalBudget)*100) : 0;
  const savingsPct = totalBudget>0 ? Math.max(0,(remaining/totalBudget)*100) : 0;

  kbudAnimateNum(document.getElementById('kbudTotalBudget'), totalBudget, fmt);
  kbudAnimateNum(document.getElementById('kbudTotalSpent'), totalSpent, fmt);
  kbudAnimateNum(document.getElementById('kbudRemaining'), Math.max(0,remaining), fmt);
  kbudAnimateNum(document.getElementById('kbudSavingsPct'), savingsPct, v=>v.toFixed(0)+'%');
  kbudAnimateNum(document.getElementById('kbudUsedPct'), usedPct, v=>v.toFixed(0)+'%');
  document.getElementById('kbudOverallBar').style.width = usedPct+'%';

  const ring = document.getElementById('kbudRingFill');
  const circumference = 2*Math.PI*70;
  ring.style.strokeDasharray = `${circumference}`;
  ring.style.strokeDashoffset = `${circumference - (usedPct/100)*circumference}`;
  ring.classList.toggle('over', totalBudget>0 && totalSpent>totalBudget);

  const summary = App.Budget.Analysis.summary();
  const healthEl = document.getElementById('kbudHealth');
  const healthText = document.getElementById('kbudHealthText');
  const hasAnyBudget = cats.length>0 || (state.budgetTypes||[]).length>0;
  if(!hasAnyBudget){
    healthEl.className = 'kbud-health';
    healthText.textContent = 'Set a budget to see your health status.';
  } else if(summary.exceeded>0){
    healthEl.className = 'kbud-health bad';
    healthText.textContent = `Over budget in ${summary.exceeded} area${summary.exceeded===1?'':'s'} this month.`;
  } else if(summary.nearLimit>0){
    healthEl.className = 'kbud-health warn';
    healthText.textContent = `${summary.nearLimit} budget${summary.nearLimit===1?'':'s'} nearing the limit.`;
  } else {
    healthEl.className = 'kbud-health good';
    healthText.textContent = 'On track — all budgets within limits.';
  }

  const forecasts = App.Budget.AI.monthEndForecasts();
  const forecastBudgetTotal = forecasts.reduce((a,f)=>a+f.budget,0);
  const forecastProjectedTotal = forecasts.reduce((a,f)=>a+f.projected,0);
  const expectedBalance = forecastBudgetTotal - forecastProjectedTotal;
  kbudAnimateNum(document.getElementById('kbudExpectedBalance'), expectedBalance, fmt);
  kbudAnimateNum(document.getElementById('kbudPredictedSavings'), Math.max(0,expectedBalance), fmt);

  const scoreEl = document.getElementById('kbudScore');
  const scoreHeroEl = document.getElementById('kbudScoreHero');
  if(!hasAnyBudget){
    scoreEl.textContent = '--';
    if(scoreHeroEl) scoreHeroEl.textContent = '--';
  } else {
    let score = 100 - summary.exceeded*15 - summary.nearLimit*5;
    score = Math.max(0, Math.min(100, Math.round(score)));
    scoreEl.textContent = score;
    if(scoreHeroEl) scoreHeroEl.textContent = score+' / 100';
  }

  // Budget Planner redesign — premium analytics charts (donut/bar/line).
  // Own try/catch, reuses the same expenseTxns()/state.budgets/monthsRange()
  // data already used above; never touches budgetList/advBudgetList/kbud*.
  try{ renderBudgetAnalyticsCharts(); }catch(err){ App.Logger.error('renderBudgetAnalyticsCharts failed', err); }
}

function renderBudgetAnalyticsCharts(){
  if(typeof Chart==='undefined') return;
  const {grid,text} = chartTheme();
  const exp = expenseTxns();
  const from = startOfMonth(0), to = endOfMonth(0);
  const monthExp = exp.filter(t=>dateInRange(t.date,from,to));

  // Spending by category (this month) — donut
  destroyChart('kbudDonut');
  const byCat = {};
  monthExp.forEach(t=>{ byCat[t.category]=(byCat[t.category]||0)+Number(t.amount); });
  const donutLabels = Object.keys(byCat);
  const donutCanvas = document.getElementById('kbud_c_donut');
  if(donutCanvas){
    if(!donutLabels.length){ noData('kbud_c_donut'); }
    else{
      charts.kbudDonut = new Chart(donutCanvas, {
        type:'doughnut',
        data:{ labels:donutLabels, datasets:[{data:Object.values(byCat), backgroundColor:palette(donutLabels.length), borderWidth:0}] },
        options:{responsive:true,maintainAspectRatio:false,cutout:'62%',
          plugins:{legend:{position:'bottom',labels:{color:text,boxWidth:9,font:{size:10}}}},
          animation:{animateRotate:true,animateScale:true,duration:900}}
      });
    }
  }

  // Weekly spending — last 6 weeks
  destroyChart('kbudWeekly');
  const weeklyCanvas = document.getElementById('kbud_c_weekly');
  if(weeklyCanvas){
    if(!exp.length){ noData('kbud_c_weekly'); }
    else{
      const weeks = 6;
      const now = new Date();
      const weekLabels = [], weekTotals = [];
      for(let i=weeks-1;i>=0;i--){
        const end = new Date(now); end.setDate(now.getDate()-i*7);
        const start = new Date(end); start.setDate(end.getDate()-6);
        const fromStr = start.toISOString().slice(0,10), toStr = end.toISOString().slice(0,10);
        weekTotals.push(sum(exp.filter(t=>dateInRange(t.date,fromStr,toStr))));
        weekLabels.push(i===0 ? 'This wk' : `-${i}w`);
      }
      charts.kbudWeekly = new Chart(weeklyCanvas, {
        type:'bar',
        data:{ labels:weekLabels, datasets:[{label:'Spent', data:weekTotals, backgroundColor:'#7C3AED', borderRadius:6, maxBarThickness:26}] },
        options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},
          scales:{x:{ticks:{color:text},grid:{display:false}},y:{ticks:{color:text},grid:{color:grid}}},
          animation:{duration:800,easing:'easeOutQuart'}}
      });
    }
  }

  // Monthly spending trend — last up to 6 months
  destroyChart('kbudTrend');
  const trendCanvas = document.getElementById('kbud_c_trend');
  if(trendCanvas){
    const months = monthsRange().slice(-6);
    if(!months.length){ noData('kbud_c_trend'); }
    else{
      const totals = months.map(m=> sum(exp.filter(t=>monthKey(t.date)===m)) );
      charts.kbudTrend = new Chart(trendCanvas, {
        type:'line',
        data:{ labels:months, datasets:[{label:'Expense', data:totals, borderColor:'#14F1D9', backgroundColor:'rgba(20,241,217,.15)', fill:true, tension:.35, pointRadius:3, pointBackgroundColor:'#14F1D9'}] },
        options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},
          scales:{x:{ticks:{color:text},grid:{display:false}},y:{ticks:{color:text},grid:{color:grid}}},
          animation:{duration:900,easing:'easeOutQuart'}}
      });
    }
  }
}

/* ---------------------------------------------------------------
   GOAL / BIG PURCHASE PLANNER (advanced: priority waterfall, buffer,
   contributions, progress, target-date pacing, what-if, timeline chart)
--------------------------------------------------------------- */
const ESSENTIAL_CATS = [...FOOD_CATS, "Travel", "Bills"];
App.Config.ESSENTIAL_CATS = ESSENTIAL_CATS;
function essentialExpenseTxns(){ return expenseTxns().filter(t=>ESSENTIAL_CATS.includes(t.category)); }
function estimateEssentialMonthly(){
  const txns = essentialExpenseTxns();
  if(!txns.length) return {value:0, sufficient:false};
  const days = uniqueDays(txns);
  const avgDaily = sum(txns)/Math.max(1,days.size);
  return {value: avgDaily*30, sufficient: days.size>=7};
}
function getEmergencyFundGoal(){ return state.goals.find(g=>g.isEmergencyFund); }

function normalizeGoals(){
  // backward-compatible: upgrade any goal saved by an earlier version of this app
  let sawEF = false;
  state.goals = (state.goals||[]).map((g,i)=>{
    // Older versions let users create a goal with category "Emergency Fund" manually.
    // Treat the first one as the managed Emergency Fund goal instead of duplicating logic.
    const isEmergencyFund = !!g.isEmergencyFund || (!sawEF && g.category==='Emergency Fund');
    if(isEmergencyFund) sawEF = true;
    return {
      id: g.id || uid(),
      name: g.name || (isEmergencyFund ? 'Emergency Fund' : 'Goal'),
      cost: Number(g.cost)||0,
      category: isEmergencyFund ? 'Emergency Fund' : (g.category || 'Other'),
      priority: (g.priority!=null) ? g.priority : (i+1),
      targetDate: g.targetDate || null,
      monthlyOverride: (g.monthlyOverride!=null) ? g.monthlyOverride : (g.monthly || null),
      weeklyOverride: (g.weeklyOverride!=null) ? g.weeklyOverride : null,
      dailyOverride: (g.dailyOverride!=null) ? g.dailyOverride : null,
      notes: g.notes || '',
      paused: !!g.paused,
      contributions: Array.isArray(g.contributions) ? g.contributions : [],
      achieved: !!g.achieved,
      isEmergencyFund,
      createdDate: g.createdDate || todayStr()
    };
  });
}

function ensureEmergencyFundGoal(){
  let g = getEmergencyFundGoal();
  if(!g){
    g = {id:uid(), name:'Emergency Fund', cost:0, category:'Emergency Fund', priority:0,
      targetDate:null, monthlyOverride:null, weeklyOverride:null, dailyOverride:null,
      notes:'', paused:false, contributions:[], achieved:false, isEmergencyFund:true, createdDate:todayStr()};
    state.goals.unshift(g);
  }
  return g;
}

document.getElementById('saveBufferBtn').addEventListener('click', async ()=>{
  state.settings.bufferMonths = parseInt(document.getElementById('bufferMonthsSelect').value,10);
  await saveSettings();
  document.getElementById('bufferNote').textContent = 'Saved ✓';
  setTimeout(()=>document.getElementById('bufferNote').textContent='', 1500);
  renderGoals();
});

function resetGoalForm(){
  ['g_name','g_cost','g_monthly','g_weekly','g_daily','g_targetdate','g_notes'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('g_category').value = 'Big Purchase';
  document.getElementById('g_priority').value = '2';
  document.getElementById('g_editid').value = '';
  document.getElementById('goalFormTitle').textContent = 'Add a Goal';
  document.getElementById('addGoalBtn').textContent = '+ Add Goal';
  document.getElementById('cancelEditGoalBtn').style.display = 'none';
}
function startEditGoal(id){
  const g = state.goals.find(x=>x.id===id);
  if(!g) return;
  document.getElementById('g_editid').value = g.id;
  document.getElementById('g_name').value = g.name;
  document.getElementById('g_cost').value = g.cost;
  document.getElementById('g_category').value = g.category;
  document.getElementById('g_priority').value = '2'; // priority select only affects placement when adding new goals; use the ▲▼ controls below to reorder existing ones
  document.getElementById('g_targetdate').value = g.targetDate || '';
  document.getElementById('g_monthly').value = g.monthlyOverride || '';
  document.getElementById('g_weekly').value = g.weeklyOverride || '';
  document.getElementById('g_daily').value = g.dailyOverride || '';
  document.getElementById('g_notes').value = g.notes || '';
  document.getElementById('goalFormTitle').textContent = `Editing: ${g.name}`;
  document.getElementById('addGoalBtn').textContent = 'Save Changes';
  document.getElementById('cancelEditGoalBtn').style.display = '';
  document.getElementById('goalFormTitle').scrollIntoView({behavior:'smooth', block:'start'});
}
document.getElementById('cancelEditGoalBtn').addEventListener('click', resetGoalForm);
document.getElementById('addGoalBtn').addEventListener('click', async ()=>{
  const name = document.getElementById('g_name').value.trim();
  const cost = parseFloat(document.getElementById('g_cost').value);
  const category = document.getElementById('g_category').value;
  const priorityChoice = document.getElementById('g_priority').value;
  const targetDate = document.getElementById('g_targetdate').value || null;
  const monthlyOverride = parseFloat(document.getElementById('g_monthly').value) || null;
  const weeklyOverride = parseFloat(document.getElementById('g_weekly').value) || null;
  const dailyOverride = parseFloat(document.getElementById('g_daily').value) || null;
  const notes = document.getElementById('g_notes').value.trim();
  if(!name || !cost || cost<=0){ alert('Enter item name and a valid cost.'); return; }
  const editId = document.getElementById('g_editid').value;
  if(editId){
    const g = state.goals.find(x=>x.id===editId);
    if(!g){ resetGoalForm(); return; }
    g.name = name; g.cost = cost; g.category = category; g.targetDate = targetDate;
    g.monthlyOverride = monthlyOverride; g.weeklyOverride = weeklyOverride; g.dailyOverride = dailyOverride;
    g.notes = notes;
    // priority left as-is on edit — use the ▲▼ controls to reorder, so editing details never reshuffles funding order
    await saveGoals();
    resetGoalForm();
    renderGoals();
    return;
  }
  const priorities = state.goals.map(g=>g.priority||0);
  const minPriority = priorities.length ? Math.min(...priorities) : 1;
  const maxPriority = priorities.length ? Math.max(...priorities) : 0;
  const priority = priorityChoice==='1' ? minPriority-1 : maxPriority+1;
  state.goals.push({
    id: uid(), name, cost, category, priority, targetDate,
    monthlyOverride, weeklyOverride, dailyOverride, notes, paused:false,
    contributions: [], achieved:false, isEmergencyFund:false, createdDate: todayStr()
  });
  await saveGoals();
  resetGoalForm();
  renderGoals();
});

function computeSavingsProfile(){
  const inc = incomeTxns(), exp = expenseTxns();
  const totalIncome = sum(inc), totalExpense = sum(exp);
  const netSavings = totalIncome - totalExpense;
  const expDays = uniqueDays(exp);
  const avgDailyExpense = expDays.size ? totalExpense/expDays.size : 0;
  const avgMonthlyExpense = avgDailyExpense*30;
  const months = monthsRange();
  let avgMonthlySavings = 0;
  if(months.length>=2){
    const perMonth = months.map(m=>{
      const mi = sum(inc.filter(t=>monthKey(t.date)===m));
      const me = sum(exp.filter(t=>monthKey(t.date)===m));
      return mi-me;
    });
    avgMonthlySavings = perMonth.reduce((a,b)=>a+b,0)/perMonth.length;
  } else if(expDays.size || uniqueDays(inc).size){
    const totalDaysTracked = daysBetween(
      [...new Set(state.transactions.map(t=>t.date))].sort()[0] || todayStr(),
      todayStr()
    );
    avgMonthlySavings = (netSavings/totalDaysTracked)*30;
  }
  const bufferMonths = (state.settings && state.settings.bufferMonths) || 3;
  const bufferNeeded = avgMonthlyExpense*bufferMonths;
  const availableSurplus = netSavings - bufferNeeded;
  return {totalIncome, totalExpense, netSavings, avgMonthlyExpense, avgMonthlySavings, bufferNeeded, availableSurplus, bufferMonths};
}

// Waterfall: lump-sum surplus + shared monthly capacity get applied to goals
// in priority order. Goals with a fixed monthlyOverride get their own
// dedicated pace and don't wait behind others.
function fixedMonthlyEquivalent(g){
  // A goal can pin its pace by month, week, or day — normalize to a monthly figure.
  if(g.monthlyOverride) return g.monthlyOverride;
  if(g.weeklyOverride) return g.weeklyOverride*4.345;
  if(g.dailyOverride) return g.dailyOverride*30;
  return null;
}

function computeGoalPlan(extraMonthlyById){
  extraMonthlyById = extraMonthlyById || {};
  const profile = computeSavingsProfile();
  // Emergency Fund is always funded first, regardless of its stored priority.
  const active = state.goals.filter(g=>!g.achieved && !g.paused)
    .sort((a,b)=> (a.isEmergencyFund?0:1)-(b.isEmergencyFund?0:1) || (a.priority-b.priority));
  let lumpSurplus = Math.max(0, profile.availableSurplus);
  let sharedCapacity = Math.max(0, profile.avgMonthlySavings);
  let cursorMonths = 0;
  const results = {};
  active.forEach(g=>{
    const contributed = sum(g.contributions);
    let remaining = Math.max(0, g.cost - contributed);
    const usedLump = Math.min(lumpSurplus, remaining);
    lumpSurplus -= usedLump;
    remaining -= usedLump;
    const fixed = fixedMonthlyEquivalent(g);
    const extra = Number(extraMonthlyById[g.id]) || 0;
    const monthlyRate = (fixed!=null ? fixed : sharedCapacity) + extra;
    let monthsForThisGoal = 0, completionMonths;
    if(remaining<=0){ monthsForThisGoal=0; completionMonths = fixed!=null ? 0 : cursorMonths; }
    else if(monthlyRate<=0){ monthsForThisGoal = Infinity; completionMonths = Infinity; }
    else {
      monthsForThisGoal = remaining/monthlyRate;
      completionMonths = fixed!=null ? monthsForThisGoal : cursorMonths + monthsForThisGoal;
      if(fixed==null) cursorMonths = completionMonths;
    }
    let paceStatus = null;
    if(g.targetDate){
      const monthsUntilTarget = Math.max(0.01, daysBetween(todayStr(), g.targetDate)/30);
      const requiredMonthly = remaining>0 ? remaining/monthsUntilTarget : 0;
      paceStatus = {
        requiredMonthly,
        requiredWeekly: requiredMonthly/4.345,
        requiredDaily: requiredMonthly/30,
        monthsUntilTarget,
        onTrack: monthlyRate >= requiredMonthly - 1
      };
    }
    results[g.id] = {
      contributed, remainingCost: Math.max(0,g.cost-contributed), usedLump, monthlyRate,
      weeklyRate: monthlyRate/4.345, dailyRate: monthlyRate/30,
      monthsForThisGoal, completionMonths, progressPct: Math.min(100, g.cost>0 ? contributed/g.cost*100 : 0),
      paceStatus
    };
  });
  // Paused goals still show progress, just no funding-plan projection.
  state.goals.filter(g=>!g.achieved && g.paused).forEach(g=>{
    const contributed = sum(g.contributions);
    results[g.id] = {
      contributed, remainingCost: Math.max(0,g.cost-contributed), usedLump:0, monthlyRate:0,
      weeklyRate:0, dailyRate:0, monthsForThisGoal:null, completionMonths:null,
      progressPct: Math.min(100, g.cost>0 ? contributed/g.cost*100 : 0), paceStatus:null, paused:true
    };
  });
  return {profile, results};
}

function computeGoalStatus(g, plan){
  const r = plan.results[g.id];
  if(g.achieved) return 'Completed';
  if(g.paused) return 'Paused';
  if(!r) return 'Not Started';
  if(r.remainingCost<=0) return 'Completed';
  if(r.contributed<=0) return 'Not Started';
  if(g.targetDate && r.paceStatus) return r.paceStatus.onTrack ? 'On Track' : 'Behind';
  return 'In Progress';
}
function statusColor(status){
  return {
    'Completed':'var(--teal)', 'On Track':'var(--teal)', 'In Progress':'var(--gold)',
    'Behind':'var(--rust)', 'Paused':'var(--ink-soft)', 'Not Started':'var(--ink-soft)'
  }[status] || 'var(--ink-soft)';
}

function goalVerdictText(g, plan){
  const r = plan.results[g.id];
  if(!r) return {text:'Achieved 🎉', dot:'good', detail:''};
  if(g.paused) return {text:'⏸ Paused', dot:'info', detail:'This goal is paused and is not receiving funding right now. Resume it when you\'re ready.'};
  const hasEnoughData = state.transactions.length >= 5;
  if(!hasEnoughData) return {text:'Not enough data available yet.', dot:'info', detail:'Log at least a week or two of transactions for an accurate projection.'};
  if(r.remainingCost<=0) return {text:'✅ Fully funded — safe to buy now', dot:'good', detail:`${fmt(r.contributed)} allocated toward ${fmt(g.cost)}.`};
  if(r.monthlyRate<=0) return {text:'⚠ Not recommended right now', dot:'bad', detail:'No monthly savings capacity available for this goal at the moment (higher-priority goals or expenses are using it all).'};
  const months = Math.ceil(r.completionMonths);
  const target = new Date(); target.setMonth(target.getMonth()+months);
  let detail = `Estimated completion: ${target.toISOString().slice(0,10)}. Funding pace: ${fmt(r.monthlyRate)}/month (~${fmt(r.weeklyRate)}/week, ~${fmt(r.dailyRate)}/day)${r.usedLump>0 ? `, plus ${fmt(r.usedLump)} from current surplus` : ''}.`;
  if(g.targetDate && r.paceStatus){
    detail += r.paceStatus.onTrack
      ? ` On track for your target date of ${g.targetDate}.`
      : ` To hit your target date of ${g.targetDate}, you'd need ~${fmt(r.paceStatus.requiredMonthly)}/month (~${fmt(r.paceStatus.requiredWeekly)}/week, ~${fmt(r.paceStatus.requiredDaily)}/day) — currently short.`;
  }
  return {text:`⏳ ~${months} month(s) to go`, dot: (g.targetDate && r.paceStatus && !r.paceStatus.onTrack) ? 'warn':'warn', detail};
}

function renderEmergencyFund(plan){
  const efGoal = getEmergencyFundGoal();
  const est = estimateEssentialMonthly();
  const bufferMonths = (state.settings && state.settings.bufferMonths) || 3;
  const panel = document.getElementById('efPanel');
  if(!est.value){
    panel.innerHTML = `<div class="empty-note">Add more expense data to improve this estimate. Once you've logged some Food, Travel or Bills expenses, your Emergency Fund target will be calculated automatically.</div>`;
    return;
  }
  const target = est.value * bufferMonths;
  // Keep the managed Emergency Fund goal's target in sync with the latest estimate.
  if(efGoal){ efGoal.cost = Math.round(target); }
  const contributed = efGoal ? sum(efGoal.contributions) : 0;
  const pct = target>0 ? Math.min(100, contributed/target*100) : 0;
  const monthsCovered = est.value>0 ? contributed/est.value : 0;
  const remaining = Math.max(0, target - contributed);
  let status, statusDot;
  if(pct>=100){ status='🟢 Fully Funded'; statusDot='good'; }
  else if(contributed>0){ status='🟡 Partially Funded'; statusDot='warn'; }
  else { status='🔴 Behind Target'; statusDot='bad'; }

  panel.innerHTML = `
    <div class="kpi-grid">
      <div class="kpi expense"><div class="kpi-label">Essential Monthly Expense${est.sufficient?'':' (rough)'}</div><div class="kpi-value">${fmt(est.value)}</div><div class="kpi-sub">Food + Travel + Bills</div></div>
      <div class="kpi savings"><div class="kpi-label">Target (${bufferMonths} month(s))</div><div class="kpi-value">${fmt(target)}</div></div>
      <div class="kpi income"><div class="kpi-label">Current Emergency Fund</div><div class="kpi-value">${fmt(contributed)}</div></div>
      <div class="kpi ${statusDot==='bad'?'expense':'savings'}"><div class="kpi-label">Amount Remaining</div><div class="kpi-value">${fmt(remaining)}</div></div>
    </div>
    <div class="bar-track" style="margin-top:10px;"><div class="bar-fill" style="width:${pct}%;"></div></div>
    <div class="card-note" style="margin-top:3px;">${pct.toFixed(0)}% funded — covers ~${monthsCovered.toFixed(1)} month(s) of essential expenses</div>
    <div class="insight" style="padding:8px 0;"><span class="dot ${statusDot}"></span><p><b>${status}</b><br>This fund is automatically prioritized first in your goal funding plan (see below). No money is moved automatically — log contributions on the "Emergency Fund" card in Your Goals below.</p></div>
    ${!est.sufficient ? `<div class="card-note">Add more expense data to improve this estimate — this is based on less than a week of essential-spending history.</div>` : ''}
  `;
  if(!efGoal){
    // create it lazily so it appears in the goals list once we know a target
    ensureEmergencyFundGoal();
  }
}

function renderGoals(){
  normalizeGoals();
  ensureEmergencyFundGoal();
  const bufferSel = document.getElementById('bufferMonthsSelect');
  bufferSel.value = String((state.settings && state.settings.bufferMonths) || 3);

  const plan = computeGoalPlan();
  renderEmergencyFund(plan);

  const active = state.goals.filter(g=>!g.achieved);
  const achieved = state.goals.filter(g=>g.achieved);
  const totalTarget = active.reduce((s,g)=>s+g.cost,0);
  const totalSaved = active.reduce((s,g)=>s+sum(g.contributions),0);

  document.getElementById('goalsOverviewKpis').innerHTML = `
    <div class="kpi savings"><div class="kpi-label">Active Goals</div><div class="kpi-value">${active.length}</div><div class="kpi-sub">${achieved.length} achieved</div></div>
    <div class="kpi savings"><div class="kpi-label">Total Target</div><div class="kpi-value">${fmt(totalTarget)}</div></div>
    <div class="kpi income"><div class="kpi-label">Total Saved Toward Goals</div><div class="kpi-value">${fmt(totalSaved)}</div></div>
    <div class="kpi expense"><div class="kpi-label">Emergency Buffer Target</div><div class="kpi-value">${fmt(plan.profile.bufferNeeded)}</div><div class="kpi-sub">${plan.profile.bufferMonths} month(s) of expenses</div></div>
    <div class="kpi ${plan.profile.availableSurplus>=0?'savings':'expense'}"><div class="kpi-label">Available Surplus (beyond buffer)</div><div class="kpi-value">${fmt(plan.profile.availableSurplus)}</div></div>
    <div class="kpi income"><div class="kpi-label">Avg Monthly Savings Capacity</div><div class="kpi-value">${fmt(plan.profile.avgMonthlySavings)}</div></div>
  `;

  buildGoalTimelineChart(plan, active);

  // Sprint 21 — additive AI recommendations/analytics/notifications panel;
  // runs regardless of whether any goals exist yet (it can recommend a
  // first goal). Own try/catch so a failure here can never break the
  // existing goals list/timeline above.
  try{ App.Goals.UI.render(plan); }catch(err){ App.Logger.error('App.Goals.UI.render failed', err); }

  const listEl = document.getElementById('goalsList');
  if(!state.goals.length){ listEl.innerHTML = '<div class="empty-note">No goals added yet. Add one above — e.g. Laptop, Mobile, Protein (monthly stock-up).</div>'; return; }

  const sortedActive = [...active].sort((a,b)=> (a.isEmergencyFund?0:1)-(b.isEmergencyFund?0:1) || (a.priority-b.priority));
  // Sprint 21: icon map now lives in App.Goals.Config.TYPE_ICONS (single source of
  // truth for both this render and the new AI goal cards below) — same 4 original
  // icons are still in there, only new goal-type entries were added, so this line
  // renders exactly as before for every pre-existing goal.
  const catIcon = App.Goals.Config.TYPE_ICONS;

  const activeHtml = sortedActive.map((g,idx)=>{
    const r = plan.results[g.id];
    const v = goalVerdictText(g, plan);
    const status = computeGoalStatus(g, plan);
    const sortedContrib = [...g.contributions].sort((a,b)=>b.date.localeCompare(a.date));
    const recentContrib = sortedContrib.slice(0,3);
    const totalContrib = sum(g.contributions);
    const avgContrib = g.contributions.length ? totalContrib/g.contributions.length : 0;
    const lastContrib = sortedContrib[0];
    const canReorder = !g.isEmergencyFund;
    return `<div class="budget-row" data-id="${g.id}" style="padding-bottom:14px;border-bottom:1px solid var(--line);margin-bottom:14px;">
      <div class="budget-top">
        <span class="budget-cat">${catIcon[g.category]||'🎯'} ${g.name} <span class="tag" style="margin-left:6px;">${g.category}</span> <span class="tag" style="margin-left:4px;background:transparent;border:1px solid ${statusColor(status)};color:${statusColor(status)};">${status}</span></span>
        <span class="budget-figs">${fmt(g.cost)}</span>
      </div>
      <div class="bar-track" style="margin-top:6px;"><div class="bar-fill" style="width:${r.progressPct}%;"></div></div>
      <div class="card-note" style="margin-top:3px;">${r.progressPct.toFixed(0)}% funded — ${fmt(r.contributed)} of ${fmt(g.cost)}</div>

      <div class="insight" style="padding:8px 0;"><span class="dot ${v.dot}"></span><p><b>${v.text}</b><br>${v.detail}</p></div>
      ${g.notes ? `<div class="card-note">📝 ${g.notes}</div>` : ''}

      <div class="form-grid" style="margin-top:8px;">
        <div><label>Log a contribution — Date</label><input type="date" class="c_date" value="${todayStr()}"></div>
        <div><label>Amount (₹)</label><input type="number" class="c_amount" min="0" step="1" placeholder="e.g. 2000"></div>
      </div>
      <div class="row-actions" style="margin-top:6px;">
        <button class="btn small secondary add-contrib" data-id="${g.id}">+ Add Contribution</button>
        ${canReorder?`<button class="btn small secondary priority-up" data-id="${g.id}" ${idx===0?'disabled':''} title="Higher priority">▲</button>
        <button class="btn small secondary priority-down" data-id="${g.id}" ${idx===sortedActive.length-1?'disabled':''} title="Lower priority">▼</button>`:''}
        ${g.paused ? `<button class="btn small secondary resume-goal" data-id="${g.id}">Resume</button>` : `<button class="btn small secondary pause-goal" data-id="${g.id}">Pause</button>`}
        <button class="btn small secondary mark-achieved" data-id="${g.id}">Mark Achieved</button>
        <button class="btn small secondary edit-goal" data-id="${g.id}">Edit</button>
        ${g.isEmergencyFund ? '' : `<button class="btn small rust del-goal" data-id="${g.id}">Remove</button>`}
      </div>

      <div class="card-note" style="margin-top:10px;">
        <b>Contribution History</b> — Total: ${fmt(totalContrib)} · Last: ${lastContrib?`${fmt(lastContrib.amount)} on ${lastContrib.date}`:'—'} · Average: ${fmt(avgContrib)} (${g.contributions.length} entr${g.contributions.length===1?'y':'ies'})
        ${recentContrib.length? `<div style="margin-top:4px;">${recentContrib.map(c=>`${c.date} — ${fmt(c.amount)}`).join(' · ')}</div>` : ''}
      </div>

      <div class="card-note" style="margin-top:10px;">
        <label style="margin-bottom:4px;">What if I save more? <span style="font-weight:700;">(ESTIMATE)</span></label>
        <div class="row-actions" style="margin-bottom:6px;">
          <button class="btn small secondary whatif-preset" data-id="${g.id}" data-val="-1000">-₹1,000</button>
          <button class="btn small secondary whatif-preset" data-id="${g.id}" data-val="1000">+₹1,000</button>
          <button class="btn small secondary whatif-preset" data-id="${g.id}" data-val="2000">+₹2,000</button>
          <button class="btn small secondary whatif-preset" data-id="${g.id}" data-val="3000">+₹3,000</button>
        </div>
        <input type="range" class="whatif-slider" data-id="${g.id}" min="-5000" max="10000" step="500" value="0" style="width:100%;">
        <div class="whatif-result" data-id="${g.id}" style="font-family:var(--font-mono);font-size:12.5px;margin-top:4px;">Current pace → no change tested yet</div>
      </div>
    </div>`;
  }).join('');

  const achievedHtml = achieved.length ? `<h4 style="font-family:var(--font-display);margin:10px 0;">Achieved 🎉</h4>` +
    achieved.map(g=>`<div class="budget-row"><div class="budget-top"><span class="budget-cat">${catIcon[g.category]||'🎯'} ${g.name}</span><span class="budget-figs">${fmt(g.cost)}</span></div>
      <div class="row-actions"><button class="btn small secondary unachieve" data-id="${g.id}">Move back to Active</button>${g.isEmergencyFund?'':`<button class="btn small rust del-goal" data-id="${g.id}">Remove</button>`}</div></div>`).join('')
    : '';

  listEl.innerHTML = activeHtml + achievedHtml;

  listEl.querySelectorAll('.del-goal').forEach(b=>b.addEventListener('click', async e=>{
    const id = e.target.dataset.id;
    if(!confirm('Remove this goal? Its contribution history will be deleted too.')) return;
    state.goals = state.goals.filter(g=>g.id!==id);
    await saveGoals(); renderGoals();
  }));
  listEl.querySelectorAll('.mark-achieved').forEach(b=>b.addEventListener('click', async e=>{
    const g = state.goals.find(x=>x.id===e.target.dataset.id); if(g){ g.achieved=true; g.paused=false; await saveGoals(); renderGoals(); }
  }));
  listEl.querySelectorAll('.edit-goal').forEach(b=>b.addEventListener('click', e=>{
    startEditGoal(e.target.dataset.id);
  }));
  listEl.querySelectorAll('.unachieve').forEach(b=>b.addEventListener('click', async e=>{
    const g = state.goals.find(x=>x.id===e.target.dataset.id); if(g){ g.achieved=false; await saveGoals(); renderGoals(); }
  }));
  listEl.querySelectorAll('.pause-goal').forEach(b=>b.addEventListener('click', async e=>{
    const g = state.goals.find(x=>x.id===e.target.dataset.id); if(g){ g.paused=true; await saveGoals(); renderGoals(); }
  }));
  listEl.querySelectorAll('.resume-goal').forEach(b=>b.addEventListener('click', async e=>{
    const g = state.goals.find(x=>x.id===e.target.dataset.id); if(g){ g.paused=false; await saveGoals(); renderGoals(); }
  }));
  listEl.querySelectorAll('.priority-up').forEach(b=>b.addEventListener('click', async e=>{
    swapPriority(e.target.dataset.id, -1); 
  }));
  listEl.querySelectorAll('.priority-down').forEach(b=>b.addEventListener('click', async e=>{
    swapPriority(e.target.dataset.id, 1);
  }));
  listEl.querySelectorAll('.add-contrib').forEach(b=>b.addEventListener('click', async e=>{
    const id = e.target.dataset.id;
    const row = e.target.closest('.budget-row');
    const date = row.querySelector('.c_date').value || todayStr();
    const amount = parseFloat(row.querySelector('.c_amount').value);
    if(!amount || amount<=0){ alert('Enter a valid contribution amount.'); return; }
    const g = state.goals.find(x=>x.id===id);
    g.contributions.push({id:uid(), date, amount});
    await saveGoals(); renderGoals();
  }));
  function runWhatIf(id, extra){
    const newPlan = computeGoalPlan({[id]: extra});
    const baselinePlan = plan;
    const g = state.goals.find(x=>x.id===id);
    const r = newPlan.results[id];
    const base = baselinePlan.results[id];
    const out = listEl.querySelector(`.whatif-result[data-id="${id}"]`);
    if(!r || !g || !out) return;
    const sign = extra>=0?'+':'';
    if(r.remainingCost<=0){ out.textContent = `${sign}₹${extra}/month → already fully funded (ESTIMATE)`; return; }
    if(r.monthlyRate<=0){ out.textContent = `${sign}₹${extra}/month → still no capacity available (ESTIMATE)`; return; }
    const months = Math.ceil(r.completionMonths);
    const target = new Date(); target.setMonth(target.getMonth()+months);
    let monthsSavedText = '';
    if(base && isFinite(base.completionMonths) && isFinite(r.completionMonths)){
      const saved = Math.round((base.completionMonths - r.completionMonths)*10)/10;
      if(saved>0) monthsSavedText = ` — ${saved} month(s) sooner`;
      else if(saved<0) monthsSavedText = ` — ${Math.abs(saved)} month(s) later`;
    }
    let extraNeededText = '';
    if(g.targetDate && r.paceStatus && !r.paceStatus.onTrack){
      const short = Math.max(0, r.paceStatus.requiredMonthly - r.monthlyRate);
      extraNeededText = ` · ~${fmt(short)}/month more needed to hit your target date of ${g.targetDate}`;
    }
    out.textContent = `${sign}₹${extra}/month → done ~${target.toISOString().slice(0,10)}${monthsSavedText}${extraNeededText} (ESTIMATE)`;
  }
  listEl.querySelectorAll('.whatif-slider').forEach(s=>s.addEventListener('input', e=>{
    runWhatIf(e.target.dataset.id, Number(e.target.value));
  }));
  listEl.querySelectorAll('.whatif-preset').forEach(b=>b.addEventListener('click', e=>{
    const id = e.target.dataset.id;
    const val = Number(e.target.dataset.val);
    const row = e.target.closest('.budget-row');
    const slider = row.querySelector('.whatif-slider');
    const newVal = Math.max(-5000, Math.min(10000, Number(slider.value)+val));
    slider.value = newVal;
    runWhatIf(id, newVal);
  }));
}

async function swapPriority(id, direction){
  const active = state.goals.filter(g=>!g.achieved && !g.isEmergencyFund).sort((a,b)=>a.priority-b.priority);
  const idx = active.findIndex(g=>g.id===id);
  const swapIdx = idx+direction;
  if(idx<0 || swapIdx<0 || swapIdx>=active.length) return;
  const a = active[idx], b = active[swapIdx];
  const tmp = a.priority; a.priority = b.priority; b.priority = tmp;
  await saveGoals();
  renderGoals();
}

function buildGoalTimelineChart(plan, active){
  destroyChart('goaltimeline');
  const canvas = document.getElementById('c_goaltimeline');
  const chartable = active.filter(g=>!g.paused);
  if(!chartable.length){ noData('c_goaltimeline'); return; }
  const sorted = [...chartable].sort((a,b)=> (a.isEmergencyFund?0:1)-(b.isEmergencyFund?0:1) || (a.priority-b.priority));
  const labels = sorted.map(g=>g.name);
  const months = sorted.map(g=>{
    const r = plan.results[g.id];
    if(!r || r.remainingCost<=0) return 0;
    if(!isFinite(r.completionMonths)) return 0;
    return Math.round(r.completionMonths*10)/10;
  });
  const {grid,text} = chartTheme();
  charts.goaltimeline = new Chart(canvas, {
    type:'bar',
    data:{ labels, datasets:[{label:'Months to completion', data:months, backgroundColor:'#B98A1E'}] },
    options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{color:text},grid:{color:grid},title:{display:true,text:'months',color:text}},y:{ticks:{color:text},grid:{color:grid}}}}
  });
}

/* ---------------------------------------------------------------
   FOOD ANALYSIS
--------------------------------------------------------------- */
function renderFood(){
  const foodTxns = expenseTxns().filter(t=>FOOD_CATS.includes(t.category));
  const totalFood = sum(foodTxns);
  const totalExp = sum(expenseTxns());
  const days = uniqueDays(foodTxns);
  const avgDaily = days.size ? totalFood/days.size : 0;
  let highest=null, highestAmt=0;
  foodTxns.forEach(t=>{ if(Number(t.amount)>highestAmt){ highestAmt=Number(t.amount); highest=t; } });
  const pctOfTotal = totalExp>0 ? (totalFood/totalExp*100) : 0;

  document.getElementById('foodKpis').innerHTML = `
    <div class="kpi expense"><div class="kpi-label">Total Food Cost</div><div class="kpi-value">${fmt(totalFood)}</div><div class="kpi-sub">${foodTxns.length} entries</div></div>
    <div class="kpi expense"><div class="kpi-label">Avg Food Cost / Day</div><div class="kpi-value">${days.size? fmt(avgDaily):'—'}</div><div class="kpi-sub">${days.size? days.size+' day(s) tracked':'Not enough data available yet.'}</div></div>
    <div class="kpi expense"><div class="kpi-label">Highest Food Expense</div><div class="kpi-value">${highest? fmt(highestAmt):'—'}</div><div class="kpi-sub">${highest? (highest.item||highest.category)+' · '+highest.date : 'Not enough data available yet.'}</div></div>
    <div class="kpi savings"><div class="kpi-label">% of Total Expenses</div><div class="kpi-value">${totalExp? pctOfTotal.toFixed(1)+'%':'—'}</div><div class="kpi-sub">spent on food</div></div>
  `;
  const grid = document.getElementById('foodCharts');
  grid.innerHTML = `
    <div class="chart-box"><h4>Food Category Breakdown</h4><canvas id="c_foodbreak"></canvas></div>
    <div class="chart-box"><h4>Monthly Food Expense Trend</h4><canvas id="c_foodtrend"></canvas></div>
  `;
  destroyChart('foodbreak'); destroyChart('foodtrend');
  const byCat={}; foodTxns.forEach(t=>byCat[t.category]=(byCat[t.category]||0)+Number(t.amount));
  if(Object.keys(byCat).length){
    const {text} = chartTheme();
    charts.foodbreak = new Chart(document.getElementById('c_foodbreak'), {
      type:'doughnut',
      data:{labels:Object.keys(byCat), datasets:[{data:Object.values(byCat), backgroundColor:palette(Object.keys(byCat).length)}]},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:text,boxWidth:10,font:{size:10}}}}}
    });
  } else noData('c_foodbreak');

  const months = [...new Set(foodTxns.map(t=>monthKey(t.date)))].sort();
  if(months.length){
    const data = months.map(m=> sum(foodTxns.filter(t=>monthKey(t.date)===m)) );
    const {grid:g,text} = chartTheme();
    charts.foodtrend = new Chart(document.getElementById('c_foodtrend'), {
      type:'line',
      data:{labels:months, datasets:[{label:'Food Spend', data, borderColor:'#B54834', backgroundColor:'#B5483422', fill:true, tension:.3}]},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{ticks:{color:text},grid:{color:g}},y:{ticks:{color:text},grid:{color:g}}}}
    });
  } else noData('c_foodtrend');
}

/* ---------------------------------------------------------------
   MONTH-OVER-MONTH COMPARISON & CATEGORY TRENDS
--------------------------------------------------------------- */
function computeMoMHtml(thisM, lastM, labelThis, labelLast){
  labelThis = labelThis || 'this month'; labelLast = labelLast || 'last month';
  const exp = expenseTxns(), inc = incomeTxns();
  const monthsPresent = new Set([...exp,...inc].map(t=>monthKey(t.date)));
  if(!monthsPresent.has(thisM) && !monthsPresent.has(lastM)){
    return { html: '', hasData: false };
  }
  const thisInc = sum(inc.filter(t=>monthKey(t.date)===thisM)), lastInc = sum(inc.filter(t=>monthKey(t.date)===lastM));
  const thisExp = sum(exp.filter(t=>monthKey(t.date)===thisM)), lastExp = sum(exp.filter(t=>monthKey(t.date)===lastM));
  const thisSave = thisInc-thisExp, lastSave = lastInc-lastExp;
  const thisRate = thisInc? (thisSave/thisInc*100) : null;
  const lastRate = lastInc? (lastSave/lastInc*100) : null;
  function rowFor(label, a, b, isPct){
    if(!isFinite(a)) a=0; if(!isFinite(b)) b=0;
    let arrow='→', pctText='similar', color='var(--ink-soft)';
    if(b===0 && a===0){ arrow='→'; pctText='no change'; }
    else if(b===0){ arrow='↑'; pctText=`new ${labelThis}`; color='var(--gold)'; }
    else{
      const chg = (a-b)/Math.abs(b)*100;
      if(!isFinite(chg)){ arrow='→'; pctText='—'; }
      else if(chg>3){ arrow='↑'; pctText=chg.toFixed(0)+'% increase'; color='var(--rust)'; }
      else if(chg<-3){ arrow='↓'; pctText=Math.abs(chg).toFixed(0)+'% decrease'; color='var(--teal)'; }
      else { arrow='→'; pctText='similar (±3%)'; }
    }
    return `<div class="insight"><span class="dot info"></span><p><b>${label}</b>: ${isPct? (a===null?'—':a.toFixed(1)+'%') : fmt(a)} ${labelThis} vs ${isPct? (b===null?'—':b.toFixed(1)+'%') : fmt(b)} ${labelLast} — <span style="color:${color};font-weight:700;">${arrow} ${pctText}</span></p></div>`;
  }
  let html = '';
  html += rowFor('Income', thisInc, lastInc, false);
  html += rowFor('Expenses', thisExp, lastExp, false);
  html += rowFor('Savings', thisSave, lastSave, false);
  html += rowFor('Savings Rate', thisRate===null?0:thisRate, lastRate===null?0:lastRate, true);
  const thisByCat={}, lastByCat={};
  exp.forEach(t=>{
    if(monthKey(t.date)===thisM) thisByCat[t.category]=(thisByCat[t.category]||0)+Number(t.amount);
    if(monthKey(t.date)===lastM) lastByCat[t.category]=(lastByCat[t.category]||0)+Number(t.amount);
  });
  const cats = new Set([...Object.keys(thisByCat), ...Object.keys(lastByCat)]);
  let biggest=null, biggestDiff=0;
  cats.forEach(c=>{
    const diff = (thisByCat[c]||0)-(lastByCat[c]||0);
    if(Math.abs(diff) > Math.abs(biggestDiff)){ biggestDiff=diff; biggest=c; }
  });
  if(biggest && biggestDiff!==0){
    html += `<div class="insight"><span class="dot ${biggestDiff>0?'bad':'good'}"></span><p>Biggest mover: <b>${biggest}</b> ${biggestDiff>0?'increased':'decreased'} spending by ${fmt(Math.abs(biggestDiff))} compared to ${labelLast}.</p></div>`;
  }
  return { html, hasData: true };
}
function renderMonthOverMonth(){
  const el = document.getElementById('momPanel');
  const exp = expenseTxns(), inc = incomeTxns();
  const thisM = monthKey(todayStr());
  const lastMDate = new Date(); lastMDate.setMonth(lastMDate.getMonth()-1);
  const lastM = monthKey(lastMDate.toISOString().slice(0,10));
  const thisInc = sum(inc.filter(t=>monthKey(t.date)===thisM)), lastInc = sum(inc.filter(t=>monthKey(t.date)===lastM));
  const thisExp = sum(exp.filter(t=>monthKey(t.date)===thisM)), lastExp = sum(exp.filter(t=>monthKey(t.date)===lastM));
  const thisSav = thisInc-thisExp, lastSav = lastInc-lastExp;
  if(!thisInc && !lastInc && !thisExp && !lastExp){ el.innerHTML = '<div class="empty-note">Not enough recorded data yet for a month-over-month comparison.</div>'; return; }

  const nwThisRec = state.netWorthHistory.find(h=>h.month===thisM);
  const nwLastRec = state.netWorthHistory.find(h=>h.month===lastM);
  const nwThis = nwThisRec ? nwThisRec.netWorth : (netWorthAssets()-netWorthLiabilities());
  const nwLast = nwLastRec ? nwLastRec.netWorth : null;

  const metrics = [
    {label:'Income', cur:thisInc, prev:lastInc},
    {label:'Expense', cur:thisExp, prev:lastExp},
    {label:'Savings', cur:thisSav, prev:lastSav},
    {label:'Net Worth', cur:nwThis, prev:nwLast}
  ];
  const allVals = metrics.flatMap(m=>[m.cur, m.prev===null?0:m.prev]).map(Math.abs);
  const maxVal = Math.max(1, ...allVals);
  const bars = metrics.map(m=>{
    const curH = Math.max(2, Math.round(Math.abs(m.cur)/maxVal*100));
    const prevH = m.prev===null ? 0 : Math.max(2, Math.round(Math.abs(m.prev)/maxVal*100));
    return `<div class="kh-ins-mom-group">
      ${m.prev===null?'':`<div class="kh-ins-mom-bar prev" style="height:${prevH}%;" title="Last month: ${fmt(m.prev)}"></div>`}
      <div class="kh-ins-mom-bar cur" style="height:${curH}%;" title="This month: ${fmt(m.cur)}"></div>
    </div>`;
  }).join('');
  const labels = metrics.map(m=>`<div>${m.label}</div>`).join('');
  const kpis = metrics.map(m=>{
    const pct = (m.prev && m.prev!==0) ? ((m.cur-m.prev)/Math.abs(m.prev)*100) : null;
    const color = pct===null ? 'var(--kh-text-soft)' : (pct>=0?'var(--kh-green)':'var(--kh-red)');
    return `<div class="kh-ins-mom-kpi"><div class="lbl">${m.label}</div><div class="val" style="color:${color};">${pct===null?'—':(pct>=0?'+':'')+pct.toFixed(1)+'%'}</div></div>`;
  }).join('');

  // real "biggest mover" category, month over month (same rule as before)
  const thisByCat={}, lastByCat={};
  exp.forEach(t=>{
    if(monthKey(t.date)===thisM) thisByCat[t.category]=(thisByCat[t.category]||0)+Number(t.amount);
    if(monthKey(t.date)===lastM) lastByCat[t.category]=(lastByCat[t.category]||0)+Number(t.amount);
  });
  const cats = new Set([...Object.keys(thisByCat), ...Object.keys(lastByCat)]);
  let biggest=null, biggestDiff=0;
  cats.forEach(c=>{ const diff=(thisByCat[c]||0)-(lastByCat[c]||0); if(Math.abs(diff)>Math.abs(biggestDiff)){biggestDiff=diff;biggest=c;} });

  el.innerHTML = `
    <div class="kh-ins-mom-wrap">
      <div class="kh-ins-mom-legend"><span><i style="background:rgba(255,255,255,.14);"></i>Last Month</span><span><i style="background:linear-gradient(180deg,var(--kh-cyan),var(--kh-purple));"></i>This Month</span></div>
      <div class="kh-ins-mom-bars">${bars}</div>
      <div class="kh-ins-mom-labels">${labels}</div>
      <div class="kh-ins-mom-kpis">${kpis}</div>
      ${biggest && biggestDiff!==0 ? `<div class="insight"><span class="dot ${biggestDiff>0?'bad':'good'}"></span><p>Biggest mover: <b>${biggest}</b> ${biggestDiff>0?'increased':'decreased'} spending by ${fmt(Math.abs(biggestDiff))} vs last month.</p></div>` : ''}
    </div>`;
}

/* ---------------------------------------------------------------
   UNUSUAL EXPENSE DETECTION & SMALL FREQUENT EXPENSE ANALYSIS
--------------------------------------------------------------- */
function renderUnusualExpenses(){
  const el = document.getElementById('unusualExpList');
  const exp = expenseTxns();
  if(exp.length<4){ el.innerHTML = '<div class="kh-ins-empty">Not enough recorded data yet.</div>'; return; }
  const thisM = monthKey(todayStr());
  const currentTxns = exp.filter(t=>monthKey(t.date)===thisM);
  const historical = exp.filter(t=>monthKey(t.date)!==thisM);
  const alerts = [];
  currentTxns.forEach(t=>{
    const histForCat = historical.filter(h=>h.category===t.category);
    if(histForCat.length<3) return;
    const avg = sum(histForCat)/histForCat.length;
    if(avg>0 && Number(t.amount) > avg*2.5){
      const ratio = Number(t.amount)/avg;
      alerts.push({t, avg, ratio, severity: ratio>=4?'high':'medium'});
    }
  });
  alerts.sort((a,b)=>b.ratio-a.ratio);
  const flaggedIds = new Set(alerts.map(a=>a.t.id));
  // one recent normal-range transaction for context, mirroring the flagship timeline
  const normalCandidate = currentTxns.filter(t=>!flaggedIds.has(t.id)).slice().sort((a,b)=>Number(b.amount)-Number(a.amount))[0];
  const rows = alerts.slice(0,7).map(a=>({t:a.t, sev:a.severity, note:`${a.ratio.toFixed(1)}× your usual ${a.t.category} spending (avg ${fmt(a.avg)})`}));
  if(normalCandidate) rows.push({t:normalCandidate, sev:'normal', note:'Normal spending'});
  if(!rows.length){ el.innerHTML = '<div class="kh-ins-empty">No unusual expenses detected this month.</div>'; return; }
  rows.sort((a,b)=> (b.t.date>a.t.date?1:-1));
  const sevColor = {high:'var(--kh-red)', medium:'#FBBF24', normal:'var(--kh-green)'};
  const sevLabel = {high:'High', medium:'Medium', normal:'Normal'};
  el.innerHTML = `<div class="kh-ins-timeline">${rows.map(r=>`
    <div class="kh-ins-tl-item" style="--dotc:${sevColor[r.sev]};">
      <div class="kh-ins-tl-date">${r.t.date}</div>
      <div class="kh-ins-tl-row">
        <div class="kh-ins-tl-left">
          <div class="kh-ins-tl-ic">${khCatIcon(r.t.category)}</div>
          <div><div class="kh-ins-tl-name">${r.t.category}${r.t.item?' — '+r.t.item:''}</div><div class="kh-ins-tl-sub">${r.note}</div></div>
        </div>
        <div style="text-align:right;">
          <div class="kh-ins-tl-amt">${fmt(r.t.amount)}</div>
          <div class="kh-ins-tl-badge ${r.sev==='normal'?'normal':r.sev==='high'?'high':'medium'}">${sevLabel[r.sev]}</div>
        </div>
      </div>
    </div>`).join('')}</div>`;
}
function renderSmallFrequentExpenses(){
  const el = document.getElementById('smallFreqList');
  const exp = expenseTxns();
  const thisM = monthKey(todayStr());
  const small = exp.filter(t=>monthKey(t.date)===thisM && Number(t.amount)<100);
  const byCat={};
  small.forEach(t=>{ (byCat[t.category]=byCat[t.category]||[]).push(t); });
  const flagged = Object.entries(byCat).filter(([c,arr])=>arr.length>5);
  if(!flagged.length){ el.innerHTML = '<div class="kh-ins-empty">Not enough recorded data yet — no repeated small purchases (under ₹100, more than 5 times) found this month.</div>'; return; }
  const rows = flagged.map(([c,arr])=>{
    const total = sum(arr);
    const avg = total/arr.length;
    const projectedMonthly = avg*arr.length;
    const projectedYearly = projectedMonthly*12;
    return {c, count:arr.length, total, projectedMonthly, projectedYearly};
  }).sort((a,b)=>b.total-a.total);
  const maxTotal = Math.max(...rows.map(r=>r.total));
  const minD = 56, maxD = 108;
  const palette = [['var(--kh-bd1a)','var(--kh-bd1b)'],['var(--kh-bd2a)','var(--kh-bd2b)'],['var(--kh-bd5a)','var(--kh-bd5b)'],['var(--kh-bd6a)','var(--kh-bd6b)'],['var(--kh-bd3a)','var(--kh-bd3b)'],['var(--kh-bd7a)','var(--kh-bd7b)']];
  const bubbles = rows.map((r,i)=>{
    const size = Math.round(minD + (r.total/maxTotal)*(maxD-minD));
    const [ca,cb] = palette[i%palette.length];
    return `<div class="kh-ins-bubble" style="width:${size}px;height:${size}px;--ca:${ca};--cb:${cb};animation-delay:${(i*0.3).toFixed(1)}s;" title="${r.count} purchases, avg ${fmt(r.total/r.count)}">
      <div class="b-name">${r.c}</div><div class="b-amt">${fmt(r.total)}</div>
    </div>`;
  }).join('');
  const totalMonthly = rows.reduce((s,r)=>s+r.projectedMonthly,0);
  const totalYearly = rows.reduce((s,r)=>s+r.projectedYearly,0);
  const potentialSavings = Math.round(totalMonthly*0.3); // ESTIMATE: cutting these back by ~30%
  el.innerHTML = `
    <div class="kh-ins-bubbles">${bubbles}</div>
    <div class="kh-ins-bubble-stats">
      <div class="kh-ins-bubble-stat"><div class="lbl">Monthly Total</div><div class="val">${fmt(totalMonthly)}</div></div>
      <div class="kh-ins-bubble-stat"><div class="lbl">Yearly Projection</div><div class="val">${fmt(totalYearly)}</div></div>
      <div class="kh-ins-bubble-stat"><div class="lbl">Potential Savings</div><div class="val" style="color:var(--kh-green);">${fmt(potentialSavings)}</div></div>
    </div>
    <div class="card-note" style="margin-top:8px;">ESTIMATE, based on this month's pace — does not modify actual stored data.</div>
  `;
}

/* ---------------------------------------------------------------
   ADVANCED FINANCIAL WHAT-IF SIMULATOR
--------------------------------------------------------------- */
function prefillSimulator(){
  const incEl = document.getElementById('sim_income'), expEl = document.getElementById('sim_expenses');
  if(incEl && !incEl.value){
    const from = startOfMonth(0), to = endOfMonth(0);
    incEl.value = Math.round(sum(incomeTxns().filter(t=>dateInRange(t.date,from,to)))) || '';
    expEl.value = Math.round(sum(expenseTxns().filter(t=>dateInRange(t.date,from,to)))) || '';
  }
}
document.getElementById('simRunBtn').addEventListener('click', ()=>{
  const income = parseFloat(document.getElementById('sim_income').value)||0;
  const expenses = parseFloat(document.getElementById('sim_expenses').value)||0;
  const extra = parseFloat(document.getElementById('sim_extra').value)||0;
  const goalAdj = parseFloat(document.getElementById('sim_goal').value)||0;
  const el = document.getElementById('simResult');
  const monthlySavings = income - expenses + extra - goalAdj;
  const annualSavings = monthlySavings*12;

  const active = state.goals.filter(g=>!g.achieved).sort((a,b)=>a.priority-b.priority);
  let goalText = 'Add a goal to see its projected timeline change.';
  if(active.length){
    const g = active[0];
    const plan = computeGoalPlan();
    const base = plan.results[g.id];
    const withExtra = computeGoalPlan({[g.id]: extra+goalAdj});
    const after = withExtra.results[g.id];
    if(base && base.monthlyRate>0 && isFinite(base.completionMonths) && after && isFinite(after.completionMonths)){
      const mb = Math.ceil(base.completionMonths), ma = Math.ceil(after.completionMonths);
      goalText = `Your top goal, <b>${g.name}</b>, would complete in ~${ma} month(s) instead of ~${mb} (${mb-ma>=0?'':''}${Math.abs(mb-ma)} month(s) ${ma<=mb?'sooner':'later'}).`;
    } else {
      goalText = `Not enough baseline data yet to project a timeline change for <b>${g.name}</b>.`;
    }
  }
  const efGoal = getEmergencyFundGoal();
  let efText = 'No emergency fund goal set up yet.';
  if(efGoal){
    const target = Number(efGoal.cost)||0, saved = Number(efGoal.contributions)||0;
    const shortfall = Math.max(0, target-saved);
    const monthlyToEF = Math.max(0, monthlySavings);
    efText = shortfall<=0 ? 'Your emergency fund is already fully funded.' : (monthlyToEF>0 ? `At ${fmt(monthlyToEF)}/month in projected savings, your emergency fund shortfall of ${fmt(shortfall)} could close in ~${Math.ceil(shortfall/monthlyToEF)} month(s) (ESTIMATE).` : 'Projected savings aren\'t positive, so the emergency fund wouldn\'t grow under this scenario.');
  }
  el.innerHTML = `
    <div class="kh-ins-pred-card">
      <div class="kh-ins-pred-row">
        <div>
          <div class="kh-ins-sum-label">Projected Monthly Savings</div>
          <div class="kh-ins-pred-big ${monthlySavings>=0?'pos':'neg'}">${fmt(monthlySavings)}</div>
        </div>
        <div>
          <div class="kh-ins-sum-label">Projected Yearly Savings</div>
          <div class="kh-ins-pred-big ${annualSavings>=0?'pos':'neg'}">${fmt(annualSavings)}</div>
        </div>
      </div>
    </div>
    <div class="insight" style="margin-top:10px;"><span class="dot info"></span><p>${goalText}</p></div>
    <div class="insight"><span class="dot info"></span><p>${efText}</p></div>
    <div class="card-note" style="margin-top:6px;">ESTIMATE — does not modify actual stored data.</div>
  `;
});

/* ---------------------------------------------------------------
   ANALYSIS + RECOMMENDATIONS
--------------------------------------------------------------- */
/* ---------------------------------------------------------------
   SPENDING INTELLIGENCE
--------------------------------------------------------------- */
function renderSpendingIntelligence(){
  const el = document.getElementById('spendingIntelList');
  const exp = expenseTxns();
  if(exp.length===0){ el.innerHTML = '<div class="empty-note">Not enough data available yet. Add some expenses to unlock spending intelligence.</div>'; return; }
  const items = [];
  let statWeekendPct = null, statWeekendHigher = null, statTopMode = null, statTopModePct = null, statDailyAvg = null;

  // highest / lowest spending category (all-time)
  const byCat={}; exp.forEach(t=>byCat[t.category]=(byCat[t.category]||0)+Number(t.amount));
  const sortedCats = Object.entries(byCat).sort((a,b)=>b[1]-a[1]);
  if(sortedCats.length){
    items.push({dot:'info', text:`<b>${sortedCats[0][0]}</b> is your highest spending category overall, at ${fmt(sortedCats[0][1])}.`});
    if(sortedCats.length>1){
      const lowest = sortedCats[sortedCats.length-1];
      items.push({dot:'info', text:`<b>${lowest[0]}</b> is your lowest spending category overall, at ${fmt(lowest[1])}.`});
    }
  }

  // largest transaction
  const largest = exp.slice().sort((a,b)=>Number(b.amount)-Number(a.amount))[0];
  if(largest){
    items.push({dot:'info', text:`Your largest recorded expense is <b>${fmt(largest.amount)}</b> on ${largest.date} for ${largest.category}${largest.item?' ('+largest.item+')':''}.`});
  }

  // most frequent purchase (by item name, case-insensitive, ignoring blanks)
  const byItem={};
  exp.forEach(t=>{ const key=(t.item||'').trim().toLowerCase(); if(!key) return; byItem[key]=byItem[key]||{count:0,label:t.item,total:0}; byItem[key].count++; byItem[key].total+=Number(t.amount); });
  const topItem = Object.values(byItem).sort((a,b)=>b.count-a.count)[0];
  if(topItem && topItem.count>=3){
    items.push({dot:'info', text:`Your most frequent purchase is <b>${topItem.label}</b> — logged ${topItem.count} times, totaling ${fmt(topItem.total)}.`});
  }

  // daily & weekly average (based on span of recorded days)
  const dates = exp.map(t=>t.date).sort();
  if(dates.length){
    const firstDate = new Date(dates[0]), lastDate = new Date(dates[dates.length-1]);
    const spanDays = Math.max(1, Math.round((lastDate-firstDate)/86400000)+1);
    const dailyAvg = sum(exp)/spanDays;
    const weeklyAvg = dailyAvg*7;
    statDailyAvg = dailyAvg;
    items.push({dot:'info', text:`Average daily spending is <b>${fmt(dailyAvg)}</b> (about ${fmt(weeklyAvg)}/week), based on ${spanDays} day(s) of recorded data.`});
  }

  // weekend vs weekday spending
  const weekend = exp.filter(t=>{ const d=new Date(t.date).getDay(); return d===0||d===6; });
  const weekday = exp.filter(t=>{ const d=new Date(t.date).getDay(); return d!==0&&d!==6; });
  if(weekend.length && weekday.length){
    const weekendCount = new Set(weekend.map(t=>t.date)).size, weekdayCount = new Set(weekday.map(t=>t.date)).size;
    const weekendAvgPerDay = sum(weekend)/Math.max(1,weekendCount);
    const weekdayAvgPerDay = sum(weekday)/Math.max(1,weekdayCount);
    if(weekendAvgPerDay>0 || weekdayAvgPerDay>0){
      const higher = weekendAvgPerDay>weekdayAvgPerDay ? 'weekend' : 'weekday';
      const diffPct = weekdayAvgPerDay>0 ? Math.abs((weekendAvgPerDay-weekdayAvgPerDay)/weekdayAvgPerDay*100) : null;
      statWeekendHigher = higher; statWeekendPct = diffPct;
      items.push({dot:'info', text:`Your ${higher} spending is higher on average (${fmt(weekendAvgPerDay)}/weekend-day vs ${fmt(weekdayAvgPerDay)}/weekday)${diffPct!==null && isFinite(diffPct)?`, about ${diffPct.toFixed(0)}% ${higher==='weekend'?'more':'less'} than weekdays`:''}.`});
    }
  }

  // repeated expenses — same category+item combo recurring across multiple distinct dates
  const repeated = Object.values(byItem).filter(v=>v.count>=3).sort((a,b)=>b.count-a.count).slice(0,3);
  if(repeated.length){
    items.push({dot:'info', text:`Repeated expenses: ${repeated.map(r=>`<b>${r.label}</b> (${r.count}×, avg ${fmt(r.total/r.count)})`).join(', ')}.`});
  }

  // large expenses (top 3 outliers by amount, this month)
  const thisM = monthKey(todayStr());
  const thisMonthExp = exp.filter(t=>monthKey(t.date)===thisM);
  const largeThisMonth = thisMonthExp.slice().sort((a,b)=>Number(b.amount)-Number(a.amount)).slice(0,3);
  if(largeThisMonth.length){
    items.push({dot:'warn', text:`Largest expenses this month: ${largeThisMonth.map(t=>`${fmt(t.amount)} (${t.category}, ${t.date})`).join('; ')}.`});
  }

  // payment mode patterns
  const byMode={}; exp.forEach(t=>{ const md=t.mode||'Unspecified'; byMode[md]=(byMode[md]||0)+Number(t.amount); });
  const modeSorted = Object.entries(byMode).sort((a,b)=>b[1]-a[1]);
  const totalExpAll = sum(exp);
  if(modeSorted.length && totalExpAll>0){
    const [topMode, topModeAmt] = modeSorted[0];
    statTopMode = topMode; statTopModePct = (topModeAmt/totalExpAll*100);
    items.push({dot:'info', text:`Most of your spending goes through <b>${topMode}</b> — ${fmt(topModeAmt)} (${(topModeAmt/totalExpAll*100).toFixed(0)}% of total expenses).`});
  }

  // fast-growing categories — compare last 2 available months for each category, need 3+ months of data to be meaningful
  const months = monthsRange();
  if(months.length>=3){
    const recent = months.slice(-3);
    const [m1,m2,m3] = recent;
    const catTotals = (m)=>{ const o={}; exp.filter(t=>monthKey(t.date)===m).forEach(t=>o[t.category]=(o[t.category]||0)+Number(t.amount)); return o; };
    const t1=catTotals(m1), t2=catTotals(m2), t3=catTotals(m3);
    const cats = new Set([...Object.keys(t1),...Object.keys(t2),...Object.keys(t3)]);
    const growth = [];
    cats.forEach(c=>{
      const v1=t1[c]||0, v2=t2[c]||0, v3=t3[c]||0;
      if(v1>0 && v2>v1 && v3>v2){
        growth.push({c, v1, v3, pct: ((v3-v1)/v1*100)});
      }
    });
    growth.sort((a,b)=>b.pct-a.pct);
    if(growth.length){
      const g = growth[0];
      items.push({dot:'warn', text:`<b>${g.c}</b> has grown for 3 months in a row — from ${fmt(g.v1)} (${m1}) to ${fmt(g.v3)} (${m3}), up ${g.pct.toFixed(0)}%.`});
    }
  }

  const statRows = [];
  if(sortedCats.length && totalExpAll>0){
    const pct = (sortedCats[0][1]/totalExpAll*100);
    statRows.push({label:`Highest Spending — ${sortedCats[0][0]}`, ic:'🔥', pct, valText:pct.toFixed(0)+'%', cls: pct>40?'bad':pct>25?'warn':''});
  }
  if(statWeekendPct!==null && isFinite(statWeekendPct)){
    statRows.push({label:`${statWeekendHigher==='weekend'?'Weekend':'Weekday'} Spending`, ic: statWeekendHigher==='weekend'?'🎉':'💼', pct: Math.min(100,statWeekendPct), valText:(statWeekendPct.toFixed(0)+'% higher'), cls: statWeekendPct>30?'warn':''});
  }
  if(statTopModePct!==null){
    statRows.push({label:`${statTopMode} Usage`, ic:'💳', pct: statTopModePct, valText: statTopModePct.toFixed(0)+'%', cls:''});
  }
  if(statDailyAvg!==null){
    statRows.push({label:'Average Daily Spend', ic:'📆', pct: 50, valText: fmt(statDailyAvg)+'/day', cls:''});
  }
  const statGridHtml = statRows.length ? `<div class="kh-ins-stat-grid" style="margin-bottom:14px;">${statRows.map(s=>`
    <div class="kh-ins-stat-row">
      <div class="kh-ins-stat-top"><div class="kh-ins-stat-name"><span class="ic">${s.ic}</span>${s.label}</div><div class="kh-ins-stat-val">${s.valText}</div></div>
      <div class="kh-ins-stat-bar"><div class="kh-ins-stat-fill ${s.cls}" style="width:${Math.max(4,Math.min(100,s.pct))}%;"></div></div>
    </div>`).join('')}</div>` : '';

  const rendered = items.map(i=>`<div class="insight"><span class="dot ${i.dot}"></span><p>${i.text}</p></div>`);
  if(!rendered.length){
    el.innerHTML = statGridHtml || '<div class="empty-note">Not enough data available yet.</div>';
    return;
  }
  const visibleCount = 4;
  if(rendered.length<=visibleCount){
    el.innerHTML = statGridHtml + rendered.join('');
  } else {
    el.innerHTML = statGridHtml + rendered.slice(0,visibleCount).join('')
      + `<div id="spendingIntelMore" style="display:none;">${rendered.slice(visibleCount).join('')}</div>`
      + `<button class="btn small secondary" id="spendingIntelToggle" style="margin-top:8px;">More (${rendered.length-visibleCount})</button>`;
    document.getElementById('spendingIntelToggle').addEventListener('click', e=>{
      const more = document.getElementById('spendingIntelMore');
      const showing = more.style.display!=='none';
      more.style.display = showing? 'none':'block';
      e.target.textContent = showing? `More (${rendered.length-visibleCount})` : 'Show Less';
    });
  }
}

/* ---------------------------------------------------------------
   CATEGORY TREND
--------------------------------------------------------------- */
const KH_INS_CAT_ICONS = {food:'🍔','food & dining':'🍔',dining:'🍔',groceries:'🛒',travel:'✈️',transport:'🚌',transportation:'🚌',fuel:'⛽',shopping:'🛍️',bills:'📄',utilities:'💡',entertainment:'🎬',health:'❤️',healthcare:'❤️',medical:'❤️',rent:'🏠',education:'🎓',recharge:'📱',subscription:'🔔',investment:'📈',insurance:'🛡️',other:'📦'};
function khCatIcon(cat){ const k=(cat||'').toLowerCase().trim(); return KH_INS_CAT_ICONS[k] || '💳'; }
function renderCategoryTrend(){
  const el = document.getElementById('categoryTrendTable');
  const exp = expenseTxns();
  const thisM = monthKey(todayStr());
  const lastMDate = new Date(); lastMDate.setMonth(lastMDate.getMonth()-1);
  const lastM = monthKey(lastMDate.toISOString().slice(0,10));
  const thisByCat={}, lastByCat={};
  exp.forEach(t=>{
    if(monthKey(t.date)===thisM) thisByCat[t.category]=(thisByCat[t.category]||0)+Number(t.amount);
    if(monthKey(t.date)===lastM) lastByCat[t.category]=(lastByCat[t.category]||0)+Number(t.amount);
  });
  const cats = [...new Set([...Object.keys(thisByCat), ...Object.keys(lastByCat)])];
  if(!cats.length){ el.innerHTML = '<div class="kh-ins-empty">Not enough recorded data yet for a category trend.</div>'; return; }
  const rows = cats.map(c=>({c, cur:thisByCat[c]||0, prev:lastByCat[c]||0}))
    .sort((a,b)=> (b.cur+b.prev) - (a.cur+a.prev))
    .slice(0,8);
  const months6 = monthsRange().slice(-6);
  const palette = [['var(--kh-bd1a)','var(--kh-bd1b)'],['var(--kh-bd2a)','var(--kh-bd2b)'],['var(--kh-bd3a)','var(--kh-bd3b)'],['var(--kh-bd4a)','var(--kh-bd4b)'],['var(--kh-bd5a)','var(--kh-bd5b)'],['var(--kh-bd6a)','var(--kh-bd6b)'],['var(--kh-bd7a)','var(--kh-bd7b)'],['var(--kh-bd8a)','var(--kh-bd8b)']];
  const html = rows.map((r,i)=>{
    const diff = r.cur - r.prev;
    let pctText, cls;
    if(r.prev===0 && r.cur===0){ pctText='—'; cls='flat'; }
    else if(r.prev===0){ pctText='new'; cls='up'; }
    else{
      const pct = (diff/r.prev*100);
      if(!isFinite(pct)){ pctText='—'; cls='flat'; }
      else if(pct>3){ pctText='↑ +'+pct.toFixed(0)+'%'; cls='up'; }
      else if(pct<-3){ pctText='↓ '+pct.toFixed(0)+'%'; cls='down'; }
      else { pctText='→ similar'; cls='flat'; }
    }
    const series = months6.length ? months6.map(m=>sum(exp.filter(t=>t.category===r.c && monthKey(t.date)===m))) : [r.prev,r.cur];
    const [ca,cb] = palette[i%palette.length];
    return `<div class="kh-ins-cat-card" style="--ca:${ca};--cb:${cb};">
      <div class="kh-ins-cat-ic">${khCatIcon(r.c)}</div>
      <div class="kh-ins-cat-name">${r.c}</div>
      <div class="kh-ins-sum-amt" style="font-size:14px;">${fmt(r.cur)}</div>
      ${khSparklineSvg(series).replace('class="kh-spark"','class="kh-spark kh-ins-cat-spark"')}
      <div class="kh-ins-cat-trend ${cls}">${pctText}</div>
    </div>`;
  }).join('');
  el.innerHTML = `<div class="kh-ins-cat-scroll">${html}</div>`;
}

/* ---------------------------------------------------------------
   PREMIUM FINANCIAL SUMMARY (Sprint 34) — 4 hero KPI cards with real
   month-over-month change and a real sparkline (last up to 6 months
   that actually have recorded data). No numbers invented here.
--------------------------------------------------------------- */
function khInsMonthlySeries(months, calc){ return months.map(calc); }
function renderInsightsSummary(){
  const el = document.getElementById('insSummaryGrid');
  const exp = expenseTxns(), inc = incomeTxns();
  if(!exp.length && !inc.length){ el.innerHTML = '<div class="kh-ins-empty" style="grid-column:1/-1;">Not enough data available yet. Add income and expenses to see your summary.</div>'; return; }
  const months = monthsRange().slice(-6);
  const thisM = monthKey(todayStr());
  const lastMDate = new Date(); lastMDate.setMonth(lastMDate.getMonth()-1);
  const lastM = monthKey(lastMDate.toISOString().slice(0,10));

  const incSeries = months.length ? khInsMonthlySeries(months, m=>sum(inc.filter(t=>monthKey(t.date)===m))) : [sum(inc)];
  const expSeries = months.length ? khInsMonthlySeries(months, m=>sum(exp.filter(t=>monthKey(t.date)===m))) : [sum(exp)];
  const savSeries = incSeries.map((v,i)=>v-expSeries[i]);
  const rateSeries = incSeries.map((v,i)=> v>0 ? ((v-expSeries[i])/v*100) : 0);

  const thisInc = sum(inc.filter(t=>monthKey(t.date)===thisM)), lastInc = sum(inc.filter(t=>monthKey(t.date)===lastM));
  const thisExp = sum(exp.filter(t=>monthKey(t.date)===thisM)), lastExp = sum(exp.filter(t=>monthKey(t.date)===lastM));
  const thisSav = thisInc-thisExp, lastSav = lastInc-lastExp;
  const thisRate = thisInc>0 ? (thisSav/thisInc*100) : null, lastRate = lastInc>0 ? (lastSav/lastInc*100) : null;

  const chg = (cur,prev)=>{
    if(prev===null || prev===0) return null;
    return ((cur-prev)/Math.abs(prev))*100;
  };
  const chipHtml = (pct)=> pct===null ? '' : `<span class="kh-ins-sum-chg ${pct>=0?'up':'down'}">${pct>=0?'↑':'↓'} ${Math.abs(pct).toFixed(1)}%</span>`;

  const cards = [
    {label:'Total Income', amt:thisInc, chg:chg(thisInc,lastInc), series:incSeries, ic:'↗', ca:'var(--kh-green)', cb:'#0EA5E9'},
    {label:'Total Expense', amt:thisExp, chg:chg(thisExp,lastExp), series:expSeries, ic:'↘', ca:'var(--kh-red)', cb:'#F97316'},
    {label:'Savings', amt:thisSav, chg:chg(thisSav,lastSav), series:savSeries, ic:'🛡️', ca:'var(--kh-purple)', cb:'var(--kh-purple2)'},
    {label:'Savings Rate', amt:null, rate:thisRate, chg:(thisRate!==null&&lastRate!==null)?(thisRate-lastRate):null, series:rateSeries, ic:'%', ca:'var(--kh-cyan)', cb:'#0891B2'}
  ];
  el.innerHTML = cards.map(c=>`
    <div class="kh-ins-sum-card" style="--ca:${c.ca};--cb:${c.cb};">
      <div class="kh-ins-sum-ic">${c.ic}</div>
      <div class="kh-ins-sum-label">${c.label}</div>
      <div class="kh-ins-sum-amt">${c.amt!==null?fmt(c.amt):(c.rate!==null?c.rate.toFixed(1)+'%':'—')}</div>
      ${c.chg===null?'':chipHtml(c.chg)}
      ${khSparklineSvg(c.series).replace('class="kh-spark"','class="kh-spark kh-ins-sum-spark"')}
    </div>
  `).join('');
}

function renderInsights(){
  renderHealthScore();
  renderInsightsSummary();
  renderWeeklyDigest();
  renderSpendingIntelligence();
  renderMonthOverMonth();
  renderCategoryTrend();
  renderUnusualExpenses();
  renderSmallFrequentExpenses();
  prefillSimulator();
  const analysisEl = document.getElementById('analysisList');
  const recoEl = document.getElementById('recoList');
  const exp = expenseTxns(), inc = incomeTxns();

  if(exp.length===0 && inc.length===0){
    analysisEl.innerHTML = '<div class="empty-note">Not enough data available yet. Add some income and expenses to unlock analysis.</div>';
    recoEl.innerHTML = '<div class="empty-note">Not enough data available yet.</div>';
    return;
  }

  const items = [];
  const totalIncome = sum(inc), totalExpense = sum(exp);
  const net = totalIncome-totalExpense;

  // top category
  const byCat={}; exp.forEach(t=>byCat[t.category]=(byCat[t.category]||0)+Number(t.amount));
  const sortedCats = Object.entries(byCat).sort((a,b)=>b[1]-a[1]);
  if(sortedCats.length){
    items.push({dot:'info', text:`Your highest spending category is <b>${sortedCats[0][0]}</b> at ${fmt(sortedCats[0][1])}${totalExpense? ' ('+(sortedCats[0][1]/totalExpense*100).toFixed(0)+'% of total expenses)':''}.`});
  }

  // budget overspend
  const from = startOfMonth(0), to = endOfMonth(0);
  Object.keys(state.budgets).forEach(c=>{
    const actual = sum(exp.filter(t=>t.category===c && dateInRange(t.date,from,to)));
    const budget = Number(state.budgets[c]);
    if(budget>0 && actual>budget){
      items.push({dot:'bad', text:`You're overspending on <b>${c}</b> — ${fmt(actual)} spent against a budget of ${fmt(budget)} this month.`});
    }
  });

  // savings
  if(totalIncome>0){
    items.push({dot: net>=0?'good':'bad', text:`You've saved <b>${fmt(net)}</b> so far — that's ${(net/totalIncome*100).toFixed(1)}% of income. ${(net/totalIncome*100)<20 && net>0 ? 'A savings rate under 20% leaves little cushion.' : ''}`});
    items.push({dot:'info', text:`${(totalExpense/totalIncome*100).toFixed(1)}% of income has gone to expenses; ${Math.max(0,100-(totalExpense/totalIncome*100)).toFixed(1)}% is being saved.`});
  } else {
    items.push({dot:'warn', text:"No income has been logged yet, so savings rate can't be calculated."});
  }

  // trend: last 7 vs prior 7
  const now = new Date();
  const last7start = new Date(now); last7start.setDate(now.getDate()-6);
  const prev7start = new Date(now); prev7start.setDate(now.getDate()-13);
  const prev7end = new Date(now); prev7end.setDate(now.getDate()-7);
  const last7 = sum(exp.filter(t=> t.date>=last7start.toISOString().slice(0,10)));
  const prev7 = sum(exp.filter(t=> t.date>=prev7start.toISOString().slice(0,10) && t.date<=prev7end.toISOString().slice(0,10)));
  if(prev7>0){
    const change = ((last7-prev7)/prev7*100);
    items.push({dot: change>0?'warn':'good', text:`Spending is ${change>0?'up':'down'} ${Math.abs(change).toFixed(0)}% in the last 7 days versus the 7 days before that.`});
  }

  // category increase month over month
  const thisMonthKey = monthKey(todayStr());
  const lastMonthDate = new Date(); lastMonthDate.setMonth(lastMonthDate.getMonth()-1);
  const lastMonthKey = monthKey(lastMonthDate.toISOString().slice(0,10));
  const thisMonthByCat={}, lastMonthByCat={};
  exp.forEach(t=>{
    if(monthKey(t.date)===thisMonthKey) thisMonthByCat[t.category]=(thisMonthByCat[t.category]||0)+Number(t.amount);
    if(monthKey(t.date)===lastMonthKey) lastMonthByCat[t.category]=(lastMonthByCat[t.category]||0)+Number(t.amount);
  });
  Object.keys(thisMonthByCat).forEach(c=>{
    if(lastMonthByCat[c] && thisMonthByCat[c]>lastMonthByCat[c]){
      const diff = thisMonthByCat[c]-lastMonthByCat[c];
      items.push({dot:'warn', text:`You spent ${fmt(diff)} more on <b>${c}</b> this month than last month.`});
    }
  });

  // unusually high spending days
  const byDay={}; exp.forEach(t=>byDay[t.date]=(byDay[t.date]||0)+Number(t.amount));
  const dayVals = Object.values(byDay);
  if(dayVals.length>=5){
    const mean = dayVals.reduce((a,b)=>a+b,0)/dayVals.length;
    const variance = dayVals.reduce((a,b)=>a+Math.pow(b-mean,2),0)/dayVals.length;
    const sd = Math.sqrt(variance);
    const highDays = Object.entries(byDay).filter(([d,a])=> a > mean+1.5*sd);
    if(highDays.length){
      items.push({dot:'warn', text:`Unusually high spending detected on: ${highDays.map(([d,a])=>d+' ('+fmt(a)+')').join(', ')}.`});
    }
  }

  // anomaly detection: category spend well above its recent monthly average
  anomalyAlerts().forEach(text=> items.push({dot:'warn', text}));

  // spending prediction based on last 3 months trend
  const pred = spendingPrediction();
  if(pred) items.push({dot:'info', text:`Based on your last ${pred.months.length} months (${pred.months.join(', ')}), a reasonable expense forecast for next month is around <b>${fmt(pred.avg)}</b>.`});

  analysisEl.innerHTML = items.map(i=>`<div class="insight"><span class="dot ${i.dot}"></span><p>${i.text}</p></div>`).join('') || '<div class="empty-note">Not enough data available yet.</div>';

  // recommendations — Sprint 34: each is now {title,text,confidence,priority}
  // so the premium swipeable cards can show a confidence % and priority
  // badge. Confidence is a fixed tier per detection rule (how directly the
  // finding is measured from data), not a modeled probability — labeled
  // honestly as such below the card list.
  const recos = [];
  if(sortedCats.length && totalExpense>0){
    const [cat, amt] = sortedCats[0];
    if(amt/totalExpense > 0.3){
      const potential = Math.round(amt*0.15);
      recos.push({title:`Reduce ${cat} Spending`, text:`This makes up over 30% of total expenses. Trimming it by ${fmt(potential)} could meaningfully boost savings.`, confidence:85, priority:'medium', ic:'✂️'});
    }
  }
  Object.keys(state.budgets).forEach(c=>{
    const actual = sum(exp.filter(t=>t.category===c && dateInRange(t.date,from,to)));
    const budget = Number(state.budgets[c]);
    if(budget>0 && actual>budget){
      recos.push({title:`${c} Over Budget`, text:`Reduce spending by ${fmt(actual-budget)} next month to get back within budget.`, confidence:95, priority:'high', ic:'⚠️'});
    }
  });
  Object.keys(thisMonthByCat).forEach(c=>{
    if(lastMonthByCat[c] && thisMonthByCat[c]>lastMonthByCat[c]*1.2){
      recos.push({title:`${c} Trending Up`, text:`Spending here is climbing versus last month — worth checking if it's a one-off or a new habit.`, confidence:75, priority:'medium', ic:'📈'});
    }
  });
  if(totalIncome>0 && net>0 && (net/totalIncome*100)<20){
    recos.push({title:'Increase Savings', text:`You're saving ${(net/totalIncome*100).toFixed(1)}% of income — try to work toward at least 20% for a healthier cushion.`, confidence:80, priority:'medium', ic:'🐷'});
  }
  const efGoalReco = getEmergencyFundGoal && getEmergencyFundGoal();
  if(efGoalReco){
    const shortfall = Math.max(0,(Number(efGoalReco.cost)||0)-(Number(efGoalReco.contributions)||0));
    if(shortfall>0) recos.push({title:'Emergency Fund', text:`Your emergency fund is short by ${fmt(shortfall)}. Even a small monthly contribution keeps it moving.`, confidence:90, priority:'high', ic:'🛟'});
  }
  if(!recos.length){
    recos.push({title:'Keep Logging', text:'Not enough data available yet to generate personalized recommendations. Keep logging transactions daily.', confidence:null, priority:'low', ic:'📝'});
  }
  const recoPalette = [['var(--kh-bd1a)','var(--kh-bd1b)'],['var(--kh-bd2a)','var(--kh-bd2b)'],['var(--kh-bd5a)','var(--kh-bd5b)'],['var(--kh-bd6a)','var(--kh-bd6b)'],['var(--kh-bd3a)','var(--kh-bd3b)']];
  recoEl.innerHTML = `<div class="kh-ins-reco-scroll">${recos.map((r,i)=>{
    const [ca,cb] = recoPalette[i%recoPalette.length];
    return `<div class="kh-ins-reco-card" style="--ca:${ca};--cb:${cb};">
      <div class="kh-ins-reco-ic">${r.ic||'💡'}</div>
      <div class="kh-ins-reco-title">${r.title}</div>
      <div class="kh-ins-reco-txt">${r.text}</div>
      <div class="kh-ins-reco-foot">
        ${r.confidence!=null?`<span class="kh-ins-reco-conf">${r.confidence}% Confidence</span>`:'<span></span>'}
        <span class="kh-ins-reco-badge ${r.priority}">${r.priority}</span>
      </div>
    </div>`;
  }).join('')}</div>`;
}

/* ---------------------------------------------------------------
   ACCOUNTS
--------------------------------------------------------------- */
function renderAccounts(){
  populateAccountSelects();
  const grid = document.getElementById('acctGrid');
  if(!state.accounts.length){ grid.innerHTML='<div class="empty-note">No accounts yet. Add one below.</div>'; }
  else{
    grid.innerHTML = state.accounts.map(a=>{
      const bal = accountBalance(a.id);
      return `<div class="acct-card ${a.active===false?'inactive':''}" data-id="${a.id}">
        <div class="acct-ic">${a.icon||'📦'}</div>
        <div class="acct-name">${a.name}</div>
        <div class="acct-type">${a.type}</div>
        <div class="acct-bal" style="color:${bal<0?'var(--rust)':'var(--teal)'};">${fmt(bal)}</div>
        <div class="acct-actions">
          <button class="btn small secondary toggle-acct">${a.active===false?'Activate':'Deactivate'}</button>
          <button class="btn small rust del-acct">Delete</button>
        </div>
      </div>`;
    }).join('');
    grid.querySelectorAll('.toggle-acct').forEach(b=>b.addEventListener('click', async e=>{
      const id = e.target.closest('.acct-card').dataset.id;
      const a = accountById(id); a.active = a.active===false ? true : false;
      await saveAccounts(); renderAccounts();
    }));
    grid.querySelectorAll('.del-acct').forEach(b=>b.addEventListener('click', async e=>{
      const id = e.target.closest('.acct-card').dataset.id;
      const inUse = state.transactions.some(t=>t.account===id||t.fromAccount===id||t.toAccount===id);
      if(inUse){ alert('This account has transactions linked to it. Deactivate it instead of deleting, to keep your history intact.'); return; }
      if(confirm('Delete this account?')){ state.accounts = state.accounts.filter(a=>a.id!==id); await saveAccounts(); renderAccounts(); }
    }));
  }
  document.getElementById('totalMoneyNote').textContent = `Total money across active accounts: ${fmt(totalMoney())}`;

  const nw = document.getElementById('netWorthKpis');
  const assets = netWorthAssets();
  const liabilities = netWorthLiabilities();
  nw.innerHTML = `
    <div class="kpi income"><div class="kpi-label">Assets (Accounts + Receivables + Investments)</div><div class="kpi-value">${fmt(assets)}</div></div>
    <div class="kpi expense"><div class="kpi-label">Liabilities (Debts + Card Outstanding)</div><div class="kpi-value">${fmt(liabilities)}</div></div>
    <div class="kpi savings"><div class="kpi-label">Net Worth</div><div class="kpi-value">${fmt(assets-liabilities)}</div></div>
  `;
  document.getElementById('tr_date').value = todayStr();
  recordNetWorthSnapshot();
  buildNetWorthTrendChart();
}
document.getElementById('addAccountBtn').addEventListener('click', async ()=>{
  const name = document.getElementById('a_name').value.trim();
  if(!name){ alert('Enter an account name.'); return; }
  state.accounts.push({ id:uid(), name, type: document.getElementById('a_type').value, opening: parseFloat(document.getElementById('a_opening').value)||0, icon: document.getElementById('a_icon').value, active:true });
  await saveAccounts();
  document.getElementById('a_name').value=''; document.getElementById('a_opening').value='0';
  renderAccounts(); populateAccountSelects();
});
document.getElementById('doTransferBtn').addEventListener('click', async ()=>{
  const from = document.getElementById('tr_from').value, to = document.getElementById('tr_to').value;
  const amount = parseFloat(document.getElementById('tr_amount').value);
  if(!amount || amount<=0){ alert('Enter a valid amount.'); return; }
  if(from===to){ alert('Choose two different accounts.'); return; }
  state.transactions.push({ id:uid(), type:'transfer', date: document.getElementById('tr_date').value||todayStr(), fromAccount:from, toAccount:to, amount, notes: document.getElementById('tr_notes').value.trim() });
  await saveTransactions();
  document.getElementById('tr_amount').value=''; document.getElementById('tr_notes').value='';
  renderAccounts(); refreshAllCharts();
});
document.getElementById('a_type').addEventListener('change', e=>{
  document.getElementById('a_icon').value = ACCOUNT_ICONS[e.target.value]||'📦';
});

/* ---------------------------------------------------------------
   NET WORTH / INVESTMENTS INTEGRATION
--------------------------------------------------------------- */
function totalInvestmentValue(){ return (state.investments||[]).reduce((s,i)=>s+(Number(i.currentValue)||0),0); }
function totalInvestedAmount(){ return (state.investments||[]).reduce((s,i)=>s+(Number(i.invested)||0),0); }
function netWorthAssets(){
  const receivable = (state.debts||[]).filter(d=>d.type==='owed_to_me' && !d.settled).reduce((s,d)=>s+Number(d.amount),0);
  return totalMoney() + receivable + totalInvestmentValue();
}
function netWorthLiabilities(){
  const iOwe = (state.debts||[]).filter(d=>d.type==='i_owe' && !d.settled).reduce((s,d)=>s+Number(d.amount),0);
  const ccOutstanding = (state.creditCards||[]).reduce((s,c)=>s+(Number(c.outstanding)||0),0);
  return iOwe + ccOutstanding;
}
function recordNetWorthSnapshot(){
  const m = monthKey(todayStr());
  const assets = netWorthAssets(), liabilities = netWorthLiabilities();
  const netWorth = assets - liabilities;
  const existing = state.netWorthHistory.find(h=>h.month===m);
  if(existing){ existing.totalAssets = assets; existing.totalLiabilities = liabilities; existing.netWorth = netWorth; }
  else { state.netWorthHistory.push({month:m, totalAssets:assets, totalLiabilities:liabilities, netWorth}); }
  state.netWorthHistory.sort((a,b)=> a.month<b.month?-1:1);
  saveNetWorthHistory();
}
function buildNetWorthTrendChart(){
  destroyChart('networth');
  const canvas = document.getElementById('c_networth');
  if(!canvas) return;
  const hist = state.netWorthHistory||[];
  if(!hist.length){ noData('c_networth'); return; }
  const {grid:g,text} = chartTheme();
  charts.networth = new Chart(canvas, {
    type:'line',
    data:{ labels: hist.map(h=>h.month), datasets:[
      {label:'Net Worth', data: hist.map(h=>h.netWorth), borderColor:'#B98A1E', backgroundColor:'#B98A1E22', fill:true, tension:.3},
      {label:'Assets', data: hist.map(h=>h.totalAssets), borderColor:'#0E7C6B', fill:false, tension:.3},
      {label:'Liabilities', data: hist.map(h=>h.totalLiabilities), borderColor:'#B54834', fill:false, tension:.3}
    ]},
    options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:text,boxWidth:10,font:{size:10}}}},scales:{x:{ticks:{color:text},grid:{color:g}},y:{ticks:{color:text},grid:{color:g}}}}
  });
}

/* ---------------------------------------------------------------
   CREDIT CARD MANAGER
--------------------------------------------------------------- */
function ccUtilization(c){ const lim = Number(c.limit)||0; return lim>0 ? (Number(c.outstanding)||0)/lim*100 : 0; }
function ccStatus(c){
  const u = ccUtilization(c);
  if(u>70) return {label:'🔴 Very High', cls:'bad'};
  if(u>=30) return {label:'🟡 High', cls:'warn'};
  return {label:'🟢 Healthy', cls:'good'};
}
function nextOccurrenceOfDay(day){
  if(!day) return null;
  const today = new Date(); const d = Number(day);
  let cand = new Date(today.getFullYear(), today.getMonth(), Math.min(d,28));
  // handle days up to 31 by clamping to actual month length
  const lastDay = new Date(today.getFullYear(), today.getMonth()+1, 0).getDate();
  cand = new Date(today.getFullYear(), today.getMonth(), Math.min(d,lastDay));
  if(cand < new Date(today.toDateString())){
    const nm = new Date(today.getFullYear(), today.getMonth()+1, 1);
    const lastDayNext = new Date(nm.getFullYear(), nm.getMonth()+1, 0).getDate();
    cand = new Date(nm.getFullYear(), nm.getMonth(), Math.min(d,lastDayNext));
  }
  return cand;
}
function ccDueAlert(c){
  if(!c.dueDate) return {text:'No due date set', cls:'info'};
  const due = nextOccurrenceOfDay(c.dueDate);
  const today = new Date(new Date().toDateString());
  const days = Math.round((due-today)/86400000);
  if(days<0) return {text:'🔴 Payment Overdue', cls:'bad'};
  if(days<=5) return {text: days===0? '🟡 Payment Due Soon (Today)' : `🟡 Payment Due Soon — Due in ${days} day(s)`, cls:'warn'};
  return {text:`Due in ${days} day(s)`, cls:'good'};
}
// ESTIMATE: simple monthly interest projection if the outstanding balance is carried forward unpaid.
// Not a substitute for the issuer's actual compounding/statement math — clearly labelled as an estimate wherever shown.
function ccMonthlyInterestEstimate(c){
  const rate = Number(c.interestRate)||0;
  const outstanding = Number(c.outstanding)||0;
  if(rate<=0 || outstanding<=0) return null;
  return outstanding * (rate/100) / 12;
}
// Snapshots each card's utilization once per calendar month so a trend ("up/down vs last month") can be shown.
// Reuses the same monthKey()+history-array pattern as netWorthHistory.
function ccUtilTrendSnapshot(c){
  const m = monthKey(todayStr());
  state.ccUtilHistory[c.id] = state.ccUtilHistory[c.id] || [];
  const hist = state.ccUtilHistory[c.id];
  const util = ccUtilization(c);
  const existing = hist.find(h=>h.month===m);
  if(existing) existing.util = util;
  else hist.push({month:m, util});
  hist.sort((a,b)=> a.month<b.month?-1:1);
  const prev = hist.filter(h=>h.month<m).slice(-1)[0];
  return { prev, current: util };
}
function ccUtilTrendText(c){
  const { prev, current } = ccUtilTrendSnapshot(c);
  if(!prev) return null;
  const diff = current - prev.util;
  if(Math.abs(diff)<0.5) return { text:`Utilization steady around ${current.toFixed(0)}% vs last month.`, dot:'info' };
  const dir = diff>0 ? 'up' : 'down';
  const dot = diff>0 ? 'warn' : 'good';
  return { text:`Utilization ${dir} ${Math.abs(diff).toFixed(0)} pts vs last month (${prev.util.toFixed(0)}% → ${current.toFixed(0)}%).`, dot };
}
function populateCCSelects(){
  const cardOptions = state.creditCards.map(c=>`<option value="${c.id}">${c.name}</option>`).join('');
  ['ccp_card','ccpay_card'].forEach(id=>{ const el=document.getElementById(id); if(el) el.innerHTML = cardOptions || '<option value="">No cards yet</option>'; });
  const ccpCat = document.getElementById('ccp_category');
  if(ccpCat) ccpCat.innerHTML = expenseCats().map(c=>`<option>${c}</option>`).join('');
  const src = document.getElementById('ccpay_source');
  if(src) src.innerHTML = activeAccounts().map(a=>`<option value="${a.id}">${a.name}</option>`).join('') || '<option value="">No accounts yet</option>';
  const afCat = document.getElementById('af_category');
  if(afCat) afCat.innerHTML = expenseCats().map(c=>`<option>${c}</option>`).join('');
}
function renderCreditCards(){
  populateCCSelects();
  document.getElementById('ccp_date') && (document.getElementById('ccp_date').value = document.getElementById('ccp_date').value || todayStr());
  document.getElementById('ccpay_date') && (document.getElementById('ccpay_date').value = document.getElementById('ccpay_date').value || todayStr());
  const cards = state.creditCards||[];
  const kpis = document.getElementById('ccKpis');
  if(!cards.length){
    kpis.innerHTML = '<div class="empty-note">Not enough recorded data yet. Add a credit card below.</div>';
  } else {
    const totalLimit = cards.reduce((s,c)=>s+(Number(c.limit)||0),0);
    const totalOutstanding = cards.reduce((s,c)=>s+(Number(c.outstanding)||0),0);
    const totalAvailable = totalLimit-totalOutstanding;
    const overallUtil = totalLimit? (totalOutstanding/totalLimit*100):0;
    kpis.innerHTML = `
      <div class="kpi"><div class="kpi-label">Total Credit Limit</div><div class="kpi-value">${fmt(totalLimit)}</div></div>
      <div class="kpi expense"><div class="kpi-label">Total Outstanding</div><div class="kpi-value">${fmt(totalOutstanding)}</div></div>
      <div class="kpi income"><div class="kpi-label">Available Credit</div><div class="kpi-value">${fmt(totalAvailable)}</div></div>
      <div class="kpi savings"><div class="kpi-label">Overall Utilization</div><div class="kpi-value">${totalLimit?overallUtil.toFixed(1)+'%':'—'}</div></div>
    `;
  }
  const grid = document.getElementById('ccGrid');
  if(!cards.length){ grid.innerHTML=''; }
  else{
    grid.innerHTML = cards.map(c=>{
      const util = ccUtilization(c);
      const status = ccStatus(c);
      const alert = ccDueAlert(c);
      const avail = (Number(c.limit)||0) - (Number(c.outstanding)||0);
      const interestEst = ccMonthlyInterestEstimate(c);
      const trend = ccUtilTrendText(c);
      const payments = (c.payments||[]).slice().sort((a,b)=> a.date<b.date?1:-1);
      const histRows = payments.length ? payments.map(p=>{
        const acct = accountById(p.source);
        return `<div class="cc-hist-row"><span>${p.date}${acct? ' · '+acct.name : ''}</span><span>${fmt(p.amount)}</span></div>`;
      }).join('') : '<div class="empty-note" style="font-size:11.5px;">No payments logged yet.</div>';
      return `<div class="acct-card" data-id="${c.id}">
        <div class="acct-ic">💳</div>
        <div class="acct-name">${c.name}</div>
        <span class="status-pill ${status.cls}">${status.label}</span>
        <div class="acct-bal" style="color:${util>70?'var(--rust)':'var(--ink)'};">${fmt(c.outstanding)} <span style="font-size:11px;color:var(--ink-soft);font-weight:400;">/ ${fmt(c.limit)}</span></div>
        <div class="bar-track" style="margin-top:6px;"><div class="bar-fill ${util>70?'over':util>=30?'warn':''}" style="width:${Math.min(100,util)}%;"></div></div>
        <div class="cc-row"><span>Available: ${fmt(avail)}</span><span>${util.toFixed(0)}% used</span></div>
        <div class="cc-row"><span class="status-pill ${alert.cls}">${alert.text}</span></div>
        ${c.minDue? `<div class="cc-row"><span>Min Due: ${fmt(c.minDue)}</span><span>Total Due: ${fmt(c.totalDue||0)}</span></div>`:''}
        ${Number(c.interestRate)>0? `<div class="cc-row"><span>Interest Rate</span><span>${c.interestRate}% APR</span></div>`:''}
        ${c.notes? `<div class="cc-row">${c.notes}</div>`:''}
        ${trend? `<div class="cc-estimate">📈 ${trend.text}</div>`:''}
        ${interestEst!==null? `<div class="cc-estimate">⚠️ ESTIMATE: carrying this balance unpaid for a month could add ~${fmt(interestEst)} in interest.</div>`:''}
        <div class="acct-actions">
          <button class="btn small secondary log-cc-payment">Log Payment</button>
          <button class="btn small rust del-cc">Delete</button>
        </div>
        <button class="cc-toggle-link toggle-cc-history">Payment history (${payments.length}) ▾</button>
        <div class="cc-history">${histRows}</div>
      </div>`;
    }).join('');
    saveCCUtilHistory();
    grid.querySelectorAll('.del-cc').forEach(b=>b.addEventListener('click', async e=>{
      const id = e.target.closest('.acct-card').dataset.id;
      if(confirm('Delete this credit card? This does not delete past purchase/payment transactions.')){
        state.creditCards = state.creditCards.filter(c=>c.id!==id);
        await saveCreditCards(); renderCreditCards();
      }
    }));
    grid.querySelectorAll('.toggle-cc-history').forEach(b=>b.addEventListener('click', e=>{
      const card = e.target.closest('.acct-card');
      const panel = card.querySelector('.cc-history');
      panel.classList.toggle('open');
      e.target.textContent = e.target.textContent.replace(/[▾▴]/, panel.classList.contains('open')?'▴':'▾');
    }));
    grid.querySelectorAll('.log-cc-payment').forEach(b=>b.addEventListener('click', e=>{
      const id = e.target.closest('.acct-card').dataset.id;
      const sel = document.getElementById('ccpay_card');
      if(sel) sel.value = id;
      document.getElementById('ccpay_amount')?.scrollIntoView({behavior:'smooth', block:'center'});
      document.getElementById('ccpay_amount')?.focus();
    }));
  }
}
document.getElementById('addCreditCardBtn').addEventListener('click', async ()=>{
  const name = document.getElementById('ccard_name').value.trim();
  if(!name){ alert('Enter a card name.'); return; }
  state.creditCards.push({
    id:uid(), name,
    limit: parseFloat(document.getElementById('ccard_limit').value)||0,
    outstanding: parseFloat(document.getElementById('ccard_outstanding').value)||0,
    billingDate: parseInt(document.getElementById('ccard_billingday').value)||null,
    dueDate: parseInt(document.getElementById('ccard_dueday').value)||null,
    minDue: parseFloat(document.getElementById('ccard_mindue').value)||0,
    totalDue: parseFloat(document.getElementById('ccard_totaldue').value)||0,
    interestRate: parseFloat(document.getElementById('ccard_intrate').value)||0,
    notes: document.getElementById('ccard_notes').value.trim(),
    payments: []
  });
  await saveCreditCards();
  ['ccard_name','ccard_limit','ccard_outstanding','ccard_billingday','ccard_dueday','ccard_mindue','ccard_totaldue','ccard_intrate','ccard_notes'].forEach(id=>document.getElementById(id).value='');
  renderCreditCards();
});
document.getElementById('ccPurchaseBtn').addEventListener('click', async ()=>{
  const cardId = document.getElementById('ccp_card').value;
  const amount = parseFloat(document.getElementById('ccp_amount').value);
  const card = state.creditCards.find(c=>c.id===cardId);
  if(!card){ alert('Add a credit card first.'); return; }
  if(!amount || amount<=0){ alert('Enter a valid amount.'); return; }
  card.outstanding = (Number(card.outstanding)||0) + amount;
  await saveCreditCards();
  state.transactions.push({
    id:uid(), type:'expense', date: document.getElementById('ccp_date').value||todayStr(),
    category: document.getElementById('ccp_category').value||'Other', item: document.getElementById('ccp_item').value.trim(),
    amount, mode:'Card', notes:`Credit card purchase — ${card.name}`, creditCard: card.id, tags:[]
  });
  await saveTransactions();
  document.getElementById('ccp_amount').value=''; document.getElementById('ccp_item').value='';
  renderCreditCards(); refreshAllCharts();
});
document.getElementById('ccPaymentBtn').addEventListener('click', async ()=>{
  const cardId = document.getElementById('ccpay_card').value;
  const amount = parseFloat(document.getElementById('ccpay_amount').value);
  const sourceId = document.getElementById('ccpay_source').value;
  const card = state.creditCards.find(c=>c.id===cardId);
  if(!card){ alert('Add a credit card first.'); return; }
  if(!amount || amount<=0){ alert('Enter a valid amount.'); return; }
  if(!sourceId){ alert('Add a bank/cash account first.'); return; }
  card.outstanding = Math.max(0, (Number(card.outstanding)||0) - amount);
  card.payments = card.payments||[];
  card.payments.push({date: document.getElementById('ccpay_date').value||todayStr(), amount, source: sourceId});
  await saveCreditCards();
  // Transfer/settlement — deducts from source account, never counted as an expense
  state.transactions.push({
    id:uid(), type:'transfer', date: document.getElementById('ccpay_date').value||todayStr(),
    fromAccount: sourceId, toAccount: null, amount, notes:`Credit card bill payment — ${card.name}`
  });
  await saveTransactions();
  document.getElementById('ccpay_amount').value='';
  renderCreditCards(); renderAccounts(); refreshAllCharts();
});

/* ---------------------------------------------------------------
   INVESTMENT TRACKER
--------------------------------------------------------------- */
function renderInvestments(){
  const invs = state.investments||[];
  const kpis = document.getElementById('invKpis');
  const totalInvested = totalInvestedAmount(), totalCurrent = totalInvestmentValue();
  const pl = totalCurrent-totalInvested;
  const retPct = totalInvested? (pl/totalInvested*100):0;
  if(!invs.length){
    kpis.innerHTML = '<div class="empty-note">Not enough recorded data yet. Add an investment below.</div>';
  } else {
    kpis.innerHTML = `
      <div class="kpi"><div class="kpi-label">Total Invested</div><div class="kpi-value">${fmt(totalInvested)}</div></div>
      <div class="kpi income"><div class="kpi-label">Total Current Value</div><div class="kpi-value">${fmt(totalCurrent)}</div></div>
      <div class="kpi ${pl>=0?'savings':'expense'}"><div class="kpi-label">Net Profit / Loss</div><div class="kpi-value" style="color:${pl>=0?'var(--teal)':'var(--rust)'};">${fmt(pl)}</div></div>
      <div class="kpi"><div class="kpi-label">Overall Return</div><div class="kpi-value" style="color:${retPct>=0?'var(--teal)':'var(--rust)'};">${totalInvested?retPct.toFixed(1)+'%':'—'}</div></div>
    `;
  }
  destroyChart('invtype');
  const byType={}; invs.forEach(i=>byType[i.type]=(byType[i.type]||0)+(Number(i.currentValue)||0));
  if(Object.keys(byType).length){
    const {text} = chartTheme();
    charts.invtype = new Chart(document.getElementById('c_invtype'), {
      type:'doughnut',
      data:{labels:Object.keys(byType), datasets:[{data:Object.values(byType), backgroundColor:palette(Object.keys(byType).length)}]},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:text,boxWidth:10,font:{size:10}}}}}
    });
  } else noData('c_invtype');
  const list = document.getElementById('invList');
  if(!invs.length){ list.innerHTML = '<div class="empty-note">Not enough recorded data yet.</div>'; return; }
  list.innerHTML = `<div class="table-wrap"><table><thead><tr><th>Name</th><th>Type</th><th>Invested</th><th>Current Value</th><th>P/L</th><th>Return %</th><th>Purchase Date</th><th></th></tr></thead><tbody>${
    invs.map(i=>{
      const p = (Number(i.currentValue)||0)-(Number(i.invested)||0);
      const r = i.invested? (p/i.invested*100):0;
      return `<tr data-id="${i.id}"><td>${i.name}</td><td>${i.type}</td><td>${fmt(i.invested)}</td><td>${fmt(i.currentValue)}</td><td style="color:${p>=0?'var(--teal)':'var(--rust)'};">${fmt(p)}</td><td style="color:${p>=0?'var(--teal)':'var(--rust)'};">${i.invested?r.toFixed(1)+'%':'—'}</td><td>${i.purchaseDate||'—'}</td><td><button class="btn small secondary div-inv" title="Record a dividend/interest payout">+₹</button> <button class="btn small rust del-inv">✕</button></td></tr>`;
    }).join('')
  }</tbody></table></div>`;
  list.querySelectorAll('.del-inv').forEach(b=>b.addEventListener('click', async e=>{
    const id = e.target.closest('tr').dataset.id;
    if(confirm('Delete this investment record?')){
      state.investments = state.investments.filter(i=>i.id!==id);
      await saveInvestments(); renderInvestments(); recordNetWorthSnapshot();
    }
  }));
  // Sprint 22 — App.Investment: quick "+ Dividend" action per row, additive
  // next to the existing delete button above (doesn't touch that handler).
  list.querySelectorAll('.div-inv').forEach(b=>b.addEventListener('click', async e=>{
    const id = e.target.closest('tr').dataset.id;
    const amt = parseFloat(prompt('Dividend/interest received (₹):','0'));
    if(!amt || amt<=0) return;
    App.Investment.Manager.addDividend(id, amt, todayStr());
    await saveInvestments(); renderInvestments();
  }));
  // Sprint 22 — App.Investment: everything below this line is additive and
  // wrapped in its own try/catch so a failure here can never break the
  // original investments list/chart/KPIs above.
  try{ App.Investment.Manager.recordSnapshot(); }catch(err){ App.Logger.error('App.Investment.Manager.recordSnapshot failed', err); }
  try{ App.Investment.UI.render(); }catch(err){ App.Logger.error('App.Investment.UI.render failed', err); }
}
document.getElementById('addInvestmentBtn').addEventListener('click', async ()=>{
  const name = document.getElementById('i_name').value.trim();
  const invested = parseFloat(document.getElementById('i_invested').value);
  if(!name){ alert('Enter an investment name.'); return; }
  if(!invested || invested<0){ alert('Enter a valid invested amount.'); return; }
  const record = {
    id:uid(), name, type: document.getElementById('i_type').value,
    invested, currentValue: parseFloat(document.getElementById('i_current').value)||invested,
    purchaseDate: document.getElementById('i_date').value||todayStr(),
    notes: document.getElementById('i_notes').value.trim()
  };
  // Sprint 22 — App.Investment: optional advanced fields from the <details>
  // block above. Every one is left off the record entirely when blank, so
  // records made this way are identical in shape to pre-Sprint-22 records.
  const units = parseFloat(document.getElementById('i_units').value);
  const price = parseFloat(document.getElementById('i_price').value);
  const risk = document.getElementById('i_risk').value;
  const goalId = document.getElementById('i_goal').value;
  if(units>0) record.units = units;
  if(price>0) record.pricePerUnit = price;
  if(risk) record.riskOverride = Number(risk);
  if(goalId) record.goalId = goalId;
  state.investments.push(record);
  await saveInvestments();
  ['i_name','i_invested','i_current','i_notes','i_units','i_price'].forEach(id=>document.getElementById(id).value='');
  document.getElementById('i_risk').value=''; document.getElementById('i_goal').value='';
  renderInvestments(); recordNetWorthSnapshot();
});

/* ---------------------------------------------------------------
   RECURRING TRANSACTIONS
--------------------------------------------------------------- */
function computeNextDate(start, frequency){
  const d = new Date(start);
  if(frequency==='daily') d.setDate(d.getDate()+1);
  else if(frequency==='weekly') d.setDate(d.getDate()+7);
  else if(frequency==='monthly') d.setMonth(d.getMonth()+1);
  else if(frequency==='yearly') d.setFullYear(d.getFullYear()+1);
  return d.toISOString().slice(0,10);
}
function processDueRecurring(){
  const today = todayStr();
  let changed=false;
  (state.recurring||[]).forEach(r=>{
    if(r.active===false) return;
    if(r.end && r.nextDate>r.end) return;
    let guard=0;
    while(r.nextDate && r.nextDate<=today && guard<500){
      // avoid duplicate: only push if no txn already logged for this recurring id + date
      const already = state.transactions.some(t=>t.recurringId===r.id && t.date===r.nextDate);
      if(!already){
        state.transactions.push({ id:uid(), recurringId:r.id, type:r.type, date:r.nextDate, time:'', category:r.category, subcategory:'', item:r.name, amount:Number(r.amount), account:r.account, mode:'Other', notes:'Auto-added from recurring: '+r.name, tags:[] });
        changed=true;
      }
      r.nextDate = computeNextDate(r.nextDate, r.frequency);
      guard++;
      if(r.end && r.nextDate>r.end) break;
    }
  });
  if(changed){ saveTransactions(); saveRecurring(); }
}
function computeUpcomingCommitmentsItems(days){
  const from = todayStr();
  const toDate = new Date(); toDate.setDate(toDate.getDate()+(days||90));
  const to = toDate.toISOString().slice(0,10);

  const items = [];

  recurringOccurrencesInRange(from, to).forEach(o=>{
    items.push({ date:o.date, name:o.name, amount:o.amount, kind: o.type==='income'?'Recurring Income':'Recurring Expense', sign: o.type==='income'?'+':'-' });
  });

  upcomingCardDuesInRange(from, to).forEach(c=>{
    items.push({ date:c.date, name:c.name, amount:c.amount, kind:'Credit Card Due', sign:'-' });
  });

  // goal target dates — an actual date the user set, not a fabricated contribution schedule
  state.goals.filter(g=>!g.isEmergencyFund && !g.achieved && !g.paused && g.targetDate && g.targetDate>=from && g.targetDate<=to).forEach(g=>{
    const saved = sum(g.contributions||[]);
    const remaining = Math.max(0, Number(g.cost)-saved);
    items.push({ date:g.targetDate, name:`${g.name} — target date`, amount:remaining, kind:'Goal Target', sign: remaining>0?'~':'✓' });
  });

  items.sort((a,b)=> a.date<b.date?-1:a.date>b.date?1:0);
  return items;
}
function renderUpcomingCommitments(){
  const top = computeUpcomingCommitmentsItems(90).slice(0,10);

  document.getElementById('upcomingList').innerHTML = top.length ? top.map(it=>{
    const daysAway = daysBetween(todayStr(), it.date)-1;
    return `<div class="upcoming-item"><div><div class="recur-name">${it.name}</div><div class="recur-meta">${it.kind} · ${daysAway<=0?'today':'in '+daysAway+' day(s)'} (${it.date})</div></div><div style="font-family:var(--font-mono);font-weight:700;">${it.sign==='~'?'~':it.sign==='✓'?'':it.sign}${fmt(it.amount)}</div></div>`;
  }).join('') : '<div class="empty-note">Nothing upcoming — add recurring transactions, credit cards, or goal target dates to see commitments here.</div>';
}
function renderRecurring(){
  processDueRecurring();
  const catSel = document.getElementById('r_category');
  document.getElementById('r_type').onchange = ()=>{
    catSel.innerHTML = (document.getElementById('r_type').value==='income'?incomeSources():expenseCats()).map(c=>`<option>${c}</option>`).join('');
  };
  catSel.innerHTML = expenseCats().map(c=>`<option>${c}</option>`).join('');
  populateAccountSelects();
  document.getElementById('r_start').value = document.getElementById('r_start').value || todayStr();

  renderUpcomingCommitments();

  const list = document.getElementById('recurringList');
  list.innerHTML = (state.recurring||[]).length ? state.recurring.map(r=>`
    <div class="recur-row" data-id="${r.id}">
      <div><div class="recur-name">${r.name} ${r.active===false?'<span class="chip">Paused</span>':''}</div><div class="recur-meta">${fmt(r.amount)} · ${r.category} · ${r.frequency} · next ${r.nextDate}</div></div>
      <div class="tbl-actions">
        <button class="btn small secondary toggle-r">${r.active===false?'Resume':'Pause'}</button>
        <button class="btn small secondary skip-r">Skip Next</button>
        <button class="btn small rust del-r">Delete</button>
      </div>
    </div>
  `).join('') : '<div class="empty-note">No recurring transactions yet.</div>';
  list.querySelectorAll('.toggle-r').forEach(b=>b.addEventListener('click', async e=>{
    const id=e.target.closest('.recur-row').dataset.id; const r=state.recurring.find(x=>x.id===id); r.active = r.active===false?true:false; await saveRecurring(); renderRecurring();
  }));
  list.querySelectorAll('.skip-r').forEach(b=>b.addEventListener('click', async e=>{
    const id=e.target.closest('.recur-row').dataset.id; const r=state.recurring.find(x=>x.id===id); r.nextDate = computeNextDate(r.nextDate, r.frequency); await saveRecurring(); renderRecurring();
  }));
  list.querySelectorAll('.del-r').forEach(b=>b.addEventListener('click', async e=>{
    const id=e.target.closest('.recur-row').dataset.id;
    if(confirm('Delete this recurring transaction? Past auto-added entries stay in your transactions.')){ state.recurring = state.recurring.filter(x=>x.id!==id); await saveRecurring(); renderRecurring(); }
  }));
}
document.getElementById('addRecurringBtn').addEventListener('click', async ()=>{
  const name = document.getElementById('r_name').value.trim();
  const amount = parseFloat(document.getElementById('r_amount').value);
  const start = document.getElementById('r_start').value || todayStr();
  if(!name || !amount || amount<=0){ alert('Enter a name and valid amount.'); return; }
  const dupe = state.recurring.some(r=>r.name.toLowerCase()===name.toLowerCase() && r.active!==false);
  if(dupe && !confirm('A recurring transaction with this name is already active. Add another anyway?')) return;
  state.recurring.push({
    id: uid(), name, type: document.getElementById('r_type').value, amount,
    category: document.getElementById('r_category').value, account: document.getElementById('r_account').value,
    frequency: document.getElementById('r_frequency').value, start, nextDate: start,
    end: document.getElementById('r_end').value || null, active:true
  });
  await saveRecurring();
  ['r_name','r_amount','r_end'].forEach(id=>document.getElementById(id).value='');
  renderRecurring();
});

/* ---------------------------------------------------------------
   CATEGORIES & TAGS VIEW
--------------------------------------------------------------- */
function renderCategoriesView(){
  document.getElementById('catManagerExpense').innerHTML = expenseCats().map(c=>{
    const isCustomCat = state.customExpenseCats.includes(c);
    const subcats = subcatsFor(c);
    const customSubForThis = (state.customSubcats && state.customSubcats[c]) || [];
    return `<div class="cat-block" data-cat="${c}">
      <b>${c}</b>${isCustomCat?' <span class="chip">custom</span>':''}${isCustomCat?`<button class="cat-x del-cat" data-cat="${c}" title="Delete category">✕</button>`:''}
      <div class="subcat-list">${
        subcats.length ? subcats.map(s=>{
          const removable = customSubForThis.includes(s);
          return removable
            ? `<span class="subcat-pill removable">${s}<button class="pill-x del-subcat" data-cat="${c}" data-sub="${s}" title="Delete subcategory">✕</button></span>`
            : `<span class="subcat-pill">${s}</span>`;
        }).join('') : '<span class="card-note">No subcategories yet</span>'
      }</div>
    </div>`;
  }).join('');
  document.getElementById('catManagerExpense').querySelectorAll('.del-cat').forEach(b=>{
    b.addEventListener('click', async e=>{
      const cat = e.target.dataset.cat;
      const inUse = state.transactions.some(t=>t.category===cat);
      const msg = inUse
        ? `"${cat}" is used in existing transactions. They'll keep showing "${cat}" as text, but it will no longer appear in dropdowns. Delete anyway?`
        : `Delete custom category "${cat}"?`;
      if(!confirm(msg)) return;
      state.customExpenseCats = state.customExpenseCats.filter(c=>c!==cat);
      if(state.customSubcats[cat]) delete state.customSubcats[cat];
      delete state.budgets[cat];
      await saveCustomCats(); await saveSubcats(); await saveBudgets();
      renderCategoriesView(); populateCategorySelect(); populateFilterCategories(); populateBudgetCategorySelect(); populateSubcatParentSelect();
    });
  });
  document.getElementById('catManagerExpense').querySelectorAll('.del-subcat').forEach(b=>{
    b.addEventListener('click', async e=>{
      const cat = e.target.dataset.cat, sub = e.target.dataset.sub;
      if(!confirm(`Delete subcategory "${sub}" under "${cat}"?`)) return;
      state.customSubcats[cat] = (state.customSubcats[cat]||[]).filter(s=>s!==sub);
      await saveSubcats();
      renderCategoriesView(); populateSubcatSelect();
    });
  });

  document.getElementById('catManagerIncome').innerHTML = incomeSources().map(c=>{
    const isCustom = state.customIncomeSources.includes(c);
    return `<div class="cat-block" data-cat="${c}"><b>${c}</b>${isCustom?' <span class="chip">custom</span>':''}${isCustom?`<button class="cat-x del-inccat" data-cat="${c}" title="Delete income source">✕</button>`:''}</div>`;
  }).join('');
  document.getElementById('catManagerIncome').querySelectorAll('.del-inccat').forEach(b=>{
    b.addEventListener('click', async e=>{
      const cat = e.target.dataset.cat;
      const inUse = state.transactions.some(t=>t.category===cat);
      const msg = inUse
        ? `"${cat}" is used in existing transactions. They'll keep showing "${cat}" as text, but it will no longer appear in dropdowns. Delete anyway?`
        : `Delete custom income source "${cat}"?`;
      if(!confirm(msg)) return;
      state.customIncomeSources = state.customIncomeSources.filter(c=>c!==cat);
      await saveCustomCats();
      renderCategoriesView(); populateCategorySelect(); populateFilterCategories();
    });
  });

  document.getElementById('tagManagerList').innerHTML = allTags().length ? allTags().map(t=>`<span class="subcat-pill">${t}</span>`).join('') : '<div class="empty-note">No tags used yet. Add tags on the Add Entry screen.</div>';
}

/* ---------------------------------------------------------------
   DEBTS & LOANS
--------------------------------------------------------------- */
function debtPaid(d){ return (d.payments||[]).reduce((s,p)=>s+(Number(p.amount)||0),0); }
function debtRemaining(d){ return Math.max(0, Number(d.amount||0) - debtPaid(d)); }
function debtStatus(d){
  if(d.settled) return {label:'✅ Settled', cls:'good'};
  const remaining = debtRemaining(d);
  const pctPaid = Number(d.amount)>0 ? (debtPaid(d)/Number(d.amount)*100) : 0;
  if(pctPaid>0) return {label:`🟡 Partially Paid (${pctPaid.toFixed(0)}%)`, cls:'warn'};
  return {label: d.type==='owed_to_me'?'Owed to you':'You owe', cls: remaining>0 ? 'bad':'good'};
}
function debtDueAlert(d){
  if(d.settled || !d.due) return null;
  const due = new Date(d.due); const today = new Date(new Date().toDateString());
  const days = Math.round((due-today)/86400000);
  if(days<0) return {text:'🔴 Overdue', cls:'bad'};
  if(days<=5) return {text: days===0? '🟡 Due Today' : `🟡 Due in ${days} day(s)`, cls:'warn'};
  return {text:`Due in ${days} day(s)`, cls:'good'};
}
// ESTIMATE: simple monthly interest projection on the remaining balance, not compounded issuer/lender math.
function debtInterestEstimate(d){
  const rate = Number(d.interest)||0;
  const remaining = debtRemaining(d);
  if(rate<=0 || remaining<=0 || d.settled) return null;
  return remaining * (rate/100) / 12;
}
function populateDebtSelects(){
  const active = (state.debts||[]).filter(d=>!d.settled);
  const opts = active.map(d=>`<option value="${d.id}">${d.person} — ${d.type==='owed_to_me'?'owes you':'you owe'} ${fmt(debtRemaining(d))}</option>`).join('');
  const sel = document.getElementById('dpay_debt');
  if(sel) sel.innerHTML = opts || '<option value="">No open debts/loans</option>';
  const acct = document.getElementById('dpay_account');
  if(acct) acct.innerHTML = '<option value="">— none / cash off-book —</option>' + activeAccounts().map(a=>`<option value="${a.id}">${a.name}</option>`).join('');
}
function renderDebts(){
  const debts = state.debts||[];
  const owedToMe = debts.filter(d=>d.type==='owed_to_me' && !d.settled).reduce((s,d)=>s+debtRemaining(d),0);
  const iOwe = debts.filter(d=>d.type==='i_owe' && !d.settled).reduce((s,d)=>s+debtRemaining(d),0);
  document.getElementById('debtKpis').innerHTML = `
    <div class="kpi income"><div class="kpi-label">Owed To Me</div><div class="kpi-value">${fmt(owedToMe)}</div></div>
    <div class="kpi expense"><div class="kpi-label">I Owe</div><div class="kpi-value">${fmt(iOwe)}</div></div>
    <div class="kpi savings"><div class="kpi-label">Net Position</div><div class="kpi-value">${fmt(owedToMe-iOwe)}</div></div>
  `;
  const list = document.getElementById('debtsList');
  list.innerHTML = debts.length ? debts.map(d=>{
    const status = debtStatus(d);
    const alert = debtDueAlert(d);
    const paid = debtPaid(d);
    const remaining = debtRemaining(d);
    const interestEst = debtInterestEstimate(d);
    const payments = (d.payments||[]).slice().sort((a,b)=> a.date<b.date?1:-1);
    const histRows = payments.length ? payments.map(p=>{
      const acct = accountById(p.account);
      return `<div class="cc-hist-row"><span>${p.date}${acct? ' · '+acct.name : ' · cash/off-book'}</span><span>${fmt(p.amount)}</span></div>`;
    }).join('') : '<div class="empty-note" style="font-size:11.5px;">No payments logged yet.</div>';
    return `<div class="recur-row" data-id="${d.id}" style="flex-direction:column;align-items:stretch;">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:8px;">
        <div><div class="recur-name">${d.person} <span class="status-pill ${status.cls}">${status.label}</span></div>
        <div class="recur-meta">${d.type==='owed_to_me'?'Owes you':'You owe'} ${fmt(d.amount)} total${d.interest?' · '+d.interest+'% interest':''}${d.due?' · due '+d.due:''}</div>
        ${!d.settled? `<div class="recur-meta">Paid so far: ${fmt(paid)} · Remaining: <b>${fmt(remaining)}</b></div>`:''}
        ${alert? `<div style="margin-top:4px;"><span class="status-pill ${alert.cls}">${alert.text}</span></div>`:''}
        ${interestEst!==null? `<div class="cc-estimate">⚠️ ESTIMATE: ~${fmt(interestEst)}/month in interest if left unpaid.</div>`:''}
        </div>
        <div class="tbl-actions">
          ${!d.settled?'<button class="btn small secondary settle-d">Mark Settled</button>':''}
          <button class="btn small rust del-d">Delete</button>
        </div>
      </div>
      <button class="cc-toggle-link toggle-cc-history">Payment history (${payments.length}) ▾</button>
      <div class="cc-history">${histRows}</div>
    </div>`;
  }).join('') : '<div class="empty-note">No debts or loans recorded yet.</div>';
  list.querySelectorAll('.settle-d').forEach(b=>b.addEventListener('click', async e=>{
    const id = e.target.closest('.recur-row').dataset.id; state.debts.find(d=>d.id===id).settled=true; await saveDebts(); renderDebts();
  }));
  list.querySelectorAll('.del-d').forEach(b=>b.addEventListener('click', async e=>{
    const id = e.target.closest('.recur-row').dataset.id;
    if(confirm('Delete this record?')){ state.debts = state.debts.filter(d=>d.id!==id); await saveDebts(); renderDebts(); }
  }));
  list.querySelectorAll('.toggle-cc-history').forEach(b=>b.addEventListener('click', e=>{
    const row = e.target.closest('.recur-row');
    const panel = row.querySelector('.cc-history');
    panel.classList.toggle('open');
    e.target.textContent = e.target.textContent.replace(/[▾▴]/, panel.classList.contains('open')?'▴':'▾');
  }));
  document.getElementById('d_date').value = document.getElementById('d_date').value || todayStr();
  document.getElementById('dpay_date') && (document.getElementById('dpay_date').value = document.getElementById('dpay_date').value || todayStr());
  populateDebtSelects();
}
document.getElementById('addDebtBtn').addEventListener('click', async ()=>{
  const person = document.getElementById('d_person').value.trim();
  const amount = parseFloat(document.getElementById('d_amount').value);
  if(!person || !amount || amount<=0){ alert('Enter a person/institution and a valid amount.'); return; }
  state.debts.push({
    id:uid(), type: document.getElementById('d_type').value, person, amount,
    interest: parseFloat(document.getElementById('d_interest').value)||0,
    date: document.getElementById('d_date').value||todayStr(), due: document.getElementById('d_due').value||null,
    settled:false, payments:[]
  });
  await saveDebts();
  ['d_person','d_amount','d_interest','d_due'].forEach(id=>document.getElementById(id).value='');
  renderDebts();
});
document.getElementById('dpayBtn').addEventListener('click', async ()=>{
  const debtId = document.getElementById('dpay_debt').value;
  const amount = parseFloat(document.getElementById('dpay_amount').value);
  const accountId = document.getElementById('dpay_account').value || null;
  const debt = state.debts.find(d=>d.id===debtId);
  if(!debt){ alert('Add a debt/loan first.'); return; }
  if(!amount || amount<=0){ alert('Enter a valid amount.'); return; }
  const date = document.getElementById('dpay_date').value||todayStr();
  debt.payments = debt.payments||[];
  debt.payments.push({date, amount, account: accountId});
  if(debtRemaining(debt)<=0) debt.settled = true;
  await saveDebts();
  // Optional transfer: money leaving an account when I pay down what I owe, or arriving when someone repays me.
  // Never counted as an income/expense — mirrors the credit card bill-payment pattern.
  if(accountId){
    state.transactions.push({
      id:uid(), type:'transfer', date,
      fromAccount: debt.type==='i_owe' ? accountId : null,
      toAccount: debt.type==='owed_to_me' ? accountId : null,
      amount, notes:`Debt payment — ${debt.person}`
    });
    await saveTransactions();
  }
  document.getElementById('dpay_amount').value='';
  renderDebts(); renderAccounts(); refreshAllCharts();
});

/* ---------------------------------------------------------------
   CASH FLOW FORECAST
--------------------------------------------------------------- */
let forecastDays = 7;
function upcomingCardDuesInRange(from, to){
  // Approximate each card's next due-date occurrence as a single upcoming outflow of its Total Due (or outstanding if no total due set)
  return (state.creditCards||[]).map(c=>{
    if(!c.dueDate) return null;
    const due = nextOccurrenceOfDay(c.dueDate);
    const dueStr = due.toISOString().slice(0,10);
    if(dueStr>=from && dueStr<=to){
      return { name:`${c.name} bill due`, amount: Number(c.totalDue)>0? Number(c.totalDue) : Number(c.outstanding)||0, date: dueStr };
    }
    return null;
  }).filter(Boolean);
}
function recurringOccurrencesInRange(from, to){
  // project each active recurring transaction forward, generating every occurrence in [from,to]
  const out = [];
  (state.recurring||[]).forEach(r=>{
    if(r.active===false || !r.nextDate) return;
    let d = new Date(r.nextDate);
    const end = new Date(to);
    let guard = 0;
    while(d<=end && guard<500){
      const ds = d.toISOString().slice(0,10);
      if(ds>=from && ds<=to) out.push({ name:r.name, type:r.type, amount:Number(r.amount)||0, date: ds });
      if(r.frequency==='daily') d.setDate(d.getDate()+1);
      else if(r.frequency==='weekly') d.setDate(d.getDate()+7);
      else if(r.frequency==='monthly') d.setMonth(d.getMonth()+1);
      else if(r.frequency==='yearly') d.setFullYear(d.getFullYear()+1);
      else break;
      guard++;
      if(r.end && ds>r.end) break;
    }
  });
  return out;
}
function computeForecast(days){
  const from = todayStr();
  const toDate = new Date(); toDate.setDate(toDate.getDate()+days);
  const to = toDate.toISOString().slice(0,10);
  const currentBalance = totalMoney();
  const occurrences = recurringOccurrencesInRange(from, to);
  const schedIncome = sum(occurrences.filter(o=>o.type==='income'));
  const schedExpense = sum(occurrences.filter(o=>o.type==='expense'));
  const cardDues = upcomingCardDuesInRange(from, to);
  const cardDuesTotal = sum(cardDues);
  const goalMonthly = state.goals.filter(g=>!g.achieved).reduce((s,g)=>s+(Number(g.monthlyOverride)||0),0);
  const goalContribution = goalMonthly * (days/30);
  const projectedBalance = currentBalance + schedIncome - schedExpense - cardDuesTotal - goalContribution;
  // simple day-by-day interpolation for a timeline chart
  const timeline = [];
  const stepDays = days<=7?1:days<=30?3:days<=60?5:7;
  for(let d=0; d<=days; d+=stepDays){
    const dt = new Date(); dt.setDate(dt.getDate()+d);
    const ds = dt.toISOString().slice(0,10);
    const occSoFar = recurringOccurrencesInRange(from, ds);
    const inc = sum(occSoFar.filter(o=>o.type==='income'));
    const exp = sum(occSoFar.filter(o=>o.type==='expense'));
    const dues = sum(upcomingCardDuesInRange(from, ds));
    const goalSoFar = goalMonthly*(d/30);
    timeline.push({date:ds, balance: currentBalance+inc-exp-dues-goalSoFar});
  }
  return { currentBalance, schedIncome, schedExpense, cardDuesTotal, goalContribution, projectedBalance, occurrences, cardDues, timeline };
}
function renderForecast(){
  const f = computeForecast(forecastDays);
  const hasAnySchedule = f.occurrences.length>0 || f.cardDues.length>0 || f.goalContribution>0;
  document.getElementById('forecastKpis').innerHTML = `
    <div class="kpi"><div class="kpi-label">Current Balance</div><div class="kpi-value">${fmt(f.currentBalance)}</div></div>
    <div class="kpi income"><div class="kpi-label">Scheduled Income</div><div class="kpi-value">${fmt(f.schedIncome)}</div></div>
    <div class="kpi expense"><div class="kpi-label">Scheduled Expenses + Dues</div><div class="kpi-value">${fmt(f.schedExpense+f.cardDuesTotal)}</div></div>
    <div class="kpi savings"><div class="kpi-label">Projected Balance (${forecastDays}d)</div><div class="kpi-value" style="color:${f.projectedBalance<0?'var(--rust)':'var(--teal)'};">${fmt(f.projectedBalance)}</div></div>
  `;
  const existingNote = document.getElementById('forecastLimitNote');
  if(existingNote) existingNote.remove();
  if(!hasAnySchedule){
    document.getElementById('forecastKpis').insertAdjacentHTML('afterend', `<div class="empty-note" id="forecastLimitNote" style="margin-top:10px;">Limited forecast: no recurring income/expenses, credit card due dates, or active goal contributions are recorded yet, so this projection is just your current balance carried forward. Add recurring transactions for a more accurate forecast.</div>`);
  }
  destroyChart('forecast');
  const {grid:g,text} = chartTheme();
  if(f.timeline.length){
    charts.forecast = new Chart(document.getElementById('c_forecast'), {
      type:'line',
      data:{labels:f.timeline.map(t=>t.date), datasets:[{label:'Projected Balance (ESTIMATE)', data:f.timeline.map(t=>t.balance), borderColor:'#B98A1E', backgroundColor:'#B98A1E22', fill:true, tension:.3}]},
      options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:text,boxWidth:10,font:{size:10}}}},scales:{x:{ticks:{color:text},grid:{color:g}},y:{ticks:{color:text},grid:{color:g}}}}
    });
  } else noData('c_forecast');
  const rows = [
    ...f.occurrences.map(o=>`<tr><td>${o.date}</td><td>${o.name}</td><td>${o.type==='income'?'Recurring Income':'Recurring Expense'}</td><td style="text-align:right;color:${o.type==='income'?'var(--teal)':'var(--rust)'};">${o.type==='income'?'+':'-'}${fmt(o.amount)}</td></tr>`),
    ...f.cardDues.map(c=>`<tr><td>${c.date}</td><td>${c.name}</td><td>Credit Card Due</td><td style="text-align:right;color:var(--rust);">-${fmt(c.amount)}</td></tr>`)
  ].sort();
  document.getElementById('forecastTable').innerHTML = rows.length
    ? `<div class="table-wrap"><table><thead><tr><th>Date</th><th>Item</th><th>Type</th><th style="text-align:right;">Amount</th></tr></thead><tbody>${rows.join('')}</tbody></table></div><div class="card-note" style="margin-top:10px;">Projected — based on your recorded financial data (ESTIMATE).</div>`
    : '<div class="empty-note">Not enough recorded data yet — add recurring transactions, credit cards, or goals to see a breakdown.</div>';
}
document.querySelectorAll('#forecastSeg button').forEach(b=>{
  b.addEventListener('click', ()=>{
    document.querySelectorAll('#forecastSeg button').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    forecastDays = parseInt(b.dataset.days);
    renderForecast();
  });
});

/* ---------------------------------------------------------------
   AFFORDABILITY CHECKER — "CAN I SPEND THIS?"
--------------------------------------------------------------- */
function renderAffordability(){
  const cat = document.getElementById('af_category');
  if(cat && !cat.dataset.filled){ cat.innerHTML = expenseCats().map(c=>`<option>${c}</option>`).join(''); cat.dataset.filled='1'; }
}
function computeAffordability(name, amount, category){
  name = name || 'This purchase';
  const availableCash = totalMoney();
  const from = todayStr();
  const in30 = new Date(); in30.setDate(in30.getDate()+30);
  const to30 = in30.toISOString().slice(0,10);
  const occ30 = recurringOccurrencesInRange(from, to30);
  const upcomingExpense30 = sum(occ30.filter(o=>o.type==='expense')) + sum(upcomingCardDuesInRange(from, to30));

  const mFrom = startOfMonth(0), mTo = endOfMonth(0);
  const budget = category ? (Number(state.budgets[category])||0) : 0;
  const spentSoFar = category ? sum(expenseTxns().filter(t=>t.category===category && dateInRange(t.date,mFrom,mTo))) : 0;
  const budgetRoom = (category && budget>0) ? Math.max(0, budget-spentSoFar) : null;

  const efGoal = getEmergencyFundGoal ? getEmergencyFundGoal() : null;
  const efTarget = efGoal ? (Number(efGoal.cost)||0) : 0;
  const efSaved = efGoal ? sum(efGoal.contributions) : 0;
  const efShortfall = Math.max(0, efTarget-efSaved);

  const afterPurchase = availableCash - amount;
  const safeToSpend = Math.max(0, availableCash - upcomingExpense30 - efShortfall);

  let verdict, cls, reason;
  if(amount > availableCash || afterPurchase < 0){
    verdict='🔴 HIGH PRIORITY CONFLICT'; cls='bad';
    reason = `This would leave your available balance negative or dip into money you don't have. You have ${fmt(availableCash)} available.`;
  } else if(afterPurchase < upcomingExpense30 + (efShortfall>0? Math.min(efShortfall, availableCash*0.2):0)){
    verdict='🔴 HIGH PRIORITY CONFLICT'; cls='bad';
    reason = `After this purchase you'd have ${fmt(afterPurchase)} left, which isn't enough to cover your ~${fmt(upcomingExpense30)} in upcoming 30-day commitments${efShortfall>0? ' while your emergency fund is still short':''}.`;
  } else if(amount > safeToSpend || (budgetRoom!==null && amount > budgetRoom)){
    verdict='🟡 PLAN FIRST'; cls='warn';
    reason = `This strains your discretionary room. Safe-to-spend after commitments is ${fmt(safeToSpend)}${budgetRoom!==null? `, and your remaining ${category} budget this month is ${fmt(budgetRoom)}`:''}.`;
  } else {
    verdict='🟢 SAFE'; cls='good';
    reason = `You have enough cushion for upcoming commitments and this purchase. Safe-to-spend after commitments: ${fmt(safeToSpend)}.`;
  }
  return { name, amount, category, availableCash, upcomingExpense30, budget, budgetRoom, efGoal, efTarget, efSaved, efShortfall, afterPurchase, safeToSpend, verdict, cls, reason };
}
function renderAffordabilityResult(r){
  const el = document.getElementById('afResult');
  el.innerHTML = `
    <div class="verdict-box ${r.cls}">
      <div class="verdict-title">${r.verdict}</div>
      <div style="margin-top:8px;font-size:13.5px;">${r.reason}</div>
    </div>
    <div class="kpi-grid" style="margin-top:16px;">
      <div class="kpi"><div class="kpi-label">Available Money</div><div class="kpi-value">${fmt(r.availableCash)}</div></div>
      <div class="kpi expense"><div class="kpi-label">Upcoming 30-Day Commitments</div><div class="kpi-value">${fmt(r.upcomingExpense30)}</div></div>
      <div class="kpi savings"><div class="kpi-label">Safe-to-Spend Amount</div><div class="kpi-value">${fmt(r.safeToSpend)}</div></div>
      <div class="kpi ${r.afterPurchase<0?'expense':'income'}"><div class="kpi-label">Balance After "${r.name}"</div><div class="kpi-value" style="color:${r.afterPurchase<0?'var(--rust)':'var(--teal)'};">${fmt(r.afterPurchase)}</div></div>
    </div>
    ${r.budgetRoom!==null? `<div class="card-note" style="margin-top:10px;">${r.category} budget room this month: ${fmt(r.budgetRoom)} of ${fmt(r.budget)}.</div>` : (r.category ? `<div class="card-note" style="margin-top:10px;">No budget set for ${r.category} — set one under Budgets for a sharper check.</div>` : '')}
    ${r.efGoal? `<div class="card-note">Emergency fund: ${fmt(r.efSaved)} saved of ${fmt(r.efTarget)} target${r.efShortfall>0? ` (${fmt(r.efShortfall)} short)`:' (fully funded)'}.</div>` : ''}
  `;
}
document.getElementById('afCheckBtn').addEventListener('click', ()=>{
  const name = document.getElementById('af_name').value.trim()||'This purchase';
  const amount = parseFloat(document.getElementById('af_amount').value);
  const el = document.getElementById('afResult');
  if(!amount || amount<=0){ el.innerHTML = '<div class="empty-note">Enter a valid amount to check.</div>'; return; }
  const category = document.getElementById('af_category').value;
  renderAffordabilityResult(computeAffordability(name, amount, category));
});

/* ---------------------------------------------------------------
   FINANCIAL HEALTH SCORE, WEEKLY DIGEST, WHAT-IF SIMULATOR,
   SPENDING PREDICTION & ANOMALY DETECTION (extend Insights)
--------------------------------------------------------------- */
// Returns {score:0-100|null, label, detail, dot:'good'|'warn'|'bad'|'info'} per area.
// A null score means there isn't enough recorded data for that area yet — never invented.
function healthAreaSavings(){
  const inc = incomeTxns(), exp = expenseTxns();
  const totalIncome = sum(inc), totalExpense = sum(exp);
  if(totalIncome<=0) return {score:null, label:'Savings', detail:'Add income data to calculate your savings rate.'};
  const savingsRate = (totalIncome-totalExpense)/totalIncome*100;
  const score = Math.max(0, Math.min(100, Math.round(savingsRate*2+50)));
  const dot = score>=70?'good':score>=40?'warn':'bad';
  return {score, label:'Savings', dot, detail:`Savings rate: ${savingsRate.toFixed(1)}% of income.`, rate:savingsRate};
}
function healthAreaBudget(){
  const exp = expenseTxns();
  const budgetCats = Object.keys(state.budgets||{});
  if(!budgetCats.length) return {score:null, label:'Budget', detail:'Set up category budgets to track discipline.'};
  const from = startOfMonth(0), to = endOfMonth(0);
  const overCats = budgetCats.filter(c=> sum(exp.filter(t=>t.category===c && dateInRange(t.date,from,to))) > Number(state.budgets[c]));
  const score = Math.round((1 - overCats.length/budgetCats.length) * 100);
  const dot = score>=70?'good':score>=40?'warn':'bad';
  return {score, label:'Budget', dot, detail: overCats.length ? `Over budget in ${overCats.length} of ${budgetCats.length} categor${budgetCats.length===1?'y':'ies'} this month.` : `Within budget in all ${budgetCats.length} tracked categor${budgetCats.length===1?'y':'ies'} this month.`, overCats};
}
function healthAreaEmergencyFund(){
  const efGoal = getEmergencyFundGoal();
  const target = efGoal ? Number(efGoal.cost)||0 : 0;
  if(!efGoal || target<=0) return {score:null, label:'Emergency Fund', detail:'Add more expense data to set an emergency fund target.'};
  const saved = sum(efGoal.contributions);
  const pct = Math.min(100, (saved/target)*100);
  const score = Math.round(pct);
  const dot = score>=100?'good':score>=50?'warn':'bad';
  return {score, label:'Emergency Fund', dot, detail:`${pct.toFixed(0)}% funded — ${fmt(saved)} of ${fmt(target)} target.`};
}
function healthAreaDebt(){
  const inc = incomeTxns();
  const totalIncome = sum(inc);
  const iOwe = (state.debts||[]).filter(d=>d.type==='i_owe'&&!d.settled).reduce((s,d)=>s+Number(d.amount),0);
  if(iOwe<=0) return {score:100, label:'Debt', dot:'good', detail:'No outstanding debt recorded.'};
  if(totalIncome<=0) return {score:null, label:'Debt', detail:'Add income data to gauge debt burden relative to income.'};
  const ratio = iOwe/totalIncome*100;
  const score = Math.max(0, Math.min(100, Math.round(100 - ratio*1.5)));
  const dot = score>=70?'good':score>=40?'warn':'bad';
  return {score, label:'Debt', dot, detail:`Outstanding debt is ${ratio.toFixed(0)}% of recorded income (${fmt(iOwe)}).`};
}
function healthAreaCredit(){
  const cards = state.creditCards||[];
  const withLimit = cards.filter(c=>Number(c.limit)>0);
  if(!withLimit.length) return {score:null, label:'Credit', detail:'Add a credit card with a limit to track utilization.'};
  const avgUtil = withLimit.reduce((s,c)=>s+ccUtilization(c),0)/withLimit.length;
  const score = Math.max(0, Math.min(100, Math.round(100-avgUtil)));
  const dot = avgUtil<30?'good':avgUtil<=70?'warn':'bad';
  return {score, label:'Credit', dot, detail:`Average utilization: ${avgUtil.toFixed(0)}% across ${withLimit.length} card${withLimit.length===1?'':'s'}.`};
}
function healthAreaGoals(){
  const goals = state.goals.filter(g=>!g.isEmergencyFund);
  if(!goals.length) return {score:null, label:'Goals', detail:'Add a savings goal to track progress here.'};
  const plan = computeGoalPlan();
  const points = goals.map(g=>{
    if(g.achieved) return 100;
    const status = computeGoalStatus(g, plan);
    return {'On Track':85,'In Progress':60,'Behind':25,'Paused':55,'Not Started':40,'Completed':100}[status] ?? 50;
  });
  const score = Math.round(points.reduce((a,b)=>a+b,0)/points.length);
  const dot = score>=70?'good':score>=40?'warn':'bad';
  const achievedCount = goals.filter(g=>g.achieved).length;
  return {score, label:'Goals', dot, detail:`${achievedCount} of ${goals.length} goal${goals.length===1?'':'s'} achieved; rest tracked by pace.`};
}
function computeHealthScoreDetail(){
  const areas = {
    savings: healthAreaSavings(),
    budget: healthAreaBudget(),
    emergencyFund: healthAreaEmergencyFund(),
    debt: healthAreaDebt(),
    credit: healthAreaCredit(),
    goals: healthAreaGoals()
  };
  const weights = {savings:0.30, budget:0.15, emergencyFund:0.20, debt:0.15, credit:0.10, goals:0.10};
  let weightedSum = 0, weightTotal = 0;
  Object.keys(areas).forEach(k=>{
    if(areas[k].score!=null && isFinite(areas[k].score)){ weightedSum += areas[k].score*weights[k]; weightTotal += weights[k]; }
  });
  const overall = weightTotal>0 ? Math.max(0, Math.min(100, Math.round(weightedSum/weightTotal))) : null;
  const good = [], attention = [], improve = [];
  const areaDefs = [
    {k:'savings', good:'You\'re saving a healthy share of your income.', bad:'Your spending is eating into (or exceeding) your income.', tip:'Trim your top 1-2 discretionary expense categories, or route a fixed amount to savings right after income lands.'},
    {k:'budget', good:'You\'re sticking to your set budgets this month.', bad:'You\'ve gone over budget in one or more categories this month.', tip:'Review the categories you\'re over in and either adjust the budget or cut back there next month.'},
    {k:'emergencyFund', good:'Your emergency fund is on track or fully funded.', bad:'Your emergency fund is behind its target.', tip:'The Emergency Fund is prioritized first in your goal funding — log a contribution when you can.'},
    {k:'debt', good:'Your debt load is low or well managed relative to income.', bad:'Outstanding debt is high relative to your income.', tip:'Prioritize paying down highest-interest debts first, and avoid taking on new ones for now.'},
    {k:'credit', good:'Your credit card utilization is healthy.', bad:'Your credit card utilization is high — this can affect your credit score.', tip:'Try to keep utilization under 30% of your limit; pay down the outstanding balance where possible.'},
    {k:'goals', good:'Your savings goals are progressing well.', bad:'Some of your goals are behind pace or not started.', tip:'Revisit goal priority order, or use the What-If Simulator to see what a higher contribution would do.'}
  ];
  areaDefs.forEach(d=>{
    const a = areas[d.k];
    if(a.score==null) return; // no invented commentary for areas without data
    if(a.score>=70) good.push(`${a.label}: ${d.good}`);
    else { attention.push(`${a.label}: ${d.detail}`); improve.push(`${a.label}: ${d.tip}`); }
  });
  return {overall, areas, good, attention, improve, confidence: Math.round(weightTotal*100)};
}
/* Sprint 34 — records one health-score snapshot per calendar month (same
   pattern as recordNetWorthSnapshot/state.netWorthHistory above) so the
   premium hero card's "vs last month" delta is a real comparison against
   a previously computed score, never a made-up number. */
function recordHealthScoreSnapshot(overall){
  if(overall==null) return null;
  const m = monthKey(todayStr());
  const existing = state.healthScoreHistory.find(h=>h.month===m);
  if(existing){ existing.score = overall; } else { state.healthScoreHistory.push({month:m, score:overall}); }
  state.healthScoreHistory.sort((a,b)=> a.month<b.month?-1:1);
  saveHealthScoreHistory();
  const prior = state.healthScoreHistory.filter(h=>h.month<m).slice(-1)[0];
  return prior ? prior.score : null;
}
function khInsHeroRingSvg(pct){
  const p = pct==null ? 0 : Math.max(0, Math.min(100, pct));
  const r = 56, c = 2*Math.PI*r;
  const dash = (p/100)*c;
  return `<svg width="132" height="132" viewBox="0 0 132 132" style="filter:drop-shadow(0 0 10px rgba(124,58,237,.5));">
    <defs><linearGradient id="khInsRingGrad" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="var(--kh-purple)"/><stop offset="100%" stop-color="var(--kh-cyan)"/></linearGradient></defs>
    <circle cx="66" cy="66" r="${r}" fill="none" stroke="var(--kh-card-line)" stroke-width="10"/>
    <circle cx="66" cy="66" r="${r}" fill="none" stroke="url(#khInsRingGrad)" stroke-width="10" stroke-linecap="round" stroke-dasharray="${dash.toFixed(1)} ${c.toFixed(1)}" transform="rotate(-90 66 66)" style="transition:stroke-dasharray 1s var(--kh-ease-out);"/>
  </svg>
  <div class="kh-ins-ring-center">
    <div class="kh-ins-ring-num">${pct==null?'—':Math.round(pct)}</div>
    <div class="kh-ins-ring-max">/ 100</div>
  </div>`;
}
function renderHealthScore(){
  const {overall, areas, good, attention, improve, confidence} = computeHealthScoreDetail();
  const priorScore = recordHealthScoreSnapshot(overall);

  document.getElementById('healthScoreRingWrap').innerHTML = khInsHeroRingSvg(overall);

  const statusEl = document.getElementById('healthScoreStatusBadge');
  if(overall===null){ statusEl.textContent = 'No Data Yet'; statusEl.className = 'kh-ins-status-badge'; }
  else{
    const label = overall>=85?'Excellent':overall>=70?'Good':overall>=40?'Fair':'Needs Attention';
    const cls = overall>=70?'good':overall>=40?'warn':'bad';
    statusEl.textContent = label; statusEl.className = 'kh-ins-status-badge '+cls;
  }

  const deltaEl = document.getElementById('healthScoreDeltaChip');
  if(overall===null){ deltaEl.className='kh-ins-delta-chip flat'; deltaEl.textContent='Not enough data yet'; }
  else if(priorScore===null){ deltaEl.className='kh-ins-delta-chip flat'; deltaEl.textContent='First score logged'; }
  else{
    const delta = overall-priorScore;
    if(delta>0){ deltaEl.className='kh-ins-delta-chip'; deltaEl.textContent=`↑ +${delta} from last month`; }
    else if(delta<0){ deltaEl.className='kh-ins-delta-chip down'; deltaEl.textContent=`↓ ${delta} from last month`; }
    else{ deltaEl.className='kh-ins-delta-chip flat'; deltaEl.textContent='No change from last month'; }
  }

  const confFill = document.getElementById('healthConfFill');
  const confLabel = document.getElementById('healthConfLabel');
  confFill.style.width = confidence+'%';
  confLabel.textContent = confidence===0 ? 'No data yet' : `${confidence>=80?'High':confidence>=50?'Medium':'Low'} ${confidence}%`;

  document.getElementById('healthScoreDetail').innerHTML = overall===null
    ? 'Not enough data available yet. Log income, expenses, and set up goals/budgets to see your score.'
    : `Score out of 100, combining the areas below (only areas with enough recorded data are counted). ${overall>=70?'Healthy footing overall — keep it up.':overall>=40?'Reasonable, but there\'s room to improve in a few areas.':'Under pressure — see what needs attention below.'}`;

  const areaOrder = [['savings','💰'],['budget','📊'],['emergencyFund','🛟'],['debt','💳'],['credit','🏦'],['goals','🎯']];
  document.getElementById('healthAreaGrid').innerHTML = areaOrder.map(([k,icon])=>{
    const a = areas[k];
    const color = a.score==null ? 'var(--kh-text-soft)' : (a.dot==='good'?'var(--kh-green)':a.dot==='warn'?'#FBBF24':'var(--kh-red)');
    return `<div class="kpi" style="--accent:${color};">
      <div class="kpi-label">${icon} ${a.label}</div>
      <div class="kpi-value" style="color:${color};">${a.score==null?'—':a.score}</div>
      <div class="kpi-sub">${a.detail}</div>
    </div>`;
  }).join('');

  const listHtml = (arr, emptyText) => arr.length
    ? arr.map(t=>`<div class="insight" style="padding:6px 0;"><span class="dot info"></span><p>${t}</p></div>`).join('')
    : `<div class="empty-note" style="padding:4px;">${emptyText}</div>`;
  document.getElementById('healthGoodList').innerHTML = listHtml(good, 'Nothing to show yet — keep logging data.');
  document.getElementById('healthAttentionList').innerHTML = listHtml(attention, 'Nothing flagged right now.');
  document.getElementById('healthImproveList').innerHTML = listHtml(improve, 'No suggestions right now — you\'re on track in the areas we can measure.');
}
function khMiniBars(dailyVals){
  const max = Math.max(1, ...dailyVals.map(v=>Math.abs(v)));
  return dailyVals.map(v=>`<i style="height:${Math.max(6,Math.round(Math.abs(v)/max*100))}%;"></i>`).join('');
}
function renderWeeklyDigest(){
  const exp = expenseTxns(), inc = incomeTxns();
  const d = new Date(); d.setDate(d.getDate()-6); const from = d.toISOString().slice(0,10);
  const weekExp = exp.filter(t=>t.date>=from), weekInc = inc.filter(t=>t.date>=from);
  const totalExp = sum(weekExp), totalInc = sum(weekInc);
  const totalSave = totalInc-totalExp;
  const byCat={}; weekExp.forEach(t=>byCat[t.category]=(byCat[t.category]||0)+Number(t.amount));
  const top = Object.entries(byCat).sort((a,b)=>b[1]-a[1])[0];
  if(!weekExp.length && !weekInc.length){ document.getElementById('weeklyDigest').innerHTML = '<div class="empty-note">Not enough data available yet for the last 7 days.</div>'; return; }

  // per-day totals for the mini bar charts (real data, last 7 days)
  const incByDay=[], expByDay=[], saveByDay=[];
  for(let i=6;i>=0;i--){
    const dd = new Date(); dd.setDate(dd.getDate()-i);
    const ds = dd.toISOString().slice(0,10);
    const di = sum(weekInc.filter(t=>t.date===ds)), de = sum(weekExp.filter(t=>t.date===ds));
    incByDay.push(di); expByDay.push(de); saveByDay.push(di-de);
  }

  // prior 7 days, for a real weekly comparison
  const prevFromD = new Date(); prevFromD.setDate(prevFromD.getDate()-13);
  const prevToD = new Date(); prevToD.setDate(prevToD.getDate()-7);
  const prevFrom = prevFromD.toISOString().slice(0,10), prevTo = prevToD.toISOString().slice(0,10);
  const prevExp = sum(exp.filter(t=>t.date>=prevFrom && t.date<=prevTo));
  const largest = weekExp.slice().sort((a,b)=>Number(b.amount)-Number(a.amount))[0];

  document.getElementById('weeklyDigest').innerHTML = `
    <div class="kh-ins-digest-grid">
      <div class="kh-ins-digest-tile inc"><div class="lbl">Income</div><div class="amt">${fmt(totalInc)}</div><div class="mini-bars">${khMiniBars(incByDay)}</div></div>
      <div class="kh-ins-digest-tile exp"><div class="lbl">Expense</div><div class="amt">${fmt(totalExp)}</div><div class="mini-bars">${khMiniBars(expByDay)}</div></div>
      <div class="kh-ins-digest-tile sav"><div class="lbl">Savings</div><div class="amt" style="color:${totalSave>=0?'var(--kh-green)':'var(--kh-red)'};">${fmt(totalSave)}</div><div class="mini-bars">${khMiniBars(saveByDay)}</div></div>
      ${top?`<div class="kh-ins-digest-top"><div class="lbl">Top Category</div><div class="cat">${top[0]}</div><div class="amt">${fmt(top[1])}</div></div>`:'<div></div>'}
    </div>
    ${largest?`<div class="insight" style="margin-top:8px;"><span class="dot info"></span><p>Largest transaction this week: <b>${fmt(largest.amount)}</b> — ${largest.category}${largest.item?' ('+largest.item+')':''} on ${largest.date}.</p></div>`:''}
    ${prevExp>0?`<div class="insight"><span class="dot ${totalExp>prevExp?'warn':'good'}"></span><p>Spending is ${totalExp>prevExp?'up':'down'} ${Math.abs(((totalExp-prevExp)/prevExp)*100).toFixed(0)}% versus the previous 7 days (${fmt(prevExp)}).</p></div>`:''}
  `;
}
document.getElementById('weeklyDigestToggle').addEventListener('click', e=>{
  const body = document.getElementById('weeklyDigest');
  const open = e.target.classList.contains('open');
  body.style.display = open ? 'none' : '';
  e.target.classList.toggle('open');
});

function spendingPrediction(){
  const exp = expenseTxns();
  const months = monthsRange();
  if(months.length<2) return null;
  const last3 = months.slice(-3);
  const totals = last3.map(m=> sum(exp.filter(t=>monthKey(t.date)===m)) );
  const avg = totals.reduce((a,b)=>a+b,0)/totals.length;
  return { avg, months: last3 };
}
function anomalyAlerts(){
  const exp = expenseTxns();
  const months = monthsRange();
  if(months.length<2) return [];
  const thisM = monthKey(todayStr());
  const priorMonths = months.filter(m=>m!==thisM).slice(-3);
  if(!priorMonths.length) return [];
  const alerts=[];
  const cats = [...new Set(exp.map(t=>t.category))];
  cats.forEach(c=>{
    const priorAvg = sum(exp.filter(t=>t.category===c && priorMonths.includes(monthKey(t.date)))) / priorMonths.length;
    const thisAmt = sum(exp.filter(t=>t.category===c && monthKey(t.date)===thisM));
    if(priorAvg>0 && thisAmt > priorAvg*1.4){
      const pctUp = ((thisAmt-priorAvg)/priorAvg*100).toFixed(0);
      alerts.push(`This month, <b>${c}</b> spending is ${pctUp}% higher than your recent average (${fmt(thisAmt)} vs usual ${fmt(priorAvg)}).`);
    }
  });
  return alerts;
}
document.getElementById('whatIfBtn').addEventListener('click', ()=>{
  const daily = parseFloat(document.getElementById('wi_amount').value)||0;
  const monthlyExtra = daily*30;
  const active = state.goals.filter(g=>!g.achieved).sort((a,b)=>a.priority-b.priority);
  const el = document.getElementById('whatIfResult');
  if(!active.length){ el.innerHTML = '<div class="empty-note">Add a goal first to simulate its timeline.</div>'; return; }
  const g = active[0];
  const plan = computeGoalPlan();
  const base = plan.results[g.id];
  const withExtra = computeGoalPlan({[g.id]: monthlyExtra});
  const after = withExtra.results[g.id];
  if(!base || base.monthlyRate<=0 || !isFinite(base.completionMonths)){
    el.innerHTML = `<div class="insight"><span class="dot info"></span><p>Saving ${fmt(daily)} less per day adds ${fmt(monthlyExtra)}/month toward <b>${g.name}</b>, but there isn't enough baseline data yet to project a full timeline.</p></div>`;
    return;
  }
  const monthsBefore = Math.ceil(base.completionMonths), monthsAfter = Math.ceil(after.completionMonths);
  const sooner = Math.max(0,monthsBefore-monthsAfter);
  const pct = monthsBefore>0 ? Math.max(4,Math.min(100,(monthsAfter/monthsBefore)*100)) : 100;
  el.innerHTML = `
    <div class="kh-ins-pred-card">
      <div class="kh-ins-sum-label">${g.name} — Goal Completion</div>
      <div class="kh-ins-pred-row" style="margin-top:4px;">
        <div class="kh-ins-pred-big pos">${monthsAfter} mo</div>
        <div style="font-size:12px;color:var(--kh-text-soft);">instead of ${monthsBefore} mo — <b style="color:var(--kh-green);">${sooner} month(s) sooner</b></div>
      </div>
      <div class="kh-ins-conf-bar" style="margin-top:10px;"><div class="kh-ins-conf-fill" style="width:${pct}%;"></div></div>
    </div>`;
});
document.getElementById('wi_amount').addEventListener('input', e=>{
  document.getElementById('wi_amount_label').textContent = '₹'+e.target.value;
  document.querySelectorAll('.kh-ins-preset-btn').forEach(b=>b.classList.toggle('active', b.dataset.val===e.target.value));
  document.getElementById('whatIfBtn').click();
});
document.querySelectorAll('.kh-ins-preset-btn').forEach(btn=>{
  btn.addEventListener('click', ()=>{
    const wi = document.getElementById('wi_amount');
    wi.value = btn.dataset.val;
    wi.dispatchEvent(new Event('input'));
  });
});

/* ---------------------------------------------------------------
   UNIVERSAL FINANCE SEARCH
--------------------------------------------------------------- */
const MONTH_NAMES = ["january","february","march","april","may","june","july","august","september","october","november","december"];
function parseSearchQuery(raw){
  const q = raw.trim().toLowerCase();
  let list = [...state.transactions.filter(t=>t.type!=='transfer')];
  let label = [];
  let remaining = q;

  // date range: "1 august 2026 - 20 august 2026" or "dd mon yyyy - dd mon yyyy"
  const rangeMatch = q.match(/(\d{1,2}\s+\w+\s+\d{4})\s*-\s*(\d{1,2}\s+\w+\s+\d{4})/);
  if(rangeMatch){
    const d1 = parseDateWords(rangeMatch[1]), d2 = parseDateWords(rangeMatch[2]);
    if(d1&&d2){ list = list.filter(t=>dateInRange(t.date,d1,d2)); label.push(`${rangeMatch[1]} – ${rangeMatch[2]}`); remaining = remaining.replace(rangeMatch[0],''); }
  }
  // relative dates
  if(/\btoday\b/.test(remaining)){ list=list.filter(t=>t.date===todayStr()); label.push('today'); remaining=remaining.replace('today',''); }
  else if(/\byesterday\b/.test(remaining)){ const y=new Date(); y.setDate(y.getDate()-1); const ys=y.toISOString().slice(0,10); list=list.filter(t=>t.date===ys); label.push('yesterday'); remaining=remaining.replace('yesterday',''); }
  else if(/\blast\s+7\s+days\b/.test(remaining)){ const d=new Date(); d.setDate(d.getDate()-6); const from=d.toISOString().slice(0,10); list=list.filter(t=>t.date>=from); label.push('last 7 days'); remaining=remaining.replace(/last\s+7\s+days/,''); }
  else if(/\blast\s+30\s+days\b/.test(remaining)){ const d=new Date(); d.setDate(d.getDate()-29); const from=d.toISOString().slice(0,10); list=list.filter(t=>t.date>=from); label.push('last 30 days'); remaining=remaining.replace(/last\s+30\s+days/,''); }
  else if(/\bthis\s+month\b/.test(remaining)){ list=list.filter(t=>dateInRange(t.date,startOfMonth(0),endOfMonth(0))); label.push('this month'); remaining=remaining.replace(/this\s+month/,''); }
  else if(/\blast\s+month\b/.test(remaining)){ list=list.filter(t=>dateInRange(t.date,startOfMonth(-1),endOfMonth(-1))); label.push('last month'); remaining=remaining.replace(/last\s+month/,''); }
  else if(/\bthis\s+week\b/.test(remaining)){ list=list.filter(t=>t.date>=startOfWeek()); label.push('this week'); remaining=remaining.replace(/this\s+week/,''); }

  // "16 august 2026" specific date
  const specificDate = remaining.match(/\b(\d{1,2})\s+(january|february|march|april|may|june|july|august|september|october|november|december)\s+(\d{4})\b/);
  if(specificDate){
    const d = parseDateWords(specificDate[0]);
    if(d){ list = list.filter(t=>t.date===d); label.push(specificDate[0]); remaining = remaining.replace(specificDate[0],''); }
  } else {
    // "august 2026" month+year
    const monthYear = remaining.match(/\b(january|february|march|april|may|june|july|august|september|october|november|december)\s+(\d{4})\b/);
    if(monthYear){
      const mi = MONTH_NAMES.indexOf(monthYear[1])+1;
      const mk = `${monthYear[2]}-${String(mi).padStart(2,'0')}`;
      list = list.filter(t=>monthKey(t.date)===mk);
      label.push(monthYear[0]);
      remaining = remaining.replace(monthYear[0],'');
    } else {
      // bare month name -> that month, most recent year with data, else this year
      const bareMonth = remaining.match(/\b(january|february|march|april|may|june|july|august|september|october|november|december)\b/);
      if(bareMonth){
        const mi = String(MONTH_NAMES.indexOf(bareMonth[1])+1).padStart(2,'0');
        list = list.filter(t=>t.date.slice(5,7)===mi);
        label.push(bareMonth[1]);
        remaining = remaining.replace(bareMonth[1],'');
      }
    }
  }

  // amount comparisons
  const above = remaining.match(/above\s+(\d+(\.\d+)?)/) || remaining.match(/over\s+(\d+(\.\d+)?)/);
  if(above){ const v=parseFloat(above[1]); list=list.filter(t=>Number(t.amount)>v); label.push('above '+v); remaining=remaining.replace(above[0],''); }
  const below = remaining.match(/below\s+(\d+(\.\d+)?)/) || remaining.match(/under\s+(\d+(\.\d+)?)/);
  if(below){ const v=parseFloat(below[1]); list=list.filter(t=>Number(t.amount)<v); label.push('below '+v); remaining=remaining.replace(below[0],''); }

  // type words
  if(/\bexpenses?\b/.test(remaining)){ list=list.filter(t=>t.type==='expense'); label.push('expenses'); remaining=remaining.replace(/expenses?/,''); }
  else if(/\bincome\b/.test(remaining)){ list=list.filter(t=>t.type==='income'); label.push('income'); remaining=remaining.replace(/income/,''); }

  // whatever text remains: match category / subcategory / item / notes / mode / account name
  remaining = remaining.replace(/[-–,]/g,' ').trim();
  const terms = remaining.split(/\s+/).filter(Boolean);
  terms.forEach(term=>{
    list = list.filter(t =>
      (t.category||'').toLowerCase().includes(term) ||
      (t.subcategory||'').toLowerCase().includes(term) ||
      (t.item||'').toLowerCase().includes(term) ||
      (t.notes||'').toLowerCase().includes(term) ||
      (t.mode||'').toLowerCase().includes(term) ||
      (accountById(t.account)?.name||'').toLowerCase().includes(term) ||
      (t.tags||[]).join(' ').toLowerCase().includes(term)
    );
    label.push(term);
  });

  return { list, label: label.join(' · ') || 'all transactions' };
}
function parseDateWords(str){
  const m = str.match(/(\d{1,2})\s+(\w+)\s+(\d{4})/);
  if(!m) return null;
  const mi = MONTH_NAMES.indexOf(m[2].toLowerCase());
  if(mi===-1) return null;
  return `${m[3]}-${String(mi+1).padStart(2,'0')}-${String(m[1]).padStart(2,'0')}`;
}
function runSearch(query){
  if(!query || !query.trim()){
    document.getElementById('searchResultsBody').innerHTML = '<div class="empty-note">Type a search above — try "Food", "above 500", "August 2026", "last 7 days", or "Food August".</div>';
    return;
  }
  const { list, label } = parseSearchQuery(query);
  const totalMonthExpense = sum(expenseTxns().filter(t=>dateInRange(t.date,startOfMonth(0),endOfMonth(0))));
  const amts = list.map(t=>Number(t.amount));
  const total = amts.reduce((a,b)=>a+b,0);
  const avg = amts.length ? total/amts.length : 0;
  const highest = amts.length ? Math.max(...amts) : 0;
  const lowest = amts.length ? Math.min(...amts) : 0;
  const pctOfMonth = totalMonthExpense ? (total/totalMonthExpense*100).toFixed(1) : null;

  let html = `<div class="card-note" style="margin-bottom:8px;">Search: <b>${label}</b></div>`;
  html += `<div class="search-summary">
    <div class="ss-box"><div class="ssv">${fmt(total)}</div><div class="ssl">Total</div></div>
    <div class="ss-box"><div class="ssv">${list.length}</div><div class="ssl">Transactions</div></div>
    <div class="ss-box"><div class="ssv">${fmt(avg)}</div><div class="ssl">Average</div></div>
    <div class="ss-box"><div class="ssv">${fmt(highest)}</div><div class="ssl">Highest</div></div>
    <div class="ss-box"><div class="ssv">${fmt(lowest)}</div><div class="ssl">Lowest</div></div>
    ${pctOfMonth!==null? `<div class="ss-box"><div class="ssv">${pctOfMonth}%</div><div class="ssl">Of Month's Spending</div></div>` : ''}
  </div>`;
  if(!list.length){
    html += '<div class="empty-note">No matching transactions found in your actual recorded data.</div>';
  } else {
    html += '<div class="table-wrap"><table><thead><tr><th>Date</th><th>Type</th><th>Category</th><th>Item</th><th>Account</th><th style="text-align:right;">Amount</th></tr></thead><tbody>';
    html += list.sort((a,b)=>b.date.localeCompare(a.date)).map(t=>`
      <tr><td>${t.date}</td><td>${t.type}</td><td>${t.category}${t.subcategory?' / '+t.subcategory:''}</td><td>${t.item||'—'}</td><td>${accountById(t.account)?.name||'—'}</td>
      <td style="text-align:right;" class="${t.type==='income'?'amt-in':'amt-ex'}">${t.type==='income'?'+':'-'}${fmt(t.amount)}</td></tr>
    `).join('');
    html += '</tbody></table></div>';
  }
  document.getElementById('searchResultsBody').innerHTML = html;
}
document.getElementById('searchViewInput').addEventListener('input', e=>runSearch(e.target.value));
document.getElementById('globalSearch').addEventListener('keydown', e=>{
  if(e.key==='Enter'){
    switchToView('search');
    document.getElementById('searchViewInput').value = e.target.value;
    runSearch(e.target.value);
  }
});
document.getElementById('mobileSearchBtn').addEventListener('click', ()=>{
  switchToView('search');
  document.getElementById('searchViewInput').focus();
});

