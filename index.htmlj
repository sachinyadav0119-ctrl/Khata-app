async function saveAccounts(){ try{ localStorage.setItem(bizKey('accounts'), JSON.stringify(state.accounts)); flash(); }catch(e){} }
async function saveRecurring(){ try{ localStorage.setItem(bizKey('recurring'), JSON.stringify(state.recurring)); flash(); }catch(e){} }
async function saveDebts(){ try{ localStorage.setItem(bizKey('debts'), JSON.stringify(state.debts)); flash(); }catch(e){} }
async function saveSubcats(){ try{ localStorage.setItem(bizKey('subcats'), JSON.stringify(state.customSubcats)); flash(); }catch(e){} }
async function saveTags(){ try{ localStorage.setItem(bizKey('tags'), JSON.stringify(state.tags)); flash(); }catch(e){} }
async function saveCreditCards(){ try{ localStorage.setItem(bizKey('creditcards'), JSON.stringify(state.creditCards)); flash(); }catch(e){} }
async function saveCCUtilHistory(){ try{ localStorage.setItem(bizKey('ccutilhistory'), JSON.stringify(state.ccUtilHistory)); }catch(e){} }
