   SCAN (FAB) — Sprint 24
   Every option here reuses the two file pipelines that already
   exist in the Add Entry view: #ocrScanInput (camera capture,
   OCR-ready) and #entryAttachInput (multi-type attach, already
   accepts image/pdf/audio/video/doc/txt). No new upload/parsing
   code was written — this sheet is just a friendlier front door
   onto those existing inputs.
--------------------------------------------------------------- */
document.getElementById('scanFabBtn').addEventListener('click', ()=>{
  document.getElementById('scanSheetOverlay').classList.remove('hidden');
});
document.getElementById('scanSheetClose').addEventListener('click', ()=>{
  document.getElementById('scanSheetOverlay').classList.add('hidden');
});
