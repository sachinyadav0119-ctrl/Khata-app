async function saveInvestmentWatchlist(){ try{ localStorage.setItem(bizKey('investmentwatchlist'), JSON.stringify(state.investmentWatchlist)); }catch(e){} }
async function saveInvestmentHistory(){ try{ localStorage.setItem(bizKey('investmenthistory'), JSON.stringify(state.investmentHistory)); }catch(e){} }
