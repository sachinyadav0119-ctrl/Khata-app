  "Food":["Groceries","Restaurant","Coffee","Milk","Curd/Dahi","Paneer","Soybean","Roasted Chana","Peanut","Water","Snacks"],
  "Travel":["Fuel","Auto","Taxi","Public Transport"],
  "Shopping":["Clothes","Electronics","Personal Care"]
};
// keyword -> {cat, sub?}, used for smart auto-categorization suggestions
const CATEGORY_KEYWORDS = [
  {cat:"Food", words:["food","lunch","dinner","breakfast","meal","restaurant","zomato","swiggy","hotel"]},
  {cat:"Food", sub:"Milk", words:["milk","doodh"]},
  {cat:"Food", sub:"Curd/Dahi", words:["curd","dahi","yogurt"]},
  {cat:"Food", sub:"Paneer", words:["paneer"]},
  {cat:"Food", sub:"Soybean", words:["soybean","soya"]},
  {cat:"Food", sub:"Roasted Chana", words:["chana","roasted chana"]},
  {cat:"Food", sub:"Peanut", words:["peanut","mungfali","moongphali"]},
  {cat:"Food", sub:"Coffee", words:["coffee","cafe","chai","tea"]},
  {cat:"Food", sub:"Water", words:["water","bisleri"]},
  {cat:"Travel", words:["uber","ola","auto","taxi","bus","train","petrol","fuel","cab"]},
  {cat:"Shopping", words:["shirt","clothes","shopping","amazon","flipkart","myntra"]},
  {cat:"Bills", words:["bill","electricity","recharge","broadband","wifi","rent","emi"]},
  {cat:"Entertainment", words:["movie","netflix","spotify","game","cinema"]},
  {cat:"Personal", words:["salon","haircut","gym","medicine","pharmacy"]}
];
const ACCOUNT_TYPES = ["Cash","Bank Account","UPI","Savings Account","Credit Card","Other"];
const ACCOUNT_ICONS = {"Cash":"💵","Bank Account":"🏦","UPI":"📱","Savings Account":"💰","Credit Card":"💳","Other":"📦"};

/* App.Config — mirrors the constants above so future modules have one
   place to read configuration from. The consts above remain the
   source of truth used everywhere else in this file; nothing here
   renames or replaces them. */
Object.assign(App.Config, {
  DEFAULT_EXPENSE_CATS, DEFAULT_INCOME_SOURCES, FOOD_CATS, PAYMENT_MODES,
  LEGACY_FOOD_ITEM_CATS, DEFAULT_SUBCATS, CATEGORY_KEYWORDS,
  ACCOUNT_TYPES, ACCOUNT_ICONS,
  STORAGE_PREFIX: 'khaata:',
  VERSION: '1.38.0'
});

let state = {
  transactions: [],      // {id,type,date,time,category,subcategory,item,amount,mode,notes,account,tags[]}
                          // Sprint 25 (additive, optional): a transaction may also carry
                          // items:[{id,name,amount,qty,unit,notes,tags[]}] + isMultiItem:true.
                          // When present, amount = sum(items) and item = joined item names —
                          // see App.Transaction.MultiItem, the single source of truth for this.
  budgets: {},            // {category: amount}
  budgetTypes: [],        // Sprint 21 — App.Budget: {id,scope(category/subcategory/account/project),period(daily/weekly/monthly/yearly/custom),customDays,category,subcategory,account,tag,amount,notes,createdDate}. Purely additive — never read/written by the original budgets{} path above.
  customExpenseCats: [],
  customIncomeSources: [],
  customSubcats: {},      // {category: [subcat,...]}
  goals: [],               // {id,name,cost,category,priority,targetDate,monthlyOverride,contributions,achieved,createdDate}
  settings: { bufferMonths: 3 },
  theme: "dark",
  accounts: [],            // {id,name,type,opening,icon,active}
  recurring: [],           // {id,name,type,amount,category,account,frequency,start,end,nextDate,active}
  debts: [],               // {id,type(owed_to_me/i_owe),person,amount,interest,date,due,settled,payments:[]}
  tags: [],                // known tags list
  creditCards: [],          // {id,name,limit,outstanding,billingDate,dueDate,minDue,totalDue,interestRate,notes,payments:[]}
  ccUtilHistory: {},        // {cardId: [{month, util}]} — monthly utilization snapshots for trend display
  investments: [],          // {id,name,type,invested,currentValue,purchaseDate,notes,
                             //  units,pricePerUnit,riskOverride,goalId,dividends[]} — the
                             //  fields after "notes" are Sprint 22 (App.Investment), all
                             //  optional/additive; existing records without them still work.
  investmentWatchlist: [],  // Sprint 22 — App.Investment.Watchlist: {id,name,type,notes,createdDate} — assets being considered, separate from the portfolio above.
  investmentHistory: [],    // Sprint 22 — App.Investment: {date,totalInvested,totalCurrent} — one snapshot/day, for the Growth Trend chart.
  netWorthHistory: [],      // {month,totalAssets,totalLiabilities,netWorth}
  healthScoreHistory: [],   // Sprint 34 (Insights redesign) — {month, score} one snapshot/month, so the premium Insights hero card can show a real "vs last month" delta instead of a made-up number
  deletedLog: [],           // recent deletions for undo, in-memory-ish but persisted lightly
  voiceSettings: { enabled:true, recognitionLang:'auto', continuousMode:false },  // Part 2.3
  voiceLog: [],               // {id,ts,transcript,interpreted,status} — voice command history only, never financial data
  reminders: [],               // {id,title,dueDate,notes,done,createdDate} — Sprint 16, chat-manageable bill/EMI/date reminders
  advisor: {                   // Sprint 20 — App.Advisor personalization + cache, nothing else reads/writes this key
    dismissed: {},              // {recoId: isoTimestamp} — suggestions the user dismissed, hidden for a cooldown
    shownLog: [],                // [{id,ts}] recent recommendation impressions, trimmed to last 200, used to space out repeats
    lastRunAt: null,             // isoTimestamp of the last full Advisor.Manager.run()
    snapshot: null                // cached output of the last run, shown instantly on tab open before a fresh run finishes
  }
};
let charts = {};
let currentEntryType = "expense";
let lastDeleted = null; // {txn, index} for undo
let quickAddType = "expense";
let quickAddAmount = null;

const fmt = n => "₹" + (Number(n)||0).toLocaleString('en-IN',{minimumFractionDigits:0,maximumFractionDigits:2});
const todayStr = () => new Date().toISOString().slice(0,10);
const uid = () => Date.now().toString(36)+Math.random().toString(36).slice(2,7);

/* Sprint 23 — App.Business: single key-resolution point used by every
   save*()/loadState() call below. App.Business itself isn't defined
   until later in this file (see the "BUSINESS FOUNDATION" block near
   the end) — that's fine, this is a plain function, so its body only
   runs when something actually calls it (a user save, or loadState()
   at startup), by which point the whole script — App.Business
   included — has already finished parsing. The try/catch fallback
   below means even that first instant is safe: if App.Business
   somehow isn't ready, this returns the exact original 'khaata:base'
   key, i.e. pre-Sprint-23 / Personal-profile behavior, unchanged. */
function bizKey(base){
  try{
    if(window.App && App.Business && App.Business.Storage && typeof App.Business.Storage.resolveKey==='function'){
      return App.Business.Storage.resolveKey(base);
    }
  }catch(e){}
  return 'khaata:' + base;
}

/* ---------------------------------------------------------------
   PERSISTENCE
--------------------------------------------------------------- */
/* Uses the browser's own localStorage, scoped to this file — works fully offline,
   no server, no account. Data lives only on this device/browser, in this file.
   Sprint 23 — App.Business: every key below now goes through bizKey() instead
   of a hardcoded 'khaata:xxx' literal, so this same function correctly loads
   whichever profile (Personal or a Business profile) is currently active —
   nothing else about this function changed. state.theme deliberately keeps
   using the plain, unscoped 'khaata:theme' key: theme is a device display
   preference, not business data, and is shared across every profile. */
async function loadState(){
  try{
    const t = localStorage.getItem(bizKey('transactions'));
    if(t) state.transactions = JSON.parse(t);
  }catch(e){}
  try{
    const b = localStorage.getItem(bizKey('budgets'));
    if(b) state.budgets = JSON.parse(b);
  }catch(e){}
  try{
    const c = localStorage.getItem(bizKey('customcats'));
    if(c){ const p = JSON.parse(c); state.customExpenseCats=p.expense||[]; state.customIncomeSources=p.income||[]; }
  }catch(e){}
  try{
    const th = localStorage.getItem('khaata:theme');
    if(th) state.theme = th;
  }catch(e){}
  try{
    const g = localStorage.getItem(bizKey('goals'));
    if(g) state.goals = JSON.parse(g);
  }catch(e){}
  try{
    const s = localStorage.getItem(bizKey('settings'));
    if(s) state.settings = {...state.settings, ...JSON.parse(s)};
  }catch(e){}
  try{ const a = localStorage.getItem(bizKey('accounts')); if(a) state.accounts = JSON.parse(a); }catch(e){}
  try{ const r = localStorage.getItem(bizKey('recurring')); if(r) state.recurring = JSON.parse(r); }catch(e){}
  try{ const d = localStorage.getItem(bizKey('debts')); if(d) state.debts = JSON.parse(d); }catch(e){}
  try{ const sc = localStorage.getItem(bizKey('subcats')); if(sc) state.customSubcats = JSON.parse(sc); }catch(e){}
  try{ const tg = localStorage.getItem(bizKey('tags')); if(tg) state.tags = JSON.parse(tg); }catch(e){}
  try{ const cc = localStorage.getItem(bizKey('creditcards')); if(cc) state.creditCards = JSON.parse(cc); }catch(e){}
  try{ const cuh = localStorage.getItem(bizKey('ccutilhistory')); if(cuh) state.ccUtilHistory = JSON.parse(cuh); }catch(e){}
  try{ const iv = localStorage.getItem(bizKey('investments')); if(iv) state.investments = JSON.parse(iv); }catch(e){}
  try{ const iw = localStorage.getItem(bizKey('investmentwatchlist')); if(iw) state.investmentWatchlist = JSON.parse(iw); }catch(e){}
  try{ const ih = localStorage.getItem(bizKey('investmenthistory')); if(ih) state.investmentHistory = JSON.parse(ih); }catch(e){}
  try{ const rm = localStorage.getItem(bizKey('reminders')); if(rm) state.reminders = JSON.parse(rm); }catch(e){}
  try{ const nh = localStorage.getItem(bizKey('networthhistory')); if(nh) state.netWorthHistory = JSON.parse(nh); }catch(e){}
  try{ const hsh = localStorage.getItem(bizKey('healthscorehistory')); if(hsh) state.healthScoreHistory = JSON.parse(hsh); }catch(e){}
  try{ const vs = localStorage.getItem(bizKey('voicesettings')); if(vs) state.voiceSettings = {...state.voiceSettings, ...JSON.parse(vs)}; }catch(e){}
  try{ const vl = localStorage.getItem(bizKey('voicelog')); if(vl) state.voiceLog = JSON.parse(vl); }catch(e){}
  try{ const av = localStorage.getItem(bizKey('advisor')); if(av) state.advisor = {...state.advisor, ...JSON.parse(av)}; }catch(e){}
  try{ const bt = localStorage.getItem(bizKey('budgettypes')); if(bt) state.budgetTypes = JSON.parse(bt); }catch(e){}
  document.body.setAttribute('data-theme', state.theme);
  migrateToV2();
}

/* ---------------------------------------------------------------
   MIGRATION — Khaata 1.x data → 2.0 (backward compatible, never wipes data)
--------------------------------------------------------------- */
function migrateToV2(){
  let touched = false;
  // Ensure at least one account exists so old data has somewhere to "live"
  if(!Array.isArray(state.accounts)) state.accounts = [];
  if(state.accounts.length===0){
    // Try to seed a sensible opening balance from existing net so totals don't jump.
    state.accounts.push({id:uid(), name:'Cash', type:'Cash', opening:0, icon:'💵', active:true});
    touched = true;
  }
  const defaultAcctId = state.accounts[0].id;
  // Backfill missing fields on every transaction, never overwrite existing values
  state.transactions.forEach(t=>{
    if(t.account===undefined){ t.account = defaultAcctId; touched=true; }
    if(t.subcategory===undefined){ t.subcategory = ''; touched=true; }
    if(t.time===undefined){ t.time = ''; touched=true; }
    if(t.tags===undefined){ t.tags = []; touched=true; }
    if(!t.type) t.type = 'expense';
  });
  if(!Array.isArray(state.recurring)) state.recurring=[];
  if(!Array.isArray(state.debts)) state.debts=[];
  if(!state.customSubcats || typeof state.customSubcats!=='object') state.customSubcats={};
  if(!Array.isArray(state.tags)) state.tags=[];
  if(!Array.isArray(state.creditCards)) state.creditCards=[];
  if(!state.ccUtilHistory || typeof state.ccUtilHistory!=='object' || Array.isArray(state.ccUtilHistory)) state.ccUtilHistory={};
  state.creditCards.forEach(c=>{
    if(c.interestRate===undefined) c.interestRate = 0;
    if(!Array.isArray(c.payments)) c.payments = [];
  });
  (state.debts||[]).forEach(d=>{
    if(!Array.isArray(d.payments)) d.payments = [];
    if(d.interest===undefined) d.interest = 0;
  });
  if(!Array.isArray(state.investments)) state.investments=[];
  if(!Array.isArray(state.investmentWatchlist)) state.investmentWatchlist=[];
  if(!Array.isArray(state.investmentHistory)) state.investmentHistory=[];
  if(!Array.isArray(state.netWorthHistory)) state.netWorthHistory=[];
  if(!Array.isArray(state.healthScoreHistory)) state.healthScoreHistory=[];
  if(!state.voiceSettings || typeof state.voiceSettings!=='object') state.voiceSettings = { enabled:true, recognitionLang:'auto', continuousMode:false };
  if(state.voiceSettings.enabled===undefined) state.voiceSettings.enabled = true;
  if(!state.voiceSettings.recognitionLang) state.voiceSettings.recognitionLang = 'auto';
  if(state.voiceSettings.continuousMode===undefined) state.voiceSettings.continuousMode = false;
  if(!Array.isArray(state.voiceLog)) state.voiceLog = [];
  if(!Array.isArray(state.budgetTypes)) state.budgetTypes = [];
  // Fold old top-level food-item categories (Milk, Curd/Dahi, Paneer, Soybean, Roasted Chana, Peanut, Coffee, Water)
  // into Food + subcategory, since they were always food items. Never fabricates data — only relabels existing entries.
  let foodTouched = false;
  state.transactions.forEach(t=>{
    if(t.category && LEGACY_FOOD_ITEM_CATS.includes(t.category)){
      if(!t.subcategory) t.subcategory = t.category;
      t.category = 'Food';
      foodTouched = true; touched = true;
    }
  });
  (state.recurring||[]).forEach(r=>{
    if(r.category && LEGACY_FOOD_ITEM_CATS.includes(r.category)){ r.category = 'Food'; foodTouched = true; }
  });
  if(state.budgets){
    let movedBudget = 0;
    LEGACY_FOOD_ITEM_CATS.forEach(c=>{
      if(state.budgets[c]!==undefined){ movedBudget += Number(state.budgets[c])||0; delete state.budgets[c]; foodTouched = true; }
    });
    if(movedBudget>0){ state.budgets['Food'] = (Number(state.budgets['Food'])||0) + movedBudget; }
  }
  // remove these from any leftover custom category list too (they're built-in now, folded into Food)
  if(Array.isArray(state.customExpenseCats) && state.customExpenseCats.some(c=>LEGACY_FOOD_ITEM_CATS.includes(c))){
    state.customExpenseCats = state.customExpenseCats.filter(c=>!LEGACY_FOOD_ITEM_CATS.includes(c));
    foodTouched = true;
  }
  if(foodTouched){ saveRecurring(); saveBudgets(); saveCustomCats(); }
  // collect tags already present on transactions
  state.transactions.forEach(t=>(t.tags||[]).forEach(tg=>{ if(!state.tags.includes(tg)) state.tags.push(tg); }));
  if(touched){ saveTransactions(); saveAccounts(); }
}
/* Sprint 23 — App.Business: every key below now resolves through bizKey()
   instead of a hardcoded 'khaata:xxx' literal (see bizKey()'s comment near
   the top of this file). saveTheme() is the one deliberate exception — theme
   stays shared across every profile, so it keeps the original plain key. */
