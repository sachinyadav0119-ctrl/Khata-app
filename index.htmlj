  b.classList.add('active');
  quickAddType = b.dataset.type;
  document.getElementById('qaExpenseIncome').classList.toggle('hidden', quickAddType==='transfer');
  document.getElementById('qaTransfer').classList.toggle('hidden', quickAddType!=='transfer');
  if(quickAddType!=='transfer') populateQuickAddCategory();
}));
document.querySelectorAll('#qaAmounts button').forEach(b=>b.addEventListener('click', ()=>{
  document.querySelectorAll('#qaAmounts button').forEach(x=>x.classList.remove('picked'));
  b.classList.add('picked');
  if(b.dataset.amt==='custom'){ quickAddAmount=null; document.getElementById('qaCustomAmtWrap').classList.remove('hidden'); document.getElementById('qa_amount').focus(); }
  else { quickAddAmount = parseFloat(b.dataset.amt); document.getElementById('qaCustomAmtWrap').classList.add('hidden'); }
}));
document.getElementById('qaSaveBtn').addEventListener('click', async ()=>{
  const amount = quickAddAmount!==null ? quickAddAmount : parseFloat(document.getElementById('qa_amount').value);
  if(!amount || amount<=0){ alert('Pick or enter a valid amount.'); return; }
  state.transactions.push({
    id:uid(), type:quickAddType, date:todayStr(), time:new Date().toTimeString().slice(0,5),
    category: document.getElementById('qa_category').value, subcategory:'', item: document.getElementById('qa_item').value.trim(),
    amount, account: document.getElementById('qa_account').value, mode:'Cash', notes:'', tags:[]
  });
  await saveTransactions();
  document.getElementById('quickAddOverlay').classList.add('hidden');
  document.getElementById('qa_item').value=''; document.getElementById('qa_amount').value='';
  document.querySelectorAll('#qaAmounts button').forEach(x=>x.classList.remove('picked'));
  quickAddAmount=null;
  refreshAllCharts();
});
document.getElementById('qaFullFormBtn').addEventListener('click', ()=>{
  document.getElementById('quickAddOverlay').classList.add('hidden');
  switchToView('entry');
});
document.getElementById('qaTransferSaveBtn').addEventListener('click', async ()=>{
  const from = document.getElementById('qa_from').value, to = document.getElementById('qa_to').value;
  const amount = parseFloat(document.getElementById('qa_transferAmount').value);
  if(!amount||amount<=0){ alert('Enter a valid amount.'); return; }
  if(from===to){ alert('Choose two different accounts.'); return; }
  state.transactions.push({ id:uid(), type:'transfer', date:todayStr(), fromAccount:from, toAccount:to, amount, notes:'' });
  await saveTransactions();
  document.getElementById('quickAddOverlay').classList.add('hidden');
  document.getElementById('qa_transferAmount').value='';
  refreshAllCharts();
});

