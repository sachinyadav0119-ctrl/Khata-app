function populateQuickAddCategory(){
  document.getElementById('qa_category').innerHTML = (quickAddType==='income'?incomeSources():expenseCats()).map(c=>`<option>${c}</option>`).join('');
}
document.querySelectorAll('#qaTypeSeg button').forEach(b=>b.addEventListener('click', ()=>{
