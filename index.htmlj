<div class="sheet-overlay hidden" id="ocrReviewOverlay">
  <div class="sheet" style="max-width:560px;">
    <button class="qa-close" id="ocrReviewClose">✕</button>
    <div class="sheet-handle"></div>
    <div class="sheet-title">Review scanned details</div>
    <div class="card-note" id="ocrReviewSourceNote" style="margin-bottom:6px;">Check the fields below — anything OCR wasn't confident about is flagged. Edit anything before saving.</div>
    <div class="ocr-warn-box hidden" id="ocrReviewWarnBox"></div>
    <div class="ocr-field-grid">
      <div><label>Type</label>
        <select id="ocr_f_type"><option value="expense">Expense</option><option value="income">Income</option></select>
      </div>
      <div><label>Merchant / Payee <span class="ocr-conf-badge" id="ocr_c_merchant"></span></label><input type="text" id="ocr_f_merchant"></div>
      <div><label>Amount (₹) <span class="ocr-conf-badge" id="ocr_c_amount"></span></label><input type="number" step="0.01" id="ocr_f_amount"></div>
      <div><label>Currency</label><input type="text" id="ocr_f_currency" placeholder="₹"></div>
      <div><label>Date <span class="ocr-conf-badge" id="ocr_c_date"></span></label><input type="date" id="ocr_f_date"></div>
      <div><label>Time</label><input type="time" id="ocr_f_time"></div>
      <div><label>Category</label><select id="ocr_f_category"></select></div>
      <div><label>Payment Mode <span class="ocr-conf-badge" id="ocr_c_mode"></span></label>
        <select id="ocr_f_mode"><option>Cash</option><option>UPI</option><option>Card</option><option>Bank Transfer</option><option>Other</option></select>
      </div>
      <div><label>Account</label><select id="ocr_f_account"></select></div>
      <div><label>Invoice / Bill No. <span class="ocr-conf-badge" id="ocr_c_invoice"></span></label><input type="text" id="ocr_f_invoice"></div>
      <div><label>GSTIN <span class="ocr-conf-badge" id="ocr_c_gstin"></span></label><input type="text" id="ocr_f_gstin"></div>
      <div><label>Tax / GST Amount</label><input type="number" step="0.01" id="ocr_f_tax"></div>
      <div><label>Discount</label><input type="number" step="0.01" id="ocr_f_discount"></div>
      <div><label>Phone Number</label><input type="text" id="ocr_f_phone"></div>
      <div style="grid-column:1/-1;"><label>Address</label><input type="text" id="ocr_f_address"></div>
      <div style="grid-column:1/-1;"><label>Items detected</label><textarea id="ocr_f_items" rows="2" placeholder="One item per line"></textarea></div>
      <div style="grid-column:1/-1;"><label>Notes</label><input type="text" id="ocr_f_notes"></div>
    </div>
    <div class="ocr-raw-toggle" id="ocrRawToggle">Show raw OCR text</div>
    <div class="ocr-raw-text hidden" id="ocrRawText"></div>
    <div class="row-actions" style="margin-top:14px;flex-wrap:wrap;">
      <button class="btn" id="ocrReviewConfirmBtn">Confirm &amp; Save Transaction</button>
      <button class="btn secondary" id="ocrReviewEditFormBtn">Send to form instead</button>
      <button class="btn secondary" id="ocrReviewDiscardBtn">Discard</button>
    </div>
  </div>
</div>

<div class="save-flash" id="saveFlash">Saved</div>
<div class="advisor-toast" id="advisorToast"></div>

<script>
/* ================================================================
   APP — global namespace (Sprint 01: foundation / architecture only)
   ------------------------------------------------------------------
   Purpose: give the codebase one predictable place to hang future
   features off of, without touching how the app currently looks or
   behaves. Every existing function, variable and event handler below
   is untouched — this object is an additive map on top of them.
   Calling App.Storage.saveGoals() and calling saveGoals() directly
   do exactly the same thing.

   Module map:
     App.Config          constants (categories, payment modes, Drive
                          backup settings, etc.)
     App.State           accessors for the live app state (`state`)
                          and active Chart.js instances (`charts`)
     App.Storage          localStorage read/write (backed by the
                           existing save-prefixed functions and
                           loadState)
     App.Events            helper for wiring up DOM event listeners
     App.Utils              small formatting/date/number helpers
     App.Logger              console logging, used by the global
                              error handlers set up near the end of
                              this file
     App.Notifications        user-facing "saved" flash indicator
     App.Helpers               domain helpers (accounts, categories,
                                debts, tags, etc.)

   Planned modules (not implemented this sprint — placeholders only,
   see "TODO MODULE PLACEHOLDERS" near the end of this file):
     App.AIEngine             natural-language finance assistant
     App.VoiceEngine          future home for the existing voice
                               command system
     App.ConversationEngine   multi-turn conversational interface
     App.OfflineEngine        offline queueing / conflict resolution
     App.OnlineEngine         cloud sync beyond the current Drive
                               backup
     App.AttachmentEngine     (still reserved/empty — see App.Attachments
                               below for the real, built implementation)
     App.SearchEngine         future home for the existing search
                               feature
     App.MemoryEngine         long-term personalization / memory
     App.AnalyticsEngine      analytics beyond the current charts

   Also built (fully implemented; see the "SMART ATTACHMENT ENGINE"
   block near the end of this file — Sprint 11):
     App.Attachments           multi-file receipt/bill/invoice/PDF/
                                audio/video/document attachments for
                                transactions. Submodules: Manager,
                                Storage (IndexedDB + localStorage
                                fallback), Validator, Viewer, Security,
                                Compression, Logger, Cache. Purely
                                client-side — no cloud upload, no OCR,
                                no external network calls. App.Attachments
                                is new and separate from the
                                App.AttachmentEngine placeholder above,
                                which is intentionally left untouched.

   Also built (architecture-only scaffold; see the "SMART TRANSACTION
   ENGINE FOUNDATION" block near the end of this file):
     App.Transaction          natural-language transaction understanding
                               + draft preparation. Reuses the existing,
                               already-working extractAmount()/detectType()/
                               detectCategory()/detectMode()/detectDate()/
                               detectAccount()/detectItem() helpers (used
                               today by the voice feature) instead of
                               duplicating that logic — this module wraps
                               them behind a documented App.Transaction.*
                               surface and adds a Draft system, structural
                               validation, history/logging and a plugin
                               registry on top. It never writes to the
                               real `state.transactions` array itself —
                               it only prepares drafts for the user (or a
                               future caller) to confirm through the
                               app's existing, unchanged add-transaction
                               flow.
================================================================ */
const App = {
  Config: {},
  State: {},
  Storage: {},
  Events: {},
  Utils: {},
  Logger: {},
  Notifications: {},
  Helpers: {},
  // ---- planned, not implemented this sprint (see bottom of file) ----
  AIEngine: {},
  VoiceEngine: {},
  // Voice Engine Foundation (architecture-only scaffold; see the
  // "VOICE ENGINE FOUNDATION" block near the end of this file).
  // App.VoiceEngine above stays reserved/empty and untouched — this is
  // a separate, newly-built namespace and does not replace it.
  Voice: {},
  ConversationEngine: {},
  // Conversation Engine Foundation (architecture-only scaffold; see the
  // "CONVERSATION ENGINE FOUNDATION" block near the end of this file).
  // App.ConversationEngine above stays reserved/empty and untouched —
  // this is a separate, newly-built namespace and does not replace it.
  Conversation: {},
  OfflineEngine: {},
  OnlineEngine: {},
  AttachmentEngine: {},
  // Smart Attachment Engine (fully implemented; see the "SMART ATTACHMENT
  // ENGINE" block near the end of this file). App.AttachmentEngine above
  // stays reserved/empty and untouched — this is a separate, newly-built
  // namespace and does not replace it.
  Attachments: {},
  // Production OCR Engine (fully implemented; see the "PRODUCTION OCR
  // ENGINE" block near the end of this file — Sprint 12). Reads
  // receipts/bills/invoices/GST bills/bank slips/payment screenshots via
  // Tesseract.js, extracts structured fields, and prepares a reviewable
  // transaction draft. Never writes to state.transactions without the
  // user confirming in the review sheet.
  OCR: {},
  // Intelligent Auto-Save Engine (fully implemented; see the
  // "INTELLIGENT AUTO-SAVE ENGINE" block near the end of this file —
  // Sprint 12). Adds debounced draft persistence + restart recovery for
  // in-progress form/OCR edits, on top of the app's existing per-change
  // localStorage saves (which are untouched).
  AutoSave: {},
  SearchEngine: {},
  MemoryEngine: {},
  // Offline AI Memory Engine (fully implemented; see the "OFFLINE AI
  // MEMORY ENGINE" block near the end of this file). App.MemoryEngine
  // above stays reserved/empty and untouched — this is a separate,
  // newly-built namespace and does not replace it.
  Memory: {},
  AnalyticsEngine: {},
  // Smart Intent Detection Engine foundation (architecture-only scaffold;
  // see the "SMART INTENT DETECTION ENGINE FOUNDATION" block near the end
  // of this file). Intended future brain for Voice AI + Chat AI — does
  // not itself run any AI model, call any API, or touch finance data.
  Intent: {},
  // Smart Transaction Engine foundation (architecture-only scaffold; see
  // the "SMART TRANSACTION ENGINE FOUNDATION" block near the end of this
  // file). Understands natural-language transaction text and prepares
  // Draft transactions for confirmation — never writes to the real
  // `state.transactions` array itself.
  Transaction: {},
  // Intelligent AI Dashboard (fully implemented; see the "SMART DASHBOARD"
  // block near the end of this file — Sprint 13). Turns the existing Home
  // tab into a live-updating dashboard; does not replace or redesign the
  // hero/KPI/chart markup already there.
  Dashboard: {},
  // AI Reports & Smart Analytics Engine (fully implemented; see the
  // "AI REPORTS & SMART ANALYTICS ENGINE" block near the end of this file
  // — Sprint 14). Powers the new "AI Reports" tab (id="view-reports").
  // Separate, new namespace — does not touch App.Dashboard, the existing
  // "Monthly Report" tab (renderReport/view-report), or the existing
  // "Insights" tab (renderInsights/view-insights), all of which remain
  // exactly as they were.
  Reports: {},
  // Offline rule-based AI insights/trends/forecast engine that powers
  // App.Reports.Analytics (fully implemented; same block as App.Reports
  // — Sprint 14). Separate, new namespace from App.AnalyticsEngine above
  // (which stays reserved/empty and untouched) and from
  // App.Dashboard.Analytics (which stays exactly as it was and keeps
  // powering the Home tab's own insight list).
  Analytics: {},
  // Personal AI Financial Advisor (fully implemented; see the "PERSONAL
  // AI FINANCIAL ADVISOR" block near the end of this file — Sprint 20).
  // Proactive layer on top of the app: it does not recompute the Health
  // Score, spending intelligence, anomaly detection, or emergency-fund
  // target math that App.Reports/App.Analytics and the existing Insights
  // tab (computeHealthScoreDetail, anomalyAlerts, getEmergencyFundGoal,
  // computeGoalPlan, etc.) already own — it calls those directly and
  // adds what didn't exist yet: subscription/duplicate detection, a
  // real-time save-time warning check, loan repayment ordering,
  // investment-readiness scoring, and a personalization layer that
  // remembers which suggestions the user dismissed. New "AI Advisor" tab
  // (id="view-advisor") — additive, does not touch any existing tab.
  Advisor: {},
  // Smart Budget AI & Goal Planner (fully implemented; see the "SPRINT 21"
  // block near the end of this file). App.Budget extends the existing
  // budgets{}/renderBudgets() with Daily/Weekly/Yearly/Custom periods and
  // Subcategory/Account/Project scopes (new, additive "advanced budgets"),
  // plus AI recommendations/forecasts/alerts on top of the existing data.
  // App.Goals wraps the existing computeGoalPlan()/computeGoalStatus()
  // engine with goal-type analytics, recommendations and notifications —
  // it does not recompute the underlying goal math.
  Budget: {},
  Goals: {},
  // Investment Intelligence System (fully implemented; see the "SPRINT 22"
  // block near the end of this file). App.Investment extends the existing
  // Investments tab (state.investments/saveInvestments()/renderInvestments())
  // with portfolio analytics, risk/diversification scoring, goal linking,
  // rule-based recommendations, a watchlist and a beginner-friendly
  // learning/glossary section — it does not recompute or replace the
  // underlying investment data or totals.
  Investment: {},
  // Business Foundation (fully implemented; see the "SPRINT 23 —
  // BUSINESS FOUNDATION" block near the end of this file). Adds
  // Personal <-> Business profile switching with fully isolated
  // transactions/budgets/budgetTypes/goals/accounts/recurring/debts/
  // tags/creditCards/investments/netWorthHistory/voiceSettings/
  // voiceLog/reminders/advisor-state/customSubcats/custom-categories/
  // settings per profile — instant switch, no restart. Every existing
  // save*()/loadState() function is reused completely unchanged in
  // behavior; they were only made profile-aware via one new key
  // resolver (bizKey()). Foundation only — Customers, Vendors,
  // Products, Inventory, Invoices, Payments, GST/Tax and Cloud Sync
  // are explicitly out of scope this sprint; future sprints build on
  // App.Business.Workspace.scopedKey() instead of reinventing this.
  Business: {}
};

